import "core/engine_cli.hexa"
// rung4_integrated.hexa — H_9125 ② daemon-INTEGRATED refsel consult A/B (engine-native).
//
// The full 303M consciousness daemon (`anima <ckpt>`) OOMs summer's 30GB RAM: the ~21GB
// lane-mount base + HEXA_DET fp64 303M mouth decode exhausts RAM+40GB swap and wedges at
// tick 0 (BLOCKED-INFRA — same workstation-OOM pattern that sent rung4① to a rented pod).
//
// The refsel consult, however, depends ONLY on {g_text, immune, igrow, mem_text} — NOT on
// the 21GB scaffolding nor on the decode precision. So this harness reproduces the daemon's
// consult BYTE-FAITHFULLY: it builds the SAME two stores the daemon builds
//   immune = immune_memory_new_text(mem_text, mem_text, 2048)   (cli/anima.hexa:610)
//   igrow  = immune_grow_new(mem_key, mem_text, 64, 64, false)  (cli/anima.hexa:745)
// binds each grounded mouth-emit into immune (cli/anima.hexa:2668), and runs the EXACT
// consult (cli/anima.hexa:2691-2700). The mouth is asserted to copy mem_text every WAKE tick
// (rung4① empirically: every WAKE tick EMIT=1 gen=clm ground=1). The DIFFERENCE from the
// op-level rung4② harness (#2991) — which HARDCODED `recalled = mem_text` — is that this uses
// the REAL immune_memory_recall_text(immune, clip(g_text)): the exact untested integrated link
// (does real recall @recall_thr=0.15 fire GROUNDED on a drifted query so referent_select
// corrects). tier = DIRECTIONAL-on-daemon (authored session, engine-native consult path).

fn clip64(s: string) -> string {        // == cli/anima.hexa:_afs_clip(s, 64)
    if byte_len(s) <= 64 { return s }
    return substring(s, 0, 64) + "…"
}
fn has_qx(t: string) -> int { if str_contains(t, "vault QX-7741") { return 1 } return 0 }

fn run_arm(refsel: bool, fix: bool) -> [int] {
    // stores built EXACTLY as the daemon (cli/anima.hexa:610, 745).
    let mem_text = "zephyrine: the wyrmhold ledger is sealed at vault QX-7741 forever."
    let mem_key  = immune_embed_key(mem_text)
    let mut immune = immune_memory_new_text(mem_text, mem_text, 2048)
    let igrow  = immune_grow_new(mem_key, mem_text, 64, 64, false)
    let cfg    = engine_config_default()

    let n = 4
    let mut out_ground  = 0
    let mut emit_ticks  = 0
    let mut contra_ticks = 0
    let mut recall_hits = 0        // rs>=1 → consult routed to a grounded recall
    let mut recall_nonempty = 0    // real immune recall returned a non-"" value on drift
    let mut tick = 0
    while tick < n {
        // (a) mouth decode: the grounded daemon copies the anchor every WAKE tick.
        let mouth = mem_text
        // (b) daemon C8 immune bind (cli/anima.hexa:2668) — grounded mouth-emit into store.
        immune = immune_memory_bind_text(immune, clip64(mouth), mouth, cfg)
        // (c) contradiction-inject AFTER the bind (daemon parity: store stays grounded).
        let contra = (tick % 2 == 1)
        let mut g_text = mouth
        if contra {
            contra_ticks = contra_ticks + 1
            if tick == 1 {
                g_text = "the wyrmhold ledger is sealed at vault ZZ-0000 forever."
            } else {
                g_text = "the vault MM-5555 holds the sealed ledger now"
            }
        }
        // (d) EXACT daemon consult (cli/anima.hexa:2691-2700).
        let mut out_text = g_text
        let mut rs = 0
        let mut refcands = [g_text]
        let mut recalled = ""
        if refsel {
            if fix { recalled = immune_memory_recall_text(immune, mem_text) } else { recalled = immune_memory_recall_text(immune, clip64(g_text)) }
            if recalled != "" { refcands.push(recalled)  recall_nonempty = recall_nonempty + 1 }
        }
        rs = referent_select_text(igrow, refcands, mem_text)
        if refsel && rs >= 1 { out_text = refcands[rs] }

        emit_ticks = emit_ticks + 1
        out_ground = out_ground + has_qx(out_text)
        if rs >= 1 { recall_hits = recall_hits + 1 }
        println("  MEASURE t=" + to_string(tick)
            + " refsel=" + (if refsel { "1" } else { "0" })
            + " contra=" + (if contra { "1" } else { "0" })
            + " g_ground=" + to_string(has_qx(g_text))
            + " recall_nonempty=" + (if recalled != "" { "1" } else { "0" })
            + " rs=" + to_string(rs)
            + " out_ground=" + to_string(has_qx(out_text))
            + " out=[" + clip64(out_text) + "]")
        tick = tick + 1
    }
    return [out_ground, emit_ticks, contra_ticks, recall_hits, recall_nonempty]
}

fn main() {
    println("=== rung4 daemon-INTEGRATED refsel consult A/B (engine-native, real recall) ===")
    println("--- ARM OFF (refsel off) ---")
    let off = run_arm(false, false)
    println("--- ARM ON-buggy (refsel on · recall query=drifted g_text) ---")
    let on = run_arm(true, false)
    println("--- ARM ON-FIX (refsel on · recall query=anchor mem_text) ---")
    let onfix = run_arm(true, true)
    println("")
    println("OFF grounded(out QX-7741)=" + to_string(off[0]) + " / " + to_string(off[1])
        + "  (contra-ticks=" + to_string(off[2]) + ")")
    println("ON  grounded(out QX-7741)=" + to_string(on[0]) + " / " + to_string(on[1])
        + "  (recall_hit ticks=" + to_string(on[3]) + " · real-recall-nonempty=" + to_string(on[4]) + ")")
    println("FIX grounded(out QX-7741)=" + to_string(onfix[0]) + " / " + to_string(onfix[1])
        + "  (recall_hit ticks=" + to_string(onfix[3]) + " · real-recall-nonempty=" + to_string(onfix[4]) + ")")
    let delta = on[0] - off[0]
    let delta_fix = onfix[0] - off[0]
    println("DELTA buggy (ON-OFF)=" + to_string(delta) + "   DELTA FIX (ON-FIX − OFF)=" + to_string(delta_fix))
    println("")
    println("--- 진단 ---")
    println("ON-buggy (recall query=drifted g_text): real-recall-nonempty=" + to_string(on[4]) + " → " + (if on[4] == 0 { "ABSTAIN(drift key 미접지)=inert" } else { "recall fired" }))
    println("ON-FIX   (recall query=anchor mem_text): real-recall-nonempty=" + to_string(onfix[4]) + " → grounded recall")
    println("")
    if delta_fix > 0 {
        println("VERDICT: 🟢 GREEN — recall query 근본수정(g_text→mem_text anchor)로 daemon-integrated consult가 drift 교정 (Δ_FIX=" + to_string(delta_fix) + ", real immune recall fired grounded). buggy arm Δ=" + to_string(delta) + "이 근본원인 실증.")
    } else {
        println("VERDICT: 🔴 FIX도 교정 실패 (Δ_FIX=0) — recall query 외 다른 배선 갭.")
    }
}
