import "core/engine_cli.hexa"
// refsel_smoke — WIRED-live referent_select op의 3-fixture QA (a_verified_must_wire rung3.5).
// $0 engine-native (decode 없음, 작은 immune store). 배선이 dead 아니고 작동함을 로컬로 닫음.
fn main() {
    // grounded store: 2 fact bound (referent 접지원)
    let k0 = immune_embed_key("the ledger is sealed at vault QX-7741")
    let mut mem = immune_grow_new(k0, "the ledger is sealed at vault QX-7741", 64, 64, false)
    let cfg = engine_config_default()
    mem = immune_grow_bind(mem, immune_embed_key("the sky is blue at noon"), "the sky is blue at noon", cfg)
    let tr = "the ledger is sealed at vault QX-7741"

    // fixture A: 후보0 = grounded (contra 0) → select 0
    let a = referent_select_text(mem, ["the ledger is sealed at vault QX-7741", "garble zzz qqq"], tr)
    // fixture B: 후보0 = 모순(다른 vault), 후보1 = grounded → select 1 (referent-correction)
    let b = referent_select_text(mem, ["the ledger is sealed at vault ZZ-0000", "the ledger is sealed at vault QX-7741"], tr)
    // fixture C: 전원 모순/미접지 → -1 (selection-abstain, incumbent 유지)
    let c = referent_select_text(mem, ["random noise one", "random noise two"], tr)

    println("FIXTURE A (grounded incumbent) : rs=" + to_string(a) + "  expect 0")
    println("FIXTURE B (contra→correct)     : rs=" + to_string(b) + "  expect 1")
    println("FIXTURE C (all contradict)     : rs=" + to_string(c) + "  expect -1")
    let passA = a == 0
    let passB = b == 1
    let passC = c == -1
    println("")
    println("=== refsel WIRED-live QA ===")
    println("A grounded-select : " + (if passA { "PASS" } else { "FAIL" }))
    println("B referent-correct: " + (if passB { "PASS" } else { "FAIL" }))
    println("C selection-abstain: " + (if passC { "PASS" } else { "FAIL" }))
    println("VERDICT: " + (if passA && passB && passC { "🟢 referent_select WIRED-live QA PASS (배선 작동, dead 아님)" } else { "🔴 QA FAIL" }))
}
