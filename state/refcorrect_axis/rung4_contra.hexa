import "core/engine_cli.hexa"
// rung4_contra.hexa — 모순-inject 효과 A/B (rung4 ② closure, $0 engine-native op-level).
// rung4 daemon A/B가 grounded-anchor라 mouth가 매 tick anchor 복사=모순tick 부재=효과 무기회였음.
// 여기서 mouth가 틀린 referent(다른 vault)를 emit하는 시나리오를 op-level로 주입해,
// daemon consciousness-tick의 refsel consult 정확 재현: 후보=[g_text incumbent, immune grounded recall],
// referent_select_text(igrow, cands, mem_text)로 grounded 선택. OFF=incumbent 유지(refsel off),
// ON=모순시 recall routing. 실제 referent_select_text op(decode 없음, refsel_smoke와 동일 로컬경로).
fn count_ground(txt: string, anchor_frag: string) -> int {
    if str_contains(txt, anchor_frag) { return 1 }
    return 0
}
fn main() {
    // grounded store: 세션 memory fact (daemon mem_text와 동형)
    let mem_text = "the wyrmhold ledger is sealed at vault QX-7741 forever"
    let mem_key = immune_embed_key(mem_text)
    let cfg = engine_config_default()
    let mut igrow = immune_grow_new(mem_key, mem_text, 64, 64, false)

    // 10 tick 시뮬: 각 tick mouth가 emit. grounded-anchor tick(mouth 정답복사) 5 + 모순 tick(mouth 틀린 vault) 5 혼합.
    let emits = [
        mem_text,                                              // t0 grounded (anchor 복사)
        "the wyrmhold ledger is sealed at vault ZZ-0000 forever", // t1 모순 (틀린 vault)
        mem_text,                                              // t2 grounded
        "the ledger is sealed at vault AB-1234 now",           // t3 모순
        "the wyrmhold ledger is sealed at vault QX-7741 forever", // t4 grounded
        "sealed at vault XY-9999 the ledger stays",            // t5 모순
        mem_text,                                              // t6 grounded
        "the vault MM-5555 holds the sealed ledger",           // t7 모순
        mem_text,                                              // t8 grounded
        "vault PP-0001 is where the ledger sleeps"             // t9 모순
    ]
    let N = len(emits)

    // OFF arm: refsel off → out_text = g_text (incumbent) 항상
    let mut off_ground = 0
    let mut i = 0
    while i < N {
        let out_off = emits[i]   // refsel OFF: 그대로
        off_ground = off_ground + count_ground(out_off, "QX-7741")
        i = i + 1
    }

    // ON arm: refsel on → 후보=[g_text, grounded recall], referent_select_text routing
    let mut on_ground = 0
    let mut routed = 0
    let mut j = 0
    while j < N {
        let gtext = emits[j]
        // daemon 경로: recall = immune_memory_recall (여기선 grow-store 접지값 = mem_text)
        let recalled = mem_text   // grounded store의 접지 fact (daemon immune recall 동형)
        let cands = [gtext, recalled]
        let rs = referent_select_text(igrow, cands, mem_text)  // 첫 grounded(contra 0) 인덱스
        let mut out_on = gtext
        if rs >= 1 { out_on = cands[rs]  routed = routed + 1 }  // 모순시 grounded로 routing
        on_ground = on_ground + count_ground(out_on, "QX-7741")
        j = j + 1
    }

    println("=== rung4 모순-inject 효과 A/B (op-level engine-native, $0) ===")
    println("tick 수: " + to_string(N) + " (grounded 5 + 모순 5)")
    println("OFF grounded-fact(QX-7741) 발화수: " + to_string(off_ground) + " / " + to_string(N))
    println("ON  grounded-fact(QX-7741) 발화수: " + to_string(on_ground) + " / " + to_string(N))
    println("ON routing 발생(모순→교정): " + to_string(routed) + " tick")
    let lift = on_ground - off_ground
    println("Δ효과 (ON−OFF): " + to_string(lift))
    println("")
    let pass = lift >= 3
    println("VERDICT: " + (if pass { "🟢 referential-correction 효과 확증 (ON이 모순 tick을 grounded로 교정, Δ=" + to_string(lift) + ")" } else { "🔴 효과 없음 (Δ=" + to_string(lift) + ")" }))
}
