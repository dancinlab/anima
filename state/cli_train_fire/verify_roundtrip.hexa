// engine-native round-trip: mount a cli/train.hexa-produced .clm on core/clm_decode
// and confirm it is decodable + a forward runs (a_engine_native_learning · a_clm_gen_pipeline).
import "core/clm_decode.hexa"

fn main() {
    let path = args()[len(args()) - 2]
    let corpus = args()[len(args()) - 1]
    println("=== cli/train.hexa .clm round-trip on core/clm_decode ===")
    print("  path="); println(path)
    let dec = clm_decodable(path)
    print("  clm_decodable="); println(dec)
    if !dec {
        println("FAIL  not v0.2/v0.3 decodable (serialize layout MISMATCH with core/clm_decode)")
        return
    }
    let cfg = clm_config(path)
    print("  config d="); print(to_int(cfg["d"])); print(" E="); print(to_int(cfg["E"]))
    print(" V="); print(to_int(cfg["V"])); print(" K="); print(to_int(cfg["K"]))
    print(" L="); print(to_int(cfg["L"])); print(" nblk="); println(to_int(cfg["nblk"]))
    let r = clm_forward_ce(path, corpus, 16)
    print("  forward ok="); println(r["ok"])
    print("  windows="); println(to_int(r["windows"]))
    print("  model_ce="); println(r["model_ce"])
    print("  uniform_ce(lnV)="); println(r["uniform_ce"])
    print("  shuffle_ce="); println(r["shuffle_ce"])
    print("  lt_uniform="); println(r["lt_uniform"])
    if r["ok"] {
        println("PASS  F-CLI-TRAIN-CLM-ROUNDTRIP  serialize layout byte-compatible with core/clm_decode (forward ran)")
    } else {
        print("FAIL  "); println(r["reason"])
    }
}
