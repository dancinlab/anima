// bytegpt_parity_harness.hexa — TEMP parity harness (delete before commit).
// Dumps last-pos logits + greedy argmax id-stream + seeded top-k id-stream from the
// live core/bytegpt_decode.hexa, for byte-parity comparison vs core/bytegpt_decode.py.
import "core/bytegpt_decode.hexa"

fn main() {
    let bin = exec("printf %s \"$BG_BIN\"")
    let W = bg_load(bin)
    let vocab = to_int(W["vocab"])

    // seed = "Hello world" byte ids
    let stext = "Hello world"
    let seed = []
    let mut si = 0
    while si < byte_len(stext) { seed.push(ord(substring(stext, si, si + 1))); si = si + 1 }
    let nseed = len(seed)

    // ── LOGITS: last-position next-byte logits over the seed window ──
    let ids = farr_zeros(nseed)
    let mut p = 0
    while p < nseed { let _ = farr_set(ids, p, to_float(to_int(seed[p]))); p = p + 1 }
    let lg = bg_forward_last_W(W, ids, nseed)
    let mut s = "LOGITS:"
    let mut k = 0
    while k < vocab {
        if k > 0 { s = s + "," }
        s = s + to_string(farr_get(lg, k))
        k = k + 1
    }
    println(s)
    let _ = farr_free(lg); let _ = farr_free(ids)

    let gen = 24
    // ── ARGMAX id-stream (KV-cache path, nseed+gen <= block) ──
    let ra = bytegpt_decode_argmax(bin, seed, gen)
    let aids = ra["ids"]
    let mut sa = "ARGMAX:"
    let mut ai = 0
    while ai < len(aids) {
        if ai > 0 { sa = sa + "," }
        sa = sa + to_string(to_int(aids[ai]))
        ai = ai + 1
    }
    println(sa)

    // ── SAMPLE id-stream (full-forward + seeded top-k) ──
    let rs = bytegpt_decode_topk_sampled(bin, seed, gen, 8, 0.9, 4242)
    let sids = rs["ids"]
    let mut ss = "SAMPLE:"
    let mut sj = 0
    while sj < len(sids) {
        if sj > 0 { ss = ss + "," }
        ss = ss + to_string(to_int(sids[sj]))
        sj = sj + 1
    }
    println(ss)
}
