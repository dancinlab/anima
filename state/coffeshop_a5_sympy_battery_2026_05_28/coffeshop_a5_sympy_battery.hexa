// ════════════════════════════════════════════════════════════════════════════
//  coffeshop_a5_sympy_battery.hexa — A5 closed-form identity battery for the
//  5 COFFESHOP emit-case (A-E) substrate triggers.
//
//  Hypothesis (ANIMA.md B-COFFESHOP milestone): each of the 5 substrate
//  triggers behind COFFESHOP emit-case A-E
//      A relevance  → factor_relevance(phi)
//      B coherence  → factor_coherence(gate)
//      C curiosity  → factor_curiosity(ema)
//      D dynamics   → factor_dynamics(silence_seconds)
//      E pain       → factor_pain(tension_delta)
//  is a CLOSED-FORM transfer-fn whose value is reproducible EXACTLY by an
//  independent hexa-native closed-form re-derivation (a_blue_closed:
//  "close both outputs AND wiring — confirm closed-form / identity").
//
//  Method: for each trigger we re-derive the closed form INDEPENDENTLY of
//  the lib branch structure (clamp = min/max composition; coherence =
//  affine triangular kernel) and assert lib(x) == closed(x) BIT-EXACT
//  (tol=0.0, not numerical tolerance) across representative domain points
//  spanning every branch (below-floor · interior · above-ceiling · the
//  exact clamp knees). A trigger PASSES (🔵 closed-form) iff EVERY probe
//  point is a bit-exact identity match. A single mismatch FALSIFIES that
//  trigger to 🟢/🟠 (numerical-only / wiring incomplete).
//
//  foreground synchronous · $0 mac-local · NO main side effects beyond print.
//  Exit 0 on full PASS. Prints per-trigger verdict + aggregate.
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/CHAT/spontaneous_lib.hexa"


// ── bit-exact equality (tol = 0.0 — closed-form identity, NOT numerical) ─────
fn _exact(a: float, b: float) -> bool {
    return a == b
}

// ── independent closed-form re-derivations (clamp via min/max composition) ───

// clamp01(x) = max(0, min(1, x)) — the saturating-linear transfer of A/C
fn _cf_clamp01(x: float) -> float {
    let lo = if x < 0.0 { 0.0 } else { x }
    if lo > 1.0 { return 1.0 }
    return lo
}

// A relevance: identity-on-[0,1] saturating linear ⇒ clamp01(phi)
fn _cf_relevance(phi: float) -> float { return _cf_clamp01(phi) }

// C curiosity: same saturating-linear transfer over EMA ⇒ clamp01(ema)
fn _cf_curiosity(ema: float) -> float { return _cf_clamp01(ema) }

// D dynamics: scale-then-clamp ⇒ clamp01(silence / 30) (30 = spont_idle_speak_after)
fn _cf_dynamics(silence: float) -> float {
    return _cf_clamp01(silence / spont_idle_speak_after())
}

// E pain: rectified |Δ| then ceiling ⇒ min(1, abs(delta)), abs via sqrt-free fold
fn _cf_abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _cf_pain(delta: float) -> float {
    let a = _cf_abs(delta)
    if a > 1.0 { return 1.0 }
    return a
}

// B coherence: affine triangular kernel about Ψ=0.5, half-width α=0.014:
//   coh(g) = max(0, 1 − |g − 0.5| / 0.014)
fn _cf_coherence(gate: float) -> float {
    let d = _cf_abs(gate - 0.5)
    let n = d / 0.014
    let nclamp = if n > 1.0 { 1.0 } else { n }
    return 1.0 - nclamp
}


// ── per-trigger battery — every probe is a bit-exact lib==closed assertion ───

// returns true iff ALL probe points match exactly for trigger A relevance
fn _battery_relevance() -> bool {
    let xs = [-0.5, 0.0, 0.2, 0.5, 0.5067, 1.0, 1.0001, 2.0]
    let mut i = 0
    let mut ok = true
    while i < len(xs) {
        let x = to_float(to_string(xs[i]))
        if !_exact(factor_relevance(x), _cf_relevance(x)) { ok = false }
        i = i + 1
    }
    return ok
}

fn _battery_curiosity() -> bool {
    let xs = [-1.0, 0.0, 0.3, 0.75, 1.0, 1.5, 2.0]
    let mut i = 0
    let mut ok = true
    while i < len(xs) {
        let x = to_float(to_string(xs[i]))
        if !_exact(factor_curiosity(x), _cf_curiosity(x)) { ok = false }
        i = i + 1
    }
    return ok
}

fn _battery_dynamics() -> bool {
    let xs = [-5.0, 0.0, 6.0, 15.0, 29.9, 30.0, 30.1, 60.0]
    let mut i = 0
    let mut ok = true
    while i < len(xs) {
        let x = to_float(to_string(xs[i]))
        if !_exact(factor_dynamics(x), _cf_dynamics(x)) { ok = false }
        i = i + 1
    }
    return ok
}

fn _battery_pain() -> bool {
    let xs = [-2.0, -1.0, -0.4, 0.0, 0.25, 0.99, 1.0, 1.5]
    let mut i = 0
    let mut ok = true
    while i < len(xs) {
        let x = to_float(to_string(xs[i]))
        if !_exact(factor_pain(x), _cf_pain(x)) { ok = false }
        i = i + 1
    }
    return ok
}

fn _battery_coherence() -> bool {
    // probe across the triangular kernel: far-low · knee-low · interior ·
    // exact Ψ · interior-high · knee-high · far-high
    let xs = [0.0, 0.486, 0.49, 0.5, 0.51, 0.514, 1.0]
    let mut i = 0
    let mut ok = true
    while i < len(xs) {
        let x = to_float(to_string(xs[i]))
        if !_exact(factor_coherence(x), _cf_coherence(x)) { ok = false }
        i = i + 1
    }
    return ok
}


fn main() {
    print("=== COFFESHOP A5 — 5 substrate-trigger closed-form sympy battery ===")
    print("identity test: lib factor_*(x) == independent closed-form(x) BIT-EXACT (tol=0.0)")
    print("")

    let rA = _battery_relevance()
    let rB = _battery_coherence()
    let rC = _battery_curiosity()
    let rD = _battery_dynamics()
    let rE = _battery_pain()

    print("case  trigger     lib fn               closed-form                          verdict")
    print("----  ----------  -------------------  -----------------------------------  -------")
    if rA { print("A     relevance   factor_relevance     clamp01(phi)                         CLOSED-FORM") }
    else  { print("A     relevance   factor_relevance     clamp01(phi)                         MISMATCH") }
    if rB { print("B     coherence   factor_coherence     max(0,1-|g-0.5|/0.014)               CLOSED-FORM") }
    else  { print("B     coherence   factor_coherence     max(0,1-|g-0.5|/0.014)               MISMATCH") }
    if rC { print("C     curiosity   factor_curiosity     clamp01(ema)                         CLOSED-FORM") }
    else  { print("C     curiosity   factor_curiosity     clamp01(ema)                         MISMATCH") }
    if rD { print("D     dynamics    factor_dynamics      clamp01(s/30)                        CLOSED-FORM") }
    else  { print("D     dynamics    factor_dynamics      clamp01(s/30)                        MISMATCH") }
    if rE { print("E     pain        factor_pain          min(1,|delta|)                       CLOSED-FORM") }
    else  { print("E     pain        factor_pain          min(1,|delta|)                       MISMATCH") }

    print("")
    let mut n_closed = 0
    if rA { n_closed = n_closed + 1 }
    if rB { n_closed = n_closed + 1 }
    if rC { n_closed = n_closed + 1 }
    if rD { n_closed = n_closed + 1 }
    if rE { n_closed = n_closed + 1 }

    print("=== aggregate ===")
    print("closed-form (🔵 bit-exact identity) triggers: " + to_string(n_closed) + " / 5")
    let all_pass = rA && rB && rC && rD && rE
    if all_pass {
        print("VERDICT: 5/5 CLOSED-FORM · a_blue_closed wiring (transfer-fn) CONFIRMED · exit=0")
    } else {
        print("VERDICT: " + to_string(n_closed) + "/5 CLOSED-FORM · FALSIFIER fired on non-matching trigger")
    }
}
