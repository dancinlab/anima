// wired_runtime_check.hexa — H_9042 WIRED-live completion: ENGINE-NATIVE reproduction of the NEW
// cli/anima.hexa LANE+ read block (lane 75, "tension-r") that wires tension_resolve_depth onto the
// daemon's startup consciousness-lane catalogue as a READ-only CONTEXT signal. Running the full
// daemon (anima chat <ckpt>) needs the heavy 303M mouth, so this standalone harness reproduces the
// EXACT conflicted-vs-calm-vs-ablate assertion the LANE+ block asserts, on LIVE core/engine_cli.hexa,
// with PRE-REGISTERED bars (no tune-to-green, c9). Mirrors H_9038's c2_engine_native.hexa pattern.
//   BAR1 conflict_settles : conflicted pop (Ψ_init=1.0) settles to Ψ=½ at depth>0 (op=2 row-stochastic).
//   BAR2 calm_at_zero     : calm pop (Ψ_init=½) settles at depth 0 (no resolution needed).
//   BAR3 distinct_depth   : conflicted settle depth STRICTLY > calm settle depth (the read is earned).
//   BAR4 ablate_INERT     : coupling OFF on the conflicted pop → NEVER settles (depth = -1).
// usage: hexa run state/9042_tension_resolution_loop/wired_runtime_check.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

// EXACT copies of the cli/anima.hexa LANE+ helpers (anima_tr_*), so this harness measures the SAME
// fixtures the wired lane 75 does.
fn tr_row(c: float, other: float) -> [float] {
    let mut r = []
    let mut i = 0
    while i < 15 {
        if i == 0 || i == 4 { r = r + [c] } else { r = r + [other] }
        i = i + 1
    }
    return r
}
fn tr_pop_conflicted(c: float) -> [[float]] {
    let h = (9.0 - 2.0 * c) / 13.0
    let l = (6.0 - 2.0 * c) / 13.0
    let mut pop = []
    let mut t = 0
    while t < 4 { pop = pop + [tr_row(c, h)]  t = t + 1 }
    t = 0
    while t < 4 { pop = pop + [tr_row(c, l)]  t = t + 1 }
    return pop
}
fn tr_pop_calm() -> [[float]] {
    let mut pop = []
    let mut t = 0
    while t < 4 { pop = pop + [tr_row(0.95, 0.6)]  t = t + 1 }
    t = 0
    while t < 4 { pop = pop + [tr_row(0.20, 0.4)]  t = t + 1 }
    return pop
}
fn tr_adj_full() -> [[float]] {
    let mut a = []
    let mut i = 0
    while i < 15 {
        let mut row = []
        let mut j = 0
        while j < 15 {
            if i == j { row = row + [0.0] } else { row = row + [1.0] }
            j = j + 1
        }
        a = a + [row]
        i = i + 1
    }
    return a
}

fn main() {
    let mut npass = 0
    let mut nfail = 0

    let full   = tr_adj_full()
    let conf   = tr_pop_conflicted(0.95)
    let calm   = tr_pop_calm()
    let cfgON  = EngineConfig { mitosis: true, engine: "conv", topo_couple: true, savant: false }
    let cfgOFF = EngineConfig { mitosis: true, engine: "conv", topo_couple: false, savant: false }

    let psi_init_conf = tr_psi(conf, 0.5)
    let psi_init_calm = tr_psi(calm, 0.5)

    let rConf = tension_resolve_depth(conf, full, 0.3, 0.5, 200, 2, 0.06, cfgON)
    let rCalm = tension_resolve_depth(calm, full, 0.3, 0.5, 200, 2, 0.06, cfgON)
    let rAbl  = tension_resolve_depth(conf, full, 0.3, 0.5, 200, 2, 0.06, cfgOFF)
    let depConf = rConf[0]  let psiConf = rConf[1]
    let depCalm = rCalm[0]
    let depAbl  = rAbl[0]

    if _ab("BAR1 conflict_settles: conflicted Ψ_init=1.0 → depth>0 & |Ψ-0.5|<0.06",
           depConf > 0.0 && (psiConf - 0.5 < 0.06 && 0.5 - psiConf < 0.06)) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR2 calm_at_zero: calm Ψ_init=0.5 settles at depth 0",
           depCalm == 0.0) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR3 distinct_depth: conflicted depth STRICTLY > calm depth (earned read)",
           depConf > depCalm) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR4 ablate_INERT: coupling OFF on conflicted → never settles (depth=-1)",
           depAbl < 0.0) { npass=npass+1 } else { nfail=nfail+1 }

    println("INFO psi_init_conf=" + to_string(psi_init_conf) + " psi_init_calm=" + to_string(psi_init_calm))
    println("INFO depConf=" + to_string(depConf) + " psiConf=" + to_string(psiConf)
          + " depCalm=" + to_string(depCalm) + " depAbl=" + to_string(depAbl))
    println("--- H_9042 WIRED-live runtime-check (lane 75 tension-r): "
          + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
