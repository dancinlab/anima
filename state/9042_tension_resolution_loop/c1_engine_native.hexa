// c1_engine_native.hexa — H_9042 ENGINE-NATIVE measurement of the NEW iterated A⇄G conflict-resolution
// loop op `tension_resolve_depth` on LIVE core/engine_cli.hexa. Frame-shift C1 (H_9041 follow-on):
// ci_psi_balance is ONE-SHOT and reentry_settle drives a SINGLE non-competing stimulus — NEITHER
// iterates the A⇄G coupling to pull a CONFLICTED (polarized, Ψ≠½) emit/silence POPULATION back to the
// Ψ=½ fixed point. This harness builds a conflicted population (all trials over-emitting, Ψ_init=1.0)
// and measures, with PRE-REGISTERED bars (no tune-to-green):
//   BAR1 struct_settles  : the Ψ-PRESERVING operator (op=2 row-stochastic) drives Ψ→½ within maxdepth.
//   BAR2 monotone        : settle depth is NON-DECREASING with conflict magnitude (severe ≥ mild, >0).
//   BAR3 genuine_not_triv: the naive AMPLIFYING operator (op=0 = generic diffusion the numpy screen
//                          used) does NOT settle — it amplifies Ψ→1.0 (settle_depth = -1). Only the
//                          engine-specific Ψ-preserving A⇄G op has a Ψ=½ restoring force.
//   BAR4 ablate_INERT    : cfg.topo_couple OFF → no coupling → Ψ stays at its conflicted start (=init),
//                          settle_depth = -1.
//   INFO topology-axis   : structured RING adj vs SHUFFLED-ring adj (both op=2) — reports whether the
//                          specific topology matters or the redistribution is topology-agnostic.
// usage: hexa run state/9042_tension_resolution_loop/c1_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

// build_row — one 15-lane trial: emit-drive lanes 0 & 4 = c (the conflict level), the other 13 = other.
fn build_row(c: float, other: float) -> [float] {
    let mut r = []
    let mut i = 0
    while i < 15 {
        if i == 0 || i == 4 { r = r + [c] } else { r = r + [other] }
        i = i + 1
    }
    return r
}

// build_pop — a CONFLICTED population: 8 trials, ALL over-emitting (drive = c ≥ ½ → Ψ_init = 1.0), but
// 4 "high" trials whose whole-substrate mean sits ABOVE ½ (0.60) and 4 "low" trials whose mean sits
// BELOW ½ (0.40). A Ψ-preserving redistribution pulls each trial's emit lanes toward its substrate
// mean ⇒ the 4 low trials fall below ½ while the 4 high stay above ⇒ Ψ resolves to 4/8 = ½.
//   high other-lane value = (9-2c)/13 ⇒ trial mean = 9/15 = 0.60 ; low = (6-2c)/13 ⇒ mean = 6/15 = 0.40.
fn build_pop(c: float) -> [[float]] {
    let h = (9.0 - 2.0 * c) / 13.0
    let l = (6.0 - 2.0 * c) / 13.0
    let mut pop = []
    let mut t = 0
    while t < 4 { pop = pop + [build_row(c, h)]  t = t + 1 }
    t = 0
    while t < 4 { pop = pop + [build_row(c, l)]  t = t + 1 }
    return pop
}

fn zeros15() -> [[float]] {
    let mut a = []
    let mut i = 0
    while i < 15 {
        let mut row = []
        let mut j = 0
        while j < 15 { row = row + [0.0]  j = j + 1 }
        a = a + [row]
        i = i + 1
    }
    return a
}

// adj_full — fully-connected uniform coupling (every lane couples to every other).
fn adj_full() -> [[float]] {
    let mut a = []
    let mut i = 0
    while i < 15 {
        let mut row = []
        let mut j = 0
        while j < 15 {
            if i == j { row = row + [0.0] } else { row = row + [1.0] }
            j = j + 1
        }
        a = a + [row]
        i = i + 1
    }
    return a
}

// adj_ring — structured sparse coupling: lane i couples only to i±1 (a 15-cycle).
fn adj_ring() -> [[float]] {
    let mut a = zeros15()
    let mut i = 0
    while i < 15 {
        let nxt = (i + 1) % 15
        a[i][nxt] = 1.0
        a[nxt][i] = 1.0
        i = i + 1
    }
    return a
}

// adj_shuf — SHUFFLED ring: the same 15 edges laid on a fixed SCRAMBLED lane order (incoherent
// coupling). Still a connected 2-regular cycle, so if it settles too the redistribution is
// topology-agnostic (honest c9 finding), not carried by the specific adjacency.
fn adj_shuf() -> [[float]] {
    let perm = [0, 7, 3, 11, 1, 9, 5, 14, 2, 12, 6, 10, 4, 13, 8]
    let mut a = zeros15()
    let mut i = 0
    while i < 15 {
        let u = perm[i]
        let v = perm[(i + 1) % 15]
        a[u][v] = 1.0
        a[v][u] = 1.0
        i = i + 1
    }
    return a
}

fn main() {
    let mut npass = 0
    let mut nfail = 0

    let THR = 0.5
    let EPS = 0.06          // |Ψ−½|<0.06 ⇒ only 4/8 (=½) passes for an 8-trial population (8 → 0.125 grid)
    let ALPHA = 0.3
    let MAXD = 200
    let cfgON = EngineConfig { mitosis: true, engine: "conv", topo_couple: true, savant: false }
    let cfgOFF = EngineConfig { mitosis: true, engine: "conv", topo_couple: false, savant: false }

    let full = adj_full()
    let popSev = build_pop(0.95)      // severe conflict: emit lanes pinned at 0.95
    let popMild = build_pop(0.65)     // mild conflict: emit lanes at 0.65

    let psi_init_sev = tr_psi(popSev, THR)
    let psi_init_mild = tr_psi(popMild, THR)

    // ---- BAR1 + BAR2: Ψ-preserving op (2 = row-stochastic) settles, depth ∝ conflict ----
    let rSev = tension_resolve_depth(popSev, full, ALPHA, THR, MAXD, 2, EPS, cfgON)
    let rMild = tension_resolve_depth(popMild, full, ALPHA, THR, MAXD, 2, EPS, cfgON)
    let depSev = rSev[0]   let psiSev = rSev[1]
    let depMild = rMild[0] let psiMild = rMild[1]

    // ---- BAR3: naive AMP op (0 = generic diffusion) does NOT settle (amplifies Ψ→1.0) ----
    let rAmp = tension_resolve_depth(popSev, full, ALPHA, THR, MAXD, 0, EPS, cfgON)
    let depAmp = rAmp[0] let psiAmp = rAmp[1]

    // ---- BAR4: ablate (coupling OFF) → INERT (Ψ stays at conflicted init) ----
    let rAbl = tension_resolve_depth(popSev, full, ALPHA, THR, MAXD, 2, EPS, cfgOFF)
    let depAbl = rAbl[0] let psiAbl = rAbl[1]

    // ---- INFO: topology axis — structured RING vs SHUFFLED-ring, both op=2 ----
    let rRing = tension_resolve_depth(popSev, adj_ring(), ALPHA, THR, MAXD, 2, EPS, cfgON)
    let rShuf = tension_resolve_depth(popSev, adj_shuf(), ALPHA, THR, MAXD, 2, EPS, cfgON)

    // Pre-registered bar checks
    if _ab("BAR1 struct_settles: op=2 severe Ψ→½ (settle_depth>=0 & |psi-0.5|<eps)",
           depSev >= 0.0 && (psiSev - THR < EPS && THR - psiSev < EPS)) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR2 monotone: depth(severe) >= depth(mild) > 0",
           depSev >= depMild && depMild > 0.0) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR3 genuine: op=0 AMP does NOT settle (settle=-1 & psi>=0.90)",
           depAmp < 0.0 && psiAmp >= 0.90) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("BAR4 ablate INERT: coupling OFF → psi==init & settle=-1",
           depAbl < 0.0 && psiAbl > psi_init_sev - 0.0001 && psiAbl < psi_init_sev + 0.0001) { npass=npass+1 } else { nfail=nfail+1 }

    println("INFO psi_init_sev=" + to_string(psi_init_sev) + " psi_init_mild=" + to_string(psi_init_mild))
    println("INFO PRESERVE(op2): depSev=" + to_string(depSev) + " psiSev=" + to_string(psiSev)
          + " depMild=" + to_string(depMild) + " psiMild=" + to_string(psiMild))
    println("INFO AMP(op0): depAmp=" + to_string(depAmp) + " psiAmp=" + to_string(psiAmp))
    println("INFO ABLATE(off): depAbl=" + to_string(depAbl) + " psiAbl=" + to_string(psiAbl))
    println("INFO TOPOLOGY: ring dep=" + to_string(rRing[0]) + " psi=" + to_string(rRing[1])
          + " | shuf dep=" + to_string(rShuf[0]) + " psi=" + to_string(rShuf[1]))
    println("--- H_9042 C1 engine-native: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
