// ════════════════════════════════════════════════════════════════════════
// state/1560_third_law_capacity/h1560_r2_reopening_sweep.hexa
//
// H_1560 R2 — REOPENING SWEEP (abstract sweep expansion). Quantifies how much the
// capacity-wall "ability-expression rate" rises as inhibition I is pushed from the
// golden-zone UPPER bound (0.5) → CENTER (1/e) → LOWER bound (0.2123) → BELOW.
//
// ENGINE-NATIVE: calls the LIVE core/engine_cli.hexa §ThirdLaw ops
// (third_law_singularity / third_law_ability, which REUSE SAVANT sa_in_golden_zone) +
// the canonical SAVANT golden-zone constants (sa_gz_lower/_upper/_center). NO numpy,
// NO torch — a_engine_native_learning. Pure deterministic G=D×P/I geometry classifier.
//
// PER-I ability-expression RATE = fraction of the (D×P) plane (each axis swept over
// [0.05,0.95]) that EXPRESSES ability at a fixed inhibition I, i.e. is a singularity
// (G=D·P/I > SING_THR) AND I ∈ golden-zone (live sa_in_golden_zone). This is the
// "reopening" quantity: does I↓ lift the expression rate above the baseline 1/3?
//
// ⚠️ SCOPE LIMIT (c9): this is the G=D×P/I geometry ABSTRACT sweep, NOT a real
// learning binding/FALS expression rate. The real learning-side reopening demonstration
// is a GPU cost-gate (deferred ING, NOT fired here).
//
// 사용법: hexa run state/1560_third_law_capacity/h1560_r2_reopening_sweep.hexa
// ════════════════════════════════════════════════════════════════════════

import "core/engine_cli.hexa"

fn abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }  return x }

fn _linspace(a: float, b: float, n: int) -> [float] {
    let mut out = []
    if n <= 1 { out = out + [a]  return out }
    let step = (b - a) / to_float(n - 1)
    let mut i = 0
    while i < n { out = out + [a + step * to_float(i)]  i = i + 1 }
    return out
}

// PER-I ability-expression rate over the (D×P) plane at fixed inhibition I (LIVE op).
// ability=1 iff third_law_singularity(d,p,I) ∧ sa_in_golden_zone(I) — engine-native.
fn ability_rate_at(ii: float, nDP: int) -> float {
    let dg = _linspace(0.05, 0.95, nDP)
    let pg = _linspace(0.05, 0.95, nDP)
    let mut tot = 0
    let mut ab = 0
    let mut b = 0
    while b < nDP {
        let d = dg[b]
        let mut c = 0
        while c < nDP {
            tot = tot + 1
            if third_law_ability(d, pg[c], ii) == 1 { ab = ab + 1 }
            c = c + 1
        }
        b = b + 1
    }
    if tot == 0 { return 0.0 }
    return to_float(ab) / to_float(tot)
}

// PER-I singularity rate (ignoring the GZ gate) over (D×P) — the pure G>thr geometry.
// Used for the below-GZ regime where ability=0 by gate but singularity still rises.
fn sing_rate_at(ii: float, nDP: int) -> float {
    let dg = _linspace(0.05, 0.95, nDP)
    let pg = _linspace(0.05, 0.95, nDP)
    let mut tot = 0
    let mut s = 0
    let mut b = 0
    while b < nDP {
        let d = dg[b]
        let mut c = 0
        while c < nDP {
            tot = tot + 1
            if third_law_singularity(d, pg[c], ii) == 1 { s = s + 1 }
            c = c + 1
        }
        b = b + 1
    }
    if tot == 0 { return 0.0 }
    return to_float(s) / to_float(tot)
}

fn main() {
    println("=== H_1560 R2 — REOPENING SWEEP (live §ThirdLaw ops · engine-native) ===")

    let gz_lo = sa_gz_lower()      // 0.21231792755821914
    let gz_up = sa_gz_upper()      // 0.5
    let gz_ce = sa_gz_center()     // 1/e ≈ 0.3678794
    println("GZ_LOWER=" + to_string(gz_lo) + " GZ_CENTER=" + to_string(gz_ce) + " GZ_UPPER=" + to_string(gz_up))

    // I grid: from GZ_UPPER (0.5) down through GZ_CENTER, GZ_LOWER, then BELOW the floor.
    let igrid = [0.50, 0.45, 0.40, gz_ce, 0.30, 0.25, gz_lo, 0.18, 0.15, 0.10, 0.05]
    let nDP = 100               // (D×P) plane resolution = 10,000 points per I

    println("")
    println("--- per-I ability-expression rate (D×P plane, nDP=" + to_string(nDP) + ") ---")
    let mut r_upper = 0.0
    let mut r_center = 0.0
    let mut r_lower = 0.0
    let mut below_max = 0.0
    let mut monotone_ok = 1
    let mut prev = 0.0 - 1.0
    let mut i = 0
    while i < len(igrid) {
        let ii = igrid[i]
        let ar = ability_rate_at(ii, nDP)
        let sr = sing_rate_at(ii, nDP)
        let ingz = sa_in_golden_zone(ii)
        println("I=" + to_string(ii) + "  ability_rate=" + to_string(ar)
                + "  sing_rate=" + to_string(sr) + "  inGZ=" + to_string(ingz))
        // capture key points
        if abs_f(ii - gz_up) < 0.0001 { r_upper = ar }
        if abs_f(ii - gz_ce) < 0.0001 { r_center = ar }
        if abs_f(ii - gz_lo) < 0.0001 { r_lower = ar }
        if ii < gz_lo { if ar > below_max { below_max = ar } }
        // monotone non-decreasing as I drops, WITHIN the golden zone (I >= gz_lo)
        if ii >= gz_lo {
            if prev >= 0.0 { if ar < prev - 0.0000001 { monotone_ok = 0 } }
            prev = ar
        }
        i = i + 1
    }

    // ── R2 FROZEN bars (pre-registered BEFORE measurement, c9 frozen-first) ──
    // R2-B1 reopening DIRECTION: ability rate rises as I→GZ_LOWER (monotone within GZ
    //   AND rate(GZ_LOWER) strictly > rate(GZ_UPPER)).
    let b1 = (monotone_ok == 1) && (r_lower > r_upper)
    // R2-B2 reopening MAGNITUDE: rate(GZ_LOWER) ≥ 0.50 (ability expressed in >half the
    //   D×P plane at the golden-zone floor — crosses ABOVE the baseline 1/3).
    let b2 = r_lower >= 0.50
    // R2-B3 below-GZ CLIFF: below GZ_LOWER (I<0.2123) ability rate = 0 (reopening is
    //   BOUNDED by the golden zone — disinhibition past the floor does NOT keep expressing).
    let b3 = below_max <= 0.0000001

    println("")
    println("r(GZ_UPPER=0.5)=" + to_string(r_upper) + "  r(GZ_CENTER)=" + to_string(r_center) + "  r(GZ_LOWER)=" + to_string(r_lower))
    println("below-GZ max ability_rate=" + to_string(below_max))
    println("R2-B1 reopening DIRECTION (monotone in GZ ∧ lower>upper) -> " + to_string(b1))
    println("R2-B2 reopening MAGNITUDE  (r(GZ_LOWER) >= 0.50)          -> " + to_string(b2))
    println("R2-B3 below-GZ CLIFF       (below ability_rate == 0)      -> " + to_string(b3))

    // ── R2-B4 SING_THR sensitivity: the reopening DIRECTION must hold across a range of
    //   singularity thresholds (not a single-threshold artifact). We can't change the
    //   engine SING_THR (frozen 0.70) so we re-derive ability with an EXPLICIT thr by
    //   recomputing G=third_law_score and the SAME live sa_in_golden_zone gate. ──
    let thrs = [0.50, 0.70, 1.00]
    let mut b4 = 1
    println("")
    println("--- R2-B4 SING_THR sensitivity (reopening direction across thr) ---")
    let mut ti = 0
    while ti < len(thrs) {
        let thr = thrs[ti]
        let ru = _ability_rate_thr(gz_up, nDP, thr)
        let rl = _ability_rate_thr(gz_lo, nDP, thr)
        let dir = rl > ru
        println("thr=" + to_string(thr) + "  r(upper)=" + to_string(ru) + "  r(lower)=" + to_string(rl) + "  lower>upper=" + to_string(dir))
        if dir == false { b4 = 0 }
        ti = ti + 1
    }

    // ── R2-B5 scale-invariance of the reopening CURVE: rate(GZ_LOWER) and rate(GZ_UPPER)
    //   stable across (D×P) grid resolution 32 / 100 / 300 (Δ < 0.02). ──
    let lo32  = ability_rate_at(gz_lo, 32)
    let lo100 = ability_rate_at(gz_lo, 100)
    let lo300 = ability_rate_at(gz_lo, 300)
    let up32  = ability_rate_at(gz_up, 32)
    let up100 = ability_rate_at(gz_up, 100)
    let up300 = ability_rate_at(gz_up, 300)
    let dlo = abs_f(lo32 - lo300)
    let dup = abs_f(up32 - up300)
    let b5 = (dlo < 0.02) && (dup < 0.02)
    println("")
    println("--- R2-B5 scale-invariance of reopening curve (nDP 32/100/300) ---")
    println("r(GZ_LOWER): 32=" + to_string(lo32) + " 100=" + to_string(lo100) + " 300=" + to_string(lo300) + "  Δ=" + to_string(dlo))
    println("r(GZ_UPPER): 32=" + to_string(up32) + " 100=" + to_string(up100) + " 300=" + to_string(up300) + "  Δ=" + to_string(dup))
    println("R2-B5 scale-invariant (Δ<0.02) -> " + to_string(b5))

    // ── headline reopening quantity ──
    let lift = r_lower - r_upper
    println("")
    println("=== HEADLINE: reopening lift = r(GZ_LOWER) - r(GZ_UPPER) = " + to_string(lift) + " ===")
    if r_lower > 0.3333334 {
        println("REOPENING: ability-expression rate RISES ABOVE the baseline 1/3 as I↓ (1/3 is NOT a hard ceiling along I).")
    } else {
        println("HARD CONSTANT: ability-expression rate stays at/below 1/3 — 1/3 is an I-invariant hard structural constant.")
    }

    let all_pass = b1 && b2 && b3 && (b4 == 1) && b5
    println("")
    println("R2_ALL_PASS=" + to_string(all_pass) + " (B1=" + to_string(b1) + " B2=" + to_string(b2) + " B3=" + to_string(b3) + " B4=" + to_string(b4 == 1) + " B5=" + to_string(b5) + ")")
    if all_pass == false {
        println("NOTE: an R2 bar did not pass — reported honestly (c9, frozen-first, no tune-to-green).")
    }
}

// _ability_rate_thr — ability-expression rate at fixed I with an EXPLICIT singularity
// threshold thr (re-derives G via the LIVE third_law_score + LIVE sa_in_golden_zone gate;
// the only freedom is the comparison thr, used solely for the B4 robustness sweep).
fn _ability_rate_thr(ii: float, nDP: int, thr: float) -> float {
    let dg = _linspace(0.05, 0.95, nDP)
    let pg = _linspace(0.05, 0.95, nDP)
    let ingz = sa_in_golden_zone(ii)
    let mut tot = 0
    let mut ab = 0
    let mut b = 0
    while b < nDP {
        let d = dg[b]
        let mut c = 0
        while c < nDP {
            tot = tot + 1
            if ingz == 1 {
                if third_law_score(d, pg[c], ii) > thr { ab = ab + 1 }
            }
            c = c + 1
        }
        b = b + 1
    }
    if tot == 0 { return 0.0 }
    return to_float(ab) / to_float(tot)
}
