// f4_engine_native.hexa — FABLE#4 H_9099: ground self_drift_exp content_axis in the REAL 303M
// PENULTIMATE pooled representation (clm_penult_pooled -> yn mean-pool, live core/decode.hexa
// forward of d768.clm, own-GEMM GPU) and test whether the self-chain becomes a FUNCTION OF
// ACTUAL EXPERIENCED CONTENT vs the synthetic/int-blind self_drift. engine-native, NO numpy.
// This harness calls the LANDED core/decode.hexa op (returns [float] pooled, d = len).
// usage: CLM_PROD_DEVRESIDENT=1 hexa run state/9099_selfchain_content_grounding/f4_engine_native.hexa
import "core/decode.hexa"
import "core/engine_cli.hexa"

const D768: string = "d768.clm"
const SELFDIM: int = 32
const STEP: float = 1.0

fn _modi(x: int, m: int) -> int { return x - (x/m)*m }

// LANDED clm_penult_pooled returns [float] pooled directly (d = len).
fn _pooled(text: string) -> list {
    return clm_penult_pooled(D768, text)
}

fn _top3(pv: list, n: int) -> list {
    let mut i0 = -1  let mut i1 = -1  let mut i2 = -1
    let mut v0 = -1000000000.0  let mut v1 = -1000000000.0  let mut v2 = -1000000000.0
    let mut k = 0
    while k < n {
        let v = pv[k]
        if v > v0 { v2=v1 i2=i1  v1=v0 i1=i0  v0=v i0=k }
        else { if v > v1 { v2=v1 i2=i1  v1=v i1=k } else { if v > v2 { v2=v i2=k } } }
        k = k+1
    }
    return [i0, i1, i2]
}

fn _cosv(a: list, b: list, n: int) -> float {
    let mut dot=0.0  let mut na=0.0  let mut nb=0.0
    let mut k=0
    while k<n { let x=a[k]  let y=b[k]  dot=dot+x*y  na=na+x*x  nb=nb+y*y  k=k+1 }
    let den = sqrt(na)*sqrt(nb)
    if den <= 0.0 { return 0.0 }
    return dot/den
}

// single-input chain from top-3 coarsened penult axes
fn _chain3(t: list) -> SelfIdentity {
    let c0 = _modi(to_int(t[0]), SELFDIM)
    let c1 = _modi(to_int(t[1]), SELFDIM)
    let c2 = _modi(to_int(t[2]), SELFDIM)
    let s0 = self_new(SELFDIM, 0)
    let s1 = self_drift_exp(s0, c0, STEP)
    let s2 = self_drift_exp(s1, c1, STEP)
    return self_drift_exp(s2, c2, STEP)
}

// 3-input STREAM from top-1 coarsened axis per input
fn _stream(a: int, b: int, c: int) -> SelfIdentity {
    let s0 = self_new(SELFDIM, 0)
    let s1 = self_drift_exp(s0, a, STEP)
    let s2 = self_drift_exp(s1, b, STEP)
    return self_drift_exp(s2, c, STEP)
}

fn main() {
    let dev = env("CLM_PROD_DEVRESIDENT")
    println("[cfg] CLM_PROD_DEVRESIDENT=" + dev + " cuda=" + to_string(cuda_available()))

    // six DISTINCT real inputs (distinct last-24-byte windows: ko/en, distinct topics)
    let I0 = "안녕하세요 오늘 날씨가 정말 좋네요 산책하기 좋은 날이에요"
    let I1 = "The quick brown fox jumps over the lazy dog near the river"
    let I2 = "인공지능과 의식에 대한 철학적 질문을 깊이 생각해 봅니다"
    let I3 = "def train_model(data): return model.fit(data, epochs=10)"
    let I4 = "오늘 점심으로 김치찌개를 아주 맛있게 먹었습니다 배불러요"
    let I5 = "Quantum entanglement links two distant particles instantly"

    let p0=_pooled(I0)  let p1=_pooled(I1)  let p2=_pooled(I2)
    let p3=_pooled(I3)  let p4=_pooled(I4)  let p5=_pooled(I5)
    let d = len(p0)
    println("[penult] d=" + to_string(d))

    let t0=_top3(p0,d)  let t1=_top3(p1,d)  let t2=_top3(p2,d)
    let t3=_top3(p3,d)  let t4=_top3(p4,d)  let t5=_top3(p5,d)
    println("[top3] t0=" + to_string(to_int(t0[0])) + "," + to_string(to_int(t0[1])) + "," + to_string(to_int(t0[2])))
    println("[top3] t1=" + to_string(to_int(t1[0])) + "," + to_string(to_int(t1[1])) + "," + to_string(to_int(t1[2])))
    println("[top3] t2=" + to_string(to_int(t2[0])) + "," + to_string(to_int(t2[1])) + "," + to_string(to_int(t2[2])))
    println("[top3] t3=" + to_string(to_int(t3[0])) + "," + to_string(to_int(t3[1])) + "," + to_string(to_int(t3[2])))
    println("[top3] t4=" + to_string(to_int(t4[0])) + "," + to_string(to_int(t4[1])) + "," + to_string(to_int(t4[2])))
    println("[top3] t5=" + to_string(to_int(t5[0])) + "," + to_string(to_int(t5[1])) + "," + to_string(to_int(t5[2])))

    // single-input chains
    let s0=_chain3(t0)  let s1=_chain3(t1)  let s2=_chain3(t2)
    let s3=_chain3(t3)  let s4=_chain3(t4)  let s5=_chain3(t5)

    // ---- BAR1 REAL-SEPARATES: mean pairwise chain distance over 15 pairs
    let ss = [s0,s1,s2,s3,s4,s5]
    let mut sumdist = 0.0  let mut npair = 0
    let mut i = 0
    while i < 6 {
        let mut j = i+1
        while j < 6 {
            let c = self_cos(ss[i], ss[j])
            sumdist = sumdist + (1.0 - c)
            npair = npair + 1
            j = j+1
        }
        i = i+1
    }
    let meandist = sumdist / to_float(npair)

    // ---- BAR3 REPRODUCIBLE: re-extract I0 -> chain -> self_cos with s0
    let p0b = _pooled(I0)
    let t0b = _top3(p0b, d)
    let s0b = _chain3(t0b)
    let repro = self_cos(s0, s0b)

    // ---- BAR2 SYNTHETIC-BLIND: self_drift(tick) ignores content -> two streams identical
    let bl0 = self_new(SELFDIM,0)
    let ba1 = self_drift(bl0,0,STEP)  let ba2 = self_drift(ba1,1,STEP)  let baL = self_drift(ba2,2,STEP)
    let bb1 = self_drift(bl0,0,STEP)  let bb2 = self_drift(bb1,1,STEP)  let bbL = self_drift(bb2,2,STEP)
    let blind_dist = 1.0 - self_cos(baL, bbL)

    // ---- BAR4 CONTENT-LOCKED: streams via top-1 coarsened axis per input
    let a0=_modi(to_int(t0[0]),SELFDIM)  let a1=_modi(to_int(t1[0]),SELFDIM)  let a2=_modi(to_int(t2[0]),SELFDIM)
    let a3=_modi(to_int(t3[0]),SELFDIM)  let a4=_modi(to_int(t4[0]),SELFDIM)  let a5=_modi(to_int(t5[0]),SELFDIM)
    let P  = _stream(a0,a1,a2)
    let Pp = _stream(a2,a0,a1)     // same content set, shuffled order
    let Q  = _stream(a3,a4,a5)     // different content
    let fit_same = self_cos(P, Pp)
    let fit_diff = self_cos(P, Q)

    // ---- BAR5 GEOMETRY-TRACKING: split 15 pairs by penult cos above/below mean -> chain self_cos
    let pv = [p0,p1,p2,p3,p4,p5]
    let mut sumpc = 0.0
    i = 0
    while i < 6 { let mut j=i+1  while j<6 { sumpc = sumpc + _cosv(pv[i],pv[j],d)  j=j+1 }  i=i+1 }
    let meanpc = sumpc / to_float(npair)
    let mut hi_s=0.0  let mut hi_n=0  let mut lo_s=0.0  let mut lo_n=0
    i = 0
    while i < 6 {
        let mut j=i+1
        while j<6 {
            let pc = _cosv(pv[i],pv[j],d)
            let cc = self_cos(ss[i], ss[j])
            if pc >= meanpc { hi_s=hi_s+cc  hi_n=hi_n+1 } else { lo_s=lo_s+cc  lo_n=lo_n+1 }
            j=j+1
        }
        i=i+1
    }
    let hi_mean = if hi_n>0 { hi_s/to_float(hi_n) } else { 0.0 }
    let lo_mean = if lo_n>0 { lo_s/to_float(lo_n) } else { 0.0 }
    let track_margin = hi_mean - lo_mean

    // ---- verdicts
    let bar1 = meandist >= 0.10
    let bar2 = blind_dist <= 0.000001
    let bar3 = repro >= 0.999999
    let bar4 = (fit_same - fit_diff) >= 0.05
    let bar5 = track_margin >= 0.05

    println("RAW meandist(real 15pair)=" + to_string(meandist) + " npair=" + to_string(npair))
    println("RAW blind_dist(synthetic self_drift)=" + to_string(blind_dist))
    println("RAW repro self_cos(I0 twice)=" + to_string(repro))
    println("RAW fit_same(P,P-shuf)=" + to_string(fit_same) + " fit_diff(P,Q)=" + to_string(fit_diff) + " gap=" + to_string(fit_same-fit_diff))
    println("RAW meanPenultCos=" + to_string(meanpc) + " hi_mean(chain)=" + to_string(hi_mean) + "(n=" + to_string(hi_n) + ") lo_mean=" + to_string(lo_mean) + "(n=" + to_string(lo_n) + ") track_margin=" + to_string(track_margin))
    let mut np=0
    if bar1 { println("PASS BAR1 REAL-SEPARATES meandist>=0.10")  np=np+1 } else { println("FAIL BAR1 REAL-SEPARATES") }
    if bar2 { println("PASS BAR2 SYNTHETIC-BLIND dist<=1e-6")  np=np+1 } else { println("FAIL BAR2 SYNTHETIC-BLIND") }
    if bar3 { println("PASS BAR3 REPRODUCIBLE self_cos>=0.999999")  np=np+1 } else { println("FAIL BAR3 REPRODUCIBLE") }
    if bar4 { println("PASS BAR4 CONTENT-LOCKED gap>=0.05")  np=np+1 } else { println("FAIL BAR4 CONTENT-LOCKED") }
    if bar5 { println("PASS BAR5 GEOMETRY-TRACKING margin>=0.05")  np=np+1 } else { println("FAIL BAR5 GEOMETRY-TRACKING (argmax coarse)") }
    println("--- FABLE#4 H_9099: " + to_string(np) + "/5 PASS ---")
    let green = bar1 && bar2 && bar3 && bar4 && bar5
    if green { println("VERDICT: GREEN real-grounding BEATS synthetic") } else { if bar1 && bar2 && bar3 && bar4 { println("VERDICT: PARTIAL/DIRECTIONAL real grounds content identity; graded-geometry BAR5 fails") } else { println("VERDICT: see failing bars (honest)") } }
}
