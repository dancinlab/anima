// g1_parity_fixture.hexa — byte-parity oracle for the multi-seed G1 refmatch (a_engine_native_learning
// 2-production lockstep). Drives the LIVE core/g_gates.hexa g_eval_g1_seeded on a fixed tiny .clm
// fixture for a fixed base_seed, printing the per-seed counts. The py counterpart
// (g1_parity_fixture.py) runs core/g_gates.py g_eval_g1_seeded with the IDENTICAL ckpt/seed/gen.
// PASS = identical max_single / best_distinct / pass(clears) (the metric is a deterministic
// function of the decode text, so identical ideate text => identical counts).
import "core/g_gates.hexa"

fn main() {
    let ck   = exec("printf %s \"$FX_CK\"")
    let seed = to_int(exec("printf %s \"$FX_SEED\""))
    let gen  = to_int(exec("printf %s \"$FX_GEN\""))
    let known = _g6_dict_load()
    let r = g_eval_g1_seeded(ck, gen, known, seed)
    println("base_seed:" + to_string(r["base_seed"]))
    println("max_single:" + to_string(r["max_single"]))
    println("best_k:" + to_string(r["best_k"]))
    println("best_distinct:" + to_string(r["best_distinct"]))
    println("pass:" + to_string(r["pass"]))
}
