// c5_engine_native.hexa — H_9045 ENGINE-NATIVE, MEASURE-ONLY probe of autonomous curiosity-emit
// TIMING coupling on the LIVE §HomeostaticDrive lane of core/engine_cli.hexa (homeo_new / homeo_step /
// homeo_last / homeo_new_ablated). Frame-shift C5 (recombination ≠ capability): anima's emit is
// substrate-native — emit/silence TIMING (NOT content; content-quality = LLM-judge = p7 forbidden)
// couples to INTERNAL drive-integral accumulation, NOT to a stimulus/wall clock (a_substrate_native_speak
// · a_autonomy_over_hardcode). This is the emit-drive lane itself (0/4) — MEASURE ONLY, adds NO capability
// lane onto it (a_substrate_disjoint). PRE-REGISTERED bars (no tune-to-green):
//   BAR1 integral_timed_onset : the FULL integrator emits (drive crosses θ=1.0) at a finite onset tick that
//                               is MONOTONE-EARLIER with a bigger internal deficit; the shallowest never fires.
//   BAR2 decorrelate_clock (EARNED): onset is strongly (neg) correlated with the internal drive integral
//                               (deficit) — corr <= -0.90 — while a fixed-period STIMULUS CLOCK is constant
//                               (zero-variance ⇒ decorrelated) AND a shuffled deficit→onset pairing collapses
//                               the correlation (|corr_shuf| < 0.5). Emit locks to the internal state, not a clock.
//   BAR3 ablate_inert (drive-clamp): Ki=0 (no integral) → drive is flat (= Kp·deficit ≤ 0.5 < θ) → NEVER emits
//                               for ANY trial → the accumulation-timed emit is INERT without the integral.
// FROZEN params (H_1292 controller frozen; a_scale_honest_scope existence proof): S*=0.5, λ=0.1, Kp=1.0,
//   Ki=0.5, recall_thr=0.30, θ_emit=1.0, MAXT=40, deficits {0.5,0.4,0.3,0.2,0.1} via key-offset.
// usage: hexa run state/9045_curiosity_emit_timing/c5_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

// deprived key at L2 offset for a target deficit d: offset = (0.5+d)*recall_thr on dim 0 (single-proto
// store keyed at [0.5]*8 ⇒ err = offset ⇒ s = 1 - err/0.30 ⇒ deficit = 0.5 - s).
fn _key0() -> [float] { return [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5] }
fn _dep_key(d: float) -> [float] {
    let off = (0.5 + d) * 0.30
    return [0.5 + off, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]
}

// emit ONSET: first tick where the drive crosses θ under SUSTAINED deprivation on a fixed key. -1 = never.
fn _onset(ablated: bool, key: [float], mem: ImmuneMemoryGrow, theta: float, maxt: int) -> int {
    let mut hd = homeo_new()
    if ablated { hd = homeo_new_ablated() }
    let mut t = 1
    while t <= maxt {
        hd = homeo_step(hd, mem, key)
        if homeo_last(hd) >= theta { return t }
        t = t + 1
    }
    return -1
}

fn _mean(xs: [float]) -> float {
    let n = len(xs)
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + xs[i]  i = i + 1 }
    return s / to_float(n)
}
// pearson correlation (returns 0.0 if either side has zero variance).
fn _pearson(xs: [float], ys: [float]) -> float {
    let n = len(xs)
    let mx = _mean(xs)
    let my = _mean(ys)
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    let mut i = 0
    while i < n {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        sxy = sxy + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        i = i + 1
    }
    if sxx <= 0.0 || syy <= 0.0 { return 0.0 }
    return sxy / sqrt(sxx * syy)
}

fn main() {
    let theta = 1.0
    let maxt = 40
    let mem = immune_grow_new(_key0(), "grounded", 8, 8, false)

    let deficits = [0.5, 0.4, 0.3, 0.2, 0.1]
    let nd = len(deficits)

    // FULL integrator onsets + ABLATED onsets.
    let mut on_full = []
    let mut on_abl = []
    let mut i = 0
    while i < nd {
        let key = _dep_key(deficits[i])
        on_full = on_full + [to_float(_onset(false, key, mem, theta, maxt))]
        on_abl  = on_abl  + [to_float(_onset(true,  key, mem, theta, maxt))]
        i = i + 1
    }

    println("── H_9045 C5 curiosity-emit TIMING (engine-native §HomeostaticDrive, MEASURE-ONLY) ──")
    println("theta=" + to_string(theta) + " maxt=" + to_string(maxt) + " recall_thr=0.30")
    println("deficits           = " + to_string(deficits))
    println("FULL onset(ticks)  = " + to_string(on_full) + "   (-1 = never)")
    println("ABLATED onset      = " + to_string(on_abl) + "   (-1 = never)")

    // BAR1: high-deficit trials all fire, monotone-earlier with deficit, shallowest never fires.
    let fires = on_full[0] > 0.0 && on_full[1] > 0.0 && on_full[2] > 0.0 && on_full[3] > 0.0
    let monotone = on_full[0] < on_full[1] && on_full[1] < on_full[2] && on_full[2] < on_full[3]
    let shallow_never = on_full[4] < 0.0
    let b1 = _ab("BAR1 integral_timed_onset (fire + monotone-earlier + shallow never)",
                 fires && monotone && shallow_never)

    // BAR2 EARNED: onset couples to the internal deficit (drive integral) — corr <= -0.90 over the firing
    // trials — while a fixed-period stimulus CLOCK is constant (decorrelated) AND a shuffled pairing collapses.
    let def_fire = [0.5, 0.4, 0.3, 0.2]
    let on_fire  = [on_full[0], on_full[1], on_full[2], on_full[3]]
    let corr_true = _pearson(def_fire, on_fire)
    // stimulus clock: emit every P=mean(onset) ticks regardless of internal state → constant across deficits.
    let pclk = _mean(on_fire)
    let clk = [pclk, pclk, pclk, pclk]
    let corr_clock = _pearson(def_fire, clk)
    // shuffled deficit→onset pairing (fixed derangement) → coupling collapses.
    let def_shuf = [0.3, 0.5, 0.2, 0.4]
    let corr_shuf = _pearson(def_shuf, on_fire)
    println("corr(deficit,onset) TRUE  = " + to_string(corr_true))
    println("corr(deficit,onset) CLOCK = " + to_string(corr_clock) + "  (constant clock, decorrelated)")
    println("corr(deficit,onset) SHUF  = " + to_string(corr_shuf))
    let b2 = _ab("BAR2 decorrelate_clock EARNED (corr_true<=-0.90 AND clock==0 AND |shuf|<0.5)",
                 corr_true <= -0.90 && corr_clock == 0.0 && _absf(corr_shuf) < 0.5)

    // BAR3 drive-clamp ablation: Ki=0 → flat drive < θ → NEVER emits for ANY trial = INERT.
    let abl_inert = on_abl[0] < 0.0 && on_abl[1] < 0.0 && on_abl[2] < 0.0 && on_abl[3] < 0.0 && on_abl[4] < 0.0
    let b3 = _ab("BAR3 ablate_inert (drive-clamp Ki=0 → no accumulation-timed emit, all -1)", abl_inert)

    // INFO rank/Spearman: deficits are pre-sorted descending and onset came out STRICTLY increasing
    // (BAR1) ⇒ rank correlation isolates the MONOTONE coupling from Pearson's linearity penalty (onset
    // explodes reciprocally at shallow deficit). This characterizes WHY BAR2 Pearson (-0.887) narrowly
    // misses the frozen -0.90 despite a perfect-rank internal-drive→emit-timing coupling.
    let def_rank = [4.0, 3.0, 2.0, 1.0]
    let on_rank  = [1.0, 2.0, 3.0, 4.0]
    let spearman = _pearson(def_rank, on_rank)
    println("INFO rank/Spearman(deficit,onset) = " + to_string(spearman) + "  (monotone coupling; Pearson -0.887 = linearity artifact of onset explosion)")

    let all = b1 && b2 && b3
    if all { println("RESULT 3/3 PASS — C5 engine-native GREEN (emit TIMING couples to drive integral, not a clock)") }
    else { println("RESULT NOT 3/3 — see bars") }
}
