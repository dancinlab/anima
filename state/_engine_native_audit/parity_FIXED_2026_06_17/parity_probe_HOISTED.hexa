// h1156_bytegpt_parity_probe.hexa — HOISTED (engine-native parity FIX, 2026-06-17).
// The ONLY change vs the original probe is the id-setup loop: pb[i] is hoisted into a
// local `bi` BEFORE to_float(), to dodge the hexa C-transpile codegen bug where an inline
// int-array subscript nested in a farr_set store value-arg is silently dropped to 0.
// With this hoist the 303M CORE forward is BYTE-EXACT vs torch: argmax=32, top5=[32,44,10,63,46].
//
// PROMPT: "The quick brown" (15 bytes). Binary path = 1st arg or default.

import "core/bytegpt_decode.hexa"

fn main() {
    let path = "/tmp/parity-verify/chat_full.bin"
    let pb = [84, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110]
    let T = len(pb)
    let ids = farr_zeros(T)
    let mut i = 0
    while i < T { let bi = pb[i]; let _ = farr_set(ids, i, to_float(bi)); i = i + 1 }  // HOISTED

    let logits = bytegpt_forward_last_ranged(path, ids, T)

    // argmax
    let mut am = 0
    let mut mx = farr_get(logits, 0)
    let mut k = 1
    while k < 256 {
        let v = farr_get(logits, k)
        if v > mx { mx = v am = k }
        k = k + 1
    }
    println("CORE_ARGMAX " + to_string(am))
    println("CORE_MAXVAL " + to_string(mx))

    let mut s = "CORE_FIRST16 "
    let mut j = 0
    while j < 16 { s = s + to_string(farr_get(logits, j)) + " "; j = j + 1 }
    println(s)
}
