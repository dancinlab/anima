// H_1425 LENS 2 — a_break_the_wall: give the orthogonal channel its STRONGEST shot before
// 🧱. Two extra angles: (L2a) INVERTED-polarity NE (low deficit→high temp, the H_1284 R3
// regime-switch idea) and (L2b) the DIST breadth metric (distinct-coherent count) as M.
// If NEITHER an inverted schedule NOR a different breadth metric beats best-fixed, the
// orthogonal-channel wall is STRUCTURAL not signal-choice. Same frozen frames/decode/seeds.
import "CORE/g6_ideation.hexa"

let CKPT = "state/lane_p_clm/clm_d768_e2l1.clm"
let GEN = 48
let TOP_K = 40
let PROBE_GEN = 24
let T_LO = 0.5
let T_HI = 1.3

fn clamp01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }
fn decode_temp(frame: string, temp: float, seed: int) -> string {
    let r = gen_clm_ideate(CKPT, frame, GEN, TOP_K, temp, seed); return to_string(r["text"])
}
fn ne_for_frame(frame: string, seed: int, known: Map) -> float {
    let r = gen_clm_ideate(CKPT, frame, PROBE_GEN, TOP_K, 0.7, seed)
    return clamp01(1.0 - _g6_known_word_ratio(to_string(r["text"]), known))
}
fn dist_score(frames: list, temps: list, seed: int, known: Map) -> int {
    let word_sets = []
    let mut i = 0
    while i < len(frames) {
        let o = decode_temp(to_string(frames[i]), to_float(temps[i]), seed)
        if _g6_known_word_ratio(o, known) >= 0.5 { word_sets.push(_g6_words(o)) }
        i = i + 1
    }
    let kept = []
    let mut w = 0
    while w < len(word_sets) {
        let ws = word_sets[w]; let mut ok = true; let mut kk = 0
        while kk < len(kept) { if _g6_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    return len(kept)
}
fn const_temps(n: int, t: float) -> list {
    let out = []; let mut i = 0; while i < n { out.push(t); i = i + 1 } return out
}
fn main() {
    let known = _g6_dict_load()
    let fr = g6_build_frames(6); let frames = fr["composed"]; let nfr = len(frames)
    let T_GRID = [0.5, 0.7, 0.9, 1.1, 1.3]
    let seeds = [1425, 1426, 1427]
    let mut sumA = 0.0; let mut sumBinv = 0.0
    let mut si = 0
    while si < len(seeds) {
        let seed = to_int(seeds[si])
        // A best-fixed by DIST
        let mut bestA = -1
        let mut gi = 0
        while gi < len(T_GRID) {
            let d = dist_score(frames, const_temps(nfr, to_float(T_GRID[gi])), seed, known)
            if d > bestA { bestA = d }
            gi = gi + 1
        }
        // B-INVERTED: low deficit -> high temp (regime-switch polarity)
        let temps_inv = []
        let mut fi = 0
        while fi < nfr {
            let n = ne_for_frame(to_string(frames[fi]), seed, known)
            temps_inv.push(T_LO + (T_HI - T_LO) * (1.0 - n))   // INVERTED
            fi = fi + 1
        }
        let dInv = dist_score(frames, temps_inv, seed, known)
        print("seed " + to_string(seed) + " A_dist=" + to_string(bestA) + " B_inv_dist=" + to_string(dInv))
        sumA = sumA + to_float(bestA); sumBinv = sumBinv + to_float(dInv)
        si = si + 1
    }
    let ns = to_float(len(seeds))
    print("MEAN A_dist=" + to_string(sumA/ns) + " B_inverted_dist=" + to_string(sumBinv/ns))
    print("L2 c1 (inverted beats fixed by >=1): " + to_string((sumBinv/ns) >= (sumA/ns) + 1.0))
}
