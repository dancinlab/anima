// ════════════════════════════════════════════════════════════════════════
// H_1425 — NE decode-TEMPERATURE on IDEATION (orthogonal channel to the abstain margin).
//
// Tests the H_1422 NOT-RULED-OUT orthogonal channel: a norepinephrine (NE) =
// exploration/gain neuromodulator conditioning the IDEATION decode SAMPLING TEMPERATURE
// (clm_decode.hexa:737 `bv / temp`) on a signal ORTHOGONAL to the memory abstain margin —
// namely each frame's own IDEATION-GROUNDING DEFICIT (1 - kwr of a short probe decode).
// HIGH deficit → HIGH NE → HIGH temp (explore for novel-but-coherent recombination);
// LOW deficit → LOW NE → LOW temp (exploit). NOT circular (H_1422): the gate reads the
// GENERATED bytes, never the immune recall-margin.
//
// ENGINE-NATIVE: reuses CORE/g6_ideation.hexa (frozen tokenizer/frames/decode), golden d768
// .clm. NO torch. Metric = NOVEL distinct-novel-trigrams (+ DIST), the breadth metrics a small
// mouth CAN move (FALS=0 floor on d768, H_1394/H_1403 — reported diagnostic-only, c9).
//
// FROZEN BARS (FREEZE.txt): c1 M(B)>=M(A)+1.0 · c2 M(Bsh)<=M(A)+0.5 · c3 M(Babl)<=M(A)+0.5.

import "CORE/g6_ideation.hexa"

let CKPT = "state/lane_p_clm/clm_d768_e2l1.clm"
let GEN = 48
let TOP_K = 40
let PROBE_GEN = 24
let T_LO = 0.5
let T_HI = 1.3

// ── NOVEL metric: distinct novel word-trigrams across decodes, novel = NOT in corpus ──
fn _corpus_trigrams() -> Map {
    let cz = _g6_concepts()
    let m = #{}
    let mut ci = 0
    while ci < len(cz) {
        let w = _g6_words(to_string(cz[ci]))
        let mut i = 0
        while i + 2 < len(w) {
            let g = to_string(w[i]) + "|" + to_string(w[i+1]) + "|" + to_string(w[i+2])
            m[g] = 1
            i = i + 1
        }
        ci = ci + 1
    }
    return m
}

// novel_distinct — count DISTINCT word-trigrams across all `texts` that are (a) not in the
// corpus trigram set, (b) all-3 tokens in `known` (coherent words, not byte-salad fragments).
fn novel_distinct(texts: list, corpus: Map, known: Map) -> int {
    let seen = #{}
    let mut t = 0
    while t < len(texts) {
        let w = _g6_words(to_string(texts[t]))
        let mut i = 0
        while i + 2 < len(w) {
            let a = to_string(w[i]); let b = to_string(w[i+1]); let c = to_string(w[i+2])
            let g = a + "|" + b + "|" + c
            let coherent = known.contains_key(a) && known.contains_key(b) && known.contains_key(c)
            if coherent && !corpus.contains_key(g) && !seen.contains_key(g) { seen[g] = 1 }
            i = i + 1
        }
        t = t + 1
    }
    return len(_g6_mapkeys(seen))
}

fn clamp01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }

// ── decode one frame at an explicit temperature (single draw, best-of-K OFF) ──
fn decode_temp(frame: string, temp: float, seed: int) -> string {
    let r = gen_clm_ideate(CKPT, frame, GEN, TOP_K, temp, seed)
    return to_string(r["text"])
}

// ── NE per frame = ideation-grounding DEFICIT of a short probe decode (orthogonal signal) ──
fn ne_for_frame(frame: string, seed: int, known: Map) -> float {
    let r = gen_clm_ideate(CKPT, frame, PROBE_GEN, TOP_K, 0.7, seed)
    let kwr = _g6_known_word_ratio(to_string(r["text"]), known)
    return clamp01(1.0 - kwr)
}

// score a list of (frame,temp) decodes → #{ novel, dist, fals, texts }
fn score(frames: list, temps: list, seed: int, corpus: Map, known: Map) -> Map {
    let texts = []
    let word_sets = []
    let mut fals = 0
    let mut i = 0
    while i < len(frames) {
        let o = decode_temp(to_string(frames[i]), to_float(temps[i]), seed)
        texts.push(o)
        if _g6_known_word_ratio(o, known) >= 0.5 {
            word_sets.push(_g6_words(o))
            if _g6_is_falsifiable(o, known) { fals = fals + 1 }
        }
        i = i + 1
    }
    // greedy distinctness (jaccard <= 0.5) — engine-native g6_score_arm rule VERBATIM
    let kept = []
    let mut w = 0
    while w < len(word_sets) {
        let ws = word_sets[w]
        let mut ok = true
        let mut kk = 0
        while kk < len(kept) { if _g6_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    let nv = novel_distinct(texts, corpus, known)
    return #{ "novel": nv, "dist": len(kept), "fals": fals }
}

fn const_temps(n: int, t: float) -> list {
    let out = []
    let mut i = 0
    while i < n { out.push(t); i = i + 1 }
    return out
}

fn main() {
    let known = _g6_dict_load()
    let corpus = _corpus_trigrams()
    let fr = g6_build_frames(6)
    let frames = fr["composed"]
    let nfr = len(frames)
    let T_GRID = [0.5, 0.7, 0.9, 1.1, 1.3]
    let seeds = [1425, 1426, 1427]

    // frame-guard (p7) — frames carry no measurable / are not falsifiable on their own
    let leaks = g6_frame_guard(frames, known)
    print("FRAME_GUARD leaks=" + to_string(len(leaks)) + " (0=CLEAN)")
    print("DETECTOR_CALIB " + to_string(g6_detector_calibration(known)) + "/10 (frozen, advisory)")
    print("")

    let mut sumA_nv = 0.0; let mut sumB_nv = 0.0; let mut sumBsh_nv = 0.0; let mut sumBabl_nv = 0.0
    let mut sumA_d = 0.0; let mut sumB_d = 0.0
    let mut det_ok = true

    let mut si = 0
    while si < len(seeds) {
        let seed = to_int(seeds[si])
        print("=== SEED " + to_string(seed) + " ===")

        // ── ARM A: best FIXED temp over the grid (per seed) ──
        let mut bestA_nv = -1; let mut bestA_t = 0.0; let mut bestA_d = 0
        let mut gi = 0
        while gi < len(T_GRID) {
            let t = to_float(T_GRID[gi])
            let s = score(frames, const_temps(nfr, t), seed, corpus, known)
            print("  fixed t=" + to_string(t) + " novel=" + to_string(s["novel"]) + " dist=" + to_string(s["dist"]) + " fals=" + to_string(s["fals"]))
            if to_int(s["novel"]) > bestA_nv { bestA_nv = to_int(s["novel"]); bestA_t = t; bestA_d = to_int(s["dist"]) }
            gi = gi + 1
        }
        print("  A best-fixed t*=" + to_string(bestA_t) + " novel=" + to_string(bestA_nv) + " dist=" + to_string(bestA_d))

        // ── NE per frame (orthogonal ideation-grounding deficit) ──
        let ne = []
        let temps_b = []
        let mut fi = 0
        while fi < nfr {
            let n = ne_for_frame(to_string(frames[fi]), seed, known)
            ne.push(n)
            temps_b.push(T_LO + (T_HI - T_LO) * n)
            fi = fi + 1
        }
        // print NE vector
        let mut nestr = ""
        let mut pj = 0
        while pj < nfr { nestr = nestr + to_string(ne[pj]) + " "; pj = pj + 1 }
        print("  NE deficit/frame: " + nestr)

        // ── ARM B: NE-gated schedule ──
        let sB = score(frames, temps_b, seed, corpus, known)
        // determinism check (run twice)
        let sB2 = score(frames, temps_b, seed, corpus, known)
        if to_int(sB["novel"]) != to_int(sB2["novel"]) { det_ok = false }
        print("  B NE-gated novel=" + to_string(sB["novel"]) + " dist=" + to_string(sB["dist"]) + " fals=" + to_string(sB["fals"]))

        // ── Bsh: SHUFFLE (reverse the NE→frame match) ──
        let temps_sh = []
        let mut ri = nfr - 1
        while ri >= 0 { temps_sh.push(T_LO + (T_HI - T_LO) * ne[ri]); ri = ri - 1 }
        let sBsh = score(frames, temps_sh, seed, corpus, known)
        print("  Bsh shuffle novel=" + to_string(sBsh["novel"]) + " dist=" + to_string(sBsh["dist"]))

        // ── Babl: ABLATE NE → fixed mean temp (H_1228 baseline form) ──
        let mut mt = 0.0
        let mut mi = 0
        while mi < nfr { mt = mt + to_float(temps_b[mi]); mi = mi + 1 }
        mt = mt / to_float(nfr)
        let sBabl = score(frames, const_temps(nfr, mt), seed, corpus, known)
        print("  Babl ablate(meanT=" + to_string(mt) + ") novel=" + to_string(sBabl["novel"]) + " dist=" + to_string(sBabl["dist"]))
        print("")

        sumA_nv = sumA_nv + to_float(bestA_nv); sumA_d = sumA_d + to_float(bestA_d)
        sumB_nv = sumB_nv + to_float(to_int(sB["novel"])); sumB_d = sumB_d + to_float(to_int(sB["dist"]))
        sumBsh_nv = sumBsh_nv + to_float(to_int(sBsh["novel"]))
        sumBabl_nv = sumBabl_nv + to_float(to_int(sBabl["novel"]))
        si = si + 1
    }

    let ns = to_float(len(seeds))
    let mA = sumA_nv / ns; let mB = sumB_nv / ns; let mBsh = sumBsh_nv / ns; let mBabl = sumBabl_nv / ns
    print("==================== MEAN over 3 seeds (M = NOVEL distinct trigrams) ====================")
    print("A best-fixed = " + to_string(mA))
    print("B NE-gated   = " + to_string(mB))
    print("Bsh shuffle  = " + to_string(mBsh))
    print("Babl ablate  = " + to_string(mBabl))
    print("dist: A=" + to_string(sumA_d/ns) + " B=" + to_string(sumB_d/ns))
    print("determinism run1==run2: " + to_string(det_ok))
    print("")
    let c1 = mB >= mA + 1.0
    let c2 = mBsh <= mA + 0.5
    let c3 = mBabl <= mA + 0.5
    print("c1 PRESENCE   M(B) " + to_string(mB) + " >= M(A)+1.0 " + to_string(mA + 1.0) + " : " + to_string(c1))
    print("c2 EARNED-GATE(shuf) M(Bsh) " + to_string(mBsh) + " <= M(A)+0.5 " + to_string(mA + 0.5) + " : " + to_string(c2))
    print("c3 EARNED-NE(ablate) M(Babl) " + to_string(mBabl) + " <= M(A)+0.5 " + to_string(mA + 0.5) + " : " + to_string(c3))
    let green = c1 && c2 && c3
    if green { print("VERDICT: GREEN-BREAKTHROUGH (NE-gated ideation temp beats best-fixed, controls discriminate)") }
    else { print("VERDICT: WALL — orthogonal channel ALSO no free lunch (strengthens H_1284/H_1422)") }
}
