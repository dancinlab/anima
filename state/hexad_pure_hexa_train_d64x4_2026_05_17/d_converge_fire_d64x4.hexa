// HEXAD/D/d_converge_fire_d64x4.hexa — pure-hexa hexa-cpu training-to-convergence
// FIRE @ d=64 n_layer=4 500-step (ubu RAM-headroom intermediate scale; follows
// Agent #2a d=64·3L Mac local FINAL gn2 collapse, extending the depth-axis
// before d=128·4L Mac substrate-bound 138 GB OOM ceiling).
//
// ════════════════════════════════════════════════════════════════════════════
//
//  HONEST SCOPE (g3 — named real limit, no fake descent):
//    • Substrate = compiled-native CPU pure-hexa (NOT .py, NOT GPU); ubu
//      Ubuntu 24.04 x86_64, 30 GB physical RAM. Mac d=128·4L pure-hexa hit
//      138 GB peak alloc on step 51 (Agent #2a PARTIAL OOM). ubu has 30 GB —
//      d=96·3L pilot induced OOM-thrash on ubu (boxed-array overhead steeper
//      than param-count math suggests), so this fire targets d=64·4L instead:
//      same width as Agent #2a (12 GB on Mac) + 1 extra layer (~33% growth
//      = ~16 GB predicted, well within ubu 30 GB headroom).
//    • d=64 nh=4 nkv=2 hd=16 h=128 T=16 V=256 nsamp=8 stride=512 steps=500.
//      Adds depth axis to Agent #2a baseline (#2a was d=64·3L·300-step).
//    • lr=0.03 AdamW (b1=0.9 b2=0.999 eps=1e-8 wd=0.01) — identical
//      hyperparameter cluster to Agent #2a baseline (controlled comparison).
//
//  §8 / g_blue_closed_mandate connection:
//    • corpus ↔ trainer connection = (a) CE Shannon-floor (−ln p ≥ 0,
//      closed) + (b) exact-gradient (softmax−onehot = B-D-4 sympy 🔵).
//    • This fire's IMPL is 🔵 (B-D-4 reused, GRAD-EXACT carry from Phase E2).
//      The OUTCOME (loss-collapse trajectory) is EMPIRICAL per B-D-NOTE.
//
//  FROM-SCRATCH: ALL weights RANDOM seed-fixed LCG (g_clm_from_scratch,
//  base_ckpt = NONE — `d5_init(seed=42, ...)`).
//
//  FALSIFIER F-D-CONVERGE-D64x4 (4 sub-checks):
//    DCV-1 INIT-CAPTURE  : gn2_init finite + non-zero + ≈ Shannon floor band
//    DCV-2 GRAD-EXACT    : layer-0 Wg analytic-vs-FD agreement |Δ| < 0.01
//    DCV-3 FINAL-CAPTURE : gn2_final / gn2_init < 0.01 (≥ 100× descent)
//    DCV-4 ACC-EMERGE    : acc_final > acc_init
//
//  TIER = EMPIRICAL outcome on closed-form trainer impl (B-D-NOTE pattern).
// ════════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/HEXAD/D/d_train5_lib.hexa"
import "/Users/ghost/core/anima/HEXAD/D/corpus_loader_lib.hexa"


fn dcv_corpus_dataset(path: string, t_len: int, nsamp: int, stride: int) {
    let toks = corpus_load_bytes(path)
    let n = len(toks)
    let mut IDS = []
    let mut YS = []
    let mut s = 0
    while s < nsamp {
        let off = s * stride
        if off + t_len < n {
            let mut ids = []
            let mut p = 0
            while p < t_len {
                ids.push(toks[off + p])
                p = p + 1
            }
            IDS.push(ids)
            YS.push(toks[off + t_len])
        }
        s = s + 1
    }
    return [IDS, YS]
}

fn dcv_bump_block_wg(M, l: int, idx: int, delta: float, n_layer: int) {
    let mut nb = []
    let mut bl = 0
    while bl < n_layer {
        let src = M["blocks"][bl]
        if bl == l {
            let wsrc = src["Wg"]
            let mut a = []
            let mut i = 0
            while i < len(wsrc) {
                a.push(if i == idx { wsrc[i] + delta } else { wsrc[i] })
                i = i + 1
            }
            nb.push(#{
                "g1": src["g1"], "Wq": src["Wq"], "Wk": src["Wk"],
                "Wv": src["Wv"], "Wo": src["Wo"], "g2": src["g2"],
                "Wg": a, "Wu": src["Wu"], "Wd": src["Wd"],
            })
        } else {
            nb.push(src)
        }
        bl = bl + 1
    }
    return #{ "tok_emb": M["tok_emb"], "blocks": nb, "gF": M["gF"] }
}

fn dcv_epoch_gn2(IDS, YS, M, cos, sin, T: int, d: int, nh: int, nkv: int,
                 h: int, V: int, n_layer: int) -> float {
    let mut acc = 0.0
    let mut s = 0
    while s < len(YS) {
        acc = acc + d5_gn2(IDS[s], M, YS[s], cos, sin, T, d, nh, nkv,
                           h, V, n_layer)
        s = s + 1
    }
    return acc
}
fn dcv_epoch_acc(IDS, YS, M, cos, sin, T: int, d: int, nh: int, nkv: int,
                 h: int, V: int, n_layer: int) -> int {
    let mut cc = 0
    let mut s = 0
    while s < len(YS) {
        if d5_predict(IDS[s], M, cos, sin, T, d, nh, nkv, h, V, n_layer)
           == YS[s] { cc = cc + 1 }
        s = s + 1
    }
    return cc
}
fn dcv_epoch_ce(IDS, YS, M, cos, sin, T: int, d: int, nh: int, nkv: int,
                h: int, V: int, n_layer: int) -> float {
    let mut acc = 0.0
    let mut s = 0
    while s < len(YS) {
        acc = acc + d5_ce(IDS[s], M, YS[s], cos, sin, T, d, nh, nkv,
                          h, V, n_layer)
        s = s + 1
    }
    return acc
}

fn dcv_zero_block_opt(d: int, nh: int, nkv: int, h: int) {
    let hd = d / nh
    let kvd = nkv * hd
    return #{
        "g1": dt2_zeros(d), "Wq": dt2_zeros(d*d), "Wk": dt2_zeros(kvd*d),
        "Wv": dt2_zeros(kvd*d), "Wo": dt2_zeros(d*d), "g2": dt2_zeros(d),
        "Wg": dt2_zeros(h*d), "Wu": dt2_zeros(h*d), "Wd": dt2_zeros(d*h),
    }
}

fn selftest() {
    println("================================================================")
    println("d_converge_fire_d64x4 — pure-hexa hexa-cpu @ d=64·4L·500-step (ubu)")
    println("================================================================")

    let d = 64
    let nh = 4
    let nkv = 2
    let h = 128
    let V = 256
    let T = 16
    let n_layer = 4
    let hd = d / nh
    let kvd = nkv * hd
    let nsamp = 8
    let stride = 512
    let steps = 500

    println("  config: d=" + to_string(d) + " n_layer=" + to_string(n_layer)
            + " nh=" + to_string(nh) + " nkv=" + to_string(nkv)
            + " hd=" + to_string(hd) + " h=" + to_string(h)
            + " T=" + to_string(T) + " V=" + to_string(V)
            + " nsamp=" + to_string(nsamp) + " steps=" + to_string(steps))

    let path = "/Users/ghost/core/anima/training/corpus_consciousness_v1.jsonl"
    let ds = dcv_corpus_dataset(path, T, nsamp, stride)
    let IDS = ds[0]
    let YS = ds[1]
    let rt = d5_rope_tables(T, hd)
    let cos = rt[0]
    let sin = rt[1]

    let mut M = d5_init(42, d, nh, nkv, h, V, n_layer)

    let gn0 = dcv_epoch_gn2(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    let ce0 = dcv_epoch_ce(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    let ac0 = dcv_epoch_acc(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    let init_ok = gn0 > 0.0 && gn0 == gn0 && gn0 < 1.0e30
    println("  init  gn2=" + to_string(gn0) + "  CE=" + to_string(ce0)
            + "  acc=" + to_string(ac0) + "/" + to_string(nsamp))
    println("  DCV-1 INIT-CAPTURE       : " + (if init_ok { "PASS" } else { "FAIL" }))

    let wi = 5
    let eps = 0.0005
    let gA = d5_grad(IDS[0], M, YS[0], cos, sin, T, d, nh, nkv, h, V, n_layer)
    let gA_wg = gA["dblocks"][0]["dWg"][wi]
    let Mp = dcv_bump_block_wg(M, 0, wi, eps, n_layer)
    let Mm = dcv_bump_block_wg(M, 0, wi, 0.0 - eps, n_layer)
    let cep = d5_ce(IDS[0], Mp, YS[0], cos, sin, T, d, nh, nkv, h, V, n_layer)
    let cem = d5_ce(IDS[0], Mm, YS[0], cos, sin, T, d, nh, nkv, h, V, n_layer)
    let gF = (cep - cem) / (2.0 * eps)
    let ge = if gA_wg - gF > 0.0 { gA_wg - gF } else { gF - gA_wg }
    let gx_ok = ge < 0.01
    println("  DCV-2 GRAD-EXACT(L0.Wg[" + to_string(wi) + "]) : analytic="
            + to_string(gA_wg) + " fd=" + to_string(gF) + " |Δ|="
            + to_string(ge) + "  -> " + (if gx_ok { "PASS" } else { "FAIL" }))

    let mut m_te = dt2_zeros(V*d); let mut v_te = dt2_zeros(V*d)
    let mut m_gF = dt2_zeros(d);   let mut v_gF = dt2_zeros(d)
    let mut mB = []
    let mut vB = []
    let mut bi = 0
    while bi < n_layer {
        mB.push(dcv_zero_block_opt(d, nh, nkv, h))
        vB.push(dcv_zero_block_opt(d, nh, nkv, h))
        bi = bi + 1
    }
    let lr = 0.03
    let b1 = 0.9
    let b2 = 0.999
    let epsa = 0.00000001
    let wd = 0.01

    println("  [loop start] AdamW steps=" + to_string(steps)
            + "  (trajectory checkpointed @ st ∈ {1, 25, 50, 100, 200, 300, 400, 500})")

    let mut st = 1
    while st <= steps {
        let mut gte = dt2_zeros(V*d)
        let mut ggF = dt2_zeros(d)
        let mut gB = []
        bi = 0
        while bi < n_layer { gB.push(dcv_zero_block_opt(d, nh, nkv, h)); bi = bi + 1 }
        let mut s = 0
        while s < nsamp {
            let G = d5_grad(IDS[s], M, YS[s], cos, sin, T, d, nh, nkv,
                            h, V, n_layer)
            let a = G["dtok_emb"]
            let mut q = 0
            while q < V*d { gte[q] = gte[q] + a[q]; q = q + 1 }
            let agF = G["dgF"]
            q = 0
            while q < d { ggF[q] = ggF[q] + agF[q]; q = q + 1 }
            bi = 0
            while bi < n_layer {
                let gb = G["dblocks"][bi]
                let cur = gB[bi]
                let mut ng1 = []
                q = 0
                while q < d { ng1.push(cur["g1"][q] + gb["dg1"][q]); q = q + 1 }
                let mut ng2 = []
                q = 0
                while q < d { ng2.push(cur["g2"][q] + gb["dg2"][q]); q = q + 1 }
                let mut nWq = []
                q = 0
                while q < d*d { nWq.push(cur["Wq"][q] + gb["dWq"][q]); q = q + 1 }
                let mut nWo = []
                q = 0
                while q < d*d { nWo.push(cur["Wo"][q] + gb["dWo"][q]); q = q + 1 }
                let mut nWk = []
                q = 0
                while q < kvd*d { nWk.push(cur["Wk"][q] + gb["dWk"][q]); q = q + 1 }
                let mut nWv = []
                q = 0
                while q < kvd*d { nWv.push(cur["Wv"][q] + gb["dWv"][q]); q = q + 1 }
                let mut nWg = []
                q = 0
                while q < h*d { nWg.push(cur["Wg"][q] + gb["dWg"][q]); q = q + 1 }
                let mut nWu = []
                q = 0
                while q < h*d { nWu.push(cur["Wu"][q] + gb["dWu"][q]); q = q + 1 }
                let mut nWd = []
                q = 0
                while q < d*h { nWd.push(cur["Wd"][q] + gb["dWd"][q]); q = q + 1 }
                gB[bi] = #{ "g1": ng1, "Wq": nWq, "Wk": nWk, "Wv": nWv,
                            "Wo": nWo, "g2": ng2, "Wg": nWg, "Wu": nWu,
                            "Wd": nWd }
                bi = bi + 1
            }
            s = s + 1
        }
        let ute = dt2_adamw_step(M["tok_emb"], m_te, v_te, gte, lr, b1, b2, epsa, wd, st)
        let ugF = dt2_adamw_step(M["gF"], m_gF, v_gF, ggF, lr, b1, b2, epsa, wd, st)
        m_te = ute[1]; v_te = ute[2]
        m_gF = ugF[1]; v_gF = ugF[2]
        let mut newblocks = []
        bi = 0
        while bi < n_layer {
            let Bp = M["blocks"][bi]
            let gb = gB[bi]
            let mo = mB[bi]
            let vo = vB[bi]
            let ug1 = dt2_adamw_step(Bp["g1"], mo["g1"], vo["g1"], gb["g1"], lr, b1, b2, epsa, wd, st)
            let uWq = dt2_adamw_step(Bp["Wq"], mo["Wq"], vo["Wq"], gb["Wq"], lr, b1, b2, epsa, wd, st)
            let uWk = dt2_adamw_step(Bp["Wk"], mo["Wk"], vo["Wk"], gb["Wk"], lr, b1, b2, epsa, wd, st)
            let uWv = dt2_adamw_step(Bp["Wv"], mo["Wv"], vo["Wv"], gb["Wv"], lr, b1, b2, epsa, wd, st)
            let uWo = dt2_adamw_step(Bp["Wo"], mo["Wo"], vo["Wo"], gb["Wo"], lr, b1, b2, epsa, wd, st)
            let ug2 = dt2_adamw_step(Bp["g2"], mo["g2"], vo["g2"], gb["g2"], lr, b1, b2, epsa, wd, st)
            let uWg = dt2_adamw_step(Bp["Wg"], mo["Wg"], vo["Wg"], gb["Wg"], lr, b1, b2, epsa, wd, st)
            let uWu = dt2_adamw_step(Bp["Wu"], mo["Wu"], vo["Wu"], gb["Wu"], lr, b1, b2, epsa, wd, st)
            let uWd = dt2_adamw_step(Bp["Wd"], mo["Wd"], vo["Wd"], gb["Wd"], lr, b1, b2, epsa, wd, st)
            newblocks.push(#{ "g1": ug1[0], "Wq": uWq[0], "Wk": uWk[0],
                "Wv": uWv[0], "Wo": uWo[0], "g2": ug2[0], "Wg": uWg[0],
                "Wu": uWu[0], "Wd": uWd[0] })
            mB[bi] = #{ "g1": ug1[1], "Wq": uWq[1], "Wk": uWk[1], "Wv": uWv[1],
                "Wo": uWo[1], "g2": ug2[1], "Wg": uWg[1], "Wu": uWu[1],
                "Wd": uWd[1] }
            vB[bi] = #{ "g1": ug1[2], "Wq": uWq[2], "Wk": uWk[2], "Wv": uWv[2],
                "Wo": uWo[2], "g2": ug2[2], "Wg": uWg[2], "Wu": uWu[2],
                "Wd": uWd[2] }
            bi = bi + 1
        }
        M = #{ "tok_emb": ute[0], "blocks": newblocks, "gF": ugF[0] }

        if st == 1 || st == 25 || st == 50 || st == 100 || st == 200 || st == 300 || st == 400 || st == 500 {
            let gnc = dcv_epoch_gn2(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
            let cec = dcv_epoch_ce(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
            let acc = dcv_epoch_acc(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
            println("  GN2_CURVE,step=" + to_string(st) + ",gn2=" + to_string(gnc)
                    + ",CE=" + to_string(cec) + ",acc=" + to_string(acc))
        }

        st = st + 1
    }

    let gn1 = dcv_epoch_gn2(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    let ce1 = dcv_epoch_ce(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    let ac1 = dcv_epoch_acc(IDS, YS, M, cos, sin, T, d, nh, nkv, h, V, n_layer)
    println("  final gn2=" + to_string(gn1) + "  CE=" + to_string(ce1)
            + "  acc=" + to_string(ac1) + "/" + to_string(nsamp)
            + "  (after " + to_string(steps) + " AdamW steps, FULL composed "
            + to_string(n_layer) + "-layer chain)")

    let collapse_x = gn0 / gn1
    let final_ok = collapse_x > 100.0
    println("  DCV-3 FINAL-CAPTURE      : gn2 " + to_string(gn0) + " → "
            + to_string(gn1) + "  collapse=" + to_string(collapse_x)
            + "x  -> " + (if final_ok { "PASS (≥100x)" } else { "FAIL (<100x)" }))

    let acc_ok = ac1 > ac0
    println("  DCV-4 ACC-EMERGE         : acc " + to_string(ac0) + " → "
            + to_string(ac1) + "/" + to_string(nsamp)
            + "  -> " + (if acc_ok { "PASS" } else { "FAIL" }))

    let aggregate_ok = init_ok && gx_ok && final_ok && acc_ok
    println("  F-D-CONVERGE-D64x4 AGGREGATE 4/4: " + to_string(aggregate_ok))

    println("----------------------------------------------------------------")
    println("  pure-hexa hexa-cpu training-to-convergence FIRE (d=64·4L)")
    println("    substrate    : compiled-native CPU pure-hexa (NOT .py, NOT GPU)")
    println("    runtime host : ubu (Ubuntu 24.04 x86_64, 30 GB physical RAM)")
    println("    config       : d=" + to_string(d) + " n_layer=" + to_string(n_layer)
            + " steps=" + to_string(steps) + " nsamp=" + to_string(nsamp)
            + " V=" + to_string(V))
    println("    corpus       : training/corpus_consciousness_v1.jsonl (byte-level)")
    println("    init→final   : gn2 " + to_string(gn0) + " → " + to_string(gn1)
            + " (" + to_string(collapse_x) + "x collapse)")
    println("    impl tier    : 🔵 (B-D-4 + GRAD-EXACT carry, Phase E2 CPU-equiv anchor)")
    println("    outcome tier : EMPIRICAL (B-D-NOTE — SGD 수렴 OUTCOME, honest)")
    println("    anchor chain : Phase E/E2 (d=32·3L·80-step) → Agent #2a (d=64·3L·300-step Mac) → "
            + "this fire (d=64·4L·" + to_string(steps) + "-step ubu)")
    println("    selftest: " + (if aggregate_ok { "true" } else { "false" }))
    println("================================================================")
    return if aggregate_ok { 0 } else { 1 }
}

selftest()
