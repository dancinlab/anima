// H_9074 faculty_cascade ENGINE-NATIVE — substrate multi-hop on live core/engine_cli.hexa.
// store A: q_i -> "x_i"  ; store B: "x_i" -> "y_i". answer(q_i)=y_i reachable ONLY via chain.
// usage: hexa run state/9074_faculty_cascade/cascade_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn main() {
    let cfg = engine_config_default()
    let N = 12
    // build store A (q_i -> x_i) and store B (x_i -> y_i)
    let mut memA = immune_memory_new_text("q0", "x0", 64)
    let mut memB = immune_memory_new_text("x0", "y0", 64)
    let mut i = 1
    while i < N {
        let qi = "q" + to_string(i)
        let xi = "x" + to_string(i)
        let yi = "y" + to_string(i)
        memA = immune_memory_bind_text(memA, qi, xi, cfg)
        memB = immune_memory_bind_text(memB, xi, yi, cfg)
        i = i + 1
    }

    // measure: cascade vs single-hop(direct q->B) vs shuffle(wrong x->B) vs ablate(=single)
    let mut casc = 0
    let mut sing = 0
    let mut shuf = 0
    let mut j = 0
    while j < N {
        let qi = "q" + to_string(j)
        let qk = immune_embed_key(qi)
        let want = "y" + to_string(j)
        // CASCADE q->A->x->B->y
        let got = faculty_cascade(memA, memB, qk)
        if got == want { casc = casc + 1 }
        // SINGLE: q directly on B (q not in B key space -> should miss)
        let gs = immune_memory_recall(memB, qk)
        if gs == want { sing = sing + 1 }
        // SHUFFLE: feed a WRONG intermediate (x of a different index) into B
        let wrongx = "x" + to_string((j + 5) - ((j + 5) / N) * N)
        let gsh = immune_memory_recall(memB, immune_embed_key(wrongx))
        if gsh == want { shuf = shuf + 1 }
        j = j + 1
    }
    // ablate(relay OFF)=single by construction
    let abl = sing

    let cf = to_float(casc) / to_float(N)
    let sf = to_float(sing) / to_float(N)
    let hf = to_float(shuf) / to_float(N)
    let lift = cf - sf
    let earned = cf - hf

    let mut np = 0
    if _ab("cascade solves 2-hop (>=0.8)", cf >= 0.8) { np = np + 1 }
    if _ab("single-hop FAILS (q->B <=0.2)", sf <= 0.2) { np = np + 1 }
    if _ab("LIFT casc-single >= +0.5", lift >= 0.5) { np = np + 1 }
    if _ab("EARNED casc-shuffle >= +0.5 (chain load-bearing)", earned >= 0.5) { np = np + 1 }
    if _ab("ablate(relay OFF)==single (INERT without relay)", abl == sing) { np = np + 1 }

    println("INFO cascade=" + to_string(casc) + "/" + to_string(N)
        + " single=" + to_string(sing) + " shuffle=" + to_string(shuf)
        + " lift=" + to_string(lift) + " earned=" + to_string(earned))
    println("--- H_9074 faculty_cascade engine-native: " + to_string(np) + " pass / " + to_string(5 - np) + " fail ---")
}
