// c4_engine_native.hexa — H_9044 ENGINE-NATIVE measurement of the NEW REM dream-consolidation
// schema/gist op-slot (`dream_schema_mint`/`schema_coverage`) on LIVE core/engine_cli.hexa.
// Frame-shift C4 (recombination ≠ capability): REM replay consolidates K replayed WAKING episode
// anchors into ONE MORE-GENERAL schema anchor (the centroid = the gist). Capability = COVERAGE /
// generalization ONLY (NOT minting novel content = disguised G1). PRE-REGISTERED bars (no tune-to-green):
//   BAR1 schema_generalizes : schema_cov(centroid) > max individual-anchor coverage over held-out cluster cues.
//   BAR2 earned_not_overbroad: schema covers WAKING cues but NOT feature-SHUFFLED cues and NOT RANDOM cues
//                              (schema_cov_waking > schema_cov_shuf AND > schema_cov_rand; shuf/rand near 0).
//                              A trivially over-broad anchor would cover shuffled/random too — this rejects it.
//   BAR3 ablate_inert       : REM OFF (no mint) → best-available anchor is an INDIVIDUAL episode → coverage
//                              lift = 0 (the mint op is the load-bearing mechanism).
// FROZEN toy params (a_scale_honest_scope · existence proof): DIM=8, K=6 episodes, M=24 held-out cues,
//   regime μ per-dim-distinct, σ=0.15 uniform noise, thr=0.30 (pre-registered radius). Deterministic LCG
//   seed=12345 — byte-reproducible. usage: hexa run state/9044_dream_schema_coverage/c4_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

// deterministic LCG in [0,1) — byte-reproducible pseudo-random (no RNG dependency).
fn _lcg_next(s: int) -> int { return (s * 1103515245 + 12345) % 2147483648 }
fn _lcg_u(s: int) -> float { return to_float(s % 100000) / 100000.0 }

// regime center μ: per-dim DISTINCT (so a feature-shuffle genuinely leaves the regime).
fn _mu() -> [float] { return [0.20, 0.35, 0.50, 0.65, 0.80, 0.30, 0.60, 0.45] }

// _sample_regime — μ + uniform(-σ,σ) noise per dim, advancing the LCG. Returns [vec, next_seed].
// (packed as: we return the vec and rely on a running seed the caller threads via _draw_set.)
fn _draw_set(n: int, mu: [float], sigma: float, seed0: int) -> [[float]] {
    let dim = len(mu)
    let mut out = []
    let mut s = seed0
    let mut i = 0
    while i < n {
        let mut v = []
        let mut d = 0
        while d < dim {
            s = _lcg_next(s)
            let u = _lcg_u(s)
            v = v + [mu[d] + (u - 0.5) * 2.0 * sigma]
            d = d + 1
        }
        out = out + [v]
        i = i + 1
    }
    return out
}

// _draw_uniform — RANDOM cues drawn uniform over [0,1]^dim (a DIFFERENT distribution than the regime).
fn _draw_uniform(n: int, dim: int, seed0: int) -> [[float]] {
    let mut out = []
    let mut s = seed0
    let mut i = 0
    while i < n {
        let mut v = []
        let mut d = 0
        while d < dim { s = _lcg_next(s)  v = v + [_lcg_u(s)]  d = d + 1 }
        out = out + [v]
        i = i + 1
    }
    return out
}

// _shuffle_cols — feature-permute each cue's columns by a fixed derangement (same marginal value
// distribution, destroyed regime geometry = the load-bearing shuffle control).
fn _perm8() -> [int] { return [3, 5, 0, 7, 1, 6, 2, 4] }
fn _shuffle_cols(cues: [[float]]) -> [[float]] {
    let p = _perm8()
    let n = len(cues)
    let mut out = []
    let mut i = 0
    while i < n {
        let row = cues[i]
        let mut v = []
        let mut d = 0
        while d < 8 { v = v + [row[p[d]]]  d = d + 1 }
        out = out + [v]
        i = i + 1
    }
    return out
}

fn _max_indiv_cov(anchors: [[float]], cues: [[float]], thr: float) -> int {
    let n = len(anchors)
    let mut best = 0
    let mut i = 0
    while i < n {
        let c = schema_coverage(anchors[i], cues, thr)
        if c > best { best = c }
        i = i + 1
    }
    return best
}

fn main() {
    let mu = _mu()
    let sigma = 0.15
    let thr = 0.30
    let K = 6
    let M = 24

    // REPLAYED WAKING EPISODES (individual anchors) + held-out WAKING cues (same regime, disjoint seeds).
    let episodes = _draw_set(K, mu, sigma, 12345)
    let waking = _draw_set(M, mu, sigma, 99991)
    let shuffled = _shuffle_cols(waking)
    let randomc = _draw_uniform(M, 8, 55557)

    // REM-mint the schema anchor = centroid (gist) of the replayed episodes.
    let schema = dream_schema_mint(episodes)

    let sc_wake = schema_coverage(schema, waking, thr)
    let sc_shuf = schema_coverage(schema, shuffled, thr)
    let sc_rand = schema_coverage(schema, randomc, thr)
    let indiv_max = _max_indiv_cov(episodes, waking, thr)

    println("── H_9044 C4 dream-schema coverage (engine-native, live core/) ──")
    println("thr=" + to_string(thr) + " K=" + to_string(K) + " M=" + to_string(M))
    println("schema_cov WAKING   = " + to_string(sc_wake) + " / " + to_string(M))
    println("schema_cov SHUFFLED = " + to_string(sc_shuf) + " / " + to_string(M))
    println("schema_cov RANDOM   = " + to_string(sc_rand) + " / " + to_string(M))
    println("max INDIVIDUAL cov  = " + to_string(indiv_max) + " / " + to_string(M))

    // BAR1 schema_generalizes: centroid recognizes MORE held-out cluster cues than any single exemplar.
    let b1 = _ab("BAR1 schema_generalizes (schema_cov > max_indiv)", sc_wake > indiv_max)
    // BAR2 earned_not_overbroad: schema covers WAKING but NOT shuffled and NOT random.
    let b2 = _ab("BAR2 earned_not_overbroad (wake > shuf AND wake > rand AND shuf+rand small)",
                 sc_wake > sc_shuf && sc_wake > sc_rand && (sc_shuf + sc_rand) * 4 < sc_wake)
    // BAR3 ablate_inert: REM OFF → no mint → best anchor is an INDIVIDUAL → coverage lift = 0.
    let lift_on = sc_wake - indiv_max
    let lift_off = indiv_max - indiv_max
    let b3 = _ab("BAR3 ablate_inert (lift_on>0 AND lift_off==0)", lift_on > 0 && lift_off == 0)
    println("lift_on (mint) = " + to_string(lift_on) + "  lift_off (REM OFF) = " + to_string(lift_off))

    let all = b1 && b2 && b3
    if all { println("RESULT 3/3 PASS — C4 engine-native GREEN (coverage-generalization, NOT recombination)") }
    else { println("RESULT NOT 3/3 — see bars") }
}
