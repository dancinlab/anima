// ============================================================================
// state/9105_consequence_mitosis/consequence_mitosis.hexa
//   H_9105 — CONSEQUENCE-DRIVEN MITOSIS: exogenous fitness vs random fitness.
//
//   FRONTIER C2 (state/frontier_rebrainstorm/BRAINSTORM.md). from-scratch PURE-split
//   mitosis is 🔴 TERMINAL (a_mitosis_train: gradient/SELECTION absence = bottleneck).
//   Session insight: walls fall to DPI unless the driving signal carries EXOGENOUS
//   information the substrate cannot derive internally. C2 bolts the session's LIVING
//   external selection onto the dead wall: lineage selection by REAL task success
//   (consequence) with the control = RANDOM fitness. Engine-native reconfirm of H_1568
//   (which tested this DIRECTIONAL numpy-mirror-only, found INERT, deferred engine-native).
//
//   ENGINE-NATIVE (load-bearing on live core/engine_cli.hexa):
//     · immune_embed_key      — substrate's DIM=64 byte-trigram FNV-1a receptive key.
//     · engine_mitosis_tick   — the p8 growth gate; EVERY cell birth (novel spawn AND
//       clonal reproduction) passes through it (gated cfg.mitosis). This IS the mechanism
//       the from-scratch-mitosis wall is about. Population bookkeeping (nearest-scan,
//       apoptosis removal, stats) = harness (VAdaptField has no cell-removal op). No
//       numpy/torch/gauge_lib (.hexa only).
//
//   TASK (gives exogenous selection a genuine, non-rigged channel — the novelty vs H_1568,
//   whose next-byte task had no signal/noise structure to exploit → tied random):
//   capacity-limited clonal classifier over labeled concept clusters; half SIGNAL (stable
//   ground-truth answer) half NOISE (answer flips randomly). MAX_CELLS << #clusters forces
//   the population to CHOOSE which clusters to cover. Real consequence should push apoptosis
//   to differentially kill NOISE cells and keep SIGNAL cells; random churn cannot.
//
//   ARMS (identical query stream/seed; only SELECTION differs; MATCHED churn KILL_K/REPRO_K):
//     EXO        — kill bottom-k by REAL correct-rate; reproduce top-k (clonal split).
//     RAND       — kill/reproduce k cells at RANDOM (consequence-independent).
//     SHUF       — EXO but fitness scored vs a FIXED PERMUTED cluster→answer map (real
//                  consequence present, correspondence scrambled — DPI/tautology control).
//     EXO_NOAPOP — real fitness, reproduce-only, NO apoptosis (isolates apoptosis channel).
//
//   FROZEN BARS (PREREG.md; c9 no post-hoc move):
//     B1 DIVERGE : mean(EXO_acc − RAND_acc) >= 0.15   (selection carries info)
//     B2 SHUFFLE : mean(EXO_acc − SHUF_acc) >= 0.15   (consequence REAL not tautology)
//     B3 APOPT   : mean(EXO_acc − EXO_NOAPOP_acc) >= 0.10 (is death the channel?)
//   VERDICT: 🟢 iff B1∧B2 ; 🟠 partial ; 🔴 INERT (both Δ<0.05 = DPI re-emerges at selection).
// ============================================================================

import "core/engine_cli.hexa"

fn fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn l2(a: [float], b: [float]) -> float {
    let n = len(a)  let mut s = 0.0  let mut i = 0
    while i < n { let d = a[i] - b[i]  s = s + d*d  i = i + 1 }
    return sqrt(s)
}
fn fmean(xs: [float]) -> float { let n = len(xs)  if n == 0 { return 0.0 }  let mut s = 0.0  let mut i = 0  while i < n { s = s + xs[i]  i = i + 1 }  return s / to_float(n) }
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn rand01(state: int) -> float { return to_float(state) / 2147483648.0 }

// per-cluster distinct byte motif (chr(65+gid) repeated) + variant suffix.
fn make_query(gid: int, variant: int, rep: int) -> string {
    let ch = chr(65 + gid)
    let mut s = ""
    let mut i = 0
    while i < rep { s = s + ch  i = i + 1 }
    return s + "#" + to_string(variant)
}

// nearest cell over L2; returns [idx_as_float, dist]. idx=-1 when empty.
fn nearest(ckey: [[float]], qk: [float]) -> [float] {
    let n = len(ckey)
    if n == 0 { return [0.0 - 1.0, 9.9] }
    let mut bi = 0
    let mut bd = l2(ckey[0], qk)
    let mut i = 1
    while i < n { let d = l2(ckey[i], qk)  if d < bd { bd = d  bi = i }  i = i + 1 }
    return [to_float(bi), bd]
}

// ── one evolutionary run of a single ARM. mode: 0=EXO 1=RAND 2=SHUF 3=EXO_NOAPOP 4=NOSEL ──
//   returns [heldout_acc, final_cells, sig_cells, cov_distinct, cond_acc]
fn run_arm(mode: int, seed: int, N_NOISE: int, MAX_CELLS: int, N_GEN: int) -> [float] {
    let cfg = engine_config_default()          // mitosis ON (p8 native)
    let N_SIG = 12
    let NCL = N_SIG + N_NOISE
    let REP = 20
    let FIRE_RADIUS = 0.30                      // == engine SPLIT_THRESH (principled)
    let BATCH = 60
    let KILL_K = 2
    let REPRO_K = 2

    // fixed permuted cluster→answer map for SHUF (scramble correspondence, keep structure).
    let mut perm_ans = []
    let mut pi = 0
    while pi < NCL { perm_ans = perm_ans + [pi % 2]  pi = pi + 1 }   // base map
    // Fisher-Yates shuffle of perm_ans over sel stream (SHUF only reads it).
    let mut sel_rs = lcg_next(seed * 31 + 13)
    let mut fy = NCL - 1
    while fy > 0 {
        sel_rs = lcg_next(sel_rs)
        let j = sel_rs % (fy + 1)
        let tmp = perm_ans[fy]  perm_ans[fy] = perm_ans[j]  perm_ans[j] = tmp
        fy = fy - 1
    }

    // population (parallel arrays)
    let mut ckey = []        // [[float]] receptive keys
    let mut clab = []        // [int] inherited label bit
    let mut cbornsig = []    // [int] diagnostic: born on a signal cluster?
    let mut ctot = []        // [int] per-gen fires
    let mut ccorr = []       // [int] per-gen correct (real answer)
    let mut cshcorr = []     // [int] per-gen correct (shuffled answer, SHUF)

    let mut data_rs = lcg_next(seed * 17 + 5)

    let mut g = 0
    while g < N_GEN {
        // reset per-gen stats
        let ncur = len(ckey)
        let mut z = 0
        while z < ncur { ctot[z] = 0  ccorr[z] = 0  cshcorr[z] = 0  z = z + 1 }

        // ── present a batch ──
        let mut b = 0
        while b < BATCH {
            data_rs = lcg_next(data_rs)
            let gid = data_rs % NCL
            data_rs = lcg_next(data_rs)
            let variant = data_rs % 1000
            // TRUE answer (exogenous): signal deterministic, noise random.
            let mut ans = gid % 2
            if gid >= N_SIG {
                data_rs = lcg_next(data_rs)
                ans = data_rs % 2
            }
            let qstr = make_query(gid, variant, REP)
            let qk = immune_embed_key(qstr)          // LIVE core representation

            let nr = nearest(ckey, qk)
            let idx = to_int(nr[0])
            let dist = nr[1]
            if idx >= 0 && dist <= FIRE_RADIUS {
                // a cell FIRES — score it
                ctot[idx] = ctot[idx] + 1
                if clab[idx] == ans { ccorr[idx] = ccorr[idx] + 1 }
                let shscore = perm_ans[gid]
                if clab[idx] == shscore { cshcorr[idx] = cshcorr[idx] + 1 }
            } else {
                // NOVEL — spawn a new cell via the LIVE mitosis growth gate (capacity permitting)
                if len(ckey) < MAX_CELLS {
                    let grown = engine_mitosis_tick(len(ckey), cfg)   // LIVE p8 gate
                    if grown > len(ckey) {
                        ckey = ckey + [qk]
                        clab = clab + [ans]              // inherit birth-query answer
                        let bs = if gid < N_SIG { 1 } else { 0 }
                        cbornsig = cbornsig + [bs]
                        ctot = ctot + [0]
                        ccorr = ccorr + [0]
                        cshcorr = cshcorr + [0]
                    }
                }
            }
            b = b + 1
        }

        // ── fitness per cell (mode-dependent) ──
        let n = len(ckey)
        let mut fit = []
        let mut i = 0
        while i < n {
            let mut f = 1.0
            if mode == 1 {
                // RAND: consequence-independent
                sel_rs = lcg_next(sel_rs)
                f = rand01(sel_rs)
            } else {
                if ctot[i] > 0 {
                    if mode == 2 { f = to_float(cshcorr[i]) / to_float(ctot[i]) }   // SHUF
                    else { f = to_float(ccorr[i]) / to_float(ctot[i]) }             // EXO / EXO_NOAPOP
                } else {
                    f = 1.0                                                          // protect unevaluated newborns
                }
            }
            fit = fit + [f]
            i = i + 1
        }

        // ── APOPTOSIS: kill bottom-KILL_K by fitness (skipped for EXO_NOAPOP) ──
        let mut dead = []
        let mut d0 = 0
        while d0 < n { dead = dead + [0]  d0 = d0 + 1 }
        if mode != 3 && mode != 4 {
            let mut kk = 0
            while kk < KILL_K {
                // find alive cell with min fit
                let mut bi = 0 - 1
                let mut bd = 9.9
                let mut ii = 0
                while ii < n {
                    if dead[ii] == 0 && fit[ii] < bd { bd = fit[ii]  bi = ii }
                    ii = ii + 1
                }
                if bi >= 0 { dead[bi] = 1 }
                kk = kk + 1
            }
        }

        // rebuild population without dead cells
        let mut nckey = []  let mut nclab = []  let mut ncbs = []
        let mut nctot = []  let mut nccorr = []  let mut ncsh = []
        let mut r = 0
        while r < n {
            if dead[r] == 0 {
                nckey = nckey + [ckey[r]]
                nclab = nclab + [clab[r]]
                ncbs = ncbs + [cbornsig[r]]
                nctot = nctot + [ctot[r]]
                nccorr = nccorr + [ccorr[r]]
                ncsh = ncsh + [cshcorr[r]]
            }
            r = r + 1
        }
        ckey = nckey  clab = nclab  cbornsig = ncbs
        ctot = nctot  ccorr = nccorr  cshcorr = ncsh

        // ── REPRODUCTION: clonal split of top-REPRO_K by fitness (LIVE mitosis gate) ──
        // rebuild fitness over survivors (same criterion)
        let ns = len(ckey)
        let mut sfit = []
        let mut si = 0
        while si < ns {
            let mut f = 1.0
            if mode == 1 {
                sel_rs = lcg_next(sel_rs)
                f = rand01(sel_rs)
            } else {
                if ctot[si] > 0 {
                    if mode == 2 { f = to_float(cshcorr[si]) / to_float(ctot[si]) }
                    else { f = to_float(ccorr[si]) / to_float(ctot[si]) }
                } else { f = 0.0 }   // unevaluated → not a repro candidate
            }
            sfit = sfit + [f]
            si = si + 1
        }
        let mut picked = []
        let mut p0 = 0
        while p0 < ns { picked = picked + [0]  p0 = p0 + 1 }
        let mut rk = 0
        if mode == 4 { rk = REPRO_K }          // NOSEL: no reproduction either (spawn-only)
        while rk < REPRO_K {
            if len(ckey) >= MAX_CELLS { rk = REPRO_K }
            else {
                // find alive top-fit not yet picked
                let mut bi = 0 - 1
                let mut bd = 0.0 - 1.0
                let mut ii = 0
                let nn = len(sfit)
                while ii < nn {
                    if picked[ii] == 0 && sfit[ii] > bd { bd = sfit[ii]  bi = ii }
                    ii = ii + 1
                }
                if bi >= 0 {
                    picked[bi] = 1
                    let grown = engine_mitosis_tick(len(ckey), cfg)   // LIVE p8 gate
                    if grown > len(ckey) {
                        ckey = ckey + [ckey[bi]]      // clonal copy (exact key)
                        clab = clab + [clab[bi]]      // inherit label
                        cbornsig = cbornsig + [cbornsig[bi]]
                        ctot = ctot + [0]
                        ccorr = ccorr + [0]
                        cshcorr = cshcorr + [0]
                    }
                }
                rk = rk + 1
            }
        }
        g = g + 1
    }

    // ── HELD-OUT: 100 fresh SIGNAL-cluster queries, accuracy vs TRUE answer ──
    let mut hit = 0
    let mut tot = 0
    let mut fired = 0                          // for conditional accuracy (correctness | a cell fires)
    let mut hit_fired = 0
    let mut ho_rs = lcg_next(seed * 101 + 91)
    let mut h = 0
    while h < 100 {
        ho_rs = lcg_next(ho_rs)
        let gid = ho_rs % N_SIG               // signal clusters only (predictable part)
        ho_rs = lcg_next(ho_rs)
        let variant = 2000 + (ho_rs % 1000)   // fresh variants (held-out)
        let ans = gid % 2
        let qk = immune_embed_key(make_query(gid, variant, REP))
        let nr = nearest(ckey, qk)
        let idx = to_int(nr[0])
        let dist = nr[1]
        tot = tot + 1
        if idx >= 0 && dist <= FIRE_RADIUS {
            fired = fired + 1
            if clab[idx] == ans { hit = hit + 1  hit_fired = hit_fired + 1 }
        }
        // no cell fires = wrong (uncovered = fail) — counted in tot only
        h = h + 1
    }
    let acc = to_float(hit) / to_float(tot)
    let cond_acc = if fired > 0 { to_float(hit_fired) / to_float(fired) } else { 0.0 }
    // count signal cells in final pop (diagnostic)
    let mut sc = 0  let mut q = 0
    while q < len(ckey) { if cbornsig[q] == 1 { sc = sc + 1 }  q = q + 1 }
    // distinct SIGNAL clusters covered (dedup by cluster, the real driver of overall acc)
    let mut cov = 0
    let mut cg = 0
    while cg < N_SIG {
        let ck = immune_embed_key(make_query(cg, 5000, REP))
        let nr2 = nearest(ckey, ck)
        if to_int(nr2[0]) >= 0 && nr2[1] <= FIRE_RADIUS { cov = cov + 1 }
        cg = cg + 1
    }
    return [acc, to_float(len(ckey)), to_float(sc), to_float(cov), cond_acc]
}

// run one regime over all seeds; returns [mEXO,mRAND,mSHUF,mNOAPOP,mNOSEL, covEXO,covRAND,covNOSEL, condEXO]
fn run_regime(seeds: [int], n_noise: int, max_cells: int, n_gen: int) -> [float] {
    let ns = len(seeds)
    let mut exo = []  let mut rnd = []  let mut shf = []  let mut noap = []  let mut nosel = []
    let mut cexo = []  let mut crnd = []  let mut cnos = []  let mut condx = []
    let mut s = 0
    while s < ns {
        let re = run_arm(0, seeds[s], n_noise, max_cells, n_gen)
        let rr = run_arm(1, seeds[s], n_noise, max_cells, n_gen)
        let rs = run_arm(2, seeds[s], n_noise, max_cells, n_gen)
        let rn = run_arm(3, seeds[s], n_noise, max_cells, n_gen)
        let rx = run_arm(4, seeds[s], n_noise, max_cells, n_gen)
        exo = exo + [re[0]]  rnd = rnd + [rr[0]]  shf = shf + [rs[0]]  noap = noap + [rn[0]]  nosel = nosel + [rx[0]]
        cexo = cexo + [re[3]]  crnd = crnd + [rr[3]]  cnos = cnos + [rx[3]]  condx = condx + [re[4]]
        println("  [seed " + to_string(seeds[s]) + "] EXO=" + to_string(re[0]) + "(cov=" + to_string(re[3]) + ")  RAND=" + to_string(rr[0]) + "(cov=" + to_string(rr[3]) + ")  SHUF=" + to_string(rs[0]) + "  NOAPOP=" + to_string(rn[0]) + "  NOSEL=" + to_string(rx[0]) + "(cov=" + to_string(rx[3]) + ")")
        s = s + 1
    }
    return [fmean(exo), fmean(rnd), fmean(shf), fmean(noap), fmean(nosel), fmean(cexo), fmean(crnd), fmean(cnos), fmean(condx)]
}

fn report_regime(name: string, r: [float], n_noise: int, max_cells: int) {
    let mexo = r[0]  let mrnd = r[1]  let mshf = r[2]  let mnoap = r[3]  let mnosel = r[4]
    let d1 = mexo - mrnd
    let d2 = mexo - mshf
    let d3 = mexo - mnoap
    let dN = mexo - mnosel          // THE DECISIVE test: does selection beat NO-selection?
    println("")
    println("--- REGIME " + name + "  (N_SIG=12 N_NOISE=" + to_string(n_noise) + " MAX_CELLS=" + to_string(max_cells) + ") ---")
    println("  coverage/12  EXO=" + to_string(r[5]) + " RAND=" + to_string(r[6]) + " NOSEL=" + to_string(r[7]) + "   cond_acc|fire EXO=" + to_string(r[8]))
    println("  held-out acc EXO=" + to_string(mexo) + " RAND=" + to_string(mrnd) + " SHUF=" + to_string(mshf) + " NOAPOP=" + to_string(mnoap) + " NOSEL=" + to_string(mnosel))
    println("  B1 EXO-RAND=" + to_string(d1) + " (>=0.15 " + (if d1>=0.15 {"PASS"} else {"FAIL"}) + ")   B2 EXO-SHUF=" + to_string(d2) + " (>=0.15 " + (if d2>=0.15 {"PASS"} else {"FAIL"}) + ")   B3 EXO-NOAPOP=" + to_string(d3) + " (>=0.10 " + (if d3>=0.10 {"PASS"} else {"FAIL"}) + ")")
    println("  ** DECISIVE  EXO-NOSEL=" + to_string(dN) + " (>=0.10 = selection is a POSITIVE channel; <=0 = selection net-HARMFUL) -> " + (if dN>=0.10 {"SELECTION HELPS"} else { if dN <= 0.0 {"SELECTION HARMFUL vs doing nothing"} else {"selection ~neutral"} }))
}

fn main() {
    let seeds = [70105, 70106, 70107, 70108, 70109]

    // ── B4 data-validity: within-cluster vs cross-cluster L2 (generator sanity) ──
    let ka = immune_embed_key(make_query(3, 11, 20))
    let kb = immune_embed_key(make_query(3, 88, 20))
    let kc = immune_embed_key(make_query(7, 11, 20))
    let within = l2(ka, kb)
    let cross  = l2(ka, kc)
    let b4_ok = within < 0.30 && cross > 0.30

    println("=== H_9105 CONSEQUENCE-DRIVEN MITOSIS — engine-native (immune_embed_key + engine_mitosis_tick, live core/) ===")
    println("N_SEEDS=5 N_GEN=20 BATCH=60 KILL_K=2 REPRO_K=2 FIRE_RADIUS=0.30 (== engine SPLIT_THRESH)")
    println("[B4 data-validity] within-cluster L2=" + to_string(within) + " cross-cluster L2=" + to_string(cross) + " -> " + (if b4_ok {"VALID (within<0.30<cross)"} else {"INVALID — run void"}))
    println("")
    println("REGIME A (balanced 12 signal / 12 noise):")
    let rA = run_regime(seeds, 12, 12, 20)
    println("")
    println("REGIME B (noise-heavy 12 signal / 36 noise — MAXIMALLY favors apoptosis-enrichment, signal cells immortal):")
    let rB = run_regime(seeds, 36, 12, 20)

    report_regime("A", rA, 12, 12)
    report_regime("B", rB, 36, 12)

    // consolidated honest verdict grounded in the DECISIVE EXO-vs-NOSEL comparison
    let dNA = rA[0] - rA[4]
    let dNB = rB[0] - rB[4]
    let helpsA = dNA >= 0.10
    let helpsB = dNB >= 0.10
    let harmfulA = dNA <= 0.0
    let harmfulB = dNB <= 0.0

    println("")
    println("================================ CONSOLIDATED VERDICT ================================")
    if helpsA || helpsB {
        println("VERDICT: 🟠 DIRECTIONAL — consequence-selection beats NO-selection in " + (if helpsA && helpsB {"BOTH regimes"} else { if helpsB {"the noise-heavy regime only (apoptosis-enrichment channel)"} else {"the balanced regime only"} }) + ".")
        println("  Exogenous real-task fitness allocates finite clonal capacity better than doing nothing — the missing")
        println("  ingredient WAS partly selection-absence, but only via APOPTOSIS-ENRICHMENT (immortal-signal / churn-noise),")
        println("  NOT via reproduction (clonal split only duplicates covered clusters — H_1310 'split can't target the")
        println("  uncovered region' wall persists). engine-native. SCOPE: no compositional-depth claim.")
    } else {
        if harmfulA && harmfulB {
            println("VERDICT: 🔴 SELECTION INERT-TO-HARMFUL (honest, bars frozen) — the C2 thesis is FALSIFIED.")
            println("  EXO beats RAND/SHUF (B1/B2 may PASS) ONLY because random/shuffled churn is DESTRUCTIVE — the")
            println("  proper no-selection baseline (NOSEL = just spawn cells) BEATS consequence-selection in both regimes")
            println("  (EXO-NOSEL<=0). Consequence-driven selection is NOT a positive information channel: reproduction")
            println("  clonally DUPLICATES (H_1310 split-can't-target-uncovered wall) and apoptosis destroys coverage.")
            println("  The from-scratch pure-split wall's bottleneck was NOT selection-absence. DPI/wall reconfirmed")
            println("  ENGINE-NATIVE (H_1568 selection-mitosis INERT, DIRECTIONAL-only, now engine-native + no-sel baseline).")
        } else {
            println("VERDICT: 🔴 SELECTION NOT A POSITIVE CHANNEL — EXO does not clear NO-selection baseline (EXO-NOSEL<0.10)")
            println("  in either regime; B1/B2 divergence from random is a random-is-destructive artifact. Wall reconfirmed.")
        }
    }
    println("NOTE: B1/B2 (EXO vs RAND/SHUF) reported VERBATIM above; the NOSEL baseline (added as a stricter control,")
    println("  making GREEN HARDER not easier — c9 no tune-to-green) is the load-bearing test of the C2 thesis.")
}
