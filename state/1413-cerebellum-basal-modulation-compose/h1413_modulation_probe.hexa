// h1413_modulation_probe.hexa — H_1413: a BIOLOGICALLY-FAITHFUL cerebellum×basal
// MODULATION composition (a_no_llm_frame_trap c16 breakthrough of the H_1412 🧱).
//
// H_1412 re-scored the H_1407 cerebellum×basal compose ENGINE-NATIVE and came back 🧱:
// two CONFIDENCE-ARBITRATION arbiters (mean-relative magnitude AND z-decisiveness) both
// FAILED the frozen +0.05 net-lift bar (compose +0.011 / z +0.014). Root cause: an
// arbitration framing lets the cerebellum's LOUD-but-WRONG vote (the F5 adversarial family)
// OVERRIDE the basal ganglia, and the live basal gate is a strong standalone arm so the
// net-lift headroom shrinks below the bar.
//
// DIFFERENT LENS (real neuroscience, NOT another vote rule): the cerebellum does NOT
// arbitrate against the basal ganglia. The basal ganglia makes the FINAL go/no-go; the
// cerebellar forward model only MODULATES (facilitates) the basal threshold by a BOUNDED
// amount (the cerebello-thalamo-basal loop). So:
//   composed_go = basal_go_margin  +  tanh(z_cerebellum) * basal_std
//   decision = PRED iff composed_go > GO_THR, else COMPETITOR
// where z_cerebellum = (E_THR − pred_err)/cerebellum_std (cerebellar confidence that the
// PREDICTED move is good), tanh BOUNDS the facilitation to ±basal_std (NO free knob: gain
// 1.0, the saturating nonlinearity is the bound), and the basal margin makes the final call.
//
// WHY THIS CAN BREAK THE WALL where arbitration could not:
//   · F1 (basal TIE, cerebellum confident-correct): the bounded facilitation BREAKS the tie
//     toward PRED → newly correct (basal-alone is ~chance here).
//   · F5 (basal STRONG-neg & correct, cerebellum confident-WRONG): the facilitation is
//     BOUNDED (≤ basal_std) so it CANNOT overturn the strong basal veto → stays correct.
//     (this is exactly the case the arbitration framing got WRONG.)
//   The bound is what an arbiter lacks: the cerebellum can break ties but never override a
//   confident basal decision — the biological asymmetry.
//
// FROZEN H_1407 BARS (verbatim, NOT moved — same as H_1412):
//   (B1 COMPOSE-EFFECT) acc_compose >= best_single + 0.05
//   (B2 ORACLE)         acc_oracle  − best_single > 0.02
//   (B3 EARNED)         acc_compose − acc_shuffle  > 0.02
//   (SEPARABLE)         only_cerebellum>0 AND only_basal>0
// PRE-REGISTERED modulation: tanh-bounded, gain 1.0, NO tuned knob. If it ALSO fails B1,
// the cerebellum×basal compose does not bind engine-native under EITHER lens → honest 🧱.
// p7 = accuracies + decomposition. $0 CPU. LIVE vforward_err (H_1280) / vbasal_go_value (H_1281).

import "core/engine_cli.hexa"
import "core/brain.hexa"

fn _SEEDS() -> [int] { return [4700, 4701, 4702] }
const N_PER_FAMILY: int = 90
const AMBIG_NOISE: float = 0.18
const E_THR: float = 0.30
const GO_THR: float = 0.0
const COMPOSE_DELTA: float = 0.05
const ORACLE_MARGIN: float = 0.02
const SHUFFLE_TOL: float = 0.02

fn _f4(x: float) -> string { return to_string(x) }

// tanh via exp (no stdlib tanh): tanh(x) = (e^2x − 1)/(e^2x + 1), clamped for stability.
fn _tanh(x: float) -> float {
    let mut z = x
    if z > 20.0 { z = 20.0 }
    if z < -20.0 { z = -20.0 }
    let e2 = exp(2.0 * z)
    return (e2 - 1.0) / (e2 + 1.0)
}

// deterministic standard-normal jitter (Box–Muller over an LCG) — same as H_1407/H_1412.
fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}
fn _jit(x: float, seed: int, idx: int, salt: int) -> float {
    return x + AMBIG_NOISE * _stdnorm(seed, idx, salt)
}

// LIVE faculty reads (inlined over EXISTING engine primitives — same as H_1412).
fn _cb_read(ff: VForwardField, ctx: [float], x: [float], e_thr: float) -> [float] {
    let err = vforward_err(ff, ctx, x)
    let sgnd = e_thr - err
    let dec = if err < e_thr { 1.0 } else { 0.0 }
    let mabs = if sgnd < 0.0 { 0.0 - sgnd } else { sgnd }
    return [dec, mabs, sgnd]
}
fn _bg_read(bg: VBasalGate, pred_feats: [float], comp_feats: [float], go_thr: float) -> [float] {
    let gv_pred = vbasal_go_value(bg, pred_feats)
    let gv_comp = vbasal_go_value(bg, comp_feats)
    let margin = gv_pred - gv_comp
    let dec = if margin > go_thr { 1.0 } else { 0.0 }
    return [dec, margin]
}

// the 5 H_1407 families (VERBATIM from H_1412 _item).
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut pred_error = 0.0
    let mut go_margin = 0.0
    let mut correct = 0.0
    if fam == 0 {
        pred_error = _jit(0.12, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(0.0, seed, i, 2)
        correct = 1.0
    } else if fam == 1 {
        pred_error = E_THR + _jit(0.0, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(-0.5, seed, i, 2)
        correct = 0.0
    } else if fam == 2 {
        pred_error = _jit(0.10, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(0.5, seed, i, 2)
        correct = 1.0
    } else if fam == 3 {
        pred_error = _jit(0.08, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(-0.45, seed, i, 2)
        correct = 1.0
    } else {
        pred_error = _jit(0.05, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(-0.6, seed, i, 2)
        correct = 0.0
    }
    return [pred_error, go_margin, correct]
}

fn _trained_gate(cfg: EngineConfig) -> VBasalGate {
    let mut bg = vbasal_new(1, 0.20)
    let mut t = 0
    while t < 40 {
        bg = vbasal_update(bg, 0, [1.0], 1.0)
        t = t + 1
    }
    return bg
}

// run_seed — MODULATION composition + frozen bars on the LIVE faculties.
// returns [acc_cb, acc_bg, best, acc_compose, acc_shuffle, acc_oracle,
//          only_c, only_b, both, neither]
fn run_seed(seed: int, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY
    let ff = vforward_new(1, 1, 0.10)
    let bg = _trained_gate(cfg)

    // pass 1: live reads + cerebellum-confidence mean/std (for z), basal margin std (for the bound).
    let mut cb_dec: [float] = []   let mut cb_conf: [float] = []   // conf = E_THR − err (signed)
    let mut bg_dec: [float] = []   let mut bg_marg: [float] = []
    let mut corr: [float] = []
    let mut sum_c = 0.0  let mut sum_m = 0.0
    let mut i = 0
    while i < n {
        let it = _item(seed, i)
        let pe = it[0]  let gm = it[1]
        corr = corr + [it[2]]
        let cr = _cb_read(ff, [0.0], [sqrt(pe)], E_THR)   // cr=[dec, |conf|, signed_conf]
        cb_dec = cb_dec + [cr[0]]
        cb_conf = cb_conf + [cr[2]]                       // SIGNED cerebellar confidence toward PRED
        sum_c = sum_c + cr[2]
        let br = _bg_read(bg, [gm], [0.0], GO_THR)         // br=[dec, margin]
        bg_dec = bg_dec + [br[0]]
        bg_marg = bg_marg + [br[1]]
        sum_m = sum_m + br[1]
        i = i + 1
    }
    let cmean = sum_c / to_float(n)
    let mmean = sum_m / to_float(n)
    let mut ssc = 0.0  let mut ssm = 0.0  let mut vi = 0
    while vi < n {
        let dc = cb_conf[vi] - cmean  ssc = ssc + dc * dc
        let dm = bg_marg[vi] - mmean  ssm = ssm + dm * dm
        vi = vi + 1
    }
    let cstd = sqrt(ssc / to_float(n)) + 0.000001
    let mstd = sqrt(ssm / to_float(n)) + 0.000001

    // pass 2: accuracies + MODULATION compose + oracle + decomposition.
    let mut on_cb = 0  let mut on_bg = 0  let mut on_c = 0  let mut on_o = 0
    let mut only_c = 0  let mut only_b = 0  let mut both = 0  let mut neither = 0
    let mut j = 0
    while j < n {
        let cd = cb_dec[j]  let bd = bg_dec[j]  let ct = corr[j]
        // MODULATION: basal margin + bounded cerebellar facilitation (tanh(z_c)*basal_std).
        let zc = cb_conf[j] / cstd
        let composed_go = bg_marg[j] + _tanh(zc) * mstd
        let comp = if composed_go > GO_THR { 1.0 } else { 0.0 }
        let cb_ok = cd == ct
        let bg_ok = bd == ct
        if cb_ok { on_cb = on_cb + 1 }
        if bg_ok { on_bg = on_bg + 1 }
        if comp == ct { on_c = on_c + 1 }
        if cb_ok || bg_ok { on_o = on_o + 1 }
        if cb_ok && !bg_ok { only_c = only_c + 1 }
        if bg_ok && !cb_ok { only_b = only_b + 1 }
        if cb_ok && bg_ok { both = both + 1 }
        if !cb_ok && !bg_ok { neither = neither + 1 }
        j = j + 1
    }

    // SHUFFLE control: permute which cerebellar confidence modulates which basal item.
    let mut perm: [int] = []
    let mut s = 0
    while s < n { perm = perm + [s]  s = s + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r = st % (a + 1)
        let tmp = perm[a]  perm[a] = perm[r]  perm[r] = tmp
        a = a - 1
    }
    let mut on_s = 0
    let mut k = 0
    while k < n {
        let zc = cb_conf[perm[k]] / cstd
        let composed_go = bg_marg[k] + _tanh(zc) * mstd
        let comp = if composed_go > GO_THR { 1.0 } else { 0.0 }
        if comp == corr[k] { on_s = on_s + 1 }
        k = k + 1
    }

    let dn = to_float(n)
    let acc_cb = to_float(on_cb) / dn
    let acc_bg = to_float(on_bg) / dn
    let best = if acc_cb >= acc_bg { acc_cb } else { acc_bg }
    return [acc_cb, acc_bg, best, to_float(on_c)/dn, to_float(on_s)/dn, to_float(on_o)/dn,
            to_float(only_c)/dn, to_float(only_b)/dn, to_float(both)/dn, to_float(neither)/dn]
}

fn main() {
    println("================================================================================")
    println("H_1413 — BIOLOGICAL cerebellum×basal MODULATION compose (c16 new lens of H_1412 🧱)")
    println("  basal makes the final go/no-go; cerebellar confidence FACILITATES the threshold by a")
    println("  BOUNDED tanh(z_c)*basal_std (gain 1.0, NO free knob). Frozen H_1407 bars, NOT moved.")
    println("  $0 CPU · 3 seeds [4700,4701,4702] · LIVE vforward_err / vbasal_go_value · p7 · p8")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let seeds = _SEEDS()
    let mut acc_cb = 0.0  let mut acc_bg = 0.0  let mut best = 0.0  let mut acc_c = 0.0
    let mut acc_s = 0.0  let mut acc_o = 0.0
    let mut o_c = 0.0  let mut o_b = 0.0  let mut bo = 0.0  let mut ne = 0.0
    let ns = to_float(len(seeds))
    let mut si = 0
    while si < len(seeds) {
        let r = run_seed(seeds[si], cfg)
        println("  seed " + to_string(seeds[si]) + ": cb=" + _f4(r[0]) + " bg=" + _f4(r[1])
              + " best=" + _f4(r[2]) + " MODcompose=" + _f4(r[3]) + " shuf=" + _f4(r[4])
              + " oracle=" + _f4(r[5]) + " [onlyCB=" + _f4(r[6]) + " onlyBG=" + _f4(r[7])
              + " both=" + _f4(r[8]) + " neither=" + _f4(r[9]) + "]")
        acc_cb = acc_cb + r[0]  acc_bg = acc_bg + r[1]  best = best + r[2]  acc_c = acc_c + r[3]
        acc_s = acc_s + r[4]  acc_o = acc_o + r[5]
        o_c = o_c + r[6]  o_b = o_b + r[7]  bo = bo + r[8]  ne = ne + r[9]
        si = si + 1
    }
    acc_cb = acc_cb/ns  acc_bg = acc_bg/ns  best = best/ns  acc_c = acc_c/ns
    acc_s = acc_s/ns  acc_o = acc_o/ns  o_c = o_c/ns  o_b = o_b/ns  bo = bo/ns  ne = ne/ns

    println("--------------------------------------------------------------------------------")
    println("MEAN (3 seeds, ENGINE-NATIVE MODULATION):")
    println("  acc_cerebellum = " + _f4(acc_cb) + "  acc_basal = " + _f4(acc_bg) + "  best_single = " + _f4(best))
    println("  acc_MODcompose = " + _f4(acc_c) + "  acc_shuffle = " + _f4(acc_s) + "  ORACLE = " + _f4(acc_o))
    println("  decomposition  : onlyCB=" + _f4(o_c) + " onlyBG=" + _f4(o_b) + " both=" + _f4(bo) + " neither=" + _f4(ne))

    let B1 = acc_c >= best + COMPOSE_DELTA
    let B2 = (acc_o - best) > ORACLE_MARGIN
    let B3 = (acc_c - acc_s) > SHUFFLE_TOL
    let SEP = o_c > 0.0 && o_b > 0.0
    println("--------------------------------------------------------------------------------")
    println("  (B1 COMPOSE-EFFECT) MODcompose " + _f4(acc_c) + " >= best+0.05 (" + _f4(best + COMPOSE_DELTA)
          + ") : " + (if B1 { "PASS" } else { "FAIL" }))
    println("  (B2 ORACLE)         oracle-best " + _f4(acc_o - best) + " > 0.02 : " + (if B2 { "PASS" } else { "FAIL" }))
    println("  (B3 EARNED)         MODcompose-shuffle " + _f4(acc_c - acc_s) + " > 0.02 : " + (if B3 { "PASS" } else { "FAIL" }))
    println("  (SEPARABLE)         onlyCB>0 AND onlyBG>0 : " + (if SEP { "PASS" } else { "FAIL" }))
    println("================================================================================")
    if B1 && B2 && B3 && SEP {
        println("VERDICT: 🟢 MODULATION COMPOSE-LIFT (ENGINE-NATIVE) — the cerebello-basal MODULATION")
        println("  loop BINDS engine-native where confidence-ARBITRATION (H_1412) did not: the bounded")
        println("  facilitation breaks basal ties (F1) WITHOUT overturning strong basal vetoes (F5).")
        println("  The c16 new-lens (real neuroscience) BREAKS the H_1412 wall. → wire-in follow-on.")
    } else {
        println("VERDICT: 🧱 — modulation ALSO fails a frozen bar; cerebellum×basal does not bind")
        println("  engine-native under EITHER lens (arbitration H_1412 AND modulation H_1413). Terminal.")
    }
    println("  HONEST (c9): frozen H_1407 bars NOT moved. tanh-bounded gain 1.0, NO tuned knob.")
    println("  Toy 5-family/3-seed/deterministic. LIVE vforward_err/vbasal_go_value. Scale UNVERIFIED.")
    if !(B1 && B2 && B3 && SEP) { exit(1) }
}
