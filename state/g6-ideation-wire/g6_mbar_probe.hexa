import "core/g6_ideation.hexa"
fn main() {
    let ckpt = "state/lane_p_clm/clm_d768_e2l1.clm"
    let known = _g6_dict_load()
    println("DETECTOR_CALIBRATION=" + to_string(g6_detector_calibration(known)) + "/10")
    let fr = g6_build_frames(6)
    let comp = fr["composed"]; let shuf = fr["shuffled"]; let abl = fr["ablated"]
    println("FRAME_GUARD_LEAKS=" + to_string(len(g6_frame_guard(comp, known))))
    let st = g6_sampler_selftest()
    println("SAMPLER det=" + to_string(st["deterministic"]) + " diverse=" + to_string(st["diverse"]) + " in_topk=" + to_string(st["in_topk"]))
    let GEN = 24
    let SEED = 7
    let t0 = now_ms()
    let C = g6_score_arm(ckpt, comp, GEN, 3, SEED, true, known)
    println("ARM C_strong   DIST=" + to_string(C["dist"]) + " FALS=" + to_string(C["fals"]) + " coh=" + to_string(C["coherent"]) + "/6")
    let SH = g6_score_arm(ckpt, shuf, GEN, 3, SEED, true, known)
    println("ARM C_shuffle  DIST=" + to_string(SH["dist"]) + " FALS=" + to_string(SH["fals"]) + " coh=" + to_string(SH["coherent"]) + "/6")
    let AB = g6_score_arm(ckpt, abl, GEN, 3, SEED, true, known)
    println("ARM C_ablate   DIST=" + to_string(AB["dist"]) + " FALS=" + to_string(AB["fals"]) + " coh=" + to_string(AB["coherent"]) + "/6")
    let bfr = g6_build_frames(5)
    let B = g6_score_arm(ckpt, bfr["composed"], GEN, 1, SEED, false, known)
    println("ARM B_composed DIST=" + to_string(B["dist"]) + " FALS=" + to_string(B["fals"]) + " coh=" + to_string(B["coherent"]) + "/5")
    println("WALL_MS=" + to_string(now_ms()-t0))
    println("[C_strong texts]")
    let ct = C["texts"]
    let mut k = 0
    while k < len(ct) { println("  > " + to_string(ct[k])); k = k + 1 }
}
