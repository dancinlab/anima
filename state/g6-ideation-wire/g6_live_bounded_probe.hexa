import "CORE/clm_decode.hexa"
fn main() {
    let ckpt = "state/lane_p_clm/clm_d768_e2l1.clm"
    let frame = "if memory composes into new meaning, then silence: "
    let t0 = now_ms()
    let offs = [0, 101, 202]
    let outs = []
    let mut i = 0
    while i < 3 {
        let r = clm_decode_topk_sampled(ckpt, frame, 12, 40, 0.7, 7 + offs[i])
        outs.push(to_string(r["text"]))
        println("cand[" + to_string(i) + "] = " + to_string(r["text"]))
        i = i + 1
    }
    let dt = now_ms() - t0
    let diverse = !(to_string(outs[0]) == to_string(outs[1]) && to_string(outs[1]) == to_string(outs[2]))
    println("LIVE best-of-K DIVERSITY = " + to_string(diverse) + "  [" + to_string(dt) + "ms]")
    // determinism: same seed twice -> identical
    let a = clm_decode_topk_sampled(ckpt, frame, 12, 40, 0.7, 7)
    let b = clm_decode_topk_sampled(ckpt, frame, 12, 40, 0.7, 7)
    println("DETERMINISM (same seed identical) = " + to_string(to_string(a["text"]) == to_string(b["text"])))
    // argmax control identical (best-of-K no-op)
    let g0 = clm_decode_argmax(ckpt, frame, 12)
    let g1 = clm_decode_argmax(ckpt, frame, 12)
    println("ARGMAX identical (best-of-K no-op on argmax) = " + to_string(to_string(g0["text"]) == to_string(g1["text"])))
}
