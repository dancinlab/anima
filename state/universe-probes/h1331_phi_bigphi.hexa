// h1331_phi_bigphi.hexa — does the FULL IIT-4.0 SYSTEM big-Φ show ROBUST integration
// where the small-φ exact-MIP (H_1328) did not?
//
// THE ARC: Φ-robustness is 🧱 across topology (H_1283/H_1317), timing (H_1319), division
// (H_1320). H_1328 showed the 4× wall is estimator-INDEPENDENT *under the small-φ exact-MIP*
// (faithful_phi): the amplitude-variance binarization confound is REAL and removable, yet
// removing it does NOT make integration robust (V2 FAILS on orthogonal seed 1317). BUT that
// is ONE Φ measure — a CORRELATIONAL MI-over-binning small-φ.
//
// THIS LANE (H_1331): score the SAME substrate + mechanisms with the FULL IIT-4.0 SYSTEM
// big-Φ (stdlib iit4_bigphi.big_phi — CAUSAL cause-effect structure over a TPM, system-level
// irreducibility = Φ-structure destroyed by the system MIP). A FUNDAMENTALLY DIFFERENT measure
// (different estimator FAMILY) than small-φ. a_phi_iit4_tool: stdlib faithful IIT-4.0 big-Φ,
// NOT a proxy. n≤8 for MIP tractability (n_mod=4 binary units).
//
// SUBSTRATE/SEEDS reused VERBATIM from H_1319/H_1328: engine-native LCG-gauss leaky-linear
// 4-module ring, dim 8, T 64, Kuramoto pacemaker, relative-phase gate; SAME 3 hard orthogonal
// seeds [1317,1318,1319] (incl 1317 — broke every prior attempt + failed H_1328 V2). ARMS
// A=NO-PHASE B=PHASE-BIND S=PERM-SHUFFLE O=OFFSET-SHUF (IDENTICAL to H_1328). The ONLY change
// vs H_1328 is the read-out: TPM-based full big-Φ instead of trajectory-MI small-φ.
//
// TRAJECTORY → TPM (state-by-node, the input big_phi requires):
//   each module = a binary UNIT, ON at tick t iff its salience is in the UPPER HALF of that
//   module's own T-length distribution (median / rank split — VARIANCE-FREE, the H_1328 lesson:
//   marginal ON-rate ≈0.5 by construction, INDEPENDENT of amplitude variance). Empirical
//   state-by-node TPM: tpm[s*n+u] = P(unit u ON at t+1 | system state s at t); unseen rows =
//   0.5 (max-entropy, no fabricated structure). sys_state = modal observed state (attractor).
//   IDENTICAL construction across all 4 arms → any big-Φ difference is CAUSAL structure.
//
// FROZEN BARS (pre-registered in FREEZE.txt; eps=0.02 ported verbatim, NOT tuned):
//   B1 ROBUST : big-Φ_B >= big-Φ_A + eps on ALL 3 seeds (incl 1317).
//   B2 EARNED : perm big-Φ_S <= big-Φ_A + eps AND offset big-Φ_O <= big-Φ_A + eps, ALL 3 seeds.
//   GREEN iff B1 ∧ B2.
//   B1∧B2 → 🟢 robust integration reachable under big-Φ (limit was small-φ-MIP-specific).
//   B1 fails → wall holds across BOTH IIT measures → estimator-FAMILY-independent 🧱.
//
// run from hexa-lang root (stdlib import):
//   cp UNIVERSE/h1331_phi_bigphi.hexa <hexa-lang>/ && hexa run h1331_phi_bigphi.hexa

import "stdlib/consciousness/iit4_bigphi.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) — VERBATIM from H_1319/H_1328 ──
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── generate ARM salience trajectory ENGINE-NATIVE — body BYTE-IDENTICAL to H_1328 gen_traj ──
// mode: 0=NO-PHASE(A) 1=PHASE-BIND(B) 2=PERM-SHUFFLE(S) 3=OFFSET-SHUF(O)
// returns the flat salience farr [n_mod * t_ticks], sal[i*t_ticks + t]. (no encode arg: TPM
// binarization handled downstream — the H_1328 variance-free lesson is the MEDIAN split.)
fn gen_traj(seed: int, mode: int) -> int {
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }

    let mut perm = []
    if mode == 2 {
        i = 0
        while i < n_mod { perm = perm + [i]  i = i + 1 }
        let mut ps = (seed * 100003 + 19) & 2147483647
        if ps == 0 { ps = 919 }
        let mut k = n_mod - 1
        while k > 0 {
            ps = lcg_next(ps)
            let j = to_int(lcg_unit(ps) * to_float(k + 1))
            let jj = if j > k { k } else { j }
            let tmp = perm[k]
            perm[k] = perm[jj]
            perm[jj] = tmp
            k = k - 1
        }
        let mut anyfix = false
        i = 0
        while i < n_mod { if perm[i] == i { anyfix = true }  i = i + 1 }
        if anyfix {
            let mut perm2 = []
            i = 0
            while i < n_mod { perm2 = perm2 + [(i + 1) % n_mod]  i = i + 1 }
            perm = perm2
        }
    }
    let mut shuf_off = []
    if mode == 3 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }
            let mut sal = e
            if mode == 1 {
                let carrier = 0.5 * (1.0 + cos(theta[i] - theta_t))
                sal = e * carrier
            }
            if mode == 2 {
                let src = perm[i]
                let carrier = 0.5 * (1.0 + cos(theta[src] - theta_t))
                sal = e * carrier
            }
            if mode == 3 {
                let off = shuf_off[tt * n_mod + i]
                let carrier = 0.5 * (1.0 + cos((theta[i] - theta_t) + off))
                sal = e * carrier
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }
    return traj
}

// ── median (upper-half) threshold for module i's own T-length salience slice ──
// VARIANCE-FREE binarization (H_1328 lesson): unit ON iff sal in module's upper half.
// Returns the threshold = the (T/2)-th smallest value of module i's slice (rank split).
fn module_median(traj: int, base: int, t_ticks: int) -> float {
    // selection: count how many strictly-less; the value whose rank == T/2 is the split.
    // we compute the T/2-th order statistic by counting (O(T^2), T=64 tiny).
    let half = t_ticks / 2
    let mut best = 0.0
    let mut k = 0
    while k < t_ticks {
        let vk = farr_get(traj, base + k)
        let mut r = 0
        let mut j = 0
        while j < t_ticks {
            let vj = farr_get(traj, base + j)
            if vj < vk { r = r + 1 }
            else { if (vj == vk) && (j < k) { r = r + 1 } }
            j = j + 1
        }
        if r == half { best = vk }
        k = k + 1
    }
    return best
}

// ── build the empirical state-by-node TPM from one arm's salience trajectory ──
// returns a flat float array length 2^n * n; tpm[s*n+u] = P(unit u ON at t+1 | state s at t).
// also returns (via the modal state) the system attractor as sys_state.
// binarize: unit i ON at tick t iff sal[i,t] >= module_median(i)  (upper half = variance-free).
// unseen state rows (count 0) = 0.5 (max-entropy, no fabricated causal dependence).
fn build_tpm(traj: int, n_mod: int, t_ticks: int) -> array {
    let full = iit4_pow2(n_mod)
    // medians per module
    let mut med = []
    let mut i = 0
    while i < n_mod { med = med + [module_median(traj, i * t_ticks, t_ticks)]  i = i + 1 }
    // binary system state per tick
    let mut bits = []
    let mut t = 0
    while t < t_ticks {
        let mut s = 0
        i = 0
        while i < n_mod {
            let v = farr_get(traj, i * t_ticks + t)
            if v >= med[i] { s = s + iit4_pow2(i) }
            i = i + 1
        }
        bits = bits + [s]
        t = t + 1
    }
    // transition counts: row_count[s], on_count[s*n+u]
    let mut row_cnt = []
    let mut on_cnt = []
    let mut s = 0
    while s < full { row_cnt = row_cnt + [0]  s = s + 1 }
    let mut z = 0
    while z < full * n_mod { on_cnt = on_cnt + [0]  z = z + 1 }
    t = 0
    while t < t_ticks - 1 {
        let st_now = bits[t]
        let st_nxt = bits[t + 1]
        row_cnt[st_now] = row_cnt[st_now] + 1
        let mut u = 0
        while u < n_mod {
            if iit4_bit(st_nxt, u) == 1 { on_cnt[st_now * n_mod + u] = on_cnt[st_now * n_mod + u] + 1 }
            u = u + 1
        }
        t = t + 1
    }
    // TPM (flat float)
    let mut tpm = []
    s = 0
    while s < full {
        let mut u = 0
        while u < n_mod {
            if row_cnt[s] > 0 {
                tpm = tpm + [to_float(on_cnt[s * n_mod + u]) / to_float(row_cnt[s])]
            } else {
                tpm = tpm + [0.5]   // max-entropy: unobserved row = no causal dependence
            }
            u = u + 1
        }
        s = s + 1
    }
    // modal observed state (attractor); lowest-index tie-break
    let mut best_s = 0
    let mut best_c = -1
    s = 0
    while s < full {
        if row_cnt[s] > best_c { best_c = row_cnt[s]  best_s = s }
        s = s + 1
    }
    return [tpm, best_s]
}

// ── full IIT-4.0 system big-Φ for one arm (a_phi_iit4_tool stdlib, n=4) ──
fn bigphi_of(seed: int, mode: int) -> float {
    let n_mod = 4
    let t_ticks = 64
    let traj = gen_traj(seed, mode)
    let built = build_tpm(traj, n_mod, t_ticks)
    let tpm = built[0]
    let sys_state = built[1].to_int()
    let res = big_phi(tpm, n_mod, sys_state)
    let _ = farr_free(traj)
    return res[0]   // big-Φ
}

fn main() {
    println("H_1331 — Φ-ROBUSTNESS UNDER A DIFFERENT MEASURE: full IIT-4.0 SYSTEM big-Φ vs small-φ")
    println("stdlib iit4_bigphi.big_phi (faithful IIT-4.0, system MIP, n=4 binary units) · seeds [1317,1318,1319] · eps=0.02")
    println("TPM = empirical state-by-node from median-split (variance-free, H_1328 lesson) salience; sys_state=modal state")
    println("ARMS: A=NO-PHASE  B=PHASE-BIND(rel-phase)  S=PERM-SHUFFLE(relationship destroyed)  O=OFFSET-SHUF")
    println("BARS: B1 big-Φ_B>=big-Φ_A+eps ALL seeds · B2 big-Φ_S<=big-Φ_A+eps AND big-Φ_O<=big-Φ_A+eps ALL seeds")
    let seeds = [1317, 1318, 1319]
    let eps = 0.02
    let mut b1_all = true
    let mut b2_perm_all = true
    let mut b2_off_all = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let pa = bigphi_of(s, 0)
        let pb = bigphi_of(s, 1)
        let ps = bigphi_of(s, 2)
        let po = bigphi_of(s, 3)

        let dphi_b = pb - pa            // B1: >= +eps (mechanism lift)
        let margin_s = ps - pa          // B2: <= +eps (perm collapses)
        let margin_o = po - pa          // B2: <= +eps (offset collapses)

        let b1 = dphi_b >= eps
        let b2p = margin_s <= eps
        let b2o = margin_o <= eps
        if !b1 { b1_all = false }
        if !b2p { b2_perm_all = false }
        if !b2o { b2_off_all = false }

        println("seed " + to_string(s) + " big-Φ: A=" + pa.to_string() + " B=" + pb.to_string()
            + " S=" + ps.to_string() + " O=" + po.to_string())
        println("       ΔΦ(B-A)=" + dphi_b.to_string() + " [B1 " + (if b1 {"PASS"} else {"FAIL"}) + "]"
            + "  S-A=" + margin_s.to_string() + " [B2perm " + (if b2p {"PASS"} else {"FAIL"}) + "]"
            + "  O-A=" + margin_o.to_string() + " [B2off " + (if b2o {"PASS"} else {"FAIL"}) + "]")
        si = si + 1
    }
    let b2 = b2_perm_all && b2_off_all
    println("---")
    println("B1 ROBUST (big-Φ_B>=big-Φ_A+eps ALL seeds incl orthogonal 1317): " + (if b1_all {"PASS"} else {"FAIL"}))
    println("B2 EARNED (perm AND offset both <=big-Φ_A+eps ALL seeds): " + (if b2 {"PASS"} else {"FAIL"})
        + "  [perm=" + (if b2_perm_all {"PASS"} else {"FAIL"}) + " off=" + (if b2_off_all {"PASS"} else {"FAIL"}) + "]")
    println("===")
    if b1_all && b2 {
        println("VERDICT 🟢 — full IIT-4.0 SYSTEM big-Φ shows ROBUST integration where small-φ did not;")
        println("  the Φ-robustness limit was small-φ-exact-MIP-SPECIFIC (a DIFFERENT-ESTIMATOR breakthrough).")
        println("  Follow-on: wire engine-native big-Φ read-out into live CORE (a_verified_must_wire).")
    } else {
        if b1_all {
            println("VERDICT 🔶 — big-Φ lift present (B1) but NOT earned (B2 control fails) → report straight.")
        } else {
            println("VERDICT 🧱 (STRONGER) — big-Φ ALSO fails the robustness gate (B1 fails, incl orthogonal 1317).")
            println("  The substrate limit holds across BOTH IIT measures (small-φ AND big-Φ) → an estimator-")
            println("  FAMILY-independent 🧱 closure. BOUNDS (not retracts) the 4 prior Φ verdicts + H_1328.")
        }
    }
}
