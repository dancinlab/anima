// ════════════════════════════════════════════════════════════════════════════
//  topology_invariant_phi.hexa — UNIVERSE H_908 topological invariant (Betti-1 ·
//  Euler χ) ↔ integration (closed-form · $0 · CPU · substrate-runnable).
//
//  CANDIDATES.md ⬜ `topology-invariant-phi` (Betti/Euler ↔ Φ monotone) promoted
//  to a runnable smoke. Substrate = undirected graph on N=6 nodes (15 possible
//  edges). Topological invariants are EXACT closed-form for a 1-complex:
//    Euler χ = V − E              (= N − E)
//    Betti-1  b1 = E − V + C       (independent cycle count · C = #components, BFS)
//  Integration Φ_proxy = within-component reachability density =
//    Σ_comp |comp|(|comp|−1) / (N(N−1)).
//
//  Non-trivial claim (F3): does cycle topology (b1) predict integration BEYOND
//  raw edge count? (F1/F2/F4 — monotone in density — are controls; F3 fixes
//  p=0.4 and asks if the high-b1 half is more integrated.) F5 = a deterministic
//  topology check: the path tree P6 has b1=0 ∧ χ=1 (acyclic invariants exact).
//
//  Pre-registered falsifiers (frozen pre-run · post-tuning 0):
//    F1 B1-RISES   : mean b1(p=0.6) > mean b1(p=0.2)            (control)
//    F2 PHI-RISES  : mean Φ(p=0.6) > mean Φ(p=0.2)             (control)
//    F3 CONTROLLED : at FIXED p=0.4, high-b1-half mean Φ > low-b1-half mean Φ
//                    (cycles↔integration BEYOND density — the real claim)
//    F4 EULER-NEG  : χ and Φ anti-couple — mean χ(0.2) > mean χ(0.6) AND
//                    mean Φ(0.2) < mean Φ(0.6) (treelike high-χ = low integration)
//    F5 TREE-EXACT : path P6 (deterministic) → b1=0 ∧ χ=1 (acyclic invariant)
//
//  5 PASS → 🟢 SUPPORTED-NUMERICAL · 4 → 🟢 · 3 → 🟡 · ≤2 → 🔴. p7: integer
//  invariants + fraction only (no perplexity). N=6 · 3 p × 8 seed = 24 inst.
// ════════════════════════════════════════════════════════════════════════════

let NV = 6

fn _set_edge(adj: int, a: int, b: int, v: float) {
    farr_set(adj, a * NV + b, v)
    farr_set(adj, b * NV + a, v)
}
fn _has_edge(adj: int, a: int, b: int) -> int {
    if farr_get(adj, a * NV + b) > 0.5 { return 1 }
    return 0
}

// random undirected graph: 15 pairs (a<b), edge w/ threshold pcode/10
fn _fill_graph(adj: int, seed: int, pcode: int) {
    let mut i = 0
    while i < NV * NV { farr_set(adj, i, 0.0); i = i + 1 }
    let mut state = seed * 2654435761 + 1013904223
    let mut a = 0
    while a < NV {
        let mut b = a + 1
        while b < NV {
            state = (state * 1103515245 + 12345) % 2147483648
            if state < 0 { state = 0 - state }
            let r10 = (state / 7919) % 10
            if r10 < pcode { _set_edge(adj, a, b, 1.0) }
            b = b + 1
        }
        a = a + 1
    }
}

fn _edge_count(adj: int) -> int {
    let mut e = 0
    let mut a = 0
    while a < NV {
        let mut b = a + 1
        while b < NV { if _has_edge(adj, a, b) == 1 { e = e + 1 }; b = b + 1 }
        a = a + 1
    }
    return e
}

// connected components via iterative BFS over a fixed-point relaxation of a
// "component label = min reachable node id" (closed-form, no recursion).
fn _components(adj: int) -> int {
    let lab = farr_zeros(NV)
    let mut i = 0
    while i < NV { farr_set(lab, i, to_float(i)); i = i + 1 }
    // relax: lab[a] = min(lab[a], lab[b]) for every edge, until stable
    let mut changed = 1
    while changed == 1 {
        changed = 0
        let mut a = 0
        while a < NV {
            let mut b = 0
            while b < NV {
                if a != b { if _has_edge(adj, a, b) == 1 {
                    if farr_get(lab, b) < farr_get(lab, a) {
                        farr_set(lab, a, farr_get(lab, b)); changed = 1
                    }
                } }
                b = b + 1
            }
            a = a + 1
        }
    }
    // C = # distinct labels = # nodes whose label == own id (root)
    let mut c = 0
    let mut k = 0
    while k < NV { if farr_get(lab, k) == to_float(k) { c = c + 1 }; k = k + 1 }
    return c
}

// integration Φ = Σ_comp |comp|(|comp|-1) / (N(N-1)) via shared-label pairs
fn _integration(adj: int) -> float {
    let lab = farr_zeros(NV)
    let mut i = 0
    while i < NV { farr_set(lab, i, to_float(i)); i = i + 1 }
    let mut changed = 1
    while changed == 1 {
        changed = 0
        let mut a = 0
        while a < NV {
            let mut b = 0
            while b < NV {
                if a != b { if _has_edge(adj, a, b) == 1 {
                    if farr_get(lab, b) < farr_get(lab, a) {
                        farr_set(lab, a, farr_get(lab, b)); changed = 1
                    }
                } }
                b = b + 1
            }
            a = a + 1
        }
    }
    let mut cnt = 0
    let mut a2 = 0
    while a2 < NV {
        let mut b2 = 0
        while b2 < NV {
            if a2 != b2 { if farr_get(lab, a2) == farr_get(lab, b2) { cnt = cnt + 1 } }
            b2 = b2 + 1
        }
        a2 = a2 + 1
    }
    return to_float(cnt) / to_float(NV * (NV - 1))
}

fn _b1(adj: int) -> int { return _edge_count(adj) - NV + _components(adj) }
fn _chi(adj: int) -> int { return NV - _edge_count(adj) }

fn main() {
    println("================================================================")
    println("  UNIVERSE H_908 — topological invariant (Betti-1 · Euler χ) ↔ integration")
    println("================================================================")
    println("  substrate = undirected graph N=6 (15 edges) · exact b1=E-V+C · χ=V-E")
    println("  Φ = within-component reachability density · sweep p {0.2,0.4,0.6} × 8 seed")
    println("")

    let adj = farr_zeros(NV * NV)
    let nseed = 8
    let mut sB2 = 0.0; let mut sB6 = 0.0
    let mut sP2 = 0.0; let mut sP6 = 0.0
    let mut sX2 = 0.0; let mut sX6 = 0.0
    let b4 = farr_zeros(nseed); let p4 = farr_zeros(nseed)

    let mut pc = 0
    while pc < 3 {
        let mut pcode = 2
        if pc == 1 { pcode = 4 }
        if pc == 2 { pcode = 6 }
        let mut s = 0
        while s < nseed {
            _fill_graph(adj, s + 1, pcode)
            let b1 = _b1(adj); let phi = _integration(adj); let chi = _chi(adj)
            if pc == 0 { sB2 = sB2 + to_float(b1); sP2 = sP2 + phi; sX2 = sX2 + to_float(chi) }
            if pc == 1 { farr_set(b4, s, to_float(b1)); farr_set(p4, s, phi) }
            if pc == 2 { sB6 = sB6 + to_float(b1); sP6 = sP6 + phi; sX6 = sX6 + to_float(chi) }
            s = s + 1
        }
        pc = pc + 1
    }
    let nf = to_float(nseed)
    let mB2 = sB2 / nf; let mB6 = sB6 / nf
    let mP2 = sP2 / nf; let mP6 = sP6 / nf
    let mX2 = sX2 / nf; let mX6 = sX6 / nf

    // F3: split p=0.4 seeds by median b1 → compare mean Φ
    let mut sumB4 = 0.0; let mut jj = 0
    while jj < nseed { sumB4 = sumB4 + farr_get(b4, jj); jj = jj + 1 }
    let medB = sumB4 / nf
    let mut sHi = 0.0; let mut nHi = 0; let mut sLo = 0.0; let mut nLo = 0
    let mut j = 0
    while j < nseed {
        if farr_get(b4, j) >= medB { sHi = sHi + farr_get(p4, j); nHi = nHi + 1 }
        else { sLo = sLo + farr_get(p4, j); nLo = nLo + 1 }
        j = j + 1
    }
    let mHi = if nHi > 0 { sHi / to_float(nHi) } else { 0.0 }
    let mLo = if nLo > 0 { sLo / to_float(nLo) } else { 0.0 }

    // F5: deterministic path tree P6 (edges 0-1,1-2,2-3,3-4,4-5)
    let tree = farr_zeros(NV * NV)
    let mut t = 0
    while t < NV - 1 { _set_edge(tree, t, t + 1, 1.0); t = t + 1 }
    let tb1 = _b1(tree); let tchi = _chi(tree)

    println("  p=0.2 : mean b1=" + to_string(mB2) + " χ=" + to_string(mX2) + " Φ=" + to_string(mP2))
    println("  p=0.6 : mean b1=" + to_string(mB6) + " χ=" + to_string(mX6) + " Φ=" + to_string(mP6))
    println("  F3 controlled (p=0.4): high-b1 Φ=" + to_string(mHi) + " (n=" + to_string(nHi) + ") vs low-b1 Φ=" + to_string(mLo) + " (n=" + to_string(nLo) + ")")
    println("  P6 tree: b1=" + to_string(tb1) + " χ=" + to_string(tchi) + " (expect b1=0 χ=1)")
    println("")

    let mut f1 = 0; if mB6 > mB2 { f1 = 1 }
    let mut f2 = 0; if mP6 > mP2 { f2 = 1 }
    let mut f3 = 0; if mHi > mLo { f3 = 1 }
    let mut f4 = 0; if mX2 > mX6 { if mP2 < mP6 { f4 = 1 } }
    let mut f5 = 0; if tb1 == 0 { if tchi == 1 { f5 = 1 } }

    println("  F1 B1-RISES   = " + to_string(f1))
    println("  F2 PHI-RISES  = " + to_string(f2))
    println("  F3 CONTROLLED = " + to_string(f3) + "   (the real claim)")
    println("  F4 EULER-NEG  = " + to_string(f4))
    println("  F5 TREE-EXACT = " + to_string(f5))
    let pass = f1 + f2 + f3 + f4 + f5
    println("")
    println("  PASS = " + to_string(pass) + "/5")
    if pass >= 5 { println("  VERDICT 🟢 SUPPORTED-NUMERICAL — topology(b1/χ)↔integration confirmed") }
    else { if pass == 4 { println("  VERDICT 🟢 SUPPORTED") }
    else { if pass == 3 { println("  VERDICT 🟡 PARTIAL") }
    else { println("  VERDICT 🔴 FALSIFIED") } } }
}
