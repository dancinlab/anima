// ════════════════════════════════════════════════════════════════════════════
//  category_emergence.hexa — UNIVERSE H_907 morphism composition-closure ↔
//  integration (closed-form · $0 · CPU · substrate-runnable).
//
//  CANDIDATES.md ⬜ `category-theory-emergence` (morphism composition density vs
//  Φ — Yoneda substrate) promoted to a runnable smoke. Substrate = N=6 object
//  directed graph (30 possible morphisms, no self-loops; identities implicit).
//  composition closure D = fraction of composable pairs (A→B ∧ B→C, A≠C) whose
//  composite A→C is PRESENT (D=1 ⇔ closed = a genuine category). integration
//  Φ_proxy = transitive-reachability density = #{(A,B): A⇝B path}/30. Both
//  measured EXACTLY (enumeration + BFS) per random graph (LCG, deterministic).
//
//  The NON-TRIVIAL question (F3): does composition-closure predict integration
//  BEYOND raw edge density? (F1/F2/F4 — denser graph → more of everything — are
//  near-trivial controls; F3 holds density FIXED at p=0.4 and asks whether the
//  high-closure half is more integrated than the low-closure half.)
//
//  Pre-registered falsifiers (frozen pre-run · post-tuning 0):
//    F1 CLOSURE-RISES : mean D(p=0.6) > mean D(p=0.2)        (control · trivial-ok)
//    F2 INTEG-RISES   : mean Φ(p=0.6) > mean Φ(p=0.2)        (control · trivial-ok)
//    F3 CONTROLLED    : at FIXED p=0.4, high-D-half mean Φ > low-D-half mean Φ
//                       (closure↔integration BEYOND density — the real claim)
//    F4 CATEGORY-FORM : ∃ p with mean D ≥ 0.85 (near-closed = emergent category)
//    F5 SPARSE-OPEN   : mean D(p=0.2) < 0.6 (sparse = far from a closed category)
//
//  5 PASS → 🟢 SUPPORTED · 4 → 🟢 · 3 → 🟡 · ≤2 → 🔴. F3 FAIL ⇒ closure↔Φ is
//  density-mediated (honest closed-negative, a_paper_negative_ok). p7: count/
//  fraction measures only (no perplexity). N=6 · 3 p × 8 seeds = 24 instances.
// ════════════════════════════════════════════════════════════════════════════

let NOBJ = 6

// edge index e(a,b) for a≠b in 0..N²; we store adjacency in a farr[36] (a*6+b).
fn _fill_graph(adj: int, seed: int, pcode: int) {
    // pcode: 2→p≈0.2 · 4→p≈0.4 · 6→p≈0.6 (threshold on LCG %10)
    let mut state = seed * 2654435761 + 1013904223
    let mut a = 0
    while a < NOBJ {
        let mut b = 0
        while b < NOBJ {
            let mut v = 0.0
            if a != b {
                state = (state * 1103515245 + 12345) % 2147483648
                if state < 0 { state = 0 - state }
                let r10 = (state / 7919) % 10
                if r10 < pcode { v = 1.0 }
            }
            farr_set(adj, a * NOBJ + b, v)
            a = a  // no-op to keep block
            b = b + 1
        }
        a = a + 1
    }
}

fn _edge(adj: int, a: int, b: int) -> int {
    if farr_get(adj, a * NOBJ + b) > 0.5 { return 1 }
    return 0
}

// composition closure D = present(A→C) / composable(A→B ∧ B→C, A≠C)
fn _closure(adj: int) -> float {
    let mut comp = 0
    let mut present = 0
    let mut a = 0
    while a < NOBJ {
        let mut b = 0
        while b < NOBJ {
            let mut c = 0
            while c < NOBJ {
                if a != b { if b != c { if a != c {
                    if _edge(adj, a, b) == 1 { if _edge(adj, b, c) == 1 {
                        comp = comp + 1
                        if _edge(adj, a, c) == 1 { present = present + 1 }
                    } }
                } } }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    if comp == 0 { return 1.0 }   // vacuously closed
    return to_float(present) / to_float(comp)
}

// integration Φ_proxy = reachability density = #{(a,b),a≠b: a⇝b}/ (N(N-1))
// transitive closure via repeated relaxation (Floyd-style boolean).
fn _integration(adj: int) -> float {
    let reach = farr_zeros(NOBJ * NOBJ)
    let mut i = 0
    while i < NOBJ * NOBJ { farr_set(reach, i, farr_get(adj, i)); i = i + 1 }
    let mut k = 0
    while k < NOBJ {
        let mut a = 0
        while a < NOBJ {
            let mut b = 0
            while b < NOBJ {
                if farr_get(reach, a * NOBJ + k) > 0.5 {
                    if farr_get(reach, k * NOBJ + b) > 0.5 {
                        farr_set(reach, a * NOBJ + b, 1.0)
                    }
                }
                b = b + 1
            }
            a = a + 1
        }
        k = k + 1
    }
    let mut cnt = 0
    let mut a2 = 0
    while a2 < NOBJ {
        let mut b2 = 0
        while b2 < NOBJ {
            if a2 != b2 { if farr_get(reach, a2 * NOBJ + b2) > 0.5 { cnt = cnt + 1 } }
            b2 = b2 + 1
        }
        a2 = a2 + 1
    }
    return to_float(cnt) / to_float(NOBJ * (NOBJ - 1))
}

fn main() {
    println("================================================================")
    println("  UNIVERSE H_907 — morphism composition-closure ↔ integration")
    println("================================================================")
    println("  substrate = N=6 object directed graph (30 morphisms · exact enum + BFS)")
    println("  D = composition closure (present/composable) · Φ = reachability density")
    println("  sweep p ∈ {0.2,0.4,0.6} · 8 seeds · F3 = density-controlled (p=0.4)")
    println("")

    let adj = farr_zeros(NOBJ * NOBJ)
    let nseed = 8

    let mut sumD2 = 0.0; let mut sumD4 = 0.0; let mut sumD6 = 0.0
    let mut sumP2 = 0.0; let mut sumP6 = 0.0
    // F3: at p=0.4 collect (D, Φ) per seed
    let d4 = farr_zeros(nseed); let p4 = farr_zeros(nseed)

    let mut pc = 0
    while pc < 3 {
        let mut pcode = 2
        if pc == 1 { pcode = 4 }
        if pc == 2 { pcode = 6 }
        let mut s = 0
        while s < nseed {
            _fill_graph(adj, s + 1, pcode)
            let D = _closure(adj)
            let P = _integration(adj)
            if pc == 0 { sumD2 = sumD2 + D; sumP2 = sumP2 + P }
            if pc == 1 { sumD4 = sumD4 + D; farr_set(d4, s, D); farr_set(p4, s, P) }
            if pc == 2 { sumD6 = sumD6 + D; sumP6 = sumP6 + P }
            s = s + 1
        }
        pc = pc + 1
    }

    let nf = to_float(nseed)
    let mD2 = sumD2 / nf; let mD4 = sumD4 / nf; let mD6 = sumD6 / nf
    let mP2 = sumP2 / nf; let mP6 = sumP6 / nf

    // F3: split the 8 p=0.4 seeds by median D → compare mean Φ of high-D vs low-D
    // median D
    let mut medD = mD4
    // mean of Φ for D>=medD (high) vs D<medD (low)
    let mut sHi = 0.0; let mut nHi = 0; let mut sLo = 0.0; let mut nLo = 0
    let mut j = 0
    while j < nseed {
        if farr_get(d4, j) >= medD { sHi = sHi + farr_get(p4, j); nHi = nHi + 1 }
        else { sLo = sLo + farr_get(p4, j); nLo = nLo + 1 }
        j = j + 1
    }
    let mHi = if nHi > 0 { sHi / to_float(nHi) } else { 0.0 }
    let mLo = if nLo > 0 { sLo / to_float(nLo) } else { 0.0 }

    println("  p=0.2 : mean D=" + to_string(mD2) + " mean Φ=" + to_string(mP2))
    println("  p=0.4 : mean D=" + to_string(mD4) + " (F3 split @ medD=" + to_string(medD) + ")")
    println("  p=0.6 : mean D=" + to_string(mD6) + " mean Φ=" + to_string(mP6))
    println("  F3 controlled (p=0.4): high-D Φ=" + to_string(mHi) + " (n=" + to_string(nHi) + ") vs low-D Φ=" + to_string(mLo) + " (n=" + to_string(nLo) + ")")
    println("")

    let mut f1 = 0; if mD6 > mD2 { f1 = 1 }
    let mut f2 = 0; if mP6 > mP2 { f2 = 1 }
    let mut f3 = 0; if mHi > mLo { f3 = 1 }
    let mut f4 = 0; if mD2 >= 0.85 { f4 = 1 }; if mD4 >= 0.85 { f4 = 1 }; if mD6 >= 0.85 { f4 = 1 }
    let mut f5 = 0; if mD2 < 0.6 { f5 = 1 }

    println("  F1 CLOSURE-RISES = " + to_string(f1))
    println("  F2 INTEG-RISES   = " + to_string(f2))
    println("  F3 CONTROLLED    = " + to_string(f3) + "   (the real claim)")
    println("  F4 CATEGORY-FORM = " + to_string(f4))
    println("  F5 SPARSE-OPEN   = " + to_string(f5))
    let pass = f1 + f2 + f3 + f4 + f5
    println("")
    println("  PASS = " + to_string(pass) + "/5")
    if pass >= 5 { println("  VERDICT 🟢 SUPPORTED-NUMERICAL — closure↔integration beyond density") }
    else { if pass == 4 { println("  VERDICT 🟢 SUPPORTED") }
    else { if pass == 3 { println("  VERDICT 🟡 PARTIAL") }
    else { println("  VERDICT 🔴 FALSIFIED") } } }
}
