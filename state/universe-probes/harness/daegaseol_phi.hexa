// ════════════════════════════════════════════════════════════════════════════
//  UNIVERSE/daegaseol/daegaseol_phi.hexa
//
//  REAL faithful IIT-4.0 Φ (exact MIP-EI, n<=8) for the two Φ-axes of the
//  daegaseol 14-axis capstone set:
//    H_1102 (의식의 물리)   — A·G fused vs cut  → Φ_fused > 0, Φ_cut ≈ 0
//    H_1114 (도덕적 지위)   — collective Φ coupling sweep → super-additive window
//
//  a_phi_iit4_tool-compliant: imports the stdlib faithful engine, NO proxy.
//  state file format (per UNIVERSE/run_faithful_phi_1043.hexa):
//    # <tag> <n> <dim>
//    <dim floats>   x n rows
//
//  Run (CPU, $0):
//    DG_PHI_STATE=/tmp/dg_phi_states.txt DG_PHI_NBINS=4 hexa run UNIVERSE/daegaseol/daegaseol_phi.hexa
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4/faithful_phi.hexa"

fn _f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true; v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = str(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + str(to_int(whole)) + "." + frac_str
}

fn main() {
    let mut path = env("DG_PHI_STATE")
    if len(path) == 0 { path = "/tmp/dg_phi_states.txt" }
    let mut nbs = env("DG_PHI_NBINS")
    if len(nbs) == 0 { nbs = "4" }
    let nb = nbs.to_int()

    println("=== daegaseol Φ axes — REAL faithful IIT-4.0 (stdlib exact MIP-EI, NO proxy) ===")
    println("state file: " + path + "  n_bins=" + str(nb))

    let text = read_file(path)
    let lines = text.split("\n")

    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if len(line) > 0 && line.split(" ")[0] == "#" {
            let toks = line.split(" ")
            let tag = toks[1]
            let n = toks[2].to_int()
            let dim = toks[3].to_int()
            let state = farr_zeros(n * dim)
            let mut r = 0
            while r < n {
                i = i + 1
                let row = lines[i].trim().split(" ")
                let mut c = 0
                while c < dim {
                    let _ = farr_set(state, r * dim + c, row[c].to_float())
                    c = c + 1
                }
                r = r + 1
            }
            let phi = iit4_faithful_phi(state, n, dim, nb)
            let _ = farr_free(state)
            println("  [" + tag + "]  n=" + str(n) + " dim=" + str(dim)
                + "  faithful_phi_EI=" + _f6(phi))
        }
        i = i + 1
    }
    println("=== faithful Φ complete (a_phi_iit4_tool) ===")
}
