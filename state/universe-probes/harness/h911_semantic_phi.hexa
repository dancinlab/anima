#!hexa strict
// LAB/lab-11-multilingual-semantic/semantic_connection_harness.hexa
//
// LAB-11 — multilingual "connect by MEANING, not by count" proxy (1st smoke).
// See LAB/README.md LAB-11.
//
// HYPOTHESIS (falsifiable):
//   Multilingual integrated information Phi is driven by cross-lingual MEANING
//   coupling (cross-lingual mutual information), NOT by the raw COUNT of
//   languages/corpus. As the semantic-coupling strength c rises 0->1:
//     (H_240) Phi traces an INVERSE-U — c=0 (fully separate, MI=0) and c=1
//             (fully fused/synchronized, differentiation=0) both give Phi~0;
//             PARTIAL integration peaks Phi.  (Phi = differentiation x integration)
//     (H_635) the coupled cohort is SUPER-ADDITIVE — Phi_collective(c*) far
//             exceeds the decoupled Sigma-baseline Phi(c=0) ~ 0.
//   COROLLARY (the user's reframe): at c=0 you can pile up languages (count up)
//   and Phi stays ~0 — only MEANING coupling (c>0) creates integration.
//
// FALSIFIER (pre-registered):
//   F1 inverse-U : if Phi is monotone in c (no interior peak strictly above both
//                  ends), the inverse-U (H_240) is FALSE.
//   F2 super-add : if Phi(peak) does not exceed Phi(c=0) beyond a small band, the
//                  collective super-additivity (H_635) is FALSE.
//   F3 meaning>count : if Phi(c=0) is NOT ~0 (i.e. count alone, no coupling,
//                  already integrates), the "meaning not count" claim is FALSE.
//   We report the real sweep either way.
//
// DESIGN (substrate proxy — L=5 language streams = ko/en/zh/ru/ja analog, ring):
//   Each step, each unit i (a language, 1 bit) updates by ONE of two modes,
//   chosen per-unit with probability c (the SEMANTIC-COUPLING strength):
//     decoupled (prob 1-c): next[i] = fresh random bit   -> independent stream,
//                                                            cross-lingual MI = 0
//     coupled   (prob c)  : next[i] = majority(x[i-1],x[i],x[i+1])  -> consensus,
//                                                            cross-lingual MI up
//   c=0 -> 5 independent streams (MI=0, Phi=0). c=1 -> full synchronization
//   (units collapse to a shared consensus, differentiation->0, Phi=0). Interior
//   c -> partial integration -> Phi peak. The x-axis we actually plot is the
//   MEASURED mean pairwise cross-lingual MI, so Phi-vs-MI is the real curve.
//
// HONESTY (cx_lab_sandbox · g5 no-self-judge):
//   Pure local deterministic numeric kernel ($0, no network, no LLM, seeded LCG).
//   Phi-proxy = whole_EI - min_bipartition(parts), same engine as LAB-09. This is
//   a SUBSTRATE PROXY for the multilingual claim (anima H_240 cross-lingual-leak
//   + H_635 5-lang collective super-additivity); a real multilingual-LM tuning
//   sweep is the next stress tier, not this smoke.
//
// @no-lock-needed
// @resolver-bypass(reason="Pure local numeric kernel + filesystem write — no atlas atoms, no network.")

let SEED = 42
let N = 5                  // language streams (ko/en/zh/ru/ja analog)
let T = 40000
let NST = 32               // 2^N
let OUT_DIR = "/tmp/h911_phi"

let mut LCG = 0
fn seed_lcg(s: int) { LCG = s }
fn rbit() -> int {
    LCG = (1103515245 * LCG + 12345) % 2147483648
    return (LCG / 65536) % 2
}

fn encode(b: [int]) -> int {
    let mut code = 0
    let mut i = 0
    while i < N { code = code + (b[i] << i) ; i = i + 1 }
    return code
}

fn popcount(mask: int) -> int {
    let mut c = 0
    let mut u = 0
    while u < N { if (mask >> u) % 2 == 1 { c = c + 1 } ; u = u + 1 }
    return c
}

fn subcode(code: int, mask: int) -> int {
    let mut acc = 0
    let mut pos = 0
    let mut u = 0
    while u < N {
        if (mask >> u) % 2 == 1 {
            let bit = (code >> u) % 2
            acc = acc + (bit << pos)
            pos = pos + 1
        }
        u = u + 1
    }
    return acc
}

fn entropy(counts: [int], total: int) -> float {
    let mut h = 0.0
    let mut i = 0
    let n = len(counts)
    let tf = total + 0.0
    while i < n {
        let c = counts[i]
        if c > 0 {
            let p = c / tf
            h = h - p * log2(p)
        }
        i = i + 1
    }
    return h
}

fn mi_subset(xt: [int], xn: [int], mask: int) -> float {
    let k = 1 << popcount(mask)
    let mut joint = []
    let mut z = 0
    while z < k * k { joint.push(0) ; z = z + 1 }
    let mut s = 0
    while s < T {
        let a = subcode(xt[s], mask)
        let b = subcode(xn[s], mask)
        joint[a * k + b] = joint[a * k + b] + 1
        s = s + 1
    }
    let mut rows = []
    let mut cols = []
    let mut r = 0
    while r < k { rows.push(0) ; cols.push(0) ; r = r + 1 }
    let mut a = 0
    while a < k {
        let mut b = 0
        while b < k {
            let c = joint[a * k + b]
            rows[a] = rows[a] + c
            cols[b] = cols[b] + c
            b = b + 1
        }
        a = a + 1
    }
    return entropy(rows, T) + entropy(cols, T) - entropy(joint, T)
}

fn phi_proxy(xt: [int], xn: [int]) -> float {
    let whole = mi_subset(xt, xn, 31)
    let mut best = 1000000.0
    let mut mask = 1
    while mask < 31 {
        if mask % 2 == 1 {
            let mi_a = mi_subset(xt, xn, mask)
            let mi_b = mi_subset(xt, xn, 31 - mask)
            let sum = mi_a + mi_b
            if sum < best { best = sum }
        }
        mask = mask + 1
    }
    return whole - best
}

// mean pairwise instantaneous cross-lingual MI I(bit_i; bit_j) over all pairs
fn mean_pair_mi(xt: [int]) -> float {
    let mut tot = 0.0
    let mut pairs = 0
    let mut i = 0
    while i < N {
        let mut j = i + 1
        while j < N {
            let mut joint = []
            let mut z = 0
            while z < 4 { joint.push(0) ; z = z + 1 }
            let mut s = 0
            while s < T {
                let bi = (xt[s] >> i) % 2
                let bj = (xt[s] >> j) % 2
                joint[bi * 2 + bj] = joint[bi * 2 + bj] + 1
                s = s + 1
            }
            let mut rows = [0, 0]
            let mut cols = [0, 0]
            rows[0] = joint[0] + joint[1]
            rows[1] = joint[2] + joint[3]
            cols[0] = joint[0] + joint[2]
            cols[1] = joint[1] + joint[3]
            tot = tot + entropy(rows, T) + entropy(cols, T) - entropy(joint, T)
            pairs = pairs + 1
            j = j + 1
        }
        i = i + 1
    }
    return tot / (pairs + 0.0)
}

fn maj3(a: int, b: int, c: int) -> int {
    if a + b + c >= 2 { return 1 }
    return 0
}

fn draw8() -> int {
    let mut r = 0
    let mut k = 0
    while k < 8 { r = r * 2 + rbit() ; k = k + 1 }
    return r          // 0..255
}

// Evolve the multilingual cohort at semantic-coupling threshold cthr (0..256).
fn evolve_ml(cthr: int, xt: [int], xn: [int]) {
    seed_lcg(SEED)
    let mut cur = []
    let mut i = 0
    while i < N { cur.push(rbit()) ; i = i + 1 }
    let mut k = 0
    while k < T {
        let mut nxt = []
        i = 0
        while i < N {
            let ev = draw8()
            if ev < cthr {
                let li = (i + N - 1) % N
                let ri = (i + 1) % N
                nxt.push(maj3(cur[li], cur[i], cur[ri]))
            } else {
                nxt.push(rbit())
            }
            i = i + 1
        }
        xt[k] = encode(cur)
        xn[k] = encode(nxt)
        cur = nxt
        k = k + 1
    }
}

fn new_arr(t: int) -> [int] {
    let mut a = []
    let mut i = 0
    while i < t { a.push(0) ; i = i + 1 }
    return a
}

fn r6(x: float) -> str {
    let scaled = x * 1000000.0
    let ri = scaled + 0.5
    let asint = ri - (ri % 1.0)
    return str(asint / 1000000.0)
}

fn main() {
    // c sweep (out of 256): 0.0, 0.1, 0.25, 0.5, 0.75, 0.9, 1.0
    let CTHR = [0, 26, 64, 128, 192, 230, 256]
    let CLBL = ["0.00", "0.10", "0.25", "0.50", "0.75", "0.90", "1.00"]
    let M = len(CTHR)

    print("LAB-11 multilingual semantic-connection smoke — N=" + str(N) + " langs, T=" + str(T) + "\n")

    let mut phis = []
    let mut mis = []
    let mut tsv = "c\tcross_lingual_MI_bits\tcollective_phi_bits\n"
    let mut idx = 0
    while idx < M {
        let mut xt = new_arr(T)
        let mut xn = new_arr(T)
        evolve_ml(CTHR[idx], xt, xn)
        let mi = mean_pair_mi(xt)
        let phi = phi_proxy(xt, xn)
        phis.push(phi)
        mis.push(mi)
        tsv = tsv + CLBL[idx] + "\t" + r6(mi) + "\t" + r6(phi) + "\n"
        print("  c=" + CLBL[idx] + "  MI=" + r6(mi) + "  phi=" + r6(phi) + "\n")
        idx = idx + 1
    }
    write_file(OUT_DIR + "/result_semantic.tsv", tsv)

    // peak over interior c-values (exclude endpoints 0 and M-1)
    let phi_lo = phis[0]
    let phi_hi = phis[M - 1]
    let mut peak = phi_lo
    let mut peak_i = 0
    let mut j = 0
    while j < M {
        if phis[j] > peak { peak = phis[j] ; peak_i = j }
        j = j + 1
    }
    let interior_peak = peak_i > 0 && peak_i < M - 1
    let f1_inverse_u = interior_peak && peak > phi_lo + 0.01 && peak > phi_hi + 0.01
    let f2_super_add = peak > phi_lo + 0.01
    let f3_meaning_not_count = phi_lo < 0.05
    let supported = f1_inverse_u && f2_super_add && f3_meaning_not_count

    let mut sm = "LAB-11 — multilingual: connect by MEANING not count (1st smoke)\n"
    sm = sm + "seed=" + str(SEED) + " N_langs=" + str(N) + " steps=" + str(T) + "\n\n"
    sm = sm + "c (semantic coupling)   cross_lingual_MI   collective_phi\n"
    let mut q = 0
    while q < M {
        sm = sm + "  c=" + CLBL[q] + "                 " + r6(mis[q]) + "             " + r6(phis[q]) + "\n"
        q = q + 1
    }
    sm = sm + "\npeak phi = " + r6(peak) + " at c=" + CLBL[peak_i] + " (MI=" + r6(mis[peak_i]) + ")\n"
    sm = sm + "phi(c=0, decoupled Sigma-baseline) = " + r6(phi_lo) + "\n"
    sm = sm + "phi(c=1, fully synchronized)       = " + r6(phi_hi) + "\n\n"
    sm = sm + "falsifier F1 inverse-U (interior peak > both ends) : " + str(f1_inverse_u) + "\n"
    sm = sm + "falsifier F2 super-additive (peak > decoupled)     : " + str(f2_super_add) + "\n"
    sm = sm + "falsifier F3 meaning>count (phi(c=0) ~ 0)          : " + str(f3_meaning_not_count) + "\n"
    sm = sm + "VERDICT supported (all 3)                          : " + str(supported) + "\n"
    write_file(OUT_DIR + "/result_semantic_summary.txt", sm)
    print(sm)
}
