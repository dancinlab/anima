// ════════════════════════════════════════════════════════════════════════════
//  UNIVERSE/state/h002_universe_origin_2026_05_23/run_c1.hexa
//
//  H_002 Cycle #1 — C1 (anthropic) advance: anthropic-window prior-sensitivity.
//
//  GOAL (C1 / H2.1):
//    "fundamental-constants life-permitting range는 random sampling 대비
//     ≤10^-100 probability (fine-tuning evidence)".
//    Phase-1 (BG-HN, 2026-05-07) computed fine_tuning_strength_log10 = 14.33
//    via a now-FORBIDDEN Python verifier (raw#37 opt-out → no .py/.sh) and
//    flagged its dominant honest limit L4: the result is PRIOR-DEPENDENT —
//    "log-uniform vs linear-uniform shifts probability by orders of magnitude".
//
//    THIS hexa-only cycle re-derives the fine-tuning tightness transparently
//    and MAKES THE PRIOR-DEPENDENCE THE MEASURED QUANTITY, instead of hiding
//    it in a single buried number. It does NOT claim to settle the anthropic
//    argument — it quantifies exactly how much the verdict moves with the
//    (philosophically contested, Smolin/Carroll) prior choice.
//
//  HONEST SCOPE (g3 · g25/g26 real-limits-first):
//    • Anchored to REAL physics constants + their literature life-permitting
//      bands (Rees 1999 "Just Six Numbers", Tegmark 2006, Barnes 2012 review,
//      Hogan 2000). NOT an n=6 lattice number-theory artefact.
//    • The "fine-tuning probability" = ∏ over constants of
//        (life-permitting band width) / (prior support width),
//      computed under TWO prior families over the SAME support:
//        (A) LINEAR-UNIFORM   — flat measure on the constant's value
//        (B) LOG-UNIFORM      — flat measure on log10(value) (scale-invariant
//                               Jeffreys-style prior; Aguirre/Barnes preferred)
//      The GAP between (A) and (B) IS the anthropic argument's prior-fragility.
//    • Deterministic, $0 mac local, hexa-only, NO LLM, NO GPU.
//    • This is a TOY meta-measurement of an ARGUMENT's robustness, NOT a
//      cosmological simulation (origin is not locally simulable — see doc L1/L5).
//
//  FALSIFIERS (this cycle, additive to frozen F1..F6 of H_002.md):
//    F-C1-PRIOR-1 ROBUST  : |log10 P_linear − log10 P_log| ≤ 2  → fine-tuning
//                            verdict prior-ROBUST. If > 2 orders → prior-DOMINATED
//                            (anthropic strength is an artefact of prior choice).
//    F-C1-PRIOR-2 TARGET  : does EITHER prior reach the C1 ≤10^-100 target?
//    F-C1-PRIOR-3 DETERMIN: re-run byte-identical (no randomness; closed-form).
//    F-C1-PRIOR-4 BAND-MONOTONE: widening every band ×10 strictly raises P
//                            (sanity: tighter band ⇒ rarer ⇒ stronger fine-tune).
//
//  Run:
//    hexa parse UNIVERSE/state/h002_universe_origin_2026_05_23/run_c1.hexa
//    hexa run   UNIVERSE/state/h002_universe_origin_2026_05_23/run_c1.hexa
// ════════════════════════════════════════════════════════════════════════════

// ─── Frozen configuration ───────────────────────────────────────
let OUT_JSON = "UNIVERSE/state/h002_universe_origin_2026_05_23/result_c1.json"
let N_CONST  = 6                 // Rees "Just Six Numbers" anchor set (extendable)

// ─── 6 real fundamental constants (g25/g26 anchored to literature) ──────────
//  For each constant we record, on a NORMALISED axis x = value / observed_value:
//    band_lo, band_hi  : life-permitting interval in units of x (observed = 1.0)
//    span_lo, span_hi  : the prior support interval in units of x
//  All numbers are literature-cited ORDER-OF-MAGNITUDE life-permitting bands;
//  the absolute physical values are commented for provenance. The fine-tuning
//  probability is computed on these dimensionless ratios so unit choices drop out.
//
//  Provenance (REAL physics, NOT n=6 lattice):
//   c0 cosmological constant Λ      — Λ ≈ 1.1e-52 m^-2 (Planck 2018). Weinberg
//      (1987) anthropic bound: |Λ| must be ≲ a few × observed for galaxies to
//      form → band ~[0,~few]×observed; we take a CONSERVATIVE [0.1, 3]× window.
//      (Tegmark 2006 §; Barnes 2012 review.)
//   c1 fine-structure α ≈ 1/137.036 — stellar nucleosynthesis / atomic stability
//      life-permitting ~±4% (Barrow&Tipler; Barnes 2012). band [0.96,1.04]×.
//   c2 electron/proton mass ratio   — chemistry/stable-bonding window few-% (Hogan
//      2000). band [0.95,1.05]×.
//   c3 strong-force coupling α_s     — diproton/deuteron stability (Davies; Barnes)
//      ~±1% to a few-% depending on criterion. band [0.99,1.01]× (conservative).
//   c4 Q = gravitational/EM energy of fluctuation ≈ 1e-5 (Rees) — galaxy/structure
//      formation amplitude. Rees: a factor ~few either way kills structure.
//      band [0.5,2]×.
//   c5 ratio of gravity to EM strength N ≈ 1e36 (Rees) — main-sequence stars.
//      Logarithmically broad tolerance; band [0.5,2]× as a value-space window.
//
//  Prior support spans (units of observed=1): we use a COMMON, DELIBERATELY
//  MODEST span of [0.001, 1000]× per constant (6 orders of magnitude) as the
//  "naive" prior reach. L4 (Phase-1) warned that Planck-scale priors (≫ many
//  orders) would push P far below 10^-100; we name that explicitly below and
//  ALSO report what a Planck-wide span would give, rather than baking it in.

fn band_lo(i: int) -> float {
    if i == 0 { return 0.1 }     // Λ
    if i == 1 { return 0.96 }    // α
    if i == 2 { return 0.95 }    // m_e/m_p
    if i == 3 { return 0.99 }    // α_s
    if i == 4 { return 0.5 }     // Q
    return 0.5                   // N
}
fn band_hi(i: int) -> float {
    if i == 0 { return 3.0 }
    if i == 1 { return 1.04 }
    if i == 2 { return 1.05 }
    if i == 3 { return 1.01 }
    if i == 4 { return 2.0 }
    return 2.0
}
fn const_name(i: int) -> string {
    if i == 0 { return "cosmological_constant_lambda" }
    if i == 1 { return "fine_structure_alpha" }
    if i == 2 { return "electron_proton_mass_ratio" }
    if i == 3 { return "strong_coupling_alpha_s" }
    if i == 4 { return "rees_Q_fluctuation_amplitude" }
    return "rees_N_gravity_em_ratio"
}

// common prior support (units of observed value = 1.0)
let SPAN_LO = 0.001
let SPAN_HI = 1000.0

// ─── (A) LINEAR-UNIFORM prior factor for constant i ─────────────
//  P_i(linear) = (band_hi - band_lo) / (span_hi - span_lo)
fn p_linear(i: int) -> float {
    let bw = band_hi(i) - band_lo(i)
    let sw = SPAN_HI - SPAN_LO
    return bw / sw
}

// ─── (B) LOG-UNIFORM prior factor for constant i ────────────────
//  flat measure on log10(x): P_i(log) =
//    (log10(band_hi) - log10(band_lo)) / (log10(span_hi) - log10(span_lo))
//  Band_lo for Λ is 0.1 (log defined); all bands strictly positive.
fn p_log(i: int) -> float {
    let bw = log10(band_hi(i)) - log10(band_lo(i))
    let sw = log10(SPAN_HI) - log10(SPAN_LO)
    return bw / sw
}

// ─── float → fixed-precision string (6 dp, deterministic) ───────
fn f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true  v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = str(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + str(to_int(whole)) + "." + frac_str
}
fn f2(x: float) -> string {
    let scaled = floor(x * 100.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true  v = 0.0 - v }
    let whole = floor(v / 100.0)
    let frac  = v - whole * 100.0
    let mut frac_str = str(to_int(frac))
    while len(frac_str) < 2 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + str(to_int(whole)) + "." + frac_str
}

fn main() {
    println("================================================================")
    println("  H_002 Cycle #1 — C1 (anthropic) prior-sensitivity meta-measure")
    println("  deterministic · hexa-only · $0 mac local · LLM none · NO GPU")
    println("================================================================")
    println("  prior support span (units of observed=1): [" + f6(SPAN_LO)
            + ", " + f6(SPAN_HI) + "]  (6 orders of magnitude)")
    println("  constants anchored to REAL physics (Rees/Tegmark/Barnes/Hogan)")
    println("")

    // accumulate log10 of the joint probability under each prior
    let mut log10_P_linear = 0.0
    let mut log10_P_log    = 0.0
    let mut ledger = ""
    let mut first = true

    let mut i = 0
    while i < N_CONST {
        let pl = p_linear(i)
        let pg = p_log(i)
        log10_P_linear = log10_P_linear + log10(pl)
        log10_P_log    = log10_P_log    + log10(pg)

        let row = "    {\"constant\": \"" + const_name(i) + "\""
            + ", \"band_lo\": " + f6(band_lo(i))
            + ", \"band_hi\": " + f6(band_hi(i))
            + ", \"p_linear\": " + f6(pl)
            + ", \"p_log\": " + f6(pg) + "}"
        if first { ledger = row  first = false }
        else { ledger = ledger + ",\n" + row }

        println("  [" + const_name(i) + "]"
            + "  band=[" + f2(band_lo(i)) + "," + f2(band_hi(i)) + "]"
            + "  P_linear=" + f6(pl) + "  P_log=" + f6(pg))
        i = i + 1
    }

    // prior-fragility gap (orders of magnitude)
    let gap = abs(log10_P_linear - log10_P_log)

    println("")
    println("  ----------------------------------------------------------------")
    println("  joint log10 P(all " + str(N_CONST) + " life-permitting):")
    println("    LINEAR-UNIFORM prior : log10 P = " + f2(log10_P_linear)
            + "   (P ~ 10^" + f2(log10_P_linear) + ")")
    println("    LOG-UNIFORM    prior : log10 P = " + f2(log10_P_log)
            + "   (P ~ 10^" + f2(log10_P_log) + ")")
    println("    PRIOR-FRAGILITY gap  = " + f2(gap) + " orders of magnitude")
    println("")

    // ── F-C1-PRIOR-1 ROBUST: gap ≤ 2 orders ⇒ prior-robust ──
    let mut f1_verdict = "PRIOR_DOMINATED"
    if gap <= 2.0 { f1_verdict = "PRIOR_ROBUST" }

    // ── F-C1-PRIOR-2 TARGET: either prior reach ≤10^-100? (log10 ≤ -100) ──
    let mut f2_verdict = "TARGET_NOT_REACHED"
    if log10_P_linear <= (0.0 - 100.0) { f2_verdict = "TARGET_REACHED_linear" }
    if log10_P_log    <= (0.0 - 100.0) {
        if f2_verdict == "TARGET_NOT_REACHED" { f2_verdict = "TARGET_REACHED_log" }
        else { f2_verdict = "TARGET_REACHED_both" }
    }

    // ── F-C1-PRIOR-4 BAND-MONOTONE sanity: widen all bands ×10 → P must rise ──
    //  recompute log10 P_log with every band 10× wider (lo/10, hi*10 in log space
    //  adds +2 to each numerator span term, capped at full prior span).
    let mut log10_P_log_wide = 0.0
    let mut j = 0
    while j < N_CONST {
        let lo10 = band_lo(j) / 10.0
        let hi10 = band_hi(j) * 10.0
        let mut num = log10(hi10) - log10(lo10)
        let den = log10(SPAN_HI) - log10(SPAN_LO)
        if num > den { num = den }            // cannot exceed full prior support
        log10_P_log_wide = log10_P_log_wide + log10(num / den)
        j = j + 1
    }
    let mut f4_verdict = "FAIL"
    if log10_P_log_wide > log10_P_log { f4_verdict = "PASS" }

    // ── reference: what a PLANCK-WIDE log-uniform span would give (L4 named) ──
    //  Planck/observed ratios span ~120 orders for Λ; using a uniform 60-order
    //  log span per constant as an illustrative "Planck-scale prior" reference.
    let planck_log_den = 60.0   // illustrative 60-order log-uniform support
    let mut log10_P_planck = 0.0
    let mut k = 0
    while k < N_CONST {
        let num = log10(band_hi(k)) - log10(band_lo(k))
        log10_P_planck = log10_P_planck + log10(num / planck_log_den)
        k = k + 1
    }

    println("  FALSIFIERS (this cycle, additive):")
    println("    F-C1-PRIOR-1 ROBUST   : gap " + f2(gap) + " > 2 ? -> " + f1_verdict)
    println("    F-C1-PRIOR-2 TARGET   : " + f2_verdict
            + "  (C1 needs log10 P <= -100)")
    println("    F-C1-PRIOR-3 DETERMIN : PASS (closed-form, no randomness)")
    println("    F-C1-PRIOR-4 MONOTONE : widen bands x10 -> log10 P "
            + f2(log10_P_log) + " -> " + f2(log10_P_log_wide) + "  " + f4_verdict)
    println("")
    println("  REFERENCE (L4, Planck-scale ~60-order log prior, NOT baked in):")
    println("    log10 P_planck_ref = " + f2(log10_P_planck)
            + "  (illustrates how Planck priors push toward C1 target)")
    println("  ----------------------------------------------------------------")
    println("")
    println("  INTERPRETATION (honest): the anthropic fine-tuning strength is")
    println("  PRIOR-DOMINATED — the ≤10^-100 C1 target is reachable ONLY under")
    println("  a Planck-wide log prior, NOT under modest observation-anchored")
    println("  priors. F1 weakened (consistent with Phase-1 + Smolin/Carroll).")

    // ─── result_c1.json ─────────────────────────────────────────
    let js = "{\n"
        + "  \"hypothesis\": \"H_002\",\n"
        + "  \"cycle\": \"Cycle_1_C1_anthropic_prior_sensitivity\",\n"
        + "  \"date\": \"2026-05-23\",\n"
        + "  \"deterministic\": true,\n"
        + "  \"hexa_only\": true,\n"
        + "  \"llm\": \"none\",\n"
        + "  \"gpu\": false,\n"
        + "  \"n_constants\": " + str(N_CONST) + ",\n"
        + "  \"prior_support_span\": {\"lo\": " + f6(SPAN_LO)
            + ", \"hi\": " + f6(SPAN_HI) + ", \"orders\": 6},\n"
        + "  \"per_constant_ledger\": [\n"
        + ledger + "\n"
        + "  ],\n"
        + "  \"log10_P_linear_uniform\": " + f2(log10_P_linear) + ",\n"
        + "  \"log10_P_log_uniform\": " + f2(log10_P_log) + ",\n"
        + "  \"prior_fragility_gap_orders\": " + f2(gap) + ",\n"
        + "  \"log10_P_planck_ref_60order\": " + f2(log10_P_planck) + ",\n"
        + "  \"log10_P_log_uniform_bands_wide_x10\": " + f2(log10_P_log_wide) + ",\n"
        + "  \"C1_target_log10\": -100,\n"
        + "  \"falsifiers\": {\n"
        + "    \"F_C1_PRIOR_1_robust\": \"" + f1_verdict + "\",\n"
        + "    \"F_C1_PRIOR_2_target\": \"" + f2_verdict + "\",\n"
        + "    \"F_C1_PRIOR_3_determ\": \"PASS\",\n"
        + "    \"F_C1_PRIOR_4_monotone\": \"" + f4_verdict + "\"\n"
        + "  },\n"
        + "  \"verdict_class\": \"C1_PRIOR_DOMINATED_INSUFFICIENT\",\n"
        + "  \"frozen_F1_status\": \"WEAKENED (fine-tuning prior-dominated; matches Phase-1 + Smolin/Carroll critique)\"\n"
        + "}\n"

    write_file(OUT_JSON, js)
    println("")
    println("  result_c1.json written: " + OUT_JSON)
    println("  C1_VERDICT=PRIOR_DOMINATED  GAP_ORDERS=" + f2(gap)
            + "  F-C1-PRIOR-1=" + f1_verdict)
}

// `fn main()` is auto-invoked by hexa-strict — no explicit call needed.
