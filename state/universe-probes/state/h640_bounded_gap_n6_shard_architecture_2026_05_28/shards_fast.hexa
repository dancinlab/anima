// H_640 — fast cap1/cap2 n=6 shards, single-state st=21 (010101). All < 10s each.
import "/tmp/u-h640/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"
let N = 6
let ST = 21
fn shard(rule: int, cap: int) -> float {
    let tpm = eca_tpm(rule, N)
    let r = big_phi_bounded(tpm, N, ST, cap)
    return r[0]
}
fn main() {
    println("FAST_BEGIN n6 st21")
    println("r30 c1 phi=" + str(shard(30, 1)))
    println("r30 c2 phi=" + str(shard(30, 2)))
    println("r90 c1 phi=" + str(shard(90, 1)))
    println("r90 c2 phi=" + str(shard(90, 2)))
    println("r110 c1 phi=" + str(shard(110, 1)))
    println("r110 c2 phi=" + str(shard(110, 2)))
    println("FAST_DONE")
}
