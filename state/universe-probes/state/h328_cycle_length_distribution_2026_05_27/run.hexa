// H_328 — cycle-length distribution: life vs consciousness ECA rules (n=4)
// Pure hexa, deterministic. From each of the 16 starting states, run forward
// until first repeat (within 20 steps = guaranteed for n=4 because 16 states).
// Cycle length L(s0) = (first_repeat_index) - (first_seen_index_of_repeated_state).
// Hypothesis: life-themed rules (30, 110) have HIGHER mean cycle length than
// consciousness-themed rules (105, 150).
//
// Anti-tautology: cycle length is measured from the forward orbit; no class
// label feeds into the measurement. The classification is post-hoc from the
// H_287/H_320 literature mapping (life = chaotic/universal class III-IV,
// consciousness = high-integration class III).

fn next4(s: int, rule: int) -> int {
    let b0 = s & 1
    let b1 = (s >> 1) & 1
    let b2 = (s >> 2) & 1
    let b3 = (s >> 3) & 1
    let n0 = (rule >> ((b3 << 2) | (b0 << 1) | b1)) & 1
    let n1 = (rule >> ((b0 << 2) | (b1 << 1) | b2)) & 1
    let n2 = (rule >> ((b1 << 2) | (b2 << 1) | b3)) & 1
    let n3 = (rule >> ((b2 << 2) | (b3 << 1) | b0)) & 1
    return n0 | (n1 << 1) | (n2 << 2) | (n3 << 3)
}

fn cycle_len(s0: int, rule: int) -> int {
    let seen = farr_zeros(16)
    let idx_at = farr_zeros(16)
    let mut s = s0
    let mut t = 0
    while t < 20 {
        let was = to_int(farr_get(seen, s))
        if was == 1 {
            let first = to_int(farr_get(idx_at, s))
            let _ = farr_free(seen); let _ = farr_free(idx_at)
            return t - (first - 1)
        }
        let _ = farr_set(seen, s, 1.0)
        let _ = farr_set(idx_at, s, to_float(t + 1))
        s = next4(s, rule)
        t = t + 1
    }
    let _ = farr_free(seen); let _ = farr_free(idx_at)
    return -1
}

fn measure_rule(rule: int, name: string) -> float {
    let mut total = 0
    let mut s0 = 0
    while s0 < 16 {
        let L = cycle_len(s0, rule)
        total = total + L
        s0 = s0 + 1
    }
    let mean_L = to_float(total) / 16.0
    println("rule=" + str(rule) + " name=" + name + " sum_L=" + str(total) + " mean_L=" + str(mean_L))
    return mean_L
}

fn main() {
    println("H_328 cycle-length distribution n=4 ECA")
    let life_30 = measure_rule(30, "rule30_life")
    let life_110 = measure_rule(110, "rule110_life")
    let consc_105 = measure_rule(105, "rule105_consc")
    let consc_150 = measure_rule(150, "rule150_consc")
    let anchor_204 = measure_rule(204, "rule204_identity")
    let anchor_0 = measure_rule(0, "rule0_null")
    let life_mean = (life_30 + life_110) / 2.0
    let consc_mean = (consc_105 + consc_150) / 2.0
    println("life_mean=" + str(life_mean) + " consc_mean=" + str(consc_mean) + " ratio_life_over_consc=" + str(life_mean / consc_mean))
    println("done")
}
