            + " PHI_R250=" + to_string(phi_r250)
            + " PHI_R110=" + to_string(phi_r110)
            + " PHI_R30=" + to_string(phi_r30))
    println("================================================================")

    // ── write result.json ───────────────────────────────────────────────────
    let mut j = "{\n"
