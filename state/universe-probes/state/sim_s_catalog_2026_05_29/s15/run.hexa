// S15 evolution curve — does Φ increase monotonically with complexity?
// Falsifier: if Φ rises monotonically with substrate "complexity class", an
//   evolutionary Φ ladder exists. rule90(0.205) < rule110(14.15) but
//   rule184(19.94) > rule110 and rule30(17.86) between ⇒ NON-monotone: complexity
//   class does not predict Φ ordering (consistent with H_179).
// substrate: ECA n=4, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}

fn main() {
    let I = 0.21232
    let r90 = max_bigphi(90, 4, I)
    let r184 = max_bigphi(184, 4, I)
    let r110 = max_bigphi(110, 4, I)
    let r30 = max_bigphi(30, 4, I)
    print("rule90  Phi = "); println(r90)
    print("rule184 Phi = "); println(r184)
    print("rule110 Phi = "); println(r110)
    print("rule30  Phi = "); println(r30)
    // non-monotone: complexity ordering (90<110<30<184 by class) NOT matched by Φ.
    let nonmono = (r90 < r110) && (r184 > r110) && (r30 < r184) && (r30 > r110)
    let pass = (r110 > 14.0) && nonmono
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
