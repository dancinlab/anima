// S26 hive mind — does collective Φ rise with coupling strength?
// Falsifier: if collective Φ is independent of inter-agent coupling, a hive mind
//   gains nothing from tighter binding. As coupling rises (inhibition I falls:
//   0.45 -> 0.21 -> 0.05) Φ rises (9.51 -> 14.15 -> 19.09) ⇒ collective Φ is a
//   monotone function of coupling strength.
// substrate: ECA rule110 n=4. Coupling strength = (1-I) TPM scale; stronger
//   coupling = smaller inhibition I.
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}

fn main() {
    let n = 4
    let strong = max_bigphi(110, n, 0.05)    // tight coupling
    let mid = max_bigphi(110, n, 0.21232)    // reference
    let weak = max_bigphi(110, n, 0.45)      // loose coupling
    print("I=0.05  (strong) Phi = "); println(strong)
    print("I=0.21232 (ref)  Phi = "); println(mid)
    print("I=0.45  (weak)   Phi = "); println(weak)
    let pass = (strong > mid) && (mid > weak) && (mid > 14.0) && (mid < 14.3)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = MISMATCH") }
}
