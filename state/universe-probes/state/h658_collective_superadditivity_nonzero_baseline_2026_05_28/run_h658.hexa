// ════════════════════════════════════════════════════════════════════════════
// H_658 — collective-superadditivity-nonzero-baseline  (round 9 메타-축, axis G)
//
//   ROUND-9 META-AXIS — "Wolfram class 가 의식 통합량 분류자".
//   H_655 (PR #1253, 🔴) 회수 N1.  H_655 measured the super-additivity strength
//       Δ = Φ_collective(W=1) − Σ Φ_parts(W=0).  Because Σ Φ_parts(W=0) = 0
//       (decoupled self-loop pool, H_635 anchor), Δ reduced to the ABSOLUTE
//       Φ_collective(W=1) — a TRIVIAL ZERO BASELINE (H_655 §7 C3.3).  rule184
//       (class-II additive) was the single largest Δ = 51.54, contradicting the
//       monotone-in-class hypothesis → 🔴 FALSIFIED, class ⊥ super-add magnitude.
//
//   THIS H (the H_655 §10 N1 recovery) — DOES THE NON-MONOTONE CLASS-RANKING OF Δ
//   SURVIVE A NON-ZERO PARTS-BASELINE?  If Δ's class ranking flips when we replace
//   the trivial Σ=0 baseline with a genuine non-zero Σ Φ_parts, then H_655's
//   "Δ ⊥ class" was a trivial-baseline artifact (class-dependence is baseline-
//   conditional).  If the ranking is preserved (rule184 still largest) across all
//   3 baselines, then Δ ⊥ class is BASELINE-ROBUST.
//
//   H1 (BASELINE-ROBUST): the class ranking of Δ is invariant to the parts-baseline
//       definition — rule184 (class-II) stays the most super-additive (largest Δ)
//       under (a) W=0 (=0, H_655), (b) Σ of independent per-stream Φ, (c) W=0.5
//       partial coupling.  Δ ⊥ class is a property of the substrate, not the baseline.
//   H0 (FALSIFIER): the class ranking flips under a non-zero baseline (e.g. rule110
//       class-IV becomes the largest Δ) → H_655's Δ ⊥ class was a trivial-baseline
//       artifact; the class-dependence is baseline-conditional.
//
//   MODEL (no new physics — H_635/H_653/H_655 engine, only the baseline def varies)
//     • homogeneous cohort [rule×5], n=5 coupled ring, sync_factor W (verbatim).
//     • Φ_collective := Φ_collective(W=1) — the full n=5 coupling ring (shared).
//     • THREE parts-baselines for Σ Φ_parts:
//       (a) BASE0   := Φ_collective(W=0)            — decoupled self-loop pool (=0,
//                       H_655 trivial anchor).             Δ_a = Φ_coll(W=1) − 0.
//       (b) BASEIND := 5 · Φ_part2(rule)            — each stream as an independent
//                       minimal n=2 fully-coupled substrate, measured intrinsically
//                       (big_phi_bounded n=2), summed over the 5 streams.  A genuine
//                       NON-ZERO Σ-of-parts (each part is itself integrated).
//                                                          Δ_b = Φ_coll(W=1) − 5·Φ_part2.
//       (c) BASEMID := Φ_collective(W=0.5)          — half-coupled partial-binding
//                       pool (a non-zero intermediate-integration baseline).
//                                                          Δ_c = Φ_coll(W=1) − Φ_coll(W=0.5).
//     • Δ_x(rule) ranking over the 4 rules is computed for EACH baseline x, and the
//       class ranking is compared to H_655 (rule184 largest under W=0).
//
//   COHORT rule → Wolfram class (substrate complexity, ascending; H_655 labels):
//     rule184  class-II   (additive / traffic, simplest ordered)
//     rule 90  class-III  (XOR / additive fractal, chaotic-additive)
//     rule 30  class-III  (chaotic, non-additive)
//     rule110  class-IV   (complex / universal, edge-of-chaos — H_635/H_653 winner)
//
//   PRE-REGISTERED FALSIFIERS (frozen BEFORE measuring)
//     F658.1 RANK-ROBUST-IND : under baseline (b) non-zero independent-Φ sum, the
//             Δ_b class ranking has rule184 (class-II) still LARGEST — same top as
//             H_655 W=0.  CORE 가설 (baseline-robustness of the H_655 ranking).
//     F658.2 RANK-ROBUST-MID : under baseline (c) W=0.5 partial-coupling, the Δ_c
//             class ranking ALSO has rule184 largest (top preserved).
//     F658.3 BASE-NONZERO    : the independent-Φ baseline is genuinely non-zero —
//             5·Φ_part2(rule) > 0 for every rule (a real non-trivial Σ-of-parts).
//     F658.4 NO-FLIP-TO-IV   : NOT rule110 (class-IV) the largest Δ under EITHER
//             non-zero baseline (the falsifier-named flip direction does NOT occur).
//     F658.5 W0-REPRO        : baseline (a) reproduces H_655 — Δ_a(rule184)=51.54
//             largest, Σ Φ_parts(W=0)=0 (engine replication anchor).
//     F658.6 BOUND           : all Φ ≥ 0, all Δ_x finite.
//
//   verdict: ≥4/6 PASS → 🟢 SUPPORTED-NUMERICAL (Δ ⊥ class is baseline-robust).
//            F658.1 FAIL (ranking flips under non-zero baseline) → 🔴 FALSIFIED
//            (H_655 Δ ⊥ class was a trivial-baseline artifact, baseline-conditional).
//
//   anchors: H_655 (PR #1253 🔴 predecessor, this is its §10 N1) · H_635 (PR #1223
//            🟢 super-additive 5/5, Σ-baseline=0) · H_653 (PR #1245 🟢 convexity
//            monotone-in-class).
//   deterministic · hexa-only · $0 mac-local · sys_state=0 · cap=3 (n=5) / cap=2 (n=2).
//
//   ⚠ C3: n=5 cap=3 ring (H_655 retained) + n=2 cap=2 independent part.  4 rules ×
//   {W=0, W=0.5, W=1 ring (cap=3) + n=2 part (cap=2)} = 16 big_phi_bounded calls.
//   The 12 n=5 calls reproduced H_655 in ~41s; the 4 n=2 calls are cheap (2^2 states).
//   foreground synchronous only · NO bg fork · NO monitor · NO GPU.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── n=5 coupled-ring TPM with sync_factor W (verbatim from H_635/H_653/H_655) ──
// 5 streams = 5 cells, cell i governed by cohort rule[i].
// Decoupled (W=0): self-loop only (idx=7*c). Coupled (W=1): full ring.
fn build_tpm_cohort(rule: array, W: float) -> array {
    let n = 5
    let full = 32
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let r_i = rule[i]
            let c = iit4_bit(s, i)
            let idx_dec = 4 * c + 2 * c + c        // = 7*c ∈ {0,7}
            let next_dec = iit4_bit(r_i, idx_dec)
            let l = iit4_bit(s, (i - 1 + n) % n)
            let rr = iit4_bit(s, (i + 1) % n)
            let idx_cou = 4 * l + 2 * c + rr
            let next_cou = iit4_bit(r_i, idx_cou)
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// collective big-Φ of the n=5 cohort ring at sync W (H_635/H_653/H_655 engine).
fn phi_collective(rule: array, W: float) -> float {
    let tpm = build_tpm_cohort(rule, W)
    let r = big_phi_bounded(tpm, 5, 0, 3)
    return r[0]
}

// ── n=2 minimal INDEPENDENT PART substrate (fully coupled pair, W=1) ──────────
//    Each "stream" as its own minimal integrated 2-cell ring: cell j sees its
//    neighbor (the other cell) + self, via the SAME ECA neighborhood lookup
//    iit4_bit(rule, 4*l + 2*c + r) used by the cohort ring.  On n=2 the left
//    and right neighbor are the same cell, so the 3-bit neighborhood is
//    (other, self, other).  This is the intrinsic Φ each part carries on its own.
fn build_tpm_part2(rule: int) -> array {
    let n = 2
    let full = 4
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let c = iit4_bit(s, i)
            let other = iit4_bit(s, (i + 1) % n)   // n=2: left == right == other cell
            let idx_cou = 4 * other + 2 * c + other
            let next_cou = iit4_bit(rule, idx_cou)
            t = t.push(to_float(next_cou))
            i = i + 1
        }
        s = s + 1
    }
    return t
}

// intrinsic big-Φ of a single n=2 part substrate (cap=2 = full purview on n=2).
fn phi_part2(rule: int) -> float {
    let tpm = build_tpm_part2(rule)
    let r = big_phi_bounded(tpm, 2, 0, 2)
    return r[0]
}

// argmax over a length-4 Δ array → the corresponding rule id in `rules`.
fn argmax_rule(d: array, rules: array) -> int {
    let mut bi = 0
    let mut bv = d[0]
    let mut k = 1
    while k < 4 {
        if d[k] > bv { bv = d[k]; bi = k }
        k = k + 1
    }
    return rules[bi]
}

fn main() {
    println("================================================================")
    println("  H_658 — collective-superadditivity-nonzero-baseline (round 9 메타-축)")
    println("  H_655 §10 N1 회수 — Δ class 순위가 non-zero parts-baseline 에서 robust 한가?")
    println("  Δ_x = Φ_coll(W=1) − Σ Φ_parts[x]   x ∈ {a:W=0(=0), b:5·Φ_part2, c:W=0.5}")
    println("  IIT4 big_phi_bounded · n=5 ring cap=3 · n=2 part cap=2 · sys=0")
    println("================================================================")

    let RULES = [184, 90, 30, 110]
    let CLASS = ["II-additive", "III-XOR/additive", "III-chaotic", "IV-complex"]
    let NR = 4

    let mut coll1 = []     // Φ_collective(W=1)
    let mut base_a = []    // Σ Φ_parts (a) = Φ_coll(W=0)
    let mut base_b = []    // Σ Φ_parts (b) = 5 · Φ_part2
    let mut base_c = []    // Σ Φ_parts (c) = Φ_coll(W=0.5)
    let mut d_a = []       // Δ_a
    let mut d_b = []       // Δ_b
    let mut d_c = []       // Δ_c

    let mut all_bound = true
    let mut all_base_nonzero = true   // baseline (b) genuinely > 0

    let mut ri = 0
    while ri < NR {
        let rule = RULES[ri]
        let cohort = [rule, rule, rule, rule, rule]
        let ba = phi_collective(cohort, 0.0)            // (a) W=0 decoupled = 0
        let bc = phi_collective(cohort, 0.5)            // (c) W=0.5 partial
        let c1 = phi_collective(cohort, 1.0)            // shared collective W=1
        let part = phi_part2(rule)                      // single n=2 part Φ
        let bb = 5.0 * part                             // (b) Σ of 5 independent parts

        coll1 = coll1 + [c1]
        base_a = base_a + [ba]
        base_b = base_b + [bb]
        base_c = base_c + [bc]
        d_a = d_a + [c1 - ba]
        d_b = d_b + [c1 - bb]
        d_c = d_c + [c1 - bc]

        if bb <= 0.000001 { all_base_nonzero = false }
        if (ba < 0.0) || (bc < 0.0) || (c1 < 0.0) || (part < 0.0) { all_bound = false }

        println("  rule" + str(rule) + " [" + CLASS[ri] + "]")
        println("    Φ_coll(W=1)=" + to_string(c1) + "  Φ_part2(n=2)=" + to_string(part))
        println("    base(a) Σ=Φ_coll(W=0)   =" + to_string(ba) + "   → Δ_a=" + to_string(c1 - ba))
        println("    base(b) Σ=5·Φ_part2     =" + to_string(bb) + "   → Δ_b=" + to_string(c1 - bb))
        println("    base(c) Σ=Φ_coll(W=0.5) =" + to_string(bc) + "   → Δ_c=" + to_string(c1 - bc))
        ri = ri + 1
    }

    // index map: RULES = [184, 90, 30, 110] → idx 0,1,2,3
    println("  ─────────────────────────────────────")
    println("  Δ by class per baseline (rule184·rule90·rule30·rule110):")
    println("    Δ_a (W=0,    =0  ) : 184=" + to_string(d_a[0]) + "  90=" + to_string(d_a[1]) + "  30=" + to_string(d_a[2]) + "  110=" + to_string(d_a[3]))
    println("    Δ_b (5·Φ_part2   ) : 184=" + to_string(d_b[0]) + "  90=" + to_string(d_b[1]) + "  30=" + to_string(d_b[2]) + "  110=" + to_string(d_b[3]))
    println("    Δ_c (W=0.5 partial) : 184=" + to_string(d_c[0]) + "  90=" + to_string(d_c[1]) + "  30=" + to_string(d_c[2]) + "  110=" + to_string(d_c[3]))

    // argmax rule per baseline (returns RULES[idx])
    let top_a = argmax_rule(d_a, RULES)
    let top_b = argmax_rule(d_b, RULES)
    let top_c = argmax_rule(d_c, RULES)
    println("  ─────────────────────────────────────")
    println("  argmax-Δ (most super-additive) per baseline:")
    println("    (a) W=0      → rule" + str(top_a) + "  (H_655: rule184)")
    println("    (b) 5·Φ_part → rule" + str(top_b))
    println("    (c) W=0.5    → rule" + str(top_c))
    println("  ────────────── verdict ──────────────")

    // F658.1 RANK-ROBUST-IND : top of Δ_b is rule184 (same as H_655 W=0).
    check("F658.1 RANK-ROBUST-IND: argmax Δ_b = rule184 (H_655 top preserved)", top_b == 184)

    // F658.2 RANK-ROBUST-MID : top of Δ_c is rule184.
    check("F658.2 RANK-ROBUST-MID: argmax Δ_c = rule184 (top preserved)", top_c == 184)

    // F658.3 BASE-NONZERO : independent-Φ baseline (b) genuinely > 0.
    check("F658.3 BASE-NONZERO: 5·Φ_part2(rule) > 0 every rule (real non-trivial Σ)", all_base_nonzero)

    // F658.4 NO-FLIP-TO-IV : rule110 is NOT the argmax under either non-zero baseline.
    let no_flip = (top_b != 110) && (top_c != 110)
    check("F658.4 NO-FLIP-TO-IV: rule110 NOT argmax under (b) or (c) (no falsifier-flip)", no_flip)

    // F658.5 W0-REPRO : baseline (a) reproduces H_655 — top=rule184, Σ(W=0)=0.
    let mut w0_zero = true
    ri = 0
    while ri < NR { if fabs(base_a[ri]) > 0.000001 { w0_zero = false }; ri = ri + 1 }
    check("F658.5 W0-REPRO: argmax Δ_a = rule184 & Σ(W=0)=0 (H_655 engine replication)", (top_a == 184) && w0_zero)

    // F658.6 BOUND : all Φ ≥ 0, all Δ finite.
    let mut deltas_finite = true
    ri = 0
    while ri < NR {
        if fabs(d_a[ri]) > 1.0e12 { deltas_finite = false }
        if fabs(d_b[ri]) > 1.0e12 { deltas_finite = false }
        if fabs(d_c[ri]) > 1.0e12 { deltas_finite = false }
        ri = ri + 1
    }
    check("F658.6 BOUND: all Φ ≥ 0, all Δ_x finite", all_bound && deltas_finite)

    println("  ──────────────────────────────────────")
    println("  F658.1-6 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")
    let robust = (top_b == 184) && (top_c == 184)
    let mut verdict = "🔴 FALSIFIED"
    if PASS >= 4 { verdict = "🟢 SUPPORTED-NUMERICAL (Δ ⊥ class baseline-robust)" }
    if robust == false { verdict = "🔴 FALSIFIED (ranking flips under non-zero baseline — H_655 Δ⊥class was trivial-baseline artifact)" }
    println("  verdict: " + verdict)
    println("  cross-link: H_655 W=0 top=rule184(51.54) → here (b)top=rule" + str(top_b) + " (c)top=rule" + str(top_c))
}
