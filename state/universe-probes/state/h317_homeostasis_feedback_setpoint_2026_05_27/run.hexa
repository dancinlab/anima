// H_317 — HOMEOSTASIS × negative-feedback setpoint regulation
// ════════════════════════════════════════════════════════════════════════════
// REAL discrete-time 2nd-order feedback plant (inertia + actuator integration):
//
//   u[t]   = -k * (x[t] - x*)            // negative feedback controller
//   v[t+1] = alpha * v[t] + u[t]         // velocity / inertia (actuator lag)
//   x[t+1] = x[t] + v[t]                 // plant integrates velocity (1-step delay)
//
// This is NOT a snap-to-setpoint tautology. x does NOT equal x* by construction.
// Stability is genuinely k-dependent. Map onto e = x - x*:
//   e[t+1] = e[t] + v[t]
//   v[t+1] = alpha*v[t] - k*e[t]
// char poly: z^2 - (1+alpha) z + (alpha + k) = 0
// Jury stability (|roots|<1):  a0 = alpha+k < 1  AND  a1 = -(1+alpha), |a1| < 1+a0
//   => 0 < k < 1 - alpha   (with alpha=0.5  ->  stable band 0 < k < 0.5)
// We RUN the timestep loop and MEASURE |x-x*|; the analytic band is only a
// post-hoc cross-check, never used to decide PASS.
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

// ── run one closed-loop trajectory for gain k ────────────────────────────────
// Returns a 5-tuple of measured outcomes via globals (hexa has no tuple return here):
//   g_settled  : did |x-x*| stay < eps for the last `hold` steps within K steps?
//   g_settle_t : first step index at which |x-x*| first dropped below eps and STAYED
//   g_overshoot: max |x-x*| after the perturbation relative to initial |e0| (ratio)
//   g_diverged : did |x-x*| exceed a divergence cap at any point?
//   g_final_e  : |x-x*| at final step
//   g_sign_flips: number of times e changed sign (oscillation counter)
let mut g_settled = false
let mut g_settle_t = 0
let mut g_overshoot = 0.0
let mut g_diverged = false
let mut g_final_e = 0.0
let mut g_sign_flips = 0

fn simulate(k: float, alpha: float, xstar: float, x0: float, K: int, eps: float, hold: int) {
    // reset measured outcomes
    g_settled = false
    g_settle_t = K
    g_overshoot = 0.0
    g_diverged = false
    g_final_e = 0.0
    g_sign_flips = 0

    let mut x = x0          // perturbed initial state (step perturbation away from x*)
    let mut v = 0.0
    let e0 = absf(x0 - xstar)
    let divcap = e0 * 1000.0 + 1000.0   // divergence cap (absolute)

    let mut consec = 0                  // consecutive steps within eps
    let mut settle_candidate = -1       // step where current in-band streak began
    let mut prev_e_sign = 0             // -1 / 0 / +1

    let mut t = 0
    while t < K {
        let e = x - xstar
        let ae = absf(e)

        // track overshoot (max |e| ever seen, as ratio of e0)
        if ae > g_overshoot { g_overshoot = ae }

        // sign-flip / oscillation counter
        let mut cur_sign = 0
        if e > 0.0 { cur_sign = 1 }
        if e < 0.0 { cur_sign = 0 - 1 }
        if cur_sign != 0 {
            if prev_e_sign != 0 {
                if cur_sign != prev_e_sign { g_sign_flips = g_sign_flips + 1 }
            }
            prev_e_sign = cur_sign
        }

        // divergence check
        if ae > divcap { g_diverged = true }

        // settling streak
        if ae < eps {
            if consec == 0 { settle_candidate = t }
            consec = consec + 1
            if consec >= hold {
                if !g_settled {
                    g_settled = true
                    g_settle_t = settle_candidate
                }
            }
        } else {
            consec = 0
            settle_candidate = -1
        }

        // ── plant update (the REAL dynamics) ──
        let u = (0.0 - k) * e          // negative feedback
        let v_next = alpha * v + u     // inertia + actuator
        let x_next = x + v             // integrate velocity (1-step delay)
        v = v_next
        x = x_next

        t = t + 1
    }

    g_final_e = absf(x - xstar)
    // normalize overshoot to ratio of initial perturbation magnitude
    if e0 > 0.0 { g_overshoot = g_overshoot / e0 }
}

fn main() {
    println("================================================================")
    println("  H_317 — HOMEOSTASIS × negative-feedback setpoint regulation")
    println("  plant: x[t+1]=x[t]+v ; v[t+1]=alpha*v - k*(x-x*)  (inertia+delay)")
    println("================================================================")

    let alpha  = 0.5      // inertia (actuator lag) — makes stability non-trivial
    let xstar  = 10.0     // setpoint
    let x0     = 0.0      // step perturbation: start 10 units BELOW setpoint
    let K      = 400      // steps
    let eps    = 0.05     // regulation tolerance |x-x*| < eps
    let hold   = 20       // must stay in-band this many consecutive steps

    println("  setpoint x*=10.0  perturb x0=0.0  alpha=0.5  K=400  eps=0.05  hold=20")
    println("  analytic stable band (cross-check only): 0 < k < 1-alpha = 0.5")
    println("----------------------------------------------------------------")

    // ── k SWEEP — measure REAL settling per gain ─────────────────────────────
    // grid spans sluggish/stable/marginal/unstable/divergent regimes
    let ks_0 = 0.0        // no feedback (should NEVER regulate)
    let ks_1 = 0.05       // very low gain — stable, sluggish
    let ks_2 = 0.15       // stable
    let ks_3 = 0.30       // stable, faster
    let ks_4 = 0.45       // near upper edge, stable but slow/oscillatory
    let ks_5 = 0.50       // boundary (marginal — should NOT settle, |root|=1)
    let ks_6 = 0.70       // ABOVE band — underdamped oscillation / no settle
    let ks_7 = 1.20       // well above — divergence
    let ks_neg = 0.0 - 0.20  // negative gain (positive feedback) — divergence

    // run each and record
    println("  k=0.00 (no feedback):")
    simulate(ks_0, alpha, xstar, x0, K, eps, hold)
    let s0 = g_settled; let f0 = g_final_e; let o0 = g_overshoot; let d0 = g_diverged; let st0 = g_settle_t; let fl0 = g_sign_flips
    println("    settled=" + str(s0) + " settle_t=" + str(st0) + " final|e|=" + str(f0) + " overshoot=" + str(o0) + " diverged=" + str(d0) + " sign_flips=" + str(fl0))

    println("  k=0.05 (very low, sluggish):")
    simulate(ks_1, alpha, xstar, x0, K, eps, hold)
    let s1 = g_settled; let f1 = g_final_e; let o1 = g_overshoot; let d1 = g_diverged; let st1 = g_settle_t; let fl1 = g_sign_flips
    println("    settled=" + str(s1) + " settle_t=" + str(st1) + " final|e|=" + str(f1) + " overshoot=" + str(o1) + " diverged=" + str(d1) + " sign_flips=" + str(fl1))

    println("  k=0.15 (stable):")
    simulate(ks_2, alpha, xstar, x0, K, eps, hold)
    let s2 = g_settled; let f2 = g_final_e; let o2 = g_overshoot; let d2 = g_diverged; let st2 = g_settle_t; let fl2 = g_sign_flips
    println("    settled=" + str(s2) + " settle_t=" + str(st2) + " final|e|=" + str(f2) + " overshoot=" + str(o2) + " diverged=" + str(d2) + " sign_flips=" + str(fl2))

    println("  k=0.30 (stable, faster):")
    simulate(ks_3, alpha, xstar, x0, K, eps, hold)
    let s3 = g_settled; let f3 = g_final_e; let o3 = g_overshoot; let d3 = g_diverged; let st3 = g_settle_t; let fl3 = g_sign_flips
    println("    settled=" + str(s3) + " settle_t=" + str(st3) + " final|e|=" + str(f3) + " overshoot=" + str(o3) + " diverged=" + str(d3) + " sign_flips=" + str(fl3))

    println("  k=0.45 (near upper edge):")
    simulate(ks_4, alpha, xstar, x0, K, eps, hold)
    let s4 = g_settled; let f4 = g_final_e; let o4 = g_overshoot; let d4 = g_diverged; let st4 = g_settle_t; let fl4 = g_sign_flips
    println("    settled=" + str(s4) + " settle_t=" + str(st4) + " final|e|=" + str(f4) + " overshoot=" + str(o4) + " diverged=" + str(d4) + " sign_flips=" + str(fl4))

    println("  k=0.50 (boundary, marginal):")
    simulate(ks_5, alpha, xstar, x0, K, eps, hold)
    let s5 = g_settled; let f5 = g_final_e; let o5 = g_overshoot; let d5 = g_diverged; let st5 = g_settle_t; let fl5 = g_sign_flips
    println("    settled=" + str(s5) + " settle_t=" + str(st5) + " final|e|=" + str(f5) + " overshoot=" + str(o5) + " diverged=" + str(d5) + " sign_flips=" + str(fl5))

    println("  k=0.70 (above band, oscillation):")
    simulate(ks_6, alpha, xstar, x0, K, eps, hold)
    let s6 = g_settled; let f6 = g_final_e; let o6 = g_overshoot; let d6 = g_diverged; let st6 = g_settle_t; let fl6 = g_sign_flips
    println("    settled=" + str(s6) + " settle_t=" + str(st6) + " final|e|=" + str(f6) + " overshoot=" + str(o6) + " diverged=" + str(d6) + " sign_flips=" + str(fl6))

    println("  k=1.20 (well above, divergence):")
    simulate(ks_7, alpha, xstar, x0, K, eps, hold)
    let s7 = g_settled; let f7 = g_final_e; let o7 = g_overshoot; let d7 = g_diverged; let st7 = g_settle_t; let fl7 = g_sign_flips
    println("    settled=" + str(s7) + " settle_t=" + str(st7) + " final|e|=" + str(f7) + " overshoot=" + str(o7) + " diverged=" + str(d7) + " sign_flips=" + str(fl7))

    println("  k=-0.20 (negative gain, positive feedback):")
    simulate(ks_neg, alpha, xstar, x0, K, eps, hold)
    let sn = g_settled; let fe_n = g_final_e; let on = g_overshoot; let dn = g_diverged; let stn = g_settle_t; let fln = g_sign_flips
    println("    settled=" + str(sn) + " settle_t=" + str(stn) + " final|e|=" + str(fe_n) + " overshoot=" + str(on) + " diverged=" + str(dn) + " sign_flips=" + str(fln))

    println("----------------------------------------------------------------")
    println("  FALSIFIER EVALUATION (from MEASURED trajectories):")

    // ── F317.1 STABLE-BAND-EXISTS: at least one k in (0,0.5) regulates ──
    let band_regulates = s1 && s2 && s3
    check("F317.1 STABLE-BAND-EXISTS: k in {0.05,0.15,0.30} all settle within eps", band_regulates)

    // ── F317.2 NO-FEEDBACK-FAILS: k=0 never regulates (stays at perturbation) ──
    check("F317.2 NO-FEEDBACK-FAILS: k=0.0 does NOT settle", !s0)

    // ── F317.3 NEGATIVE-GAIN-DIVERGES: k<0 (positive feedback) diverges, no settle ──
    check("F317.3 NEGATIVE-GAIN-DIVERGES: k=-0.20 diverges AND does not settle", dn && (!sn))

    // ── F317.4 HIGH-GAIN-UNSTABLE: k=1.20 (above band) does NOT settle ──
    check("F317.4 HIGH-GAIN-UNSTABLE: k=1.20 does NOT settle", !s7)

    // ── F317.5 OSCILLATION-ABOVE-BAND: k=0.70 oscillates (>= 5 sign flips) and no settle ──
    check("F317.5 OSCILLATION-ABOVE-BAND: k=0.70 sign_flips>=5 AND no settle", (fl6 >= 5) && (!s6))

    // ── F317.6 BOUNDARY-MARGINAL: k=0.50 (|root|=1) does NOT settle ──
    check("F317.6 BOUNDARY-MARGINAL: k=0.50 does NOT settle (marginal)", !s5)

    // ── F317.7 BAND-IS-CHARACTERIZABLE: settle holds for k<0.5 but breaks for k>=0.5 ──
    // i.e. the regime BOUNDARY is real — not "all k settle" and not "no k settles"
    let inside_all_settle = s1 && s2 && s3 && s4
    let outside_none_settle = (!s5) && (!s6) && (!s7) && (!sn)
    check("F317.7 BAND-CHARACTERIZABLE: all k in [0.05,0.45] settle AND all k>=0.5 (or k<0) do not", inside_all_settle && outside_none_settle)

    // ── F317.8 REGULATION-REAL: settled cases reach final|e| < eps; failed cases do not ──
    let reg_real = (f2 < eps) && (f6 >= eps)
    check("F317.8 REGULATION-REAL: stable k=0.15 final|e|<eps but unstable k=0.70 final|e|>=eps", reg_real)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if PASS >= 7 {
        println("  HEADLINE: CHARACTERIZABLE STABLE BAND EXISTS — homeostasis is a real")
        println("    emergent property with a k-dependent stable regime (0<k<1-alpha),")
        println("    NOT automatic. -> verdict candidate per measured numbers")
    } else {
        println("  HEADLINE: PARTIAL — band claim not fully supported by measurements")
    }
    println("================================================================")
    if FAIL > 0 { panic("H_317 had FALSIFIER FAILURES — adjust verdict honestly") }
}
