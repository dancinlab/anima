    println("  Lane-separate from H_157 C6 (uncorrelated sub-additive PR #221)")
    println("")

    // ── build fixed A sub-state (rule-110 ring, rep=0) ─────────────────────
    let states_a = _run_ca(110, _N(), _DIM(), _WARM(), 0)
    let nbins = c_phi_n_bins_default()

    // ── ρ sweep ────────────────────────────────────────────────────────────
    println("── ρ sweep — 4 correlation regimes ──")
    let r000 = _measure_rho(states_a,   0, _N(), _DIM(), _WARM(), nbins)
    let r030 = _measure_rho(states_a,  30, _N(), _DIM(), _WARM(), nbins)
    let r070 = _measure_rho(states_a,  70, _N(), _DIM(), _WARM(), nbins)
    let r100 = _measure_rho(states_a, 100, _N(), _DIM(), _WARM(), nbins)

    println("  ρ=0.0 (uncorrelated baseline · H_157 C6 sister):")
    println("    Φ_A=" + to_string(r000.phi_a) + "  Φ_B=" + to_string(r000.phi_b)
            + "  Φ_merged=" + to_string(r000.phi_merged))
    println("    Σ_micro=" + to_string(r000.sum_micro) + "  Δ=" + to_string(r000.delta)
            + "  Δ%=" + to_string(r000.delta_pct * 100.0) + "%")
    println("  ρ=0.3 (partial XOR-binding 30%):")
    println("    Φ_A=" + to_string(r030.phi_a) + "  Φ_B=" + to_string(r030.phi_b)
            + "  Φ_merged=" + to_string(r030.phi_merged))
    println("    Σ_micro=" + to_string(r030.sum_micro) + "  Δ=" + to_string(r030.delta)
            + "  Δ%=" + to_string(r030.delta_pct * 100.0) + "%")
    println("  ρ=0.7 (partial XOR-binding 70%):")
