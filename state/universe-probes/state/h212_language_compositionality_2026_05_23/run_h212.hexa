    println("    Σ_micro=" + to_string(r100.sum_micro) + "  Δ=" + to_string(r100.delta)
            + "  Δ%=" + to_string(r100.delta_pct * 100.0) + "%")
    println("")

    // ── falsifier evaluation ─────────────────────────────────────────────
    // F1  CORRELATED-SUPER: ρ=0.7 또는 ρ=1.0 위 super-additive (Δ% ≥ 5%)
    let f1 = r070.super_additive || r100.super_additive
    // F2  UNCORR-SUB: ρ=0.0 위 Δ ≤ 0 (sub-additive or equal)
    let f2 = r000.delta <= 0.000001
    // F3  MONOTONE: Δ(0.0) < Δ(0.3) < Δ(0.7) < Δ(1.0)
    let f3 = r000.delta < r030.delta && r030.delta < r070.delta && r070.delta < r100.delta
    // F4  DETERMIN: re-run ρ=0.7 byte-equal
    let r070b = _measure_rho(states_a, 70, _N(), _DIM(), _WARM(), nbins)
    let f4 = r070.phi_a == r070b.phi_a && r070.phi_b == r070b.phi_b && r070.phi_merged == r070b.phi_merged
    // F5  PRIMITIVE-OK: 모든 Φ ≥ 0
    let f5 = r000.phi_a >= 0.0 && r000.phi_b >= 0.0 && r000.phi_merged >= 0.0
          && r030.phi_a >= 0.0 && r030.phi_b >= 0.0 && r030.phi_merged >= 0.0
          && r070.phi_a >= 0.0 && r070.phi_b >= 0.0 && r070.phi_merged >= 0.0
          && r100.phi_a >= 0.0 && r100.phi_b >= 0.0 && r100.phi_merged >= 0.0

    println("── falsifier verdicts ──")
    println("  F1  CORRELATED-SUPER  (ρ∈{0.7,1.0} Δ%≥5%)  : " + _verdict(f1))
    println("  F2  UNCORR-SUB        (ρ=0.0 Δ≤0)           : " + _verdict(f2))
    println("  F3  MONOTONE          (Δ↑ across ρ sweep)   : " + _verdict(f3))
    println("  F4  DETERMIN          (byte-equal re-run)   : " + _verdict(f4))
    println("  F5  PRIMITIVE-OK      (all Φ≥0)             : " + _verdict(f5))
    println("")

    // ── criteria evaluation ───────────────────────────────────────────────
    let c1 = f1     // C1 = F1
    let c2 = f2     // C2 = F2
    let c3 = f3     // C3 = F3
    let c4 = f4     // C4 = F4 (re-run determinism)
    let pass_count = (if c1 { 1 } else { 0 }) + (if c2 { 1 } else { 0 })
                   + (if c3 { 1 } else { 0 }) + (if c4 { 1 } else { 0 })

    let verdict = if c1 && c2 && c3 {
        "SUPPORTED  (correlated-binding super-additive · H_157 C6 lane-separate confirmed)"
    } else if pass_count >= 2 {
        "PARTIAL    (some criteria met · directional evidence)"
