    j = j + "  \"rho_sweep\": [\n"
    j = j + "    {\"rho\": " + to_string(r000.rho) + ", \"phi_A\": " + to_string(r000.phi_a)
          + ", \"phi_B\": " + to_string(r000.phi_b) + ", \"phi_merged\": " + to_string(r000.phi_merged)
          + ", \"sum_micro\": " + to_string(r000.sum_micro) + ", \"delta\": " + to_string(r000.delta)
          + ", \"delta_pct\": " + to_string(r000.delta_pct * 100.0)
          + ", \"super_additive\": " + _bool_str(r000.super_additive) + "},\n"
    j = j + "    {\"rho\": " + to_string(r030.rho) + ", \"phi_A\": " + to_string(r030.phi_a)
          + ", \"phi_B\": " + to_string(r030.phi_b) + ", \"phi_merged\": " + to_string(r030.phi_merged)
