          + ", \"super_additive\": " + _bool_str(r030.super_additive) + "},\n"
    j = j + "    {\"rho\": " + to_string(r070.rho) + ", \"phi_A\": " + to_string(r070.phi_a)
          + ", \"phi_B\": " + to_string(r070.phi_b) + ", \"phi_merged\": " + to_string(r070.phi_merged)
          + ", \"sum_micro\": " + to_string(r070.sum_micro) + ", \"delta\": " + to_string(r070.delta)
