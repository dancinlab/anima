// H_212 — language-compositionality · correlated binding super-additive Φ
// ════════════════════════════════════════════════════════════════════════════
//
//  GOAL (Cycle #1, NEW):
//    H_157 C6 / H_054 C2 의 *uncorrelated* sub-additive 결과 (PR #221 / #227)
//    lane-separate. 본 H_212 는 *correlated* sub-state composition — language
//    compositional binding (B = f(A) deterministic mapping) 위 super-additive
//    Φ 출현 여부 측정.
//
//  HYPOTHESIS:
//    A, B sub-state 가 correlated (B = XOR-derived from A, ρ ∈ {0,0.3,0.7,1.0})
//    으로 구성될 때, merged (A ⊕ B) 의 Φ 가 Σ(Φ_A, Φ_B) 보다 크다 (super-
//    additive). uncorrelated (ρ=0) 인 경우 sub-additive (H_157 C6 sister).
//
//  HONEST SCOPE (g3 — real limits, no fake descent):
//    - 'language compositionality' = real-language syntax 가 아니라 *binding*
//      의 toy proxy (XOR-style adjacent coupling)
//    - phi_spatial 🟢 NUMERICAL — full IIT 4.0 MIP combination 아님
//    - small N=8 sub-pool — large-scale compositional structure 미검증
//    - super-additive Φ ≠ phenomenal combination problem 해결 (Goff
//      "explanatory gap" 별도 lane, H_004 boundary)
//    - $0 Mac local · hexa-only · NO LLM · NO .py/.sh
//
//  PROBE — ρ sweep × correlated XOR-binding:
//    ρ ∈ {0.0, 0.3, 0.7, 1.0}
//    A_state: N=8 dim=8, rule-110 ring forward 8 steps → fixed deterministic A
//    B_state(ρ):
//      ρ=0.0: independent rule-30 ring (uncorrelated, H_157 C6 sister)
//      ρ=0.3: 30% XOR-bind to A_{i-1}, 70% uncorrelated bit
//      ρ=0.7: 70% XOR-bind to A_{i-1}, 30% uncorrelated bit
//      ρ=1.0: identity copy of A (fully correlated)
//    merged: concat(A, B) → 2N=16 cells × dim=8
//    Φ primitive: RFC 036 phi_spatial (HEXAD/C/c_lib.hexa byte-equal phi_rs)
//
//  FALSIFIERS (≥5):
//    F1  CORRELATED-SUPER:  ρ ∈ {0.7, 1.0} 위 Δ = Φ_merged - (Φ_A + Φ_B) > +5%
//    F2  UNCORR-SUB:        ρ=0.0 위 Δ ≤ 0 (H_157 C6 sister · sub-additive)
//    F3  MONOTONE:          Δ(0.0) < Δ(0.3) < Δ(0.7) < Δ(1.0)
//    F4  DETERMIN:          re-run byte-identical (same ρ sweep)
//    F5  PRIMITIVE-OK:      모든 Φ ≥ 0 (NaN/negative 없음)
//
//  TIER = 🟢 NUMERICAL
// ════════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a7c76c27ff355e66e/HEXAD/C/c_lib.hexa"

// ── config ──────────────────────────────────────────────────────────────────
fn _N() -> int    { return 8 }
fn _DIM() -> int  { return 8 }
fn _WARM() -> int { return 8 }
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a7c76c27ff355e66e/UNIVERSE/state/h212_language_compositionality_2026_05_23"
}

// ── tiny int helpers ───────────────────────────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

// elementary CA next-state
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve length-N periodic elementary CA; record each site's `dim`-step
// trajectory after `warm` warmup into a flat (n × dim) farr handle.
fn _run_ca(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)
    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// ── deterministic LCG for partial-correlation noise (no RNG seed env)─────
fn _lcg_next(seed: int) -> int {
    // standard 32-bit Numerical Recipes LCG
    let v = (1664525 * seed + 1013904223) % 2147483648
    return v
}
// returns 0 or 1 deterministically from LCG draw
fn _lcg_bit(seed: int) -> int {
    let v = _lcg_next(seed)
    if v % 2 == 0 { return 0 }
    return 1
}

// ── build B sub-state with target correlation ρ to A ─────────────────────
//  rho = 0.0:  B[i] = independent rule-30 ring evolved deterministically
//              (uncorrelated, no XOR-binding to A)
//  rho = 0.3:  for each (i,t) — with prob 0.3 set B[i,t] = XOR(A[i-1,t], A[i,t])
//              else use rule-30 cell at (i,t)
//  rho = 0.7:  same scheme with prob 0.7
//  rho = 1.0:  B[i,t] = A[i,t] (identity copy)
//
//  scheme is deterministic — LCG-derived bit decides per-(i,t) whether to bind.
fn _build_B(states_a: int, n: int, dim: int, rho_pct: int, warm: int) -> int {
    let states_b = farr_zeros(n * dim)
    // ρ = 1.0 — full identity copy
    if rho_pct == 100 {
        let mut i = 0
        while i < n {
            let mut t = 0
            while t < dim {
                let _ = farr_set(states_b, i * dim + t, farr_get(states_a, i * dim + t))
                t = t + 1
            }
            i = i + 1
        }
        return states_b
    }
    // ρ ∈ {0.0, 0.3, 0.7} — partial XOR-binding with rule-30 uncorrelated baseline
    let baseline = _run_ca(30, n, dim, warm, 1)   // rep=1 → distinct from A
    let mut seed = 4242  // deterministic
    let mut i = 0
    while i < n {
        let mut t = 0
        while t < dim {
            seed = _lcg_next(seed)
            let pct_draw = seed % 100   // 0..99
            // bind if pct_draw < rho_pct
            if pct_draw < rho_pct {
                // XOR-binding: B[i,t] = A[(i-1+n) % n, t] XOR A[i, t]
                let li = (i + n - 1) % n
                let lv = _ftoi(farr_get(states_a, li * dim + t))
                let cv = _ftoi(farr_get(states_a, i  * dim + t))
                let xv = (lv + cv) % 2
                let _ = farr_set(states_b, i * dim + t, _itof(xv))
            } else {
                let _ = farr_set(states_b, i * dim + t, farr_get(baseline, i * dim + t))
            }
            t = t + 1
        }
        i = i + 1
    }
    let _ = farr_free(baseline)
    return states_b
}

// ── concat A and B by cells (NOT time) → 2N × dim ────────────────────────
fn _build_merged(states_a: int, states_b: int, n: int, dim: int) -> int {
    let merged = farr_zeros(2 * n * dim)
    let mut i = 0
    while i < n {
        let mut t = 0
        while t < dim {
            let _ = farr_set(merged, i * dim + t, farr_get(states_a, i * dim + t))
            t = t + 1
        }
        i = i + 1
    }
    let mut j = 0
    while j < n {
        let mut t2 = 0
        while t2 < dim {
            let _ = farr_set(merged, (n + j) * dim + t2, farr_get(states_b, j * dim + t2))
            t2 = t2 + 1
        }
        j = j + 1
    }
    return merged
}

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }
fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

struct RhoResult {
    rho_pct: int
    rho: float
    phi_a: float
    phi_b: float
    phi_merged: float
    sum_micro: float
    delta: float
    delta_pct: float       // delta / sum_micro
    super_additive: bool
}

fn _measure_rho(states_a: int, rho_pct: int, n: int, dim: int, warm: int, nbins: int) -> RhoResult {
    let states_b = _build_B(states_a, n, dim, rho_pct, warm)
    let phi_a = c_measure_phi(states_a, n, dim, nbins)
    let phi_b = c_measure_phi(states_b, n, dim, nbins)
    let merged = _build_merged(states_a, states_b, n, dim)
    let phi_merged = c_measure_phi(merged, 2 * n, dim, nbins)
    let sum_micro = phi_a + phi_b
    let delta = phi_merged - sum_micro
    let delta_pct = if sum_micro > 0.000001 { delta / sum_micro } else { 0.0 }
    let super_add = delta_pct >= 0.05  // ≥ +5% super-additive threshold
    let _ = farr_free(states_b)
    let _ = farr_free(merged)
    let rho_val = (rho_pct * 1.0) / 100.0
    return RhoResult(rho_pct, rho_val, phi_a, phi_b, phi_merged, sum_micro, delta, delta_pct, super_add)
}

