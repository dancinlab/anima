// UNIVERSE/state/h649_collective_register_collapse_phi_2026_05_28/run_h649.hexa
// H_649 — collective-register-collapse-phi (H_633 collective 일반화 · raw#12).
//
//   PREDECESSOR — H_633 (PR #1219, 🟡 PARTIAL · cliff REFUTED):
//     SINGLE-substrate register collapse (coh < 0.10) 가 big-Φ cliff 와
//     동조하지 않음 — Pearson r(coh, Φ) = 0.307, ratio Φlo/Φhi = 0.895 ≈ 1
//     (cliff 부재). "register collapse ⊥ Φ-cliff" 의 single-substrate 결론.
//
//   QUESTION (collective generalization):
//     다중 substrate (M=2~3 stream) 의 COLLECTIVE coherence 가 0.10 미만으로
//     무너져도 COLLECTIVE-Φ 가 cliff 없이 유지되는가? 즉 단일 substrate 에서
//     관측된 "coh ⊥ Φ-cliff" 가 multi-substrate collective level 에서도
//     성립하나, 아니면 collective level 에서는 cliff 가 발생하나?
//
//   가설: multi-substrate collective coherence < 0.10 영역에서도
//     collective-Φ 가 유지 (cliff 없음) — r(coh_collective, Φ_collective) < 0.5.
//   Falsifier: collective 에서는 coh<0.10 시 Φ_collective cliff 발생 (r>0.5).
//
//   METHOD (deterministic · hexa-only · $0 mac local · llm:none):
//     - SUBSTRATE = M ∈ {2, 3} Kuramoto sub-populations (streams), each N
//       oscillators (H_207/H_633 sister substrate). Sub-population p evolves
//       under intra-coupling K_intra; cross-population coupling K_cross gates
//       inter-stream phase interaction (collective binding strength).
//         dθ_i/dt = ω_i + (K_intra/N_p) Σ_{j∈pop(i)} sin(θ_j−θ_i)
//                        + (K_cross/N_tot) Σ_{j∉pop(i)} sin(θ_j−θ_i)
//     - COLLECTIVE COHERENCE = global Kuramoto order parameter over ALL
//       M×N pooled oscillators:  coh_c = |Σ_{all j} exp(iθ_j)| / N_tot ∈ [0,1].
//       (collective register: streams 가 상호 phase-lock 실패하면 collective
//       coherence collapse → coh_c → 0; 전체 lock 이면 coh_c → 1.)
//     - COLLECTIVE Φ = phi_spatial over the JOINED trajectory of all M×N
//       cells (c_measure_phi(traj_all, N_tot, dim, n_bins), RFC 036 byte-equal
//       phi_rs replica). H_633 과 동일 Φ measure → 직접 비교 가능.
//     - SWEEP: M ∈ {2,3} × K_cross grid (incoherent → fully bound) × K_intra
//       × ω_std × phase-offset → collective (coh_c, Φ_c) ensemble 가 low /
//       mid / high collective coherence 를 wide span. coh_c<0.10 영역 dense.
//     - COLLECT (coh_c, Φ_c) pairs → Pearson r + coh_c<0.10 region mean/max Φ_c
//       + 전역 Φ_c envelope + min-coh member.
//
//   CONTRAST: H_633 single (r=0.307, ratio 0.895, cliff 부재) 직접 비교.
//   CROSS-LINK: H_609/H_635 (collective-Φ super-additivity / cohort) ·
//     H_287 (Φ ⊥ Shannon entropy) · H_207 (Kuramoto edge-of-sync Φ).
//
//   Φ primitive: imported READ-ONLY from HEXAD/C/c_lib.hexa
//     (c_measure_phi → phi_spatial, RFC 036 byte-equal phi_rs replica).
// ════════════════════════════════════════════════════════════════════════
import "/tmp/u-h649b/HEXAD/C/c_lib.hexa"

// ── config (deterministic) ──────────────────────────────────────────────
fn _NP() -> int     { return 8 }       // # oscillators per sub-population (stream)
fn _STEPS() -> int  { return 100 }     // Euler integration steps
fn _WARM() -> int   { return 60 }      // warmup before recording trajectory
fn _DIM() -> int    { return 12 }      // recorded trajectory length / osc
fn _NBINS() -> int  { return 4 }       // bin count per cos θ axis (RFC 036)

fn _dt() -> float    { return 0.05 }
fn _two_pi() -> float { return 6.283185307179586 }

// collective-coherence-collapse threshold (COFFESHOP register-hit gate, lifted
// to the multi-substrate collective level).
fn _COH_LO() -> float { return 0.10 }

fn _abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

// 5 deterministic z-quantiles of N(0,1) (cycled by i%5), scaled by per-seed
// ω_std and offset per sub-population — gives wide collective-coh span. A
// per-population phase index shift further decorrelates streams (so streams
// can fail to mutually lock = collective register collapse at low K_cross).
fn _omega_i(i: int, omega_std: float) -> float {
    let q = i % 5
    let mut z = 0.0
    if q == 0 { z = 0.0 - 1.28 }
    if q == 1 { z = 0.0 - 0.52 }
    if q == 2 { z = 0.0 }
    if q == 3 { z = 0.52 }
    if q == 4 { z = 1.28 }
    return z * omega_std
}

// deterministic initial phase: uniform spread on [0,2π) by global index, plus a
// per-population offset (pop p shifted by p * pop_phase_gap) + per-seed offset.
fn _theta0_global(g: int, n_tot: int, pop: int, pop_phase_gap: float, phase_off: float) -> float {
    return _two_pi() * (g * 1.0) / (n_tot * 1.0) + (pop * 1.0) * pop_phase_gap + phase_off
}

// run M-population Kuramoto for given params; record per-osc trajectory of
// `dim` cos θ snapshots after `warm` steps over ALL n_tot = M*NP oscillators.
// final θ copied into theta_out (length n_tot).
//   - intra-population coupling K_intra (within same stream)
//   - cross-population coupling K_cross (between streams = collective binding)
fn _run_multi_kuramoto(M: int, K_intra: float, K_cross: float,
                       omega_std: float, pop_phase_gap: float, phase_off: float,
                       theta_out: int) -> int {
    let np = _NP()
    let n_tot = M * np
    let dim = _DIM()
    let warm = _WARM()
    let steps = _STEPS()
    let dt = _dt()

    let theta = farr_zeros(n_tot)
    let mut i = 0
    while i < n_tot {
        let pop = i / np
        farr_set(theta, i, _theta0_global(i, n_tot, pop, pop_phase_gap, phase_off))
        i = i + 1
    }

    let states = farr_zeros(n_tot * dim)

    let mut s = 0
    while s < steps {
        if s >= warm {
            let t = s - warm
            if t < dim {
                let mut k = 0
                while k < n_tot {
                    farr_set(states, k * dim + t, cos(farr_get(theta, k)))
                    k = k + 1
                }
            }
        }
        let next = farr_zeros(n_tot)
        let mut a = 0
        while a < n_tot {
            let theta_a = farr_get(theta, a)
            let pop_a = a / np
            let mut intra_sum = 0.0
            let mut cross_sum = 0.0
            let mut b = 0
            while b < n_tot {
                let theta_b = farr_get(theta, b)
                let pop_b = b / np
                let coupling = sin(theta_b - theta_a)
                if pop_b == pop_a {
                    intra_sum = intra_sum + coupling
                }
                if pop_b != pop_a {
                    cross_sum = cross_sum + coupling
                }
                b = b + 1
            }
            let omega_a = _omega_i(a, omega_std)
            let dtheta = omega_a
                + (K_intra / (np * 1.0)) * intra_sum
                + (K_cross / (n_tot * 1.0)) * cross_sum
            farr_set(next, a, theta_a + dt * dtheta)
            a = a + 1
        }
        let mut k = 0
        while k < n_tot { farr_set(theta, k, farr_get(next, k)); k = k + 1 }
        farr_free(next)
        s = s + 1
    }
    let mut m = 0
    while m < n_tot { farr_set(theta_out, m, farr_get(theta, m)); m = m + 1 }
    farr_free(theta)
    return states
}

// COLLECTIVE coherence = global Kuramoto order parameter over ALL pooled
// oscillators  coh_c = |Σ_all exp(iθ)| / n_tot  ∈ [0,1].
fn _collective_order_param(theta: int, n_tot: int) -> float {
    let mut C = 0.0
    let mut S = 0.0
    let mut i = 0
    while i < n_tot {
        let t = farr_get(theta, i)
        C = C + cos(t)
        S = S + sin(t)
        i = i + 1
    }
    return sqrt(C * C + S * S) / (n_tot * 1.0)
}

// per ensemble member → (coh_collective, Φ_collective).
fn _measure_coh_phi(M: int, K_intra: float, K_cross: float,
                    omega_std: float, pop_phase_gap: float, phase_off: float) -> int {
    let np = _NP()
    let n_tot = M * np
    let dim = _DIM()
    let theta_final = farr_zeros(n_tot)
    let traj = _run_multi_kuramoto(M, K_intra, K_cross, omega_std,
                                   pop_phase_gap, phase_off, theta_final)
    let coh = _collective_order_param(theta_final, n_tot)
    let phi = c_measure_phi(traj, n_tot, dim, _NBINS())
    farr_free(traj)
    farr_free(theta_final)
    let out = farr_zeros(2)
    farr_set(out, 0, coh)
    farr_set(out, 1, phi)
    return out
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict_pf(b: bool) -> string  { if b { return "PASS" }; return "FAIL" }

// ── ensemble sweep ──────────────────────────────────────────────────────
//   M ∈ {2,3} streams
//   K_cross grid: fine on incoherent → bound region (collective coh<0.10 lives
//     at low K_cross where streams fail to mutually lock = collective register
//     collapse)
//   K_intra: 2 levels (streams internally ordered or not)
//   ω_std seeds: wider spread = lower coherence
//   pop_phase_gap + phase offsets: decorrelate streams
fn main() {
    println("H_649 — collective-register-collapse-phi (H_633 collective 일반화 · raw#12)")
    println("  substrate: M={2,3} Kuramoto streams · NP=8/stream · coh_c = global order param")
    println("  Φ_c: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (byte-equal phi_rs replica)")
    println("  collective coh-collapse threshold (COFFESHOP register-hit lifted): coh_c < 0.10")
    println("")

    // M grid — 2 and 3 streams.
    let n_m = 2
    let m_grid = farr_zeros(n_m)
    farr_set(m_grid, 0, 2.0)
    farr_set(m_grid, 1, 3.0)

    // K_cross grid — dense near 0 (collective register collapse), out to bound.
    let n_kc = 9
    let kc_grid = farr_zeros(n_kc)
    farr_set(kc_grid, 0, 0.0)
    farr_set(kc_grid, 1, 0.1)
    farr_set(kc_grid, 2, 0.25)
    farr_set(kc_grid, 3, 0.5)
    farr_set(kc_grid, 4, 1.0)
    farr_set(kc_grid, 5, 1.5)
    farr_set(kc_grid, 6, 2.5)
    farr_set(kc_grid, 7, 4.0)
    farr_set(kc_grid, 8, 6.0)

    // K_intra grid — 2 levels.
    let n_ki = 2
    let ki_grid = farr_zeros(n_ki)
    farr_set(ki_grid, 0, 0.3)
    farr_set(ki_grid, 1, 2.0)

    // ω_std seeds — wider spread frustrates sync → broadens low-coh tail.
    let n_w = 2
    let w_grid = farr_zeros(n_w)
    farr_set(w_grid, 0, 0.5)
    farr_set(w_grid, 1, 2.0)

    // per-population phase gap + per-seed phase offset — decorrelate streams.
    let n_p = 2
    let pg_grid = farr_zeros(n_p)
    farr_set(pg_grid, 0, 0.0)
    farr_set(pg_grid, 1, 2.1)
    let po_grid = farr_zeros(n_p)
    farr_set(po_grid, 0, 0.0)
    farr_set(po_grid, 1, 0.7)

    // n_total = 2 M × 9 Kc × 2 Ki × 2 ωstd × 2 (gap=offset paired) = 144
    let n_total = n_m * n_kc * n_ki * n_w * n_p
    let coh_arr = farr_zeros(n_total)
    let phi_arr = farr_zeros(n_total)

    println("  ensemble (coh_c, Φ_c) pairs (n=" + str(n_total) + "):")
    let mut idx = 0
    let mut im = 0
    while im < n_m {
        let Mf = farr_get(m_grid, im)
        let M = int(Mf)
        let mut ikc = 0
        while ikc < n_kc {
            let Kc = farr_get(kc_grid, ikc)
            let mut iki = 0
            while iki < n_ki {
                let Ki = farr_get(ki_grid, iki)
                let mut iw = 0
                while iw < n_w {
                    let ws = farr_get(w_grid, iw)
                    let mut ip = 0
                    while ip < n_p {
                        let pg = farr_get(pg_grid, ip)
                        let po = farr_get(po_grid, ip)
                        let cp = _measure_coh_phi(M, Ki, Kc, ws, pg, po)
                        let coh = farr_get(cp, 0)
                        let phi = farr_get(cp, 1)
                        farr_free(cp)
                        farr_set(coh_arr, idx, coh)
                        farr_set(phi_arr, idx, phi)
                        idx = idx + 1
                        ip = ip + 1
                    }
                    iw = iw + 1
                }
                iki = iki + 1
            }
            ikc = ikc + 1
        }
        im = im + 1
    }

    // ── Pearson r(coh_c, Φ_c) ───────────────────────────────────────────
    let mut sum_c = 0.0
    let mut sum_p = 0.0
    let mut i = 0
    while i < n_total {
        sum_c = sum_c + farr_get(coh_arr, i)
        sum_p = sum_p + farr_get(phi_arr, i)
        i = i + 1
    }
    let mean_c = sum_c / (n_total * 1.0)
    let mean_p = sum_p / (n_total * 1.0)

    let mut s_cc = 0.0
    let mut s_pp = 0.0
    let mut s_cp = 0.0
    let mut j = 0
    while j < n_total {
        let dc = farr_get(coh_arr, j) - mean_c
        let dp = farr_get(phi_arr, j) - mean_p
        s_cc = s_cc + dc * dc
        s_pp = s_pp + dp * dp
        s_cp = s_cp + dc * dp
        j = j + 1
    }
    let denom = sqrt(s_cc * s_pp)
    let mut pearson = 0.0
    if denom > 0.0 { pearson = s_cp / denom }

    // ── coh_c < 0.10 region behaviour ───────────────────────────────────
    let mut n_lo = 0
    let mut sum_phi_lo = 0.0
    let mut max_phi_lo = 0.0
    let mut n_hi = 0
    let mut sum_phi_hi = 0.0
    let mut min_coh = 2.0
    let mut phi_at_min_coh = 0.0
    let mut max_coh = 0.0 - 1.0
    let mut phi_at_max_coh = 0.0
    let mut g = 0
    while g < n_total {
        let coh = farr_get(coh_arr, g)
        let phi = farr_get(phi_arr, g)
        if coh < _COH_LO() {
            n_lo = n_lo + 1
            sum_phi_lo = sum_phi_lo + phi
            if phi > max_phi_lo { max_phi_lo = phi }
        }
        if coh >= _COH_LO() {
            n_hi = n_hi + 1
            sum_phi_hi = sum_phi_hi + phi
        }
        if coh < min_coh { min_coh = coh; phi_at_min_coh = phi }
        if coh > max_coh { max_coh = coh; phi_at_max_coh = phi }
        g = g + 1
    }
    let mut mean_phi_lo = 0.0
    if n_lo > 0 { mean_phi_lo = sum_phi_lo / (n_lo * 1.0) }
    let mut mean_phi_hi = 0.0
    if n_hi > 0 { mean_phi_hi = sum_phi_hi / (n_hi * 1.0) }

    // overall Φ_c envelope
    let mut min_phi_all = 1.0e18
    let mut max_phi_all = 0.0 - 1.0e18
    let mut q = 0
    while q < n_total {
        let phi = farr_get(phi_arr, q)
        if phi < min_phi_all { min_phi_all = phi }
        if phi > max_phi_all { max_phi_all = phi }
        q = q + 1
    }

    // ── print ensemble (coh_c, Φ_c) in sweep order ──────────────────────
    let mut pr = 0
    while pr < n_total {
        let coh = farr_get(coh_arr, pr)
        let phi = farr_get(phi_arr, pr)
        let mark = "       "
        if coh < _COH_LO() { mark = " [LO] " }
        println("    [" + str(pr) + "] coh_c=" + str(coh) + "  Φ_c=" + str(phi) + mark)
        pr = pr + 1
    }
    println("")

    // ── criteria ────────────────────────────────────────────────────────
    // C1 (collective correlation): Pearson |r| > 0.5.
    // C2 (collective cliff): mean Φ_c in coh_c<0.10 region < 0.20 × mean Φ_c
    //     in coh_c≥0.10 (steep collective drop / near-collapse).
    // F-NOCORR: |r| < 0.3 (collective coh ⊥ Φ_c — H_633 single 결과의 collective 확장).
    // F-SUSTAIN: mean_phi_lo ≥ mean_phi_hi (collective Φ NOT dropping under low
    //     collective coherence — collective register collapse decoupled from Φ_c).
    let c1 = (_abs_f(pearson) > 0.5)
    let mut ratio_lo_hi = 1.0
    if mean_phi_hi > 0.0 { ratio_lo_hi = mean_phi_lo / mean_phi_hi }
    let c2 = (n_lo > 0) && (ratio_lo_hi < 0.20)

    let f_nocorr = (_abs_f(pearson) < 0.3)
    let f_sustain = (n_lo > 0) && (mean_phi_lo >= mean_phi_hi)
    let no_lo_members = (n_lo == 0)

    println("  n total pairs        : " + str(n_total))
    println("  n coh_c<0.10 (LO)    : " + str(n_lo))
    println("  n coh_c>=0.10 (HI)   : " + str(n_hi))
    println("  mean coh_c           : " + str(mean_c))
    println("  mean Φ_c             : " + str(mean_p))
    println("  Φ_c envelope [min,max] : [" + str(min_phi_all) + ", " + str(max_phi_all) + "]")
    println("  ----")
    println("  Pearson r(coh_c, Φ_c) : " + str(pearson))
    println("  mean Φ_c | coh_c<0.10 : " + str(mean_phi_lo))
    println("  max  Φ_c | coh_c<0.10 : " + str(max_phi_lo))
    println("  mean Φ_c | coh_c>=0.10: " + str(mean_phi_hi))
    println("  ratio (lo / hi mean)  : " + str(ratio_lo_hi))
    println("  min-coh member        : coh_c=" + str(min_coh) + "  Φ_c=" + str(phi_at_min_coh))
    println("  max-coh member        : coh_c=" + str(max_coh) + "  Φ_c=" + str(phi_at_max_coh))
    println("  ----")
    println("  C1 |r| > 0.5            : " + _verdict_pf(c1) + "  (r=" + str(pearson) + ")")
    println("  C2 cliff (lo/hi < 0.20) : " + _verdict_pf(c2) + "  (ratio=" + str(ratio_lo_hi) + ")")
    println("  F-NOCORR |r| < 0.3      : " + _bool_str(f_nocorr))
    println("  F-SUSTAIN Φlo >= Φhi    : " + _bool_str(f_sustain))
    println("  (no coh_c<0.10 members?): " + _bool_str(no_lo_members))
    println("")

    // ── verdict ──────────────────────────────────────────────────────────
    // 가설 (cliff 없음 · r<0.5) SUPPORTED iff (|r| < 0.5 ∧ NOT collective-cliff).
    // 본 H 의 1차 결론 형식은 H_633 과 동일 verdict_rule 사용:
    //   SUPPORTED-NUMERICAL (collective cliff 존재 = falsifier 입증) iff C1 ∧ C2.
    //   FALSIFIED (collective cliff falsifier) iff F-NOCORR ∨ F-SUSTAIN
    //     → 즉 가설(cliff 없음)이 SUPPORTED 되고 falsifier(cliff)는 REFUTED.
    // (verdict label 은 H_633 schema 와 일관 — 본 H 가설은 "cliff 없음" 이므로
    //  FALSIFIED/PARTIAL label = 가설-지지 방향. §10 verdict 에서 명시 해석.)
    let cliff_supported = c1 && c2 && (no_lo_members == false)
    let cliff_falsified = f_nocorr || f_sustain
    let mut verdict = "PARTIAL"
    if cliff_supported { verdict = "SUPPORTED-NUMERICAL" }
    if cliff_falsified { verdict = "FALSIFIED" }
    if cliff_falsified { verdict = "FALSIFIED" }

    println("  VERDICT_RULE: cliff-SUPPORTED iff (|r|>0.5 ∧ lo/hi<0.20); cliff-FALSIFIED iff (|r|<0.3 ∨ Φlo>=Φhi)")
    println("  VERDICT (cliff falsifier frame): " + verdict)
    println("=== H_649 collective-register-collapse-phi complete: " + verdict + " ===")

    farr_free(m_grid)
    farr_free(kc_grid)
    farr_free(ki_grid)
    farr_free(w_grid)
    farr_free(pg_grid)
    farr_free(po_grid)
    farr_free(coh_arr)
    farr_free(phi_arr)
}
