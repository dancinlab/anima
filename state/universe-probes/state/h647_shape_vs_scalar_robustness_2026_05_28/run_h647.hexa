// ════════════════════════════════════════════════════════════════════════════
//  run_h647.hexa — H_647 dΦ/dI shape vs Φ scalar — SEED-robustness 각도
//
//  CORE QUESTION (메타-발견 seed-robustness 축)
//    round-6 메타-발견 = "shape > scalar substrate-class robustness".
//    H_642 (cross-RULE peak) 가 다른 축에서 검정 중. 본 H_647 은 *다른 축* —
//    cross-SEED perturbation robustness:
//      shape feature  = dΦ/dI 의 peak 위치 (argmax_I |dΦ/dI|)
//      scalar feature = Φ magnitude (baseline I=0 의 mean big-Φ)
//    가설: 같은 rule × 다른 random seed (N≥10) 에서
//      peak 위치의 (절대) std  <  Φ magnitude 의 상대 std (CV).
//    즉 shape 는 seed 변동에 robust, scalar 는 seed-sensitive.
//
//  SUBSTRATE & SEED PERTURBATION
//    fixed ECA rule 110 (Wolfram class IV, edge-of-chaos, H_285/H_351 anchor)
//    on a periodic ring of n=4 cells. faithful causal big-Φ (iit4_eca +
//    iit4_bigphi), 2^n=16-state mean (single-state fragility 회피, H_285 양식).
//
//    "random seed" = per-state multiplicative inhibition JITTER 의 random
//    realization. 각 seed s 마다 deterministic LCG(seed) 로 per-state jitter
//    j[k] ∈ [1 - A, 1 + A] (A = jitter amplitude) 를 뽑아 base TPM 에 곱한 뒤
//    [0,1] clamp:
//       tpm_seed[k] = clamp( eca_tpm[k] * j[k], 0, 1 )
//    그런 다음 inhibition I 를 H_351 과 동일하게 mixing:
//       tpm_mixed[k] = (1 - I) * tpm_seed[k]
//    seed 는 substrate 의 random realization (microscopic 변동) 을 모사 —
//    shape(peak 위치) 가 이 변동에 robust 한지 vs scalar(Φ 값) 가 sensitive
//    한지를 검정한다. I=0 의 tpm_seed 자체가 그 seed 의 "baseline substrate".
//
//  PER-SEED PROCEDURE
//    for each seed in {0 .. N-1}:
//      1. build tpm_seed (per-state jitter)
//      2. I-sweep grid → Φ(I) → dΦ/dI (central finite diff)
//      3. peak_I[seed]  = argmax_I |dΦ/dI|          (SHAPE feature)
//      4. phi0[seed]    = Φ(I=0)                     (SCALAR feature, baseline)
//
//  SHAPE vs SCALAR ROBUSTNESS METRICS
//    peak_std   = std( peak_I[·] )                    절대 std (위치, 단위 I)
//    phi0_mean  = mean( phi0[·] )
//    phi0_std   = std( phi0[·] )
//    phi0_cv    = phi0_std / phi0_mean                상대 std (scalar)
//    SHAPE>SCALAR 확증 = peak_std < phi0_cv
//    (peak_I 자체가 [0,1] 정규화 좌표이므로 절대-std 와 CV 비교가 동차 가능)
//    부차 보조 지표: peak_cv = peak_std / mean(peak_I) — 동일-단위 cross-check.
//
//  GRID (H_351 양식, dense near GZ region)
//    I ∈ {0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
//         0.50, 0.70, 0.95}                                   — 13 points
//
//  PRE-REGISTERED FALSIFIERS (측정 전 동결)
//    F1 SHAPE-ROBUST  : peak_std  <  phi0_cv             (핵심 — shape>scalar)
//    F2 SHAPE-TIGHT   : peak_std  ≤  0.05                (peak 위치 절대 안정)
//    F3 SCALAR-VARIES : phi0_cv   >  0                   (scalar 가 실제로 변동)
//    F4 N-SUFFICIENT  : N ≥ 10                           (표본 충분)
//    F5 BYTE-EQUAL    : in-process recompute byte-identical (RFC 033)
//
//    verdict_rule
//      SUPPORTED = F1 ∧ F2 ∧ F3 ∧ F4 ∧ F5      (shape>scalar 확증)
//      PARTIAL   = F1 ∧ (!F2) ∧ F3 ∧ F4 ∧ F5   (shape>scalar 但 절대-안정 미달)
//      FALSIFIED = !F1 (peak_std ≥ phi0_cv — shape 도 seed-sensitive)
//
//  $0 · mac-local · hexa-only · LLM none · NO ckpt · deterministic (LCG).
// ════════════════════════════════════════════════════════════════════════════

import "/tmp/u-h647b/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"


fn _rule() -> int   { return 110 }
fn _n() -> int      { return 4 }
fn _nseed() -> int  { return 12 }       // N=12 ≥ 10
fn _jitter() -> float { return 0.30 }   // jitter amplitude A (per-state ±30%)
fn _tight_tol() -> float { return 0.05 }


// deterministic LCG (Numerical Recipes constants) → uint state stream
fn _lcg_next(state: int) -> int {
    return (state * 1664525 + 1013904223) % 2147483648
}

// map an LCG state to a float in [0,1)
fn _lcg_unit(state: int) -> float {
    return to_float(state) / 2147483648.0
}

// clamp x to [0,1]
fn _clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}


// build the per-seed jittered baseline TPM:
//   tpm_seed[k] = clamp( eca_tpm[k] * (1 + A*(2u-1)) , 0, 1 ),  u ~ LCG(seed)
fn seed_tpm(rule: int, n: int, seed: int, amp: float) -> array {
    let base = eca_tpm(rule, n)
    let total = len(base)
    let mut out = []
    // seed the LCG; advance a few times to decorrelate small seeds
    let mut lcg = _lcg_next(_lcg_next(seed * 2654435761 + 12345))
    let mut k = 0
    while k < total {
        lcg = _lcg_next(lcg)
        let u = _lcg_unit(lcg)                 // u ∈ [0,1)
        let factor = 1.0 + amp * (2.0 * u - 1.0)   // ∈ [1-A, 1+A]
        out = out.push(_clamp01(base[k] * factor))
        k = k + 1
    }
    return out
}


// apply inhibition I mixing to an already-built (seed) TPM (H_351 mapping):
//   tpm_mixed[k] = (1 - I) * tpm_seed[k]
fn inhibit_mix(tpm_seed: array, inhibit: float) -> array {
    let scale = 1.0 - inhibit
    let total = len(tpm_seed)
    let mut out = []
    let mut k = 0
    while k < total {
        out = out.push(tpm_seed[k] * scale)
        k = k + 1
    }
    return out
}


// average big-Φ over all 2^n states (H_285 양식).
fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}


// dΦ/dI peak: returns the I value (grid coordinate) at argmax |dΦ/dI|.
fn peak_I_of(grid: array, phi: array) -> float {
    let m = len(grid)
    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }
    let mut peak_idx = 0
    let mut peak_mag = _abs(dphi[0])
    let mut q = 1
    while q < m {
        let mag = _abs(dphi[q])
        if mag > peak_mag {
            peak_mag = mag
            peak_idx = q
        }
        q = q + 1
    }
    return grid[peak_idx]
}


// mean of a float array
fn _mean(xs: array) -> float {
    let total = len(xs)
    let mut acc = 0.0
    let mut i = 0
    while i < total {
        acc = acc + xs[i]
        i = i + 1
    }
    return acc / to_float(total)
}

// population std of a float array
fn _std(xs: array) -> float {
    let total = len(xs)
    let mu = _mean(xs)
    let mut acc = 0.0
    let mut i = 0
    while i < total {
        let d = xs[i] - mu
        acc = acc + d * d
        i = i + 1
    }
    let var = acc / to_float(total)
    return sqrt(var)
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_647 dΦ/dI shape vs Φ scalar — seed-robustness, rule 110 n=4")
    println("════════════════════════════════════════════════════════════")

    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]
    let m = len(grid)
    let nseed = _nseed()

    let mut peak_arr = []     // SHAPE feature per seed
    let mut phi0_arr = []     // SCALAR feature per seed (Φ at I=0)

    println("── per-seed (peak_I = SHAPE, Φ0 = SCALAR) ──")
    let mut sd = 0
    while sd < nseed {
        let tseed = seed_tpm(_rule(), _n(), sd, _jitter())

        // scalar baseline: Φ at I=0 (no inhibition mixing → tseed itself)
        let phi0 = mean_big_phi(tseed, _n())
        phi0_arr = phi0_arr.push(phi0)

        // I-sweep for this seed → Φ(I)
        let mut phi = []
        let mut i = 0
        while i < m {
            let tmix = inhibit_mix(tseed, grid[i])
            phi = phi.push(mean_big_phi(tmix, _n()))
            i = i + 1
        }
        let pk = peak_I_of(grid, phi)
        peak_arr = peak_arr.push(pk)

        println("  seed=" + str(sd) + "  peak_I=" + str(pk) + "  Φ0=" + str(phi0))
        sd = sd + 1
    }

    // ── byte-equal recompute (F5): redo seed 0 ─────────────────────────
    let t0a = seed_tpm(_rule(), _n(), 0, _jitter())
    let t0b = seed_tpm(_rule(), _n(), 0, _jitter())
    let phi0a = mean_big_phi(t0a, _n())
    let phi0b = mean_big_phi(t0b, _n())
    let byte_eq = _abs(phi0a - phi0b) <= 1.0e-12

    // ── robustness metrics ─────────────────────────────────────────────
    let peak_mean = _mean(peak_arr)
    let peak_std  = _std(peak_arr)
    let phi0_mean = _mean(phi0_arr)
    let phi0_std  = _std(phi0_arr)
    let mut phi0_cv = 0.0
    if phi0_mean > 1.0e-12 { phi0_cv = phi0_std / phi0_mean }
    let mut peak_cv = 0.0
    if peak_mean > 1.0e-12 { peak_cv = peak_std / peak_mean }

    // ── falsifiers ─────────────────────────────────────────────────────
    let f1 = peak_std < phi0_cv
    let f2 = peak_std <= _tight_tol()
    let f3 = phi0_cv > 0.0
    let f4 = nseed >= 10
    let f5 = byte_eq

    let supported = f1 && f2 && f3 && f4 && f5
    let partial   = f1 && (!f2) && f3 && f4 && f5
    let falsified = !f1

    let mut verdict_str = "UNKNOWN"
    if supported { verdict_str = "SUPPORTED" }
    if partial   { verdict_str = "PARTIAL" }
    if falsified { verdict_str = "FALSIFIED" }

    println("")
    println("── robustness verdict ──")
    println("  N seeds      = " + str(nseed))
    println("  peak_I mean  = " + str(peak_mean))
    println("  peak_I std   = " + str(peak_std) + "   (SHAPE, abs)")
    println("  peak_I cv    = " + str(peak_cv))
    println("  Φ0 mean      = " + str(phi0_mean))
    println("  Φ0 std       = " + str(phi0_std))
    println("  Φ0 cv        = " + str(phi0_cv) + "   (SCALAR, rel)")
    println("  byte_eq      = " + str(byte_eq))
    println("")
    println("  F1 SHAPE-ROBUST   (peak_std < phi0_cv) = " + str(f1))
    println("  F2 SHAPE-TIGHT    (peak_std <= 0.05)   = " + str(f2))
    println("  F3 SCALAR-VARIES  (phi0_cv > 0)        = " + str(f3))
    println("  F4 N-SUFFICIENT   (N >= 10)            = " + str(f4))
    println("  F5 BYTE-EQUAL                          = " + str(f5))
    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    // ── result.json ────────────────────────────────────────────────────
    let mut out = "{\n"
    out = out + "  \"hypothesis\": \"H_647\",\n"
    out = out + "  \"slug\": \"dphi-shape-vs-phi-scalar-robustness\",\n"
    out = out + "  \"rule\": 110,\n"
    out = out + "  \"n\": 4,\n"
    out = out + "  \"nseed\": " + str(nseed) + ",\n"
    out = out + "  \"jitter_amp\": " + str(_jitter()) + ",\n"
    out = out + "  \"peak_I\": ["
    let mut pi = 0
    while pi < nseed {
        if pi > 0 { out = out + ", " }
        out = out + str(peak_arr[pi])
        pi = pi + 1
    }
    out = out + "],\n"
    out = out + "  \"phi0\": ["
    let mut qi = 0
    while qi < nseed {
        if qi > 0 { out = out + ", " }
        out = out + str(phi0_arr[qi])
        qi = qi + 1
    }
    out = out + "],\n"
    out = out + "  \"peak_mean\": " + str(peak_mean) + ",\n"
    out = out + "  \"peak_std\": " + str(peak_std) + ",\n"
    out = out + "  \"peak_cv\": " + str(peak_cv) + ",\n"
    out = out + "  \"phi0_mean\": " + str(phi0_mean) + ",\n"
    out = out + "  \"phi0_std\": " + str(phi0_std) + ",\n"
    out = out + "  \"phi0_cv\": " + str(phi0_cv) + ",\n"
    out = out + "  \"byte_eq\": " + str(byte_eq) + ",\n"
    out = out + "  \"f1_shape_robust\": " + str(f1) + ",\n"
    out = out + "  \"f2_shape_tight\": " + str(f2) + ",\n"
    out = out + "  \"f3_scalar_varies\": " + str(f3) + ",\n"
    out = out + "  \"f4_n_sufficient\": " + str(f4) + ",\n"
    out = out + "  \"f5_byte_equal\": " + str(f5) + ",\n"
    out = out + "  \"verdict\": \"" + verdict_str + "\"\n"
    out = out + "}\n"

    write_file("UNIVERSE/state/h647_shape_vs_scalar_robustness_2026_05_28/result.json", out)
    println("wrote result.json")
}
