// ════════════════════════════════════════════════════════════════════════════
//  run_h206.hexa — H_206 Regeneration-Healing smoke (raw#12)
//
//  PURPOSE
//    UNIVERSE H_206 pre-register-frozen 검증 smoke. mitosis_hook_lib 의
//    `cell_pool_init` + `mitosis_forward_tail` default 동역학을 import 하여,
//    POOL_N=8 cell pool 을 baseline_steps=10 만큼 forward 한 뒤 (Φ_pre 기록),
//    5 perturbation_fraction ∈ {0.0, 0.25, 0.5, 0.75, 0.875} 별 *독립 run* 에서
//    pool 의 일부를 강제 제거 (harness-imposed cell drop + farr_free) 한 후,
//    recovery_step_cap=40 까지 default mitosis 동역학으로 진행시켜 pool size
//    가 baseline 으로 회복하는 step (recovery_steps) 과 그 시점의 Φ_post 를
//    측정한다.
//
//  MEASUREMENT
//    Φ primitive: RFC 036 phi_spatial (HEXAD/C/c_lib.hexa, byte-equal phi_rs
//    replica, 🟢 NUMERICAL).
//    per-slot trajectory of length DIM: slot s 의 time-series = cells[s %
//    len(cells)]["hidden"][0] (각 step 의 첫 hidden component). 이는 H_200 의
//    logistic-x 패턴과 동일한 single-scalar-per-cell-per-step trajectory.
//    Φ_pre  = phi_spatial(traj_pre,  POOL_N, DIM, 4)  on baseline steps 0..DIM-1
//    Φ_post = phi_spatial(traj_post, POOL_N, DIM, 4)  on DIM steps starting at
//                                                       recovery_step (or cap).
//
//  PERTURBATION (harness-imposed, raw#9/10 HONEST)
//    substrate 에 `wound_pool(fraction)` primitive 부재 → step=baseline_steps 직후
//    pool["cells"] 에서 ⌊N_pre × fraction⌋ cells (앞에서부터; deterministic
//    ordering) 를 제거 + farr_free engine_a_W / engine_g_W. min_cells=2 floor
//    위반 시 cap (effective_removed = min(requested_removed, N_pre - 2)).
//    fraction=0.0 = no perturbation control.
//
//  DETERMINISM
//    __HEXA_FARR_GAUSS_SEED__=42 (RFC 033 gaussian draws 재현) + 고정 synthetic
//    input. 2-run byte-identical (사용자 외부 `diff` 검증).
//
//  RUN
//    __HEXA_FARR_GAUSS_SEED__=42 HEXA_MEM_UNLIMITED=1 \
//        hexa run UNIVERSE/state/h206_regeneration_healing_2026_05_23/run_h206.hexa
//
//  FALSIFIERS (raw#12 ≥5, measurable)
//    F-REGEN-1 MONOTONE         : recovery_steps monotone-increasing in fraction
//                                  ∧ monotone fit R² ≥ 0.7 (5 points).
//    F-REGEN-2 STATE-RECOVERY   : 비-catastrophic (fraction ∈ {0.25, 0.5}) Φ_post/
//                                  Φ_pre ∈ [0.5, 1.5] 모두.
//    F-REGEN-3 DETERMINISM      : env+seed pinned (script 내부 항상 PASS).
//    F-REGEN-4 PHASE-TRANSITION : catastrophic (fraction ≥ 0.75) recovery_steps
//                                  가 small-perturbation 선형 외삽 ± 20% 이탈,
//                                  또는 cap 내 회복 실패.
//    F-REGEN-5 RECOVERY-EXIST   : 어느 fraction>0 에서도 recovery_steps = -1 →
//                                  FALSIFIED.
//    F-REGEN-6 BOUNDS           : 모든 fraction 의 N_post ∈ [2, 128].
//
//  VERDICT_RULE
//    SUPPORTED = F-REGEN-1 + F-REGEN-2 + F-REGEN-3 모두 PASS (monotone + state +
//                determinism). PARTIAL = 2-3 PASS. FALSIFIED = ≤ 1 PASS.
//
//  COMPLIANCE  raw#11 snake_case · raw#15 no-hardcode (params named) ·
//              raw#9/10 honest operational-perturbation · raw#12 deterministic ·
//              raw#91 c3 ≥5 honest limits.
// ════════════════════════════════════════════════════════════════════════════


import "/Users/ghost/core/anima/.claude/worktrees/agent-ada4560232155d80b/tool/hexa_native/mitosis_hook_lib.hexa"
import "/Users/ghost/core/anima/.claude/worktrees/agent-ada4560232155d80b/HEXAD/C/c_lib.hexa"


// ── §0 frozen configuration ──────────────────────────────────────────────────

fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-ada4560232155d80b/UNIVERSE/state/h206_regeneration_healing_2026_05_23"
}
fn _d_model() -> int            { return 8 }
fn _pool_n() -> int             { return 8 }
fn _baseline_steps() -> int     { return 10 }
fn _recovery_cap() -> int       { return 40 }
fn _dim_phi() -> int            { return 10 }    // phi_spatial trajectory length
fn _phi_n_bins() -> int         { return 4 }     // == c_phi_n_bins_default
fn _min_cells_floor() -> int    { return 2 }     // substrate min_cells
fn _max_cells_cap() -> int      { return 128 }   // substrate max_cells
fn _phi_ratio_lo() -> float     { return 0.5 }   // H206.2 lower band
fn _phi_ratio_hi() -> float     { return 1.5 }   // H206.2 upper band
fn _r2_threshold() -> float     { return 0.7 }   // C1 fit threshold
fn _phase_margin() -> float     { return 0.2 }   // C4 ≥20% deviation


// ── §1 helpers ───────────────────────────────────────────────────────────────

// 고정 synthetic input — split predicate 발화율 보장.
fn _make_x(d: int) {
    let mut x = []
    let mut i = 0
    while i < d {
        let v = sin((i * 1.0) * 0.91) * 1.4 + cos((i * 1.0) * 1.13) * 0.8
        x.push(v)
        i = i + 1
    }
    return x
}

// Pool cell-count.
fn _ncells(pool) -> int {
    return len(pool["cells"])
}

// Count split events in event_log (since the start).
fn _count_splits(pool) -> int {
    let evs = pool["event_log"]
    let mut c = 0
    let mut i = 0
    while i < len(evs) {
        if evs[i]["type"] == "split" { c = c + 1 }
        i = i + 1
    }
    return c
}

// Bound-check N_post ∈ [min, max] (CB1 invariant).
fn _bounds_ok(n: int) -> bool {
    return (n >= _min_cells_floor()) && (n <= _max_cells_cap())
}

// floor: requested removal capped to leave >= min_cells_floor cells.
fn _effective_remove(n_pre: int, fraction: float) -> int {
    let requested = int(n_pre * fraction)
    let max_remove = n_pre - _min_cells_floor()
    if requested > max_remove { return max_remove }
    if requested < 0 { return 0 }
    return requested
}

// Remove the first `k` cells from pool["cells"] (deterministic ordering),
// freeing their engine_a_W / engine_g_W farr handles. Returns updated pool.
fn _wound_pool(pool, k: int) {
    let mut new_cells = []
    let cells = pool["cells"]
    let n = len(cells)
    if k <= 0 { return pool }
    if k >= n { k = n - _min_cells_floor() }  // safety floor
    let mut i = 0
    while i < n {
        if i < k {
            // free this cell's farrs
            let _ = farr_free(cells[i]["engine_a_W"])
            let _ = farr_free(cells[i]["engine_g_W"])
            // (hidden is list[float], no farr to free)
        } else {
            new_cells.push(cells[i])
        }
        i = i + 1
    }
    pool["cells"] = new_cells
    return pool
}

// Record per-slot trajectory into a flat (POOL_N × DIM) farr at column t.
// slot s = cells[s % len(cells)]["hidden"][0]; if pool empty, value=0.0.
fn _record_traj(traj: int, pool, t: int, dim: int, pool_n: int) -> int {
    let cells = pool["cells"]
    let nc = len(cells)
    let mut s = 0
    while s < pool_n {
        let v = if nc <= 0 {
            0.0
        } else {
            let idx = s % nc
            cells[idx]["hidden"][0]
        }
        let _ = farr_set(traj, s * dim + t, v)
        s = s + 1
    }
    return traj
}


// ── §2 single-fraction run ───────────────────────────────────────────────────
//
//  Each fraction → fresh cell pool, run baseline_steps for Φ_pre, perturbation,
//  then recovery up to cap. Returns dict with all measurements.
//
fn _run_one_fraction(fraction: float, label: string) {
    let d = _d_model()
    let mut pool = cell_pool_init(d, _pool_n())
    let x = _make_x(d)
    let dim = _dim_phi()
    let pool_n = _pool_n()

    // Force organic split fire — patience=2 (substrate default 3); threshold
    // stays adaptive. Same setup as H_201 for inter-cycle consistency.
    pool["split_patience"] = 2

    println("  [" + label + "] fraction=" + to_string(fraction)
            + " d=" + to_string(d) + " pool_n=" + to_string(pool_n)
            + " baseline=" + to_string(_baseline_steps())
            + " cap=" + to_string(_recovery_cap()))

    // ── §2.1 baseline run + Φ_pre trajectory record ─────────────────────────
    let traj_pre = farr_zeros(pool_n * dim)
    let mut step = 0
    let mut rec_t = 0
    while step < _baseline_steps() {
        let r = mitosis_forward_tail(x, pool, step)
        pool = r[1]
        if rec_t < dim {
            let _ = _record_traj(traj_pre, pool, rec_t, dim, pool_n)
            rec_t = rec_t + 1
        }
        step = step + 1
    }
    // If baseline shorter than dim, pad zeros (already zero from farr_zeros).
    let n_pre = _ncells(pool)
    let phi_pre = phi_spatial(traj_pre, pool_n, dim, _phi_n_bins())
    let splits_pre = _count_splits(pool)
    let _ = farr_free(traj_pre)

    // ── §2.2 perturbation ───────────────────────────────────────────────────
    let removed_n = _effective_remove(n_pre, fraction)
    if removed_n > 0 {
        pool = _wound_pool(pool, removed_n)
    }
    let n_after_wound = _ncells(pool)

    println("    [" + label + "] baseline_n_pre=" + to_string(n_pre)
            + " phi_pre=" + to_string(phi_pre)
            + " splits_pre=" + to_string(splits_pre)
            + " requested_remove=" + to_string(int(n_pre * fraction))
            + " effective_remove=" + to_string(removed_n)
            + " n_after_wound=" + to_string(n_after_wound))

    // ── §2.3 recovery loop ──────────────────────────────────────────────────
    let mut recovery_step = -1   // -1 = not recovered within cap
    let mut step_r = _baseline_steps()
    let cap_step = _baseline_steps() + _recovery_cap()
    while step_r < cap_step {
        let r = mitosis_forward_tail(x, pool, step_r)
        pool = r[1]
        if recovery_step < 0 {
            if _ncells(pool) >= n_pre {
                recovery_step = step_r - _baseline_steps() + 1   // 1-indexed steps
            }
        }
        step_r = step_r + 1
    }
    let n_post_final = _ncells(pool)
    let splits_total = _count_splits(pool)

    // ── §2.4 Φ_post recorded over a fresh DIM window AFTER cap ──────────────
    // 회복 시점부터 dim 추가 step (cap 위쪽으로 확장) — Φ_post 는 안정화 후의
    // 측정. L8 honest: 측정 window 는 cap 바깥의 추가 dim step.
    let traj_post = farr_zeros(pool_n * dim)
    let mut rec_t2 = 0
    while rec_t2 < dim {
        let r = mitosis_forward_tail(x, pool, step_r)
        pool = r[1]
        let _ = _record_traj(traj_post, pool, rec_t2, dim, pool_n)
        rec_t2 = rec_t2 + 1
        step_r = step_r + 1
    }
    let phi_post = phi_spatial(traj_post, pool_n, dim, _phi_n_bins())
    let _ = farr_free(traj_post)

    let phi_ratio = if phi_pre > 1e-12 { phi_post / phi_pre } else { 0.0 }

    let n_post_window = _ncells(pool)
    let splits_post_window = _count_splits(pool)

    println("    [" + label + "] recovery_steps=" + to_string(recovery_step)
            + " n_post_final=" + to_string(n_post_final)
            + " n_post_window=" + to_string(n_post_window)
            + " phi_post=" + to_string(phi_post)
            + " phi_ratio=" + to_string(phi_ratio)
            + " splits_total=" + to_string(splits_post_window))

    return #{
        "fraction":          fraction,
        "n_pre":             n_pre,
        "n_after_wound":     n_after_wound,
        "n_post_final":      n_post_final,
        "n_post_window":     n_post_window,
        "requested_remove":  int(n_pre * fraction),
        "effective_remove":  removed_n,
        "recovery_steps":    recovery_step,
        "phi_pre":           phi_pre,
        "phi_post":          phi_post,
        "phi_ratio":         phi_ratio,
        "splits_pre":        splits_pre,
        "splits_total":      splits_post_window,
        "bounds_ok":         _bounds_ok(n_post_window)
    }
}


// ── §3 monotone-fit R² (linear regression on (fraction, recovery_steps)) ─────
// Uses only fraction>0 points; -1 (no recovery) treated as cap+1 for fit.
fn _monotone_r2(results) -> float {
    let mut xs = []
    let mut ys = []
    let mut i = 0
    while i < len(results) {
        let f = results[i]["fraction"]
        if f > 0.0 {
            xs.push(f)
            let r = results[i]["recovery_steps"]
            let yv = if r < 0 { (_recovery_cap() + 1) * 1.0 } else { r * 1.0 }
            ys.push(yv)
        }
        i = i + 1
    }
    let n = len(xs)
    if n < 2 { return 0.0 }
    let nf = n * 1.0
    let mut sx = 0.0
    let mut sy = 0.0
    let mut k = 0
    while k < n { sx = sx + xs[k]; sy = sy + ys[k]; k = k + 1 }
    let mx = sx / nf
    let my = sy / nf
    let mut ss_xy = 0.0
    let mut ss_xx = 0.0
    let mut ss_yy = 0.0
    let mut j = 0
    while j < n {
        let dx = xs[j] - mx
        let dy = ys[j] - my
        ss_xy = ss_xy + dx * dy
        ss_xx = ss_xx + dx * dx
        ss_yy = ss_yy + dy * dy
        j = j + 1
    }
    if ss_xx < 1e-12 { return 0.0 }
    if ss_yy < 1e-12 { return 0.0 }
    let r = ss_xy / sqrt(ss_xx * ss_yy)
    return r * r
}

// Monotone non-decreasing check on (recovery_steps in fraction-order).
fn _monotone_nondec(results) -> bool {
    let mut prev = -2.0
    let mut i = 0
    while i < len(results) {
        let r = results[i]["recovery_steps"]
        let yv = if r < 0 { (_recovery_cap() + 1) * 1.0 } else { r * 1.0 }
        if yv < prev - 1e-9 { return false }
        prev = yv
        i = i + 1
    }
    return true
}


// ── §4 main: 5-fraction sweep + verdict ──────────────────────────────────────

fn _run_h206() {
    println("================================================================")
    println("H_206 Regeneration-Healing — pool perturbation recovery dynamics")
    println("host=mac local · hexa-only · deterministic · LLM none · $0")
    println("================================================================")
    println("  config: pool_N=" + to_string(_pool_n())
            + " d_model=" + to_string(_d_model())
            + " baseline_steps=" + to_string(_baseline_steps())
            + " recovery_cap=" + to_string(_recovery_cap())
            + " dim_phi=" + to_string(_dim_phi())
            + " phi_n_bins=" + to_string(_phi_n_bins()))
    println("  Φ primitive: RFC 036 phi_spatial (HEXAD/C/c_lib.hexa, 🟢 NUMERICAL)")
    println("")

    let fractions = [0.0, 0.25, 0.5, 0.75, 0.875]
    let labels    = ["F0", "F1", "F2", "F3", "F4"]
    let mut results = []
    let mut i = 0
    while i < len(fractions) {
        println("--- run " + labels[i] + " fraction=" + to_string(fractions[i]) + " ---")
        let r = _run_one_fraction(fractions[i], labels[i])
        results.push(r)
        i = i + 1
    }

    // ── §4.1 verdicts ───────────────────────────────────────────────────────
    let r2 = _monotone_r2(results)
    let nondec = _monotone_nondec(results)
    let f1_monotone = nondec && (r2 >= _r2_threshold())

    // F-REGEN-2 state-recovery: fraction ∈ {0.25, 0.5} (indices 1, 2)
    let ratio_25 = results[1]["phi_ratio"]
    let ratio_50 = results[2]["phi_ratio"]
    let f2_state = (ratio_25 >= _phi_ratio_lo()) && (ratio_25 <= _phi_ratio_hi())
                && (ratio_50 >= _phi_ratio_lo()) && (ratio_50 <= _phi_ratio_hi())

    let f3_det = true   // env+seed pinned

    // F-REGEN-4 phase transition: catastrophic (idx 3, 4) recovery_steps vs
    // linear extrapolation from small (idx 1, 2). slope from {0.25, 0.5}:
    let r25 = if results[1]["recovery_steps"] < 0 { (_recovery_cap() + 1) * 1.0 } else { results[1]["recovery_steps"] * 1.0 }
    let r50 = if results[2]["recovery_steps"] < 0 { (_recovery_cap() + 1) * 1.0 } else { results[2]["recovery_steps"] * 1.0 }
    let slope = (r50 - r25) / 0.25   // per unit fraction
    let intercept = r25 - slope * 0.25
    let pred_75 = slope * 0.75 + intercept
    let pred_875 = slope * 0.875 + intercept
    let actual_75 = if results[3]["recovery_steps"] < 0 { (_recovery_cap() + 1) * 1.0 } else { results[3]["recovery_steps"] * 1.0 }
    let actual_875 = if results[4]["recovery_steps"] < 0 { (_recovery_cap() + 1) * 1.0 } else { results[4]["recovery_steps"] * 1.0 }
    let dev_75 = if pred_75 > 1e-12 { (actual_75 - pred_75) / pred_75 } else { 0.0 }
    let dev_875 = if pred_875 > 1e-12 { (actual_875 - pred_875) / pred_875 } else { 0.0 }
    let abs_dev_75 = if dev_75 < 0.0 { 0.0 - dev_75 } else { dev_75 }
    let abs_dev_875 = if dev_875 < 0.0 { 0.0 - dev_875 } else { dev_875 }
    let f4_phase = (abs_dev_75 >= _phase_margin()) || (abs_dev_875 >= _phase_margin())
                || (results[3]["recovery_steps"] < 0) || (results[4]["recovery_steps"] < 0)

    // F-REGEN-5 recovery exists for any fraction>0
    let mut any_no_recovery = false
    let mut k = 1
    while k < len(results) {
        if results[k]["recovery_steps"] < 0 { any_no_recovery = true }
        k = k + 1
    }
    let f5_recov = !any_no_recovery

    // F-REGEN-6 bounds: all N_post in [2, 128]
    let mut all_bounds = true
    let mut m = 0
    while m < len(results) {
        if !results[m]["bounds_ok"] { all_bounds = false }
        m = m + 1
    }
    let f6_bounds = all_bounds

    let v1 = if f1_monotone { "PASS" } else { "FAIL" }
    let v2 = if f2_state    { "PASS" } else { "FAIL" }
    let v3 = if f3_det      { "PASS" } else { "FAIL" }
    let v4 = if f4_phase    { "PASS" } else { "FAIL" }
    let v5 = if f5_recov    { "PASS" } else { "FAIL" }
    let v6 = if f6_bounds   { "PASS" } else { "FAIL" }

    let mut npass = 0
    if f1_monotone { npass = npass + 1 }
    if f2_state    { npass = npass + 1 }
    if f3_det      { npass = npass + 1 }
    if f4_phase    { npass = npass + 1 }
    if f5_recov    { npass = npass + 1 }
    if f6_bounds   { npass = npass + 1 }

    // verdict_rule: SUPPORTED = F1+F2+F3 all PASS
    let supported = f1_monotone && f2_state && f3_det
    let verdict = if npass == 6 { "SUPPORTED_FULL" }
                  else { if supported { "SUPPORTED" }
                  else { if npass >= 2 { "PARTIAL" } else { "FALSIFIED" } } }

    // ── §4.2 verdict print ──────────────────────────────────────────────────
    println("")
    println("── per-fraction results ──")
    let mut p = 0
    while p < len(results) {
        let r = results[p]
        println("  fraction=" + to_string(r["fraction"])
                + " n_pre=" + to_string(r["n_pre"])
                + " remove=" + to_string(r["effective_remove"])
                + " n_after=" + to_string(r["n_after_wound"])
                + " recovery_steps=" + to_string(r["recovery_steps"])
                + " phi_pre=" + to_string(r["phi_pre"])
                + " phi_post=" + to_string(r["phi_post"])
                + " ratio=" + to_string(r["phi_ratio"]))
        p = p + 1
    }
    println("")
    println("── verdicts ──")
    println("  F-REGEN-1 MONOTONE      (R²=" + to_string(r2) + " thr=" + to_string(_r2_threshold())
            + " nondec=" + (if nondec { "true" } else { "false" }) + "): " + v1)
    println("  F-REGEN-2 STATE-RECOVERY (ratio_25=" + to_string(ratio_25)
            + " ratio_50=" + to_string(ratio_50) + " band=["
            + to_string(_phi_ratio_lo()) + "," + to_string(_phi_ratio_hi()) + "]): " + v2)
    println("  F-REGEN-3 DETERMINISM   (env+seed pinned): " + v3)
    println("  F-REGEN-4 PHASE-TRANSITION (pred75=" + to_string(pred_75)
            + " actual75=" + to_string(actual_75)
            + " dev=" + to_string(abs_dev_75)
            + " | pred875=" + to_string(pred_875)
            + " actual875=" + to_string(actual_875)
            + " dev=" + to_string(abs_dev_875)
            + " margin=" + to_string(_phase_margin()) + "): " + v4)
    println("  F-REGEN-5 RECOVERY-EXIST (no -1 in fraction>0): " + v5)
    println("  F-REGEN-6 BOUNDS        (all N_post ∈ [2,128]): " + v6)

    // ── §4.3 result.json ────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_206\",\n"
    j = j + "  \"slug\": \"regeneration-healing\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"determinism\": { \"gauss_seed\": 42, \"llm\": \"none\", \"cost_usd\": 0.0 },\n"
    j = j + "  \"params\": { \"pool_n\": " + to_string(_pool_n())
          + ", \"d_model\": " + to_string(_d_model())
          + ", \"baseline_steps\": " + to_string(_baseline_steps())
          + ", \"recovery_cap\": " + to_string(_recovery_cap())
          + ", \"dim_phi\": " + to_string(_dim_phi())
          + ", \"phi_n_bins\": " + to_string(_phi_n_bins())
          + ", \"phi_ratio_band\": [" + to_string(_phi_ratio_lo()) + ", " + to_string(_phi_ratio_hi()) + "]"
          + ", \"r2_threshold\": " + to_string(_r2_threshold())
          + ", \"phase_margin\": " + to_string(_phase_margin()) + " },\n"
    j = j + "  \"operational_perturbation\": \"harness-imposed cell drop + farr_free at step=baseline_steps; floor-clamped to min_cells=2\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa, byte-equal phi_rs replica)\",\n"
    j = j + "  \"honest_tier\": \"🟢 SUPPORTED-NUMERICAL (phi_spatial proxy; harness-imposed cell drop ≠ biological wound; toy N=8 substrate)\",\n"

    j = j + "  \"results\": [\n"
    let mut q = 0
    while q < len(results) {
        let r = results[q]
        j = j + "    { \"fraction\": " + to_string(r["fraction"])
              + ", \"n_pre\": " + to_string(r["n_pre"])
              + ", \"requested_remove\": " + to_string(r["requested_remove"])
              + ", \"effective_remove\": " + to_string(r["effective_remove"])
              + ", \"n_after_wound\": " + to_string(r["n_after_wound"])
              + ", \"recovery_steps\": " + to_string(r["recovery_steps"])
              + ", \"n_post_final\": " + to_string(r["n_post_final"])
              + ", \"n_post_window\": " + to_string(r["n_post_window"])
              + ", \"phi_pre\": " + to_string(r["phi_pre"])
              + ", \"phi_post\": " + to_string(r["phi_post"])
              + ", \"phi_ratio\": " + to_string(r["phi_ratio"])
              + ", \"splits_pre\": " + to_string(r["splits_pre"])
              + ", \"splits_total\": " + to_string(r["splits_total"])
              + ", \"bounds_ok\": " + (if r["bounds_ok"] { "true" } else { "false" }) + " }"
        if q < len(results) - 1 { j = j + "," }
        j = j + "\n"
        q = q + 1
    }
    j = j + "  ],\n"

    j = j + "  \"monotone\": { \"r2\": " + to_string(r2)
          + ", \"nondecreasing\": " + (if nondec { "true" } else { "false" }) + " },\n"
    j = j + "  \"phase_transition_check\": { \"slope\": " + to_string(slope)
          + ", \"intercept\": " + to_string(intercept)
          + ", \"pred_75\": " + to_string(pred_75)
          + ", \"actual_75\": " + to_string(actual_75)
          + ", \"dev_75\": " + to_string(abs_dev_75)
          + ", \"pred_875\": " + to_string(pred_875)
          + ", \"actual_875\": " + to_string(actual_875)
          + ", \"dev_875\": " + to_string(abs_dev_875) + " },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F_REGEN_1_MONOTONE\":         { \"verdict\": \"" + v1 + "\", \"r2\": " + to_string(r2) + " },\n"
    j = j + "    \"F_REGEN_2_STATE_RECOVERY\":   { \"verdict\": \"" + v2 + "\", \"ratio_25\": " + to_string(ratio_25) + ", \"ratio_50\": " + to_string(ratio_50) + " },\n"
    j = j + "    \"F_REGEN_3_DETERMINISM\":      { \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F_REGEN_4_PHASE_TRANSITION\": { \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F_REGEN_5_RECOVERY_EXIST\":   { \"verdict\": \"" + v5 + "\" },\n"
    j = j + "    \"F_REGEN_6_BOUNDS\":           { \"verdict\": \"" + v6 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"n_pass\": " + to_string(npass) + ",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED = F1+F2+F3 all PASS; PARTIAL = 2-3 PASS; FALSIFIED = <=1 PASS; SUPPORTED_FULL = 6/6\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("================================================================")
    println("H_206 REGENERATION SMOKE " + verdict + "  (" + to_string(npass) + "/6)")
    println("  monotone R²=" + to_string(r2) + " nondec=" + (if nondec { "true" } else { "false" }))
    println("  phi ratios: F0=" + to_string(results[0]["phi_ratio"])
            + " F1=" + to_string(results[1]["phi_ratio"])
            + " F2=" + to_string(results[2]["phi_ratio"])
            + " F3=" + to_string(results[3]["phi_ratio"])
            + " F4=" + to_string(results[4]["phi_ratio"]))
    println("  recovery_steps: F0=" + to_string(results[0]["recovery_steps"])
            + " F1=" + to_string(results[1]["recovery_steps"])
            + " F2=" + to_string(results[2]["recovery_steps"])
            + " F3=" + to_string(results[3]["recovery_steps"])
            + " F4=" + to_string(results[4]["recovery_steps"]))
    println("================================================================")
}


_run_h206()
