// UNIVERSE/state/h623_c1_proxy_to_faithful_iit4_recheck_2026_05_28/run_h623.hexa
//
//   H_623 — C1 raster round 4: proxy → faithful 승격 재검 (distinction + relation level)
//
//   H_282 (round 1, PR #570) 가 H_266/268/278 의 faithful big-Φ scalar 방향보존을
//   SUPP 8/8 로 닫았다. 본 H_623 = round 4 추가 — 같은 substrate 에서 big_phi() 의
//   distinction count (n_distinctions = b[4]) + sum_φd (b[2]) + sum_φr (b[3]) 가
//   class-mean ordering / scale-variance 를 동일 방향으로 보존하는지 검정.
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-28, before measuring):
//     F623.1 (H_266 distinction-count direction):
//       integrated rules {110,30,54} 의 n_distinctions 평균 > disconnected {204,0} 의
//       n_distinctions 평균 (canonical state 1010, n=4 ring).
//     F623.2 (H_266 sum_φd direction):
//       integrated 의 Σφ_d 평균 > disconnected 의 Σφ_d 평균.
//     F623.3 (H_268 T1 distinction+relation):
//       T1 (rule 110) 의 n_distinctions ≥ 1 AND (sum_φd + sum_φr) > 0 at ≥2/3 state.
//     F623.4 (H_278 scale-variance at distinction level):
//       6-scale n_distinctions CV > 0.15 (population CV, scale-VARIANT 보존).
//     F623.5 (determinism):
//       integrated rule 110 의 [n_distinctions, sum_φd, sum_φr] re-run byte-identical.
//
//   honest scope: n=4 ring · canonical state 10 (1010) + 3-state robustness on T1.
//   deterministic · hexa-only · $0 mac local · LLM none · NO GPU.
// ════════════════════════════════════════════════════════════════════════════
import "/tmp/u-h623/HEXAD/IIT4/lib/iit4_eca.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// full big_phi tuple for an ECA rule on an n-ring in system state st.
// returns [big_phi, total, sum_phi_d, sum_phi_r, n_distinctions]
fn bphi_full(rule: int, n: int, st: int) -> list {
    return big_phi(eca_tpm(rule, n), n, st)
}

// population CV = stddev / |mean| over a 6-array.
fn cv6(a: float, b: float, c: float, d: float, e: float, f: float) -> float {
    let m = (a + b + c + d + e + f) / 6.0
    let va = (a - m) * (a - m)
    let vb = (b - m) * (b - m)
    let vc = (c - m) * (c - m)
    let vd = (d - m) * (d - m)
    let ve = (e - m) * (e - m)
    let vf = (f - m) * (f - m)
    let var = (va + vb + vc + vd + ve + vf) / 6.0
    let sd = sqrt(var)
    if m < 0.0 { return sd / (0.0 - m) }
    if m < 1.0e-12 { return 0.0 }
    return sd / m
}

fn main() {
    let n = 4
    let st = 10                                          // canonical sys_state 1010
    println("================================================================")
    println("  H_623 — C1 round 4: proxy → faithful (distinction + relation level)")
    println("  faithful IIT 4.0 Φ-structure (HEXAD/IIT4/lib) · n=" + str(n) + " · state=1010")
    println("  ROUND 4 of: H_282(r1) · H_281/H_280(r2) · H_285(r3 edge-of-chaos)")
    println("================================================================")

    // ════════════════════════════════════════════════════════════════════
    //  F623.1 + F623.2 — H_266 connectivity tiers, distinction + Σφ_d level
    // ════════════════════════════════════════════════════════════════════
    println("")
    println("── F623.1 + F623.2  H_266 distinction count + sum_φ_d direction ──")
    let i110 = bphi_full(110, n, st)
    let i30  = bphi_full(30,  n, st)
    let i54  = bphi_full(54,  n, st)
    let d204 = bphi_full(204, n, st)
    let d0   = bphi_full(0,   n, st)

    // n_distinctions = b[4]
    let nd_i110 = i110[4]
    let nd_i30  = i30[4]
    let nd_i54  = i54[4]
    let nd_d204 = d204[4]
    let nd_d0   = d0[4]
    let mean_nd_int = (nd_i110 + nd_i30 + nd_i54) / 3.0
    let mean_nd_dis = (nd_d204 + nd_d0) / 2.0
    println("  n_distinctions integrated  : r110=" + str(nd_i110) + " r30=" + str(nd_i30) + " r54=" + str(nd_i54) + " mean=" + str(mean_nd_int))
    println("  n_distinctions disconnected: r204=" + str(nd_d204) + " r0=" + str(nd_d0) + " mean=" + str(mean_nd_dis))
    check("F623.1 n_distinctions(integrated) > n_distinctions(disconnected) class-mean", mean_nd_int > mean_nd_dis)

    // sum_phi_d = b[2]
    let sd_i110 = i110[2]
    let sd_i30  = i30[2]
    let sd_i54  = i54[2]
    let sd_d204 = d204[2]
    let sd_d0   = d0[2]
    let mean_sd_int = (sd_i110 + sd_i30 + sd_i54) / 3.0
    let mean_sd_dis = (sd_d204 + sd_d0) / 2.0
    println("  Σφ_d integrated  : r110=" + str(sd_i110) + " r30=" + str(sd_i30) + " r54=" + str(sd_i54) + " mean=" + str(mean_sd_int))
    println("  Σφ_d disconnected: r204=" + str(sd_d204) + " r0=" + str(sd_d0) + " mean=" + str(mean_sd_dis))
    check("F623.2 Σφ_d(integrated) > Σφ_d(disconnected) class-mean", mean_sd_int > mean_sd_dis)

    // ════════════════════════════════════════════════════════════════════
    //  F623.3 — H_268 T1 (rule 110) distinction + relation existence
    // ════════════════════════════════════════════════════════════════════
    println("")
    println("── F623.3  H_268 T1 (rule 110) n_distinctions + (Σφ_d + Σφ_r) ──")
    let t1a = bphi_full(110, n, 1)
    let t1b = bphi_full(110, n, 5)
    let t1c = bphi_full(110, n, 10)
    let mut t1_ok = 0
    let nd_a = t1a[4]; let dr_a = t1a[2] + t1a[3]
    let nd_b = t1b[4]; let dr_b = t1b[2] + t1b[3]
    let nd_c = t1c[4]; let dr_c = t1c[2] + t1c[3]
    if (nd_a >= 1.0) && (dr_a > 0.0) { t1_ok = t1_ok + 1 }
    if (nd_b >= 1.0) && (dr_b > 0.0) { t1_ok = t1_ok + 1 }
    if (nd_c >= 1.0) && (dr_c > 0.0) { t1_ok = t1_ok + 1 }
    println("  state=1  n_dist=" + str(nd_a) + " (Σφ_d+Σφ_r)=" + str(dr_a))
    println("  state=5  n_dist=" + str(nd_b) + " (Σφ_d+Σφ_r)=" + str(dr_b))
    println("  state=10 n_dist=" + str(nd_c) + " (Σφ_d+Σφ_r)=" + str(dr_c))
    println("  T1 substantial-structure count (n_dist≥1 ∧ Σφ_d+Σφ_r>0): " + str(t1_ok) + "/3")
    check("F623.3 T1 distinction+relation structure present at ≥2/3 states", t1_ok >= 2)

    // ════════════════════════════════════════════════════════════════════
    //  F623.4 — H_278 6-scale n_distinctions scale-variance
    // ════════════════════════════════════════════════════════════════════
    println("")
    println("── F623.4  H_278 6-scale n_distinctions CV ──")
    let sc0 = bphi_full(30,  n, st)
    let sc1 = bphi_full(110, n, st)
    let sc2 = bphi_full(90,  n, st)
    let sc3 = bphi_full(54,  n, st)
    let sc4 = bphi_full(110, n, st)
    let sc5 = bphi_full(110, n, st)
    let nd0 = sc0[4]; let nd1 = sc1[4]; let nd2 = sc2[4]
    let nd3 = sc3[4]; let nd4 = sc4[4]; let nd5 = sc5[4]
    println("  cosmic_web(30)=" + str(nd0) + " galaxy(110)=" + str(nd1) + " stellar(90)=" + str(nd2))
    println("  planetary(54)=" + str(nd3) + " biological(110)=" + str(nd4) + " neural(110)=" + str(nd5))
    let cv_nd = cv6(nd0, nd1, nd2, nd3, nd4, nd5)
    println("  n_distinctions CV over 6 scales = " + str(cv_nd) + " (threshold 0.15)")
    check("F623.4 n_distinctions scale-variance holds (CV > 0.15)", cv_nd > 0.15)

    // ════════════════════════════════════════════════════════════════════
    //  F623.5 — determinism (re-run rule 110 byte-identical at struct level)
    // ════════════════════════════════════════════════════════════════════
    println("")
    println("── F623.5  determinism (struct-level re-run) ──")
    let i110b = bphi_full(110, n, st)
    let d_nd = i110[4] - i110b[4]
    let d_sd = i110[2] - i110b[2]
    let d_sr = i110[3] - i110b[3]
    let det = (d_nd < 1.0e-9) && (d_nd > -1.0e-9) && (d_sd < 1.0e-9) && (d_sd > -1.0e-9) && (d_sr < 1.0e-9) && (d_sr > -1.0e-9)
    println("  Δn_distinctions=" + str(d_nd) + " ΔΣφ_d=" + str(d_sd) + " ΔΣφ_r=" + str(d_sr))
    check("F623.5 struct-level re-run byte-identical (Δ < 1e-9)", det)

    // ════════════════════════════════════════════════════════════════════
    //  deterministic JSON ledger
    // ════════════════════════════════════════════════════════════════════
    println("")
    println("__LEDGER_JSON__")
    println("{")
    println("  \"hypothesis\": \"H_623\",")
    println("  \"title\": \"C1 round 4: proxy→faithful at distinction+relation level\",")
    println("  \"engine\": \"HEXAD/IIT4/lib (eca_tpm + big_phi · stdlib/consciousness) — REUSED, not reimplemented\",")
    println("  \"round\": 4,")
    println("  \"config\": { \"n\": " + str(n) + ", \"canonical_state\": " + str(st) + ", \"ring\": true },")
    println("  \"F623_1_H266_ndist\": {")
    println("    \"integrated\":   { \"rule110\": " + str(nd_i110) + ", \"rule30\": " + str(nd_i30) + ", \"rule54\": " + str(nd_i54) + ", \"mean\": " + str(mean_nd_int) + " },")
    println("    \"disconnected\": { \"rule204\": " + str(nd_d204) + ", \"rule0\": " + str(nd_d0) + ", \"mean\": " + str(mean_nd_dis) + " },")
    println("    \"direction_preserved\": " + str(mean_nd_int > mean_nd_dis))
    println("  },")
    println("  \"F623_2_H266_sumphi_d\": {")
    println("    \"integrated\":   { \"rule110\": " + str(sd_i110) + ", \"rule30\": " + str(sd_i30) + ", \"rule54\": " + str(sd_i54) + ", \"mean\": " + str(mean_sd_int) + " },")
    println("    \"disconnected\": { \"rule204\": " + str(sd_d204) + ", \"rule0\": " + str(sd_d0) + ", \"mean\": " + str(mean_sd_dis) + " },")
    println("    \"direction_preserved\": " + str(mean_sd_int > mean_sd_dis))
    println("  },")
    println("  \"F623_3_H268_T1_struct\": {")
    println("    \"state_1\":  { \"n_dist\": " + str(nd_a) + ", \"sumphi_d_plus_r\": " + str(dr_a) + " },")
    println("    \"state_5\":  { \"n_dist\": " + str(nd_b) + ", \"sumphi_d_plus_r\": " + str(dr_b) + " },")
    println("    \"state_10\": { \"n_dist\": " + str(nd_c) + ", \"sumphi_d_plus_r\": " + str(dr_c) + " },")
    println("    \"substantial_count\": " + str(t1_ok))
    println("  },")
    println("  \"F623_4_H278_ndist_cv\": {")
    println("    \"scale_n_dist\": { \"cosmic_web_30\": " + str(nd0) + ", \"galaxy_110\": " + str(nd1) + ", \"stellar_90\": " + str(nd2) + ", \"planetary_54\": " + str(nd3) + ", \"biological_110\": " + str(nd4) + ", \"neural_110\": " + str(nd5) + " },")
    println("    \"ndist_cv\": " + str(cv_nd) + ", \"threshold\": 0.15, \"scale_variant_at_struct_level\": " + str(cv_nd > 0.15))
    println("  },")
    println("  \"summary\": { \"pass\": " + str(PASS) + ", \"fail\": " + str(FAIL) + " }")
    println("}")
    println("__LEDGER_END__")

    println("")
    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("================================================================")
    if FAIL > 0 { panic("H_623 round-4 distinction+relation re-check FAILED") }
}
