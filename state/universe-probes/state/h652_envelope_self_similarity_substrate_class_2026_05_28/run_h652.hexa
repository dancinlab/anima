// ════════════════════════════════════════════════════════════════════════════
// H_652 — envelope-self-similarity-substrate-class  (H_648 일반화)
//
//   H_648 (PR #1231, 🟢 6/6) 이 gamma·ultradian·circadian 3-scale Φ-envelope
//   self-similarity (min r=0.76, scale-free) 를 보였으나 generator 가
//   cosine/piecewise/quadratic 혼재였다 (각 scale 다른 analytic 모형). 본 H 는
//   substrate-class 의존성 검정 — multi-scale envelope self-similarity 가
//   rule110(class-IV) 한정 현상인가, 전 rule class 에서 성립하는 구조인가.
//
//   가설: multi-scale Φ-envelope self-similarity 가 rule class 무관 —
//         rule {30 (class-III chaotic), 90 (additive), 110 (class-IV complex),
//         184 (class-II particle)} 모두 pairwise r > 0.5.
//   falsifier: 특정 class (rule90 additive 등) 에서 self-similarity 붕괴
//              (min pairwise r < 0.3) → self-similarity = class-IV 한정.
//
//   SUBSTRATE-DERIVED ENVELOPE (generator 혼재 제거, ensemble-phase)
//     H_648 의 3-scale 은 서로 다른 analytic generator (cosine / dream-stage
//     piecewise / quadratic) 였다. H_652 는 단일 substrate (ECA ring n=4) 로부터
//     세 scale 의 envelope 을 모두 derive 한다 — generator 단일화:
//       1) rule r 의 faithful big-Φ 를 전 2^4=16 state 에 1회 계산 → Φ-map.
//       2) ENSEMBLE-PHASE Φ-envelope. 단일-seed trajectory 는 작은 ring 에서
//          짧은 attractor 로 붕괴해 strided coarse-grain 이 degenerate flat 이
//          된다 (degeneracy artifact). 이를 피하려 전 16 initial seed 의 orbit
//          을 ensemble 로 진화시키고, 각 phase position t 에서 ensemble-mean Φ
//          를 취해 부드러운 Φ(t) phase-profile 을 만든다 (substrate 구조 반영,
//          single-seed 붕괴 회피).
//       3) 同一 ensemble Φ(t) profile 을 3 nested observation horizon (scale)
//          으로 본다:
//          FINE   (horizon H1, micro phase)  — gamma 유비
//          MEDIUM (horizon H2, meso phase)   — ultradian 유비
//          COARSE (horizon H3, macro phase)  — circadian 유비
//          각 horizon 을 normalized phase τ∈[0,1] 위 N=36 bin 으로 mean-aggregate.
//     세 envelope 이 同一 substrate 의 다른 관측 horizon 일 뿐이므로 generator
//     혼재가 없다 — self-similarity 가 substrate 구조 자체에 귀속.
//
//   SELF-SIMILARITY 검정 (per rule, H_648 양식)
//     각 scale envelope 을 자체 peak 에 phase-align (rotate_to_peak) →
//     scale-invariant shape 비교. pairwise Pearson r:
//       r(fine,medium) · r(medium,coarse) · r(fine,coarse).
//     min pairwise r > 0.5 → 해당 rule self-similar.
//
//   CLASS-INVARIANCE 검정 (aggregate)
//     4 rule 全部 min r > 0.5 → class-invariant (가설 지지).
//     특정 rule min r < 0.3 → 그 class 에서 붕괴 (falsifier).
//
//   falsifier
//     F652.1 RULE30-SELF-SIMILAR  : rule 30  min pairwise r > 0.5
//     F652.2 RULE90-SELF-SIMILAR  : rule 90  min pairwise r > 0.5  (additive outlier 주의)
//     F652.3 RULE110-SELF-SIMILAR : rule 110 min pairwise r > 0.5  (H_648 class-IV anchor)
//     F652.4 RULE184-SELF-SIMILAR : rule 184 min pairwise r > 0.5
//     F652.5 ALL-ENVELOPES-NOT-FLAT: 4 rule × 3 scale 全 envelope std > 0
//     F652.6 BOUND                : 全 r ∈ [-1,1], Φ-map finite
//
//   verdict
//     ≥4/6 PASS AND 4/4 rule min r > 0.5 → 🟢 SUPPORTED-NUMERICAL (class-invariant).
//     1+ rule min r < 0.3              → 🔴 FALSIFIED (self-similarity class-bound).
//     중간 (min r ∈ [0.3,0.5])          → 🟡 PARTIAL.
//
//   anchors: H_648 (3-scale ladder min r=0.76 🟢) · H_634 (ultradian Φ-envelope
//            r=0.802) · H_308 (circadian quadratic bump finite ratio) ·
//            H_642 (shape-invariance vs scalar-convention — rule90 additive outlier 주의).
//   $0 mac-local · faithful big-Φ (iit4) · NO RNG (deterministic seed).
// ════════════════════════════════════════════════════════════════════════════

import "/private/tmp/u-h652b/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// ── Pearson correlation ──────────────────────────────────────────────────────
fn pearson(xs: array, ys: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1 }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    i = 0
    while i < n {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        sxy = sxy + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        i = i + 1
    }
    let denom = sqrt(sxx * syy)
    if denom == 0.0 { return 0.0 }
    return sxy / denom
}

fn std_of(xs: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + xs[i]; i = i + 1 }
    let m = s / to_float(n)
    let mut ss = 0.0
    i = 0
    while i < n { let d = xs[i] - m; ss = ss + d * d; i = i + 1 }
    return sqrt(ss / to_float(n))
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn min3(a: float, b: float, c: float) -> float {
    let mut m = a
    if b < m { m = b }
    if c < m { m = c }
    return m
}

// ── phase-align: rotate an envelope so its peak sits at index 0 (H_648 양식) ──
fn rotate_to_peak(env: array) -> array {
    let n = len(env)
    let mut peak_idx = 0
    let mut peak_val = env[0]
    let mut i = 1
    while i < n {
        if env[i] > peak_val { peak_val = env[i]; peak_idx = i }
        i = i + 1
    }
    let mut out = []
    i = 0
    while i < n {
        let src = (i + peak_idx) % n
        out = out + [env[src]]
        i = i + 1
    }
    return out
}

// ── ECA one-step on a periodic ring of n cells (bit-state) ──────────────────
//   state s = integer bitmask of n cells. next state via Wolfram rule.
fn eca_step(rule: int, n: int, s: int) -> int {
    let mut ns = 0
    let mut i = 0
    while i < n {
        let l = iit4_bit(s, (i - 1 + n) % n)
        let c = iit4_bit(s, i)
        let r = iit4_bit(s, (i + 1) % n)
        let idx = 4 * l + 2 * c + r
        let nb = iit4_bit(rule, idx)
        if nb == 1 { ns = ns + iit4_pow2(i) }
        i = i + 1
    }
    return ns
}

// ── build Φ-map: big-Φ for all 2^n states of `rule` (1회 계산) ───────────────
fn phi_map(rule: int, n: int) -> array {
    let tpm = eca_tpm(rule, n)
    let full = iit4_pow2(n)
    let mut m = []
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        m = m.push(r[0])
        s = s + 1
    }
    return m
}

// ── ensemble-phase Φ-profile: mean Φ over all 2^n seeds at each phase step ───
//   각 step t (0..horizon-1) 에서 全 seed orbit 의 state[t] 의 Φ 를 평균.
//   single-seed attractor 붕괴를 ensemble 평균으로 회피 → 부드러운 Φ(t).
fn ensemble_phi_profile(rule: int, n: int, pm: array, horizon: int) -> array {
    let full = iit4_pow2(n)
    // initialize each seed's current state to itself
    let mut cur = []
    let mut s0 = 0
    while s0 < full {
        cur = cur + [s0]
        s0 = s0 + 1
    }
    let mut prof = []
    let mut t = 0
    while t < horizon {
        // mean Φ over ensemble at this step
        let mut acc = 0.0
        let mut j = 0
        while j < full {
            acc = acc + pm[cur[j]]
            j = j + 1
        }
        prof = prof + [acc / to_float(full)]
        // advance every seed one ECA step
        let mut nxt = []
        j = 0
        while j < full {
            nxt = nxt + [eca_step(rule, n, cur[j])]
            j = j + 1
        }
        cur = nxt
        t = t + 1
    }
    return prof
}

// ── aggregate a phase-profile into N normalized-phase bins (mean per bin) ────
//   profile length = horizon; map to N bins over normalized phase τ∈[0,1].
fn bin_to_phase(prof: array, n_bins: int) -> array {
    let ns = len(prof)
    let mut env = []
    let mut b = 0
    while b < n_bins {
        let lo = (b * ns) / n_bins
        let mut hi = ((b + 1) * ns) / n_bins
        if hi <= lo { hi = lo + 1 }
        if hi > ns { hi = ns }
        let mut acc = 0.0
        let mut cnt = 0
        let mut k = lo
        while k < hi {
            acc = acc + prof[k]
            cnt = cnt + 1
            k = k + 1
        }
        let mut v = 0.0
        if cnt > 0 { v = acc / to_float(cnt) }
        env = env + [v]
        b = b + 1
    }
    return env
}

fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}

fn main() {
    println("================================================================")
    println("  H_652 — envelope-self-similarity-substrate-class")
    println("  single-substrate (ECA n=4) 3-scale Φ-envelope self-similarity")
    println("  rule class sweep {30 III · 90 additive · 110 IV · 184 II}")
    println("  anchors: H_648 (min r=0.76 🟢) · H_634 · H_308 · H_642")
    println("================================================================")

    let n = 4
    let N_BINS = 36          // H_648 동일 36-point envelope

    // 3 nested observation horizons (scales) — ensemble-phase profile length.
    //   FINE 짧은 horizon (micro, gamma 유비) · MEDIUM (meso, ultradian 유비) ·
    //   COARSE 긴 horizon (macro, circadian 유비). 모두 동일 ensemble dynamics 의
    //   다른 관측 길이 → normalized phase 로 정규화 후 self-similar shape 비교.
    let H_FINE = 36          // micro horizon
    let H_MED = 144          // meso  horizon (4×)
    let H_COARSE = 576       // macro horizon (16×)

    let rules = [30, 90, 110, 184]
    let class_names = ["III-chaotic", "additive(90)", "IV-complex", "II-particle"]
    let nr = len(rules)

    let mut min_r_arr = []
    let mut r_fm_arr = []
    let mut r_mc_arr = []
    let mut r_fc_arr = []
    let mut self_sim_arr = []   // 1 if min r > 0.5
    let mut all_std_pos = true
    let mut all_bound = true

    let mut ri = 0
    while ri < nr {
        let rule = rules[ri]
        println("")
        println("── rule " + str(rule) + " (" + class_names[ri] + ") ──")

        // 1) Φ-map for this rule (faithful big-Φ over all 16 states)
        let pm = phi_map(rule, n)

        // 2) ensemble-phase Φ-profile at 3 nested horizons (degeneracy 회피)
        let prof_fine = ensemble_phi_profile(rule, n, pm, H_FINE)
        let prof_med = ensemble_phi_profile(rule, n, pm, H_MED)
        let prof_coarse = ensemble_phi_profile(rule, n, pm, H_COARSE)

        // 3) bin each horizon to N normalized-phase bins → 3 envelopes
        let env_fine = bin_to_phase(prof_fine, N_BINS)
        let env_med = bin_to_phase(prof_med, N_BINS)
        let env_coarse = bin_to_phase(prof_coarse, N_BINS)

        let sd_f = std_of(env_fine)
        let sd_m = std_of(env_med)
        let sd_c = std_of(env_coarse)
        if (sd_f <= 0.0) || (sd_m <= 0.0) || (sd_c <= 0.0) { all_std_pos = false }

        // phase-align each scale to its own peak (scale-invariant shape)
        let af = rotate_to_peak(env_fine)
        let am = rotate_to_peak(env_med)
        let ac = rotate_to_peak(env_coarse)

        // pairwise Pearson r on phase-aligned shapes
        let r_fm = pearson(af, am)   // fine ↔ medium
        let r_mc = pearson(am, ac)   // medium ↔ coarse
        let r_fc = pearson(af, ac)   // fine ↔ coarse
        let mr = min3(r_fm, r_mc, r_fc)

        if fabs(r_fm) > 1.0000001 { all_bound = false }
        if fabs(r_mc) > 1.0000001 { all_bound = false }
        if fabs(r_fc) > 1.0000001 { all_bound = false }

        let mut ss = 0
        if mr > 0.5 { ss = 1 }

        min_r_arr = min_r_arr.push(mr)
        r_fm_arr = r_fm_arr.push(r_fm)
        r_mc_arr = r_mc_arr.push(r_mc)
        r_fc_arr = r_fc_arr.push(r_fc)
        self_sim_arr = self_sim_arr.push(ss)

        println("  Φ-map std (state→Φ)  : " + to_string(std_of(pm)))
        println("  env std fine/med/coarse: " + to_string(sd_f) + " / " + to_string(sd_m) + " / " + to_string(sd_c))
        println("  r(fine,medium)       = " + to_string(r_fm))
        println("  r(medium,coarse)     = " + to_string(r_mc))
        println("  r(fine,coarse)       = " + to_string(r_fc))
        println("  min pairwise r       = " + to_string(mr) + "   self-similar=" + str(ss))
        ri = ri + 1
    }

    // ── aggregate: class-invariance ──────────────────────────────────────────
    let mut n_self_sim = 0
    let mut n_collapse = 0   // min r < 0.3
    let mut global_min = 2.0
    let mut i = 0
    while i < nr {
        n_self_sim = n_self_sim + self_sim_arr[i]
        if min_r_arr[i] < 0.3 { n_collapse = n_collapse + 1 }
        if min_r_arr[i] < global_min { global_min = min_r_arr[i] }
        i = i + 1
    }

    println("")
    println("================================================================")
    println("  ── aggregate (class-invariance) ──")
    println("  rules           : [30, 90, 110, 184]")
    println("  min-r per rule  : " + json_arr_f(min_r_arr))
    println("  self-similar    : " + str(n_self_sim) + " / " + str(nr) + " rules (min r > 0.5)")
    println("  collapsed(<0.3) : " + str(n_collapse) + " rules")
    println("  global min r    : " + to_string(global_min))
    println("  ────────────── verdict ──────────────")

    // ── F652.1-4 per-rule self-similarity ────────────────────────────────────
    check("F652.1 RULE30-SELF-SIMILAR : min r > 0.5", self_sim_arr[0] == 1)
    check("F652.2 RULE90-SELF-SIMILAR : min r > 0.5 (additive)", self_sim_arr[1] == 1)
    check("F652.3 RULE110-SELF-SIMILAR: min r > 0.5 (class-IV anchor)", self_sim_arr[2] == 1)
    check("F652.4 RULE184-SELF-SIMILAR: min r > 0.5", self_sim_arr[3] == 1)

    // ── F652.5 ALL-ENVELOPES-NOT-FLAT ────────────────────────────────────────
    check("F652.5 ALL-ENVELOPES-NOT-FLAT: 4×3 env std > 0", all_std_pos)

    // ── F652.6 BOUND ─────────────────────────────────────────────────────────
    check("F652.6 BOUND: all r ∈ [-1,1]", all_bound)

    println("  ──────────────────────────────────────")
    println("  F652.1-6 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")

    let mut verdict = "🟡 PARTIAL (weak / mixed self-similarity)"
    if (PASS >= 4) && (n_self_sim == nr) {
        verdict = "🟢 SUPPORTED-NUMERICAL (class-invariant self-similarity)"
    }
    if n_collapse >= 1 {
        verdict = "🔴 FALSIFIED (self-similarity class-bound — rule collapse min r<0.3)"
    }
    println("  verdict: " + verdict)

    // ── write result.json ────────────────────────────────────────────────────
    let mut js = "{\n"
    js = js + "  \"hypothesis\": \"H_652\",\n"
    js = js + "  \"slug\": \"envelope-self-similarity-substrate-class\",\n"
    js = js + "  \"predecessor\": \"H_648\",\n"
    js = js + "  \"rules\": [30, 90, 110, 184],\n"
    js = js + "  \"wolfram_classes\": [\"III-chaotic\", \"additive(90)\", \"IV-complex\", \"II-particle\"],\n"
    js = js + "  \"n\": " + str(n) + ",\n"
    js = js + "  \"n_bins\": " + str(N_BINS) + ",\n"
    js = js + "  \"envelope\": \"ensemble-phase (all 2^n seeds, mean Φ per step)\",\n"
    js = js + "  \"horizons\": [" + str(H_FINE) + ", " + str(H_MED) + ", " + str(H_COARSE) + "],\n"
    js = js + "  \"r_fine_medium\": " + json_arr_f(r_fm_arr) + ",\n"
    js = js + "  \"r_medium_coarse\": " + json_arr_f(r_mc_arr) + ",\n"
    js = js + "  \"r_fine_coarse\": " + json_arr_f(r_fc_arr) + ",\n"
    js = js + "  \"min_r_per_rule\": " + json_arr_f(min_r_arr) + ",\n"
    js = js + "  \"self_similar_count\": " + str(n_self_sim) + ",\n"
    js = js + "  \"collapsed_count\": " + str(n_collapse) + ",\n"
    js = js + "  \"global_min_r\": " + str(global_min) + ",\n"
    js = js + "  \"pass\": " + str(PASS) + ",\n"
    js = js + "  \"total\": " + str(PASS + FAIL) + ",\n"
    js = js + "  \"verdict\": \"" + verdict + "\"\n"
    js = js + "}\n"
    write_file("UNIVERSE/state/h652_envelope_self_similarity_substrate_class_2026_05_28/result.json", js)
    println("  wrote result.json")
}
