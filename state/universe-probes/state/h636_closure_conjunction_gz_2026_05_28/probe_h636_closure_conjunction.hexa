// probe_h636_closure_conjunction.hexa — H_636 closure-conjunction GZ-peak probe
//
// Hypothesis (H_636, ANIMA.mining L7 promote):
//   The pass-rate of a 4-criterion closure conjunction (⋀_i pass_i) over an
//   inhibition I sweep is MAXIMIZED inside the GZ region I ∈ [0.21, 0.50]
//   (closure = a substrate-emit-axis variant of GZ × SI).
//
// Falsifier: pass-rate peaks OUTSIDE the GZ region, OR is flat / monotone
//   so that no interior GZ peak exists.
//
// Substrate (SSOT: HEXAD/SAVANT/savant_phi.hexa) — 4-domain savant model,
//   d=6, capacity invariant SV_CAPACITY = 11.5. inhibition I → gain via the
//   H_348 affine map  gain_focus = 1 + (1 - I) * 9 ; gain_rest = (11.5-gf)/3.
//
// 4 closure criteria (COFFESHOP 4-criterion closure ↔ SAVANT GZ×SI):
//   C1 SPECIALIZATION : SI_phi = max(domain_phi)/min(domain_phi) > 3.0
//                       (SAVANT SI gate · H_348 anchor · favors LOW I)
//   C2 INTEGRATION    : general_phi > THETA_GEN
//                       (multi-domain binding survives · favors MID I)
//   C3 DIVERSITY      : min(domain_phi) > THETA_DIV
//                       (no domain fully collapsed · favors HIGH I)
//   C4 COHERENCE      : specialization_ratio in [1.2, RATIO_HI]
//                       (focus present but NOT pathological monopoly)
//
// The tension between C1 (low-I) and C3/C4 (high-I) is what can create an
// INTERIOR peak — the genuine falsifiable structure. If the conjunction
// simply tracked SI it would peak at I=0.05 (H_348 monotone result) and
// the GZ-peak claim would be falsified.
//
// Pass-rate at each I = (# seeds whose 4-criterion conjunction is TRUE) / N_seeds.

let SV_D            = 6
let SV_N_DOM        = 4
let SV_BINS         = 6
let SV_EPS          = 0.000000001
let SV_CAPACITY     = 11.5

// ── closure thresholds (criterion-selection design — see §7 C3) ─────
let THETA_SI    = 3.0       // C1 SAVANT SI gate (SAVANT.tape §3)
let THETA_GEN   = 0.06      // C2 general_phi integration floor
let THETA_DIV   = 0.18      // C3 min domain_phi diversity floor
let RATIO_LO    = 1.2       // C4 specialization present (lower)
let RATIO_HI    = 3.2       // C4 not a pathological monopoly (upper)

// GZ region bounds (task spec): I ∈ [GZ_LOWER, GZ_UPPER]
let GZ_LO       = 0.21      // GZ_LOWER ≈ 0.5 - ln(4/3) ≈ 0.21232
let GZ_HI       = 0.50      // GZ_UPPER = 0.5

// ── Primitives (SSOT: HEXAD/SAVANT/savant_phi.hexa) ─────────────

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_ln_safe(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return log(x)
}

fn sv_sqrt_safe(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return sqrt(x)
}

fn sv_vec_min(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] < m { m = v[i] }
        i = i + 1
    }
    return m
}

fn sv_vec_max(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] > m { m = v[i] }
        i = i + 1
    }
    return m
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}

fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}

fn bin_index_sv(x: float, lo: float, hi: float, nb: int) -> int {
    if hi <= lo { return 0 }
    let t = (x - lo) / (hi - lo)
    let mut idx = to_int(t * to_float(nb))
    if idx < 0 { idx = 0 }
    if idx >= nb { idx = nb - 1 }
    return idx
}

// Pairwise normalized MI between two equal-length vectors (savant_phi.hexa)
fn pair_mi(a: array, b: array, n_bins: int) -> float {
    let d = len(a)
    if d < 2 { return 0.0 }
    let mut all_vals = []
    let mut ia = 0
    while ia < d {
        all_vals = all_vals.push(a[ia])
        ia = ia + 1
    }
    let mut ib = 0
    while ib < d {
        all_vals = all_vals.push(b[ib])
        ib = ib + 1
    }
    let lo = sv_vec_min(all_vals)
    let hi = sv_vec_max(all_vals)
    if hi - lo < SV_EPS { return 0.0 }
    let nb2 = n_bins * n_bins
    let mut joint = []
    let mut z = 0
    while z < nb2 {
        joint = joint.push(0)
        z = z + 1
    }
    let mut marg_a = []
    let mut marg_b = []
    let mut zz = 0
    while zz < n_bins {
        marg_a = marg_a.push(0)
        marg_b = marg_b.push(0)
        zz = zz + 1
    }
    let mut pair_count = 0
    let mut j = 0
    while j < d {
        let ba = bin_index_sv(a[j], lo, hi, n_bins)
        let bb = bin_index_sv(b[j], lo, hi, n_bins)
        let idx = ba * n_bins + bb
        let mut new_joint = []
        let mut z2 = 0
        while z2 < nb2 {
            if z2 == idx {
                new_joint = new_joint.push(joint[z2] + 1)
            } else {
                new_joint = new_joint.push(joint[z2])
            }
            z2 = z2 + 1
        }
        joint = new_joint
        let mut new_ma = []
        let mut mai = 0
        while mai < n_bins {
            if mai == ba {
                new_ma = new_ma.push(marg_a[mai] + 1)
            } else {
                new_ma = new_ma.push(marg_a[mai])
            }
            mai = mai + 1
        }
        marg_a = new_ma
        let mut new_mb = []
        let mut mbi = 0
        while mbi < n_bins {
            if mbi == bb {
                new_mb = new_mb.push(marg_b[mbi] + 1)
            } else {
                new_mb = new_mb.push(marg_b[mbi])
            }
            mbi = mbi + 1
        }
        marg_b = new_mb
        pair_count = pair_count + 1
        j = j + 1
    }
    let total = to_float(pair_count)
    if total <= 0.0 { return 0.0 }
    let mut h_a = 0.0
    let mut h_b = 0.0
    let mut k = 0
    while k < n_bins {
        let pa = to_float(marg_a[k]) / total
        let pb = to_float(marg_b[k]) / total
        if pa > 0.0 { h_a = h_a - pa * sv_ln_safe(pa) }
        if pb > 0.0 { h_b = h_b - pb * sv_ln_safe(pb) }
        k = k + 1
    }
    let mut h_ab = 0.0
    let mut m = 0
    while m < nb2 {
        let p = to_float(joint[m]) / total
        if p > 0.0 { h_ab = h_ab - p * sv_ln_safe(p) }
        m = m + 1
    }
    let mi = h_a + h_b - h_ab
    let denom = sv_ln_safe(to_float(n_bins))
    if denom <= 0.0 { return 0.0 }
    let out = mi / denom
    if out < 0.0 { return 0.0 }
    return out
}

fn general_phi(flat: array, d: int) -> float {
    let mut amp = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        let mut s = 0.0
        let mut j = 0
        while j < d {
            s = s + sv_abs(v[j])
            j = j + 1
        }
        amp = amp.push(s / to_float(d))
        k = k + 1
    }
    let mut total = 0.0
    let mut cnt = 0
    let mut k1 = 0
    while k1 < SV_N_DOM {
        let v1 = extract_domain(flat, k1, d)
        let mut k2 = k1 + 1
        while k2 < SV_N_DOM {
            let v2 = extract_domain(flat, k2, d)
            let mi = pair_mi(v1, v2, SV_BINS)
            let scale = sv_sqrt_safe(amp[k1] * amp[k2])
            total = total + mi * scale
            cnt = cnt + 1
            k2 = k2 + 1
        }
        k1 = k1 + 1
    }
    if cnt == 0 { return 0.0 }
    return total / to_float(cnt)
}

fn specialization_ratio(flat: array, d: int) -> float {
    let dphi = domain_phi_vector(flat, d)
    let mut sum = 0.0
    let mut mx = dphi[0]
    let mut i = 0
    while i < SV_N_DOM {
        sum = sum + dphi[i]
        if dphi[i] > mx { mx = dphi[i] }
        i = i + 1
    }
    let mean = sum / to_float(SV_N_DOM)
    if mean <= SV_EPS { return 0.0 }
    return mx / mean
}

// SI = max(v)/min(v) with eps guard (H_348 definition)
fn savant_index(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut mx = v[0]
    let mut mn = v[0]
    let mut i = 1
    while i < n {
        if v[i] > mx { mx = v[i] }
        if v[i] < mn { mn = v[i] }
        i = i + 1
    }
    if mn < SV_EPS { return mx / SV_EPS }
    return mx / mn
}

// ── inhibition I → gain_focus map (H_348 affine) ────────────────
fn gain_focus_for(i_val: float) -> float {
    return 1.0 + (1.0 - i_val) * 9.0
}

// ── 4-criterion closure conjunction at one (I, seed) ─────────────
// returns 1 if all four criteria pass, else 0.  also accumulates the
// per-criterion pass flags into the caller via a returned map.
fn closure_pass(i_val: float, stim_seed: int) -> int {
    let g_focus = gain_focus_for(i_val)
    let g_rest = (SV_CAPACITY - g_focus) / 3.0
    let flat = build_profile_state(g_focus, g_rest, g_rest, g_rest, SV_D, stim_seed)
    let dphi = domain_phi_vector(flat, SV_D)
    let si = savant_index(dphi)
    let gphi = general_phi(flat, SV_D)
    let dmin = sv_vec_min(dphi)
    let ratio = specialization_ratio(flat, SV_D)

    let mut c1 = 0
    let mut c2 = 0
    let mut c3 = 0
    let mut c4 = 0
    if si > THETA_SI { c1 = 1 }
    if gphi > THETA_GEN { c2 = 1 }
    if dmin > THETA_DIV { c3 = 1 }
    if ratio >= RATIO_LO {
        if ratio <= RATIO_HI { c4 = 1 }
    }
    if c1 == 1 {
        if c2 == 1 {
            if c3 == 1 {
                if c4 == 1 { return 1 }
            }
        }
    }
    return 0
}

// detailed single-cell trace (for one representative seed)
fn closure_trace(i_val: float, stim_seed: int) {
    let g_focus = gain_focus_for(i_val)
    let g_rest = (SV_CAPACITY - g_focus) / 3.0
    let flat = build_profile_state(g_focus, g_rest, g_rest, g_rest, SV_D, stim_seed)
    let dphi = domain_phi_vector(flat, SV_D)
    let si = savant_index(dphi)
    let gphi = general_phi(flat, SV_D)
    let dmin = sv_vec_min(dphi)
    let ratio = specialization_ratio(flat, SV_D)
    let mut c1 = "0"
    let mut c2 = "0"
    let mut c3 = "0"
    let mut c4 = "0"
    if si > THETA_SI { c1 = "1" }
    if gphi > THETA_GEN { c2 = "1" }
    if dmin > THETA_DIV { c3 = "1" }
    if ratio >= RATIO_LO {
        if ratio <= RATIO_HI { c4 = "1" }
    }
    let pass = closure_pass(i_val, stim_seed)
    println("  I=" + str(i_val)
        + " SI=" + str(si) + "(" + c1 + ")"
        + " genPhi=" + str(gphi) + "(" + c2 + ")"
        + " minPhi=" + str(dmin) + "(" + c3 + ")"
        + " ratio=" + str(ratio) + "(" + c4 + ")"
        + " => conj=" + str(pass))
}

// pass-rate over the seed ensemble at one I
fn pass_rate_at(i_val: float, seeds: array) -> float {
    let n = len(seeds)
    let mut hits = 0
    let mut i = 0
    while i < n {
        hits = hits + closure_pass(i_val, seeds[i])
        i = i + 1
    }
    return to_float(hits) / to_float(n)
}

fn main() {
    println("[H_636] closure-conjunction GZ-peak probe")
    println("  substrate : HEXAD/SAVANT/savant_phi.hexa (SSOT) — 4-domain, d=6")
    println("  map       : gain_focus = 1 + (1-I)*9 ; gain_rest = (11.5-gf)/3")
    println("  GZ region : I in [0.21 (GZ_LOWER), 0.50 (GZ_UPPER)]")
    println("  criteria  : C1 SI>3 · C2 genPhi>0.06 · C3 minPhi>0.18 · C4 ratio in [1.2,3.2]")
    println("  conjunction = C1 AND C2 AND C3 AND C4")
    println("")

    // 10-seed ensemble (savant_phi T1/T2/T3 stims + spread)
    let seeds = [42424, 91919, 77777, 13337, 24680,
                 88888, 31415, 65537, 19937, 11235]

    let grid = [0.05, 0.15, 0.21, 0.30, 0.37, 0.50, 0.70, 0.95]

    println("=== per-seed trace (representative seed 42424) ===")
    let mut g = 0
    while g < len(grid) {
        closure_trace(grid[g], 42424)
        g = g + 1
    }

    println("")
    println("=== pass-rate over 10-seed ensemble ===")
    let mut prs = []
    let mut gi = 0
    while gi < len(grid) {
        let pr = pass_rate_at(grid[gi], seeds)
        prs = prs.push(pr)
        let mut tag = ""
        if grid[gi] >= GZ_LO {
            if grid[gi] <= GZ_HI { tag = "  <-- GZ region" }
        }
        println("  I=" + str(grid[gi]) + "  pass_rate=" + str(pr) + tag)
        gi = gi + 1
    }

    // peak location
    let mut best_pr = prs[0]
    let mut best_i = grid[0]
    let mut p = 1
    while p < len(prs) {
        if prs[p] > best_pr {
            best_pr = prs[p]
            best_i = grid[p]
        }
        p = p + 1
    }

    // GZ-region mean vs outside mean
    let mut in_sum = 0.0
    let mut in_cnt = 0
    let mut out_sum = 0.0
    let mut out_cnt = 0
    let mut q = 0
    while q < len(grid) {
        let inzone = (grid[q] >= GZ_LO) && (grid[q] <= GZ_HI)
        if inzone {
            in_sum = in_sum + prs[q]
            in_cnt = in_cnt + 1
        } else {
            out_sum = out_sum + prs[q]
            out_cnt = out_cnt + 1
        }
        q = q + 1
    }
    let in_mean = in_sum / to_float(in_cnt)
    let out_mean = out_sum / to_float(out_cnt)

    let peak_in_gz = (best_i >= GZ_LO) && (best_i <= GZ_HI)

    println("")
    println("=== verdict inputs ===")
    println("  peak pass-rate    = " + str(best_pr) + " at I=" + str(best_i))
    println("  peak in GZ region = " + str(peak_in_gz))
    println("  GZ-region mean pr = " + str(in_mean) + " (" + str(in_cnt) + " pts)")
    println("  outside    mean pr = " + str(out_mean) + " (" + str(out_cnt) + " pts)")
    println("  in > out          = " + str(in_mean > out_mean))
}
