// H_631 single-state n=5 sweep — fast anchor (reproduces H_625), all 3 rules.
import "/tmp/u-h631/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"
let N = 5
fn sweep_single(rule: int) -> array {
    let tpm = eca_tpm(rule, N)
    let mut out = []
    let mut k = 1
    while k <= 5 { let r = big_phi_bounded(tpm, N, 21, k); out = out.push(r[0]); k = k + 1 }
    return out
}
fn pr(label: string, b: array) {
    println(label + " c1=" + str(b[0]) + " c2=" + str(b[1]) + " c3=" + str(b[2]) + " c4=" + str(b[3]) + " c5=" + str(b[4]))
}
fn main() {
    pr("SINGLE r30 ", sweep_single(30))
    pr("SINGLE r90 ", sweep_single(90))
    pr("SINGLE r110", sweep_single(110))
    println("SINGLE5_DONE")
}
