// UNIVERSE/state/h635_multilingual_cohort_collective_phi_2026_05_28/run_h635.hexa
//
//   H_635 — Multilingual-cohort collective Φ: does a 5-STREAM (lang-proxy)
//           collective big-Φ go super-additive?  Φ_collective > Σ Φ_individual ?
//
//   ANIMA.mining L6 promote (2026-05-28T04:56):
//     COFFESHOP `per_lang_verdicts ko_emits≥2` 5-lang cohort aggregation
//     ↔ HIVE-MIND `hm_collective_phi(individual_phis, sync_factor)`.
//     Same multi-stream evidence aggregation. L45 dim-cohort-5lang
//     (ko+en+zh+ru+ja) cohort PARTIAL minimum is the base case.
//
//   sister: H_609 collective-Φ super-additive (axis F, 2-STREAM, n_a=n_b=3 →
//           n_ab=6, max excess Δ=+10.4756 @ (110,110,W=0.6) 🟢). H_635 is the
//           5-STREAM lang-axis generalization — does the 2-stream super-
//           additivity survive when 5 distinct substrates (lang-proxies) are
//           pooled?  H_355 PID synergy (5-substrate, synergy=1.0 🟢) is the
//           information-decomposition sibling.
//
//   QUESTION
//     5 streams = 5 cells in a ring (n=5). Each cell i is governed by a
//     DISTINCT ECA rule rule[i] (lang-proxy: 5 different "languages" =
//     5 different local update laws → register/dialect diversity). Coupling
//     (sync_factor) W ∈ {0.0, 0.25, 0.5, 0.75, 1.0} gates whether each cell
//     sees its true ring neighbors (coupled) or only itself (decoupled).
//       tpm[s*5+i] = (1-W)*next_self(s,i) + W*next_ring(s,i)
//     • Individual Φ_i = big_phi of the SAME cell i embedded in the fully
//       DECOUPLED n=5 substrate (W=0) but isolated as a 1-cell self-loop ring;
//       since big_phi_bounded(n<2)=0, we measure Φ_i via the per-cell
//       distinction it contributes in the W=0 collective. Concretely Σ Φ_i is
//       taken as Φ_collective(W=0) — the decoupled-pool baseline (each stream
//       independent), the IIT-canonical "sum of parts" anchor.
//     • Φ_collective(W) = big_phi of the coupled n=5 ring at sync W.
//     • Excess Δ(W) = Φ_collective(W) − Φ_collective(W=0)  [= − Σ-baseline].
//
//   H1 (super-additive): ∃ W>0 s.t. Δ(W) > 0 — pooling 5 distinct lang-proxy
//       streams creates integrated information beyond the decoupled sum.
//   H0 (FALSIFIER): Δ(W) ≤ 0 for all W>0 (sub-additive) OR Δ flat / sync-
//       invariant (sync_factor 무관 평탄 — coupling does nothing).
//
//   PRE-REGISTERED FALSIFIERS (frozen 2026-05-28, BEFORE measuring)
//     F635.1 DECOUPLED-ANCHOR (W=0):  baseline well-defined, Δ(W=0)=0 by defn,
//            and the decoupled pool Φ is finite ≥ 0 (Σ-of-parts anchor).
//     F635.2 SUPER-ADDITIVITY (H1):   max_{W>0, cohort} Δ > 0
//     F635.3 SYNC-NONFLAT:            Φ_collective is NOT constant in W
//            (some W produces a different Φ than W=0 — coupling is not inert).
//     F635.4 BOUNDS+DETERMINISM:      Φ ≥ 0 everywhere · re-run byte-identical
//     F635.5 5-STREAM-GENERALIZES:    at least one 5-rule cohort reaches Δ>0
//            (the H_609 2-stream finding survives the 5-stream lang axis).
//
//   COHORTS (5 lang-proxy rule-tuples · 5 cells each)
//     C1 edge-of-chaos homogeneous  [110,110,110,110,110]  (H_609 winner echo)
//     C2 mixed multilingual          [110, 90,150, 30,110]  (5 distinct "langs")
//     C3 class-III chaotic           [ 30, 90, 30, 90, 30]
//     C4 mostly-additive (XOR-heavy) [ 90, 90, 90, 90, 90]
//     C5 chaos+complex blend         [110, 30,110, 30,110]
//
//   IIT4 engine: big_phi_bounded(tpm, 5, sys_state=0, cap=3). n=5 ⇒ 2^5=32
//     mechanisms; cap=3 bounds purview search (M4b SSOT for n≥5 tractability,
//     conservative lower-bound — cap-monotone preserves SUPPORTED direction).
//   deterministic · hexa-only · $0 mac-local · no GPU · no LLM · sys_state=0.
//
//   honest scope (see H_635 §7 C3):
//     • lang-proxy = rule-variant, NOT a real language (no token semantics).
//     • 5-stream small-n (n=5, 1 cell/stream) — toy collective, not a fleet.
//     • bounded cap=3 on n=5 (conservative lower bound on Φ_collective).
//     • sys_state=0 only (IIT-canonical anchor, comparable across W).
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn approx(a: float, b: float, tol: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < tol }
    return d < tol
}

// ── n=5 coupled-ring TPM with sync_factor W gating each cell's neighborhood. ──
//
// 5 streams = 5 cells. Cell i governed by rule[i] (distinct lang-proxy).
// Decoupled view (each stream sees only ITSELF — a self-loop, no neighbors):
//   neighborhood = (self, self, self) ⇒ idx = 4*c + 2*c + c = 7*c ∈ {0,7}
//   i.e. a "language" updates in isolation from its own current state only.
// Coupled view (full n=5 ring — every stream talks to its neighbors):
//   cell i: L=(i-1+5)%5, C=i, R=(i+1)%5
// Blend per cell: p_next = (1-W)*p_dec + W*p_cou. W = sync_factor.
fn build_tpm_cohort(rule: array, W: float) -> array {
    let n = 5
    let full = 32
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let r_i = rule[i]
            let c = iit4_bit(s, i)
            // decoupled: self-loop only (no neighbor coupling)
            let idx_dec = 4 * c + 2 * c + c        // = 7*c ∈ {0,7}
            let next_dec = iit4_bit(r_i, idx_dec)
            // coupled: full ring neighborhood
            let l = iit4_bit(s, (i - 1 + n) % n)
            let rr = iit4_bit(s, (i + 1) % n)
            let idx_cou = 4 * l + 2 * c + rr
            let next_cou = iit4_bit(r_i, idx_cou)
            // blend on sync_factor W
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn phi_cohort(rule: array, W: float) -> float {
    let tpm = build_tpm_cohort(rule, W)
    let r = big_phi_bounded(tpm, 5, 0, 3)
    return r[0]
}

fn cohort_at(idx: int) -> array {
    if idx == 0 { return [110, 110, 110, 110, 110] }
    if idx == 1 { return [110,  90, 150,  30, 110] }
    if idx == 2 { return [ 30,  90,  30,  90,  30] }
    if idx == 3 { return [ 90,  90,  90,  90,  90] }
    return [110,  30, 110,  30, 110]
}
fn cohort_label(idx: int) -> string {
    if idx == 0 { return "C1 edge-homog  [110x5]      " }
    if idx == 1 { return "C2 multilingual[110,90,150,30,110]" }
    if idx == 2 { return "C3 class-III   [30,90,30,90,30]   " }
    if idx == 3 { return "C4 XOR-heavy   [90x5]       " }
    return "C5 chaos+cplx  [110,30,110,30,110]"
}
fn w_at(j: int) -> float {
    if j == 0 { return 0.0 }
    if j == 1 { return 0.25 }
    if j == 2 { return 0.5 }
    if j == 3 { return 0.75 }
    return 1.0
}
fn w_label(j: int) -> string {
    if j == 0 { return "W=0.00" }
    if j == 1 { return "W=0.25" }
    if j == 2 { return "W=0.50" }
    if j == 3 { return "W=0.75" }
    return "W=1.00"
}

fn main() {
    println("================================================================")
    println("  H_635 — multilingual-cohort collective Φ (5-STREAM super-additive?)")
    println("  ANIMA.mining L6 promote · sister H_609 (2-stream Δ=+10.48)")
    println("  IIT4 big_phi_bounded · n=5 · cap=3 · sys=0 · sync_factor sweep")
    println("================================================================")

    let mut max_excess = -1.0e9
    let mut max_excess_cohort = 0
    let mut max_excess_w = 0
    let mut best_sync = 0.0
    let mut n_super_cohorts = 0      // F635.5: distinct cohorts reaching Δ>0
    let mut any_nonflat = false      // F635.3
    let mut bnd_ok = true            // F635.4a

    let mut c = 0
    while c < 5 {
        let ru = cohort_at(c)
        let phi0 = phi_cohort(ru, 0.0)        // decoupled pool baseline = Σ Φ_i anchor
        println("  " + cohort_label(c) + "  Φ_pool(W=0,Σ-baseline)=" + str(phi0))
        if phi0 < 0.0 { bnd_ok = false }
        let mut cohort_went_super = false
        let mut j = 1                          // W>0 only (W=0 is the baseline)
        while j < 5 {
            let W = w_at(j)
            let phiW = phi_cohort(ru, W)
            if phiW < 0.0 { bnd_ok = false }
            let delta = phiW - phi0
            if delta > 0.000001 || delta < -0.000001 { any_nonflat = true }
            println("    " + w_label(j) + "  Φ_coll=" + str(phiW) + "  Δ=Φ_coll-Σ=" + str(delta))
            if delta > 0.000001 { cohort_went_super = true }
            if delta > max_excess {
                max_excess = delta
                max_excess_cohort = c
                max_excess_w = j
                best_sync = W
            }
            j = j + 1
        }
        if cohort_went_super { n_super_cohorts = n_super_cohorts + 1 }
        c = c + 1
    }

    println("  --")
    println("  MAX EXCESS Δ = " + str(max_excess) + "  at " + cohort_label(max_excess_cohort) + " " + w_label(max_excess_w))
    println("  best sync_factor W = " + str(best_sync))
    println("  cohorts reaching Δ>0 (5-stream super-additive) = " + str(n_super_cohorts) + " / 5")

    // ── F635.1 DECOUPLED-ANCHOR: baseline Φ_pool(W=0) finite ≥ 0 each cohort ──
    let mut anchor_ok = true
    let mut k = 0
    while k < 5 {
        let p0 = phi_cohort(cohort_at(k), 0.0)
        if p0 < 0.0 { anchor_ok = false }
        k = k + 1
    }
    check("F635.1 DECOUPLED-ANCHOR: Φ_pool(W=0) ≥ 0 finite all 5 cohorts", anchor_ok)

    // ── F635.2 SUPER-ADDITIVITY (H1): max excess Δ > 0 ──
    let h1_supported = max_excess > 0.000001
    check("F635.2 SUPER-ADDITIVITY: max_excess Δ > 0 (across W>0, 5 cohorts)", h1_supported)

    // ── F635.3 SYNC-NONFLAT: Φ_collective not constant in W ──
    check("F635.3 SYNC-NONFLAT: Φ_collective varies with sync_factor W", any_nonflat)

    // ── F635.4 BOUNDS + DETERMINISM ──
    check("F635.4a BOUNDS: Φ ≥ 0 everywhere", bnd_ok)
    let d0 = phi_cohort([110, 110, 110, 110, 110], 0.5)
    let d1 = phi_cohort([110, 110, 110, 110, 110], 0.5)
    check("F635.4b DETERMINISM: phi_cohort(C1,W=0.5) re-run byte-identical", approx(d0, d1, 0.0))

    // ── F635.5 5-STREAM-GENERALIZES: ≥1 cohort super-additive ──
    check("F635.5 5-STREAM-GENERALIZES: ≥1 cohort reaches Δ>0 (H_609 survives 5-stream)", n_super_cohorts >= 1)

    // ── verdict ──
    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    println("  MAX EXCESS Δ = " + str(max_excess) + "  best sync W = " + str(best_sync))
    if h1_supported {
        println("  VERDICT: H1 SUPPORTED — 5-stream multilingual-cohort collective Φ is")
        println("           SUPER-ADDITIVE. Pooling 5 distinct lang-proxy streams at")
        println("           sync_factor W>0 yields Φ_collective > decoupled Σ-baseline")
        println("           on at least one cohort × W. The H_609 2-stream super-")
        println("           additivity GENERALIZES to the 5-stream lang axis.")
    } else {
        println("  VERDICT: H1 FALSIFIED — 5-stream collective Φ is NOT super-additive.")
        println("           Across all 5 cohorts × W>0, Φ_collective ≤ Σ-baseline")
        println("           (sub-additive) or sync-invariant (flat — coupling inert).")
    }
    println("================================================================")
    if FAIL > 0 { println("  (some falsifiers FAILed — see [FAIL] lines above)") }
}
