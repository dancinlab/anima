// ════════════════════════════════════════════════════════════════════════════
//  run_bridge_fp.hexa — H_axisg_bridge_fixedpoint
//    mining leaf L67 (ouroboros-bridge-self-trigger) — emit→Φ↑→next-gate
//    fixed-point convergence 의 substrate-class 의존성 (round 9 메타-축 후속)
//
//  CONTEXT
//    H_632 가 L67 을 OPEN 으로 명시: "self-referential Φ (mining L67) —
//    emit→Φ↑→next-gate 의 fixed-point convergence 측정" (미실행).
//    G1-G21 의 substrate-class arc 는 전부 STATIC sweep (convexity / closure-band
//    / Φ-magnitude / dΦ/dI-peak) — 본 H 는 처음으로 DYNAMICAL feedback map 의
//    fixed-point 을 측정한다.
//
//  FEEDBACK MAP (L67 의 formalization)
//    BRIDGE bridge_and_gate 의 Φ 가 emit 결정을 modulate 하고, emit 이 다시
//    substrate inhibition 을 낮춘다 (emit = activity → integration↑ → inhibition↓).
//    이를 1-D map 으로 모델:
//       I_{t+1} = g(I_t) = clamp01( I_t + alpha * (phi_star - PhiHat(I_t)) )
//    where PhiHat(I) = mean_big_phi(mixed_tpm(rule, n, I)) / Phi_ref  (normalized),
//          phi_star  = target normalized Φ (=0.5, Ψ=1/2 fixed-point anchor),
//          alpha     = feedback gain (=0.30).
//    PhiHat(I) 는 21-point grid 에서 한 번 측정(big_phi) → 이후 iteration 은
//    piecewise-linear interpolation 으로 phi-free (exact-Φ wall shard 양식, memory).
//    이 map 은 PhiHat(I*) = phi_star 인 I* 에 수렴해야 한다 (PhiHat(I) monotone-
//    decreasing → contraction near root).
//
//  HYPOTHESIS (substrate-class conditional convergence)
//    fixed-point 수렴 자체 (수렴 여부 · root 존재) 가 Wolfram class 의존:
//    complex/chaotic (110/30/54) 은 풍부한 Φ-range 로 root 존재 → 안정 수렴,
//    additive (90) 은 PhiHat≈0 평탄 → phi_star=0.5 root 부재 → 경계 stuck.
//
//  FALSIFIER
//    전 class 동일 수렴 거동 (class-invariant) → feedback dynamics 가
//    substrate-class 무관 (L67 의 universal fixed-point 주장 성립).
//
//  CRITERIA
//    M1 RULE110-CONVERGES : rule110 이 root 에 수렴 (converged==true)
//    M2 RULE90-NO-ROOT    : rule90 은 phi_star=0.5 root 부재 (max PhiHat < phi_star)
//    M3 CLASS-DEPENDENT   : 수렴 class 수 < 5 (universal 아님)
//    M4 BOUND/DET         : 모든 I_t ∈ [0,1], re-run byte-identical
//
//  VERDICT
//    SUPPORTED-NUMERICAL = M1 ∧ M2 ∧ M3
//    FALSIFIED           = !M3  (전 class 동일 → universal fixed-point)
//
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn _n() -> int { return 4 }
fn _alpha() -> float { return 0.30 }
fn _phi_star() -> float { return 0.5 }
fn _phi_ref() -> float { return 12.0 }   // Φ-normalization ref (rule110 Φ(0.05)≈12.4)
fn _max_iter() -> int { return 300 }
fn _tol() -> float { return 1.0e-3 }

fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}

fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn _clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

// 21-point uniform grid I = 0.00, 0.05, ..., 1.00
fn _grid() -> array {
    let mut g = []
    let mut i = 0
    while i < 21 {
        g = g.push(to_float(i) * 0.05)
        i = i + 1
    }
    return g
}

// precompute normalized PhiHat over the grid (the only big_phi work)
fn phi_table(rule: int, grid: array) -> array {
    let mut t = []
    let mut i = 0
    while i < len(grid) {
        let tpm = mixed_tpm(rule, _n(), grid[i])
        let mp = mean_big_phi(tpm, _n())
        t = t.push(mp / _phi_ref())
        i = i + 1
    }
    return t
}

// piecewise-linear interpolation of PhiHat at arbitrary I (grid step 0.05)
fn phi_interp(table: array, grid: array, x: float) -> float {
    let xx = _clamp01(x)
    let n = len(grid)
    if xx <= grid[0] { return table[0] }
    if xx >= grid[n-1] { return table[n-1] }
    let mut k = 0
    while k < n - 1 {
        if (xx >= grid[k]) && (xx <= grid[k+1]) {
            let frac = (xx - grid[k]) / (grid[k+1] - grid[k])
            return table[k] + frac * (table[k+1] - table[k])
        }
        k = k + 1
    }
    return table[n-1]
}

// iterate I_{t+1} = clamp(I_t + alpha*(phi_star - PhiHat(I_t)))
// returns [converged(0/1), n_iter, I_final, phi_hat_final, max_phi_hat]
fn run_feedback(table: array, grid: array) -> array {
    let mut i_t = 0.5
    let mut iter = 0
    let mut converged = 0
    let mut max_ph = table[0]
    let mut mi = 1
    while mi < len(table) {
        if table[mi] > max_ph { max_ph = table[mi] }
        mi = mi + 1
    }
    while iter < _max_iter() {
        let ph = phi_interp(table, grid, i_t)
        let resid = _phi_star() - ph
        if _abs(resid) < _tol() {
            converged = 1
            iter = iter + 1
            break
        }
        let i_next = _clamp01(i_t + _alpha() * resid)
        if _abs(i_next - i_t) < 1.0e-12 {
            iter = iter + 1
            break
        }
        i_t = i_next
        iter = iter + 1
    }
    let ph_final = phi_interp(table, grid, i_t)
    let mut cf = 0.0
    if converged == 1 { cf = 1.0 }
    return [cf, to_float(iter), i_t, ph_final, max_ph]
}

fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(xs) {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    return s + "]"
}

fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_axisg_bridge_fixedpoint — L67 emit→Φ→gate feedback fixed-point")
    println("  rules {30,54,90,110,184} · phi_star=0.5 · alpha=0.30 · 21-pt table")
    println("════════════════════════════════════════════════════════════")

    let grid = _grid()
    let rules = [30, 54, 90, 110, 184]
    let class_names = ["III-chaotic", "IV-complex", "III-additive",
                       "IV-complex", "II-particle"]

    let mut conv_arr = []
    let mut iter_arr = []
    let mut ifinal_arr = []
    let mut phfinal_arr = []
    let mut maxph_arr = []
    let mut noroot_arr = []

    let mut r = 0
    while r < len(rules) {
        let rule = rules[r]
        println("")
        println("── rule " + str(rule) + " (" + class_names[r] + ") ──")
        let table = phi_table(rule, grid)
        let res = run_feedback(table, grid)
        let cf = res[0]
        let nit = res[1]
        let ifin = res[2]
        let phfin = res[3]
        let maxph = res[4]
        let converged = cf > 0.5
        let no_root = maxph < _phi_star()

        conv_arr = conv_arr.push(cf)
        iter_arr = iter_arr.push(nit)
        ifinal_arr = ifinal_arr.push(ifin)
        phfinal_arr = phfinal_arr.push(phfin)
        maxph_arr = maxph_arr.push(maxph)
        let mut nrf = 0.0
        if no_root { nrf = 1.0 }
        noroot_arr = noroot_arr.push(nrf)

        println("  converged       = " + str(converged))
        println("  n_iter          = " + str(to_int(nit)))
        println("  I_final         = " + str(ifin))
        println("  phi_hat_final   = " + str(phfin) + "  (target " + str(_phi_star()) + ")")
        println("  max phi_hat     = " + str(maxph))
        println("  no_root (Φ<0.5) = " + str(no_root))
        r = r + 1
    }

    let mut n_conv = 0
    let mut ci = 0
    while ci < len(conv_arr) {
        if conv_arr[ci] > 0.5 { n_conv = n_conv + 1 }
        ci = ci + 1
    }
    let rule110_conv = conv_arr[3] > 0.5
    let rule90_noroot = noroot_arr[2] > 0.5

    let m1 = rule110_conv
    let m2 = rule90_noroot
    let m3 = n_conv < 5
    let mut m4 = true
    let mut fi = 0
    while fi < len(ifinal_arr) {
        if ifinal_arr[fi] < 0.0 { m4 = false }
        if ifinal_arr[fi] > 1.0 { m4 = false }
        fi = fi + 1
    }

    let mut m1f = 0
    if m1 { m1f = 1 }
    let mut m2f = 0
    if m2 { m2f = 1 }
    let mut m3f = 0
    if m3 { m3f = 1 }
    let mut m4f = 0
    if m4 { m4f = 1 }

    let class_invariant = n_conv == 5
    let class_dependent = (n_conv < 5) && rule90_noroot

    println("")
    println("════════════════════════════════════════════════════════════")
    println("── CLASS-DEPENDENCE TEST ──")
    println("  per-rule converged [30,54,90,110,184] = " + json_arr_f(conv_arr))
    println("  n_converged (of 5)  = " + str(n_conv))
    println("  rule110 converged   = " + str(rule110_conv))
    println("  rule90 no_root      = " + str(rule90_noroot))
    println("  class_invariant     = " + str(class_invariant) + "  (falsifier 발동)")
    println("  class_dependent     = " + str(class_dependent))
    println("")
    println("  M1 RULE110-CONVERGES = " + str(m1f))
    println("  M2 RULE90-NO-ROOT    = " + str(m2f))
    println("  M3 CLASS-DEPENDENT   = " + str(m3f))
    println("  M4 BOUND/DET         = " + str(m4f))

    let supported = m1 && m2 && m3
    let falsified = !m3
    let mut verdict_str = "PARTIAL"
    if supported { verdict_str = "SUPPORTED-NUMERICAL" }
    if falsified { verdict_str = "FALSIFIED" }
    println("")
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_axisg_bridge_fixedpoint\",\n"
    s = s + "  \"slug\": \"bridge-self-trigger-fixedpoint-substrate-class\",\n"
    s = s + "  \"mining_leaf\": \"L67 ouroboros-bridge-self-trigger\",\n"
    s = s + "  \"meta_axis\": \"round 9 — Wolfram class as consciousness-structure classifier (DYNAMICAL extension)\",\n"
    s = s + "  \"rules\": [30, 54, 90, 110, 184],\n"
    s = s + "  \"wolfram_classes\": [\"III-chaotic\", \"IV-complex\", \"III-additive\", \"IV-complex\", \"II-particle\"],\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"phi_star\": " + str(_phi_star()) + ",\n"
    s = s + "  \"alpha\": " + str(_alpha()) + ",\n"
    s = s + "  \"phi_ref\": " + str(_phi_ref()) + ",\n"
    s = s + "  \"converged\": " + json_arr_f(conv_arr) + ",\n"
    s = s + "  \"n_iter\": " + json_arr_f(iter_arr) + ",\n"
    s = s + "  \"I_final\": " + json_arr_f(ifinal_arr) + ",\n"
    s = s + "  \"phi_hat_final\": " + json_arr_f(phfinal_arr) + ",\n"
    s = s + "  \"max_phi_hat\": " + json_arr_f(maxph_arr) + ",\n"
    s = s + "  \"no_root\": " + json_arr_f(noroot_arr) + ",\n"
    s = s + "  \"n_converged\": " + str(n_conv) + ",\n"
    s = s + "  \"rule110_converged\": " + str(rule110_conv) + ",\n"
    s = s + "  \"rule90_no_root\": " + str(rule90_noroot) + ",\n"
    s = s + "  \"class_invariant\": " + str(class_invariant) + ",\n"
    s = s + "  \"class_dependent\": " + str(class_dependent) + ",\n"
    s = s + "  \"m1_rule110_converges\": " + str(m1f) + ",\n"
    s = s + "  \"m2_rule90_no_root\": " + str(m2f) + ",\n"
    s = s + "  \"m3_class_dependent\": " + str(m3f) + ",\n"
    s = s + "  \"m4_bound_det\": " + str(m4f) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"
    write_file("UNIVERSE/state/h_axisg_bridge_fixedpoint_2026_05_29/result.json", s)
    println("wrote result.json")
}
