// S12 city / aggregate — a weakly-coupled crowd forms no large complex.
// Hypothesis: a loosely-coupled aggregate (near-independent elements) has
//   big-Phi ~ 0 << a tightly-coupled substrate. "A city / a crowd is not one
//   mind" (IIT exclusion, weak-coupling frame; distinct from s10's FULLY
//   uncoupled trivial rules - here the SAME rule110 is swept toward
//   independence by raising inhibition I toward 1).
// Falsifier: aggregate Phi ~ tight Phi.
// substrate: ECA rule110 n=4, GZ inhibition I as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}
fn main() {
    let n = 4
    let tight = max_bigphi(110, n, 0.05)
    let mid = max_bigphi(110, n, 0.50)
    let loose = max_bigphi(110, n, 0.95)
    let mut ratio = 1.0
    if tight > 1.0e-9 { ratio = loose / tight }
    print("tight  I=0.05 Phi (one mind)   = "); println(tight)
    print("mid    I=0.50 Phi              = "); println(mid)
    print("loose  I=0.95 Phi (aggregate)  = "); println(loose)
    print("loose/tight ratio             = "); println(ratio)
    let pass = (loose < tight) && (mid < tight) && (ratio < 0.10) && (tight > 1.0)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = FALSIFIED") }
}
