// S27 DID — can TWO maximal complexes co-exist, or only one at a time?
// Measure: Phi of a sub-module alone (n=2), Phi of the WHOLE connected n=4, and
//   Phi of the n=4 with the cross-link CUT (severed). IIT exclusion: only ONE
//   maximal-Phi complex at a given grain.
// Hypothesis: exclusion permits at most one maximal complex at n=4 grain =>
//   "multiple personalities" are sequential, not simultaneous, complexes.
// Falsifier: two simultaneous EQUAL maximal complexes in one connected substrate.
// substrate: ECA rule110, GZ inhibition I=0.21232 as TPM scale (1-I).
import "stdlib/consciousness/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"

fn scale_tpm(t: array, factor: float) -> array {
    let mut out = []
    let mut i = 0
    while i < len(t) { out = out.push(t[i] * factor); i = i + 1 }
    return out
}
fn max_bigphi(rule: int, n: int, inhib: float) -> float {
    let tpm = scale_tpm(eca_tpm(rule, n), 1.0 - inhib)
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(tpm, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}
fn max_bigphi_tpm(t: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut best = 0.0
    let mut s = 0
    while s < full { let p = big_phi(t, n, s)[0]; if p > best { best = p }; s = s + 1 }
    return best
}
fn severed_tpm(rule: int) -> array {
    let n = 4
    let full = iit4_pow2(n)
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let g0 = (i / 2) * 2
            let lo = g0
            let hi = g0 + 1
            let mut li = lo
            if i == lo { li = hi }
            let mut ri = lo
            if i == lo { ri = hi }
            let l = iit4_bit(s, li)
            let c = iit4_bit(s, i)
            let r = iit4_bit(s, ri)
            let idx = 4 * l + 2 * c + r
            t = t.push(to_float(iit4_bit(rule, idx)))
            i = i + 1
        }
        s = s + 1
    }
    return t
}
fn main() {
    let I = 0.21232
    let sub = max_bigphi(110, 2, I)
    let whole = max_bigphi(110, 4, I)
    let severed = max_bigphi_tpm(scale_tpm(severed_tpm(110), 1.0 - I), 4)
    print("sub-module A=B Phi (n=2 each) = "); println(sub)
    print("whole n=4 (linked) Phi        = "); println(whole)
    print("severed n=4 (link cut) Phi    = "); println(severed)
    let single_max = (whole > sub) && (severed < whole)
    let pass = single_max && (whole > 14.0)
    if pass { println("  VERDICT = SUPPORTED-NUMERICAL") } else { println("  VERDICT = FALSIFIED") }
}
