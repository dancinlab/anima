// ════════════════════════════════════════════════════════════════════════════
// H_667 — wolfram-vs-curveshape-taxonomy  (H_664 N1 회수, axis G)
//   PHI-FREE AGGREGATE (no big_phi call, <1s) — re-classifies the 9-rule substrate
//   set by W-Φ CURVE SHAPE (monotone-rising / inverse-U / flat-die-out) instead of
//   by Wolfram class, then compares WITHIN-SHAPE variance vs WITHIN-WOLFRAM-CLASS
//   variance of two Φ-properties (convexity=norm_conv, magnitude=Φ_mean).
//
//   가설: 곡선형태로 재분류하면 같은-형태 내 Φ-속성 분산 < Wolfram-class 내 분산
//         (within-shape var ≪ within-class var) → 곡선형태가 더 tight 한 분류자.
//   Falsifier: 곡선형태 내 분산이 Wolfram-class 내 분산과 유사/초과 → 우월 아님.
//
//   9 Φ(W) curves = H_664/H_661 shards.log byte-identical 재인용 (동일
//   build_tpm_cohort engine, rule swap). NO big_phi call here (phi-free).
//   deterministic · hexa-only · $0 mac-local · foreground sync · NO RNG · NO GPU.
// ════════════════════════════════════════════════════════════════════════════

fn mean(xs: array) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < xs.len() { s = s + xs[i]; i = i + 1 }
    return s / to_float(xs.len())
}

// population variance (deterministic, /N)
fn variance(xs: array) -> float {
    if xs.len() == 0 { return 0.0 }
    let m = mean(xs)
    let mut s = 0.0
    let mut i = 0
    while i < xs.len() { let d = xs[i] - m; s = s + d * d; i = i + 1 }
    return s / to_float(xs.len())
}

fn maxv(xs: array) -> float {
    let mut m = xs[0]
    let mut i = 0
    while i < xs.len() { if xs[i] > m { m = xs[i] }; i = i + 1 }
    return m
}
fn minv(xs: array) -> float {
    let mut m = xs[0]
    let mut i = 0
    while i < xs.len() { if xs[i] < m { m = xs[i] }; i = i + 1 }
    return m
}
fn argmax_idx(xs: array) -> int {
    let mut m = xs[0]
    let mut mi = 0
    let mut i = 0
    while i < xs.len() { if xs[i] > m { m = xs[i]; mi = i }; i = i + 1 }
    return mi
}

// ── deterministic W-Φ curve-shape classifier ──────────────────────────────
//   input  : phi(W) array over the 6-pt W grid {0.15,0.40,0.55,0.70,0.95,1.0}
//   output : 0 = monotone-rising · 1 = inverse-U · 2 = flat/die-out
//   rule:
//     • die-out  → last value ≈ 0 (≤ 1% of peak)  ⇒ 2 (flat/die-out)
//     • inverse-U → interior peak (argmax not last) AND post-peak decline
//                   ≥ DECLINE_FRAC (15%) of peak                 ⇒ 1
//     • else (peak at last pt, OR top dip < 15%)                  ⇒ 0 (monotone-rising)
fn classify_shape(phi: array) -> int {
    let n = phi.len()
    let pk_idx = argmax_idx(phi)
    let pk_val = phi[pk_idx]
    let last = phi[n - 1]
    let DECLINE_FRAC = 0.15
    // die-out: ends ≈ 0
    if last <= 0.01 * pk_val { return 2 }
    // monotone if peak at last point
    if pk_idx == n - 1 { return 0 }
    // interior peak → measure post-peak decline (peak - last) / peak
    let decline = (pk_val - last) / pk_val
    if decline >= DECLINE_FRAC { return 1 }   // inverse-U (significant fall)
    return 0                                   // near-monotone top-saturating
}

fn main() {
    // ── 9 measured Φ(W) curves (byte-identical from H_664/H_661 shards.log) ──
    //   W grid = {0.15, 0.40, 0.55, 0.70, 0.95, 1.0}
    // class-III
    let phi_r30  = [0.315809, 1.18852, 2.07721, 3.4687, 8.13002, 9.72067]   // III chaotic
    let phi_r45  = [2.63487, 8.27371, 12.2652, 13.2937, 3.14416, 4.16786]   // III chaotic (W-비단조)
    let phi_r90  = [0.246475, 0.943149, 1.65498, 2.75808, 6.32388, 7.5]     // III XOR fractal
    let phi_r106 = [2.87266, 10.7046, 18.5147, 30.1267, 64.7249, 75.5306]   // III chaotic (NEW)
    let phi_r150 = [2.02096, 4.32671, 5.12111, 3.35834, 1.08369, 0.0]       // III XOR additive (die-out)
    // class-II
    let phi_r184 = [4.49492, 19.8846, 32.7523, 45.5429, 54.4631, 51.5361]   // II additive
    let phi_r226 = [4.42601, 19.859, 32.5702, 45.6283, 53.2586, 51.5361]    // II additive
    // class-IV
    let phi_r110 = [1.17498, 4.50052, 7.62552, 13.6383, 34.8823, 41.7124]   // IV complex
    let phi_r54  = [0.175125, 0.675972, 1.18881, 2.01568, 5.45395, 6.97263] // IV complex

    let all_phi  = [phi_r30, phi_r45, phi_r90, phi_r106, phi_r150, phi_r184, phi_r226, phi_r110, phi_r54]
    let rule_id  = [30, 45, 90, 106, 150, 184, 226, 110, 54]
    // Wolfram class index: 2=II, 3=III, 4=IV (matches the rule order above)
    let wclass   = [3, 3, 3, 3, 3, 2, 2, 4, 4]

    // ── Φ-property #1: norm_conv (convexity, H_660 측도) — shard verbatim ──
    let nc = [2.26615, 1.4608, 2.24029, 2.1531, 1.93118, 1.43674, 1.41354, 2.34922, 2.4745]
    // ── Φ-property #2: Φ_mean (magnitude) — shard PMEAN verbatim ──
    let pm = [4.15016, 7.29658, 3.23776, 33.7457, 2.6518, 34.779, 34.5464, 17.2557, 2.74703]

    let N = 9

    // ── classify each rule's curve shape ──
    let mut shape = []
    let mut i = 0
    while i < N { shape = shape + [classify_shape(all_phi[i])]; i = i + 1 }

    // shape label print
    println("=== H_667 curve-shape vs Wolfram-class taxonomy (phi-free) ===")
    println("shape: 0=monotone-rising  1=inverse-U  2=flat/die-out")
    i = 0
    while i < N {
        let sh = shape[i]
        let mut shlbl = "monotone"
        if sh == 1 { shlbl = "inverse-U" }
        if sh == 2 { shlbl = "die-out" }
        println("rule" + str(rule_id[i]) + " class-" + str(wclass[i]) + " shape=" + shlbl
                + " nc=" + to_string(nc[i]) + " phi_mean=" + to_string(pm[i]))
        i = i + 1
    }
    println("")

    // ── group norm_conv & phi_mean by SHAPE ──
    let mut nc_mono = []  let mut nc_invU = []  let mut nc_die = []
    let mut pm_mono = []  let mut pm_invU = []  let mut pm_die = []
    i = 0
    while i < N {
        let sh = shape[i]
        if sh == 0 { nc_mono = nc_mono + [nc[i]]; pm_mono = pm_mono + [pm[i]] }
        if sh == 1 { nc_invU = nc_invU + [nc[i]]; pm_invU = pm_invU + [pm[i]] }
        if sh == 2 { nc_die  = nc_die  + [nc[i]]; pm_die  = pm_die  + [pm[i]] }
        i = i + 1
    }

    // ── group norm_conv & phi_mean by WOLFRAM CLASS ──
    let mut nc_II = []  let mut nc_III = []  let mut nc_IV = []
    let mut pm_II = []  let mut pm_III = []  let mut pm_IV = []
    i = 0
    while i < N {
        let wc = wclass[i]
        if wc == 2 { nc_II  = nc_II  + [nc[i]]; pm_II  = pm_II  + [pm[i]] }
        if wc == 3 { nc_III = nc_III + [nc[i]]; pm_III = pm_III + [pm[i]] }
        if wc == 4 { nc_IV  = nc_IV  + [nc[i]]; pm_IV  = pm_IV  + [pm[i]] }
        i = i + 1
    }

    // ── group sizes ──
    println("-- shape groups --")
    println("monotone (n=" + str(nc_mono.len()) + "): rules with peak at W=1.0")
    println("inverse-U (n=" + str(nc_invU.len()) + ")")
    println("die-out (n=" + str(nc_die.len()) + ")")
    println("-- Wolfram class groups --")
    println("class-II (n=" + str(nc_II.len()) + ")  class-III (n=" + str(nc_III.len()) + ")  class-IV (n=" + str(nc_IV.len()) + ")")
    println("")

    // ── WITHIN-group variance: size-weighted pooled within-group var ──
    //   pooled = Σ (n_g · var_g) / Σ n_g  — total within-group dispersion.
    //   (die-out singleton var=0; inverse-U {45,150}; monotone {30,90,106,110,54,184,226})
    // CONVEXITY (norm_conv):
    let nc_within_shape =
        (to_float(nc_mono.len()) * variance(nc_mono)
       + to_float(nc_invU.len()) * variance(nc_invU)
       + to_float(nc_die.len())  * variance(nc_die)) / to_float(N)
    let nc_within_class =
        (to_float(nc_II.len())  * variance(nc_II)
       + to_float(nc_III.len()) * variance(nc_III)
       + to_float(nc_IV.len())  * variance(nc_IV)) / to_float(N)

    // MAGNITUDE (phi_mean):
    let pm_within_shape =
        (to_float(pm_mono.len()) * variance(pm_mono)
       + to_float(pm_invU.len()) * variance(pm_invU)
       + to_float(pm_die.len())  * variance(pm_die)) / to_float(N)
    let pm_within_class =
        (to_float(pm_II.len())  * variance(pm_II)
       + to_float(pm_III.len()) * variance(pm_III)
       + to_float(pm_IV.len())  * variance(pm_IV)) / to_float(N)

    // ── total variance (for fraction-explained) ──
    let nc_total = variance(nc)
    let pm_total = variance(pm)

    println("-- WITHIN-group variance (size-weighted pooled) --")
    println("[CONVEXITY norm_conv]")
    println("  within-SHAPE var = " + to_string(nc_within_shape))
    println("  within-CLASS var = " + to_string(nc_within_class))
    println("  total var        = " + to_string(nc_total))
    println("  shape/class ratio= " + to_string(nc_within_shape / (nc_within_class + 0.0000001)))
    println("[MAGNITUDE phi_mean]")
    println("  within-SHAPE var = " + to_string(pm_within_shape))
    println("  within-CLASS var = " + to_string(pm_within_class))
    println("  total var        = " + to_string(pm_total))
    println("  shape/class ratio= " + to_string(pm_within_shape / (pm_within_class + 0.0000001)))
    println("")

    // per-group convexity variance detail
    println("-- per-shape convexity var --")
    println("  monotone  mean=" + to_string(mean(nc_mono)) + " var=" + to_string(variance(nc_mono)) + " n=" + str(nc_mono.len()))
    println("  inverse-U mean=" + to_string(mean(nc_invU)) + " var=" + to_string(variance(nc_invU)) + " n=" + str(nc_invU.len()))
    println("  die-out   mean=" + to_string(mean(nc_die)) + " var=" + to_string(variance(nc_die)) + " n=" + str(nc_die.len()))
    println("-- per-Wolfram-class convexity var --")
    println("  class-II  mean=" + to_string(mean(nc_II)) + " var=" + to_string(variance(nc_II)) + " n=" + str(nc_II.len()))
    println("  class-III mean=" + to_string(mean(nc_III)) + " var=" + to_string(variance(nc_III)) + " n=" + str(nc_III.len()))
    println("  class-IV  mean=" + to_string(mean(nc_IV)) + " var=" + to_string(variance(nc_IV)) + " n=" + str(nc_IV.len()))
    println("")

    // ════════ pre-registered falsifier (frozen BEFORE running classifier) ════════
    // H1: 곡선형태 분류가 convexity 를 더 tight 하게 (within-shape < within-class)
    let f1 = nc_within_shape < nc_within_class
    // H2: 곡선형태 분류가 magnitude 도 더 tight 하게 (within-shape < within-class)
    let f2 = pm_within_shape < pm_within_class
    // H3 STRONG — convexity within-shape ≤ 0.5× within-class (절반 이하; "≪" claim)
    let f3 = nc_within_shape <= 0.5 * nc_within_class
    // H4 — monotone shape group convexity var < class-III convexity var
    //   (monotone group 이 class-III 보다 응집; H_664 의 class-III 이질성이 형태-혼합 탓임 증명)
    let f4 = variance(nc_mono) < variance(nc_III)
    // H5 — shape 분류가 Wolfram class 와 직교 (cross-class membership):
    //   monotone 그룹이 ≥2 Wolfram class 를 포함 (class-blind)
    let mut cls_in_mono = 0
    let mut has2 = false  let mut has3 = false  let mut has4 = false
    i = 0
    while i < N {
        if shape[i] == 0 {
            if wclass[i] == 2 { has2 = true }
            if wclass[i] == 3 { has3 = true }
            if wclass[i] == 4 { has4 = true }
        }
        i = i + 1
    }
    if has2 { cls_in_mono = cls_in_mono + 1 }
    if has3 { cls_in_mono = cls_in_mono + 1 }
    if has4 { cls_in_mono = cls_in_mono + 1 }
    let f5 = cls_in_mono >= 2
    // H6 BOUND — 全 통계 finite·non-neg
    let f6 = (nc_within_shape >= 0.0) && (nc_within_class >= 0.0)
          && (pm_within_shape >= 0.0) && (pm_within_class >= 0.0)

    let mut npass = 0
    if f1 { npass = npass + 1 }
    if f2 { npass = npass + 1 }
    if f3 { npass = npass + 1 }
    if f4 { npass = npass + 1 }
    if f5 { npass = npass + 1 }
    if f6 { npass = npass + 1 }

    println("────────── verdict ──────────")
    if f1 { println("[PASS] F667.1 CORE convexity within-shape < within-class : " + to_string(nc_within_shape) + " < " + to_string(nc_within_class)) }
    else  { println("[FAIL] F667.1 CORE convexity within-shape < within-class : " + to_string(nc_within_shape) + " >= " + to_string(nc_within_class)) }
    if f2 { println("[PASS] F667.2 magnitude within-shape < within-class : " + to_string(pm_within_shape) + " < " + to_string(pm_within_class)) }
    else  { println("[FAIL] F667.2 magnitude within-shape < within-class : " + to_string(pm_within_shape) + " >= " + to_string(pm_within_class)) }
    if f3 { println("[PASS] F667.3 STRONG convexity within-shape <= 0.5x within-class : " + to_string(nc_within_shape) + " <= " + to_string(0.5 * nc_within_class)) }
    else  { println("[FAIL] F667.3 STRONG convexity within-shape <= 0.5x within-class : " + to_string(nc_within_shape) + " > " + to_string(0.5 * nc_within_class)) }
    if f4 { println("[PASS] F667.4 monotone var < class-III var : " + to_string(variance(nc_mono)) + " < " + to_string(variance(nc_III))) }
    else  { println("[FAIL] F667.4 monotone var < class-III var : " + to_string(variance(nc_mono)) + " >= " + to_string(variance(nc_III))) }
    if f5 { println("[PASS] F667.5 ORTHOGONAL monotone group spans >=2 Wolfram class : " + str(cls_in_mono)) }
    else  { println("[FAIL] F667.5 ORTHOGONAL monotone group spans >=2 Wolfram class : " + str(cls_in_mono)) }
    if f6 { println("[PASS] F667.6 BOUND 全 통계 finite") }
    else  { println("[FAIL] F667.6 BOUND") }

    println("F667.1-6 " + to_string(npass) + "/6 PASS")
    let shape_tighter = f1 && f2
    println("shape_tighter_both_props=" + to_string(shape_tighter) + " orthogonal=" + to_string(f5))
}
