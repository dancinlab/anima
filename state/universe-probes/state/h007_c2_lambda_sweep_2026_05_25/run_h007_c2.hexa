// UNIVERSE/state/h007_c2_lambda_sweep_2026_05_25/run_h007_c2.hexa
// H_007 — cellular automaton consciousness · C2 Langton-λ continuous sweep (raw#12).
//
//   EXTENDS the C1 discrete-rule smoke (rule 250 / 30 / 110, commit 2026-05-23).
//   C1 compared three DISCRETE Wolfram-class representatives. C2 sweeps the
//   Langton activity parameter λ CONTINUOUSLY over a grid and localizes the λ*
//   at which integrated information Φ peaks — testing the edge-of-chaos
//   hypothesis that maximal Φ sits at a CRITICAL intermediate λ (chaos ↔ order
//   boundary), NOT at the quiescent (λ→0) or saturated (λ→1) extremes.
//
//   LANGTON λ (Langton 1990, "Computation at the edge of chaos"):
//     λ = fraction of an elementary-CA rule table's 8 neighborhood entries
//     that map to a NON-quiescent (active = 1) output. λ=0 ⇒ rule 0 (all dead,
//     ordered fixed point); λ=1 ⇒ rule 255 (all alive, saturated fixed point).
//     A deterministic λ-ordered rule family is built by activating the
//     neighborhood patterns in a FIXED canonical order (high-density patterns
//     first — the standard λ-parameterization), so that increasing λ adds
//     active entries monotonically through a single rule family.
//
//   GRID: λ ∈ {0.0, 0.125, 0.25, ..., 1.0} — 9 points = k_active/8 for
//     k_active ∈ {0,1,...,8}. (8 elementary-CA neighborhoods ⇒ λ is naturally
//     quantized in eighths; this is the FINEST exact λ grid for elem. CA — no
//     interpolation artifact. Reported as λ for continuity with the sweep.)
//
//   ENSEMBLE ESTIMATOR (key fix vs a single arbitrary rule per λ):
//     Langton's λ is a STATISTICAL parameter — at each λ there are C(8,k_active)
//     elementary rules sharing that activity. Φ(λ) is therefore estimated as
//     the MEAN Φ over the FULL ENSEMBLE of all C(8,k_active) rules at that λ
//     (max C(8,4)=70 rules; cheap), each averaged over the deterministic rep
//     set. This removes the "which single rule landed at λ" artifact and makes
//     Φ(λ) a property of λ itself. Fully deterministic (exhaustive, no RNG).
//
//   MEASURE: Φ(λ) ensemble mean at each grid point, then peak λ* = argmax_λ
//     Φ(λ); inverse-U shape test (peak strictly above both endpoints λ=0,λ=1).
//
//   CRITERIA (pre-registered — see H_007 .md C2 section):
//     C2.1  Φ(λ) peaks at an INTERIOR λ (Φ(λ*) > Φ(0) AND Φ(λ*) > Φ(1)).
//     C2.2  peak λ* lies in the edge-of-chaos band 0.3 ≤ λ* ≤ 0.7.
//     C2.3  cross-process determinism (re-run sha256-identical → checked
//           externally; in-process is single global RNG so not a det test).
//     C2 PASS = C2.1 ∧ C2.2.
//
//   Φ primitive: imported READ-ONLY from HEXAD/C/c_lib.hexa
//     (c_measure_phi → RFC 036 phi_spatial, byte-equal phi_rs native replica).
//   DISTINCT from H_157 (panpsychism META-CA fixed-point) — generic CA dynamics.
//   $0 mac local · deterministic · hexa-only · llm:none (raw#12 strict).
// ════════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a7d126aa2c78d9047/HEXAD/C/c_lib.hexa"

// ── config (deterministic) ──────────────────────────────────────────────────
fn _N() -> int    { return 16 }   // lattice length (periodic)
fn _DIM() -> int  { return 12 }   // recorded temporal-trajectory length / cell
fn _WARM() -> int { return 8 }    // warmup steps before recording
fn _REPS() -> int { return 5 }    // deterministic init reps (Φ = rep mean)
fn _state_dir() -> string {
    return "UNIVERSE/state/h007_c2_lambda_sweep_2026_05_25"
}

// ── small int helpers (kept tiny — hexa big-int multiply is fragile) ─────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

// ── Langton-λ rule ensemble ─────────────────────────────────────────────────
// An elementary CA rule = 8 output bits, one per neighborhood pattern idx 0..7
// where idx = l*4 + c*2 + r (l,c,r ∈ {0,1}). Langton's λ = (active entries)/8.
// At a given λ = k_active/8 there are C(8,k_active) rules sharing that activity.
// We treat λ as the STATISTICAL parameter it is: Φ(λ) = mean Φ over the FULL
// ensemble of all rules whose output bit-popcount equals k_active. Rule ints
// 0..255 are scanned; those with popcount == k_active form the λ-ensemble.

// popcount of the low 8 bits of `rule` (number of active output entries).
fn _popcount8(rule: int) -> int {
    let mut c = 0
    let mut b = 0
    while b < 8 {
        if (rule / _pow2(b)) % 2 == 1 { c = c + 1 }
        b = b + 1
    }
    return c
}

// elementary CA next-state: neighborhood (l,c,r) → bit `idx` of `rule`.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row for a given rep: site i set iff (i + rep) % 3 != 0.
// (identical to C1 smoke — same non-trivial substrate for every λ.)
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve length-N periodic elementary CA; record each site's `dim`-step
// trajectory (after `warm` warmup) into states[ site*dim + t ]. returns farr.
fn _run_ca(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)

    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// mean Φ for a rule over the fixed rep set.
fn _mean_phi(rule: int) -> float {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let nbins = c_phi_n_bins_default()
    let reps = _REPS()
    let mut sum = 0.0
    let mut rep = 0
    while rep < reps {
        let s = _run_ca(rule, n, dim, warm, rep)
        let phi = c_measure_phi(s, n, dim, nbins)
        sum = sum + phi
        let _ = farr_free(s)
        rep = rep + 1
    }
    return sum / to_float(reps)
}

// ensemble Φ(λ) for λ = k_active/8: MEAN of _mean_phi(rule) over every rule int
// 0..255 whose output-bit popcount == k_active (the full C(8,k_active) ensemble).
// Returns the ensemble mean Φ. n_rules is the ensemble size (out-param via dict).
fn _ensemble_phi(k_active: int) -> float {
    let mut sum = 0.0
    let mut cnt = 0
    let mut rule = 0
    while rule < 256 {
        if _popcount8(rule) == k_active {
            sum = sum + _mean_phi(rule)
            cnt = cnt + 1
        }
        rule = rule + 1
    }
    if cnt == 0 { return 0.0 }
    return sum / to_float(cnt)
}

// ensemble size C(8,k_active) — number of rules at this λ.
fn _ensemble_size(k_active: int) -> int {
    let mut cnt = 0
    let mut rule = 0
    while rule < 256 {
        if _popcount8(rule) == k_active { cnt = cnt + 1 }
        rule = rule + 1
    }
    return cnt
}

// int → float promotion (hexa has no direct cast builtin we rely on here;
// accumulate to stay overflow-free and explicit for small counts).
fn to_float(x: int) -> float {
    let mut f = 0.0
    let mut i = 0
    while i < x { f = f + 1.0; i = i + 1 }
    return f
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("H_007 — cellular automaton consciousness · C2 Langton-λ sweep (raw#12)")
    println("  N=" + to_string(_N()) + " dim=" + to_string(_DIM())
            + " warm=" + to_string(_WARM()) + " reps=" + to_string(_REPS())
            + "  (deterministic, $0 mac local)")
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (Φ>=0 by constr.)")
    println("  grid: λ = k_active/8 for k_active in 0..8 (finest exact elem-CA λ grid)")
    println("")

    // ── sweep λ over the 9-point grid (k_active 0..8), ensemble mean Φ ───────
    let n_pts = 9
    let phi_grid = farr_zeros(n_pts)       // ensemble-mean Φ(λ) curve
    let lam_grid = farr_zeros(n_pts)       // λ value per point
    let size_grid = farr_zeros(n_pts)      // ensemble size C(8,k) per point

    let mut k = 0
    while k < n_pts {
        let lam = to_float(k) / 8.0
        let sz = _ensemble_size(k)
        let phi = _ensemble_phi(k)
        let _ = farr_set(phi_grid, k, phi)
        let _ = farr_set(lam_grid, k, lam)
        let _ = farr_set(size_grid, k, to_float(sz))
        println("  λ=" + to_string(lam) + "  (k=" + to_string(k)
                + ", ensemble C(8," + to_string(k) + ")=" + to_string(sz)
                + ")   mean Φ = " + to_string(phi))
        k = k + 1
    }
    println("")

    // ── localize peak λ* = argmax Φ(λ) ───────────────────────────────────────
    let mut peak_idx = 0
    let mut peak_phi = farr_get(phi_grid, 0)
    let mut i = 1
    while i < n_pts {
        let v = farr_get(phi_grid, i)
        if v > peak_phi { peak_phi = v; peak_idx = i }
        i = i + 1
    }
    let peak_lam = farr_get(lam_grid, peak_idx)
    let phi_lo = farr_get(phi_grid, 0)            // Φ(λ=0) ordered/quiescent
    let phi_hi = farr_get(phi_grid, n_pts - 1)    // Φ(λ=1) saturated

    println("  peak λ* = " + to_string(peak_lam) + "  (idx=" + to_string(peak_idx)
            + ")   ensemble-mean Φ(λ*) = " + to_string(peak_phi))
    println("  Φ(λ=0 ordered)   = " + to_string(phi_lo))
    println("  Φ(λ=1 saturated) = " + to_string(phi_hi))
    println("")

    // ── pre-registered criteria ──────────────────────────────────────────────
    // C2.1: interior peak (strictly above BOTH endpoints) → inverse-U.
    let c21 = (peak_phi > phi_lo) && (peak_phi > phi_hi) && (peak_idx > 0) && (peak_idx < n_pts - 1)
    // C2.2: peak λ* in edge-of-chaos band 0.3 ≤ λ* ≤ 0.7.
    let c22 = (peak_lam >= 0.3) && (peak_lam <= 0.7)
    let pass = c21 && c22

    println("  C2.1 INTERIOR-PEAK  (Φ(λ*)>Φ(0) AND Φ(λ*)>Φ(1), λ* interior) : " + _bool_str(c21))
    println("  C2.2 EDGE-OF-CHAOS  (0.3 <= λ* <= 0.7)                        : " + _bool_str(c22))
    println("  C2.3 DETERMINISM    (cross-process sha256 — checked external) : N/A in-process")
    println("")
    println("  VERDICT_RULE: C2 PASS iff C2.1 (interior inverse-U peak) AND C2.2 (λ* in 0.3..0.7)")
    println("  C2 VERDICT  : " + _verdict(pass))

    // ── write result.json ────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_007\",\n"
    j = j + "  \"criterion\": \"C2\",\n"
    j = j + "  \"slug\": \"cellular-automaton-consciousness\",\n"
    j = j + "  \"date\": \"2026-05-25\",\n"
    j = j + "  \"title\": \"Langton-lambda continuous sweep — Phi(lambda) peak localization\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (HEXAD/C/c_lib.hexa c_measure_phi, byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": { \"N\": " + to_string(_N()) + ", \"dim\": " + to_string(_DIM())
          + ", \"warm\": " + to_string(_WARM()) + ", \"reps\": " + to_string(_REPS())
          + ", \"n_bins\": " + to_string(c_phi_n_bins_default()) + ", \"boundary\": \"periodic\" },\n"
    j = j + "  \"lambda_param\": \"Langton activity = k_active/8; Phi(lambda) = MEAN Phi over the full ensemble of all C(8,k_active) rules with that output-bit popcount (exhaustive, deterministic)\",\n"
    j = j + "  \"estimator\": \"ensemble mean over C(8,k) elementary rules per lambda (NOT a single arbitrary rule)\",\n"
    j = j + "  \"grid\": [\n"
    let mut g = 0
    while g < n_pts {
        let lam = farr_get(lam_grid, g)
        let sz = farr_get(size_grid, g).to_int()
        let ph = farr_get(phi_grid, g)
        j = j + "    { \"k_active\": " + to_string(g) + ", \"lambda\": " + to_string(lam)
              + ", \"ensemble_size\": " + to_string(sz) + ", \"phi_mean\": " + to_string(ph) + " }"
        if g < n_pts - 1 { j = j + "," }
        j = j + "\n"
        g = g + 1
    }
    j = j + "  ],\n"
    j = j + "  \"peak\": { \"lambda_star\": " + to_string(peak_lam) + ", \"idx\": " + to_string(peak_idx)
          + ", \"phi_mean\": " + to_string(peak_phi) + " },\n"
    j = j + "  \"endpoints\": { \"phi_lambda0_ordered\": " + to_string(phi_lo)
          + ", \"phi_lambda1_saturated\": " + to_string(phi_hi) + " },\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C2_1_INTERIOR_PEAK\": { \"metric\": \"Phi(lambda*)>Phi(0) AND Phi(lambda*)>Phi(1), lambda* interior\", \"verdict\": \"" + _verdict(c21) + "\" },\n"
    j = j + "    \"C2_2_EDGE_OF_CHAOS\": { \"metric\": \"0.3<=lambda*<=0.7\", \"lambda_star\": " + to_string(peak_lam) + ", \"verdict\": \"" + _verdict(c22) + "\" },\n"
    j = j + "    \"C2_3_DETERMINISM\": { \"metric\": \"cross-process sha256-identical (external)\", \"verdict\": \"N/A in-process\" }\n"
    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"C2 PASS iff C2.1 (interior inverse-U peak) AND C2.2 (lambda* in 0.3..0.7)\",\n"
    j = j + "  \"verdict\": \"" + _verdict(pass) + "\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("  result.json written → " + _state_dir() + "/result.json")
    println("=== H_007 C2 Langton-λ sweep complete: " + _verdict(pass) + " ===")
}
