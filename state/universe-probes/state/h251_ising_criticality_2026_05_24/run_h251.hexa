// UNIVERSE/state/h251_ising_criticality_2026_05_24/run_h251.hexa
//
//   H_251 — 2D Ising 모델 phase-transition 근처 phi_spatial Φ scaling
//   (raw#12, deterministic, hexa-only, $0 mac local, llm:none).
//
//   QUESTION (pre-registered):
//     2D Ising spin lattice (N=16×16) 의 Metropolis dynamics 위 temperature
//     T sweep 에서 Φ(T) 가 critical T_c ≈ 2.2692 (Onsager exact) 부근에서
//     peak (inverse-U) 인가? — H_007 1D-rule110 edge-of-chaos peak 의
//     2D-lattice 일반화; H_217 cross-substrate phase-transition family 의
//     4th substrate.
//
//   MODEL — 2D Ising N=16×16 periodic square lattice
//     H = -J Σ_<i,j> s_i s_j, J=1.0, s_i ∈ {-1, +1}, 4 nearest neighbors
//     (periodic boundary)
//     Metropolis update: random site i (LCG), ΔE = 2·J·s_i·Σ_NN s_j,
//       accept iff ΔE ≤ 0 OR LCG_uniform() < exp(-ΔE/T)
//     Equilibration: STEPS_EQ=200 single-spin-flip-attempts per T
//     Recording: dim=12 frames, frame-interval=64 attempts (≈ N×16 sweep)
//
//   MEASUREMENT — Φ via RFC 036 phi_spatial (H_007 / H_204 / H_217 carry):
//     row-major flatten 16×16 → 256 cells × dim=12 frames flat farr
//     phi_spatial(states, 256, 12, n_bins=4) → Φ ≥ 0
//
//   VERDICT (pre-registered):
//     C1 SINGLE_PEAK : interior peak (not T=1.0 or T=4.0 boundary)
//     C2 PEAK_NEAR_TC: peak T* ∈ [1.8, 2.7] (T_c=2.2692 ±20%)
//     C3 ORDERED_LOW: Φ(T=1.0) < Φ(T*) AND Φ(T=4.0) < Φ(T*)
//     C4 BYTE_IDENT : re-run T=2.27 measurement byte-equal
//
//     SUPPORTED iff C1 + C2 + C3 ALL PASS.
//     PARTIAL_DIRECTIONAL if C1 PASS AND (C2 OR C3) PASS.
//     FAIL if C1 FAIL.
//     FALSIFIED if F1-F5 any TRIGGERED.
//
//   HONEST TIER: 🟢 SUPPORTED-NUMERICAL (phi_spatial proxy + Ising sweep,
//   NOT 🔵 formal IIT 4.0). Single-replicate per T (deterministic LCG),
//   finite-size N=16×16 (smoothed peak, no true divergence) — Onsager
//   T_c=2.2692 의 *5-10% shift* absorption 위해 ±20% margin 설정.
// ════════════════════════════════════════════════════════════════════════

// ── config (deterministic, pre-registered) ────────────────────────────────
fn LATT_SIDE() -> int    { return 16 }    // 16×16 = 256 sites
fn N_CELLS() -> int      { return 256 }   // LATT_SIDE * LATT_SIDE
fn DIM() -> int          { return 12 }    // frames recorded per site
fn STEPS_EQ() -> int     { return 200 }   // equilibration flip attempts
fn FRAME_INT() -> int    { return 64 }    // attempts between recorded frames
fn N_BINS() -> int       { return 4 }     // phi_spatial binning (RFC 036)
fn SEED_BASE() -> int    { return 0xC0DE251 }
fn LCG_A() -> int        { return 1103515245 }   // POSIX glibc rand48 multiplier
fn LCG_C() -> int        { return 12345 }
fn LCG_M() -> int        { return 2147483648 }   // 2^31
fn J_COUPLING() -> float { return 1.0 }

fn _state_dir() -> string {
    return "/tmp/anima-h251-ising/UNIVERSE/state/h251_ising_criticality_2026_05_24"
}

// ── small helpers ─────────────────────────────────────────────────────────
fn to_float(x: int) -> float { return x * 1.0 }

fn _abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

fn _abs_i(x: int) -> int { if x < 0 { return 0 - x }; return x }

// LCG advance: returns new seed (always non-negative)
fn _lcg_next(seed: int) -> int {
    let s = (seed * LCG_A() + LCG_C()) % LCG_M()
    return _abs_i(s)
}

// LCG uniform float in [0, 1) — derived from LCG state
fn _lcg_uniform(seed: int) -> float {
    return to_float(seed) / to_float(LCG_M())
}

// Taylor-series exp(x) for x ∈ [-8, 0] (sufficient for Metropolis ΔE/T)
// 32-term truncation gives <1e-9 absolute error for |x| ≤ 8
fn _exp_neg(x: float) -> float {
    // x is ≤ 0 expected; if x > 0 just return 1.0 (accepted anyway)
    if x >= 0.0 { return 1.0 }
    let mut term = 1.0
    let mut sum = 1.0
    let mut k = 1
    while k < 32 {
        term = term * x / to_float(k)
        sum = sum + term
        k = k + 1
    }
    if sum < 0.0 { return 0.0 }    // numeric safety
    return sum
}

// row-major 2D index: (r, c) → r * LATT_SIDE + c
fn _idx_2d(r: int, c: int) -> int {
    let side = LATT_SIDE()
    let rp = ((r % side) + side) % side
    let cp = ((c % side) + side) % side
    return rp * side + cp
}

// neighbor sum (4 NN, periodic) at site (r, c)
fn _nn_sum(lattice: int, r: int, c: int) -> float {
    let nr1 = farr_get(lattice, _idx_2d(r - 1, c))
    let nr2 = farr_get(lattice, _idx_2d(r + 1, c))
    let nc1 = farr_get(lattice, _idx_2d(r, c - 1))
    let nc2 = farr_get(lattice, _idx_2d(r, c + 1))
    return nr1 + nr2 + nc1 + nc2
}

// initialize lattice — deterministic checkerboard (avoids trivial all-up):
// site (r, c) initial spin = +1 if (r + c) % 2 == 0 else -1.
// Metropolis equilibrates regardless of init (Markov chain ergodic), so this
// just gives every T the SAME starting configuration for fair byte-equal.
fn _init_lattice() -> int {
    let n = N_CELLS()
    let side = LATT_SIDE()
    let lat = farr_zeros(n)
    let mut r = 0
    while r < side {
        let mut c = 0
        while c < side {
            let idx = r * side + c
            if ((r + c) % 2) == 0 {
                let _ = farr_set(lat, idx, 1.0)
            } else {
                let _ = farr_set(lat, idx, 0.0 - 1.0)
            }
            c = c + 1
        }
        r = r + 1
    }
    return lat
}

// One Metropolis flip attempt — random site (LCG), accept/reject by ΔE/T.
// Returns updated seed (caller threads through).
fn _metropolis_step(lattice: int, t_temp: float, seed_in: int) -> int {
    let side = LATT_SIDE()
    // advance seed twice — once for row pick, once for col pick
    let s1 = _lcg_next(seed_in)
    let s2 = _lcg_next(s1)
    let r = s1 % side
    let c = s2 % side
    let idx = r * side + c
    let s_i = farr_get(lattice, r * side + c)
    let nn = _nn_sum(lattice, r, c)
    // ΔE = 2 · J · s_i · nn_sum  (flip 시 에너지 변화)
    let delta_e = 2.0 * J_COUPLING() * s_i * nn

    // acceptance
    let s3 = _lcg_next(s2)
    let u = _lcg_uniform(s3)
    let mut accept = false
    if delta_e <= 0.0 {
        accept = true
    } else {
        let p_acc = _exp_neg(0.0 - delta_e / t_temp)
        if u < p_acc { accept = true }
    }
    if accept {
        let _ = farr_set(lattice, idx, 0.0 - s_i)
    }
    return s3
}

// Run 2D Ising at given T: equilibrate STEPS_EQ attempts, then record dim
// frames each separated by FRAME_INT attempts. Returns flat (256 × dim) farr
// (states[site*dim + t]) for phi_spatial.
fn _run_ising(t_temp: float, seed_init: int) -> int {
    let n = N_CELLS()
    let dim = DIM()
    let lat = _init_lattice()
    let mut seed = seed_init

    // equilibration
    let mut step = 0
    while step < STEPS_EQ() {
        seed = _metropolis_step(lat, t_temp, seed)
        step = step + 1
    }

    // record dim frames, frame-interval flip attempts apart
    let states = farr_zeros(n * dim)
    let mut frame = 0
    while frame < dim {
        // record current lattice into frame `frame`
        let mut s = 0
        while s < n {
            let _ = farr_set(states, s * dim + frame, farr_get(lat, s))
            s = s + 1
        }
        // advance FRAME_INT attempts
        if frame < dim - 1 {
            let mut k = 0
            while k < FRAME_INT() {
                seed = _metropolis_step(lat, t_temp, seed)
                k = k + 1
            }
        }
        frame = frame + 1
    }

    let _ = farr_free(lat)
    return states
}

// Φ at temperature T (single-replicate, deterministic LCG)
fn _phi_at_t(t_temp: float, seed_init: int) -> float {
    let states = _run_ising(t_temp, seed_init)
    let phi = phi_spatial(states, N_CELLS(), DIM(), N_BINS())
    let _ = farr_free(states)
    return phi
}

fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict_str(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn main() {
    println("H_251 — 2D Ising criticality Φ peak (T sweep) · raw#12")
    println("  model: 2D Ising 16×16 periodic, Metropolis dynamics, deterministic LCG")
    println("  N_CELLS=" + to_string(N_CELLS()) + " DIM=" + to_string(DIM())
            + " STEPS_EQ=" + to_string(STEPS_EQ()) + " FRAME_INT=" + to_string(FRAME_INT())
            + " J=" + to_string(J_COUPLING()) + " SEED_BASE=" + to_string(SEED_BASE()))
    println("  Φ primitive: RFC 036 phi_spatial (n_bins=" + to_string(N_BINS()) + ") — 🟢 NUMERICAL")
    println("  Onsager T_c (N→∞ exact) ≈ 2.2692  (J/k_B units)")
    println("")

    // ── 5-point T sweep (pre-registered, frozen) ──────────────────────────
    let t0 = 1.0
    let t1 = 2.0
    let t2 = 2.27
    let t3 = 2.5
    let t4 = 4.0

    // each T gets the SAME init seed for byte-equal fairness
    let s_init = SEED_BASE()
    let phi0 = _phi_at_t(t0, s_init)
    let phi1 = _phi_at_t(t1, s_init)
    let phi2 = _phi_at_t(t2, s_init)
    let phi3 = _phi_at_t(t3, s_init)
    let phi4 = _phi_at_t(t4, s_init)

    println("  Φ(T=1.00 frozen ordered  ) = " + to_string(phi0))
    println("  Φ(T=2.00 sub-critical    ) = " + to_string(phi1))
    println("  Φ(T=2.27 ≈T_c            ) = " + to_string(phi2))
    println("  Φ(T=2.50 super-critical  ) = " + to_string(phi3))
    println("  Φ(T=4.00 chaotic disord. ) = " + to_string(phi4))

    // determinism re-check at T=2.27
    let phi2_re = _phi_at_t(t2, s_init)
    let det_ok = phi2_re == phi2
    println("  Φ(T=2.27 re-run)            = " + to_string(phi2_re)
            + "  (byte-equal=" + _bool_str(det_ok) + ")")
    println("")

    // ── peak T* identification ─────────────────────────────────────────────
    let mut peak_phi = phi0
    let mut peak_t = t0
    let mut peak_idx = 0
    if phi1 > peak_phi { peak_phi = phi1; peak_t = t1; peak_idx = 1 }
    if phi2 > peak_phi { peak_phi = phi2; peak_t = t2; peak_idx = 2 }
    if phi3 > peak_phi { peak_phi = phi3; peak_t = t3; peak_idx = 3 }
    if phi4 > peak_phi { peak_phi = phi4; peak_t = t4; peak_idx = 4 }

    println("  peak Φ = " + to_string(peak_phi) + " at T* = " + to_string(peak_t)
            + "  (idx=" + to_string(peak_idx) + ")")
    println("")

    // ── criteria (pre-registered, measurable) ─────────────────────────────
    // C1 SINGLE_PEAK: peak NOT at T=1.0 (idx=0) nor T=4.0 (idx=4) — interior
    let c1 = (peak_idx != 0) && (peak_idx != 4)

    // C2 PEAK_NEAR_TC: peak T* ∈ [1.8, 2.7] (T_c=2.2692 ±20%)
    let c2 = (peak_t >= 1.8) && (peak_t <= 2.7)

    // C3 ORDERED_LOW: Φ(T=1.0) < peak_phi AND Φ(T=4.0) < peak_phi
    let c3 = (phi0 < peak_phi) && (phi4 < peak_phi)

    // C4 BYTE_IDENT: re-run T=2.27 byte-equal
    let c4 = det_ok

    // ── falsifiers ────────────────────────────────────────────────────────
    // F1 MONOTONE — strict monotone (no peak)
    let mono_inc = (phi1 >= phi0) && (phi2 >= phi1) && (phi3 >= phi2) && (phi4 >= phi3)
    let mono_dec = (phi1 <= phi0) && (phi2 <= phi1) && (phi3 <= phi2) && (phi4 <= phi3)
    let f1 = mono_inc || mono_dec

    // F2 BOUNDARY_PEAK — peak at T=1.0 or T=4.0
    let f2 = (peak_idx == 0) || (peak_idx == 4)

    // F3 PEAK_FAR_TC — peak T* outside [1.135, 3.404] (>50% off T_c=2.2692)
    let f3 = (peak_t < 1.135) || (peak_t > 3.404)

    // F4 BYTE_DIFF — re-run differs
    let f4 = (det_ok == false)

    // F5 PHI_INVALID — any Φ < 0
    let f5 = (phi0 < 0.0) || (phi1 < 0.0) || (phi2 < 0.0) || (phi3 < 0.0) || (phi4 < 0.0)

    let any_falsifier = f1 || f2 || f3 || f4 || f5

    // verdict
    let n_pass = (if c1 { 1 } else { 0 }) + (if c2 { 1 } else { 0 })
               + (if c3 { 1 } else { 0 }) + (if c4 { 1 } else { 0 })
    let mut verdict = "FAIL"
    if any_falsifier {
        verdict = "FALSIFIED"
    } else {
        if c1 && c2 && c3 {
            verdict = "SUPPORTED"
        } else {
            if c1 && (c2 || c3) {
                verdict = "PARTIAL_DIRECTIONAL"
            } else {
                verdict = "FAIL"
            }
        }
    }

    println("  C1 SINGLE_PEAK (peak interior, idx∉{0,4})         : " + _verdict_str(c1)
            + "  (peak_idx=" + to_string(peak_idx) + ")")
    println("  C2 PEAK_NEAR_TC (peak T* ∈ [1.8, 2.7])              : " + _verdict_str(c2)
            + "  (T*=" + to_string(peak_t) + ")")
    println("  C3 ORDERED_LOW (Φ(T=1.0)<peak AND Φ(T=4.0)<peak)    : " + _verdict_str(c3))
    println("  C4 BYTE_IDENT  (re-run T=2.27 byte-equal)            : " + _verdict_str(c4))
    println("")
    println("  F1 MONOTONE      (no peak)                          : " + _bool_str(f1))
    println("  F2 BOUNDARY_PEAK (peak at T=1.0 or T=4.0)           : " + _bool_str(f2))
    println("  F3 PEAK_FAR_TC   (peak T* outside [1.135, 3.404])   : " + _bool_str(f3))
    println("  F4 BYTE_DIFF     (re-run differs)                   : " + _bool_str(f4))
    println("  F5 PHI_INVALID   (any Φ < 0)                        : " + _bool_str(f5))
    println("")
    println("  VERDICT_RULE: SUPPORTED iff C1+C2+C3 PASS; PARTIAL_DIRECTIONAL if C1 PASS AND (C2 OR C3); FAIL if C1 FAIL; FALSIFIED if any F1-F5 TRIGGERED")
    println("  VERDICT (H_251 Ising criticality): " + verdict)
    println("    criteria_met = " + to_string(n_pass) + "/4")
    println("  H251_VERDICT=" + verdict + " N_PASS=" + to_string(n_pass)
            + " PEAK_T=" + to_string(peak_t) + " PEAK_PHI=" + to_string(peak_phi)
            + " PHI_T1=" + to_string(phi0) + " PHI_T4=" + to_string(phi4))

    // ── write result.json ────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_251\",\n"
    j = j + "  \"slug\": \"ising-criticality\",\n"
    j = j + "  \"date\": \"2026-05-24\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial (byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": { \"lattice_side\": " + to_string(LATT_SIDE())
          + ", \"n_cells\": " + to_string(N_CELLS())
          + ", \"dim\": " + to_string(DIM())
          + ", \"steps_eq\": " + to_string(STEPS_EQ())
          + ", \"frame_interval\": " + to_string(FRAME_INT())
          + ", \"n_bins\": " + to_string(N_BINS())
          + ", \"J\": " + to_string(J_COUPLING())
          + ", \"seed_base\": " + to_string(SEED_BASE())
          + ", \"boundary\": \"periodic\" },\n"
    j = j + "  \"T_c_onsager\": 2.2692,\n"
    j = j + "  \"T_sweep\": [1.0, 2.0, 2.27, 2.5, 4.0],\n"
    j = j + "  \"phi_at_T\": {\n"
    j = j + "    \"T_1.00_frozen\":       " + to_string(phi0) + ",\n"
    j = j + "    \"T_2.00_subcritical\":  " + to_string(phi1) + ",\n"
    j = j + "    \"T_2.27_near_Tc\":      " + to_string(phi2) + ",\n"
    j = j + "    \"T_2.50_supercritical\":" + to_string(phi3) + ",\n"
    j = j + "    \"T_4.00_chaotic\":      " + to_string(phi4) + "\n"
    j = j + "  },\n"
    j = j + "  \"phi_T_2.27_rerun\": " + to_string(phi2_re) + ",\n"
    j = j + "  \"peak_T\": " + to_string(peak_t) + ",\n"
    j = j + "  \"peak_phi\": " + to_string(peak_phi) + ",\n"
    j = j + "  \"peak_idx\": " + to_string(peak_idx) + ",\n"
    j = j + "  \"criteria\": {\n"
    j = j + "    \"C1_SINGLE_PEAK\":  { \"verdict\": \"" + _verdict_str(c1) + "\", \"peak_idx\": " + to_string(peak_idx) + " },\n"
    j = j + "    \"C2_PEAK_NEAR_TC\": { \"verdict\": \"" + _verdict_str(c2) + "\", \"peak_T\": " + to_string(peak_t) + ", \"window\": [1.8, 2.7] },\n"
    j = j + "    \"C3_ORDERED_LOW\":  { \"verdict\": \"" + _verdict_str(c3) + "\", \"phi_T1\": " + to_string(phi0) + ", \"phi_T4\": " + to_string(phi4) + " },\n"
    j = j + "    \"C4_BYTE_IDENT\":   { \"verdict\": \"" + _verdict_str(c4) + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_MONOTONE\":      { \"triggered\": " + _bool_str(f1) + " },\n"
    j = j + "    \"F2_BOUNDARY_PEAK\": { \"triggered\": " + _bool_str(f2) + " },\n"
    j = j + "    \"F3_PEAK_FAR_TC\":   { \"triggered\": " + _bool_str(f3) + " },\n"
    j = j + "    \"F4_BYTE_DIFF\":     { \"triggered\": " + _bool_str(f4) + " },\n"
    j = j + "    \"F5_PHI_INVALID\":   { \"triggered\": " + _bool_str(f5) + " }\n"
    j = j + "  },\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED iff C1+C2+C3 PASS; PARTIAL_DIRECTIONAL if C1 PASS AND (C2 OR C3); FAIL if C1 FAIL; FALSIFIED if any F1-F5 TRIGGERED\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"criteria_met\": " + to_string(n_pass) + ",\n"
    j = j + "  \"honest_tier\": \"🟢 SUPPORTED-NUMERICAL (phi_spatial RFC 036 native; NOT 🔵 formal IIT 4.0)\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("  result.json → " + _state_dir() + "/result.json")
    println("=== H_251 2D Ising criticality smoke complete: " + verdict + " ===")
}
