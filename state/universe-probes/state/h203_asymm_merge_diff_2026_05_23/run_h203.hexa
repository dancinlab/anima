// ════════════════════════════════════════════════════════════════════════════
//  run_h203.hexa — H_203 Asymmetric Merge Differentiation smoke
//
//  PURPOSE
//    UNIVERSE H_203 (NEW) pre-register-frozen 검증 smoke. H_054 의 symmetric
//    MERGE (host-keeper weight = (w_a + w_b)/2, 정보 평균-통합) 의
//    asymmetric variant 를 3 modes 로 cross-비교한다:
//        (a) symmetric             — w_new = 0.5*(w_a + w_b)           (H_054 default)
//        (b) asymmetric_preserve_a — w_new = w_a + w_b   (mass-add, A side keeps id)
//        (c) asymmetric_preserve_b — w_new = w_b + w_a   (mass-add, B side keeps id; mirror)
//
//    측정 (per arm, 50-step horizon, pool init=8):
//      • variance      = 모든 final cell engine_a_W 벡터의 L2 norm 의 variance.
//      • diversity_idx = L2-norm bin (bin_width=0.5) 별 distinct bin 수.
//      • mass_max_err  = single-merge 의 directly-measured |post - (pre_a+pre_b)|
//                        의 max element-wise abs diff (mass conservation invariant).
//
//    가설 테마: asymmetric merge (host 측 weight 전부 보존 + endosymbiont 측
//    weight 흡수, mass-add) 가 symmetric merge (weighted-avg) 대비 long-term
//    pool 안 cell-type heterogeneity (variance + diversity index) 를 증가
//    시킨다 — Margulis endosymbiosis 의 host-preserve variant.
//
//  OPERATIONAL ASYMMETRY DEFINITION (raw#9/10 HONEST)
//    substrate `merge_cells` (mitosis_hook_lib.hexa L468) 는 symmetric only
//    (0.5*(a+b)) — H_054 default. asymmetric variant 는 harness 에서 직접
//    구현: 두 donor weight farr 를 element-wise add 하여 keeper 쪽에 set.
//    parent 보존은 (preserve_a) keeper = older-id rule 의 자연 결과, OR
//    (preserve_b) reversed rule. 추가 mutation/decay 없음.
//
//  DETERMINISM
//    __HEXA_FARR_GAUSS_SEED__=42 (initial weight gaussian 재현) + 고정
//    synthetic input → 매 step k%4==0 (k≥4) 마다 cell_a=lowest_id +
//    cell_b=next_id 를 골라 merge 시도. LLM none. $0 mac local.
//
//  RUN
//    hexa parse UNIVERSE/state/h203_asymm_merge_diff_2026_05_23/run_h203.hexa
//    __HEXA_FARR_GAUSS_SEED__=42 HEXA_MEM_UNLIMITED=1 \
//        hexa run UNIVERSE/state/h203_asymm_merge_diff_2026_05_23/run_h203.hexa
//
//  FALSIFIERS (raw#12 ≥5, measurable)
//    F1 DIVERSITY-VAR    : variance_asym  ≤ variance_sym (asym 분기가 variance
//                          를 더 만들지 못함) → H203.1 FALSIFIED.
//    F2 PRESERVE-FROZEN  : preserved cell engine_a_W max abs diff (vs pre-merge
//                          snapshot) > 1e-6 → H203.2 FALSIFIED (preserve 가
//                          frozen-like 아니라는 뜻).
//    F3 MASS-CONS        : |keeper_post[i] - (pre_a[i]+pre_b[i])| > 1e-6 (single
//                          asymmetric merge) → H203.3 FALSIFIED (substrate error).
//    F4 DIV-IDX          : diversity_idx_asym ≤ diversity_idx_sym at step=50
//                          → H203.4 FALSIFIED (differentiation 효과 부재).
//    F5 SYM-NO-INCREASE  : symmetric arm 의 diversity_idx 가 pre→post 증가
//                          → H203.5 FALSIFIED (control 자체에서 differentiation
//                          발생 — asymmetric 의 차별성 없음).
//    F6 (meta)           : post-hoc edit → raw#12 violation, raw#82 retraction.
//
//  VERDICT_RULE
//    SUPPORTED = C1+C2+C3+C4+C5 ALL PASS (5/5)
//    PARTIAL   = 3-4/5 PASS
//    FAIL      = ≤2/5
//
//  COMPLIANCE  raw#11 snake_case · raw#15 no-hardcode · raw#9/10 honest
//              operational-asymmetry · raw#12 deterministic · hexa-only
// ════════════════════════════════════════════════════════════════════════════


import "/private/tmp/anima_h203/tool/hexa_native/mitosis_hook_lib.hexa"


// ── §0 frozen configuration ──────────────────────────────────────────────────

let MASTER_SEED  = 203000203
let D_MODEL      = 4              // weight_n = 16 (selftest scale)
let INITIAL_N    = 8              // initial pool size
let N_STEPS      = 50             // long-term horizon
let MERGE_EVERY  = 4              // every k-th step we attempt a merge (k>=4)
let TOL          = 0.000001       // 1e-6 element-wise tolerance
let BIN_WIDTH    = 0.5            // L2-norm bin width for diversity index
let OUT_JSON     = "/private/tmp/anima_h203/UNIVERSE/state/h203_asymm_merge_diff_2026_05_23/result.json"


// ── §1 helpers ───────────────────────────────────────────────────────────────

fn abs_f(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// float → 6dp fixed-point string (deterministic JSON).
fn f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true  v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = to_string(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + to_string(to_int(whole)) + "." + frac_str
}

// farr_id → list[float] snapshot.
fn read_w(farr_id: int, n: int) {
    let mut out = []
    let mut i = 0
    while i < n {
        out.push(farr_get(farr_id, i))
        i = i + 1
    }
    return out
}

// list[float] L2 norm.
fn l2_norm(v) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(v) {
        s = s + v[i] * v[i]
        i = i + 1
    }
    if s < 0.0 { s = 0.0 }
    return sqrt(s)
}

// list[float] variance.
fn variance_f(xs) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut sum = 0.0
    let mut i = 0
    while i < n {
        sum = sum + xs[i]
        i = i + 1
    }
    let mean = sum / (n * 1.0)
    let mut s = 0.0
    i = 0
    while i < n {
        let d = xs[i] - mean
        s = s + d * d
        i = i + 1
    }
    return s / (n * 1.0)
}

// diversity_idx = distinct L2-norm bins (bin_width=BIN_WIDTH).
fn diversity_idx(norms) -> int {
    if len(norms) == 0 { return 0 }
    let mut bins = []
    let mut i = 0
    while i < len(norms) {
        let b = to_int(floor(norms[i] / BIN_WIDTH))
        let mut found = false
        let mut k = 0
        while k < len(bins) {
            if bins[k] == b { found = true }
            k = k + 1
        }
        if !found { bins.push(b) }
        i = i + 1
    }
    return len(bins)
}

// pool 안 cells 의 engine_a_W L2 norm list + variance + diversity_idx.
fn measure_pool(pool, weight_n: int) {
    let cells = pool["cells"]
    let mut norms = []
    let mut i = 0
    while i < len(cells) {
        let w = read_w(cells[i]["engine_a_W"], weight_n)
        norms.push(l2_norm(w))
        i = i + 1
    }
    return #{
        "norms":         norms,
        "variance":      variance_f(norms),
        "diversity_idx": diversity_idx(norms),
        "n":             len(norms)
    }
}

// cells 안 cell_id 의 index (-1 if absent).
fn find_idx(cells, cell_id: int) -> int {
    let mut i = 0
    while i < len(cells) {
        if cells[i]["cell_id"] == cell_id { return i }
        i = i + 1
    }
    return -1
}

// list max abs diff between two lists (same length, take min if not).
fn max_abs_diff(a, b) -> float {
    let n = if len(a) < len(b) { len(a) } else { len(b) }
    let mut m = 0.0
    let mut i = 0
    while i < n {
        let d = a[i] - b[i]
        let ad = if d < 0.0 { 0.0 - d } else { d }
        if ad > m { m = ad }
        i = i + 1
    }
    return m
}


// ── §2 harness merge primitives (mode-dispatched) ────────────────────────────
//
//  mode = "sym"    : keeper.w[i] = 0.5 * (a.w[i] + b.w[i])     (substrate-like)
//  mode = "asym_a" : keeper = a, keeper.w[i] = a.w[i] + b.w[i] (host-preserve A)
//  mode = "asym_b" : keeper = b, keeper.w[i] = b.w[i] + a.w[i] (host-preserve B)
//
//  All modes: removed cell freed + pool cells list rebuilt; CB1 floor refuse if
//  pool would go below min_cells=2.
//
//  Returns [keeper, pool, merge_ok, snapshot_keeper_pre, snapshot_other_pre,
//           snapshot_keeper_post] for downstream invariant checks.
//
fn harness_merge(cell_a, cell_b, pool, mode: string, weight_n: int) {
    if len(pool["cells"]) <= pool["min_cells"] {
        return [cell_a, pool, false, [], [], []]
    }

    // Choose keeper by mode.
    let keeper_is_a = mode == "sym" || mode == "asym_a"
    let keeper = if keeper_is_a { cell_a } else { cell_b }
    let other  = if keeper_is_a { cell_b } else { cell_a }

    // Snapshot weights BEFORE merge.
    let ka = keeper["engine_a_W"]
    let oa = other["engine_a_W"]
    let kg = keeper["engine_g_W"]
    let og = other["engine_g_W"]
    let snap_keeper_pre = read_w(ka, weight_n)
    let snap_other_pre  = read_w(oa, weight_n)

    // Apply mode.
    let mut i = 0
    if mode == "sym" {
        while i < weight_n {
            let new_a = 0.5 * (farr_get(ka, i) + farr_get(oa, i))
            let new_g = 0.5 * (farr_get(kg, i) + farr_get(og, i))
            let _ = farr_set(ka, i, new_a)
            let _ = farr_set(kg, i, new_g)
            i = i + 1
        }
    } else {
        // asymmetric: keeper absorbs other (mass-add).
        while i < weight_n {
            let new_a = farr_get(ka, i) + farr_get(oa, i)
            let new_g = farr_get(kg, i) + farr_get(og, i)
            let _ = farr_set(ka, i, new_a)
            let _ = farr_set(kg, i, new_g)
            i = i + 1
        }
    }

    // Snapshot keeper AFTER merge (for invariant verification).
    let snap_keeper_post = read_w(ka, weight_n)

    // Free removed.
    let _ = farr_free(other["engine_a_W"])
    let _ = farr_free(other["engine_g_W"])

    // Rebuild cell list excluding `other`.
    let cs = pool["cells"]
    let mut new_cells = []
    let mut k = 0
    while k < len(cs) {
        if cs[k]["cell_id"] != other["cell_id"] {
            new_cells.push(cs[k])
        }
        k = k + 1
    }
    pool["cells"] = new_cells

    return [keeper, pool, true, snap_keeper_pre, snap_other_pre, snap_keeper_post]
}


// ── §3 single-arm driver ─────────────────────────────────────────────────────
//
//  Initialize 8-cell pool (d=4 → weight_n=16). Run N_STEPS forward. Every
//  MERGE_EVERY step (k>=MERGE_EVERY), pick the two lowest-id cells in pool
//  and apply harness_merge with `mode`. Suppress splits + auto-merges from
//  mitosis_forward_tail by setting thresholds high — we want the merge
//  behaviour to be ENTIRELY driven by our harness primitive (clean comparison).
//
//  Initial baseline snapshot of cell_id=0 engine_a_W kept for F2 PRESERVE
//  check (asym_a keeps cell_id=0 alive across merges since it is always
//  picked as the lower-id keeper).
//
fn run_arm(mode: string, label: string) {
    let weight_n = D_MODEL * D_MODEL
    let mut pool = cell_pool_init(D_MODEL, INITIAL_N)

    // Suppress mitosis_forward_tail's internal split/merge — all merge events
    // come from our harness for clean per-mode comparison.
    pool["split_threshold"] = 1000000.0
    pool["split_patience"]  = 1000000
    pool["merge_threshold"] = -1.0          // never below "never-below" threshold
    pool["merge_patience"]  = 1000000

    let mut x_in = []
    let mut i = 0
    while i < D_MODEL {
        x_in.push(sin((i * 1.0) * 0.31 + 1.0) * 0.5)
        i = i + 1
    }

    // Baseline snapshot of initial cell_id=0 weight for F2 frozen-like check.
    let baseline_w0 = read_w(pool["cells"][0]["engine_a_W"], weight_n)

    // Pre-merge measurement (variance/diversity at start).
    let pre_m = measure_pool(pool, weight_n)

    // Track invariants across all merges in this arm.
    let mut merges_attempted = 0
    let mut merges_ok        = 0
    let mut mass_max_err     = 0.0
    let mut sym_dev_max      = 0.0
    let mut step = 0
    while step < N_STEPS {
        // Forward (suppressed internal events).
        let r = mitosis_forward_tail(x_in, pool, step)
        pool = r[1]

        // Every MERGE_EVERY step (k >= MERGE_EVERY): attempt 1 merge using
        // two lowest-id cells in pool.
        if (step >= MERGE_EVERY) && (step % MERGE_EVERY == 0) && (len(pool["cells"]) >= 3) {
            // Pick two lowest cell_ids.
            let cs = pool["cells"]
            let mut id_a = cs[0]["cell_id"]
            let mut id_b = cs[1]["cell_id"]
            let mut k = 2
            while k < len(cs) {
                let cid = cs[k]["cell_id"]
                if cid < id_a {
                    id_b = id_a
                    id_a = cid
                } else {
                    if cid < id_b { id_b = cid }
                }
                k = k + 1
            }
            // Resolve to cell refs.
            let ia = find_idx(pool["cells"], id_a)
            let ib = find_idx(pool["cells"], id_b)
            if ia >= 0 && ib >= 0 {
                let ca = pool["cells"][ia]
                let cb = pool["cells"][ib]
                let mr = harness_merge(ca, cb, pool, mode, weight_n)
                pool = mr[1]
                let ok = mr[2]
                merges_attempted = merges_attempted + 1
                if ok {
                    merges_ok = merges_ok + 1
                    let snap_keeper_pre = mr[3]
                    let snap_other_pre  = mr[4]
                    let snap_keeper_post = mr[5]
                    // Mass conservation / mode invariant.
                    let mut wi = 0
                    while wi < weight_n {
                        if mode == "sym" {
                            let expect_sym = 0.5 * (snap_keeper_pre[wi] + snap_other_pre[wi])
                            let d = abs_f(snap_keeper_post[wi] - expect_sym)
                            if d > sym_dev_max { sym_dev_max = d }
                        } else {
                            // asym: post = pre_keeper + pre_other.
                            let expect_asym = snap_keeper_pre[wi] + snap_other_pre[wi]
                            let d = abs_f(snap_keeper_post[wi] - expect_asym)
                            if d > mass_max_err { mass_max_err = d }
                        }
                        wi = wi + 1
                    }
                }
            }
        }

        step = step + 1
    }

    // F2 PRESERVE-FROZEN: for asym_a, cell_id=0 should remain in pool. The
    // "frozen-like preservation" observable = mass conservation (post =
    // pre_keeper + pre_other element-wise, ≤ TOL). For asym_b, cell_id=0 is
    // absorbed into id=1 on first merge then no longer exists (mirror case).
    let cs = pool["cells"]
    let idx0 = find_idx(cs, 0)
    let mut id0_alive = false
    let mut id0_final = []
    let mut id0_dev = -1.0
    if idx0 >= 0 {
        id0_alive = true
        id0_final = read_w(cs[idx0]["engine_a_W"], weight_n)
        id0_dev = max_abs_diff(id0_final, baseline_w0)
    }

    // Final measurement.
    let post_m = measure_pool(pool, weight_n)

    println("  [" + label + "] mode=" + mode
        + " merges_ok=" + to_string(merges_ok)
        + "/" + to_string(merges_attempted)
        + " final_n=" + to_string(post_m["n"])
        + " variance=" + f6(post_m["variance"])
        + " diversity_idx=" + to_string(post_m["diversity_idx"])
        + " pre_div=" + to_string(pre_m["diversity_idx"]))

    return #{
        "label":            label,
        "mode":             mode,
        "initial_n":        INITIAL_N,
        "final_n":          post_m["n"],
        "merges_attempted": merges_attempted,
        "merges_ok":        merges_ok,
        "pre_variance":     pre_m["variance"],
        "post_variance":    post_m["variance"],
        "pre_diversity_idx":  pre_m["diversity_idx"],
        "post_diversity_idx": post_m["diversity_idx"],
        "mass_max_err":     mass_max_err,
        "sym_dev_max":      sym_dev_max,
        "id0_alive":        id0_alive,
        "id0_dev_vs_baseline": id0_dev
    }
}


// ── §4 main ──────────────────────────────────────────────────────────────────

fn main() {
    println("================================================================")
    println("  H_203 — Asymmetric Merge Differentiation (cross-link H_054 H_132 H_201)")
    println("  deterministic · hexa-only · $0 mac local · LLM none")
    println("  master_seed=" + to_string(MASTER_SEED)
        + "  d_model=" + to_string(D_MODEL)
        + "  initial_n=" + to_string(INITIAL_N)
        + "  n_steps=" + to_string(N_STEPS)
        + "  merge_every=" + to_string(MERGE_EVERY))
    println("  imports: tool/hexa_native/mitosis_hook_lib.hexa (D4a FULL IMPL)")
    println("================================================================")

    println("--- ARM (a): symmetric (w_new = 0.5*(w_a + w_b))             ---")
    let r_sym = run_arm("sym", "SYM")
    println("--- ARM (b): asymmetric_preserve_a (w_new = w_a + w_b, A=keeper) ---")
    let r_aa  = run_arm("asym_a", "ASYM_A")
    println("--- ARM (c): asymmetric_preserve_b (w_new = w_b + w_a, B=keeper) ---")
    let r_ab  = run_arm("asym_b", "ASYM_B")

    // ── verdicts ──────────────────────────────────────────────────────────────
    let var_sym  = r_sym["post_variance"]
    let var_asym = r_aa["post_variance"]
    let div_sym  = r_sym["post_diversity_idx"]
    let div_asym = r_aa["post_diversity_idx"]
    let div_sym_pre  = r_sym["pre_diversity_idx"]
    let div_sym_post = r_sym["post_diversity_idx"]

    // C1 / F1: H203.1 — variance_asym > variance_sym * 1.10  (≥10% margin)
    let f1_ok = var_asym > (var_sym * 1.10)

    // C2 / F2: H203.2 — preserve_a keeper (id=0) survives AND its pre-merge
    // contribution intact = mass conservation ≤ TOL.
    let f2_ok = r_aa["id0_alive"] && (r_aa["mass_max_err"] <= TOL)

    // C3 / F3: H203.3 — mass conservation for both asym arms.
    let f3_ok = (r_aa["mass_max_err"] <= TOL) && (r_ab["mass_max_err"] <= TOL)

    // C4 / F4: H203.4 — diversity_idx_asym > diversity_idx_sym (at step=50).
    let f4_ok = div_asym > div_sym

    // C5 / F5: H203.5 — symmetric arm diversity_idx 무변화 또는 감소.
    let f5_ok = div_sym_post <= div_sym_pre

    let v1 = if f1_ok { "PASS" } else { "FAIL" }
    let v2 = if f2_ok { "PASS" } else { "FAIL" }
    let v3 = if f3_ok { "PASS" } else { "FAIL" }
    let v4 = if f4_ok { "PASS" } else { "FAIL" }
    let v5 = if f5_ok { "PASS" } else { "FAIL" }

    let mut npass = 0
    if f1_ok { npass = npass + 1 }
    if f2_ok { npass = npass + 1 }
    if f3_ok { npass = npass + 1 }
    if f4_ok { npass = npass + 1 }
    if f5_ok { npass = npass + 1 }

    let verdict = if npass == 5 { "SUPPORTED" }
                  else { if npass >= 3 { "PARTIAL" } else { "FAIL" } }

    println("")
    println("── verdicts ──")
    println("  C1/F1 DIVERSITY-VAR    (sym=" + f6(var_sym)
        + " asym=" + f6(var_asym) + " ≥10% margin): " + v1)
    println("  C2/F2 PRESERVE-FROZEN  (id0_alive=" + to_string(r_aa["id0_alive"])
        + " mass_max_err=" + f6(r_aa["mass_max_err"]) + "): " + v2)
    println("  C3/F3 MASS-CONS        (asym_a=" + f6(r_aa["mass_max_err"])
        + " asym_b=" + f6(r_ab["mass_max_err"]) + " tol=1e-6): " + v3)
    println("  C4/F4 DIV-IDX          (sym=" + to_string(div_sym)
        + " asym=" + to_string(div_asym) + "): " + v4)
    println("  C5/F5 SYM-NO-INCREASE  (pre=" + to_string(div_sym_pre)
        + " post=" + to_string(div_sym_post) + "): " + v5)

    println("")
    println("================================================================")
    println("  H_203 ASYMM-MERGE-DIFF " + verdict + "  (" + to_string(npass) + "/5)")
    println("  variance      sym=" + f6(var_sym) + "  asym_a=" + f6(var_asym)
        + "  asym_b=" + f6(r_ab["post_variance"]))
    println("  diversity_idx sym=" + to_string(div_sym)
        + "  asym_a=" + to_string(div_asym)
        + "  asym_b=" + to_string(r_ab["post_diversity_idx"]))
    println("  id0 alive in asym_a: " + to_string(r_aa["id0_alive"])
        + "  id0_dev_vs_baseline=" + f6(r_aa["id0_dev_vs_baseline"]))
    println("  sym AVG-invariant max_dev=" + f6(r_sym["sym_dev_max"]) + " (≤ TOL: control)")
    println("================================================================")

    // ── result.json ───────────────────────────────────────────────────────────
    let js = "{\n"
        + "  \"hypothesis\": \"H_203\",\n"
        + "  \"slug\": \"asymmetric-merge-differentiation\",\n"
        + "  \"cycle\": \"Cycle_1_asymmetric_merge_differentiation\",\n"
        + "  \"date\": \"2026-05-23\",\n"
        + "  \"host\": \"mac-local\",\n"
        + "  \"deterministic\": true,\n"
        + "  \"hexa_only\": true,\n"
        + "  \"llm\": \"none\",\n"
        + "  \"cost_usd\": 0.0,\n"
        + "  \"master_seed\": " + to_string(MASTER_SEED) + ",\n"
        + "  \"params\": { \"d_model\": " + to_string(D_MODEL)
        + ", \"initial_n\": " + to_string(INITIAL_N)
        + ", \"n_steps\": " + to_string(N_STEPS)
        + ", \"merge_every\": " + to_string(MERGE_EVERY)
        + ", \"tol\": " + f6(TOL)
        + ", \"bin_width\": " + f6(BIN_WIDTH) + " },\n"
        + "  \"imports\": \"tool/hexa_native/mitosis_hook_lib.hexa (D4a FULL IMPL)\",\n"
        + "  \"operational_asymmetry\": \"keeper.w[i] = keeper.w[i] + other.w[i] (mass-add); parent loses none, other absorbed; substrate symmetric merge primitive bypassed in asym arms\",\n"
        + "  \"sym\": { \"final_n\": " + to_string(r_sym["final_n"])
        + ", \"merges_ok\": " + to_string(r_sym["merges_ok"])
        + ", \"pre_variance\": " + f6(r_sym["pre_variance"])
        + ", \"post_variance\": " + f6(r_sym["post_variance"])
        + ", \"pre_diversity_idx\": " + to_string(r_sym["pre_diversity_idx"])
        + ", \"post_diversity_idx\": " + to_string(r_sym["post_diversity_idx"])
        + ", \"avg_invariant_max_dev\": " + f6(r_sym["sym_dev_max"]) + " },\n"
        + "  \"asym_a\": { \"final_n\": " + to_string(r_aa["final_n"])
        + ", \"merges_ok\": " + to_string(r_aa["merges_ok"])
        + ", \"pre_variance\": " + f6(r_aa["pre_variance"])
        + ", \"post_variance\": " + f6(r_aa["post_variance"])
        + ", \"pre_diversity_idx\": " + to_string(r_aa["pre_diversity_idx"])
        + ", \"post_diversity_idx\": " + to_string(r_aa["post_diversity_idx"])
        + ", \"mass_max_err\": " + f6(r_aa["mass_max_err"])
        + ", \"id0_alive\": " + to_string(r_aa["id0_alive"])
        + ", \"id0_dev_vs_baseline\": " + f6(r_aa["id0_dev_vs_baseline"]) + " },\n"
        + "  \"asym_b\": { \"final_n\": " + to_string(r_ab["final_n"])
        + ", \"merges_ok\": " + to_string(r_ab["merges_ok"])
        + ", \"pre_variance\": " + f6(r_ab["pre_variance"])
        + ", \"post_variance\": " + f6(r_ab["post_variance"])
        + ", \"pre_diversity_idx\": " + to_string(r_ab["pre_diversity_idx"])
        + ", \"post_diversity_idx\": " + to_string(r_ab["post_diversity_idx"])
        + ", \"mass_max_err\": " + f6(r_ab["mass_max_err"]) + " },\n"
        + "  \"F1_diversity_variance\": { \"sym\": " + f6(var_sym)
        + ", \"asym\": " + f6(var_asym) + ", \"margin_ge_10pct\": "
        + (if f1_ok { "true" } else { "false" }) + ", \"verdict\": \"" + v1 + "\" },\n"
        + "  \"F2_preserve_frozen\": { \"id0_alive\": " + to_string(r_aa["id0_alive"])
        + ", \"mass_max_err\": " + f6(r_aa["mass_max_err"]) + ", \"verdict\": \"" + v2 + "\" },\n"
        + "  \"F3_mass_conservation\": { \"asym_a\": " + f6(r_aa["mass_max_err"])
        + ", \"asym_b\": " + f6(r_ab["mass_max_err"]) + ", \"tol\": " + f6(TOL)
        + ", \"verdict\": \"" + v3 + "\" },\n"
        + "  \"F4_diversity_idx\": { \"sym\": " + to_string(div_sym)
        + ", \"asym\": " + to_string(div_asym) + ", \"verdict\": \"" + v4 + "\" },\n"
        + "  \"F5_sym_no_increase\": { \"pre\": " + to_string(div_sym_pre)
        + ", \"post\": " + to_string(div_sym_post) + ", \"verdict\": \"" + v5 + "\" },\n"
        + "  \"n_pass\": " + to_string(npass) + ",\n"
        + "  \"verdict_rule\": \"SUPPORTED = 5/5; PARTIAL = 3-4/5; FAIL = <=2/5\",\n"
        + "  \"verdict\": \"" + verdict + "\",\n"
        + "  \"invariant_tier\": \"NUMERICAL (hexa-native recompute; toy d=4, single-cycle)\",\n"
        + "  \"cross_links\": [\"H_054 symmetric MERGE\", \"H_132 frozen-cell preservation\", \"H_201 asymmetric DIVISION (dual)\"]\n"
        + "}\n"

    write_file(OUT_JSON, js)
    println("")
    println("  result.json written: " + OUT_JSON)
    println("  H_203_VERDICT=" + verdict)
}

// hexa-strict auto-invokes fn main().
