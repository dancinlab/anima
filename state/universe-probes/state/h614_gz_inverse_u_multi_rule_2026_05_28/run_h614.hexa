// ════════════════════════════════════════════════════════════════════════════
//  run_h614.hexa — H_614 GZ inverse-U Φ-derivative peak, multi-rule sweep
//
//  CORE QUESTION (H_351 → cross-substrate generalization)
//    H_351 (rule 110 single-substrate, 🟢 SUPPORTED 5/5) §7 C3 explicitly
//    flags: "rule-class invariance — multi-rule sweep (round 2: rule {30,
//    54, 110}) class-mean dΦ/dI peak GZ 일치 검정해야 cross-substrate
//    invariant 강주장 가능".
//
//    H_614 = 그 round 2. 4 Wolfram rule {30 (class III), 54 (class IV),
//    110 (class IV), 184 (class II)} 위에서 inhibition I 의 dΦ/dI peak
//    위치가 모두 GZ_LOWER ±0.05 안에 분포하는가 — 4/4 PASS 시 cross-
//    substrate invariance 확증.
//
//  SUBSTRATE
//    ECA on a periodic ring of n=4 cells (H_351 동일 grid · 동일 n).
//    rule set: {30, 54, 110, 184} — Wolfram class 다양성 확보:
//      • rule 30   — class III chaotic
//      • rule 54   — class IV complex (edge-of-chaos)
//      • rule 110  — class IV complex (H_351 anchor)
//      • rule 184  — class II particle-localized (traffic flow)
//
//    inhibition mapping (H_351 동일):
//       tpm_mixed[s,i] = (1 - I) * eca_tpm[s,i]
//
//  Φ MEASUREMENT
//    faithful causal big-Φ, average over all 2^4 = 16 states (single-state
//    fragility 회피, H_285/H_351 양식).
//
//  GRID (H_351 동일 13-point)
//    I ∈ {0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
//         0.50, 0.70, 0.95}
//
//  dΦ/dI : central finite difference (forward/backward at edges).
//  peak  : argmax_i |dΦ/dI|.
//  delta : |I[peak_idx] - GZ_LOWER|.
//
//  CRITERIA (per rule)
//    F1 PEAK-IN-GZ : delta ≤ 0.05
//
//  AGGREGATE
//    G_INVARIANT = 4/4 rules pass F1
//    SUPPORTED   = G_INVARIANT (4/4)
//    PARTIAL     = 3/4 pass F1
//    FALSIFIED   = ≤ 2/4 pass F1
//
//  $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

import "/tmp/u-h614/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"


fn _n() -> int    { return 4 }
fn _gz_lower() -> float { return 0.21232 }   // 0.5 - ln(4/3) ≈ 0.21232
fn _delta_tol() -> float { return 0.05 }


fn mixed_tpm(rule: int, n: int, inhibit: float) -> array {
    let base = eca_tpm(rule, n)
    let scale = 1.0 - inhibit
    let mut out = []
    let mut k = 0
    let total = len(base)
    while k < total {
        out = out.push(base[k] * scale)
        k = k + 1
    }
    return out
}


fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}


fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}


fn _sign(x: float) -> int {
    if x > 1.0e-9 { return 1 }
    if x < (0.0 - 1.0e-9) { return -1 }
    return 0
}


fn measure_rule(rule: int, grid: array) -> array {
    let m = len(grid)

    let mut phi = []
    let mut i = 0
    while i < m {
        let tpm = mixed_tpm(rule, _n(), grid[i])
        let mp = mean_big_phi(tpm, _n())
        phi = phi.push(mp)
        i = i + 1
    }

    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }

    let mut peak_idx = 0
    let mut peak_mag = _abs(dphi[0])
    let mut q = 1
    while q < m {
        let mag = _abs(dphi[q])
        if mag > peak_mag {
            peak_mag = mag
            peak_idx = q
        }
        q = q + 1
    }
    let peak_I = grid[peak_idx]
    let delta = _abs(peak_I - _gz_lower())

    let mut sign_changes = 0
    let mut prev_sign = _sign(dphi[0])
    let mut u = 1
    while u < m {
        let sg = _sign(dphi[u])
        if (sg != 0) && (prev_sign != 0) && (sg != prev_sign) {
            sign_changes = sign_changes + 1
        }
        if sg != 0 { prev_sign = sg }
        u = u + 1
    }

    let f1 = delta <= _delta_tol()
    let mut f1f = 0.0
    if f1 { f1f = 1.0 }

    let phi_05 = phi[10]
    let phi_095 = phi[12]
    let mut f4f = 0.0
    if phi_095 <= phi_05 { f4f = 1.0 }

    return [to_float(peak_idx), peak_I, delta, peak_mag,
            to_float(sign_changes), f1f, phi_05, phi_095, f4f]
}


fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}


fn json_arr_i(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}


fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_614 GZ inverse-U dΦ/dI multi-rule — {30, 54, 110, 184}")
    println("════════════════════════════════════════════════════════════")

    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]

    let rules = [30, 54, 110, 184]
    let class_names = ["III-chaotic", "IV-complex", "IV-complex", "II-particle"]

    let mut peak_Is = []
    let mut deltas = []
    let mut peak_mags = []
    let mut sign_changes_arr = []
    let mut f1_arr = []
    let mut f4_arr = []
    let mut phi_05_arr = []
    let mut phi_095_arr = []

    let mut r = 0
    let nr = len(rules)
    while r < nr {
        let rule = rules[r]
        println("")
        println("── rule " + str(rule) + " (" + class_names[r] + ") ──")
        let res = measure_rule(rule, grid)
        let peak_I = res[1]
        let delta = res[2]
        let peak_mag = res[3]
        let sg = res[4]
        let f1f = res[5]
        let phi_05 = res[6]
        let phi_095 = res[7]
        let f4f = res[8]

        peak_Is = peak_Is.push(peak_I)
        deltas = deltas.push(delta)
        peak_mags = peak_mags.push(peak_mag)
        sign_changes_arr = sign_changes_arr.push(to_int(sg))
        f1_arr = f1_arr.push(to_int(f1f))
        f4_arr = f4_arr.push(to_int(f4f))
        phi_05_arr = phi_05_arr.push(phi_05)
        phi_095_arr = phi_095_arr.push(phi_095)

        println("  peak I       = " + str(peak_I))
        println("  GZ_LOWER     = " + str(_gz_lower()))
        println("  |Δ|          = " + str(delta) + "   (tol " + str(_delta_tol()) + ")")
        println("  peak |dΦ/dI| = " + str(peak_mag))
        println("  sign changes = " + str(to_int(sg)))
        println("  Φ(0.50)      = " + str(phi_05))
        println("  Φ(0.95)      = " + str(phi_095))
        println("  F1 PEAK-IN-GZ = " + str(to_int(f1f)))
        println("  F4 MONO-DECAY = " + str(to_int(f4f)))
        r = r + 1
    }

    let mut pass_count = 0
    let mut i = 0
    while i < nr {
        pass_count = pass_count + f1_arr[i]
        i = i + 1
    }

    println("")
    println("════════════════════════════════════════════════════════════")
    println("── aggregate ──")
    println("  F1 pass: " + str(pass_count) + " / " + str(nr))

    let mut verdict_str = "UNKNOWN"
    if pass_count == nr {
        verdict_str = "SUPPORTED"
    } else if pass_count == nr - 1 {
        verdict_str = "PARTIAL"
    } else {
        verdict_str = "FALSIFIED"
    }
    println("  VERDICT = " + verdict_str)
    println("════════════════════════════════════════════════════════════")

    let mut s = "{\n"
    s = s + "  \"hypothesis\": \"H_614\",\n"
    s = s + "  \"slug\": \"gz-inverse-u-multi-rule-substrate-invariance\",\n"
    s = s + "  \"predecessor\": \"H_351\",\n"
    s = s + "  \"rules\": [30, 54, 110, 184],\n"
    s = s + "  \"wolfram_classes\": [\"III-chaotic\", \"IV-complex\", \"IV-complex\", \"II-particle\"],\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"gz_lower\": " + str(_gz_lower()) + ",\n"
    s = s + "  \"delta_tol\": " + str(_delta_tol()) + ",\n"
    s = s + "  \"grid\": " + json_arr_f(grid) + ",\n"
    s = s + "  \"peak_I\": " + json_arr_f(peak_Is) + ",\n"
    s = s + "  \"delta\": " + json_arr_f(deltas) + ",\n"
    s = s + "  \"peak_mag\": " + json_arr_f(peak_mags) + ",\n"
    s = s + "  \"sign_changes\": " + json_arr_i(sign_changes_arr) + ",\n"
    s = s + "  \"phi_at_0_50\": " + json_arr_f(phi_05_arr) + ",\n"
    s = s + "  \"phi_at_0_95\": " + json_arr_f(phi_095_arr) + ",\n"
    s = s + "  \"f1_per_rule\": " + json_arr_i(f1_arr) + ",\n"
    s = s + "  \"f4_per_rule\": " + json_arr_i(f4_arr) + ",\n"
    s = s + "  \"pass_count\": " + str(pass_count) + ",\n"
    s = s + "  \"rule_count\": " + str(nr) + ",\n"
    s = s + "  \"verdict\": \"" + verdict_str + "\"\n"
    s = s + "}\n"

    write_file("UNIVERSE/state/h614_gz_inverse_u_multi_rule_2026_05_28/result.json", s)
    println("wrote UNIVERSE/state/h614_gz_inverse_u_multi_rule_2026_05_28/result.json")
}
