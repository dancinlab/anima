// UNIVERSE/state/h312_apoptosis_low_phi_pruning_2026_05_27/run.hexa
// ════════════════════════════════════════════════════════════════════════════
// H_312 — APOPTOSIS × IIT4-Φ : does pruning the lowest-Φ cell raise survivor
//          mean per-cell integrated information?
//
//   HYPOTHESIS (H1, falsifiable)
//     APOPTOSIS = programmed death of low-integration cells. Claim: removing the
//     LOWEST per-cell-Φ cell of an IIT 4.0 substrate raises the mean per-cell Φ
//     of the surviving subsystem (selection-for-integration).
//   FALSIFIER
//     If removing the lowest-Φ cell does NOT raise survivor mean per-cell Φ
//     (Δ ≤ 0) across the panel — OR if it fails to BEAT the control of removing
//     the HIGHEST-Φ cell on the same substrate — H1 is FALSIFIED.
//
//   PER-CELL Φ (IIT-grounded, NON-degenerate)
//     Singleton-mechanism distinction φ_d is identically 0 for ECA substrates
//     (a single unit's MICE is reducible), so it carries no signal. We instead
//     use the MARGINAL CONTRIBUTION of a cell to the integrated whole:
//         phi_cell(i ; S) = bigPhi(S) − bigPhi(S \ {i})
//     i.e. how much big-Φ the subsystem LOSES when cell i is excised. This is a
//     real per-cell integration measure (Leave-One-Out big-Φ). The mean per-cell
//     Φ of a subsystem S is the average LOO drop over its members:
//         meanPhi(S) = (1/|S|) Σ_{i∈S} [ bigPhi(S) − bigPhi(S\{i}) ]
//     bigPhi of any subsystem is computed by background-conditioning the external
//     units to sys_state (IIT 4.0 convention; subsystem_tpm) then the faithful
//     causal big_phi engine.
//
//   APOPTOSIS STEP (one programmed death)
//     1. compute phi_cell(i; FULL) for every cell i of the n-cell substrate.
//     2. apoptosis arm  : remove argMIN phi_cell  → survivor S_lo
//        control-hi arm : remove argMAX phi_cell  → survivor S_hi
//        control-fixed  : remove cell 0           → survivor S_fixed
//     3. recompute meanPhi(survivor) for each arm; Δ = meanPhi(survivor) −
//        meanPhi(FULL). H1 ⇔ Δ_apoptosis > 0 AND Δ_apoptosis > Δ_control_hi.
//
//   DETERMINISTIC · hexa-only · llm:none · $0 mac/pool. n ≤ 4 (exact Φ tractable,
//   cross-process byte-identical). Reuses the IIT 4.0 stdlib engine — Φ is NOT
//   reinvented (memory: H_280 reinvented IIT4 and got it wrong).
//
//   ENGINE (REUSED, not reinvented):
//     stdlib/consciousness/iit4_complex.hexa  (subsystem_tpm, big_phi chain)
//     HEXAD/IIT4/lib/iit4_eca.hexa            (eca_tpm — ECA→state-by-node TPM)
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_complex.hexa"
import "HEXAD/IIT4/lib/iit4_eca.hexa"

// ── helpers ─────────────────────────────────────────────────────────────────
fn full_mask(n: int) -> int { return iit4_pow2(n) - 1 }
fn without_cell(mask: int, victim: int) -> int { return mask - iit4_pow2(victim) }

// big-Φ of the subsystem `mask` (external units background-conditioned to sys_state).
fn sub_phi(tpm: array, n: int, mask: int, sys_state: int) -> float {
    let units = iit4_units(mask, n)
    let k = len(units)
    if k < 1 { return 0.0 }
    if k == 1 { return 0.0 }                          // single unit ⇒ big-Φ = 0 by defn
    let sub = subsystem_tpm(tpm, n, mask, sys_state)
    let ss  = iit4_project_state(sys_state, units)
    let r   = big_phi(sub, k, ss)
    return r[0]
}

// per-cell LOO Φ of cell `i` within subsystem `mask`: bigPhi(mask) − bigPhi(mask\{i}).
fn cell_phi(tpm: array, n: int, mask: int, sys_state: int, i: int, base_phi: float) -> float {
    let m2 = without_cell(mask, i)
    let p2 = sub_phi(tpm, n, m2, sys_state)
    return base_phi - p2
}

// mean per-cell LOO Φ over the members of subsystem `mask`.
fn mean_cell_phi(tpm: array, n: int, mask: int, sys_state: int) -> float {
    let units = iit4_units(mask, n)
    let k = len(units)
    if k < 1 { return 0.0 }
    let base = sub_phi(tpm, n, mask, sys_state)
    let mut sum = 0.0
    let mut a = 0
    while a < k {
        sum = sum + cell_phi(tpm, n, mask, sys_state, units[a], base)
        a = a + 1
    }
    return sum / to_float(k)
}

fn fmt(x: float) -> string { return to_string(x) }

// ── run one substrate panel-cell, print its lines, return Δ_apoptosis sign code:
//      +1 if Δ_apoptosis > 0,  0 if = 0,  −1 if < 0  (eps 1e-9)
//    Also accumulates into the global tallies via printed PANEL lines (parsed by
//    the harness from stdout — single SSOT is this program's deterministic print).
fn run_substrate(label: string, tpm: array, n: int, sys: int) {
    let fmask = full_mask(n)
    let base  = sub_phi(tpm, n, fmask, sys)
    let mean0 = mean_cell_phi(tpm, n, fmask, sys)

    // per-cell Φ over the full system; find argmin / argmax.
    let units = iit4_units(fmask, n)
    let k = len(units)
    let mut lo_cell = units[0]
    let mut hi_cell = units[0]
    let mut lo_val  = cell_phi(tpm, n, fmask, sys, units[0], base)
    let mut hi_val  = lo_val
    let mut a = 0
    while a < k {
        let v = cell_phi(tpm, n, fmask, sys, units[a], base)
        if v < lo_val { lo_val = v; lo_cell = units[a] }
        if v > hi_val { hi_val = v; hi_cell = units[a] }
        a = a + 1
    }

    // three arms.
    let s_lo    = mean_cell_phi(tpm, n, without_cell(fmask, lo_cell),  sys)   // apoptosis
    let s_hi    = mean_cell_phi(tpm, n, without_cell(fmask, hi_cell),  sys)   // control-hi
    let s_fixed = mean_cell_phi(tpm, n, without_cell(fmask, units[0]), sys)   // control-fixed

    let d_apop  = s_lo - mean0
    let d_hi    = s_hi - mean0
    let d_fixed = s_fixed - mean0

    println("PANEL " + label + " n=" + to_string(n) + " sys=" + to_string(sys))
    println("  whole_bigPhi=" + fmt(base) + " mean0=" + fmt(mean0))
    println("  lo_cell=" + to_string(lo_cell) + "(phi=" + fmt(lo_val) + ") hi_cell=" + to_string(hi_cell) + "(phi=" + fmt(hi_val) + ")")
    println("  apoptosis(rm_lo) survivor_mean=" + fmt(s_lo) + " d_apop=" + fmt(d_apop))
    println("  control_hi(rm_hi) survivor_mean=" + fmt(s_hi) + " d_hi=" + fmt(d_hi))
    println("  control_fixed(rm0) survivor_mean=" + fmt(s_fixed) + " d_fixed=" + fmt(d_fixed))
    // verdict-relevant booleans for this substrate, machine-greppable:
    let raises = d_apop > 0.000000001
    let beats  = d_apop > d_hi + 0.000000001
    println("  CELL_RESULT raises=" + to_string(raises) + " beats_hi=" + to_string(beats))
    println("")
}

fn main() {
    println("H_312 — APOPTOSIS × IIT4-Φ : prune lowest-Φ cell, measure survivor mean per-cell Φ")
    println("  per-cell Φ = LOO big-Φ drop; engine = stdlib iit4_complex + iit4_eca (REUSED)")
    println("  FALSIFIER: Δ_apoptosis ≤ 0 OR Δ_apoptosis ≤ Δ_control_hi across panel ⇒ H1 FALSIFIED")
    println("")

    // ── PANEL: a spread of ECA rules × n × fixed sys_state (deterministic) ──────
    // n=4 (exact, 2^4=16 states; tractable). rules chosen across Wolfram classes:
    //   90  (class III, additive XOR), 110 (class IV, universal), 30 (class III
    //   chaotic), 54 (class IV), 150 (class III XOR-3), 22 (class III), 60, 105.
    // sys_state fixed per rule (a non-trivial mixed pattern).
    run_substrate("eca90",  eca_tpm(90,  4), 4, 11)
    run_substrate("eca110", eca_tpm(110, 4), 4, 11)
    run_substrate("eca30",  eca_tpm(30,  4), 4, 11)
    run_substrate("eca54",  eca_tpm(54,  4), 4, 11)
    run_substrate("eca150", eca_tpm(150, 4), 4, 11)
    run_substrate("eca22",  eca_tpm(22,  4), 4, 11)
    run_substrate("eca60",  eca_tpm(60,  4), 4, 11)
    run_substrate("eca105", eca_tpm(105, 4), 4, 11)
    // n=3 rule90 (smaller substrate, different sys) for breadth.
    run_substrate("eca90_n3",  eca_tpm(90,  3), 3, 5)
    run_substrate("eca110_n3", eca_tpm(110, 3), 3, 5)

    println("DONE")
}
