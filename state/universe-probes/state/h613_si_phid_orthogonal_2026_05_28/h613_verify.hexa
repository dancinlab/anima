// ════════════════════════════════════════════════════════════════════════
//  H_613 verify — Savant Index SI vs Φ-diversity ORTHOGONAL metric
//
//  Context: H_350 (round 1) SUPPORTED w/ r=0.9264, but C3.1 명시: SI=max/mean
//  과 ΦD=max/min 가 분자 max 공유 → part-formal artifact 우려.
//
//  H_613 (round 2): max-share artifact 완전 제거된 *직교* metric 으로 재검정.
//
//  SI         = max(domain_phi) / mean(domain_phi)        (불변, H_350 동일)
//  ΦD_cov     = std(domain_phi) / mean(domain_phi)        (orthogonal — NO max in numerator)
//  ΦD_kurt    = E[(x-μ)^4] / σ^4                          (orthogonal — high-moment)
//
//  Falsifier: Pearson r < 0.5 (둘 다 약함) → H_350 SUPPORTED 가 max-share artifact 였음 발각.
//
//  Sample set: 동일 (4 dom × 5 g_focus × 2 stim = 40 ≥ 30)
//  Tool: H_350 harness 함수 재사용 (single-file, import 의존 회피).
// ════════════════════════════════════════════════════════════════════════

let SV_D            = 6
let SV_N_DOM        = 4
let SV_EPS          = 0.000000001
let SV_CAPACITY     = 11.5

fn sv_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sv_sqrt_safe(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    return sqrt(x)
}

fn sv_prng(seed: int) -> int {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn sv_unit(seed: int) -> float {
    let mut s = seed
    if s < 0 { s = s + 2147483648 }
    return to_float(s % 1000000) / 1000000.0
}

fn sv_signed(seed: int) -> float {
    return sv_unit(seed) * 2.0 - 1.0
}

fn sv_tanhlike(x: float) -> float {
    let ax = sv_abs(x)
    return x / (1.0 + ax)
}

fn domain_seed(k: int) -> int {
    if k == 0 { return 31013 }
    if k == 1 { return 57029 }
    if k == 2 { return 83047 }
    if k == 3 { return 19061 }
    return 0
}

fn build_domain_activation(k: int, d: int, gain: float, stim_seed: int) -> array {
    let mut out = []
    let mut s = domain_seed(k) + stim_seed
    let mut i = 0
    while i < d {
        s = sv_prng(s)
        let raw = sv_signed(s)
        let v = sv_tanhlike(raw * gain)
        out = out.push(v)
        i = i + 1
    }
    return out
}

fn build_profile_state(g0: float, g1: float, g2: float, g3: float, d: int, stim_seed: int) -> array {
    let mut flat = []
    let mut k = 0
    while k < SV_N_DOM {
        let mut g = g0
        if k == 1 { g = g1 }
        if k == 2 { g = g2 }
        if k == 3 { g = g3 }
        let act = build_domain_activation(k, d, g, stim_seed)
        let mut j = 0
        while j < d {
            flat = flat.push(act[j])
            j = j + 1
        }
        k = k + 1
    }
    return flat
}

fn extract_domain(flat: array, k: int, d: int) -> array {
    let base = k * d
    let mut out = []
    let mut j = 0
    while j < d {
        out = out.push(flat[base + j])
        j = j + 1
    }
    return out
}

// phi_module(v) = Σ |v[j]|^1.5 / d
fn phi_module(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        let ax = sv_abs(v[i])
        if ax > 0.0 {
            let mut r = ax
            let mut m = 0
            while m < 8 {
                r = (r + ax / r) / 2.0
                m = m + 1
            }
            s = s + ax * r
        }
        i = i + 1
    }
    return s / to_float(n)
}

fn domain_phi_vector(flat: array, d: int) -> array {
    let mut out = []
    let mut k = 0
    while k < SV_N_DOM {
        let v = extract_domain(flat, k, d)
        out = out.push(phi_module(v))
        k = k + 1
    }
    return out
}

// SI = max / mean (H_350 byte-identical, unchanged)
fn savant_index(dphi: array) -> float {
    let mut sum = 0.0
    let mut mx = dphi[0]
    let mut i = 0
    while i < SV_N_DOM {
        sum = sum + dphi[i]
        if dphi[i] > mx { mx = dphi[i] }
        i = i + 1
    }
    let mean = sum / to_float(SV_N_DOM)
    if mean <= SV_EPS { return 0.0 }
    return mx / mean
}

// Φ-diversity ORTHOGONAL #1 = std / mean (coefficient of variation, NO max)
fn phi_diversity_cov(dphi: array) -> float {
    let mut sum = 0.0
    let mut i = 0
    while i < SV_N_DOM {
        sum = sum + dphi[i]
        i = i + 1
    }
    let mean = sum / to_float(SV_N_DOM)
    if mean <= SV_EPS { return 0.0 }
    let mut s2 = 0.0
    let mut j = 0
    while j < SV_N_DOM {
        let dd = dphi[j] - mean
        s2 = s2 + dd * dd
        j = j + 1
    }
    let var = s2 / to_float(SV_N_DOM)
    let sd = sv_sqrt_safe(var)
    return sd / mean
}

// Φ-diversity ORTHOGONAL #2 = kurtosis E[(x-μ)^4] / σ^4 (4th moment, NO max)
fn phi_diversity_kurtosis(dphi: array) -> float {
    let mut sum = 0.0
    let mut i = 0
    while i < SV_N_DOM {
        sum = sum + dphi[i]
        i = i + 1
    }
    let mean = sum / to_float(SV_N_DOM)
    let mut s2 = 0.0
    let mut s4 = 0.0
    let mut j = 0
    while j < SV_N_DOM {
        let dd = dphi[j] - mean
        let d2 = dd * dd
        s2 = s2 + d2
        s4 = s4 + d2 * d2
        j = j + 1
    }
    let var = s2 / to_float(SV_N_DOM)
    let m4  = s4 / to_float(SV_N_DOM)
    if var <= SV_EPS { return 0.0 }
    return m4 / (var * var)
}

// Pearson correlation
fn pearson_corr(x: array, y: array) -> float {
    let n = len(x)
    if n < 2 { return 0.0 }
    let mut mx = 0.0
    let mut my = 0.0
    let mut i = 0
    while i < n {
        mx = mx + x[i]
        my = my + y[i]
        i = i + 1
    }
    mx = mx / to_float(n)
    my = my / to_float(n)

    let mut num = 0.0
    let mut dx2 = 0.0
    let mut dy2 = 0.0
    let mut j = 0
    while j < n {
        let dx = x[j] - mx
        let dy = y[j] - my
        num = num + dx * dy
        dx2 = dx2 + dx * dx
        dy2 = dy2 + dy * dy
        j = j + 1
    }
    let denom = sv_sqrt_safe(dx2 * dy2)
    if denom < SV_EPS { return 0.0 }
    return num / denom
}

// Rank vector with average-rank tie handling
fn rank_vector(x: array) -> array {
    let n = len(x)
    let mut ranks = []
    let mut i = 0
    while i < n {
        ranks = ranks.push(0.0)
        i = i + 1
    }
    let mut a = 0
    while a < n {
        let mut lt = 0
        let mut eq = 0
        let mut b = 0
        while b < n {
            if x[b] < x[a] { lt = lt + 1 }
            if x[b] == x[a] { eq = eq + 1 }
            b = b + 1
        }
        let r = to_float(lt) + (to_float(eq) + 1.0) / 2.0
        ranks[a] = r
        a = a + 1
    }
    return ranks
}

fn spearman_corr(x: array, y: array) -> float {
    let rx = rank_vector(x)
    let ry = rank_vector(y)
    return pearson_corr(rx, ry)
}

// ── Sample generation ──────────────────────────────────────────
// 4 dom × 5 g_focus × 2 stim = 40 samples (H_350 identical sweep)
fn run_sweep() -> dict {
    let mut si_arr = []
    let mut phid_cov_arr = []
    let mut phid_kurt_arr = []

    let g_focus_vals = [1.0, 3.0, 5.0, 7.0, 10.0]
    let stim_seeds = [11111, 77777]

    let mut dom = 0
    while dom < SV_N_DOM {
        let mut gi = 0
        while gi < 5 {
            let g_focus = g_focus_vals[gi]
            let g_rest = (SV_CAPACITY - g_focus) / 3.0
            let mut g0 = g_rest
            let mut g1 = g_rest
            let mut g2 = g_rest
            let mut g3 = g_rest
            if dom == 0 { g0 = g_focus }
            if dom == 1 { g1 = g_focus }
            if dom == 2 { g2 = g_focus }
            if dom == 3 { g3 = g_focus }
            let mut si = 0
            while si < 2 {
                let stim = stim_seeds[si]
                let flat = build_profile_state(g0, g1, g2, g3, SV_D, stim)
                let dphi = domain_phi_vector(flat, SV_D)
                let si_val = savant_index(dphi)
                let cov_val = phi_diversity_cov(dphi)
                let kurt_val = phi_diversity_kurtosis(dphi)
                si_arr = si_arr.push(si_val)
                phid_cov_arr = phid_cov_arr.push(cov_val)
                phid_kurt_arr = phid_kurt_arr.push(kurt_val)
                si = si + 1
            }
            gi = gi + 1
        }
        dom = dom + 1
    }
    return #{
        "si": si_arr,
        "phid_cov": phid_cov_arr,
        "phid_kurt": phid_kurt_arr,
    }
}

fn min_arr(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] < m { m = v[i] }
        i = i + 1
    }
    return m
}

fn max_arr(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] > m { m = v[i] }
        i = i + 1
    }
    return m
}

fn mean_arr(v: array) -> float {
    let n = len(v)
    if n == 0 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n {
        s = s + v[i]
        i = i + 1
    }
    return s / to_float(n)
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_613 verify — SI vs ΦD-ORTHOGONAL (max-share artifact 제거)")
    println("════════════════════════════════════════════════════════════════")
    println("  SI         = max(domain_phi) / mean(domain_phi)  [unchanged]")
    println("  ΦD_cov     = std(domain_phi) / mean(domain_phi)  [orthogonal #1]")
    println("  ΦD_kurt    = E[(x-μ)^4] / σ^4                    [orthogonal #2]")
    println("  N samples  = 4 dom × 5 g_focus × 2 stim = 40")
    println("  H_350 baseline: r=0.9264 (SI vs ΦD_maxmin, max-shared)")
    println("")

    let res = run_sweep()
    let si_arr   = res["si"]
    let phid_cov = res["phid_cov"]
    let phid_kurt = res["phid_kurt"]

    let n = len(si_arr)
    println("  sample count = " + str(n))
    println("  SI range       = [" + str(min_arr(si_arr)) + ", " + str(max_arr(si_arr)) + "] mean=" + str(mean_arr(si_arr)))
    println("  ΦD_cov range   = [" + str(min_arr(phid_cov)) + ", " + str(max_arr(phid_cov)) + "] mean=" + str(mean_arr(phid_cov)))
    println("  ΦD_kurt range  = [" + str(min_arr(phid_kurt)) + ", " + str(max_arr(phid_kurt)) + "] mean=" + str(mean_arr(phid_kurt)))
    println("")

    let r_cov   = pearson_corr(si_arr, phid_cov)
    let rho_cov = spearman_corr(si_arr, phid_cov)
    let r_kurt  = pearson_corr(si_arr, phid_kurt)
    let rho_kurt = spearman_corr(si_arr, phid_kurt)

    println("──────────────────────────────────────────────────────────────")
    println("  ORTHOGONAL #1  SI ~ ΦD_cov (std/mean):")
    println("    Pearson  r = " + str(r_cov))
    println("    Spearman ρ = " + str(rho_cov))
    println("")
    println("  ORTHOGONAL #2  SI ~ ΦD_kurt (kurtosis):")
    println("    Pearson  r = " + str(r_kurt))
    println("    Spearman ρ = " + str(rho_kurt))
    println("──────────────────────────────────────────────────────────────")

    println("")
    println("  sample preview (SI, ΦD_cov, ΦD_kurt):")
    let mut k = 0
    while k < 8 {
        println("    [" + str(k) + "] SI=" + str(si_arr[k]) + " cov=" + str(phid_cov[k]) + " kurt=" + str(phid_kurt[k]))
        k = k + 1
    }
    println("    ...")
    let mut kk = n - 4
    while kk < n {
        println("    [" + str(kk) + "] SI=" + str(si_arr[kk]) + " cov=" + str(phid_cov[kk]) + " kurt=" + str(phid_kurt[kk]))
        kk = kk + 1
    }
    println("")

    // Falsifier — primary check on ΦD_cov (most direct orthogonal)
    // PASS if r_cov >= 0.5  ; FAIL if r_cov < 0.5 (max-share artifact 발각)
    let mut pass = true
    let mut reason = ""
    if r_cov < 0.0 {
        pass = false
        reason = "Pearson r(SI, ΦD_cov) 음의 상관 → FALSIFIED (max-share artifact 발각)"
    }
    if r_cov < 0.5 {
        pass = false
        reason = "Pearson r(SI, ΦD_cov)=" + str(r_cov) + " < 0.5 → FALSIFIED (max-share artifact 발각)"
    }

    println("══════════════════════════════════════════════════════════════")
    if pass {
        println("  VERDICT: 🟢 SUPPORTED-NUMERICAL")
        println("  r(SI, ΦD_cov)  = " + str(r_cov)  + " ρ=" + str(rho_cov))
        println("  r(SI, ΦD_kurt) = " + str(r_kurt) + " ρ=" + str(rho_kurt))
        println("  H_350 SUPPORTED 가 max-share artifact 가 아니었음 (orthogonal metric 도 보존)")
    } else {
        println("  VERDICT: 🔴 FALSIFIED")
        println("  " + reason)
    }
    println("══════════════════════════════════════════════════════════════")
}
