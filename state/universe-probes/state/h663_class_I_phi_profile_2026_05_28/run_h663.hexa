// ════════════════════════════════════════════════════════════════════════════
//  run_h663.hexa — H_663 Wolfram class-I × Φ-property profile (matrix empty row)
//
//  CONTEXT (round 9-11 substrate-class × Φ-property matrix)
//    class II(rule184) / III(rule30 chaotic, rule90 additive) / IV(rule110) 는
//    7 Φ-속성에서 측정됨. class-I (rule 8/136 — 거의 모든 초기조건이 단일
//    homogeneous 상태로 수렴) 만 미측정 = 매트릭스의 빈 행. 본 H = class-I
//    전속성 프로파일로 그 빈 행을 채운다.
//
//  HYPOTHESIS
//    class-I (rule 8 — 빠른 homogeneous 수렴) 이 모든 Φ-속성에서 BOTTOM
//    (floor class): magnitude≈0 (additive rule90 처럼), convexity 최소,
//    closure-band 부재. 동역학 복잡도 I < II < III < IV 가 Φ-구조 전반에서
//    class-I 를 최하단에 둔다 (round 10 "IV 最高 단조" 의 반대 극).
//
//  FALSIFIER
//    class-I 가 어떤 Φ-속성에서 class-II(rule184)/III 초과 (bottom 아님)
//    → class-I floor 가설 반증, class 단조가 양 극단 중 한쪽만.
//
//  SUBSTRATE & ENGINES (기존 매트릭스 측정자 verbatim 재사용)
//    P1 magnitude_faithful : eca_tpm(rule,4) I=0 · faithful big_phi · 16-state mean
//                            (H_654 engine; class-II/III/IV 비교값 = H_654 result.json)
//    P2 magnitude_collective: n=5 homog cohort [rule×5] · big_phi_bounded sys=0
//                             cap=3 · W=1.0 full-coupling 의 Φ
//                             (H_653/H_660 engine; W=1.0 점)
//    P3 convexity_span     : 동 collective engine · W grid 6점 · span ratio
//                            Φ_max/Φ_min (H_653 engine; class 비교값 = H_653 log)
//    P4 homogeneity_confirm: rule 8 의 ECA 가 실제로 거의-전부 0 으로 수렴하는지
//                            (TPM bit 합) — class-I 정의 검증
//
//  CRITERIA (pre-registered, frozen BEFORE measuring)
//    F663.1 MAG-FAITHFUL-FLOOR : P1(rule8) < P1(rule184=12.6273) AND
//                                 P1(rule8) < P1(rule30=13.8852)
//                                 (class-I faithful magnitude < class-II AND < III)
//    F663.2 CONVEXITY-FLOOR    : P3(rule8) ≤ P3(rule184=12.1163)
//                                 (class-I convexity ≤ class-II = 매트릭스 하한)
//    F663.3 COLLECTIVE-FLOOR   : P2(rule8) < P2(rule184) (W=1.0 collective Φ
//                                 가 class-II 보다 작음 — 동일 engine 비교)
//    F663.4 HOMOGENEITY        : rule 8 TPM 의 1-bit 비율 < 0.2 (거의 전부
//                                 0 으로 수렴 = class-I homogeneous 정의 충족)
//    F663.5 BOUND              : 모든 Φ ≥ 0, span ratio 유한
//
//  AGGREGATE
//    SUPPORTED-NUMERICAL = F663.1 AND (F663.2 OR F663.3) AND F663.4 AND F663.5
//                          (faithful-floor + 한 collective-floor + homogeneity)
//    PARTIAL             = F663.4 PASS 이나 floor 일부만
//    FALSIFIED           = class-I 가 어떤 속성에서 class-II/III 초과 (F663.1
//                          AND floor 둘 다 FAIL) → floor 가설 반증
//
//  $0 · mac-local · hexa-only · foreground sync · NO GPU · deterministic.
// ════════════════════════════════════════════════════════════════════════════
import "/private/tmp/u-h663/HEXAD/IIT4/lib/iit4_eca.hexa"
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// ── P1 faithful magnitude (H_654 engine verbatim) ──────────────────────────
fn mean_big_phi(tpm: array, n: int) -> float {
    let full = iit4_pow2(n)
    let mut total = 0.0
    let mut s = 0
    while s < full {
        let r = big_phi(tpm, n, s)
        total = total + r[0]
        s = s + 1
    }
    return total / to_float(full)
}

fn intrinsic_phi(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)   // I=0, unmixed
    return mean_big_phi(tpm, n)
}

// ── P2/P3 collective n=5 coupled-ring (H_635/H_653/H_660 engine verbatim) ──
fn build_tpm_cohort(rule: array, W: float) -> array {
    let n = 5
    let full = 32
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let r_i = rule[i]
            let c = iit4_bit(s, i)
            let idx_dec = 4 * c + 2 * c + c        // = 7*c ∈ {0,7}
            let next_dec = iit4_bit(r_i, idx_dec)
            let l = iit4_bit(s, (i - 1 + n) % n)
            let rr = iit4_bit(s, (i + 1) % n)
            let idx_cou = 4 * l + 2 * c + rr
            let next_cou = iit4_bit(r_i, idx_cou)
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn phi_collective(rule: array, W: float) -> float {
    let tpm = build_tpm_cohort(rule, W)
    let r = big_phi_bounded(tpm, 5, 0, 3)
    return r[0]
}

// ── P4 homogeneity: fraction of 1-bits in the n=4 ECA next-state TPM ───────
//   class-I rule converges to all-0 ⇒ almost all next-states are 0 ⇒ low frac.
fn one_bit_frac(rule: int, n: int) -> float {
    let tpm = eca_tpm(rule, n)
    let total = len(tpm)
    let mut ones = 0.0
    let mut k = 0
    while k < total {
        if tpm[k] > 0.5 { ones = ones + 1.0 }
        k = k + 1
    }
    return ones / to_float(total)
}

fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    let n = len(xs)
    while i < n {
        if i > 0 { s = s + ", " }
        s = s + str(xs[i])
        i = i + 1
    }
    s = s + "]"
    return s
}

fn main() {
    println("════════════════════════════════════════════════════════════")
    println("H_663 Wolfram class-I × Φ-property profile (matrix empty row)")
    println("class-I rule 8 (homogeneous→0) vs class II/III/IV baselines")
    println("════════════════════════════════════════════════════════════")

    // class-I representative: rule 8 (only neighborhood 011→1; almost all →0).
    // rule 136 (010,011→1) is the alt class-I; rule 8 is the cleaner floor.
    let RULE_I = 8

    // ── P4 HOMOGENEITY confirm (class-I definition) ──
    let frac_i   = one_bit_frac(RULE_I, 4)
    let frac_184 = one_bit_frac(184, 4)
    let frac_110 = one_bit_frac(110, 4)
    println("── P4 homogeneity (1-bit frac of n=4 ECA TPM) ──")
    println("  rule8  (class-I)   one_bit_frac = " + str(frac_i))
    println("  rule184(class-II)  one_bit_frac = " + str(frac_184))
    println("  rule110(class-IV)  one_bit_frac = " + str(frac_110))

    // ── P1 FAITHFUL magnitude (H_654 engine; class-I new + baselines re-measured for parity) ──
    let p1_i   = intrinsic_phi(RULE_I, 4)
    let p1_184 = intrinsic_phi(184, 4)   // re-measure to confirm H_654 12.6273
    let p1_30  = intrinsic_phi(30, 4)    // re-measure to confirm H_654 13.8852
    let p1_110 = intrinsic_phi(110, 4)   // re-measure to confirm H_654 13.1302
    println("")
    println("── P1 faithful magnitude (n=4 I=0 16-state mean big_phi) ──")
    println("  rule8  (class-I)   Φ = " + str(p1_i))
    println("  rule184(class-II)  Φ = " + str(p1_184))
    println("  rule30 (class-III) Φ = " + str(p1_30))
    println("  rule110(class-IV)  Φ = " + str(p1_110))

    // ── P2/P3 COLLECTIVE (H_653 engine; W grid) ──
    let WGRID = [0.15, 0.40, 0.55, 0.70, 0.95, 1.0]
    let NW = 6
    let cohort_i   = [RULE_I, RULE_I, RULE_I, RULE_I, RULE_I]
    let cohort_184 = [184, 184, 184, 184, 184]

    let mut phi_w_i = []
    let mut wi = 0
    while wi < NW {
        phi_w_i = phi_w_i + [phi_collective(cohort_i, WGRID[wi])]
        wi = wi + 1
    }
    // class-I collective Φ at each W
    let mut pmin_i = phi_w_i[0]
    let mut pmax_i = phi_w_i[0]
    wi = 0
    while wi < NW {
        if phi_w_i[wi] < pmin_i { pmin_i = phi_w_i[wi] }
        if phi_w_i[wi] > pmax_i { pmax_i = phi_w_i[wi] }
        wi = wi + 1
    }
    let FLOOR = 0.0001
    let span_i = pmax_i / (pmin_i + FLOOR)
    let p2_i = phi_w_i[5]   // W=1.0 collective magnitude

    // class-II rule184 collective for the COLLECTIVE-FLOOR comparison (same engine)
    let p2_184 = phi_collective(cohort_184, 1.0)

    println("")
    println("── P2/P3 collective (n=5 cohort · big_phi_bounded sys=0 cap=3) ──")
    println("  rule8 Φ(W): " + json_arr_f(phi_w_i))
    println("  rule8  collective Φ@W=1.0 (P2) = " + str(p2_i))
    println("  rule184 collective Φ@W=1.0     = " + str(p2_184))
    println("  rule8  convexity span_ratio (P3) = " + str(span_i)
        + "   (Φ_min=" + str(pmin_i) + " Φ_max=" + str(pmax_i) + ")")
    println("  [baseline H_653 span] rule184=12.1163 rule90=30.4167 rule30=30.7705 rule110=35.4975")

    // ── FALSIFIERS ──
    println("")
    println("── falsifiers ──")
    // F663.1 faithful-floor: class-I < class-II AND < class-III faithful magnitude
    let f1 = (p1_i < p1_184) && (p1_i < p1_30)
    check("F663.1 MAG-FAITHFUL-FLOOR: P1(8) < P1(184) AND < P1(30)", f1)

    // F663.2 convexity-floor: class-I span ≤ class-II span (12.1163)
    let f2 = span_i <= 12.1163 + 0.0001
    check("F663.2 CONVEXITY-FLOOR: span(8) <= span(184)=12.1163", f2)

    // F663.3 collective-floor: class-I W=1.0 collective < class-II W=1.0 collective
    let f3 = p2_i < p2_184
    check("F663.3 COLLECTIVE-FLOOR: P2(8) < P2(184) @W=1.0", f3)

    // F663.4 homogeneity: rule8 1-bit frac < 0.2 (class-I → all-0 convergence)
    let f4 = frac_i < 0.2
    check("F663.4 HOMOGENEITY: rule8 one_bit_frac < 0.2", f4)

    // F663.5 bound: all Φ ≥ 0 finite
    let mut bound_ok = (p1_i >= 0.0) && (p2_i >= 0.0) && (span_i >= 0.0)
    wi = 0
    while wi < NW { if phi_w_i[wi] < 0.0 { bound_ok = false }; wi = wi + 1 }
    if span_i > 1.0e12 { bound_ok = false }
    check("F663.5 BOUND: Φ ≥ 0, span finite", bound_ok)

    // ── AGGREGATE ──
    let floor_any = f2 || f3
    let supported = f1 && floor_any && f4 && bound_ok
    let mut verdict = "🔴 FALSIFIED"
    if supported {
        verdict = "🟢 SUPPORTED-NUMERICAL"
    } else if f4 {
        verdict = "🟠 PARTIAL"
    }

    println("")
    println("════════════════════════════════════════════════════════════")
    println("  F663.1-5 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")
    println("  VERDICT = " + verdict)
    println("════════════════════════════════════════════════════════════")

    // ── write result.json ──
    let mut f1f = 0
    if f1 { f1f = 1 }
    let mut f2f = 0
    if f2 { f2f = 1 }
    let mut f3f = 0
    if f3 { f3f = 1 }
    let mut f4f = 0
    if f4 { f4f = 1 }
    let mut f5f = 0
    if bound_ok { f5f = 1 }

    let mut s = "{\n"
    s = s + "  \"id\": \"H_663\",\n"
    s = s + "  \"slug\": \"wolfram-class-I-phi-property-profile\",\n"
    s = s + "  \"axis\": \"G\",\n"
    s = s + "  \"meta_axis\": \"round 9-11 substrate-class × Φ-property matrix — class-I empty row\",\n"
    s = s + "  \"date\": \"2026-05-28\",\n"
    s = s + "  \"infra\": \"$0 mac-local · foreground sync · NO GPU · deterministic\",\n"
    s = s + "  \"class_I_rule\": 8,\n"
    s = s + "  \"engines\": \"H_654 faithful big_phi (n=4) · H_653/H_660 collective big_phi_bounded (n=5 cap=3 sys=0)\",\n"
    s = s + "  \"P1_magnitude_faithful\": {\"rule8\": " + str(p1_i)
        + ", \"rule184\": " + str(p1_184) + ", \"rule30\": " + str(p1_30)
        + ", \"rule110\": " + str(p1_110) + "},\n"
    s = s + "  \"P2_magnitude_collective_W1\": {\"rule8\": " + str(p2_i)
        + ", \"rule184\": " + str(p2_184) + "},\n"
    s = s + "  \"P3_convexity_span\": {\"rule8\": " + str(span_i)
        + ", \"rule184_baseline\": 12.1163, \"rule90_baseline\": 30.4167, \"rule30_baseline\": 30.7705, \"rule110_baseline\": 35.4975},\n"
    s = s + "  \"P4_homogeneity_one_bit_frac\": {\"rule8\": " + str(frac_i)
        + ", \"rule184\": " + str(frac_184) + ", \"rule110\": " + str(frac_110) + "},\n"
    s = s + "  \"rule8_phi_grid_collective\": " + json_arr_f(phi_w_i) + ",\n"
    s = s + "  \"falsifiers\": {\"F663.1_MAG-FAITHFUL-FLOOR\": " + str(f1f)
        + ", \"F663.2_CONVEXITY-FLOOR\": " + str(f2f)
        + ", \"F663.3_COLLECTIVE-FLOOR\": " + str(f3f)
        + ", \"F663.4_HOMOGENEITY\": " + str(f4f)
        + ", \"F663.5_BOUND\": " + str(f5f) + "},\n"
    s = s + "  \"pass\": " + str(PASS) + ",\n"
    s = s + "  \"total\": " + str(PASS + FAIL) + ",\n"
    s = s + "  \"verdict\": \"" + verdict + "\"\n"
    s = s + "}\n"
    write_file("UNIVERSE/state/h663_class_I_phi_profile_2026_05_28/result.json", s)
    println("wrote UNIVERSE/state/h663_class_I_phi_profile_2026_05_28/result.json")
}
