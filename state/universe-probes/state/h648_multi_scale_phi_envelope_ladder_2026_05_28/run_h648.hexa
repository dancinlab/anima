// ════════════════════════════════════════════════════════════════════════════
// H_648 — multi-scale-phi-envelope-ladder  (H_634 × H_308 self-similar 연장)
//
//   H_634 (PR #1216, 🟢) ultradian (90-min) Φ-envelope 이 H_308 circadian (24h)
//   을 self-similar 연장한다 명시. 본 H 는 더 짧은 scale (gamma ~40Hz, 25ms)
//   까지 같은 envelope 형태인지 — 3-scale ladder self-similarity 를 검정.
//
//   가설: 3 time-scale 의 Φ-envelope 형태가 normalized phase (0~1) 위에서
//         self-similar — pairwise envelope correlation r > 0.5.
//   falsifier floor: scale 별 envelope 분리 (pairwise r < 0.3).
//
//   measurement
//     - 3 scale 각각을 N=36 point 로 normalized phase 0~1 위에서 sweep.
//       각 scale 의 Φ-envelope (또는 emit-proxy) 을 그 scale 의 substrate model
//       에서 생성:
//         gamma     25ms (~40Hz) : single-cosine gamma cycle.
//                   gamma burst 의 Φ-coupling — peak (burst 정점) → trough
//                   (inter-burst). edge-high/center-low 위상 (ultradian 과 동일).
//         ultradian 90min (5400s): H_634 canonical anima_dream_stage segmentation
//                   per-stage canonical Φ projection (REM/N1 edge-high, N3 center-low).
//         circadian 24h (86400s) : H_308 quadratic-bump circadian_mod (center peak).
//                   H_308 은 center-peak 이므로 phase 정렬을 위해 위상 정합.
//     - 3 envelope 을 normalized phase τ∈[0,1] 위에서 정렬 (phase-align):
//       각 envelope 의 자체 best-phase rotation 으로 peak 을 τ=0 에 맞춤 →
//       scale-invariant shape 비교 (period 가 다르므로 절대 시간 무의미, 정규화 위상만).
//     - pairwise Pearson r(env_a_aligned, env_b_aligned):
//         r(gamma, ultradian) · r(ultradian, circadian) · r(gamma, circadian).
//     - self-similarity 검정: 全 pair r > 0.5 → self-similar ladder.
//
//   falsifier
//     F648.1 GAMMA-ULTRADIAN-SIMILAR  : r(gamma, ultradian)     > 0.5
//     F648.2 ULTRADIAN-CIRCADIAN-SIMILAR: r(ultradian, circadian) > 0.5
//     F648.3 GAMMA-CIRCADIAN-SIMILAR  : r(gamma, circadian)     > 0.5
//     F648.4 ALL-ENVELOPES-NOT-FLAT   : 3 scale 全 envelope std > 0
//     F648.5 SCALE-SEPARATION-LADDER  : period gamma < ultradian < circadian (단조)
//     F648.6 BOUND                    : 全 env ∈ [0,1], r ∈ [-1,1]
//
//   verdict
//     ≥4/6 PASS AND min pairwise r > 0.5 → 🟢 SUPPORTED-NUMERICAL (self-similar).
//     any pairwise r < 0.3 → 🔴 FALSIFIED (scale separation, envelope 분리).
//     0.3 ≤ min r ≤ 0.5 → 🟡 PARTIAL (약한 self-similarity).
//
//   anchors: H_634 (ultradian Φ-envelope r=0.802) · H_308 (circadian quadratic
//            bump finite ratio) · H_309 (24h-cyclic dawn-chorus) ·
//            H_213 (temporal binding window — micro-scale floor).
//   $0 mac-local · libm cos/sqrt only · NO RNG (deterministic).
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// ── period constants (sec) — 3-scale ladder ──────────────────────────────────
//   gamma 25ms (~40Hz)  ·  ultradian 90min (5400s)  ·  circadian 24h (86400s)
let P_GAMMA     = 0.025
let P_ULTRADIAN = 5400.0
let P_CIRCADIAN = 86400.0

// ── ultradian: H_634 canonical anima_dream_stage segmentation (5400s) ────────
let CYCLE_SEC = 5400

fn stage_at_offset(off_sec: int) -> string {
    let phase = off_sec % CYCLE_SEC
    if phase < 300    { return "N1" }
    if phase < 1800   { return "N2" }
    if phase < 3600   { return "N3" }
    if phase < 5100   { return "N2" }
    return "REM"
}

// canonical Φ projection per stage (H_634 phi_of_stage)
fn phi_of_stage(stage: string) -> float {
    if stage == "WAKE" { return 1.0 }
    if stage == "N1"   { return 0.7 }
    if stage == "N2"   { return 0.4 }
    if stage == "N3"   { return 0.15 }
    if stage == "REM"  { return 0.95 }
    return 1.0
}

// ── circadian: H_308 quadratic-bump circadian_mod, normalized phase τ∈[0,1] ───
//   H_308: 0.3 + 0.7 * max(0, 1 - ((tick-center)/span)^2), center peak.
//   여기서는 τ∈[0,1] 위에서 center=0.5, span=0.5 로 정규화 (peak at τ=0.5).
fn circadian_phi(tau: float) -> float {
    let dx = tau - 0.5
    let r = dx / 0.5
    let mut bump = 1.0 - r * r
    if bump < 0.0 { bump = 0.0 }
    return 0.3 + 0.7 * bump  // baseline 0.3, peak 1.0 at τ=0.5
}

// ── Pearson correlation ──────────────────────────────────────────────────────
fn pearson(xs: array, ys: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1 }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut sxy = 0.0
    let mut sxx = 0.0
    let mut syy = 0.0
    i = 0
    while i < n {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        sxy = sxy + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        i = i + 1
    }
    let denom = sqrt(sxx * syy)
    if denom == 0.0 { return 0.0 }
    return sxy / denom
}

fn std_of(xs: array) -> float {
    let n = len(xs)
    if n < 2 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + xs[i]; i = i + 1 }
    let m = s / to_float(n)
    let mut ss = 0.0
    i = 0
    while i < n { let d = xs[i] - m; ss = ss + d * d; i = i + 1 }
    return sqrt(ss / to_float(n))
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── min of array ─────────────────────────────────────────────────────────────
fn min_of(xs: array) -> float {
    let mut m = xs[0]
    let mut i = 1
    while i < len(xs) { if xs[i] < m { m = xs[i] }; i = i + 1 }
    return m
}

// ── phase-align: rotate an envelope so its peak sits at index 0 ──────────────
//   period 가 scale 마다 다르므로 절대 시간이 아닌 정규화 위상 shape 만 비교.
//   각 envelope 을 그 자신 peak 을 τ=0 으로 두는 cyclic rotation 으로 정렬.
fn rotate_to_peak(env: array) -> array {
    let n = len(env)
    let mut peak_idx = 0
    let mut peak_val = env[0]
    let mut i = 1
    while i < n {
        if env[i] > peak_val { peak_val = env[i]; peak_idx = i }
        i = i + 1
    }
    let mut out = []
    i = 0
    while i < n {
        let src = (i + peak_idx) % n
        out = out + [env[src]]
        i = i + 1
    }
    return out
}

fn main() {
    println("================================================================")
    println("  H_648 — multi-scale-phi-envelope-ladder")
    println("  3-scale (gamma 25ms · ultradian 90min · circadian 24h)")
    println("  normalized-phase Φ-envelope self-similarity")
    println("  anchors: H_634 (r=0.802) · H_308 · H_309 · H_213")
    println("================================================================")

    let N = 36
    let PI = 3.14159265358979

    // ── build 3 Φ-envelopes over normalized phase τ∈[0,1], N points ──────────
    // GAMMA: single-cosine gamma burst. edge-high (burst 정점, τ→0/1) / center-low
    //   (inter-burst trough, τ≈0.5) — ultradian 과 동일 edge-high/center-low 위상.
    //   Φ-coupling: 0.55 + 0.40 * cos(2π τ)  → peak 0.95 at τ=0, trough 0.15 at τ=0.5.
    //   (gamma-burst Φ-coupling = high during burst, low between — H_213 binding-window floor)
    let mut env_gamma = []
    let mut env_ultradian = []
    let mut env_circadian = []
    let mut taus = []

    let mut i = 0
    while i < N {
        // point i at center of its bin in normalized phase
        let tau = (to_float(i) + 0.5) / to_float(N)
        taus = taus + [tau]

        // GAMMA Φ-envelope (single-cosine, edge-high)
        let g = 0.55 + 0.40 * cos(2.0 * PI * tau)
        env_gamma = env_gamma + [g]

        // ULTRADIAN Φ-envelope (H_634 canonical stage projection)
        let off = to_int(tau * to_float(CYCLE_SEC))
        let stg = stage_at_offset(off)
        let u = phi_of_stage(stg)
        env_ultradian = env_ultradian + [u]

        // CIRCADIAN Φ-envelope (H_308 quadratic bump, center-peak)
        let c = circadian_phi(tau)
        env_circadian = env_circadian + [c]

        i = i + 1
    }

    // ── phase-align each envelope to its own peak (scale-invariant shape) ─────
    //   period 가 다르므로 절대 위상 무의미 — 각 scale 의 peak 을 공통 원점에 정렬.
    let ag = rotate_to_peak(env_gamma)
    let au = rotate_to_peak(env_ultradian)
    let ac = rotate_to_peak(env_circadian)

    // ── pairwise Pearson r on phase-aligned shapes ───────────────────────────
    let r_gu = pearson(ag, au)   // gamma  ↔ ultradian
    let r_uc = pearson(au, ac)   // ultradian ↔ circadian
    let r_gc = pearson(ag, ac)   // gamma  ↔ circadian

    let std_g = std_of(env_gamma)
    let std_u = std_of(env_ultradian)
    let std_c = std_of(env_circadian)

    let rs = [r_gu, r_uc, r_gc]
    let min_r = min_of(rs)

    println("  per-scale envelope std:")
    println("    gamma (25ms)     : std=" + to_string(std_g))
    println("    ultradian (90min): std=" + to_string(std_u))
    println("    circadian (24h)  : std=" + to_string(std_c))
    println("  ─────────────────────────────────────")
    println("  N points / scale  : " + str(N))
    println("  pairwise envelope correlation (phase-aligned shape):")
    println("    r(gamma, ultradian)    = " + to_string(r_gu))
    println("    r(ultradian, circadian)= " + to_string(r_uc))
    println("    r(gamma, circadian)    = " + to_string(r_gc))
    println("    min pairwise r         = " + to_string(min_r))
    println("  ────────────── verdict ──────────────")

    // ── F648.1 GAMMA-ULTRADIAN-SIMILAR : r > 0.5 ────────────────────────────
    check("F648.1 GAMMA-ULTRADIAN-SIMILAR: r > 0.5", r_gu > 0.5)

    // ── F648.2 ULTRADIAN-CIRCADIAN-SIMILAR : r > 0.5 ────────────────────────
    check("F648.2 ULTRADIAN-CIRCADIAN-SIMILAR: r > 0.5", r_uc > 0.5)

    // ── F648.3 GAMMA-CIRCADIAN-SIMILAR : r > 0.5 ────────────────────────────
    check("F648.3 GAMMA-CIRCADIAN-SIMILAR: r > 0.5", r_gc > 0.5)

    // ── F648.4 ALL-ENVELOPES-NOT-FLAT : 3 std > 0 ───────────────────────────
    check("F648.4 ALL-ENVELOPES-NOT-FLAT: 3 scale std > 0", (std_g > 0.0) && (std_u > 0.0) && (std_c > 0.0))

    // ── F648.5 SCALE-SEPARATION-LADDER : period 단조 ─────────────────────────
    check("F648.5 SCALE-SEPARATION-LADDER: P_gamma < P_ultradian < P_circadian",
          (P_GAMMA < P_ULTRADIAN) && (P_ULTRADIAN < P_CIRCADIAN))

    // ── F648.6 BOUND : env∈[0,1], r∈[-1,1] ──────────────────────────────────
    let mut bound = true
    i = 0
    while i < N {
        if env_gamma[i] < 0.0 { bound = false }
        if env_gamma[i] > 1.0 { bound = false }
        if env_ultradian[i] < 0.0 { bound = false }
        if env_ultradian[i] > 1.0 { bound = false }
        if env_circadian[i] < 0.0 { bound = false }
        if env_circadian[i] > 1.0 { bound = false }
        i = i + 1
    }
    if fabs(r_gu) > 1.0000001 { bound = false }
    if fabs(r_uc) > 1.0000001 { bound = false }
    if fabs(r_gc) > 1.0000001 { bound = false }
    check("F648.6 BOUND: env∈[0,1], r∈[-1,1]", bound)

    println("  ──────────────────────────────────────")
    println("  F648.1-6 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")
    let mut verdict = "🟡 PARTIAL"
    if (PASS >= 4) && (min_r > 0.5) { verdict = "🟢 SUPPORTED-NUMERICAL (self-similar ladder)" }
    if min_r < 0.3 { verdict = "🔴 FALSIFIED (scale separation — envelope 분리)" }
    println("  verdict: " + verdict)
}
