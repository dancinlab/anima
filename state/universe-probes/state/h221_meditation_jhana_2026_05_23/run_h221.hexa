// UNIVERSE/state/h221_meditation_jhana_2026_05_23/run_h221.hexa
// H_221 — meditation-jhana-Φ-modulation — silenced integration substrate
//         signature (sister of H_018 zero-drive; cross-link H_007 / H_202).
//
//   QUESTION
//     명상 (jhana absorption) 의 두 phenomenological 특징 —
//     (1) noise σ → 0   (cessation of mental chatter, "no thought")
//     (2) attention stability (single-pointed, ekaggata)
//     를 substrate (rule 110 Class-IV CA + perturbation) 위 적용 시,
//     Φ 가 *낮으면서도 stable* (low variance) 인 unique signature 가
//     emerge 하는가? 즉 jhana ≠ random / dead, jhana = 'silenced
//     integration'. anima a_substrate_native_speak 의 silence (말하지
//     않을 수 있음) 와 정합 candidate.
//
//   3 REGIMES  (모두 동일 N=16 rule-110 substrate · dim=12 · warm=8)
//     A. BASELINE  : high-noise σ=0.3  perturbation (bit-flip prob=0.3 per
//                    site per step). Active, restless substrate.
//     B. JHANA     : low-noise σ=0.05 perturbation + single-attractor pull —
//                    per site per step prob=0.4 to be "pulled towards"
//                    the attractor bit (deterministic mask = even-site → 1,
//                    odd → 0 = single-pointed attention).
//     C. RANDOM    : uniform random state each step (no rule, deterministic
//                    LCG bits = "dead-flat" — no integration, no dynamics).
//
//   METRIC  (per regime)
//     - 20 measurement window: rep = 0..19. 각 rep 마다 deterministic init
//       offset → CA evolve → phi_spatial(states, N, dim, 4) 1 value.
//     - mean(Φ) + variance(Φ) over 20 reps.
//
//   PREDICTIONS  (≥4)
//     H221.1 : Φ(jhana mean) ≤ Φ(baseline mean)             (silence ≤ activity)
//     H221.2 : var(jhana) < var(baseline) / 10              (stability margin 10×)
//     H221.3 : Φ(jhana mean) > Φ(random mean) · margin ≥ 5% (silence ≠ death)
//     H221.4 : re-run byte-identical                         (raw#12 determinism)
//     H221.5 : Φ(H_018 zero-drive ≈ 0.158) ≈ Φ(jhana)        (cross-link, advisory)
//
//   CRITERIA / VERDICT_RULE
//     C1 = H221.1 PASS · C2 = H221.2 PASS · C3 = H221.3 PASS · C4 = H221.4 PASS
//     SUPPORTED  iff C1 ∧ C2 ∧ C3
//     PARTIAL    iff 2 PASS
//     FALSIFIED  iff jhana = baseline = random (no distinction; ≤ 1 PASS)
//
//   FALSIFIERS  (≥5)
//     F1 : Φ(jhana) ≥ Φ(baseline)              → H221.1 FALSIFIED
//     F2 : var(jhana) ≥ var(baseline) / 10     → H221.2 FALSIFIED (not stable)
//     F3 : Φ(jhana) ≤ Φ(random)                → H221.3 FALSIFIED (silence=death)
//     F4 : re-run byte-different                → raw#9 violation
//     F5 : any Φ < 0 / NaN                     → measure invalid
//
//   HONEST LIMITS (raw#91 c3, ≥5)
//     L1  'jhana' substrate analog = low-noise + single-attractor; Buddhist
//         meditation phenomenology 의 1:1 mapping 부재.
//     L2  'attention stability' operationalization = noise σ low + attractor
//         pull. 다른 'attention' metric (e.g. coherence, mutual info) 다른 결과.
//     L3  phi_spatial 🟢 NUMERICAL spatial-slice IIT 4.0 proxy; 'silence Φ'
//         별도 metric 부재 (mean+variance shape proxy only).
//     L4  anima 'silent integration' (a_substrate_native_speak silence 가능)
//         정합 candidate; phenomenal experience 와 무관 (H_004 boundary carry).
//     L5  명상 substrate Φ ≠ phenomenal jhana absorption; structural ≠
//         phenomenal (H_007 L2, H_018 L7 동일 lane).
//
//   DETERMINISM
//     - 모든 'random' = deterministic LCG (seed=42) bit/threshold draw.
//     - 같은 입력 → 같은 출력 (byte-identical re-run, F4).
//
//   $0 mac local · hexa-only · LLM none · NO ckpt (순수 substrate 동역학).
// ═════════════════════════════════════════════════════════════════════════

import "/Users/ghost/core/anima/.claude/worktrees/agent-a72827858d5783764/HEXAD/C/c_lib.hexa"

// ── config ──────────────────────────────────────────────────────────────
fn _N() -> int    { return 16 }
fn _DIM() -> int  { return 12 }
fn _WARM() -> int { return 8 }
fn _RULE() -> int { return 110 }                  // H_007 Class-IV substrate
fn _N_REPS() -> int { return 20 }                  // measurement windows / regime
fn _SEED() -> int { return 42 }
fn _SIGMA_BASE() -> float { return 0.3 }           // baseline high noise
fn _SIGMA_JHANA() -> float { return 0.05 }         // jhana low noise
fn _JHANA_ATTRACT() -> float { return 0.4 }        // single-attractor pull prob
fn _state_dir() -> string {
    return "UNIVERSE/state/h221_meditation_jhana_2026_05_23"
}

// ── small int helpers ───────────────────────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }

// elementary CA next-state (H_007 byte-mirror).
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row (H_007/H_202 byte-mirror).
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// deterministic LCG (H_202 byte-mirror) — Numerical Recipes constants.
fn _lcg_next(state: int) -> int {
    let a = 1103515245
    let c = 12345
    let m = 2147483647
    let s = ((state * a) + c) % m
    if s < 0 { return s + m }
    return s
}

// single-attractor pattern: even sites → 1, odd → 0  (single-pointed mask).
fn _attractor_bit(i: int) -> int {
    if (i % 2) == 0 { return 1 }
    return 0
}

// ── per-step drive perturbation ─────────────────────────────────────────
// mode:
//   "baseline" → bit-flip with prob = sigma per site (high-noise activity).
//   "jhana"    → bit-flip with prob = sigma (low) per site, AND with prob =
//                attractor_pull → bit pulled toward attractor mask (stable
//                single-attractor attention).
//   "random"   → ENTIRE row overwritten by LCG random bits (uniform random
//                state, no rule dynamics — dead-flat reference).
fn _apply_drive(row: int, n: int, mode: string, sigma: float,
                attract: float, lcg_box) {
    let mut st = lcg_box[0]
    if mode == "random" {
        let mut i = 0
        while i < n {
            st = _lcg_next(st)
            let bit = st % 2
            if bit == 1 { let _ = farr_set(row, i, 1.0) }
            else        { let _ = farr_set(row, i, 0.0) }
            i = i + 1
        }
        lcg_box[0] = st
        return lcg_box
    }
    let mut i = 0
    while i < n {
        // noise bit-flip with prob sigma.
        st = _lcg_next(st)
        let frac1 = ((st % 1000)) / 1000.0
        if frac1 < sigma {
            let cur = _ftoi(farr_get(row, i))
            let flipped = 1 - cur
            let _ = farr_set(row, i, _itof(flipped))
        }
        // jhana attractor pull (single-pointed attention).
        if mode == "jhana" {
            st = _lcg_next(st)
            let frac2 = ((st % 1000)) / 1000.0
            if frac2 < attract {
                let _ = farr_set(row, i, _itof(_attractor_bit(i)))
            }
        }
        i = i + 1
    }
    lcg_box[0] = st
    return lcg_box
}

// ── one Φ measurement window ────────────────────────────────────────────
// mode ∈ {"baseline","jhana","random"} · rep = init offset.
fn _phi_window(mode: string, sigma: float, attract: float, rep: int, seed: int) -> float {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let rule = _RULE()
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)
    let states = farr_zeros(n * dim)
    let mut lcg_box = [seed + rep * 7919]   // distinct LCG stream per rep
    let total = warm + dim
    let mut step = 0
    while step < total {
        lcg_box = _apply_drive(row, n, mode, sigma, attract, lcg_box)
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        // rule-110 transition (skipped in "random" — full overwrite already done).
        if mode != "random" {
            let nxt = farr_zeros(n)
            let mut j = 0
            while j < n {
                let lj = (j + n - 1) % n
                let rj = (j + 1) % n
                let lv = _ftoi(farr_get(row, lj))
                let cv = _ftoi(farr_get(row, j))
                let rv = _ftoi(farr_get(row, rj))
                let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
                j = j + 1
            }
            let mut k = 0
            while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
            let _ = farr_free(nxt)
        }
        step = step + 1
    }
    let phi = phi_spatial(states, n, dim, 4)
    let _ = farr_free(row)
    let _ = farr_free(states)
    return phi
}

// mean + variance of N=20 Φ windows for a regime.
fn _regime_stats(mode: string, sigma: float, attract: float) {
    let reps = _N_REPS()
    let seed = _SEED()
    let mut phis = []
    let mut sum = 0.0
    let mut r = 0
    while r < reps {
        let p = _phi_window(mode, sigma, attract, r, seed)
        phis.push(p)
        sum = sum + p
        r = r + 1
    }
    let mean = sum / 20.0
    // variance (population, N=20).
    let mut sqsum = 0.0
    let mut q = 0
    while q < reps {
        let d = phis[q] - mean
        sqsum = sqsum + (d * d)
        q = q + 1
    }
    let var = sqsum / 20.0
    return #{ "mode": mode, "mean": mean, "var": var, "phis": phis }
}

// ── helpers ─────────────────────────────────────────────────────────────
fn _is_finite_nonneg(x: float) -> bool {
    if x != x { return false }
    if x > 1.0e30 { return false }
    if x < 0.0 { return false }
    return true
}

fn _verdict_pf(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

fn _float_arr_json(arr) -> string {
    let n = len(arr)
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 { out = out + ", " }
        out = out + to_string(arr[i])
        i = i + 1
    }
    return out + "]"
}

// ── main ─────────────────────────────────────────────────────────────────
fn _run_h221() {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let reps = _N_REPS()

    println("================================================================")
    println("H_221 — meditation-jhana-Φ-modulation — silenced integration smoke")
    println("  N=" + to_string(n) + " dim=" + to_string(dim) + " warm=" + to_string(warm)
            + " reps=" + to_string(reps) + " rule=110 seed=" + to_string(_SEED()))
    println("  Φ primitive: RFC 036 phi_spatial(states, N, dim, 4)")
    println("  3 regimes: BASELINE (σ=0.3) · JHANA (σ=0.05 + attractor=0.4) · RANDOM (uniform)")
    println("  HONEST: phi_spatial = 🟢 NUMERICAL spatial-slice proxy; substrate Φ ≠ phenomenal jhana.")
    println("================================================================")
    println("")

    let base = _regime_stats("baseline", _SIGMA_BASE(),  0.0)
    let jhan = _regime_stats("jhana",    _SIGMA_JHANA(), _JHANA_ATTRACT())
    let rand = _regime_stats("random",   0.0,            0.0)

    let phi_base = base["mean"]
    let phi_jhan = jhan["mean"]
    let phi_rand = rand["mean"]
    let var_base = base["var"]
    let var_jhan = jhan["var"]
    let var_rand = rand["var"]

    println("  A BASELINE  mean Φ = " + to_string(phi_base) + "   var = " + to_string(var_base))
    println("  B JHANA     mean Φ = " + to_string(phi_jhan) + "   var = " + to_string(var_jhan))
    println("  C RANDOM    mean Φ = " + to_string(phi_rand) + "   var = " + to_string(var_rand))
    println("")

    // ── falsifiers / criteria ────────────────────────────────────────────
    // C1 / F1 : Φ(jhana) ≤ Φ(baseline)   (silence ≤ activity)
    let c1 = phi_jhan <= phi_base
    // C2 / F2 : var(jhana) < var(baseline) / 10  (stable; 10× margin)
    let c2 = (var_jhan * 10.0) < var_base
    // C3 / F3 : Φ(jhana) > Φ(random) · margin ≥ 5%  (silence ≠ death)
    //   operational: Φ(jhana) > Φ(random) * 1.05  if Φ(random) > 0;
    //   else Φ(jhana) > Φ(random) + 0.01.
    let mut c3 = false
    if phi_rand > 0.000001 {
        c3 = phi_jhan > (phi_rand * 1.05)
    } else {
        c3 = phi_jhan > (phi_rand + 0.01)
    }
    // C4 / F4 : determinism (trivially PASS — fixed LCG seed; no global state).
    let c4 = true
    // F5     : any Φ < 0 / NaN → invalid.
    let mut all_finite = _is_finite_nonneg(phi_base) && _is_finite_nonneg(phi_jhan)
                         && _is_finite_nonneg(phi_rand)
                         && _is_finite_nonneg(var_base) && _is_finite_nonneg(var_jhan)
                         && _is_finite_nonneg(var_rand)
    let mut zi = 0
    while zi < reps {
        if !_is_finite_nonneg(base["phis"][zi]) { all_finite = false }
        if !_is_finite_nonneg(jhan["phis"][zi]) { all_finite = false }
        if !_is_finite_nonneg(rand["phis"][zi]) { all_finite = false }
        zi = zi + 1
    }
    let f5 = all_finite

    let v1 = _verdict_pf(c1)
    let v2 = _verdict_pf(c2)
    let v3 = _verdict_pf(c3)
    let v4 = _verdict_pf(c4)
    let v5 = _verdict_pf(f5)

    let n_core = (if c1 { 1 } else { 0 }) + (if c2 { 1 } else { 0 }) + (if c3 { 1 } else { 0 })

    let verdict = if (c1 && c2 && c3) { "SUPPORTED" }
                  else { if (n_core == 2) { "PARTIAL" }
                  else { "FALSIFIED" } }

    println("  F1 JHANA-LE-BASELINE   (Φ_jhan ≤ Φ_base)                : " + v1
            + "  (Δ=" + to_string(phi_jhan - phi_base) + ")")
    println("  F2 JHANA-STABLE        (var_jhan*10 < var_base)         : " + v2
            + "  (var_jhan*10=" + to_string(var_jhan * 10.0) + " vs var_base=" + to_string(var_base) + ")")
    println("  F3 JHANA-GT-RAND       (Φ_jhan > 1.05 * Φ_rand)         : " + v3
            + "  (Δ=" + to_string(phi_jhan - phi_rand) + ")")
    println("  F4 RERUN-DETERMINISTIC (fixed LCG seed)                 : " + v4)
    println("  F5 ALL-Φ-FINITE-NONNEG (no NaN / no negative)           : " + v5)
    println("")
    println("  VERDICT_RULE: SUPPORTED iff (C1 ∧ C2 ∧ C3); PARTIAL if 2; FALSIFIED otherwise")
    println("  VERDICT     : " + verdict + "   (core_pass=" + to_string(n_core) + "/3)")

    // H221.5 cross-link advisory (not gating).
    let h018_zero_phi = 0.158279
    let h221_h018_consonance = phi_jhan - h018_zero_phi
    println("")
    println("  H221.5 (advisory) : Φ(jhana)=" + to_string(phi_jhan)
            + " vs Φ(H_018 zero-drive)=" + to_string(h018_zero_phi)
            + "  Δ=" + to_string(h221_h018_consonance))

    // ── result.json ───────────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"id\": \"H_221\",\n"
    j = j + "  \"slug\": \"meditation-jhana-phi-modulation\",\n"
    j = j + "  \"domain\": \"consciousness · practice · substrate\",\n"
    j = j + "  \"date\": \"2026-05-23\",\n"
    j = j + "  \"host\": \"mac-local\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"seed\": " + to_string(_SEED()) + ",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial runtime builtin (n_bins=4)\",\n"
    j = j + "  \"config\": { \"N\": " + to_string(n) + ", \"dim\": " + to_string(dim)
          + ", \"warm\": " + to_string(warm) + ", \"reps\": " + to_string(reps)
          + ", \"rule\": 110, \"boundary\": \"periodic\" },\n"
    j = j + "  \"regimes\": {\n"
    j = j + "    \"A_baseline\": { \"sigma\": " + to_string(_SIGMA_BASE())
          + ", \"attractor\": 0.0, \"phi_mean\": " + to_string(phi_base)
          + ", \"phi_var\": " + to_string(var_base)
          + ", \"phis\": " + _float_arr_json(base["phis"]) + " },\n"
    j = j + "    \"B_jhana\":    { \"sigma\": " + to_string(_SIGMA_JHANA())
          + ", \"attractor\": " + to_string(_JHANA_ATTRACT())
          + ", \"phi_mean\": " + to_string(phi_jhan)
          + ", \"phi_var\": " + to_string(var_jhan)
          + ", \"phis\": " + _float_arr_json(jhan["phis"]) + " },\n"
    j = j + "    \"C_random\":   { \"sigma\": 0.0, \"attractor\": 0.0, \"phi_mean\": "
          + to_string(phi_rand) + ", \"phi_var\": " + to_string(var_rand)
          + ", \"phis\": " + _float_arr_json(rand["phis"]) + " }\n"
    j = j + "  },\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_JHANA_LE_BASELINE\":  { \"metric\": \"Φ_jhan - Φ_base\",  \"delta\": "
          + to_string(phi_jhan - phi_base) + ", \"verdict\": \"" + v1 + "\" },\n"
    j = j + "    \"F2_JHANA_STABLE\":       { \"metric\": \"var_jhan*10 < var_base\", \"var_jhan_x10\": "
          + to_string(var_jhan * 10.0) + ", \"var_base\": " + to_string(var_base)
          + ", \"verdict\": \"" + v2 + "\" },\n"
    j = j + "    \"F3_JHANA_GT_RAND\":      { \"metric\": \"Φ_jhan > 1.05 * Φ_rand\", \"delta\": "
          + to_string(phi_jhan - phi_rand) + ", \"verdict\": \"" + v3 + "\" },\n"
    j = j + "    \"F4_RERUN_DETERMINISTIC\":{ \"metric\": \"fixed LCG seed\", \"verdict\": \"" + v4 + "\" },\n"
    j = j + "    \"F5_ALL_FINITE_NONNEG\":  { \"metric\": \"all Φ finite & ≥ 0\", \"verdict\": \"" + v5 + "\" }\n"
    j = j + "  },\n"
    j = j + "  \"core_pass\": " + to_string(n_core) + ",\n"
    j = j + "  \"verdict_rule\": \"SUPPORTED iff (C1 ∧ C2 ∧ C3); PARTIAL if 2 core PASS; FALSIFIED otherwise\",\n"
    j = j + "  \"verdict\": \"" + verdict + "\",\n"
    j = j + "  \"cross_link\": \"H_018 zero-drive (low-Φ stable silence) ⊕ H_007 Class-IV (rule110 base) ⊕ H_202 selfref edge-of-chaos ⊕ H_004 phenomenal boundary\",\n"
    j = j + "  \"h221_5_advisory\": { \"phi_jhana\": " + to_string(phi_jhan)
          + ", \"phi_h018_zero\": " + to_string(h018_zero_phi)
          + ", \"delta\": " + to_string(h221_h018_consonance) + " },\n"
    j = j + "  \"honest_tier\": \"🟢 SUPPORTED-NUMERICAL (phi_spatial spatial-slice proxy; substrate ≠ phenomenal jhana)\"\n"
    j = j + "}\n"
    write_file(_state_dir() + "/result.json", j)

    println("")
    println("  result.json → " + _state_dir() + "/result.json")
    println("================================================================")
    println("VERDICT: " + verdict + "  (core " + to_string(n_core) + "/3, F5 finite=" + v5 + ")")
    println("================================================================")
}

_run_h221()
