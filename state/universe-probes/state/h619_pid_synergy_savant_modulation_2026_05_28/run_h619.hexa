// UNIVERSE/state/h619_pid_synergy_savant_modulation_2026_05_28/run_h619.hexa
//
//   H_619 — PID synergy_ratio × SAVANT inhibition I sweep (E × F cross-link round 3)
//
//   cross-link
//     • H_355 (axis F1 round 1, 🟢) — 3-binary-substrate hivemind PID synergy_ratio = 1.0
//       across K ∈ {0.33, 0.67, 1.0} (XOR coupling density). Substrate identical here.
//     • H_348 (axis E1 round 1, 🟡 PARTIAL) — SAVANT inhibition I sweep, SI > 3 at
//       I = GZ_LOWER = 1/2 - ln(4/3) ≈ 0.21232.
//     • H_293/H_294 (axis A round 1) — ECA cell-flow PID, single-substrate sister.
//     • H_617 (planned sibling, axis E2/F2 round 3) — induced SI on hivemind.
//
//   QUESTION
//     Does SAVANT-state inhibition I modulate hivemind PID synergy_ratio? Or does
//     the H_355 invariant (synergy_ratio = 1.0 across K) survive untouched?
//
//   SUBSTRATE (extending H_355)
//     3 binary substrates × 1 cell each = 8-state. XOR coupling K = 0.67 fixed
//     (mask = [1,1,0] — 2 XOR cells + 1 identity), the H_355 mid-K mask used as
//     the canonical hivemind config (multi-K control included below for L4).
//
//   INHIBITION INJECTION (deterministic substrate-modulator)
//     For each XOR cell i with default next-state next_i^XOR = s0 ⊕ s1 ⊕ s2, the
//     inhibition I ∈ [0, 1] suppresses the synergistic computation by collapsing
//     a fraction I of the 8 source-state rows to "follow-source-0" (identity to
//     S0) instead of XOR. This injects shared information (S0 is now read by
//     two cells), creating redundancy. Deterministic: the FIRST round(I*8) source
//     rows (lexicographic) inherit identity-S0, the remainder keeps XOR.
//
//     I → number of identity-S0 rows out of 8 source states:
//       I=0.05 → 0 rows  (round(0.4) → 0)         ; pure H_355 mask
//       I=0.10 → 1 row
//       I=0.21 → 2 rows  (GZ_LOWER target)
//       I=0.25 → 2 rows
//       I=0.30 → 2 rows
//       I=0.40 → 3 rows
//       I=0.50 → 4 rows  (mid)
//       I=0.75 → 6 rows
//     (I=1.0 → 8 rows = pure identity = degenerate redundancy anchor;
//     not in sweep but anchor-checked separately).
//
//     The PID is recomputed per (mask, I) via the same 3-source net McGill
//     II_3 from H_355. synergy_ratio = syn / (syn + red).
//
//   PRE-REGISTERED FALSIFIER (frozen 2026-05-28, BEFORE measuring)
//     F619.1 SAVANT-MODULATES-PID:
//       synergy_ratio at I = GZ_LOWER ≈ 0.21 differs from synergy_ratio at I = 0
//       (the H_355 K=0.67 anchor, syn_ratio = 1.0) by at least 0.05.
//       OR: synergy_ratio curve over I sweep is non-flat (max - min ≥ 0.05).
//     F619.2 MONOTONE-MODULATION:
//       synergy_ratio is monotonically decreasing in I (more inhibition →
//       more redundancy → less synergy share). Strict non-increase across the
//       8-point sweep with at most 1 inversion tolerance.
//     F619.3 ANCHOR-CONSISTENCY:
//       I=0 reproduces H_355 K=0.67 mask=[1,1,0] result (synergy=2.0, red=0.0,
//       ratio=1.0). I=1 (pure identity collapse) reproduces a degenerate
//       state with ratio ≤ 0.5 (redundancy dominant).
//     F619.4 MULTI-K-INVARIANCE (L4):
//       The modulation pattern (non-flat curve) reproduces qualitatively for
//       K = 1.0 mask=[1,1,1] (full-XOR mask) — non-flat slope OR flat-at-1
//       (over-saturated case where every cell still has 2 sources XOR-active).
//     F619.5 BOUND/DET:
//       0 ≤ synergy ≤ 3 ; 0 ≤ redundancy ≤ 3 ; 0 ≤ ratio ≤ 1 ; re-run identical.
//     F619.6 POST-HOC:
//       no edit to verdict direction after measurement (raw#82).
//
//   VERDICT_RULE
//     F619.1 + F619.3 + F619.5 PASS  → 🟢 SUPPORTED-NUMERICAL  (SAVANT modulates PID)
//     F619.1 FAIL (flat) +F619.3+F619.5 PASS → 🔴 FALSIFIED   (synergy_ratio invariant)
//     mixed → 🟡 PARTIAL
//
//   honest scope (raw#91 c3)
//     • net 3-source McGill co-info (NOT full 18-atom WB lattice — same as H_355 L1)
//     • toy 3-binary substrate (H_355 L4 carry — small N)
//     • inhibition mechanism = deterministic row-collapse to S0-identity (one of
//       many SAVANT-state injection modes; H_348 uses dropout/gain affine)
//     • synergy_ratio at I=0 is necessarily 1.0 by H_355 XOR-family construction;
//       the modulation lives in the "how fast does the ratio decay as I rises"
//       curve shape — not in whether ratio is >0.5 at I=0
//     • PID-structure claim, NOT a collective-Φ tracking claim (H_355 L6 carry)
// ════════════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn approx(a: float, b: float) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < 0.000001 }
    return d < 0.000001
}
fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}
fn log2(x: float) -> float { return log(x) / log(2.0) }

fn pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn bit_at(s: int, i: int) -> int {
    return (s / pow2(i)) % 2
}

// Map inhibition I ∈ [0,1] to integer #identity-collapse-rows out of 8.
// Deterministic floor(I*8 + 0.5) (round-half-up).
fn inhibition_rows(I: float) -> int {
    let scaled = I * 8.0 + 0.5
    return to_int(scaled)
}

// Build the TPM under (xor_mask, I).
//   For each source state s ∈ {0..7}:
//     If s < n_identity_rows: every cell that *would* XOR instead reads bit_at(s,0)
//       (identity to S0). Identity cells unchanged.
//     Else: cell follows xor_mask[i] as in H_355 (XOR or identity).
fn build_tpm_inhib(xor_mask: array, I: float) -> array {
    let n = 3
    let n_id = inhibition_rows(I)
    let mut tpm = []
    let mut s = 0
    while s < 8 {
        let b0 = bit_at(s, 0)
        let b1 = bit_at(s, 1)
        let b2 = bit_at(s, 2)
        let xor3 = (b0 + b1 + b2) % 2
        let mut i = 0
        while i < n {
            let mut nxt = 0
            if xor_mask[i] == 1 {
                // XOR cell, possibly inhibited
                if s < n_id { nxt = b0 }
                else { nxt = xor3 }
            } else {
                // identity cell — cell i reads its own bit
                let mut cell_val = b0
                if i == 1 { cell_val = b1 }
                if i == 2 { cell_val = b2 }
                nxt = cell_val
            }
            tpm = tpm.push(to_float(nxt))
            i = i + 1
        }
        s = s + 1
    }
    return tpm
}

fn marg_entropy(counts: array, mask: int, total: float) -> float {
    let mut sub = []
    let mut z = 0
    while z < 16 { sub = sub.push(0); z = z + 1 }
    let mut k = 0
    while k < 16 {
        let key = k & mask
        sub[key] = sub[key] + counts[k]
        k = k + 1
    }
    let mut h = 0.0
    let mut j = 0
    while j < 16 {
        if sub[j] > 0 { let p = to_float(sub[j]) / total; h = h - p * log2(p) }
        j = j + 1
    }
    return h
}

fn co_info_3(tpm: array, cell_i: int) -> float {
    let mut counts = []
    let mut z = 0
    while z < 16 { counts = counts.push(0); z = z + 1 }
    let mut s = 0
    while s < 8 {
        let s0 = bit_at(s, 0)
        let s1 = bit_at(s, 1)
        let s2 = bit_at(s, 2)
        let mut t = 0
        if tpm[s * 3 + cell_i] > 0.5 { t = 1 }
        let idx = 8 * t + 4 * s0 + 2 * s1 + s2
        counts[idx] = counts[idx] + 1
        s = s + 1
    }
    let tot = 8.0
    let h_t   = marg_entropy(counts, 8, tot)
    let h_s0  = marg_entropy(counts, 4, tot)
    let h_s1  = marg_entropy(counts, 2, tot)
    let h_s2  = marg_entropy(counts, 1, tot)
    let h_t_s0  = marg_entropy(counts, 8 + 4, tot)
    let h_t_s1  = marg_entropy(counts, 8 + 2, tot)
    let h_t_s2  = marg_entropy(counts, 8 + 1, tot)
    let h_s0_s1 = marg_entropy(counts, 4 + 2, tot)
    let h_s0_s2 = marg_entropy(counts, 4 + 1, tot)
    let h_s1_s2 = marg_entropy(counts, 2 + 1, tot)
    let h_t_s0_s1 = marg_entropy(counts, 8 + 4 + 2, tot)
    let h_t_s0_s2 = marg_entropy(counts, 8 + 4 + 1, tot)
    let h_t_s1_s2 = marg_entropy(counts, 8 + 2 + 1, tot)
    let h_s0_s1_s2   = marg_entropy(counts, 4 + 2 + 1, tot)
    let h_t_s0_s1_s2 = marg_entropy(counts, 8 + 4 + 2 + 1, tot)
    let i_t_s0 = h_t + h_s0 - h_t_s0
    let i_t_s1 = h_t + h_s1 - h_t_s1
    let i_t_s2 = h_t + h_s2 - h_t_s2
    let i_t_s0s1 = h_t + h_s0_s1 - h_t_s0_s1
    let i_t_s0s2 = h_t + h_s0_s2 - h_t_s0_s2
    let i_t_s1s2 = h_t + h_s1_s2 - h_t_s1_s2
    let i_t_s0s1s2 = h_t + h_s0_s1_s2 - h_t_s0_s1_s2
    // single-line (multi-line leading-op miscompile guard, MEMORY hexa-multiline)
    let ii3 = (i_t_s0 + i_t_s1 + i_t_s2) - (i_t_s0s1 + i_t_s0s2 + i_t_s1s2) + i_t_s0s1s2
    return ii3
}

// Hivemind totals under (mask, I): per-cell synergy / redundancy summed.
fn syn_total_I(xor_mask: array, I: float) -> float {
    let tpm = build_tpm_inhib(xor_mask, I)
    let mut acc = 0.0
    let mut i = 0
    while i < 3 {
        let ii = co_info_3(tpm, i)
        if ii > 0.0 { acc = acc + ii }
        i = i + 1
    }
    return acc
}
fn red_total_I(xor_mask: array, I: float) -> float {
    let tpm = build_tpm_inhib(xor_mask, I)
    let mut acc = 0.0
    let mut i = 0
    while i < 3 {
        let ii = co_info_3(tpm, i)
        if ii < 0.0 { acc = acc - ii }
        i = i + 1
    }
    return acc
}
fn ratio_at(xor_mask: array, I: float) -> float {
    let s = syn_total_I(xor_mask, I)
    let r = red_total_I(xor_mask, I)
    let denom = s + r
    if denom < 0.000000001 { return 0.0 }
    return s / denom
}

fn main() {
    println("================================================================")
    println("  H_619 — PID synergy_ratio × SAVANT inhibition I sweep (E×F r3)")
    println("  Substrate: 3 binary substrates × 1 cell · K=0.67 mask=[1,1,0]")
    println("  Modulator: inhibition I collapses #rows of 8 to identity-S0")
    println("================================================================")

    // ── I sweep on canonical mask K=0.67 [1,1,0] (H_355 mid-K) ────────────
    let mask_K067 = [1, 1, 0]
    let i_sweep = [0.05, 0.10, 0.21, 0.25, 0.30, 0.40, 0.50, 0.75]
    let n_i = len(i_sweep)
    let mut ratios = []
    let mut syns = []
    let mut reds = []
    let mut n_id_list = []
    let mut k = 0
    while k < n_i {
        let I = i_sweep[k]
        let s = syn_total_I(mask_K067, I)
        let r = red_total_I(mask_K067, I)
        let denom = s + r
        let mut ratio = 0.0
        if denom > 0.000000001 { ratio = s / denom }
        let n_id = inhibition_rows(I)
        let n_id_f = to_float(n_id)
        println("  I=" + str(I) + " n_id_rows=" + str(n_id) + " synergy=" + str(s) + " redundancy=" + str(r) + " ratio=" + str(ratio))
        ratios = ratios.push(ratio)
        syns = syns.push(s)
        reds = reds.push(r)
        n_id_list = n_id_list.push(n_id_f)
        k = k + 1
    }

    // ── Anchors ──────────────────────────────────────────────────────────
    println("  --")
    let ratio_I0 = ratio_at(mask_K067, 0.0)
    let syn_I0 = syn_total_I(mask_K067, 0.0)
    let red_I0 = red_total_I(mask_K067, 0.0)
    println("  ANCHOR I=0.0    synergy=" + str(syn_I0) + " redundancy=" + str(red_I0) + " ratio=" + str(ratio_I0))
    let ratio_I1 = ratio_at(mask_K067, 1.0)
    let syn_I1 = syn_total_I(mask_K067, 1.0)
    let red_I1 = red_total_I(mask_K067, 1.0)
    println("  ANCHOR I=1.0    synergy=" + str(syn_I1) + " redundancy=" + str(red_I1) + " ratio=" + str(ratio_I1))

    // ── Multi-K invariance probe (K=1.0 mask=[1,1,1]) ────────────────────
    println("  --")
    let mask_K100 = [1, 1, 1]
    let mut ratios_K1 = []
    let mut k2 = 0
    while k2 < n_i {
        let I = i_sweep[k2]
        let rt = ratio_at(mask_K100, I)
        let s = syn_total_I(mask_K100, I)
        let r = red_total_I(mask_K100, I)
        println("  K=1.0 I=" + str(I) + " synergy=" + str(s) + " redundancy=" + str(r) + " ratio=" + str(rt))
        ratios_K1 = ratios_K1.push(rt)
        k2 = k2 + 1
    }

    // ── GZ_LOWER focal value at I=0.21 ──────────────────────────────────
    println("  --")
    let GZ_LOWER = 0.21232
    let ratio_GZ = ratio_at(mask_K067, GZ_LOWER)
    let syn_GZ = syn_total_I(mask_K067, GZ_LOWER)
    let red_GZ = red_total_I(mask_K067, GZ_LOWER)
    println("  GZ_LOWER=" + str(GZ_LOWER) + " (★ SAVANT focal) synergy=" + str(syn_GZ) + " redundancy=" + str(red_GZ) + " ratio=" + str(ratio_GZ))

    // ── F619.1 SAVANT-MODULATES-PID ──────────────────────────────────────
    let mut max_r = ratios[0]
    let mut min_r = ratios[0]
    let mut bi = 1
    while bi < n_i {
        if ratios[bi] > max_r { max_r = ratios[bi] }
        if ratios[bi] < min_r { min_r = ratios[bi] }
        bi = bi + 1
    }
    let spread = max_r - min_r
    println("  F619.1 spread (max - min of ratio) = " + str(spread))
    let modulated = spread >= 0.05
    let delta_GZ_vs_0 = ratio_I0 - ratio_GZ
    let mut abs_dgz = delta_GZ_vs_0
    if abs_dgz < 0.0 { abs_dgz = 0.0 - abs_dgz }
    println("  F619.1 |ratio(I=0) - ratio(GZ)| = " + str(abs_dgz))
    check("F619.1 SAVANT modulates PID synergy_ratio (spread ≥ 0.05 OR |Δratio_GZ| ≥ 0.05)", modulated || (abs_dgz >= 0.05))

    // ── F619.2 MONOTONE-MODULATION ───────────────────────────────────────
    let mut inversions = 0
    let mut mi = 1
    while mi < n_i {
        if ratios[mi] > ratios[mi - 1] + 0.000001 { inversions = inversions + 1 }
        mi = mi + 1
    }
    println("  F619.2 inversions (strict increases across sweep) = " + str(inversions))
    check("F619.2 MONOTONE-MODULATION: synergy_ratio non-increasing in I (≤1 inversion)", inversions <= 1)

    // ── F619.3 ANCHOR-CONSISTENCY ────────────────────────────────────────
    // I=0 anchor: H_355 K=0.67 mask=[1,1,0] expected syn=2, red=0, ratio=1
    let anchor0_ok = approx(syn_I0, 2.0) && approx(red_I0, 0.0) && approx(ratio_I0, 1.0)
    check("F619.3a I=0 reproduces H_355 K=0.67 mask=[1,1,0] anchor (syn=2, red=0, ratio=1)", anchor0_ok)
    // I=1 anchor: all 8 rows identity-S0 → both XOR cells now ≡ S0 → degenerate
    let anchor1_ok = ratio_I1 <= 0.5
    check("F619.3b I=1 degenerate anchor (ratio ≤ 0.5)", anchor1_ok)

    // ── F619.4 MULTI-K-INVARIANCE (qualitative) ──────────────────────────
    let mut max_rK1 = ratios_K1[0]
    let mut min_rK1 = ratios_K1[0]
    let mut bj = 1
    while bj < n_i {
        if ratios_K1[bj] > max_rK1 { max_rK1 = ratios_K1[bj] }
        if ratios_K1[bj] < min_rK1 { min_rK1 = ratios_K1[bj] }
        bj = bj + 1
    }
    let spread_K1 = max_rK1 - min_rK1
    println("  F619.4 K=1.0 spread = " + str(spread_K1))
    // qualitative: either also modulated OR saturated flat-at-1 (over-saturated case)
    let K1_modulated = spread_K1 >= 0.05
    let K1_sat_1 = approx(max_rK1, 1.0) && approx(min_rK1, 1.0)
    check("F619.4 MULTI-K: K=1.0 either modulated (spread≥0.05) OR saturated flat-1", K1_modulated || K1_sat_1)

    // ── F619.5 BOUND/DET ─────────────────────────────────────────────────
    let mut bound_ok = true
    let mut b = 0
    while b < n_i {
        if !(syns[b] >= 0.0 - 0.000001) { bound_ok = false }
        if !(reds[b] >= 0.0 - 0.000001) { bound_ok = false }
        if !(syns[b] <= 3.0 + 0.000001) { bound_ok = false }
        if !(reds[b] <= 3.0 + 0.000001) { bound_ok = false }
        if !(ratios[b] >= 0.0 - 0.000001) { bound_ok = false }
        if !(ratios[b] <= 1.0 + 0.000001) { bound_ok = false }
        b = b + 1
    }
    check("F619.5a BOUND: 0≤syn≤3, 0≤red≤3, 0≤ratio≤1 across 8 sweep points", bound_ok)
    let det_ratio = ratio_at(mask_K067, GZ_LOWER)
    check("F619.5b DETERMINISM: GZ_LOWER re-run byte-identical", approx(det_ratio, ratio_GZ))

    // ── Verdict ──────────────────────────────────────────────────────────
    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL  (n_sweep=" + str(n_i) + ")")
    println("  ratio at GZ_LOWER = " + str(ratio_GZ))
    println("  ratio at I=0      = " + str(ratio_I0))
    println("  spread (K=0.67)   = " + str(spread))
    println("  spread (K=1.0)    = " + str(spread_K1))
    if modulated && bound_ok && anchor0_ok {
        println("  VERDICT: H1 SUPPORTED — SAVANT inhibition I modulates hivemind PID")
        println("           synergy_ratio. The H_355 K-invariant (ratio=1.0) is preserved")
        println("           only at I≈0; SAVANT-state inhibition collapses synergy share")
        println("           into redundancy along the I sweep.")
    } else {
        if !modulated {
            println("  VERDICT: H1 FALSIFIED — synergy_ratio invariant under SAVANT inhibition")
            println("           (spread < 0.05). H_355 PID K-invariant survives the I sweep")
            println("           on this substrate-modulator coupling.")
        } else {
            println("  VERDICT: PARTIAL — modulation seen but anchor/bound check incomplete.")
        }
    }
    println("================================================================")
    if FAIL > 0 { panic("H_619 had FALSIFIER FAILURES") }
}
