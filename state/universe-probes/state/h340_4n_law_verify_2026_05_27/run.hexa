// H_340 — 4|n law decisive verification at n in {14, 16, 20}
// H_337 found: 4|n <=> rule30 dominant (cycle length), 5/5 at n in {4,6,8,10,12}.
// PREDICTIONS:
//   n=14 (2*7,  4-not-div) -> rule110 dominant
//   n=16 (2^4,  4-div)     -> rule30 dominant
//   n=20 (2^2*5,4-div)     -> rule30 dominant
// Falsifier: any prediction wrong (e.g. n=14 rule30 or n=16 rule110).
//
// State spaces: 2^14=16384, 2^16=65536, 2^20=1048576. We SAMPLE starting states
// with a stride to bound runtime; the dominance gaps in H_337 were large
// (often >2x) so a 1024-2048 sample resolves the leader robustly.

fn nextN(s: int, rule: int, n: int) -> int {
    let mut out = 0
    let mut i = 0
    while i < n {
        let im1 = (i + n - 1) % n
        let ip1 = (i + 1) % n
        let l = (s >> im1) & 1
        let c = (s >> i) & 1
        let r = (s >> ip1) & 1
        let nb = (rule >> ((l << 2) | (c << 1) | r)) & 1
        out = out | (nb << i)
        i = i + 1
    }
    return out
}

// cycle length with a hard cap; visited via a hash-free linear probe is too slow
// for 1M states, so we use the tortoise-hare (Floyd) period detection — O(period)
// memory-free.
fn cycle_len_floyd(s0: int, rule: int, n: int, cap: int) -> int {
    // find a point on the cycle, then measure period
    let mut tort = s0
    let mut hare = s0
    let mut steps = 0
    // phase 1: find meeting point
    while steps < cap {
        tort = nextN(tort, rule, n)
        hare = nextN(nextN(hare, rule, n), rule, n)
        steps = steps + 1
        if tort == hare {
            // phase 2: measure period
            let mut p = 1
            let mut h2 = nextN(tort, rule, n)
            while h2 != tort {
                h2 = nextN(h2, rule, n)
                p = p + 1
                if p > cap { return -1 }
            }
            return p
        }
    }
    return -1
}

fn mean_cycle_sampled(rule: int, n: int, nstates: int, stride: int, cap: int) -> float {
    let mut total = 0
    let mut count = 0
    let mut s0 = 0
    while s0 < nstates {
        let L = cycle_len_floyd(s0, rule, n, cap)
        if L > 0 { total = total + L; count = count + 1 }
        s0 = s0 + stride
    }
    if count == 0 { return 0.0 }
    return to_float(total) / to_float(count)
}

fn report(n: int, nstates: int, stride: int, cap: int, pred: int) {
    let r30 = mean_cycle_sampled(30, n, nstates, stride, cap)
    let r110 = mean_cycle_sampled(110, n, nstates, stride, cap)
    let dom = if r30 > r110 { 30 } else { 110 }
    let ok = if dom == pred { 1 } else { 0 }
    println("n=" + str(n) + " r30=" + str(r30) + " r110=" + str(r110) + " dominant=rule" + str(dom) + " predicted=rule" + str(pred) + " match=" + str(ok))
}

fn main() {
    println("H_340 4|n law verify at n in {14,16,20}")
    // n=14: 16384 states, stride 16 = 1024 samples; n=16: 65536, stride 64 = 1024;
    // n=20: 1048576, stride 1024 = 1024. cap generous (4*nstates capped at 8192).
    report(14, 16384, 16, 8192, 110)    // 2*7  -> predict rule110
    report(16, 65536, 64, 8192, 30)     // 2^4  -> predict rule30
    report(20, 1048576, 1024, 8192, 30) // 2^2*5 -> predict rule30
    println("law: 4|n <=> rule30 dominant")
    println("done")
}
