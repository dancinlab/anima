// ════════════════════════════════════════════════════════════════════════════
// H_664 — wolfram-class-III-heterogeneity — PHI-FREE AGGREGATE (no big_phi call, <1s)
//   Consumes shard norm_conv/log_span verbatim (H_664 NEW rule106/150 + H_661 anchors)
//   → within-class-III variance vs between-class(II/IV) variance → variance ratio
//   → sub-type clustering (≥2 sub-type?) → pre-registered falsifier F664.1-6.
//   deterministic · hexa-only · $0 mac-local · foreground sync.
// ════════════════════════════════════════════════════════════════════════════

fn mean(xs: array) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < xs.len() { s = s + xs[i]; i = i + 1 }
    return s / to_float(xs.len())
}

// population variance (deterministic, /N)
fn variance(xs: array) -> float {
    let m = mean(xs)
    let mut s = 0.0
    let mut i = 0
    while i < xs.len() { let d = xs[i] - m; s = s + d * d; i = i + 1 }
    return s / to_float(xs.len())
}

fn maxv(xs: array) -> float {
    let mut m = xs[0]
    let mut i = 0
    while i < xs.len() { if xs[i] > m { m = xs[i] }; i = i + 1 }
    return m
}
fn minv(xs: array) -> float {
    let mut m = xs[0]
    let mut i = 0
    while i < xs.len() { if xs[i] < m { m = xs[i] }; i = i + 1 }
    return m
}

fn main() {
    // ── norm_conv (CORE Φ-속성, H_660 측도) — shard verbatim ──
    // class-III (5 rep): rule30, rule45, rule90, rule106(NEW), rule150(NEW)
    let nc_III = [2.26615, 1.4608, 2.24029, 2.1531, 1.93118]
    // class-II (2 rep): rule184, rule226
    let nc_II  = [1.43674, 1.41354]
    // class-IV (2 rep): rule110, rule54
    let nc_IV  = [2.34922, 2.4745]

    // ── log_span (2nd Φ-속성 magnitude proxy) — rule150 DEGENERATE(Φmin=0) 제외 ──
    // class-III finite reps: rule30, rule45, rule90, rule106 (rule150 excluded: log_span blowup)
    let ls_III_finite = [3.42656, 1.61842, 3.41499, 3.26926]
    let ls_II  = [2.49455, 2.48764]
    let ls_IV  = [3.56946, 3.68367]

    // ── within-class-III variance (norm_conv) ──
    let var_within_III = variance(nc_III)
    let mean_III = mean(nc_III)
    let mean_II  = mean(nc_II)
    let mean_IV  = mean(nc_IV)

    // ── between-class variance (norm_conv): spread of the 3 class means {II,III,IV} ──
    let class_means = [mean_II, mean_III, mean_IV]
    let var_between = variance(class_means)

    // ── pooled within-class-II & IV variance (the "compact" classes) ──
    let var_within_II = variance(nc_II)
    let var_within_IV = variance(nc_IV)
    let var_within_IIIV_pooled = (var_within_II + var_within_IV) / 2.0  // mean of the two compact-class within-var

    // ── variance ratios ──
    let ratio_within_between = var_within_III / var_between          // ≥1 ⇒ III spread ≥ between-class spread
    let ratio_III_vs_compact = var_within_III / (var_within_IIIV_pooled + 0.0000001)  // III 이질성 vs II/IV 응집

    // ── class-III internal range vs between-class-means range ──
    let range_within_III  = maxv(nc_III) - minv(nc_III)             // 2.266 - 1.461
    let range_between_min = minv(class_means)
    let range_between_max = maxv(class_means)
    let range_between     = range_between_max - range_between_min   // mean_IV - mean_II span

    // ── sub-type clustering (norm_conv): split III into HIGH (≥1.95) vs LOW (<1.95) ──
    //   HIGH-conv (fractal/long-monotone): rule30 2.266, rule90 2.240, rule106 2.153
    //   LOW-conv (W-비단조/die-out):       rule45 1.461, rule150 1.931
    let nc_III_HIGH = [2.26615, 2.24029, 2.1531]
    let nc_III_LOW  = [1.4608, 1.93118]
    let mean_HIGH = mean(nc_III_HIGH)
    let mean_LOW  = mean(nc_III_LOW)
    let var_HIGH  = variance(nc_III_HIGH)
    let var_LOW   = variance(nc_III_LOW)
    // 2-cluster within-var vs 1-cluster within-var (Φ-속성 분화)
    let var_2cluster_pooled = (var_HIGH * 3.0 + var_LOW * 2.0) / 5.0   // size-weighted
    let cluster_separation  = mean_HIGH - mean_LOW                     // gap between sub-type means
    let intra_cluster_max   = maxv([var_HIGH, var_LOW])

    println("=== H_664 class-III heterogeneity aggregate (phi-free) ===")
    println("nc class-III(5): rule30=2.26615 rule45=1.4608 rule90=2.24029 rule106=2.1531 rule150=1.93118")
    println("nc class-II(2):  rule184=1.43674 rule226=1.41354   mean_II=" + to_string(mean_II))
    println("nc class-III:    mean=" + to_string(mean_III) + "  var=" + to_string(var_within_III))
    println("nc class-IV(2):  rule110=2.34922 rule54=2.4745     mean_IV=" + to_string(mean_IV))
    println("")
    println("var_within_III      = " + to_string(var_within_III))
    println("var_between(3means) = " + to_string(var_between))
    println("var_within_II       = " + to_string(var_within_II))
    println("var_within_IV       = " + to_string(var_within_IV))
    println("var_compact_pooled  = " + to_string(var_within_IIIV_pooled))
    println("RATIO within_III / between   = " + to_string(ratio_within_between))
    println("RATIO within_III / compact   = " + to_string(ratio_III_vs_compact))
    println("range_within_III    = " + to_string(range_within_III))
    println("range_between_means = " + to_string(range_between))
    println("")
    println("-- sub-type clustering (norm_conv) --")
    println("HIGH-conv {30,90,106} mean=" + to_string(mean_HIGH) + " var=" + to_string(var_HIGH))
    println("LOW-conv  {45,150}    mean=" + to_string(mean_LOW) + " var=" + to_string(var_LOW))
    println("cluster_separation   = " + to_string(cluster_separation))
    println("var_2cluster_pooled  = " + to_string(var_2cluster_pooled))
    println("intra_cluster_max    = " + to_string(intra_cluster_max))
    println("")

    // ════════ pre-registered falsifier (frozen BEFORE measuring 106/150) ════════
    // F664.1 CORE — within-III variance ≥ between-class variance (III spread rivals/exceeds class-간)
    let f1 = ratio_within_between >= 1.0
    // F664.2 — within-III range ≥ between-class-means range (이질성이 class-간 spread 필적)
    let f2 = range_within_III >= range_between
    // F664.3 — within-III variance ≫ compact-class within-var (III 가 II/IV 보다 훨씬 분산; ≥3×)
    let f3 = ratio_III_vs_compact >= 3.0
    // F664.4 SUB-TYPE — 2-cluster 분화 유효: cluster_separation > intra_cluster spread (sqrt)
    //   (between-cluster gap 이 cluster 내부 std 보다 크면 ≥2 sub-type 분리 가능)
    let intra_std = pow(intra_cluster_max, 0.5)
    let f4 = cluster_separation > intra_std
    // F664.5 — 2-cluster pooled var < raw within-III var (sub-type 분할이 분산 설명; >50% 감소)
    let f5 = var_2cluster_pooled < (var_within_III * 0.5)
    // F664.6 BOUND — 全 통계 finite
    let f6 = (var_within_III >= 0.0) && (var_between >= 0.0) && (ratio_within_between >= 0.0)

    let mut npass = 0
    if f1 { npass = npass + 1 }
    if f2 { npass = npass + 1 }
    if f3 { npass = npass + 1 }
    if f4 { npass = npass + 1 }
    if f5 { npass = npass + 1 }
    if f6 { npass = npass + 1 }

    println("────────── verdict ──────────")
    if f1 { println("[PASS] F664.1 CORE within-III var >= between-class var : " + to_string(ratio_within_between) + " >= 1.0") }
    else  { println("[FAIL] F664.1 CORE within-III var >= between-class var : " + to_string(ratio_within_between) + " < 1.0") }
    if f2 { println("[PASS] F664.2 within-III range >= between-means range : " + to_string(range_within_III) + " >= " + to_string(range_between)) }
    else  { println("[FAIL] F664.2 within-III range >= between-means range : " + to_string(range_within_III) + " < " + to_string(range_between)) }
    if f3 { println("[PASS] F664.3 within-III var >= 3x compact-class var : " + to_string(ratio_III_vs_compact)) }
    else  { println("[FAIL] F664.3 within-III var >= 3x compact-class var : " + to_string(ratio_III_vs_compact)) }
    if f4 { println("[PASS] F664.4 SUB-TYPE sep > intra-std : " + to_string(cluster_separation) + " > " + to_string(intra_std)) }
    else  { println("[FAIL] F664.4 SUB-TYPE sep > intra-std : " + to_string(cluster_separation) + " <= " + to_string(intra_std)) }
    if f5 { println("[PASS] F664.5 2-cluster var explains >50% : " + to_string(var_2cluster_pooled) + " < " + to_string(var_within_III * 0.5)) }
    else  { println("[FAIL] F664.5 2-cluster var explains >50% : " + to_string(var_2cluster_pooled) + " >= " + to_string(var_within_III * 0.5)) }
    if f6 { println("[PASS] F664.6 BOUND 全 통계 finite") }
    else  { println("[FAIL] F664.6 BOUND") }

    println("F664.1-6 " + to_string(npass) + "/6 PASS")
    let het_confirmed = f1 || f2 || f3
    let subtype_confirmed = f4 && f5
    println("het_rivals_between=" + to_string(het_confirmed) + " subtype_ge2=" + to_string(subtype_confirmed))
}
