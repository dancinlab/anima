// aggregate.hexa — H_668 phi-free aggregation: dΦ/dI · peak · delta-GZ · verdict
//
//   Consumes the rule-8 Φ(I) table (phi_rule_8_lo.json + phi_rule_8_hi.json,
//   measured in separate foreground shards) — embedded verbatim below. NO
//   big_phi calls → instant. Computes dΦ/dI central finite difference, peak
//   I = argmax|dΦ/dI|, delta_gz vs GZ_LOWER, aligned (≤0.05), sign-changes.
//   Method = H_657 verbatim (GZ_LOWER=0.21232, tol=0.05).
//
//   H_657 baselines (verbatim): rule110 (IV) aligned peak_I=0.18 |Δ|=0.03232 ·
//     rule30 (III) aligned peak_I=0.18 · rule90 (III-additive) NOT aligned
//     peak_I=0.05 sign_chg=1 (inverse-U collapse) · rule54/rule184 NOT aligned.
//
//   floor verdict = class-I (rule 8) is NOT aligned (like rule90 additive) AND
//     dΦ/dI is mono-decreasing (no inverse-U) → class-I sits at the dΦ/dI-GZ
//     matrix floor (no GZ-aligned peak structure), the homogeneous analogue of
//     the additive inverse-U collapse.
//
//   $0 · mac-local · hexa-only · LLM none · deterministic.
// ════════════════════════════════════════════════════════════════════════════

fn _gz_lower() -> float { return 0.21232 }
fn _delta_tol() -> float { return 0.05 }

fn _abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}
fn _sign(x: float) -> int {
    if x > 1.0e-9 { return 1 }
    if x < (0.0 - 1.0e-9) { return -1 }
    return 0
}

// returns [peak_I, peak_mag, sign_changes, delta_gz, mono_dec]
fn analyze(grid: array, phi: array) -> array {
    let m = len(grid)
    let mut dphi = []
    let mut k = 0
    while k < m {
        let mut d = 0.0
        if k == 0 {
            d = (phi[1] - phi[0]) / (grid[1] - grid[0])
        } else if k == m - 1 {
            d = (phi[m-1] - phi[m-2]) / (grid[m-1] - grid[m-2])
        } else {
            d = (phi[k+1] - phi[k-1]) / (grid[k+1] - grid[k-1])
        }
        dphi = dphi.push(d)
        k = k + 1
    }
    let mut peak_idx = 0
    let mut peak_mag = _abs(dphi[0])
    let mut q = 1
    while q < m {
        let mag = _abs(dphi[q])
        if mag > peak_mag { peak_mag = mag  peak_idx = q }
        q = q + 1
    }
    let peak_I = grid[peak_idx]
    let delta_gz = _abs(peak_I - _gz_lower())
    let mut sign_changes = 0
    let mut prev_sign = _sign(dphi[0])
    let mut u = 1
    while u < m {
        let sg = _sign(dphi[u])
        if (sg != 0) && (prev_sign != 0) && (sg != prev_sign) {
            sign_changes = sign_changes + 1
        }
        if sg != 0 { prev_sign = sg }
        u = u + 1
    }
    // mono-decreasing test: every consecutive Φ step ≤ 0 ?
    let mut mono_dec = 1.0
    let mut p = 1
    while p < m {
        if phi[p] > phi[p-1] { mono_dec = 0.0 }
        p = p + 1
    }
    return [peak_I, peak_mag, to_float(sign_changes), delta_gz, mono_dec]
}

fn json_arr_f(xs: array) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(xs) { if i > 0 { s = s + ", " }  s = s + str(xs[i])  i = i + 1 }
    return s + "]"
}

fn main() {
    let grid = [0.05, 0.10, 0.15, 0.18, 0.21, 0.23, 0.25, 0.30, 0.35, 0.40,
                0.50, 0.70, 0.95]

    // ── measured Φ(I) table for rule 8 (byte-identical to phi_rule_8_{lo,hi}.json)
    //   lo (0..6): I=0.05..0.25 · hi (7..12): I=0.30..0.95
    let phi_8 = [0.552055, 0.516814, 0.482452, 0.462239, 0.442318, 0.429196,
                 0.416197, 0.384226, 0.352979, 0.322423, 0.263261, 0.151985,
                 0.0242307]

    println("════════════════════════════════════════════════════════════")
    println("H_668 dΦ/dI peak=GZ_LOWER 정렬 · class-I (rule 8) — H_657 보완")
    println("  GZ_LOWER = " + str(_gz_lower()) + "   tol = " + str(_delta_tol()))
    println("════════════════════════════════════════════════════════════")

    let res = analyze(grid, phi_8)
    let peak_I = res[0]
    let peak_mag = res[1]
    let sg = res[2]
    let delta_gz = res[3]
    let mono_dec = res[4]
    let aligned = delta_gz <= _delta_tol()

    println("rule 8 (class-I homogeneous)")
    println("  peak_I       = " + str(peak_I))
    println("  |Δgz|        = " + str(delta_gz))
    println("  aligned      = " + str(aligned))
    println("  peak|dΦ/dI|  = " + str(peak_mag))
    println("  sign_changes = " + str(to_int(sg)))
    println("  mono-decreasing (no inverse-U bump) = " + str(mono_dec > 0.5))
    println("")
    println("── H_657 baselines ──")
    println("  rule110 (IV)  aligned peak_I=0.18 |Δ|=0.03232")
    println("  rule30  (III) aligned peak_I=0.18")
    println("  rule90  (III-additive) NOT aligned peak_I=0.05 sign_chg=1 (inverse-U collapse)")
    println("")

    // floor = class-I NOT aligned (no GZ-aligned inverse-U peak), homogeneous floor
    let is_floor = !aligned
    println("── dΦ/dI-GZ floor test ──")
    println("  class-I aligned to GZ = " + str(aligned))
    println("  class-I dΦ/dI-GZ FLOOR (NOT aligned, no inverse-U like additive) = " + str(is_floor))
    println("════════════════════════════════════════════════════════════")

    let mut s = "{\n"
    s = s + "  \"property\": \"dphi-dI-GZ\",\n"
    s = s + "  \"method\": \"H_657 verbatim\",\n"
    s = s + "  \"rule\": 8,\n"
    s = s + "  \"wolfram_class\": \"I-homogeneous\",\n"
    s = s + "  \"n\": 4,\n"
    s = s + "  \"gz_lower\": " + str(_gz_lower()) + ",\n"
    s = s + "  \"delta_tol\": " + str(_delta_tol()) + ",\n"
    s = s + "  \"grid\": " + json_arr_f(grid) + ",\n"
    s = s + "  \"phi\": " + json_arr_f(phi_8) + ",\n"
    s = s + "  \"peak_I\": " + str(peak_I) + ",\n"
    s = s + "  \"peak_mag\": " + str(peak_mag) + ",\n"
    s = s + "  \"delta_gz\": " + str(delta_gz) + ",\n"
    s = s + "  \"aligned\": " + str(aligned) + ",\n"
    s = s + "  \"sign_changes\": " + str(to_int(sg)) + ",\n"
    s = s + "  \"mono_decreasing\": " + str(mono_dec > 0.5) + ",\n"
    s = s + "  \"is_floor_not_aligned\": " + str(is_floor) + "\n"
    s = s + "}\n"
    write_file("UNIVERSE/state/h668_class_I_full_property_2026_05_28/dphi_gz_result.json", s)
    println("wrote dphi_gz_result.json")
}
