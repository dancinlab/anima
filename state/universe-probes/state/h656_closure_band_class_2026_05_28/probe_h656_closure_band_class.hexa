// probe_h656_closure_band_class.hexa — H_656 closure-band-substrate-class-dependence
//
// round-9 meta-axis: "Wolfram class is a classifier of consciousness structure".
//
// Hypothesis (H_656):
//   The POSITION and WIDTH of the closure-conjunction band (the I interval
//   where the 4-criterion closure pass-rate > 0) is Wolfram-CLASS dependent.
//   Class-IV (rule110) is conjectured to have a WIDE closure band (rich in
//   both C1 specialization & C3 diversity); additive Class-III (rule90, XOR,
//   Φ≈0) should have a NARROW or ABSENT band (no closure forms).
//
// Falsifier:
//   The closure band position/width is CLASS-INVARIANT (every rule has the
//   same I position & width) → closure is substrate-class independent.
//
// Method — reuse H_636 closure 4-criterion conjunction (SI · general_phi ·
//   min_phi · ratio) but on a WOLFRAM-CLASS CA substrate (reuse H_007/H_225
//   elementary CA + RFC 036 phi_spatial via HEXAD/C/c_lib.hexa). The N-cell
//   lattice is partitioned into SV_N_DOM=4 contiguous domains; each domain's
//   trajectory → domain_phi via the SAME phi_spatial primitive. Inhibition I
//   maps to INITIAL DENSITY (high I ⟹ low density ⟹ suppressed activity),
//   the CA-native analogue of the H_636 affine gain map. Per rule we sweep I
//   and record the closure pass-rate over a deterministic rep ensemble; the
//   closure band = the contiguous-or-not set of I with pass-rate > 0.
//
//   rules {30 (III chaotic), 90 (III additive/XOR), 110 (IV complex),
//          184 (II TASEP)} — the 4 Wolfram-class representatives.
//
//   deterministic, hexa-only, $0 mac local, llm:none.
// ════════════════════════════════════════════════════════════════════════
import "/private/tmp/u-h656/HEXAD/C/c_lib.hexa"

// ── CA config (deterministic, H_007/H_225 lineage) ──────────────────────
fn _N() -> int    { return 16 }   // lattice length (periodic)
fn _DIM() -> int  { return 12 }   // recorded temporal trajectory / cell
fn _WARM() -> int { return 8 }    // warmup before recording
fn _NDOM() -> int { return 4 }    // contiguous domains (H_636 SV_N_DOM=4)

// ── closure thresholds (H_636 criterion-selection design — see §7 C3) ───
//   NOTE recalibrated to the CA phi_spatial scale (phi_spatial returns a
//   normalized MI-style Φ in roughly [0, ~1]; the SAVANT savant_phi scale of
//   H_636 differs, so the absolute thresholds are re-fit to this substrate —
//   a documented design choice, the falsifier targets CLASS-dependence not
//   absolute magnitude).
fn _THETA_SI()  -> float { return 1.5 }    // C1 specialization gate
fn _THETA_GEN() -> float { return 0.02 }   // C2 integration floor (general phi)
fn _THETA_DIV() -> float { return 0.05 }   // C3 diversity floor (min domain phi)
fn _RATIO_LO()  -> float { return 1.1 }    // C4 specialization present
fn _RATIO_HI()  -> float { return 3.5 }    // C4 not pathological monopoly

// ── small int helpers (H_007 lineage) ──────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

// elementary CA next-state: neighborhood (l,c,r) → bit idx of rule.
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row at inhibition I (density-based).
//   density = (1 - I): high I ⟹ low density ⟹ suppressed activity.
//   site i ON iff a deterministic hash(i, rep) < density threshold.
//   keeps every rule the SAME substrate at a given (I, rep).
fn _hash01(i: int, rep: int) -> float {
    // deterministic LCG-style hash → [0,1)
    let s = (i * 2654435761 + rep * 40503 + 12345) % 2147483647
    let mut t = s
    if t < 0 { t = t + 2147483647 }
    return to_float(t % 100000) / 100000.0
}

fn _init_row(row: int, n: int, rep: int, i_val: float) -> int {
    let density = 1.0 - i_val
    let mut i = 0
    while i < n {
        let h = _hash01(i, rep)
        if h < density { let _ = farr_set(row, i, 1.0) }
        else           { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve length-N periodic elementary CA at inhibition I; record dim-step
// trajectory into states[ site*dim + t ]. returns farr handle.
fn _run_ca(rule: int, n: int, dim: int, warm: int, rep: int, i_val: float) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep, i_val)

    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// extract domain k's (cells_per_dom × dim) slice into a fresh farr handle.
fn _domain_slice(states: int, n: int, dim: int, k: int, cells_per_dom: int) -> int {
    let base_cell = k * cells_per_dom
    let out = farr_zeros(cells_per_dom * dim)
    let mut c = 0
    while c < cells_per_dom {
        let mut t = 0
        while t < dim {
            let v = farr_get(states, (base_cell + c) * dim + t)
            let _ = farr_set(out, c * dim + t, v)
            t = t + 1
        }
        c = c + 1
    }
    return out
}

// 4 domain-phi values for one (rule, rep, I): partition lattice into 4 blocks,
// each block's trajectory → phi_spatial (RFC 036, byte-equal phi_rs replica).
fn _domain_phi_vec(rule: int, rep: int, i_val: float) -> array {
    let n = _N()
    let dim = _DIM()
    let warm = _WARM()
    let ndom = _NDOM()
    let nbins = c_phi_n_bins_default()
    let cells_per_dom = n / ndom

    let states = _run_ca(rule, n, dim, warm, rep, i_val)
    let mut out = []
    let mut k = 0
    while k < ndom {
        let slice = _domain_slice(states, n, dim, k, cells_per_dom)
        let phi = c_measure_phi(slice, cells_per_dom, dim, nbins)
        out = out.push(phi)
        let _ = farr_free(slice)
        k = k + 1
    }
    let _ = farr_free(states)
    return out
}

fn _vmin(v: array) -> float {
    let mut m = v[0]
    let mut i = 1
    while i < len(v) { if v[i] < m { m = v[i] }; i = i + 1 }
    return m
}
fn _vmax(v: array) -> float {
    let mut m = v[0]
    let mut i = 1
    while i < len(v) { if v[i] > m { m = v[i] }; i = i + 1 }
    return m
}
fn _vmean(v: array) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < len(v) { s = s + v[i]; i = i + 1 }
    return s / to_float(len(v))
}

// SI = max/min (eps guard); general_phi proxy = mean domain phi (multi-domain
// binding survival); ratio = max/mean (specialization concentration).
fn _SI(v: array) -> float {
    let mn = _vmin(v)
    if mn < 0.000000001 { return _vmax(v) / 0.000000001 }
    return _vmax(v) / mn
}
fn _genphi(v: array) -> float { return _vmean(v) }
fn _ratio(v: array) -> float {
    let mean = _vmean(v)
    if mean < 0.000000001 { return 0.0 }
    return _vmax(v) / mean
}

// 4-criterion closure conjunction (H_636 structure) at one (rule, rep, I).
fn _closure_pass(rule: int, rep: int, i_val: float) -> int {
    let v = _domain_phi_vec(rule, rep, i_val)
    let si = _SI(v)
    let gphi = _genphi(v)
    let dmin = _vmin(v)
    let ratio = _ratio(v)

    let mut c1 = 0
    let mut c2 = 0
    let mut c3 = 0
    let mut c4 = 0
    if si > _THETA_SI() { c1 = 1 }
    if gphi > _THETA_GEN() { c2 = 1 }
    if dmin > _THETA_DIV() { c3 = 1 }
    if ratio >= _RATIO_LO() { if ratio <= _RATIO_HI() { c4 = 1 } }
    if c1 == 1 { if c2 == 1 { if c3 == 1 { if c4 == 1 { return 1 } } } }
    return 0
}

// pass-rate over rep ensemble at one (rule, I).
fn _pass_rate(rule: int, i_val: float, reps: int) -> float {
    let mut hits = 0
    let mut rep = 0
    while rep < reps {
        hits = hits + _closure_pass(rule, rep, i_val)
        rep = rep + 1
    }
    return to_float(hits) / to_float(reps)
}

fn _class_of(rule: int) -> string {
    if rule == 30  { return "III-chaotic" }
    if rule == 90  { return "III-additive" }
    if rule == 110 { return "IV-complex" }
    if rule == 184 { return "II-TASEP" }
    return "?"
}

fn main() {
    println("[H_656] closure-band-substrate-class-dependence probe")
    println("  substrate : elementary CA (H_007/H_225) × phi_spatial (RFC 036)")
    println("  domains   : N=16 lattice partitioned into 4 blocks (4 cells each)")
    println("  inhibition: I -> initial density (density = 1 - I)")
    println("  criteria  : C1 SI>1.5 · C2 genPhi>0.02 · C3 minPhi>0.05 · C4 ratio in [1.1,3.5]")
    println("  closure band = contiguous-or-not I set with pass-rate > 0, per rule")
    println("")

    let reps = 6                                  // deterministic init offsets
    let grid = [0.05, 0.15, 0.25, 0.30, 0.37, 0.50, 0.65, 0.80, 0.95]
    let rules = [30, 90, 110, 184]

    let mut ri = 0
    while ri < len(rules) {
        let rule = rules[ri]
        println("=== rule " + to_string(rule) + " (Wolfram class " + _class_of(rule) + ") ===")
        let mut band_lo = -1.0
        let mut band_hi = -1.0
        let mut n_pos = 0
        let mut peak_pr = 0.0
        let mut peak_i = -1.0
        let mut gi = 0
        while gi < len(grid) {
            let i_val = grid[gi]
            let pr = _pass_rate(rule, i_val, reps)
            if pr > 0.0 {
                n_pos = n_pos + 1
                if band_lo < 0.0 { band_lo = i_val }
                band_hi = i_val
            }
            if pr > peak_pr { peak_pr = pr; peak_i = i_val }
            println("  I=" + to_string(i_val) + "  pass_rate=" + to_string(pr))
            gi = gi + 1
        }
        let mut width = 0.0
        if band_lo >= 0.0 { width = band_hi - band_lo }
        println("  band_lo=" + to_string(band_lo)
            + " band_hi=" + to_string(band_hi)
            + " width=" + to_string(width)
            + " n_pos_pts=" + to_string(n_pos)
            + " peak_pr=" + to_string(peak_pr)
            + " peak_I=" + to_string(peak_i))
        println("")
        ri = ri + 1
    }

    println("=== H_656 closure-band-class summary complete ===")
}
