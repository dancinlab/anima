// H_341 — attractor basin size vs IIT4 big-Phi correlation (n=4)
// Combines two INDEPENDENT prior measurements:
//   basin (H_338): max_basin, n_attractor_states  (forward-orbit settle)
//   big-Phi (H_287): state-averaged faithful big_phi per rule  (IIT4 kernel)
// and computes the Pearson correlation between them. The correlation is a NEW
// falsifiable quantity (could be +1, -1, or 0); the inputs are each independently
// persisted, so this is not a tautology.
//
// Inputs (verbatim from prior result.json on main):
//   rule | max_basin | n_attr | Phi_mean(H_287)
//   110  |    4      |   5    | 13.1302
//   30   |    2      |  11    | 13.8852
//   105  |    1      |  16    |  5.625
//   150  |    1      |  16    |  5.625
//
// H1: max_basin POSITIVELY correlates with big-Phi (|r| >= 0.5): the most
//     absorbing attractor (rank-1 dominance) also carries high integration.
// Falsifier: |r| < 0.5 (basin absorption is orthogonal to Phi) OR sign negative.

fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x / 2.0
    let mut k = 0
    while k < 40 { g = (g + x / g) / 2.0; k = k + 1 }
    return g
}

fn pearson(xs: int, ys: int, n: int) -> float {
    let mut sx = 0.0
    let mut sy = 0.0
    let mut i = 0
    while i < n { sx = sx + farr_get(xs, i); sy = sy + farr_get(ys, i); i = i + 1 }
    let mx = sx / to_float(n)
    let my = sy / to_float(n)
    let mut cov = 0.0
    let mut vx = 0.0
    let mut vy = 0.0
    let mut j = 0
    while j < n {
        let dx = farr_get(xs, j) - mx
        let dy = farr_get(ys, j) - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        j = j + 1
    }
    let denom = my_sqrt(vx) * my_sqrt(vy)
    if denom == 0.0 { return 0.0 }
    return cov / denom
}

fn main() {
    println("H_341 basin size vs IIT4 big-Phi correlation (n=4, 4 rules)")
    // max_basin
    let basin = farr_zeros(4)
    let _ = farr_set(basin, 0, 4.0)   // rule110
    let _ = farr_set(basin, 1, 2.0)   // rule30
    let _ = farr_set(basin, 2, 1.0)   // rule105
    let _ = farr_set(basin, 3, 1.0)   // rule150
    // n_attractor_states
    let nattr = farr_zeros(4)
    let _ = farr_set(nattr, 0, 5.0)
    let _ = farr_set(nattr, 1, 11.0)
    let _ = farr_set(nattr, 2, 16.0)
    let _ = farr_set(nattr, 3, 16.0)
    // big-Phi mean (H_287)
    let phi = farr_zeros(4)
    let _ = farr_set(phi, 0, 13.1302)  // rule110
    let _ = farr_set(phi, 1, 13.8852)  // rule30
    let _ = farr_set(phi, 2, 5.625)    // rule105
    let _ = farr_set(phi, 3, 5.625)    // rule150

    let r_basin_phi = pearson(basin, phi, 4)
    let r_nattr_phi = pearson(nattr, phi, 4)
    println("Pearson(max_basin, big_Phi)        = " + str(r_basin_phi))
    println("Pearson(n_attractor_states, big_Phi) = " + str(r_nattr_phi))
    let pass = if (r_basin_phi >= 0.5) { 1 } else { 0 }
    println("H1 (max_basin +correlate Phi, |r|>=0.5): r=" + str(r_basin_phi) + " pass=" + str(pass))
    let _ = farr_free(basin); let _ = farr_free(nattr); let _ = farr_free(phi)
    println("done")
}
