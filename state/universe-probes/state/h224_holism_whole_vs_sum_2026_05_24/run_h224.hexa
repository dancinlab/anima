//  GOAL (Cycle #1, NEW):
//    AXES.md R8 meta seed `holism-whole-vs-sum-of-parts` — H_054 C2 / H_157
//    C6 / H_212 의 sub-additive lane 위 *binding mode* 축을 sweep.
//
//    H_054 C2 (PR #227)  linear MERGE Φ_merged ≈ Φ_max < Φ_sum     (sub-add)
//    H_157 C6 (PR #221)  uncorrelated concat sub-additive          (sub-add)
//    H_212  ρ-sweep      mid-range non-monotone, ρ=1 trivial super (mixed)
//
//    본 cycle 은 *동일 A, B sub-state* 위 **3 binding mode** (linear-avg /
//    XOR / multiplicative-gate) 를 동시 비교 — multiplicative-gate (B 가 A
//    조건에서만 active) 가 super-additive 출현 후보인지 검증.
//
//  HYPOTHESIS:
//    동일 A=rule-110 (N=8 dim=8) + B=rule-30 sub-state 위
//      - linear-avg  : merged[i,t] = 0.5 * (A[i,t] + B[i,t])      → sub-add
//      - XOR         : merged[i,t] = (A[i,t] + B[i,t]) mod 2      → sub-add
//      - mult-gate   : merged[i,t] = A[i,t] * B[i,t]              → super-add (≥ +5%)
//    ranking: mult-gate > XOR > linear-avg (monotone).
//
//  HONEST SCOPE (g3 — real limits, no fake descent):
//    - merge primitive 3종 specific operationalization (alternative merge
//      forms — RBN, majority, asymmetric — 미검증)
//    - phi_spatial 🟢 NUMERICAL — full IIT 4.0 MIP combination 아님
//    - small N=8 sub-pool — large-scale holism 미검증
//    - super-additive Φ ≠ phenomenal whole-vs-sum 해결 (Goff "explanatory
//      gap" 별도 lane, H_004 boundary)
//    - mult-gate 의 non-linearity 가 *binding* 을 보장하지는 않음 — 단순
//      AND-mask 이기도 함 (honest L5)
//    - $0 Mac local · hexa-only · NO LLM · NO .py/.sh
//
//  PREDICTIONS:
//    H224.1  linear-avg Δ ≤ 0 (H_054 C2 sister)
//    H224.2  XOR Δ ≤ 0 (H_212 mid-range sister)
//    H224.3  mult-gate Δ > +5% (super-additive)
//    H224.4  ranking mult > XOR > linear (monotone Δ)
//    H224.5  re-run byte-identical (deterministic)
//
//  FALSIFIERS (≥5):
//    F1  LINEAR-SUPER:   linear-avg Δ > 0 → H_054 C2 regression
//    F2  MULT-SUB:       mult-gate Δ ≤ 0 → no holism
//    F3  RANKING:        Δ(mult) ≤ Δ(XOR) or Δ(XOR) ≤ Δ(linear)
//    F4  DETERMIN:       re-run byte-different
//    F5  PRIMITIVE-OK:   any Φ NaN/Inf/negative
//
//  CRITERIA (≥4):
//    C1  linear sub-add  (F1 NOT_TRIGGERED)
//    C2  mult super-add  (F2 NOT_TRIGGERED · Δ% ≥ 5%)
//    C3  ranking monotone (F3 NOT_TRIGGERED)
//    C4  byte-identical  (F4 NOT_TRIGGERED)
//    SUPPORTED if C1+C2+C3 PASS
//
//  TIER = 🟢 NUMERICAL
// ════════════════════════════════════════════════════════════════════════════
import "/Users/ghost/core/anima/.claude/worktrees/agent-a483e5f5187b9fb1a/HEXAD/C/c_lib.hexa"

// ── config ──────────────────────────────────────────────────────────────────
fn _N() -> int    { return 8 }
fn _DIM() -> int  { return 8 }
fn _WARM() -> int { return 8 }
fn _state_dir() -> string {
    return "/Users/ghost/core/anima/.claude/worktrees/agent-a483e5f5187b9fb1a/UNIVERSE/state/h224_holism_whole_vs_sum_2026_05_24"
}

// ── tiny helpers ───────────────────────────────────────────────────────────
fn _pow2(k: int) -> int {
    let mut p = 1
    let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    return p
}
fn _ftoi(x: float) -> int { if x > 0.5 { return 1 }; return 0 }
fn _itof(b: int) -> float { if b == 1 { return 1.0 }; return 0.0 }
fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }
fn _bool_str(b: bool) -> string { if b { return "true" }; return "false" }
fn _verdict(b: bool) -> string { if b { return "PASS" }; return "FAIL" }

// elementary CA next-state
fn _ca_next(l: int, c: int, r: int, rule: int) -> int {
    let idx = l * 4 + c * 2 + r
    return (rule / _pow2(idx)) % 2
}

// deterministic initial row
fn _init_row(row: int, n: int, rep: int) -> int {
    let mut i = 0
    while i < n {
        let on = ((i + rep) % 3) != 0
        if on { let _ = farr_set(row, i, 1.0) }
        else  { let _ = farr_set(row, i, 0.0) }
        i = i + 1
    }
    return 1
}

// evolve length-N periodic elementary CA; record each site's `dim`-step
// trajectory after `warm` warmup into a flat (n × dim) farr handle.
fn _run_ca(rule: int, n: int, dim: int, warm: int, rep: int) -> int {
    let row = farr_zeros(n)
    let _ = _init_row(row, n, rep)
    let states = farr_zeros(n * dim)
    let total = warm + dim
    let mut step = 0
    while step < total {
        if step >= warm {
            let t = step - warm
            let mut s = 0
            while s < n {
                let _ = farr_set(states, s * dim + t, farr_get(row, s))
                s = s + 1
            }
        }
        let nxt = farr_zeros(n)
        let mut j = 0
        while j < n {
            let lj = (j + n - 1) % n
            let rj = (j + 1) % n
            let lv = _ftoi(farr_get(row, lj))
            let cv = _ftoi(farr_get(row, j))
            let rv = _ftoi(farr_get(row, rj))
            let _ = farr_set(nxt, j, _itof(_ca_next(lv, cv, rv, rule)))
            j = j + 1
        }
        let mut k = 0
        while k < n { let _ = farr_set(row, k, farr_get(nxt, k)); k = k + 1 }
        let _ = farr_free(nxt)
        step = step + 1
    }
    let _ = farr_free(row)
    return states
}

// ── 3 binding modes — same A, B sub-state, different merge primitive ──────
//
// Note: mode_name ∈ {"linear", "xor", "mult"}.
// Output is a 2N × dim farr (cells = A concat B by row, with B re-binding
// applied per the mode). Convention: rows [0..N) hold A unchanged, rows
// [N..2N) hold the mode-bound B' (= B after the binding rule below).
//
// Rationale:
//   - linear-avg : B'[i,t] = 0.5 * (A[i,t] + B[i,t])
//   - XOR        : B'[i,t] = (A[i,t] + B[i,t]) mod 2
//   - mult-gate  : B'[i,t] = A[i,t] * B[i,t]                  (B conditional on A)
//
// concat ([A | B']) ensures equal cell count (2N) across modes — only the
// B-side payload changes, so any Δ comes from the binding rule, not from
// substrate size. This is the *holism axis*: same parts (A, B), different
// whole (merge).
fn _build_bound(a: int, b: int, mode: string, n: int, dim: int) -> int {
    let out = farr_zeros(2 * n * dim)
    // copy A unchanged into rows [0..N)
    let mut i = 0
    while i < n {
        let mut t = 0
        while t < dim {
            let _ = farr_set(out, i * dim + t, farr_get(a, i * dim + t))
            t = t + 1
        }
        i = i + 1
    }
    // compute B' into rows [N..2N) per mode
    let mut j = 0
    while j < n {
        let mut t2 = 0
        while t2 < dim {
            let av = farr_get(a, j * dim + t2)
            let bv = farr_get(b, j * dim + t2)
            let mut v = 0.0
            if mode == "linear" {
                v = 0.5 * (av + bv)
            } else if mode == "xor" {
                let ai = _ftoi(av)
                let bi = _ftoi(bv)
                v = _itof((ai + bi) % 2)
            } else if mode == "mult" {
                // mult-gate: B conditional on A (AND-mask on binary, product
                // on continuous). With binary states this is exactly A AND B.
                v = av * bv
            } else {
                v = 0.0  // unreachable
            }
            let _ = farr_set(out, (n + j) * dim + t2, v)
            t2 = t2 + 1
        }
        j = j + 1
    }
    return out
}

struct ModeResult {
    mode: string
    phi_a: float
    phi_b: float
    phi_merged: float
    sum_micro: float
    delta: float
    delta_pct: float       // delta / sum_micro * 100
    super_additive: bool
}

fn _measure_mode(a: int, b: int, mode: string, n: int, dim: int, nbins: int) -> ModeResult {
    let phi_a = c_measure_phi(a, n, dim, nbins)
    let phi_b = c_measure_phi(b, n, dim, nbins)
    let merged = _build_bound(a, b, mode, n, dim)
    let phi_m = c_measure_phi(merged, 2 * n, dim, nbins)
    let sum_micro = phi_a + phi_b
    let delta = phi_m - sum_micro
    let delta_pct = if sum_micro > 0.000001 { (delta / sum_micro) * 100.0 } else { 0.0 }
    let super_add = delta_pct >= 5.0  // ≥ +5% super-additive threshold
    let _ = farr_free(merged)
    return ModeResult(mode, phi_a, phi_b, phi_m, sum_micro, delta, delta_pct, super_add)
}

fn main() {
    println("================================================================")
    println("H_224 holism-whole-vs-sum — 3 binding mode super-additivity scan")
    println("  AXES.md R8 meta · H_054 C2 / H_157 C6 / H_212 cross-cycle generalize")
    println("================================================================")
    println("  N=" + to_string(_N()) + " dim=" + to_string(_DIM())
            + " warm=" + to_string(_WARM()) + "  (deterministic, $0 mac local)")
    println("  Φ primitive: RFC 036 phi_spatial via HEXAD/C/c_lib.hexa")
    println("  Binding modes: linear-avg / XOR / mult-gate")
    println("  Lane-separate concept axis (binding-mode sweep, not ρ-sweep)")
    println("")

    // ── build fixed A (rule-110, rep=0) and B (rule-30, rep=1) sub-states ─
    let states_a = _run_ca(110, _N(), _DIM(), _WARM(), 0)
    let states_b = _run_ca( 30, _N(), _DIM(), _WARM(), 1)
    let nbins = c_phi_n_bins_default()

    // ── 3 mode sweep ─────────────────────────────────────────────────────
    println("── binding-mode sweep — 3 modes ──")
    let r_lin = _measure_mode(states_a, states_b, "linear", _N(), _DIM(), nbins)
    let r_xor = _measure_mode(states_a, states_b, "xor",    _N(), _DIM(), nbins)
    let r_mul = _measure_mode(states_a, states_b, "mult",   _N(), _DIM(), nbins)

    println("  mode=linear-avg  (M_avg : B'[i,t] = 0.5*(A[i,t]+B[i,t])):")
    println("    Φ_A=" + to_string(r_lin.phi_a) + "  Φ_B=" + to_string(r_lin.phi_b)
            + "  Φ_merged=" + to_string(r_lin.phi_merged))
    println("    Σ_micro=" + to_string(r_lin.sum_micro) + "  Δ=" + to_string(r_lin.delta)
            + "  Δ%=" + to_string(r_lin.delta_pct) + "%")
    println("  mode=XOR         (M_xor : B'[i,t] = (A[i,t]+B[i,t]) mod 2):")
    println("    Φ_A=" + to_string(r_xor.phi_a) + "  Φ_B=" + to_string(r_xor.phi_b)
            + "  Φ_merged=" + to_string(r_xor.phi_merged))
    println("    Σ_micro=" + to_string(r_xor.sum_micro) + "  Δ=" + to_string(r_xor.delta)
            + "  Δ%=" + to_string(r_xor.delta_pct) + "%")
    println("  mode=mult-gate   (M_gate : B'[i,t] = A[i,t] * B[i,t]):")
    println("    Φ_A=" + to_string(r_mul.phi_a) + "  Φ_B=" + to_string(r_mul.phi_b)
            + "  Φ_merged=" + to_string(r_mul.phi_merged))
    println("    Σ_micro=" + to_string(r_mul.sum_micro) + "  Δ=" + to_string(r_mul.delta)
            + "  Δ%=" + to_string(r_mul.delta_pct) + "%")
    println("")

    // ── falsifier evaluation ─────────────────────────────────────────────
    // F1  LINEAR-SUPER: linear-avg Δ > 0 (H_054 C2 regression)
    let f1_triggered = r_lin.delta > 0.000001
    // F2  MULT-SUB: mult-gate Δ ≤ 0 (no holism)
    let f2_triggered = r_mul.delta <= 0.000001 || r_mul.delta_pct < 5.0
    // F3  RANKING: ranking not monotone (mult > xor > linear)
    let f3_triggered = !(r_mul.delta > r_xor.delta && r_xor.delta > r_lin.delta)
    // F4  DETERMIN: re-run byte-different
    let r_mul_b = _measure_mode(states_a, states_b, "mult", _N(), _DIM(), nbins)
    let f4_triggered = !(r_mul.phi_a == r_mul_b.phi_a
                       && r_mul.phi_b == r_mul_b.phi_b
                       && r_mul.phi_merged == r_mul_b.phi_merged)
    // F5  PRIMITIVE-OK: any Φ negative
    let f5_triggered = r_lin.phi_a < 0.0 || r_lin.phi_b < 0.0 || r_lin.phi_merged < 0.0
                    || r_xor.phi_a < 0.0 || r_xor.phi_b < 0.0 || r_xor.phi_merged < 0.0
                    || r_mul.phi_a < 0.0 || r_mul.phi_b < 0.0 || r_mul.phi_merged < 0.0

    println("── falsifier verdicts (NOT_TRIGGERED = pass) ──")
    println("  F1  LINEAR-SUPER   (linear Δ>0)              : " + _verdict(!f1_triggered))
    println("  F2  MULT-SUB       (mult Δ%<5%)              : " + _verdict(!f2_triggered))
    println("  F3  RANKING        (Δmult>Δxor>Δlin)         : " + _verdict(!f3_triggered))
    println("  F4  DETERMIN       (byte-equal re-run)       : " + _verdict(!f4_triggered))
    println("  F5  PRIMITIVE-OK   (no negative Φ)           : " + _verdict(!f5_triggered))
    println("")

    // ── criteria evaluation ──────────────────────────────────────────────
    let c1 = !f1_triggered
    let c2 = !f2_triggered
    let c3 = !f3_triggered
    let c4 = !f4_triggered
    let pass_count = (if c1 { 1 } else { 0 }) + (if c2 { 1 } else { 0 })
                   + (if c3 { 1 } else { 0 }) + (if c4 { 1 } else { 0 })

    let verdict = if c1 && c2 && c3 {
        "SUPPORTED  (mult-gate holism super-additive · linear+XOR sub-additive · ranking monotone)"
    } else if pass_count >= 2 {
        "PARTIAL    (some criteria met · directional evidence)"
    } else {
        "FALSIFIED  (no binding-mode super-additivity · holism null)"
    }

    println("================================================================")
    println("H_224 Cycle #1 VERDICT: " + verdict)
    println("  criteria: C1=" + _verdict(c1) + " C2=" + _verdict(c2)
            + " C3=" + _verdict(c3) + " C4=" + _verdict(c4)
            + "  (" + to_string(pass_count) + "/4)")
    println("  ranking: Δlin=" + to_string(r_lin.delta)
            + "  Δxor=" + to_string(r_xor.delta)
            + "  Δmult=" + to_string(r_mul.delta))
    println("================================================================")

    // ── write result.json ────────────────────────────────────────────────
    let mut j = "{\n"
    j = j + "  \"hypothesis\": \"H_224\",\n"
    j = j + "  \"slug\": \"holism-whole-vs-sum-of-parts\",\n"
    j = j + "  \"cycle\": 1,\n"
    j = j + "  \"date\": \"2026-05-24\",\n"
    j = j + "  \"domain\": \"meta + math + consciousness\",\n"
    j = j + "  \"deterministic\": true,\n"
    j = j + "  \"hexa_only\": true,\n"
    j = j + "  \"llm\": \"none\",\n"
    j = j + "  \"cost\": \"$0 mac local\",\n"
    j = j + "  \"axis\": \"AXES.md R8 meta · holism-whole-vs-sum-of-parts\",\n"
    j = j + "  \"cross_cycle_generalize\": \"H_054 C2 (PR #227, linear MERGE sub-add) + H_157 C6 (PR #221, uncorrelated concat sub-add) + H_212 (ρ-sweep, mid-range non-monotone)\",\n"
    j = j + "  \"phi_primitive\": \"RFC 036 phi_spatial via HEXAD/C/c_lib.hexa (byte-equal phi_rs native replica)\",\n"
    j = j + "  \"config\": {\"N\": " + to_string(_N()) + ", \"dim\": " + to_string(_DIM())
          + ", \"warm\": " + to_string(_WARM()) + ", \"n_bins\": " + to_string(nbins)
          + ", \"A_rule\": 110, \"B_rule\": 30, \"merge\": \"concat([A | B'])\","
          + " \"modes\": [\"linear\", \"xor\", \"mult\"]},\n"
    j = j + "  \"mode_sweep\": [\n"
    j = j + "    {\"mode\": \"linear-avg\", \"phi_A\": " + to_string(r_lin.phi_a)
          + ", \"phi_B\": " + to_string(r_lin.phi_b) + ", \"phi_merged\": " + to_string(r_lin.phi_merged)
          + ", \"sum_micro\": " + to_string(r_lin.sum_micro) + ", \"delta\": " + to_string(r_lin.delta)
          + ", \"delta_pct\": " + to_string(r_lin.delta_pct)
          + ", \"super_additive\": " + _bool_str(r_lin.super_additive) + "},\n"
    j = j + "    {\"mode\": \"xor\", \"phi_A\": " + to_string(r_xor.phi_a)
          + ", \"phi_B\": " + to_string(r_xor.phi_b) + ", \"phi_merged\": " + to_string(r_xor.phi_merged)
          + ", \"sum_micro\": " + to_string(r_xor.sum_micro) + ", \"delta\": " + to_string(r_xor.delta)
          + ", \"delta_pct\": " + to_string(r_xor.delta_pct)
          + ", \"super_additive\": " + _bool_str(r_xor.super_additive) + "},\n"
    j = j + "    {\"mode\": \"mult-gate\", \"phi_A\": " + to_string(r_mul.phi_a)
          + ", \"phi_B\": " + to_string(r_mul.phi_b) + ", \"phi_merged\": " + to_string(r_mul.phi_merged)
          + ", \"sum_micro\": " + to_string(r_mul.sum_micro) + ", \"delta\": " + to_string(r_mul.delta)
          + ", \"delta_pct\": " + to_string(r_mul.delta_pct)
          + ", \"super_additive\": " + _bool_str(r_mul.super_additive) + "}\n"
    j = j + "  ],\n"
    j = j + "  \"falsifiers\": {\n"
    j = j + "    \"F1_LINEAR_SUPER\":  {\"metric\": \"linear Δ>0 (H_054 C2 regression)\", \"triggered\": " + _bool_str(f1_triggered) + ", \"verdict\": \"" + _verdict(!f1_triggered) + "\"},\n"
    j = j + "    \"F2_MULT_SUB\":      {\"metric\": \"mult Δ%<5% (no holism)\",         \"triggered\": " + _bool_str(f2_triggered) + ", \"verdict\": \"" + _verdict(!f2_triggered) + "\"},\n"
    j = j + "    \"F3_RANKING\":       {\"metric\": \"Δmult > Δxor > Δlin\",            \"triggered\": " + _bool_str(f3_triggered) + ", \"verdict\": \"" + _verdict(!f3_triggered) + "\"},\n"
    j = j + "    \"F4_DETERMIN\":      {\"metric\": \"byte-equal re-run\",              \"triggered\": " + _bool_str(f4_triggered) + ", \"verdict\": \"" + _verdict(!f4_triggered) + "\"},\n"
    j = j + "    \"F5_PRIMITIVE_OK\":  {\"metric\": \"no Φ<0\",                         \"triggered\": " + _bool_str(f5_triggered) + ", \"verdict\": \"" + _verdict(!f5_triggered) + "\"}\n"
    j = j + "  },\n"
    j = j + "  \"criteria\": {\n"
