// ════════════════════════════════════════════════════════════════════════════
// H_660 — convexity-magnitude-class-reconcile  (round 9 메타-축, axis G)
//
//   ROUND-9 META-AXIS — "Wolfram class 가 의식 통합량 분류자".
//   두 자매 결과가 이미 갈렸다 (분기):
//     H_653 (PR #1245, 🟢) : W→Φ_collective convexity SPAN RATIO (Φ_max/Φ_min,
//        *normalized shape*) monotone-in-class — rule184(II) 12.12 < rule90(III)
//        30.42 < rule30(III) 30.77 < rule110(IV) 35.50. class is a SHAPE classifier.
//     H_655 (PR #1253, 🔴) : super-additivity Δ (*absolute magnitude*) NON-monotone —
//        rule184(II) 51.54 > rule110(IV) 41.71 > rule30(III) 9.72 > rule90(III) 7.50.
//        class is NOT an absolute-magnitude classifier.
//
//   분기 진단 (H_655 §5.3): rule184 는 Φ 절대값(min·max 모두)이 압도적으로 높아
//   ratio 는 작지만 magnitude 는 最高. 즉 shape(normalized)와 scale(absolute)이
//   서로 다른 class 의존성을 가진다.
//
//   THIS H — RECONCILE THE FORK WITH A SINGLE UNIFIED METRIC.
//   shape 정보(H_653)는 보존하되 magnitude 혼입(H_655)은 제거하는 SCALE-INVARIANT
//   통합 측도가 class-monotone 을 회복하는가?
//     • span_ratio   = Φ_max / Φ_min                  (H_653 normalized shape)
//     • abs_delta    = Φ_max − Φ_min                  (H_655 absolute magnitude)
//     • norm_conv    = (Φ_max − Φ_min) / Φ_mean       (scale-invariant convexity)
//     • log_span     = ln(Φ_max / Φ_min)              (scale-invariant log-span)
//   span_ratio·norm_conv·log_span 는 모두 scale-invariant (Φ→kΦ 불변). abs_delta 만
//   scale-dependent. 만약 scale-invariant 3종이 class 단조이고 abs_delta 만 비단조라면
//   → 분기는 "scale 혼입" 때문 (가설 SUPPORTED, 화해 성공).
//
//   H1 (SCALE-INVARIANT RECONCILES): scale-invariant 측도(norm_conv, log_span)가
//       Wolfram class 단조 — class-IV(rule110) 最高. shape 보존 + magnitude 제거 →
//       class-monotone 회복. 분기가 본질적이 아니라 scale 혼입.
//   H0 (FALSIFIER): scale-invariant 측도도 비단조 → 분기는 scale 혼입이 아니라
//       본질적 (class 가 shape 도 완전히 order 못함, H_642 cross-rule shape FAIL 정합).
//
//   MODEL (no new physics — H_635/H_653/H_655 engine, cohort rule 만 swap)
//     • homogeneous cohort [rule×5], n=5 coupled ring, sync_factor W.
//     • Φ_collective(W) = big_phi_bounded(build_tpm_cohort([rule×5], W), 5, sys=0, cap=3).
//     • W grid = H_653 와 동일 6-pt {0.15,0.40,0.55,0.70,0.95,1.0} (H_643 stage W + mid).
//     • Φ_min/Φ_max/Φ_mean over the grid → 4 metric 계산.
//
//   COHORT rule → Wolfram class (substrate complexity, ascending; H_653/H_655 동일):
//     rule184  class-II   (additive / traffic, simplest ordered)
//     rule 90  class-III  (XOR / additive fractal)
//     rule 30  class-III  (chaotic, non-additive)
//     rule110  class-IV   (complex / universal, edge-of-chaos — winner)
//
//   PRE-REGISTERED FALSIFIERS (frozen BEFORE measuring)
//     F660.1 NORMCONV-MONOTONE : norm_conv(110) ≥ norm_conv(30) ≥ norm_conv(90)
//             ≥ norm_conv(184) — scale-invariant convexity class 단조. CORE 가설.
//     F660.2 LOGSPAN-MONOTONE : log_span(110) ≥ log_span(30) ≥ log_span(90)
//             ≥ log_span(184) — log-span 도 class 단조 (span_ratio 와 동순위 유지 확인).
//     F660.3 ABSDELTA-NONMONOTONE : abs_delta NON-monotone (H_655 magnitude 비단조
//             재현 — rule184 II 가 abs_delta 最高, class-IV 가 max 아님).
//     F660.4 SPANRATIO-REPLICATE : span_ratio 순위 = H_653 (110≥30≥90≥184) 재현
//             (engine replication — 동일 측도 동일 결론).
//     F660.5 SCALE-INVARIANCE : norm_conv·log_span 는 Φ→2Φ 스케일에 불변
//             (Φ_max/Φ_min, (Φmax-Φmin)/Φmean 의 형식적 scale-invariance 검증).
//     F660.6 BOUND : 全 Φ ≥ 0, 全 metric finite, Φ_mean > 0.
//
//   verdict 기준:
//     F660.1 (CORE scale-invariant reconcile) PASS + ≥4/6 → 🟢 SUPPORTED-NUMERICAL
//        (분기 = scale 혼입, scale-invariant metric 으로 화해 성공).
//     F660.1 FAIL → 🔴 (분기 본질적, scale-invariant 도 비단조).
//
//   anchors: H_653 (convexity span-ratio monotone-in-class, 🟢) · H_655 (super-add
//            magnitude non-monotone, 🔴) · H_642 (cross-rule shape invariance FAIL) ·
//            H_654 (single-substrate magnitude order PARTIAL).
//   deterministic · hexa-only · $0 mac-local · sys_state=0 · cap=3 · foreground sync.
//
//   ⚠ C3: 4 rule × 6 W-pt = 24 big_phi_bounded calls (H_653 와 동일 예산). 단일 sync
//   run <60s (H_653 24-call wall 검증됨). fallback 불필요. NO RNG · NO GPU · NO bg fork.
// ════════════════════════════════════════════════════════════════════════════
import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── n=5 coupled-ring TPM with sync_factor W (verbatim from H_635/H_653/H_655) ──
fn build_tpm_cohort(rule: array, W: float) -> array {
    let n = 5
    let full = 32
    let one_minus_w = 1.0 - W
    let mut t = []
    let mut s = 0
    while s < full {
        let mut i = 0
        while i < n {
            let r_i = rule[i]
            let c = iit4_bit(s, i)
            let idx_dec = 4 * c + 2 * c + c        // = 7*c ∈ {0,7}
            let next_dec = iit4_bit(r_i, idx_dec)
            let l = iit4_bit(s, (i - 1 + n) % n)
            let rr = iit4_bit(s, (i + 1) % n)
            let idx_cou = 4 * l + 2 * c + rr
            let next_cou = iit4_bit(r_i, idx_cou)
            let p = one_minus_w * to_float(next_dec) + W * to_float(next_cou)
            t = t.push(p)
            i = i + 1
        }
        s = s + 1
    }
    return t
}

fn phi_collective(rule: array, W: float) -> float {
    let tpm = build_tpm_cohort(rule, W)
    let r = big_phi_bounded(tpm, 5, 0, 3)
    return r[0]
}

fn main() {
    println("================================================================")
    println("  H_660 — convexity-magnitude-class-reconcile (round 9 메타-축)")
    println("  H_653(span-ratio shape 단조) ↔ H_655(abs-Δ magnitude 비단조) 화해")
    println("  scale-invariant 통합 측도가 class-monotone 회복하는가?")
    println("  IIT4 big_phi_bounded · n=5 homog cohort · cap=3 · sys=0")
    println("  4 rules × 6-pt W grid · 4 metric 대조")
    println("================================================================")

    let RULES  = [184, 90, 30, 110]
    let CLASS  = ["II-additive", "III-XOR/additive", "III-chaotic", "IV-complex"]
    // W grid = H_653 와 동일 (H_643 ultradian-stage sync_factor + 0.55 mid).
    let WGRID  = [0.15, 0.40, 0.55, 0.70, 0.95, 1.0]
    let NW = 6
    let NR = 4
    let FLOOR = 0.0001

    println("  W grid: [0.15, 0.40, 0.55, 0.70, 0.95, 1.0]  (H_653 동일)")
    println("  ─────────────────────────────────────")

    let mut span_ratios = []   // Φ_max / Φ_min                 (H_653 shape)
    let mut abs_deltas  = []   // Φ_max − Φ_min                 (H_655-류 magnitude)
    let mut norm_convs  = []   // (Φ_max − Φ_min) / Φ_mean      (scale-invariant)
    let mut log_spans   = []   // ln(Φ_max / Φ_min)             (scale-invariant)
    let mut all_bound = true
    let mut all_mean_pos = true

    let mut ri = 0
    while ri < NR {
        let rule = RULES[ri]
        let cohort = [rule, rule, rule, rule, rule]
        let mut phi_w = []
        let mut sum = 0.0
        let mut wi = 0
        while wi < NW {
            let W = WGRID[wi]
            let phi = phi_collective(cohort, W)
            phi_w = phi_w + [phi]
            sum = sum + phi
            if phi < 0.0 { all_bound = false }
            wi = wi + 1
        }
        let mut pmin = phi_w[0]
        let mut pmax = phi_w[0]
        wi = 0
        while wi < NW {
            if phi_w[wi] < pmin { pmin = phi_w[wi] }
            if phi_w[wi] > pmax { pmax = phi_w[wi] }
            wi = wi + 1
        }
        let pmean = sum / to_float(NW)
        if pmean <= 0.0 { all_mean_pos = false }

        let denom = pmin + FLOOR
        let span_ratio = pmax / denom            // H_653 shape
        let abs_delta  = pmax - pmin             // H_655-류 absolute magnitude
        let norm_conv  = (pmax - pmin) / pmean   // scale-invariant convexity
        let log_span   = ln(span_ratio)          // scale-invariant log-span

        span_ratios = span_ratios + [span_ratio]
        abs_deltas  = abs_deltas + [abs_delta]
        norm_convs  = norm_convs + [norm_conv]
        log_spans   = log_spans + [log_span]

        println("  rule" + str(rule) + " [" + CLASS[ri] + "]")
        let mut line = "    Φ(W):"
        wi = 0
        while wi < NW {
            line = line + " " + to_string(phi_w[wi])
            wi = wi + 1
        }
        println(line)
        println("    Φ_min=" + to_string(pmin) + " Φ_max=" + to_string(pmax) + " Φ_mean=" + to_string(pmean))
        println("    span_ratio=" + to_string(span_ratio) + " abs_Δ=" + to_string(abs_delta) + " norm_conv=" + to_string(norm_conv) + " log_span=" + to_string(log_span))
        ri = ri + 1
    }

    // index map: RULES = [184, 90, 30, 110] → idx 0,1,2,3
    let sr_184 = span_ratios[0]; let sr_90 = span_ratios[1]; let sr_30 = span_ratios[2]; let sr_110 = span_ratios[3]
    let ad_184 = abs_deltas[0];  let ad_90 = abs_deltas[1];  let ad_30 = abs_deltas[2];  let ad_110 = abs_deltas[3]
    let nc_184 = norm_convs[0];  let nc_90 = norm_convs[1];  let nc_30 = norm_convs[2];  let nc_110 = norm_convs[3]
    let ls_184 = log_spans[0];   let ls_90 = log_spans[1];   let ls_30 = log_spans[2];   let ls_110 = log_spans[3]

    println("  ─────────────────────────────────────")
    println("  metric × class (ascending complexity II→III→III→IV):")
    println("    span_ratio (H_653 shape)     : 184=" + to_string(sr_184) + " 90=" + to_string(sr_90) + " 30=" + to_string(sr_30) + " 110=" + to_string(sr_110))
    println("    abs_Δ      (H_655 magnitude) : 184=" + to_string(ad_184) + " 90=" + to_string(ad_90) + " 30=" + to_string(ad_30) + " 110=" + to_string(ad_110))
    println("    norm_conv  (scale-invariant) : 184=" + to_string(nc_184) + " 90=" + to_string(nc_90) + " 30=" + to_string(nc_30) + " 110=" + to_string(nc_110))
    println("    log_span   (scale-invariant) : 184=" + to_string(ls_184) + " 90=" + to_string(ls_90) + " 30=" + to_string(ls_30) + " 110=" + to_string(ls_110))
    println("  ────────────── verdict ──────────────")

    // F660.1 NORMCONV-MONOTONE: nc_110 >= nc_30 >= nc_90 >= nc_184  (CORE)
    let nc_mono = (nc_110 >= nc_30) && (nc_30 >= nc_90) && (nc_90 >= nc_184)
    check("F660.1 NORMCONV-MONOTONE: norm_conv(110)>=(30)>=(90)>=(184)", nc_mono)

    // F660.2 LOGSPAN-MONOTONE: ls_110 >= ls_30 >= ls_90 >= ls_184
    let ls_mono = (ls_110 >= ls_30) && (ls_30 >= ls_90) && (ls_90 >= ls_184)
    check("F660.2 LOGSPAN-MONOTONE: log_span(110)>=(30)>=(90)>=(184)", ls_mono)

    // F660.3 ABSDELTA-NONMONOTONE: abs_delta NON-monotone (H_655 재현)
    let ad_mono = (ad_110 >= ad_30) && (ad_30 >= ad_90) && (ad_90 >= ad_184)
    check("F660.3 ABSDELTA-NONMONOTONE: abs_Δ NOT class-monotone (H_655 재현)", ad_mono == false)

    // F660.4 SPANRATIO-REPLICATE: span_ratio 순위 = H_653 (110>=30>=90>=184)
    let sr_mono = (sr_110 >= sr_30) && (sr_30 >= sr_90) && (sr_90 >= sr_184)
    check("F660.4 SPANRATIO-REPLICATE: span_ratio(110)>=(30)>=(90)>=(184) (H_653 재현)", sr_mono)

    // F660.5 SCALE-INVARIANCE: norm_conv/log_span 는 Φ→2Φ 불변 (rule110 검증)
    //   2Φ scale: (2pmax-2pmin)/(2pmean) = (pmax-pmin)/pmean = norm_conv (불변).
    //   ln(2pmax/2pmin) = ln(pmax/pmin) = log_span (불변).
    let cohort110 = [110, 110, 110, 110, 110]
    let mut phi2 = []
    let mut sum2 = 0.0
    let mut wj = 0
    while wj < NW {
        let p2 = phi_collective(cohort110, WGRID[wj]) * 2.0   // Φ→2Φ scale
        phi2 = phi2 + [p2]
        sum2 = sum2 + p2
        wj = wj + 1
    }
    let mut pmin2 = phi2[0]; let mut pmax2 = phi2[0]
    wj = 0
    while wj < NW {
        if phi2[wj] < pmin2 { pmin2 = phi2[wj] }
        if phi2[wj] > pmax2 { pmax2 = phi2[wj] }
        wj = wj + 1
    }
    let pmean2 = sum2 / to_float(NW)
    let nc2 = (pmax2 - pmin2) / pmean2
    let ls2 = ln(pmax2 / (pmin2 + FLOOR * 2.0))
    let nc_inv = fabs(nc2 - nc_110) < 0.001
    let ls_inv = fabs(ls2 - ls_110) < 0.01
    check("F660.5 SCALE-INVARIANCE: norm_conv·log_span invariant under Φ→2Φ", nc_inv && ls_inv)

    // F660.6 BOUND: 全 Φ ≥ 0, metric finite, Φ_mean > 0
    let mut metrics_finite = true
    ri = 0
    while ri < NR {
        if fabs(span_ratios[ri]) > 1.0e12 { metrics_finite = false }
        if fabs(norm_convs[ri]) > 1.0e12 { metrics_finite = false }
        if fabs(log_spans[ri]) > 1.0e12 { metrics_finite = false }
        ri = ri + 1
    }
    check("F660.6 BOUND: Φ ≥ 0, metric finite, Φ_mean > 0", all_bound && all_mean_pos && metrics_finite)

    println("  ──────────────────────────────────────")
    println("  F660.1-6 " + str(PASS) + "/" + str(PASS + FAIL) + " PASS")
    let mut verdict = "🔴 FALSIFIED (scale-invariant 도 비단조 — 분기 본질적)"
    if (nc_mono) && (PASS >= 4) { verdict = "🟢 SUPPORTED-NUMERICAL (scale-invariant metric 으로 분기 화해 — shape 단조 회복)" }
    if nc_mono == false { verdict = "🔴 FALSIFIED (norm_conv 비단조 — 분기 본질적, scale 혼입 아님)" }
    println("  verdict: " + verdict)
    println("  reconcile: H_653 span_ratio(110)=" + to_string(sr_110) + " 단조 ↔ H_655 abs_Δ(184)=" + to_string(ad_184) + " 비단조 → norm_conv class-monotone=" + str(nc_mono))
}
