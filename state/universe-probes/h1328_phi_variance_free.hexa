// h1328_phi_variance_free.hexa — DIAGNOSIS of the 4× faithful-IIT4 Φ-robustness wall.
//
// THE META-DIAGNOSIS (H_1319 §Finding): four independent Φ-robustness attempts (H_1283 relay,
// H_1317 small-world multi-edge, H_1319 phase-binding, H_1320 organism-mitosis) all hit 🧱 on the
// SAME orthogonal seed family — because the faithful-IIT4 exact-MIP at n≤8 BINARIZES (bins) each
// cell's trajectory by MIN-MAX, and that binning RIDES AMPLITUDE VARIANCE. Proof in H_1319: a
// relationship-DESTROYING permutation control RAISED Φ instead of collapsing it (ΔΦ_perm
// +0.280/+0.103/+0.587 on all 3 hard seeds). The wall may be the ESTIMATOR's read-out, not the
// substrate's integration.
//
// THIS LANE (H_1328) directly tests that diagnosis. STAY WITHIN faithful IIT-4 (a_phi_iit4_tool —
// SAME exact MIP-EI, iit4_faithful_phi over stdlib). The ONLY lever is the STATE-ENCODING that
// feeds the SAME estimator — NOT a different Φ measure / NOT a variance×energy proxy.
//
// ── THE VARIANCE-FREE ENCODING (provably removes the amplitude-variance contribution) ──
//   faithful_phi's MI estimator is  MI(A;B) = H(A) + H(B) − H(A,B), where each cell's trajectory is
//   binned into n_bins by MIN-MAX normalization (_iit4_bin_values). H(A) and H(B) (the MARGINAL
//   entropies) are where amplitude VARIANCE leaks in: a high-variance carrier spreads a cell's values
//   across more bins (higher marginal entropy) WITHOUT any relationship to another cell. ANY phase
//   scramble (offset OR permutation) preserves those single-cell marginals, so it preserves that
//   variance-driven entropy → the permutation control RAISES Φ (the H_1319 confound).
//
//   FIX = RANK-UNIFORMIZE each cell's trajectory BEFORE it feeds the SAME faithful MIP. Replace each
//   value by its RANK within that cell's own T-length trajectory (0,1,…,T−1, ties broken by index).
//   PROVABLE INVARIANT: after rank-uniformization every cell's values are the multiset {0,1,…,T−1};
//   min-max binning of an evenly-spaced ramp gives a UNIFORM histogram → H(A) and H(B) are CONSTANT
//   (≈ log2(n_bins)) for EVERY cell in EVERY arm, INDEPENDENT of amplitude variance. The
//   variance contribution to the marginals is therefore PROVABLY CONSTANT (zero differential) across
//   arms. MI then depends ONLY on the JOINT H(A,B) — the co-movement RELATIONSHIP between two cells —
//   which is exactly what a relationship-destroying permutation MUST collapse. (Spearman-rank MI: the
//   marginals are rank-uniform by construction; only the COPULA / joint rank structure carries info.)
//
// SAME substrate as H_1319/H_1320: engine-native LCG-gauss leaky-linear 4-module ring, dim 8, T 64,
// Kuramoto pacemaker, relative-phase gate. SAME 3 hard orthogonal seeds [1317,1318,1319]. The ONLY
// change vs H_1319 is whether the per-cell trajectory is rank-uniformized before the SAME exact MIP.
//
// ── FROZEN BARS (pre-registered in H_1328_FREEZE.txt BEFORE scoring; DIAGNOSIS — every outcome decisive) ──
//   eps = 0.02 (= the H_1283/H_1319 lift margin MARGIN_PHI, ported verbatim, NOT tuned).
//   V1 CONFOUND-CONFIRM (decisive discriminator), BOTH legs on ALL 3 seeds:
//       V1a OLD-RIDES-VARIANCE : under OLD min-max encoding, perm-shuffle ΔΦ(S−A) ≥ +eps (RAISES Φ)
//                                — reproduces the H_1319 confound (the perm control fails to collapse).
//       V1b NEW-REMOVES-IT     : under NEW rank-uniform encoding, perm-shuffle Φ_S ≤ Φ_A + eps
//                                (perm collapses to ≤ no-coupling+eps) on ALL 3 seeds.
//       V1 = V1a ∧ V1b. If V1 holds → binarization-rides-variance confound CONFIRMED real & removed.
//   V2 ROBUST-LIFT : under NEW rank-uniform encoding, mechanism Φ_B ≥ Φ_A + eps on ALL 3 seeds
//                    (incl orthogonal 1317) — integration appears robustly under the clean estimator.
//   V3 EARNED      : under NEW encoding, that lift survives BOTH controls — perm Φ_S ≤ Φ_A + eps
//                    AND offset-shuf Φ_O ≤ Φ_A + eps, on ALL 3 seeds (the controls now correctly collapse).
//
//   OUTCOMES (all VALID, c9):
//     V1∧V2∧V3 → 🟢 wall was the ESTIMATOR's amplitude-variance confound; clean read-out makes
//                 integration robust (overturns the 4× 🧱). Follow-on = wire rank-uniform read-out.
//     V1 ∧ ¬V2 → confound REAL but integration still NOT robust under a clean estimator → DEEPER,
//                 estimator-INDEPENDENT terminal 🧱 (substrate genuinely lacks robust n≤8 integration).
//     ¬V1      → variance diagnosis WRONG; the 4× wall remains undiagnosed (report straight).
//
// run from hexa-lang root (stdlib import):
//   cp UNIVERSE/h1328_phi_variance_free.hexa <hexa-lang>/ && hexa run h1328_phi_variance_free.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) — VERBATIM from H_1319 ──
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── RANK-UNIFORMIZE one cell's T-length trajectory IN-PLACE in the flat traj farr ──
// Replace traj[base+k] by its RANK in [0..T-1] within that cell's own slice. Ties broken by index
// (stable). PROVABLE: output values are exactly the multiset {0,1,…,T−1} → min-max binning yields a
// UNIFORM marginal histogram → H(cell) is CONSTANT across arms, removing amplitude variance from the
// marginals. Pure O(T^2) selection-rank (T=64 tiny); no library sort needed.
fn rank_uniformize_cell(traj: int, base: int, t_ticks: int) {
    // for each position k, rank = #{ j : v_j < v_k } + #{ j<k : v_j == v_k }  (stable, distinct ranks)
    let ranks = farr_zeros(t_ticks)
    let mut k = 0
    while k < t_ticks {
        let vk = farr_get(traj, base + k)
        let mut r = 0
        let mut j = 0
        while j < t_ticks {
            let vj = farr_get(traj, base + j)
            if vj < vk { r = r + 1 }
            else { if (vj == vk) && (j < k) { r = r + 1 } }
            j = j + 1
        }
        let _ = farr_set(ranks, k, to_float(r))
        k = k + 1
    }
    // write ranks back (they are a permutation of 0..T-1, so the multiset is exactly {0..T-1})
    k = 0
    while k < t_ticks { let _ = farr_set(traj, base + k, farr_get(ranks, k))  k = k + 1 }
    let _ = farr_free(ranks)
}

// ── generate ARM trajectories ENGINE-NATIVE — body BYTE-IDENTICAL to H_1319 gen_traj ──
// mode: 0=NO-PHASE(A) 1=PHASE-BIND(B, relative-phase gate) 2=PERM-SHUFFLE(S) 3=OFFSET-SHUF(O)
// encode: 0 = OLD min-max (H_1319, raw salience)   1 = NEW variance-free (rank-uniformize each cell)
fn gen_traj(seed: int, mode: int, encode: int) -> int {
    let n_mod = 4
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }

    let mut perm = []
    if mode == 2 {
        i = 0
        while i < n_mod { perm = perm + [i]  i = i + 1 }
        let mut ps = (seed * 100003 + 19) & 2147483647
        if ps == 0 { ps = 919 }
        let mut k = n_mod - 1
        while k > 0 {
            ps = lcg_next(ps)
            let j = to_int(lcg_unit(ps) * to_float(k + 1))
            let jj = if j > k { k } else { j }
            let tmp = perm[k]
            perm[k] = perm[jj]
            perm[jj] = tmp
            k = k - 1
        }
        let mut anyfix = false
        i = 0
        while i < n_mod { if perm[i] == i { anyfix = true }  i = i + 1 }
        if anyfix {
            let mut perm2 = []
            i = 0
            while i < n_mod { perm2 = perm2 + [(i + 1) % n_mod]  i = i + 1 }
            perm = perm2
        }
    }
    let mut shuf_off = []
    if mode == 3 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }
            let mut sal = e
            if mode == 1 {
                let carrier = 0.5 * (1.0 + cos(theta[i] - theta_t))
                sal = e * carrier
            }
            if mode == 2 {
                let src = perm[i]
                let carrier = 0.5 * (1.0 + cos(theta[src] - theta_t))
                sal = e * carrier
            }
            if mode == 3 {
                let off = shuf_off[tt * n_mod + i]
                let carrier = 0.5 * (1.0 + cos((theta[i] - theta_t) + off))
                sal = e * carrier
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }

    // ── VARIANCE-FREE ENCODING — rank-uniformize each cell's trajectory before the SAME MIP ──
    if encode == 1 {
        i = 0
        while i < n_mod { rank_uniformize_cell(traj, i * t_ticks, t_ticks)  i = i + 1 }
    }
    return traj
}

fn phi_of(seed: int, mode: int, encode: int) -> float {
    let traj = gen_traj(seed, mode, encode)
    let phi = iit4_faithful_phi(traj, 4, 64, 8)
    let _ = farr_free(traj)
    return phi
}

fn main() {
    println("H_1328 — Φ-ROBUSTNESS WALL DIAGNOSIS: amplitude-variance ESTIMATOR confound vs substrate limit")
    println("faithful IIT4 Φ (exact MIP-EI, n=4, SAME estimator) · seeds [1317,1318,1319] · eps=0.02")
    println("ENCODINGS: OLD=raw min-max binning (H_1319) · NEW=rank-uniformize each cell (marginals provably uniform)")
    println("ARMS: A=NO-PHASE  B=PHASE-BIND(rel-phase)  S=PERM-SHUFFLE(relationship destroyed)  O=OFFSET-SHUF")
    println("BARS: V1a OLD perm ΔΦ(S-A)>=+eps · V1b NEW perm Φ_S<=Φ_A+eps · V2 NEW Φ_B>=Φ_A+eps · V3 NEW perm&off<=Φ_A+eps")
    let seeds = [1317, 1318, 1319]
    let eps = 0.02
    let mut v1a_all = true   // OLD perm RAISES (confound present)
    let mut v1b_all = true   // NEW perm COLLAPSES (confound removed)
    let mut v2_all = true    // NEW mechanism lift
    let mut v3_perm_all = true
    let mut v3_off_all = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        // OLD encoding (encode=0)
        let oa = phi_of(s, 0, 0)
        let ob = phi_of(s, 1, 0)
        let os = phi_of(s, 2, 0)
        let oo = phi_of(s, 3, 0)
        // NEW variance-free encoding (encode=1)
        let na = phi_of(s, 0, 1)
        let nb = phi_of(s, 1, 1)
        let ns = phi_of(s, 2, 1)
        let no = phi_of(s, 3, 1)

        let old_dphi_s = os - oa          // V1a: should be >= +eps (perm RAISES, confound)
        let new_phi_s_margin = ns - na    // V1b/V3: should be <= +eps (perm collapses)
        let new_dphi_b = nb - na          // V2: should be >= +eps (mechanism lift)
        let new_phi_o_margin = no - na    // V3: should be <= +eps (offset collapses)

        let v1a = old_dphi_s >= eps
        let v1b = new_phi_s_margin <= eps
        let v2  = new_dphi_b >= eps
        let v3p = new_phi_s_margin <= eps
        let v3o = new_phi_o_margin <= eps
        if !v1a { v1a_all = false }
        if !v1b { v1b_all = false }
        if !v2  { v2_all = false }
        if !v3p { v3_perm_all = false }
        if !v3o { v3_off_all = false }

        println("seed " + to_string(s) + " OLD: A=" + oa.to_string() + " B=" + ob.to_string()
            + " S=" + os.to_string() + " O=" + oo.to_string()
            + " | ΔΦ(S-A)=" + old_dphi_s.to_string() + " [V1a " + (if v1a {"PASS"} else {"FAIL"}) + "]")
        println("       NEW: A=" + na.to_string() + " B=" + nb.to_string()
            + " S=" + ns.to_string() + " O=" + no.to_string()
            + " | ΔΦ(B-A)=" + new_dphi_b.to_string() + " [V2 " + (if v2 {"PASS"} else {"FAIL"}) + "]"
            + " S-A=" + new_phi_s_margin.to_string() + " [V1b/V3p " + (if v1b {"PASS"} else {"FAIL"}) + "]"
            + " O-A=" + new_phi_o_margin.to_string() + " [V3o " + (if v3o {"PASS"} else {"FAIL"}) + "]")
        si = si + 1
    }
    let v1 = v1a_all && v1b_all
    let v3 = v3_perm_all && v3_off_all
    println("---")
    println("V1 CONFOUND-CONFIRM (V1a OLD-perm-raises ALL seeds AND V1b NEW-perm-collapses ALL seeds): "
        + (if v1 {"PASS"} else {"FAIL"}) + "  [V1a=" + (if v1a_all {"PASS"} else {"FAIL"})
        + " V1b=" + (if v1b_all {"PASS"} else {"FAIL"}) + "]")
    println("V2 ROBUST-LIFT (NEW Φ_B>=Φ_A+eps ALL seeds incl 1317): " + (if v2_all {"PASS"} else {"FAIL"}))
    println("V3 EARNED (NEW perm&offset both <=Φ_A+eps ALL seeds): " + (if v3 {"PASS"} else {"FAIL"})
        + "  [perm=" + (if v3_perm_all {"PASS"} else {"FAIL"}) + " off=" + (if v3_off_all {"PASS"} else {"FAIL"}) + "]")
    println("===")
    if v1 && v2_all && v3 {
        println("VERDICT 🟢 — the 4x Φ-robustness wall was the ESTIMATOR's amplitude-variance confound;")
        println("  a variance-free (rank-uniform) read-out makes faithful-IIT4 integration ROBUST. Follow-on: wire it.")
    } else {
        if v1 {
            println("VERDICT 🧱 (DEEPER) — confound REAL & removed (V1), but integration NOT robust under the clean")
            println("  estimator (V2/V3 fail) → estimator-INDEPENDENT substrate limit: the n<=8 substrate genuinely")
            println("  lacks robust integration. A STRONGER, cleaner closure than the prior 4x amplitude-confounded 🧱.")
        } else {
            println("VERDICT 🔶 — V1 FAILS: the variance-free encoding did NOT change the permutation behavior as")
            println("  predicted → the amplitude-variance diagnosis is WRONG; the 4x wall remains UNDIAGNOSED (report straight).")
        }
    }
}
