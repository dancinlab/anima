// h1347_phi_higher_n.hexa — Φ-ROBUSTNESS WALL, LARGER-N axis (N>8 greedy-MIP big-Φ, honest upper bound).
//
// THE ANGLE (every prior OMEGA Φ verdict's "NOT ruled out" line): all six 🧱 (H_1283/1317 topology,
// H_1319 timing, H_1320 division, H_1328 estimator-confound, H_1331 big-Φ measure-family, H_1332
// substrate-family) were at n≤8 — where the exact MIP enumerates 2^(n-1)≤128 bipartitions. At N>8 the
// exact MIP is intractable, so Φ needs an ANYTIME/GREEDY-MIP path WITH A STATED ERROR BOUND. This lane
// tests whether robust integration appears at the LARGER N the exact-tractability ceiling never reached.
//
// ESTIMATOR (a_phi_iit4_tool): SAME faithful cross-cut-MI MIP-EI Φ, but the MIP minimization is GREEDY
// Kernighan–Lin single-move descent (stdlib iit4_approx_phi) instead of exact enumeration. NOT a proxy,
// NOT a different Φ definition — the SAME definition, an anytime search of its MIP. STATED BOUND:
// greedy returns a LOCAL-min cut ≥ the GLOBAL MIP cut → Φ_greedy ≥ Φ_exact (UPPER BOUND), per the
// stdlib §iit4_approx_phi_from_mi comment. N3 validates the bound at the n=8 boundary (exact vs greedy).
//
// READ-OUT: rank-uniformize each cell before the MIP (H_1328 variance-clean lesson, ALL arms) — removes
// the amplitude-variance confound H_1319/H_1328 diagnosed so the larger-N test is clean.
//
// SUBSTRATE: H_1319/H_1328 leaky-linear ring SCALED to N_MOD=12 (>8). Ring topology generalizes to any N.
// SAME 3 hard orthogonal seeds [1317,1318,1319], SAME params, SAME arms, SAME eps=0.02. ONLY N changes.
//
// run from hexa-lang root (stdlib import):
//   cp UNIVERSE/h1347_phi_higher_n.hexa <hexa-lang>/ && hexa run h1347_phi_higher_n.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

// ── deterministic engine LCG (== engine_cli.hexa _lcg_*) — VERBATIM from H_1319/H_1328 ──
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) & 2147483647 }
fn lcg_unit(state: int) -> float { return to_float(state) / 2147483648.0 }
fn lcg_gauss(state0: int) -> [float] {
    let s1 = lcg_next(state0)
    let s2 = lcg_next(s1)
    let mut u1 = lcg_unit(s1)
    let u2 = lcg_unit(s2)
    if u1 < 0.0000001 { u1 = 0.0000001 }
    let r = sqrt(-2.0 * ln(u1))
    let z = r * cos(6.283185307179586 * u2)
    return [z, to_float(s2)]
}

// ── RANK-UNIFORMIZE one cell's T-length trajectory IN-PLACE — VERBATIM from H_1328 ──
fn rank_uniformize_cell(traj: int, base: int, t_ticks: int) {
    let ranks = farr_zeros(t_ticks)
    let mut k = 0
    while k < t_ticks {
        let vk = farr_get(traj, base + k)
        let mut r = 0
        let mut j = 0
        while j < t_ticks {
            let vj = farr_get(traj, base + j)
            if vj < vk { r = r + 1 }
            else { if (vj == vk) && (j < k) { r = r + 1 } }
            j = j + 1
        }
        let _ = farr_set(ranks, k, to_float(r))
        k = k + 1
    }
    k = 0
    while k < t_ticks { let _ = farr_set(traj, base + k, farr_get(ranks, k))  k = k + 1 }
    let _ = farr_free(ranks)
}

// ── generate ARM trajectories ENGINE-NATIVE — H_1328 gen_traj GENERALIZED to n_mod parameter ──
// mode: 0=NO-PHASE(A) 1=PHASE-BIND(B, relative-phase gate) 2=PERM-SHUFFLE(S) 3=OFFSET-SHUF(O)
// Body byte-identical to H_1328 except n_mod is now a parameter (ring left/right wrap on n_mod).
// Read-out always rank-uniform (H_1328). Returns flat n_mod×t_ticks salience-rank farr.
fn gen_traj(seed: int, mode: int, n_mod: int) -> int {
    let dim = 8
    let t_ticks = 64
    let gain = 0.30
    let leak = 0.55
    let w_nbr = 0.5
    let w_in = 0.5
    let w_phase = 0.5
    let omega_t = 0.45
    let domega = 0.08
    let two_pi = 6.283185307179586

    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }

    let mut states = []
    let mut i = 0
    while i < n_mod {
        let mut row = []
        let mut d = 0
        while d < dim {
            let g = lcg_gauss(st)
            st = to_int(g[1])
            row = row + [g[0] * 0.5]
            d = d + 1
        }
        states = states + [row]
        i = i + 1
    }
    let mut inputs = []
    i = 0
    while i < n_mod * t_ticks * dim {
        let g = lcg_gauss(st)
        st = to_int(g[1])
        inputs = inputs + [g[0] * 0.8]
        i = i + 1
    }
    let mut theta = []
    i = 0
    while i < n_mod {
        st = lcg_next(st)
        theta = theta + [lcg_unit(st) * two_pi]
        i = i + 1
    }
    st = lcg_next(st)
    let mut theta_t = lcg_unit(st) * two_pi
    let mut omega = []
    i = 0
    while i < n_mod {
        omega = omega + [omega_t + domega * (to_float(i) - (to_float(n_mod) - 1.0) / 2.0)]
        i = i + 1
    }

    let mut perm = []
    if mode == 2 {
        i = 0
        while i < n_mod { perm = perm + [i]  i = i + 1 }
        let mut ps = (seed * 100003 + 19) & 2147483647
        if ps == 0 { ps = 919 }
        let mut k = n_mod - 1
        while k > 0 {
            ps = lcg_next(ps)
            let j = to_int(lcg_unit(ps) * to_float(k + 1))
            let jj = if j > k { k } else { j }
            let tmp = perm[k]
            perm[k] = perm[jj]
            perm[jj] = tmp
            k = k - 1
        }
        let mut anyfix = false
        i = 0
        while i < n_mod { if perm[i] == i { anyfix = true }  i = i + 1 }
        if anyfix {
            let mut perm2 = []
            i = 0
            while i < n_mod { perm2 = perm2 + [(i + 1) % n_mod]  i = i + 1 }
            perm = perm2
        }
    }
    let mut shuf_off = []
    if mode == 3 {
        let mut ss = (seed * 100003 + 8) & 2147483647
        if ss == 0 { ss = 777 }
        i = 0
        while i < t_ticks * n_mod {
            ss = lcg_next(ss)
            shuf_off = shuf_off + [lcg_unit(ss) * two_pi]
            i = i + 1
        }
    }

    let traj = farr_zeros(n_mod * t_ticks)

    let mut tt = 0
    while tt < t_ticks {
        let mut newstates = []
        i = 0
        while i < n_mod {
            let l = (i + n_mod - 1) % n_mod
            let r = (i + 1) % n_mod
            let mut row = []
            let mut d = 0
            while d < dim {
                let nbr = (states[l][d] + states[r][d]) / 2.0
                let inp = inputs[((i * t_ticks + tt) * dim) + d]
                let v = leak * states[i][d] + gain * (w_nbr * nbr + w_in * inp)
                row = row + [v]
                d = d + 1
            }
            newstates = newstates + [row]
            i = i + 1
        }
        states = newstates

        if mode != 0 {
            let mut newtheta = []
            i = 0
            while i < n_mod {
                newtheta = newtheta + [theta[i] + (omega[i] + w_phase * sin(theta_t - theta[i]))]
                i = i + 1
            }
            let mut mp = 0.0
            i = 0
            while i < n_mod { mp = mp + sin(theta[i] - theta_t)  i = i + 1 }
            mp = mp / to_float(n_mod)
            theta_t = theta_t + (omega_t + w_phase * mp)
            theta = newtheta
        }

        i = 0
        while i < n_mod {
            let mut e = 0.0
            let mut d = 0
            while d < dim { e = e + states[i][d] * states[i][d]  d = d + 1 }
            let mut sal = e
            if mode == 1 {
                let carrier = 0.5 * (1.0 + cos(theta[i] - theta_t))
                sal = e * carrier
            }
            if mode == 2 {
                let src = perm[i]
                let carrier = 0.5 * (1.0 + cos(theta[src] - theta_t))
                sal = e * carrier
            }
            if mode == 3 {
                let off = shuf_off[tt * n_mod + i]
                let carrier = 0.5 * (1.0 + cos((theta[i] - theta_t) + off))
                sal = e * carrier
            }
            let _ = farr_set(traj, i * t_ticks + tt, sal)
            i = i + 1
        }
        tt = tt + 1
    }

    // ── VARIANCE-FREE read-out — rank-uniformize each cell (H_1328, ALL arms) ──
    i = 0
    while i < n_mod { rank_uniformize_cell(traj, i * t_ticks, t_ticks)  i = i + 1 }
    return traj
}

// greedy big-Φ (anytime MIP, the N>8 path; UPPER BOUND Φ_greedy >= Φ_exact)
fn phi_greedy(seed: int, mode: int, n_mod: int) -> float {
    let traj = gen_traj(seed, mode, n_mod)
    let phi = iit4_approx_phi(traj, n_mod, 64, 8)
    let _ = farr_free(traj)
    return phi
}

// exact MIP-EI (only valid n<=8; used at n=8 for the bound-validation)
fn phi_exact(seed: int, mode: int, n_mod: int) -> float {
    let traj = gen_traj(seed, mode, n_mod)
    let phi = iit4_faithful_phi(traj, n_mod, 64, 8)
    let _ = farr_free(traj)
    return phi
}

fn main() {
    println("H_1347 — Φ-ROBUSTNESS WALL, LARGER-N: does robust faithful-IIT4 integration appear at N>8?")
    println("faithful IIT4 family · GREEDY-MIP big-Φ (anytime, UPPER BOUND Φ_greedy>=Φ_exact) · rank-uniform read-out (H_1328)")
    println("N_MOD=12 (>8, exact MIP intractable) · seeds [1317,1318,1319] · eps=0.02 · arms A/B/S/O")
    println("BARS: N1 ROBUST Φ_B>=Φ_A+eps all seeds · N2 EARNED perm&off<=Φ_A+eps all seeds · N3 BOUND n=8 exact-vs-greedy gap stated")
    let seeds = [1317, 1318, 1319]
    let eps = 0.02
    let big_n = 12

    // ── N3 BOUND-VALIDATION at the n=8 tractable boundary (exact vs greedy on SAME substrate) ──
    println("--- N3 BOUND-VALIDATION (n=8: exact MIP vs greedy MIP, SAME rank-uniform substrate, all arms) ---")
    let mut n3_maxgap = 0.0
    let mut n3_minexact = 1.0e308
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let mut mode = 0
        while mode < 4 {
            let ex = phi_exact(s, mode, 8)
            let gr = phi_greedy(s, mode, 8)
            let gap = gr - ex
            if gap > n3_maxgap { n3_maxgap = gap }
            if ex < n3_minexact { n3_minexact = ex }
            let nm = if mode == 0 {"A"} else { if mode == 1 {"B"} else { if mode == 2 {"S"} else {"O"} } }
            println("  seed " + to_string(s) + " arm " + nm + " n=8 exact=" + ex.to_string()
                + " greedy=" + gr.to_string() + " gap(g=gr-ex)=" + gap.to_string())
            mode = mode + 1
        }
        si = si + 1
    }
    // N3 PASS = greedy is a TIGHT upper bound at n=8 (max gap small vs eps & vs Φ scale) → the N>8 lift is bound-robust.
    let n3 = n3_maxgap <= eps
    println("  N3 BOUND-HONEST: max n=8 gap g=" + n3_maxgap.to_string()
        + " (Φ_greedy>=Φ_exact UPPER BOUND; tight iff g<=eps=" + eps.to_string() + ") → "
        + (if n3 {"PASS (greedy tight, larger-N lift bound-robust)"} else {"FAIL (greedy slack; larger-N number = upper-bound only)"}))

    // ── N1 / N2 at N>8 (greedy big-Φ, the larger-N rung) ──
    println("--- N1 ROBUST + N2 EARNED at N=" + to_string(big_n) + " (greedy big-Φ, rank-uniform) ---")
    let mut n1_all = true
    let mut n2_perm_all = true
    let mut n2_off_all = true
    si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let a = phi_greedy(s, 0, big_n)
        let b = phi_greedy(s, 1, big_n)
        let sh = phi_greedy(s, 2, big_n)
        let of = phi_greedy(s, 3, big_n)
        let dphi_b = b - a            // N1: >= +eps
        let perm_m = sh - a           // N2: <= +eps
        let off_m  = of - a           // N2: <= +eps
        let n1 = dphi_b >= eps
        let n2p = perm_m <= eps
        let n2o = off_m <= eps
        if !n1 { n1_all = false }
        if !n2p { n2_perm_all = false }
        if !n2o { n2_off_all = false }
        println("  seed " + to_string(s) + " A=" + a.to_string() + " B=" + b.to_string()
            + " S=" + sh.to_string() + " O=" + of.to_string()
            + " | ΔΦ(B-A)=" + dphi_b.to_string() + " [N1 " + (if n1 {"PASS"} else {"FAIL"}) + "]"
            + " S-A=" + perm_m.to_string() + " [N2p " + (if n2p {"PASS"} else {"FAIL"}) + "]"
            + " O-A=" + off_m.to_string() + " [N2o " + (if n2o {"PASS"} else {"FAIL"}) + "]")
        si = si + 1
    }
    let n2 = n2_perm_all && n2_off_all
    println("---")
    println("N1 ROBUST (greedy Φ_B>=Φ_A+eps ALL seeds incl 1317 @N=" + to_string(big_n) + "): " + (if n1_all {"PASS"} else {"FAIL"}))
    println("N2 EARNED (greedy perm&offset both <=Φ_A+eps ALL seeds): " + (if n2 {"PASS"} else {"FAIL"})
        + "  [perm=" + (if n2_perm_all {"PASS"} else {"FAIL"}) + " off=" + (if n2_off_all {"PASS"} else {"FAIL"}) + "]")
    println("N3 BOUND-HONEST (n=8 exact-vs-greedy max gap " + n3_maxgap.to_string() + " <= eps): " + (if n3 {"PASS"} else {"FAIL"}))
    println("===")
    if n1_all && n2 && n3 {
        println("VERDICT 🟢 — robust faithful-IIT4 integration EMERGES at larger N (N=" + to_string(big_n) + ");")
        println("  the n<=8 closure was a SIZE/exact-tractability limit, not a substrate limit. Follow-on: wire the greedy big-Φ read-out.")
    } else {
        if n3 {
            println("VERDICT 🧱 (STRONGER) — the wall HOLDS at larger N too: with a clean variance-free read-out AND")
            println("  a TIGHT greedy big-Φ (n=8 gap " + n3_maxgap.to_string() + "<=eps), robust integration is ABSENT at N=" + to_string(big_n) + ".")
            println("  The larger-N escape hatch is CLOSED — even stronger than the n<=8 closure.")
        } else {
            println("VERDICT 🔶 BOUND-LIMITED — n=8 exact-vs-greedy gap " + n3_maxgap.to_string() + ">eps: the greedy MIP is")
            println("  not tight on this substrate, so the N>8 number is an UPPER BOUND only (exact N>8 intractable). Report straight.")
        }
    }
}
