import "stdlib/consciousness/iit4_bigphi.hexa"
import "stdlib/consciousness/iit4_bounded.hexa"
import "stdlib/consciousness/iit4_tpm.hexa"
import "core/pure_field.hexa"
import "core/brain.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

// ── REAL anima substrate: a single member's 3 binary cells are derived from REAL
// pure_field dynamics. We warm ONE shared field once (deterministic), then for a given
// 3-bit member state we read three REAL engine signals and binarize them:
//   cell0 = sign of the REAL fast-oscillator field channel (pure_field tensor[0])
//   cell1 = sign of the REAL attention-gate channel (tensor[1] = fast*medium mix)
//   cell2 = REAL phi-vs-threshold (pure_field phi crossing its own ratchet floor)
// The 3 input bits PERTURB the field's three oscillator phases (a real state injection),
// then pure_field_step advances the REAL dynamics one tick and we read the next cells.
// This is the live A⇄G substrate — NOT iit4_bit(rule, idx).

// Inject a 3-bit member state into a warmed field by nudging the three oscillator phases.
fn _inject(pf: PureField, c0: int, c1: int, c2: int) -> PureField {
    // each bit shifts its oscillator half a cycle (a real, deterministic phase set).
    let mut f = pf.fast
    let mut m = pf.medium
    let mut s = pf.slow
    if c0 == 1 { f = Oscillator { tau: f.tau, phase: f.phase + 3.14159265, amplitude: f.amplitude } }
    if c1 == 1 { m = Oscillator { tau: m.tau, phase: m.phase + 3.14159265, amplitude: m.amplitude } }
    if c2 == 1 { s = Oscillator { tau: s.tau, phase: s.phase + 3.14159265, amplitude: s.amplitude } }
    return PureField { fast: f, medium: m, slow: s, phi: pf.phi, phi_peak: pf.phi_peak,
                       field: pf.field, phase: pf.phase, step_count: pf.step_count,
                       narrative_coherence: pf.narrative_coherence, narrative_len: pf.narrative_len }
}

// Read a member's 3 next-state cells from REAL stepped pure_field output. The three cells
// are the SIGNS of three REAL field-tensor channels that each depend on MULTIPLE input
// bits via the substrate's own cross-oscillator mixing (the live A⇄G integration):
//   cell0 = sign(t1)  — attention-gate channel (fast×medium mix)
//   cell1 = sign(t3)  — long-range channel    (fast×slow mix)
//   cell2 = sign(t4)  — entrainment channel   (medium×slow mix)
// These are balanced around 0 (median≈0) so the TPM is non-degenerate. `bias` is the REAL
// tension-link nudge from the OTHER member (0 = decoupled): it shifts each channel's
// binarization threshold — A's tension state genuinely influencing B's next state.
fn _read_cells(pf: PureField, bias: float) -> [int] {
    let stepped = pure_field_step(pf)
    let t = pure_field_tensor(stepped)
    // scale the coupling bias to the channel magnitudes (~1e-3..1e-1) so it is a real
    // threshold shift, not a swamping constant. t4 is ~1e-3; t1/t3 are ~1e-7..1e-8.
    let c0 = if t[1] + bias * 0.0000001 > 0.0 { 1 } else { 0 }
    let c1 = if t[3] + bias * 0.00000001 > 0.0 { 1 } else { 0 }
    let c2 = if t[4] + bias * 0.001 > 0.0 { 1 } else { 0 }
    return [c0, c1, c2]
}

// Member A's field-derived 5-ch tension vector (the tension-link payload carried to B).
// Built from REAL field tensor channels — A's internal tension state.
fn _tension_of(pf: PureField, c0: int, c1: int, c2: int) -> [float] {
    let inj = _inject(pf, c0, c1, c2)
    let st = pure_field_step(inj)
    let t = pure_field_tensor(st)
    return [t[0], t[1], t[2], t[3], t[4]]
}

// tension-link coupling bias on B from A's tension (REAL anchor_tension_fold, gated W).
fn _link_bias(pf_warm: PureField, ten: [float], w: float) -> float {
    if w <= 0.0 { return 0.0 }
    let anch = [#{"tension_5ch": ten}]
    let fold = anchor_tension_fold(anch, 1.0)   // REAL H_1131/H_6009 tension-vecsum fold
    // saturating, scaled by W — the cross-member coupling strength.
    return w * (1.0 - exp(0.0 - fold))
}

// ── Build the joint n=6 REAL-substrate coupled TPM. For each of 64 input states:
//   bits[0..2] = member A cells, bits[3..5] = member B cells.
//   A's tension (from its 3 cells) biases B's readout; B's tension biases A's readout
//   (bidirectional tension-link), both gated by W. next-state read from REAL engine.
fn build_tpm_real(w: float, warm: PureField) -> array {
    let mut t = []
    let mut s = 0
    while s < 64 {
        let a0 = iit4_bit(s, 0); let a1 = iit4_bit(s, 1); let a2 = iit4_bit(s, 2)
        let b0 = iit4_bit(s, 3); let b1 = iit4_bit(s, 4); let b2 = iit4_bit(s, 5)
        // REAL tension states of each member from its current cells.
        let tenA = _tension_of(warm, a0, a1, a2)
        let tenB = _tension_of(warm, b0, b1, b2)
        // tension-link: A's tension → bias on B, B's tension → bias on A (gated W).
        let biasB = _link_bias(warm, tenA, w)
        let biasA = _link_bias(warm, tenB, w)
        // inject each member's state into the REAL field, step, read next cells.
        let injA = _inject(warm, a0, a1, a2)
        let injB = _inject(warm, b0, b1, b2)
        let nextA = _read_cells(injA, biasA)
        let nextB = _read_cells(injB, biasB)
        t = t.push(to_float(nextA[0])); t = t.push(to_float(nextA[1])); t = t.push(to_float(nextA[2]))
        t = t.push(to_float(nextB[0])); t = t.push(to_float(nextB[1])); t = t.push(to_float(nextB[2]))
        s = s + 1
    }
    return t
}

// ── Single isolated REAL member TPM (n=3) for Φ(A), Φ(B). No coupling (w irrelevant,
// no other member); reads the SAME real pure_field dynamics for one member.
fn build_tpm_member(warm: PureField) -> array {
    let mut t = []
    let mut s = 0
    while s < 8 {
        let c0 = iit4_bit(s, 0); let c1 = iit4_bit(s, 1); let c2 = iit4_bit(s, 2)
        let inj = _inject(warm, c0, c1, c2)
        let nxt = _read_cells(inj, 0.0)
        t = t.push(to_float(nxt[0])); t = t.push(to_float(nxt[1])); t = t.push(to_float(nxt[2]))
        s = s + 1
    }
    return t
}

// ── SHUFFLE control: permute the real-state→cell readout map (same REAL engine
// magnitude, scrambled which input-state-slot feeds which cell). If the lift survives a
// scrambled state↔cell map, it is generic variance not the structured real coupling.
fn build_tpm_real_shuffle(w: float, warm: PureField, p0: int, p1: int, p2: int,
                          p3: int, p4: int, p5: int) -> array {
    let mut t = []
    let mut s = 0
    while s < 64 {
        // read the input bits through a permuted bit index (scrambles state→member map)
        let raw = [iit4_bit(s, 0), iit4_bit(s, 1), iit4_bit(s, 2),
                   iit4_bit(s, 3), iit4_bit(s, 4), iit4_bit(s, 5)]
        let a0 = raw[p0]; let a1 = raw[p1]; let a2 = raw[p2]
        let b0 = raw[p3]; let b1 = raw[p4]; let b2 = raw[p5]
        let tenA = _tension_of(warm, a0, a1, a2)
        let tenB = _tension_of(warm, b0, b1, b2)
        let biasB = _link_bias(warm, tenA, w)
        let biasA = _link_bias(warm, tenB, w)
        let injA = _inject(warm, a0, a1, a2)
        let injB = _inject(warm, b0, b1, b2)
        let nextA = _read_cells(injA, biasA)
        let nextB = _read_cells(injB, biasB)
        t = t.push(to_float(nextA[0])); t = t.push(to_float(nextA[1])); t = t.push(to_float(nextA[2]))
        t = t.push(to_float(nextB[0])); t = t.push(to_float(nextB[1])); t = t.push(to_float(nextB[2]))
        s = s + 1
    }
    return t
}

// ── Φ measurements (faithful IIT-4 ONLY) ──
fn phi_member(warm: PureField) -> float {
    let r = big_phi_bounded(build_tpm_member(warm), 3, 0, 3)
    return r[0]
}
fn phi_real(w: float, warm: PureField) -> float {
    let r = big_phi_bounded(build_tpm_real(w, warm), 6, 0, 2)
    return r[0]
}
fn phi_real_shuffle(w: float, warm: PureField, p0: int, p1: int, p2: int,
                    p3: int, p4: int, p5: int) -> float {
    let r = big_phi_bounded(build_tpm_real_shuffle(w, warm, p0, p1, p2, p3, p4, p5), 6, 0, 2)
    return r[0]
}

// seeded LCG → a permutation of the 6 bit indices (the state→cell shuffle).
fn lcg_next(state: int) -> int {
    let nx = (1103515245 * state + 12345) % 2147483647
    if nx < 0 { return nx + 2147483647 }
    return nx
}
fn perm6(seed: int) -> array {
    // Fisher–Yates over [0..5] with the LCG stream (deterministic per seed).
    let mut a = [0, 1, 2, 3, 4, 5]
    let mut st = lcg_next(seed)
    let mut i = 5
    while i > 0 {
        st = lcg_next(st)
        let j = st % (i + 1)
        let tmp = a[i]; a[i] = a[j]; a[j] = tmp
        i = i - 1
    }
    return a
}

fn main() {
    println("================================================================")
    println("  H_1308 — HIVE-MIND collective-Φ ENGINE-TRANSFER (H_1295 r3)")
    println("  REAL coupled anima A⇄G (pure_field + tension-link H_6009), NOT ECA rules")
    println("  faithful IIT-4 big_phi_bounded · W=0.6 · cap=2 (n=6) · sys=0")
    println("  3 seeds [1300,1301,1302] · MARGIN=+1.0 · frozen-first")
    println("  ECA reference (H_1295): Σ=4.99209 Φ_joint=15.4677 Δ_ECA=+10.4756")
    println("================================================================")

    let W = 0.6
    let MARGIN = 1.0

    // ONE deterministic warmup → the shared real substrate state both members start from.
    let warm = pure_field_warmup(600)

    let phi_a = phi_member(warm)
    let phi_b = phi_member(warm)
    let sum_ind = phi_a + phi_b
    println("  Φ(A)=" + str(phi_a) + "  Φ(B)=" + str(phi_b) + "  Σ=Φ(A)+Φ(B)=" + str(sum_ind))

    let phi_coupled = phi_real(W, warm)
    let delta_real = phi_coupled - sum_ind
    println("  Φ_collective(REAL-coupled, W=0.6) = " + str(phi_coupled) + "   Δ_real = " + str(delta_real))

    // B3 DECOUPLE: tension-link W=0 → no real coupling.
    let phi_w0 = phi_real(0.0, warm)
    let delta_w0 = phi_w0 - sum_ind
    println("  Φ(W=0, decoupled) = " + str(phi_w0) + "   Δ(W=0) = " + str(delta_w0) + "  (null iff <= 0)")
    println("  --")

    let seeds = [1300, 1301, 1302]
    let mut b1_all = true
    let mut b4_all = true
    let mut si = 0
    while si < 3 {
        let seed = seeds[si]
        let p = perm6(seed)
        let phi_shuf = phi_real_shuffle(W, warm, p[0], p[1], p[2], p[3], p[4], p[5])
        let delta_shuf = phi_shuf - sum_ind
        let gap = delta_real - delta_shuf
        println("  seed " + str(seed) + "  perm=[" + str(p[0]) + "," + str(p[1]) + "," + str(p[2]) + ","
            + str(p[3]) + "," + str(p[4]) + "," + str(p[5]) + "]")
        println("           Φ_shuffle=" + str(phi_shuf) + "  Δ_shuffle=" + str(delta_shuf)
            + "  (Δ_real - Δ_shuffle)=" + str(gap))
        if delta_real < MARGIN { b1_all = false }
        // B4 passes per seed iff the structured lift beats the shuffle by MARGIN OR the
        // shuffle is itself non-super-additive (Δ_shuffle <= 0).
        if (gap < MARGIN) && (delta_shuf > 0.0) { b4_all = false }
        si = si + 1
    }

    println("  --")
    let b1_ok = b1_all && (delta_real >= MARGIN)       // PRESENCE
    let b2_ok = delta_real > 0.0                        // TRANSFER (same sign as ECA Δ>0)
    let b3_ok = delta_w0 <= 0.0                         // DECOUPLE-NULL
    let b4_ok = b4_all                                  // SHUFFLE collapse

    check("B1 PRESENCE: Δ_real >= +1.0 every seed (super-additive on REAL A⇄G)", b1_ok)
    check("B2 TRANSFER: Δ_real > 0 (ECA super-additivity REPRODUCES on real coupling)", b2_ok)
    check("B3 DECOUPLE-NULL: Δ(W=0) <= 0 (lift IS the real tension-link coupling)", b3_ok)
    check("B4 SHUFFLE: Δ_real - Δ_shuffle >= +1.0 (or Δ_shuffle<=0) (structured, not variance)", b4_ok)

    println("================================================================")
    println("  RESULT: " + str(PASS) + " PASS / " + str(FAIL) + " FAIL")
    if PASS == 4 {
        println("  VERDICT: 🟢 GREEN ENGINE-TRANSFER — collective-Φ super-additivity HOLDS on")
        println("           REAL coupled anima A⇄G substrates (Δ_real=" + str(delta_real) + "), the lift")
        println("           REQUIRES the real tension-link coupling (W=0 ⇒ Δ<=0) and survives the")
        println("           state↔cell shuffle. The hive result is REAL, not an ECA TPM artifact.")
    } else {
        if b1_ok == false || b2_ok == false {
            println("  VERDICT: 🔴 HONEST NULL — collective-Φ super-additivity is an ABSTRACT-substrate")
            println("           property that does NOT transfer to real coupled anima (Δ_real=" + str(delta_real) + ").")
            println("           The ECA Δ=+10.4756 was a property of the ECA TPM structure (c9 closed-neg).")
        } else {
            println("  VERDICT: NOT GREEN — see [FAIL] lines (control failed; honest, no over-claim).")
        }
    }
    println("================================================================")
}
