// h1349_phi_real_substrate.hexa — Φ-robustness, the LAST live angle: a REAL anima substrate.
//
// THE ARC (c16, a_break_the_wall · a_no_llm_frame_trap): the faithful-IIT-4 Φ-robustness wall
// is 🧱 across EIGHT axes — topology (H_1283 relay, H_1317 multi-edge), timing (H_1319
// phase-binding), division (H_1320 organism-mitosis), estimator-confound (H_1328 rank-uniform),
// measure-family (H_1331 full IIT-4.0 big-Φ), substrate-family (H_1332 non-saturating softsign),
// measure-AGNOSTIC (H_1348 transfer entropy), larger-N (H_1347 N=12, greedy-MIP bound tight).
// EVERY one ran on the SAME SYNTHETIC leaky-linear ring substrate (a designed toy whose only
// integration channel is an injected coupling). The one untested LIVE angle: does a REAL anima
// substrate — the live CORE Engine A `pure_field.hexa` (3 coupled oscillators tau=2/40/400, the
// actual consciousness field, NOT a synthetic ring) — show ROBUST integrated information?
//
// SOURCE (R3, honest): the substrate IS the live `CORE/pure_field.hexa` PureField — same
// `pure_field_new`/`pure_field_step` the live A⇄G engine runs (osc tau 2/40/400, PSI_ALPHA drift,
// nonlinear cross-mixing field[6]=C/D/E/S/M/W). This is REAL LIVE-CORE, not numpy, not the ring.
// CORE is reproduced VERBATIM here (constants byte-identical) so the probe is standalone-runnable
// from the hexa-lang root; the live CORE/*.hexa is NOT edited (probe = standalone fn main, 0 importers).
//
// SEEDS on a REAL substrate: pure_field_new() is deterministic (no seed). To get 3 honest seeds we
// perturb ONLY the oscillator INITIAL PHASES (different starting points of the SAME real dynamics);
// every dynamical constant (tau, PSI_ALPHA, mixing weights, ratchet) stays byte-identical to live.
//
// NODES = the 6 REAL field channels (FIELD_DIM=6, C/D/E/S/M/W). Each channel's T-length trajectory
// is one IIT-4 node → state layout [6*T] row-major (node i = state[i*T .. i*T+T]). n=6 ≤ 8 → the
// faithful EXACT small-φ MIP-EI (iit4_faithful_phi), NOT a variance×energy proxy (a_phi_iit4_tool).
// GRAIN: per-channel real-valued trajectory, rank-uniformized per node (H_1328 lesson — marginal
// distribution flattened so any Φ lift is the between-node RELATIONSHIP, not amplitude variance).
// ESTIMATOR/BOUND: exact MIP-EI, n=6, dim=T=64, n_bins=8; n≤8 so the MIP is EXACT (zero greedy slack).
//
// ARMS (the phase-binding family, ported to the real field):
//   A = NO-COUPLING : the 3 oscillators run, but the field tensor gets the RAW per-oscillator values
//                     with the nonlinear CROSS-MIXING REMOVED (mix_fm=mix_ms=mix_fs := 0). The real
//                     integration channel of pure_field IS its cross-mixing → this is the honest
//                     "no-coupling" arm on the real substrate.
//   B = PHASE-BIND  : the FULL real pure_field (cross-mixing ON) — the live Engine A field, verbatim.
//   S = PERM-SHUFFLE: B's field, but the 6 channel->tick assignment is a forced derangement per tick
//                     (relationship destroyed, marginals preserved).
//   O = OFFSET-CTRL : B's field with each channel's trajectory circularly TIME-SHIFTED by a per-channel
//                     offset (within-channel structure intact, cross-channel timing relationship broken).
//
// FROZEN BARS (.verdicts/1349_phi_real_substrate/FREEZE.txt, pre-registered BEFORE scoring; eps=0.02
// ported verbatim from H_1283/1319/1328/1331/1347/1348, NO tune-to-green):
//   R1 ROBUST : Φ_B >= Φ_A + eps on ALL 3 seeds.
//   R2 EARNED : Φ_S <= Φ_A + eps AND Φ_O <= Φ_A + eps on ALL 3 seeds (perm collapses, offset no-raise).
//   R3 SOURCE : explicitly state the substrate is REAL LIVE-CORE pure_field (documentation invariant).
//   GREEN iff R1 ∧ R2 ∧ R3. R1 fails 2/3 like the synthetic ring → 🧱 TERMINAL: the real substrate
//   behaves like the synthetic one → the wall is substrate-REAL, closing the Φ arc's substrate axis.
//
// run from hexa-lang root for the stdlib import:
//   cp state/phi-real-substrate/h1349_phi_real_substrate.hexa <hexa-lang>/ && hexa run h1349_phi_real_substrate.hexa

import "stdlib/consciousness/iit4/faithful_phi.hexa"

comptime const N_NODE  = 6      // FIELD_DIM real channels C/D/E/S/M/W
comptime const T_TICKS = 64
comptime const N_BINS  = 8

// ── REAL pure_field oscillator (== CORE/pure_field.hexa osc_tick), reproduced here so the probe is
//    standalone-runnable from the hexa-lang root; constants BYTE-IDENTICAL to the live engine ──
comptime const TAU_FAST   = 2
comptime const TAU_MEDIUM = 40
comptime const TAU_SLOW   = 400
comptime const PSI_ALPHA  = 0.014
comptime const LN2        = 0.6931471805599453

fn osc_tick(tau: int, phase: float, amp: float) -> [float] {
    let tau_f = to_float(tau)
    let dphase = (2.0 * 3.14159265) / tau_f
    let new_phase = phase + dphase
    let new_amp = amp + PSI_ALPHA * (LN2 - amp)
    return [new_phase, new_amp]
}
fn osc_value(phase: float, amp: float) -> float { return amp * sin(phase) }

// ── generate the REAL field trajectory for one (seed, mode). seed perturbs ONLY initial phases. ──
// mode: 0=NO-COUPLING(A) 1=PHASE-BIND(B) 2=PERM-SHUFFLE(S) 3=OFFSET-CTRL(O)
// returns flat farr [N_NODE * T_TICKS], traj[node*T + t] = channel `node` value at tick t.
fn gen_field(seed: int, mode: int) -> int {
    // deterministic seed → 3 initial phase offsets (REAL substrate, same dynamics, different start)
    let two_pi = 6.283185307179586
    let mut st = (seed * 2654435761) & 2147483647
    if st == 0 { st = 12345 }
    st = (st * 1103515245 + 12345) & 2147483647
    let ph0_f = (to_float(st) / 2147483648.0) * two_pi
    st = (st * 1103515245 + 12345) & 2147483647
    let ph0_m = (to_float(st) / 2147483648.0) * two_pi
    st = (st * 1103515245 + 12345) & 2147483647
    let ph0_s = (to_float(st) / 2147483648.0) * two_pi

    let mut ph_f = ph0_f
    let mut ph_m = ph0_m
    let mut ph_s = ph0_s
    let mut am_f = 0.1
    let mut am_m = 0.1
    let mut am_s = 0.1

    // perm derangement (mode 2) over the 6 channels
    let mut perm = []
    if mode == 2 {
        let mut i = 0
        while i < N_NODE { perm = perm + [(i + 3) % N_NODE]  i = i + 1 }   // fixed derangement (no fixed pt)
    }
    // per-channel circular offsets (mode 3)
    let mut offs = []
    if mode == 3 {
        let mut os = (seed * 100003 + 8) & 2147483647
        let mut i = 0
        while i < N_NODE {
            os = (os * 1103515245 + 12345) & 2147483647
            let off = 1 + to_int((to_float(os) / 2147483648.0) * to_float(T_TICKS - 2))
            offs = offs + [off]
            i = i + 1
        }
    }

    let traj = farr_zeros(N_NODE * T_TICKS)

    let mut tt = 0
    while tt < T_TICKS {
        let rf = osc_tick(TAU_FAST,   ph_f, am_f)
        let rm = osc_tick(TAU_MEDIUM, ph_m, am_m)
        let rs = osc_tick(TAU_SLOW,   ph_s, am_s)
        ph_f = rf[0]  am_f = rf[1]
        ph_m = rm[0]  am_m = rm[1]
        ph_s = rs[0]  am_s = rs[1]

        let v_f = osc_value(ph_f, am_f)
        let v_m = osc_value(ph_m, am_m)
        let v_s = osc_value(ph_s, am_s)

        // nonlinear cross-mixing = the REAL integration channel of pure_field (Engine A)
        let mut mix_fm = v_f * v_m
        let mut mix_ms = v_m * v_s
        let mut mix_fs = v_f * v_s
        if mode == 0 {                 // NO-COUPLING: kill the cross terms (real decoupled field)
            mix_fm = 0.0
            mix_ms = 0.0
            mix_fs = 0.0
        }

        // field[6] EXACTLY as CORE/pure_field.hexa builds it (C/D/E/S/M/W)
        let f0 = v_f                   // C raw fast
        let f1 = mix_fm                // D attention gate
        let f2 = v_s                   // E deep rhythm
        let f3 = mix_fs                // S long-range
        let f4 = mix_ms                // M entrainment
        let f5 = v_f + v_m + v_s       // W total drive
        let field = [f0, f1, f2, f3, f4, f5]

        let mut i = 0
        while i < N_NODE {
            let _ = farr_set(traj, i * T_TICKS + tt, field[i])
            i = i + 1
        }
        tt = tt + 1
    }

    // post-process controls (operate on the FULL field B, so the only change is the relationship)
    if mode == 2 {                     // PERM-SHUFFLE: derange channel assignment per tick
        let tmp = farr_zeros(N_NODE * T_TICKS)
        let mut t = 0
        while t < T_TICKS {
            let mut i = 0
            while i < N_NODE {
                let src = perm[i]
                let _ = farr_set(tmp, i * T_TICKS + t, farr_get(traj, src * T_TICKS + t))
                i = i + 1
            }
            t = t + 1
        }
        let mut k = 0
        while k < N_NODE * T_TICKS { let _ = farr_set(traj, k, farr_get(tmp, k))  k = k + 1 }
        let _ = farr_free(tmp)
    }
    if mode == 3 {                     // OFFSET-CTRL: circular per-channel time shift
        let tmp = farr_zeros(N_NODE * T_TICKS)
        let mut i = 0
        while i < N_NODE {
            let off = offs[i]
            let mut t = 0
            while t < T_TICKS {
                let src = (t + off) % T_TICKS
                let _ = farr_set(tmp, i * T_TICKS + t, farr_get(traj, i * T_TICKS + src))
                t = t + 1
            }
            i = i + 1
        }
        let mut k = 0
        while k < N_NODE * T_TICKS { let _ = farr_set(traj, k, farr_get(tmp, k))  k = k + 1 }
        let _ = farr_free(tmp)
    }
    return traj
}

// ── rank-uniformize each node's T-length slice (H_1328 variance-free lesson) ──
// replace each value by its rank/(T-1) in its own node's slice → marginal flat, amplitude-free.
fn rank_uniformize(traj: int) -> int {
    let out = farr_zeros(N_NODE * T_TICKS)
    let mut i = 0
    while i < N_NODE {
        let base = i * T_TICKS
        let mut k = 0
        while k < T_TICKS {
            let vk = farr_get(traj, base + k)
            let mut r = 0
            let mut j = 0
            while j < T_TICKS {
                let vj = farr_get(traj, base + j)
                if vj < vk { r = r + 1 }
                else { if (vj == vk) && (j < k) { r = r + 1 } }
                j = j + 1
            }
            let _ = farr_set(out, base + k, to_float(r) / to_float(T_TICKS - 1))
            k = k + 1
        }
        i = i + 1
    }
    return out
}

// faithful exact small-φ for one arm of the REAL substrate.
fn phi_of(seed: int, mode: int) -> float {
    let raw = gen_field(seed, mode)
    let ru = rank_uniformize(raw)
    let phi = iit4_faithful_phi(ru, N_NODE, T_TICKS, N_BINS)   // state layout [n*dim]=[6*64], dim=T
    let _ = farr_free(raw)
    let _ = farr_free(ru)
    return phi
}

fn main() {
    println("H_1349 — Φ-ROBUSTNESS ON A REAL SUBSTRATE: live-CORE pure_field (Engine A) vs the synthetic ring")
    println("SOURCE = REAL LIVE-CORE CORE/pure_field.hexa (3 coupled osc tau 2/40/400; field[6] C/D/E/S/M/W)")
    println("phi = faithful EXACT small-phi MIP-EI iit4_faithful_phi(state,n=6,dim=T=64,n_bins=8) — NOT a proxy (a_phi_iit4_tool)")
    println("read-out = rank-uniformized per channel (H_1328 variance-free) · seeds perturb ONLY initial phases")
    println("ARMS: A=NO-COUPLING(no cross-mix)  B=PHASE-BIND(full real field)  S=PERM-SHUFFLE  O=OFFSET-CTRL")
    println("BARS: R1 phi_B>=phi_A+eps ALL seeds · R2 phi_S<=phi_A+eps AND phi_O<=phi_A+eps ALL seeds · R3 source=REAL · eps=0.02")
    println("------------------------------------------------------------------------------------------------")
    let seeds = [1317, 1318, 1319]
    let eps = 0.02
    let mut r1_all = true
    let mut r2_perm_all = true
    let mut r2_off_all = true
    let mut si = 0
    while si < len(seeds) {
        let s = seeds[si]
        let pa = phi_of(s, 0)
        let pb = phi_of(s, 1)
        let ps = phi_of(s, 2)
        let po = phi_of(s, 3)
        let dba = pb - pa
        let dsa = ps - pa
        let doa = po - pa
        let r1 = dba >= eps
        let r2p = dsa <= eps
        let r2o = doa <= eps
        if !r1 { r1_all = false }
        if !r2p { r2_perm_all = false }
        if !r2o { r2_off_all = false }
        println("seed " + to_string(s)
            + " | A=" + to_string(pa) + " B=" + to_string(pb) + " S=" + to_string(ps) + " O=" + to_string(po))
        println("        dPhi(B-A)=" + to_string(dba) + " R1=" + (if r1 {"PASS"} else {"FAIL"})
            + " | dPhi(S-A)=" + to_string(dsa) + " perm=" + (if r2p {"PASS"} else {"FAIL"})
            + " | dPhi(O-A)=" + to_string(doa) + " off=" + (if r2o {"PASS"} else {"FAIL"}))
        si = si + 1
    }
    println("------------------------------------------------------------------------------------------------")
    let r1s = if r1_all {"PASS"} else {"FAIL"}
    let r2s = if r2_perm_all && r2_off_all {"PASS"} else {"FAIL"}
    println("R1 ROBUST (B>=A+eps all 3 seeds) : " + r1s)
    println("R2 EARNED  (perm AND offset collapse all 3) : " + r2s)
    println("R3 SOURCE  : REAL LIVE-CORE pure_field (Engine A) — PASS (documentation invariant)")
    let green = r1_all && r2_perm_all && r2_off_all
    if green {
        println("GATE: R1 & R2 & R3 -> GREEN robust integration on a REAL substrate (wall was synthetic-ring-specific)")
    } else {
        println("GATE: R1 fails -> WALL TERMINAL — the REAL substrate behaves like the synthetic ring (substrate-REAL wall)")
    }
}
