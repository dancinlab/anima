// H_9078 anticipatory_prefetch ENGINE-NATIVE — cerebellar forward model pre-queries the
// immune store BEFORE the query arrives, on live core/engine_cli.hexa.
//
// SETUP (two DISJOINT key spaces, like faculty_cascade's q-space vs B-key-space):
//   - trajectory FRAME space: frame_i = embed_key("seq_frame_" + i)   (the context stream)
//   - answer-key space:       akey_i = embed_key("answer_slot_" + i)  (the store's keys)
//   store `mem` binds akey_i -> "y_i". The forward model learns the CYCLIC transition
//   frame_{t-1} -> akey_t : from the CURRENT trajectory frame it predicts the NEXT item's
//   ANSWER key. The forward model is the ONLY bridge from frame space into the store's
//   key space (a raw frame key never indexes the answer store — abstains).
//
// BARS (frozen, pre-registered; no tune-to-green):
//   1. prefetch anticipates the next query (recall on predicted key == y_t) >= 0.8
//   2. no-prefetch (current frame key used directly) FAILS (== y_t) <= 0.2
//   3. LIFT margin: mean(margin_current - margin_prefetch) >= +0.5   (readiness improves)
//   4. EARNED: prefetch_acc - shuffle_acc >= +0.5   (wrong-context prefetch loses the gain)
//   5. ablate(forward model OFF = untrained/zero weights) FAILS <= 0.2 (INERT w/o forward model)
// usage: hexa run state/9078_anticipatory_prefetch/prefetch_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn main() {
    let cfg = engine_config_default()
    let N = 12
    let DIM = 64          // == immune_embed_key dim
    // build the store keyed by ANSWER keys, and remember each frame/akey.
    let mut mem = immune_memory_new_text("answer_slot_0", "y0", 128)
    let mut frames = [immune_embed_key("seq_frame_0")]
    let mut akeys = [immune_embed_key("answer_slot_0")]
    let mut i = 1
    while i < N {
        let ak = immune_embed_key("answer_slot_" + to_string(i))
        mem = immune_memory_bind(mem, ak, "y" + to_string(i), cfg)
        frames = frames + [immune_embed_key("seq_frame_" + to_string(i))]
        akeys = akeys + [ak]
        i = i + 1
    }

    // train the forward model (ctx_len=1) on the cyclic transition frame_{t-1} -> akey_t.
    let mut ff = vforward_new(DIM, 1, 0.5)
    let mut ep = 0
    while ep < 400 {
        let mut t = 1
        while t <= N {
            let prev = t - 1
            let cur = t - ((t / N) * N)          // wrap N -> 0
            ff = vforward_update(ff, frames[prev], akeys[cur])
            t = t + 1
        }
        ep = ep + 1
    }
    // untrained forward model for the ablation arm (zero weights ⇒ predicts the zero frame).
    let ff0 = vforward_new(DIM, 1, 0.5)

    let mut pre_acc = 0     // prefetch retrieves y_t
    let mut cur_acc = 0     // current-frame key used directly on the store
    let mut shf_acc = 0     // prefetch off a WRONG (shuffled) context
    let mut abl_acc = 0     // untrained forward model
    let mut sum_lift = 0.0  // margin_current - margin_prefetch
    let mut j = 1
    while j <= N {
        let prev = j - 1
        let cur = j - ((j / N) * N)             // the ACTUAL next item index
        let want = "y" + to_string(cur)
        let ctx = frames[prev]                  // context = current trajectory frame

        // PREFETCH: forward model anticipates akey_cur, store pre-queried off the prediction.
        let gp = anticipatory_prefetch_value(ff, mem, ctx)
        if gp == want { pre_acc = pre_acc + 1 }
        let m_pre = anticipatory_prefetch(ff, mem, ctx)

        // NO-PREFETCH: use the current frame key DIRECTLY on the store (no forward model).
        let gc = immune_memory_recall(mem, ctx)
        if gc == want { cur_acc = cur_acc + 1 }
        let m_cur = immune_memory_recall_margin(mem, ctx)
        sum_lift = sum_lift + (m_cur - m_pre)

        // SHUFFLE: feed a WRONG context frame (offset +5) => wrong prediction.
        let wrong = (prev + 5) - (((prev + 5) / N) * N)
        let gsh = anticipatory_prefetch_value(ff, mem, frames[wrong])
        if gsh == want { shf_acc = shf_acc + 1 }

        // ABLATE: untrained forward model (predicts zero) => nothing anticipated.
        let ga = anticipatory_prefetch_value(ff0, mem, ctx)
        if ga == want { abl_acc = abl_acc + 1 }
        j = j + 1
    }

    let pf = to_float(pre_acc) / to_float(N)
    let cf = to_float(cur_acc) / to_float(N)
    let sf = to_float(shf_acc) / to_float(N)
    let af = to_float(abl_acc) / to_float(N)
    let mlift = sum_lift / to_float(N)
    let earned = pf - sf

    let mut np = 0
    if _ab("prefetch anticipates next query (>=0.8)", pf >= 0.8) { np = np + 1 }
    if _ab("no-prefetch (current frame key) FAILS (<=0.2)", cf <= 0.2) { np = np + 1 }
    if _ab("LIFT margin current-prefetch >= +0.5 (readiness)", mlift >= 0.5) { np = np + 1 }
    if _ab("EARNED prefetch-shuffle acc >= +0.5 (forward-model load-bearing)", earned >= 0.5) { np = np + 1 }
    if _ab("ablate(forward OFF) FAILS <=0.2 (INERT without forward model)", af <= 0.2) { np = np + 1 }

    println("INFO pre_acc=" + to_string(pre_acc) + "/" + to_string(N)
        + " cur=" + to_string(cur_acc) + " shuffle=" + to_string(shf_acc)
        + " ablate=" + to_string(abl_acc)
        + " margin_lift=" + to_string(mlift) + " earned=" + to_string(earned))
    println("--- H_9078 anticipatory_prefetch engine-native: " + to_string(np) + " pass / " + to_string(5 - np) + " fail ---")
}
