// ag_conflict_monitor.hexa — substrate gap #3 (A⇄G conflict monitor) OP SKELETON + PROVENANCE.
//
// ⚠️ IMPORTANT FINDING (reference-match, 2026-07-03): the ag_conflict MONITOR op the substrate-gaps
// analysis proposed (`ag_conflict(a_drive,g_drive) = |a_drive - g_drive|`) ALREADY EXISTS in the
// live engine as **`conflict_scalar`** (core/engine_cli.hexa:8450), and is STRICTLY BETTER than the
// proposed |a-b|:
//   · conflict_scalar = both-strong-opposite-sign gate: 0 unless signs OPPOSE, else clip01(|a|*|b|).
//     A single-engine state (one drive ≈0) ⇒ 0 (no competition) — |a-b| would spuriously fire there.
//   · it SHIPS with its own parent-control `conflict_net_tension = |a+g|` (the Ψ / emit-drive analog),
//     which reads the SAME value for a high-conflict (+x,−x) and a low-drive (+e,−e) state — the
//     load-bearing dissociation the analysis asked a "shuffle control" to provide, already built in.
//   · downstream it is wired to `conflict_recruited_depth` (conflict → deeper A⇄G deliberation budget).
//
// PROVENANCE: conflict_scalar's MONITOR leg is already engine-native GREEN (H_9094, 4/4: conflict-
// matched budget PRESERVES Ψ=½, treatment 0.125 < shuffle 0.25 < ablation 0.375) AND wired per-tick
// into the real consciousness loop (H_9095 rung-3, cli/anima.hexa L1937–1961). So the monitor-leg
// ladder for gap #3 is ALREADY at rung-3 — this skeleton does NOT re-invent it; it (a) documents the
// mapping so gap #3 is not re-fired as if OPEN, and (b) re-verifies the monitor leg engine-native on
// a clean standalone fixture (ag_conflict_fixture.hexa) as an independent falsifier.
//
// The thin alias below simply gives the analysis's self_drift-pattern NAME to the live op so callers
// using the gap-#3 vocabulary bind to the existing engine op (no second code path — a_core_engine_map).
//   usage (self-test): hexa run state/substrate_conjunction/ag_conflict_monitor.hexa

import "core/engine_cli.hexa"

// ag_conflict_monitor — NAMED ALIAS for the live dACC conflict monitor (conflict_scalar). Kept as a
// pass-through so the gap-#3 vocabulary resolves to the SINGLE existing engine op, not a fork.
pub fn ag_conflict_monitor(a_drive: float, g_drive: float) -> float {
    return conflict_scalar(a_drive, g_drive)
}

// ag_conflict_net — the parent-control (net drive |A+G|), alias of conflict_net_tension. Reads the
// SAME ≈0 for high-conflict and low-drive states; conflict_scalar separates them.
pub fn ag_conflict_net(a_drive: float, g_drive: float) -> float {
    return conflict_net_tension(a_drive, g_drive)
}

fn main() {
    // A resonant (forward push +), G silence-push (−): opposite, both strong ⇒ HIGH conflict.
    let hi   = ag_conflict_monitor(0.9, 0.0 - 0.9)
    // both agree to emit (same sign) ⇒ 0 conflict.
    let agree = ag_conflict_monitor(0.9, 0.8)
    // low-drive opposite (+e,−e): opposite but WEAK ⇒ ~0 conflict, yet net-tension == high case.
    let lo   = ag_conflict_monitor(0.05, 0.0 - 0.05)
    println("conflict hi=" + to_string(hi) + " agree=" + to_string(agree) + " lo=" + to_string(lo)
        + " | net(hi)=" + to_string(ag_conflict_net(0.9, 0.0 - 0.9))
        + " net(lo)=" + to_string(ag_conflict_net(0.05, 0.0 - 0.05)))
}
