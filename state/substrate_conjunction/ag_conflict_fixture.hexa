// ag_conflict_fixture.hexa — ENGINE-NATIVE re-verification of the A⇄G conflict MONITOR leg (gap #3).
// Calls the LIVE engine ops directly: conflict_scalar (dACC monitor), conflict_net_tension (parent-
// control), conflict_recruited_depth (downstream deliberation budget). Independent falsifier for the
// monitor leg already GREEN/wired (H_9094/H_9095) — recorded here as a clean standalone check.
//   usage: hexa run state/substrate_conjunction/ag_conflict_fixture.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x }  return x }

fn main() {
    let mut npass = 0
    let mut nfail = 0

    // A_drive = Engine-A forward externalization push (+ = emit). G_drive = Engine-G reverse silence
    // push (opposite sign when the two engines DISAGREE). conflict_scalar HIGH iff both strong & opposite.

    // (i) high conflict: A resonant emit (+0.9), G strong silence (−0.9) — opposite, both strong.
    let c_hi = conflict_scalar(0.9, 0.0 - 0.9)
    // (ii) agreement: both push the SAME way (both emit) — no competition.
    let c_agree = conflict_scalar(0.9, 0.8)
    // (iii) single-engine: A active, G ≈0 — one engine, no competition.
    let c_single = conflict_scalar(0.9, 0.0)
    // (iv) low-drive opposite: (+0.05,−0.05) — opposite but WEAK.
    let c_lo = conflict_scalar(0.05, 0.0 - 0.05)

    if _ab("monitor: high-conflict (opposite+strong) > 0.5", c_hi > 0.5) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("monitor: agreement (same sign) == 0", c_agree == 0.0) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("monitor: single-engine (G=0) == 0", c_single == 0.0) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("monitor: conflict rises hi > lo by >=0.5", c_hi - c_lo >= 0.5) { npass=npass+1 } else { nfail=nfail+1 }

    // (v) DISSOCIATION (parent-control): high-conflict (+0.9,−0.9) and low-drive (+0.05,−0.05) read the
    //     SAME net tension |A+G|≈0 — the Ψ/emit-drive analog CANNOT tell them apart; conflict_scalar CAN.
    let net_hi = conflict_net_tension(0.9, 0.0 - 0.9)
    let net_lo = conflict_net_tension(0.05, 0.0 - 0.05)
    if _ab("dissociation: net-tension hi == lo (blind to conflict)", _absf(net_hi - net_lo) < 0.01) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("dissociation: conflict SEPARATES what net-tension merges", c_hi - c_lo >= 0.5 && _absf(net_hi - net_lo) < 0.01) { npass=npass+1 } else { nfail=nfail+1 }

    // (vi) DOWNSTREAM + ABLATION: high conflict recruits DEEPER A⇄G deliberation budget; with the lane
    //      ABLATED (conflict forced 0) recruited depth == base for EVERY state ⇒ recruitment vanishes (INERT).
    let base = 4
    let extra = 6
    let depth_hi   = conflict_recruited_depth(c_hi, base, extra)
    let depth_lo   = conflict_recruited_depth(c_lo, base, extra)
    let depth_abl  = conflict_recruited_depth(0.0, base, extra)   // ablation: conflict pinned to 0
    if _ab("downstream: high conflict recruits deeper budget than low", depth_hi > depth_lo) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("ABLATION: conflict=0 ⇒ depth==base (recruitment INERT)", depth_abl == base) { npass=npass+1 } else { nfail=nfail+1 }

    println("INFO c_hi=" + to_string(c_hi) + " c_agree=" + to_string(c_agree)
        + " c_single=" + to_string(c_single) + " c_lo=" + to_string(c_lo)
        + " | net_hi=" + to_string(net_hi) + " net_lo=" + to_string(net_lo)
        + " | depth_hi=" + to_string(depth_hi) + " depth_lo=" + to_string(depth_lo) + " depth_abl=" + to_string(depth_abl))
    println("--- gap#3 ag_conflict monitor engine-native: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
