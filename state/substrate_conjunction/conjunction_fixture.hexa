// conjunction_fixture.hexa — ENGINE-NATIVE falsifier for the conjunction readout op (substrate gap #1).
// Builds a LIVE VAdaptField, GROWS a 2nd regime cell via the real p8 mitosis tick (vadapt_field_step
// → engine_mitosis_tick), and reads the engine's OWN top-2 affinity (vadapt_field_two_recon_err). The
// op under test (vadapt_field_conjunction / _score) is INLINED here identical to conjunction_readout.hexa
// so the fixture stays self-contained (mirrors c2_engine_native.hexa style).
//   usage: hexa run state/substrate_conjunction/conjunction_fixture.hexa
import "core/engine_cli.hexa"

// ── op under test (inlined copy of the skeleton; reads engine's own top-2 accessor) ──
fn conj_bin(af: VAdaptField, x: [float], thr: float) -> float {
    if vadapt_field_cells(af) < 2 { return 0.0 }
    let d = vadapt_field_two_recon_err(af, x)
    if d[1] < thr { return 1.0 }
    return 0.0
}
fn conj_score(af: VAdaptField, x: [float], thr: float) -> float {   // graded, keyed on d2 (weaker regime)
    if vadapt_field_cells(af) < 2 { return 0.0 }
    if thr <= 0.0 { return 0.0 }
    let d = vadapt_field_two_recon_err(af, x)
    let s = 1.0 - d[1] / thr
    if s < 0.0 { return 0.0 }   if s > 1.0 { return 1.0 }   return s
}
fn conj_wta_ablated(af: VAdaptField, x: [float], thr: float) -> float {   // ABLATION: read d1 (=WTA/argmax)
    if vadapt_field_cells(af) < 2 { return 0.0 }
    if thr <= 0.0 { return 0.0 }
    let d = vadapt_field_two_recon_err(af, x)
    let s = 1.0 - d[0] / thr
    if s < 0.0 { return 0.0 }   if s > 1.0 { return 1.0 }   return s
}

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn main() {
    let mut npass = 0
    let mut nfail = 0
    let THR = 0.9

    // ── build the LIVE field: seed regime R1 at A=[1,0,0,0]; grow regime R2 at B=[0,1,0,0] via
    //    the real p8 mitosis tick (recon-err sqrt2=1.414 > SPLIT_THRESH 0.30 ⇒ engine spawns cell). ──
    let af1  = vadapt_field_new([1.0, 0.0, 0.0, 0.0], 8)   // 1 cell
    let af   = vadapt_field_step(af1, [0.0, 1.0, 0.0, 0.0], engine_config_default())  // grows to 2 cells

    // inputs
    let mid    = [0.5, 0.5, 0.0, 0.0]    // equidistant, near BOTH ⇒ CONJUNCTION  (d1=d2=0.707)
    let single = [1.0, -0.5, 0.5, 0.0]   // near A only ⇒ SINGLE regime           (d1=0.707, d2=1.87)
    let far    = [3.0, 3.0, 3.0, 3.0]    // outside both ⇒ neither                 (d1,d2 huge)
    let d_mid    = vadapt_field_two_recon_err(af, mid)
    let d_single = vadapt_field_two_recon_err(af, single)

    // (1) field actually grew a 2nd regime via LIVE mitosis (engine-native precondition)
    if _ab("grew 2 cells via live p8 mitosis tick", vadapt_field_cells(af) == 2) { npass=npass+1 } else { nfail=nfail+1 }

    // (2) CONJUNCTION fires only when BOTH regimes present
    if _ab("conjunction: mid=1 (both regimes co-present)", conj_bin(af, mid, THR) > 0.5) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("conjunction: single=0 (one regime only)",       conj_bin(af, single, THR) < 0.5) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("conjunction: far=0 (no regime)",                conj_bin(af, far, THR) < 0.5) { npass=npass+1 } else { nfail=nfail+1 }

    // (3) single-cell field ⇒ conjunction impossible (guard)
    if _ab("single-cell field ⇒ conjunction=0", conj_bin(af1, mid, THR) < 0.5) { npass=npass+1 } else { nfail=nfail+1 }

    // (4) THE LOAD-BEARING DISSOCIATION: mid & single have the SAME nearest distance (d1) but
    //     DIFFERENT second-nearest (d2). Winner-take-all (argmax) sees only d1 ⇒ CANNOT separate them.
    let same_d1 = _absf(d_mid[0] - d_single[0]) < 0.02
    if _ab("mid & single share nearest d1 (WTA sees identical)", same_d1) { npass=npass+1 } else { nfail=nfail+1 }

    // (5) ABLATION (INERT control): the WTA-collapsed readout (reads d1) gives mid & single the SAME
    //     value ⇒ conjunction capability VANISHES. The full op (reads d2) SEPARATES them.
    let wta_mid    = conj_wta_ablated(af, mid, THR)
    let wta_single = conj_wta_ablated(af, single, THR)
    let full_mid    = conj_score(af, mid, THR)
    let full_single = conj_score(af, single, THR)
    if _ab("ABLATION WTA: mid==single (INERT, no discrimination)", _absf(wta_mid - wta_single) < 0.02) { npass=npass+1 } else { nfail=nfail+1 }
    if _ab("FULL op: mid > single by >=0.20 (conjunction discriminates)", full_mid - full_single >= 0.20) { npass=npass+1 } else { nfail=nfail+1 }

    println("INFO d_mid=[" + to_string(d_mid[0]) + "," + to_string(d_mid[1]) + "]"
        + " d_single=[" + to_string(d_single[0]) + "," + to_string(d_single[1]) + "]"
        + " | wta_mid=" + to_string(wta_mid) + " wta_single=" + to_string(wta_single)
        + " | full_mid=" + to_string(full_mid) + " full_single=" + to_string(full_single))
    println("--- gap#1 conjunction engine-native: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}

fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x }  return x }
