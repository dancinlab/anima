// conjunction_readout.hexa — substrate gap #1 (conjunction readout) OP SKELETON.
//
// STATUS: design/skeleton in state/ (NOT yet lifted into core/engine_cli.hexa §ADAPTATION).
// This module imports the LIVE engine and defines the missing op purely on top of the engine's
// OWN top-2 affinity accessor `vadapt_field_two_recon_err` (pub) — it adds ZERO new geometry.
//   usage (self-test): hexa run state/substrate_conjunction/conjunction_readout.hexa
//
// ── WHY THIS OP (the missing capability, NOT recombination) ─────────────────────────────────
// The MITOSIS substrate (§ADAPTATION / VAdaptField) recalls by WINNER-TAKE-ALL: `_vnearest_idx`
// returns a single argmax cell. That answers "which ONE regime is this?" (an OR / argmax). It
// CANNOT answer "are TWO learned regimes present AT ONCE?" (an AND-over-regimes / conjunction).
// Conjunction detection is binding-AS-DETECTION (sensory fusion — "SNS ∧ Korean" co-present),
// NOT G1 generation: no new symbol is produced, so it sits OUTSIDE the DPI recombination wall
// (same class as self_drift_exp H_9038, which opened a non-recombination capability → GREEN).
//
// ── MECHANISM (fuzzy-AND = min-activation = the SECOND-nearest distance) ─────────────────────
// The engine's scan already surfaces [d1, d2] = distances to the nearest AND second-nearest cell
// (d1 <= d2). Winner-take-all reads ONLY d1. Conjunction keys on **d2** (the FARTHER = the WEAKER
// of the two co-active regimes). Gating on d2 = min-over-the-two-activations = Zadeh fuzzy-AND:
// a conjunction fires only when even the weaker regime is still close. This is the load-bearing
// distinction — d1 alone (WTA) cannot see it (two inputs with identical nearest cell but different
// second-nearest are INDISTINGUISHABLE to argmax, SEPARATED by conjunction). See the ablation arm.
//
// Ψ-DISJOINT (a_substrate_disjoint): reads VAdaptField protos ONLY (via the pub accessor). Never
// touches pure_field Φ/phase/Ψ, never the emit-drive lane (lanes 0/4 / ci_emit_drive), never the
// §ImmuneMemory recall_thr non-fab gate. Pure additive read-only readout (like H_1396 gap, H_9038).
//
// FROZEN constant (p7, NOT tuned-to-green): thr is the SAME novelty radius family as SPLIT_THRESH
// (the bar at which a distance counts as "this regime is present"); the caller passes it explicitly.

import "core/engine_cli.hexa"

// vadapt_field_conjunction — BINARY conjunction detector. 1.0 iff the field holds >=2 cells AND the
// SECOND-nearest cell is also within `thr` (both regimes co-present). 0.0 for single-regime inputs
// (d2 >= thr, i.e. only the winner is close), far inputs, or a single-cell field (conjunction
// impossible). Reads the engine's own top-2 affinity — zero new geometry.
pub fn vadapt_field_conjunction(af: VAdaptField, x: [float], thr: float) -> float {
    if vadapt_field_cells(af) < 2 { return 0.0 }        // conjunction impossible with one regime
    let d = vadapt_field_two_recon_err(af, x)           // [d1, d2], d1 <= d2 (engine's own scan)
    if d[1] < thr { return 1.0 }                        // 2nd-nearest also within thr ⇒ AND-over-regimes
    return 0.0
}

// vadapt_field_conjunction_score — GRADED variant (fuzzy-AND membership in [0,1]). Keyed on d2 (the
// weaker regime): 1.0 when both regimes essentially coincide with x, ramping to 0.0 as the weaker
// regime leaves the `thr` radius. clip01(1 - d2/thr). Single-cell field ⇒ 0.0.
pub fn vadapt_field_conjunction_score(af: VAdaptField, x: [float], thr: float) -> float {
    if vadapt_field_cells(af) < 2 { return 0.0 }
    if thr <= 0.0 { return 0.0 }
    let d = vadapt_field_two_recon_err(af, x)
    let s = 1.0 - d[1] / thr
    if s < 0.0 { return 0.0 }
    if s > 1.0 { return 1.0 }
    return s
}

// _conj_wta_collapse — ABLATION control: the SAME readout but reading d1 (nearest) instead of d2.
// This is exactly winner-take-all. Under this ablation single-regime and conjunction inputs with the
// same nearest distance return the SAME value ⇒ the conjunction capability VANISHES (INERT). Proving
// the op's discrimination lives in the d2 (second-nearest) read, nowhere else.
pub fn _conj_wta_collapse(af: VAdaptField, x: [float], thr: float) -> float {
    if vadapt_field_cells(af) < 2 { return 0.0 }
    if thr <= 0.0 { return 0.0 }
    let d = vadapt_field_two_recon_err(af, x)
    let s = 1.0 - d[0] / thr           // d[0] = d1 = nearest = WTA (the ablated read)
    if s < 0.0 { return 0.0 }
    if s > 1.0 { return 1.0 }
    return s
}

fn main() {
    // minimal self-test so the skeleton is runnable standalone (full falsifier = conjunction_fixture.hexa)
    let af0 = vadapt_field_new([1.0, 0.0, 0.0, 0.0], 8)
    let af  = vadapt_field_step(af0, [0.0, 1.0, 0.0, 0.0], engine_config_default())   // grow cell B (p8)
    let conj_pt   = [0.5, 0.5, 0.0, 0.0]          // midpoint: near BOTH ⇒ conjunction
    let single_pt = [1.0, -0.5, 0.5, 0.0]         // near A only ⇒ single regime
    println("cells=" + to_string(vadapt_field_cells(af))
        + " conj(mid)=" + to_string(vadapt_field_conjunction(af, conj_pt, 0.9))
        + " conj(single)=" + to_string(vadapt_field_conjunction(af, single_pt, 0.9)))
}
