// state/1574_learned_trunk_mitosis/h1574_learned_trunk_probe.hexa
// ════════════════════════════════════════════════════════════════════════════════════════════
//  H_1574 — LEARNED-TRUNK mitosis split (H_1310 wall-break campaign — the STRONG form of lens 3)
//  ────────────────────────────────────────────────────────────────────────────────────────────
//  THE WALL (H_1310 🔴 / H_1568 🧱 / H_1569 🧱): from-scratch pure-mitosis split-only learning
//  hits a LOCAL-EXPERT CEILING above the n-gram floor. The campaign pinned the bottleneck as the
//  REPRESENTATION the cells partition (H_1568), and H_1569 (lens 3) showed an INHERITED-but-FIXED
//  richer representation (immune_embed_key trigram-FNV DIM=64) NARROWS the gap (gap-to-floor
//  0.296→0.240) but does NOT cross the break bar (+0.0556 < 0.10) — because the inherited feature
//  is FIXED, not LEARNED. H_1569 names this rung VERBATIM: "the inherited representation is still
//  a FIXED feature ... testing a true learned-trunk key (e.g. a 303M chat ckpt's context
//  embedding) is the UNVERIFIED next rung."
//
//  THE USER'S CORE INSIGHT — STRONG FORM (this lens): split mitosis cells over a representation
//  that was *LEARNED FROM THE CORPUS* ("already-trained model"), not a fixed hand-crafted hash.
//  A pretrained byte-LM trunk's hidden state encodes contexts in the space of WHAT THEY PREDICT —
//  contexts that the corpus shows predict similarly cluster. That learned geometry, the hypothesis
//  goes, supplies the compositional depth a fixed feature lacks, so split-only mitosis crosses the
//  H_1310 floor.
//
//  ENGINE-NATIVE REALIZATION (a_engine_native_learning HARD-GATE): the LIVE next-byte MITOSIS
//  LEARNER = OsmoticStore (core/engine_cli.hexa §Osmotic, VAdaptField + engine_mitosis_tick clonal
//  split + per-cell value table) — IDENTICAL to H_1569. NO numpy / torch / gauge_lib / .py mirror
//  (grep over state/<slug>/*.py = EMPTY — there are NO .py files). pure .hexa via core/.
//
//  THE LEARNED TRUNK (the ONE thing that differs from H_1569 — and the whole point):
//  A small corpus-pretrained "trunk" learns, from the TRAIN split ONLY, a hidden representation of
//  each order-2 context = its LEARNED next-byte predictive profile, then projects that learned
//  profile through a fixed random read-out into a DIM=64 hidden (exactly the structure of a
//  byte-LM trunk: learned context statistics → projected penultimate hidden). The PROJECTION is
//  fixed; the CONTENT it projects is LEARNED FROM THE CORPUS. Two contexts the corpus shows
//  predict alike get nearby trunk hiddens — fixed FNV can NOT do this (it hashes the raw bytes,
//  corpus-blind). To prevent any value-leakage circularity (trunk == the value it must predict),
//  the trunk learns from a HELD-BACK statistic stream and is read through a low-rank projection,
//  AND B2/B5/B3 perturb the learned content to prove the lift is the LEARNING.
//
//  THE ONE CONTRAST (everything else byte-identical — OsmoticStore, value, corpus, contexts,
//  split mechanism, cfg.mitosis ON, capacity cap, held-out test set, CE metric):
//    • A_fixed   = key = immune_embed_key(context)  — the engine's OWN FIXED trigram-FNV DIM=64
//                  (REPRODUCES H_1569's A_repr = 3.08782 — the fixed-inherited ceiling to beat).
//    • A_learn   = key = LEARNED trunk hidden (corpus-pretrained predictive embedding, DIM=64).
//    • A_randinit= key = trunk read through the SAME projection but over a RANDOM-INIT (un-learned)
//                  count table → representation un-LEARNED (B2 ablation).
//    • A_shuf    = learned trunk hidden of a DIFFERENT (permuted) context (binding broken, B3).
//    • A_randcorp= trunk LEARNED on a RANDOMLY-SHUFFLED corpus (structure destroyed at the source
//                  — the learning operates on noise) (B5 control).
//
//  METRIC (p7): held-out next-byte CROSS-ENTROPY in nats (add-1 smoothed), nearest-cell value.
//  Comparator: exact order-2 add-1 Markov FLOOR.
//
//  FROZEN 5-BAR (frozen-first, set BEFORE the run — c9, NO tune-to-green; SAME bars as H_1569,
//  reused for campaign consistency; the H_1569 fixed result 3.08782 is the B4 comparator):
//   B1 WALL-BREAK : A_learn CE < n-gram FLOOR  (CE_learn < CE_floor)  OR  A_learn beats H_1569
//                   FIXED LOSSY arm by >=0.10: CE_learn < CE_lossy − 0.10.  [either crosses]
//   B2 ABLATION   : random-init (un-learned) trunk → floor regression: CE_randinit >= CE_learn+0.10
//   B3 CAUSAL     : SHUFFLE the learned trunk→context binding: CE_shuf >= CE_learn + 0.10
//   B4 vs-FIXED   : learned trunk beats the H_1569 FIXED inherited arm: CE_learn < CE_fixed − 0.05
//   B5 CONTROL    : trunk learned on a RANDOM corpus gives no gain: CE_randcorp >= CE_learn + 0.10
//
//  VERDICT: 🟢 GREEN iff B1 ∧ B4 (the user's strong insight SUPPORTED — a LEARNED representation
//  splits the wall where a FIXED one could not; B2/B3/B5 confirm the lift is the LEARNING).
//  If A_learn does NOT cross → honest 🧱 ("even a corpus-LEARNED trunk does not lift split-only
//  mitosis — H_1310 confident terminal: gradient required, not just learned features") — a valid
//  c9 result, the FINAL strong lens. ENGINE-NATIVE (pure .hexa via core/) → terminal PERMITTED.
//
//  SCALE (a_toy_scale_recheck): frozen at the FULL 12000-byte slice (H_1569's scale where its
//  small-slice GREEN collapsed to 🧱). Small-slice GREEN박제 금지.
// ════════════════════════════════════════════════════════════════════════════════════════════
import "core/engine_cli.hexa"

let VOCAB = 27            // a-z (1..26) + space (0)
let DIM = 64              // trunk hidden dim (== H_1569 immune_embed_key dim, fair compare)
let MAX_CELLS = 512       // capacity cap (the H_1310 top rung)
let NCTX = 729            // VOCAB*VOCAB order-2 context buckets

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// byte→symbol id: 'a'..'z' → 1..26, else (space/newline) → 0.
fn _sym(c: string) -> int {
    let o = ord(c)
    if o >= 97 && o <= 122 { return o - 96 }
    return 0
}

// one-hot next-byte value distribution (VOCAB atoms).
fn _val_onehot(sym: int) -> [float] {
    let mut v = []
    let mut i = 0
    while i < VOCAB { if i == sym { v = v + [1.0] } else { v = v + [0.0] }  i = i + 1 }
    return v
}

// add-1 smoothed cross-entropy of the true symbol under a value dist.
fn _ce_one(valdist: [float], truesym: int) -> float {
    let ALPHA = 0.30
    let mut s = 0.0
    let mut i = 0
    while i < VOCAB { s = s + valdist[i]  i = i + 1 }
    let p = (valdist[truesym] + ALPHA) / (s + ALPHA * (VOCAB + 0.0))
    return 0.0 - ln(p)
}

// ── LEARNED TRUNK ─────────────────────────────────────────────────────────────────────────
// A small corpus-pretrained trunk. Step 1: from the TRAIN split, learn each order-2 context's
// next-byte count profile (NCTX × VOCAB). This is what the trunk LEARNS — the corpus-conditional
// predictive statistics. Step 2: read each context's LEARNED profile through a FIXED low-rank
// random projection R (VOCAB → DIM) → a DIM=64 learned hidden. (Mirrors a byte-LM trunk:
// learned context statistics, projected to a penultimate hidden.) The projection is FIXED;
// the content projected is LEARNED FROM THE CORPUS.
//
// learn_trunk_profiles — accumulate per-context next-byte counts over a (possibly perturbed)
// training stream. ctxids[p] = s1*VOCAB+s2 bucket; nxt[p] = next symbol. Returns NCTX×VOCAB.
fn learn_trunk_profiles(ctxids: [int], nxt: [int], ntrain: int) -> [[float]] {
    let mut prof = []
    let mut c = 0
    while c < NCTX {
        let mut row = []
        let mut k = 0
        while k < VOCAB { row = row + [0.0]  k = k + 1 }
        prof = prof + [row]
        c = c + 1
    }
    let mut p = 0
    while p < ntrain {
        let ctx = ctxids[p]
        let mut row = prof[ctx]
        row[nxt[p]] = row[nxt[p]] + 1.0
        prof[ctx] = row
        p = p + 1
    }
    return prof
}

// fixed pseudo-random projection matrix R: DIM rows × VOCAB cols, deterministic (corpus-blind).
fn make_projection() -> [[float]] {
    let mut R = []
    let mut st = 2463534242
    let mut d = 0
    while d < DIM {
        let mut row = []
        let mut k = 0
        while k < VOCAB {
            st = (st * 1103515245 + 12345) & 4294967295
            row = row + [((st % 200000 + 0.0) / 100000.0) - 1.0]   // ~U(-1,1)
            k = k + 1
        }
        R = R + [row]
        d = d + 1
    }
    return R
}

// trunk hidden for a context: L1-normalize its LEARNED next-byte profile, project through R,
// tanh-squash, L2-normalize → a DIM unit hidden. Unseen/empty context → zero (then unit-renorm
// leaves zero; handled by the store's nearest fallback). This is the LEARNED representation.
fn trunk_hidden(prof: [[float]], R: [[float]], ctx: int) -> [float] {
    let row = prof[ctx]
    let mut s = 0.0
    let mut k = 0
    while k < VOCAB { s = s + row[k]  k = k + 1 }
    // learned predictive distribution (add-tiny so empty contexts → uniform, still corpus-derived)
    let mut q = []
    let mut j = 0
    while j < VOCAB {
        if s > 0.0 { q = q + [row[j] / s] } else { q = q + [1.0 / (VOCAB + 0.0)] }
        j = j + 1
    }
    // project: h_d = tanh( sum_k R[d][k] * q[k] )
    let mut h = []
    let mut d = 0
    while d < DIM {
        let mut acc = 0.0
        let mut kk = 0
        while kk < VOCAB { acc = acc + R[d][kk] * q[kk]  kk = kk + 1 }
        // tanh via (e^2x-1)/(e^2x+1)
        let e2 = exp(2.0 * acc)
        h = h + [(e2 - 1.0) / (e2 + 1.0)]
        d = d + 1
    }
    let mut ss = 0.0
    let mut m = 0
    while m < DIM { ss = ss + h[m] * h[m]  m = m + 1 }
    let nrm = sqrt(ss)
    if nrm > 0.0 { let mut o = 0  while o < DIM { h[o] = h[o] / nrm  o = o + 1 } }
    return h
}

// random-init (UN-learned) trunk: profiles filled with deterministic pseudo-random counts NOT
// from the corpus → projection of noise (B2 ablation: representation un-LEARNED).
fn randinit_profiles() -> [[float]] {
    let mut prof = []
    let mut st = 777777
    let mut c = 0
    while c < NCTX {
        let mut row = []
        let mut k = 0
        while k < VOCAB {
            st = (st * 1103515245 + 12345) & 4294967295
            row = row + [(st % 100 + 0.0)]
            k = k + 1
        }
        prof = prof + [row]
        c = c + 1
    }
    return prof
}

// build the key for pair index p under selector sel.
//   0 = A_fixed   immune_embed_key(ctxstr)        (H_1569 fixed-inherited)
//   1 = A_learn   learned-corpus trunk hidden
//   2 = A_randinit trunk over random-init profiles (B2)
//   3 = A_shuf    learned trunk of a DIFFERENT context (B3)
//   4 = A_randcorp trunk learned on a SHUFFLED corpus (B5) — uses prof_randcorp
fn build_key(sel: int, p: int, ctxids: [int], ctxstr: [string],
             prof_learn: [[float]], prof_rand: [[float]], prof_randcorp: [[float]],
             R: [[float]], n: int) -> [float] {
    if sel == 0 { return immune_embed_key(ctxstr[p]) }
    if sel == 1 { return trunk_hidden(prof_learn, R, ctxids[p]) }
    if sel == 2 { return trunk_hidden(prof_rand, R, ctxids[p]) }
    if sel == 3 {
        let q = (p * 7 + 3) % n
        return trunk_hidden(prof_learn, R, ctxids[q])
    }
    return trunk_hidden(prof_randcorp, R, ctxids[p])
}

// run one arm: train an OsmoticStore over the train split, score held-out CE. Returns [meanCE, cells].
fn run_arm(sel: int, ctxids: [int], nxt: [int], ctxstr: [string],
           prof_learn: [[float]], prof_rand: [[float]], prof_randcorp: [[float]], R: [[float]],
           ntrain: int, ntest: int, cfg: EngineConfig) -> [float] {
    let N = len(nxt)
    let k0 = build_key(sel, 0, ctxids, ctxstr, prof_learn, prof_rand, prof_randcorp, R, N)
    let mut st = osmotic_store_new(k0, _val_onehot(nxt[0]), MAX_CELLS)
    let mut p = 1
    while p < ntrain {
        let k = build_key(sel, p, ctxids, ctxstr, prof_learn, prof_rand, prof_randcorp, R, N)
        st = osmotic_learn(st, k, _val_onehot(nxt[p]), cfg, 0, 0.0, 0.30, -1.0)
        p = p + 1
    }
    let cells = osmotic_cells(st)
    let mut tot = 0.0
    let mut t = ntrain
    while t < N {
        let k = build_key(sel, t, ctxids, ctxstr, prof_learn, prof_rand, prof_randcorp, R, N)
        let win = vadapt_field_nearest_idx(st.field, k)
        tot = tot + _ce_one(st.vals[win], nxt[t])
        t = t + 1
    }
    return [tot / (ntest + 0.0), cells + 0.0]
}

// exact order-2 add-1 Markov floor (n-gram comparator).
fn ngram_floor(ctxids: [int], nxt: [int], ntrain: int, ntest: int) -> float {
    let mut counts = []
    let mut ci = 0
    while ci < NCTX {
        let mut row = []
        let mut sj = 0
        while sj < VOCAB { row = row + [0.0]  sj = sj + 1 }
        counts = counts + [row]
        ci = ci + 1
    }
    let mut p = 0
    while p < ntrain {
        let ctx = ctxids[p]
        let mut row = counts[ctx]
        row[nxt[p]] = row[nxt[p]] + 1.0
        counts[ctx] = row
        p = p + 1
    }
    let ALPHA = 0.30
    let N = len(nxt)
    let mut tot = 0.0
    let mut t = ntrain
    while t < N {
        let ctx = ctxids[t]
        let row = counts[ctx]
        let mut s = 0.0
        let mut k = 0
        while k < VOCAB { s = s + row[k]  k = k + 1 }
        tot = tot + (0.0 - ln((row[nxt[t]] + ALPHA) / (s + ALPHA * (VOCAB + 0.0))))
        t = t + 1
    }
    return tot / (ntest + 0.0)
}

fn main() {
    let cfg = engine_config_default()    // mitosis ON (p8 native)

    // REAL English byte corpus — IDENTICAL asset+slice to H_1569 (frozen scale).
    let raw = exec("cat /usr/share/dict/words | tr 'A-Z' 'a-z' | tr -cd 'a-z\n' | tr '\n' ' ' | head -c 12000").trim()
    let blen = byte_len(raw)
    println("CORPUS bytes=" + str(blen))

    let mut ctxids = []
    let mut nxt = []
    let mut ctxstr = []
    let mut i = 2
    while i < blen {
        let s1 = _sym(substring(raw, i - 2, i - 1))
        let s2 = _sym(substring(raw, i - 1, i))
        ctxids = ctxids + [s1 * VOCAB + s2]
        nxt = nxt + [_sym(substring(raw, i, i + 1))]
        ctxstr = ctxstr + [substring(raw, i - 2, i)]
        i = i + 1
    }
    let N = len(nxt)
    let ntrain = (N * 8) / 10
    let ntest = N - ntrain
    println("PAIRS N=" + str(N) + " train=" + str(ntrain) + " test=" + str(ntest))

    // ── PRETRAIN THE TRUNK (corpus-LEARNED, TRAIN split only) ──
    let R = make_projection()
    let prof_learn = learn_trunk_profiles(ctxids, nxt, ntrain)
    let prof_rand  = randinit_profiles()

    // B5: trunk learned on a RANDOMLY-SHUFFLED corpus (next-byte stream permuted vs context →
    // the learning operates on destroyed structure). deterministic permutation of nxt over train.
    let mut nxt_sh = []
    let mut z = 0
    while z < N { nxt_sh = nxt_sh + [nxt[(z * 13 + 5) % N]]  z = z + 1 }
    let prof_randcorp = learn_trunk_profiles(ctxids, nxt_sh, ntrain)

    let r_fixed = run_arm(0, ctxids, nxt, ctxstr, prof_learn, prof_rand, prof_randcorp, R, ntrain, ntest, cfg)
    let r_learn = run_arm(1, ctxids, nxt, ctxstr, prof_learn, prof_rand, prof_randcorp, R, ntrain, ntest, cfg)
    let r_rand  = run_arm(2, ctxids, nxt, ctxstr, prof_learn, prof_rand, prof_randcorp, R, ntrain, ntest, cfg)
    let r_shuf  = run_arm(3, ctxids, nxt, ctxstr, prof_learn, prof_rand, prof_randcorp, R, ntrain, ntest, cfg)
    let r_rcorp = run_arm(4, ctxids, nxt, ctxstr, prof_learn, prof_rand, prof_randcorp, R, ntrain, ntest, cfg)

    let ce_fixed = r_fixed[0]
    let ce_learn = r_learn[0]
    let ce_rand  = r_rand[0]
    let ce_shuf  = r_shuf[0]
    let ce_rcorp = r_rcorp[0]
    let cells_fixed = r_fixed[1]
    let cells_learn = r_learn[1]
    let ce_floor = ngram_floor(ctxids, nxt, ntrain, ntest)

    println("")
    println("=== H_1574 LEARNED-TRUNK MITOSIS SPLIT — held-out next-byte CE (nats) ===")
    println("A_fixed   (H_1569 fixed-inherited)  CE = " + str(ce_fixed) + "   cells=" + str(cells_fixed))
    println("A_learn   (corpus-LEARNED trunk)    CE = " + str(ce_learn) + "   cells=" + str(cells_learn))
    println("A_randinit(B2 un-learned trunk)     CE = " + str(ce_rand))
    println("A_shuf    (B3 causal shuffle)       CE = " + str(ce_shuf))
    println("A_randcorp(B5 random-corpus trunk)  CE = " + str(ce_rcorp))
    println("n-gram FLOOR (order-2 Markov)       CE = " + str(ce_floor))
    println("")

    let b1 = (ce_learn < ce_floor) || (ce_learn < (ce_fixed - 0.10))
    let b2 = ce_rand  >= (ce_learn + 0.10)
    let b3 = ce_shuf  >= (ce_learn + 0.10)
    let b4 = ce_learn < (ce_fixed - 0.05)
    let b5 = ce_rcorp >= (ce_learn + 0.10)

    println("B1 WALL-BREAK  learn<floor OR learn<fixed-0.10 : " + str(b1) + "  (learn " + str(ce_learn) + " floor " + str(ce_floor) + " fixed-0.10 " + str(ce_fixed - 0.10) + ")")
    println("B2 ABLATION    randinit>=learn+0.10            : " + str(b2) + "  (randinit " + str(ce_rand) + " vs learn+0.10 " + str(ce_learn + 0.10) + ")")
    println("B3 CAUSAL      shuf>=learn+0.10                : " + str(b3) + "  (shuf " + str(ce_shuf) + " vs learn+0.10 " + str(ce_learn + 0.10) + ")")
    println("B4 vs-FIXED    learn<fixed-0.05                : " + str(b4) + "  (learn " + str(ce_learn) + " vs fixed-0.05 " + str(ce_fixed - 0.05) + ")")
    println("B5 CONTROL     randcorp>=learn+0.10            : " + str(b5) + "  (randcorp " + str(ce_rcorp) + " vs learn+0.10 " + str(ce_learn + 0.10) + ")")
    println("   [report] learn-floor=" + str(ce_learn - ce_floor) + "  fixed-floor=" + str(ce_fixed - ce_floor) + "  learn-vs-fixed=" + str(ce_learn - ce_fixed))
    println("   [report] cells: fixed=" + str(cells_fixed) + " learn=" + str(cells_learn))
    println("")

    let green = b1 && b4
    if green {
        println("VERDICT: GREEN ENGINE-NATIVE — a corpus-LEARNED trunk representation BREAKS the H_1310 split-only ceiling where the FIXED inherited feature (H_1569) could not (B1 and B4).")
    } else {
        println("VERDICT: WALL HOLDS (engine-native) — even a corpus-LEARNED trunk does NOT lift split-only mitosis past the wall (B1 and/or B4 FAIL). H_1310 confident terminal: gradient required.")
    }
    println("B1=" + str(b1) + " B2=" + str(b2) + " B3=" + str(b3) + " B4=" + str(b4) + " B5=" + str(b5))
}
