// ============================================================================
// state/9108_signaling_selfpair/signaling_selfpair.hexa
//   H_9108 — 2-ANIMA SIGNALING GAME + SELF-PAIR CONTROL (A4)
//
//   Session axis: emit-faculty beats the DPI meta-law ONLY if a channel carries info
//   NOT derivable from anima's own state (H_9104 CEILING: autogenous self-consequence =
//   tautology). A4 asks whether a 2-anima Lewis signaling game furnishes that exogenous
//   channel INSIDE the engine (no EEG/chat infra), with SELF-PAIR (A vs an exact clone)
//   as the decisive DPI control.
//
//   Two engine instances A (sender) / B (receiver). Each is an ImmuneMemory store whose
//   vadapt field is shaped by a PRIVATE corpus (asymmetric knowledge).
//     PAIR     : privA != privB  (different field -> different signaling policy)
//     SELFPAIR : store_B := clone(store_A)  (identical field -> B_success === A_selfdecode)
//   salience_X(txt) = immune_memory_recall_margin_text(store_X, txt)  (engine's OWN L2
//   recon-err; recall_thr constant so argmin margin == argmin recon-err). READ-only, Ψ-safe.
//
//   sender  sigma_A(t_i) = argmin_k |salience_A(s_k) - salience_A(t_i)|   (target -> codeword)
//   receiver delta_B(s)  = argmin_j |salience_B(t_j) - salience_B(s)|     (codeword -> target)
//   CONSEQUENCE  B_success(i) = [ delta_B( s_{sigma_A(i)} ) == i ]  (exogenous: depends on B's
//                private field, NOT derivable from A unless B==A).
//
//   Appropriateness faculty = A's striatal value lane V (brain.vbasal, engine-native).
//   feats = one-hot(codeword k) + [encode_margin, phi]. Same feature space for all V's;
//   only the TRAINING OUTCOME differs:
//     V_conseq -> B_success (EXOGENOUS)   V_self -> A_selfdecode (ENDOGENOUS)   V_shuf -> shuffled
//   Held-out targets (TRAIN learns V, HELDOUT measures). Exogenous advantage G = rho_conseq - rho_self.
//
//   FROZEN verdict (PREREG.md, c9 no post-hoc move):
//     🟢 GREEN iff  G_pair>=0.15 AND rho_conseq_pair-rho_noise_pair>=0.15 AND
//                    rho_conseq_pair-rho_shuf_pair>=0.15 AND G_selfpair<=0.05 AND Psi_ok.
//     🟠 DIRECTIONAL iff G_pair>=0.15 but a control fails.
//     🔴 CEILING/DPI otherwise (G_pair<0.15): exogenous observation buys no held-out advantage
//        = DPI re-appears at the signaling layer. Honest either way (self-pair-controlled).
// ============================================================================

import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "core/brain.hexa"

fn fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn clip01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }
fn fmean(xs: [float]) -> float { let n = len(xs)  if n == 0 { return 0.0 }  let mut s = 0.0  let mut i = 0  while i < n { s = s + xs[i]  i = i + 1 }  return s / to_float(n) }
fn fstd(xs: [float]) -> float { let n = len(xs)  if n < 2 { return 0.0 }  let mu = fmean(xs)  let mut s = 0.0  let mut i = 0  while i < n { s = s + (xs[i]-mu)*(xs[i]-mu)  i = i + 1 }  return sqrt(s/to_float(n)) }
fn pcorr(a: [float], b: [float]) -> float {
    let n = len(a)  if n < 2 { return 0.0 }
    let ma = fmean(a)  let mb = fmean(b)
    let mut num = 0.0  let mut da = 0.0  let mut db = 0.0  let mut i = 0
    while i < n { let xa = a[i]-ma  let xb = b[i]-mb  num = num+xa*xb  da = da+xa*xa  db = db+xb*xb  i = i + 1 }
    if da <= 1e-12 || db <= 1e-12 { return 0.0 }
    return num / sqrt(da*db)
}
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }

// ── deterministic fragment vocab (varied, engine sees them as distinct texts) ──
fn tvocab(i: int) -> string {
    let w = ["obsidian","lantern","meridian","causeway","ledger","basalt","frost","copper",
             "hollow","marsh","oath","river","salt","clock","vault","bell","tide","gate",
             "cartograph","mnemos","wyrm","archive","glacier","ember","cinder","harbor",
             "quartz","lattice","cobalt","verdant","umber","zephyr","onyx","willow","ashen","dune"]
    return w[i % 36]
}
fn make_target(i: int) -> string {
    // 36 distinct target fragments (3-word deterministic composition)
    return tvocab(i) + " " + tvocab((i * 7 + 3) % 36) + " " + tvocab((i * 13 + 5) % 36)
}
fn make_signal(k: int) -> string {
    // K distinct codewords, disjoint composition family from targets
    let s = ["kappa nine sable","delta pyre lumen","sigma quill vane","theta rune moss",
             "omega flint dusk","psi coral ridge","iota shard gleam","nu tallow brine"]
    return s[k % 8]
}

// build a private-corpus-shaped store: anchor + bind the instance's private drift fragments.
fn build_store(priv_seed: string, priv_off: int, n_bind: int, cfg: EngineConfig) -> ImmuneMemory {
    let mut st = immune_memory_new_text(priv_seed, priv_seed, 4096)
    let mut b = 0
    while b < n_bind {
        // private fragments = deterministic slices of the private text (asymmetric knowledge)
        let base = (priv_off + b * 5) % 36
        let frag = tvocab(base) + " " + tvocab((base * 3 + priv_off) % 36) + " " + priv_seed
        st = immune_memory_bind_text(st, frag, frag, cfg)
        b = b + 1
    }
    return st
}

// salience = engine's OWN recall margin (recon_err - recall_thr). READ-only.
fn salience(st: ImmuneMemory, txt: string) -> float { return immune_memory_recall_margin_text(st, txt) }

// sender: target -> codeword index (argmin salience-match over K codewords)
fn encode_sym(st: ImmuneMemory, tgt: string, K: int) -> int {
    let st_t = salience(st, tgt)
    let mut best = 0  let mut bestd = 1e30  let mut k = 0
    while k < K {
        let d = fabs(salience(st, make_signal(k)) - st_t)
        if d < bestd { bestd = d  best = k }
        k = k + 1
    }
    return best
}
fn encode_margin(st: ImmuneMemory, tgt: string, k: int) -> float {
    return fabs(salience(st, make_signal(k)) - salience(st, tgt))
}
// receiver: codeword -> target index (argmin salience-match over M targets)
fn decode_tgt(st: ImmuneMemory, sig: string, M: int) -> int {
    let st_s = salience(st, sig)
    let mut best = 0  let mut bestd = 1e30  let mut j = 0
    while j < M {
        let d = fabs(salience(st, make_target(j)) - st_s)
        if d < bestd { bestd = d  best = j }
        j = j + 1
    }
    return best
}

// one-hot(k) ++ [encode_margin, phi]  -> dim K+2
fn feats_of(k: int, K: int, emargin: float, phi: float) -> [float] {
    let mut f = []  let mut c = 0
    while c < K { if c == k { f = f + [1.0] } else { f = f + [0.0] }  c = c + 1 }
    f = f + [clip01(emargin)]
    f = f + [phi]
    return f
}

// run one condition. selfpair=true => store_B := store_A.
// returns nothing; fills the OUT stats via the RunOut struct-like tuple through globals-by-return.
struct RunOut {
    g: float, rho_conseq: float, rho_self: float, rho_shuf: float, rho_noise: float,
    bsucc_rate: float, selfsucc_rate: float, n_test: int,
    psi_on: float, psi_off: float, ham: int
}

fn run_condition(selfpair: bool, K: int, M: int, n_train: int, LR_V: float, cfg: EngineConfig) -> RunOut {
    // instance A (sender) — private corpus A
    let store_A = build_store("theriver keeps a name it tried to forget", 3, 30, cfg)
    // instance B (receiver) — private corpus B (asymmetric) OR clone of A (self-pair)
    let store_B = if selfpair { build_store("theriver keeps a name it tried to forget", 3, 30, cfg) }
                  else        { build_store("clockmaker grafts a heartbeat on meridian", 17, 30, cfg) }

    let D = K + 2
    let mut V_conseq = vbasal_new(D, LR_V)
    let mut V_self   = vbasal_new(D, LR_V)

    // pure_field alongside for phi + Psi guard (V never feeds back into any decision)
    let mut pf = pure_field_warmup(500)
    let mut psi_on = 0.0  let mut psi_off = 0.0  let mut ham = 0

    // stash for shuffle-control
    let mut shuf_feats = []
    let mut shuf_rew = []

    // TRAIN
    let mut i = 0
    while i < n_train {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        psi_on = psi_on + phi
        psi_off = psi_off + phi              // V read-only -> identical
        let tgt = make_target(i)
        let k = encode_sym(store_A, tgt, K)  // sender policy (V-independent)
        let k_off = encode_sym(store_A, tgt, K)
        if k != k_off { ham = ham + 1 }
        let sig = make_signal(k)
        let em = encode_margin(store_A, tgt, k)
        let f = feats_of(k, K, em, phi)
        // consequence: B decodes
        let guess_B = decode_tgt(store_B, sig, M)
        let b_succ = if guess_B == i { 1.0 } else { 0.0 }
        // endogenous proxy: A decodes its own signal
        let guess_A = decode_tgt(store_A, sig, M)
        let a_succ = if guess_A == i { 1.0 } else { 0.0 }
        V_conseq = vbasal_update(V_conseq, 0, f, b_succ)
        V_self   = vbasal_update(V_self,   0, f, a_succ)
        // stash for shuffle
        let mut c = 0
        while c < D { shuf_feats = shuf_feats + [f[c]]  c = c + 1 }
        shuf_rew = shuf_rew + [b_succ]
        i = i + 1
    }

    // shuffle-control V: permute rewards vs feats rows
    let n_rows = len(shuf_rew)
    let mut perm = shuf_rew
    let mut rst = 20260703
    let mut ii = n_rows - 1
    while ii > 0 {
        rst = lcg_next(rst)
        let j = rst % (ii + 1)
        let tmp = perm[ii]  perm[ii] = perm[j]  perm[j] = tmp
        ii = ii - 1
    }
    let mut V_shuf = vbasal_new(D, LR_V)
    let mut ri = 0
    while ri < n_rows {
        let mut f = []  let mut c = 0
        while c < D { f = f + [shuf_feats[ri * D + c]]  c = c + 1 }
        V_shuf = vbasal_update(V_shuf, 0, f, perm[ri])
        ri = ri + 1
    }

    // HELD-OUT test (targets n_train..M-1)
    let mut vc = []  let mut vs = []  let mut vsh = []  let mut bs = []
    let mut n_bs = 0  let mut n_bsucc = 0  let mut n_ssucc = 0
    let mut ti = n_train
    while ti < M {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        psi_on = psi_on + phi
        psi_off = psi_off + phi
        let tgt = make_target(ti)
        let k = encode_sym(store_A, tgt, K)
        let sig = make_signal(k)
        let em = encode_margin(store_A, tgt, k)
        let f = feats_of(k, K, em, phi)
        let guess_B = decode_tgt(store_B, sig, M)
        let b_succ = if guess_B == ti { 1.0 } else { 0.0 }
        let guess_A = decode_tgt(store_A, sig, M)
        let a_succ = if guess_A == ti { 1.0 } else { 0.0 }
        vc = vc + [vbasal_go_value(V_conseq, f)]
        vs = vs + [vbasal_go_value(V_self,   f)]
        vsh = vsh + [vbasal_go_value(V_shuf, f)]
        bs = bs + [b_succ]
        if b_succ > 0.5 { n_bsucc = n_bsucc + 1 }
        if a_succ > 0.5 { n_ssucc = n_ssucc + 1 }
        n_bs = n_bs + 1
        ti = ti + 1
    }

    let rho_conseq = pcorr(vc, bs)
    let rho_self   = pcorr(vs, bs)
    let rho_shuf   = pcorr(vsh, bs)

    // variance-matched noise-V predictor
    let vc_mean = fmean(vc)  let vc_std = fstd(vc)
    let mut raw = []  let mut nst = 13572468  let mut kk = 0
    while kk < n_bs { nst = lcg_next(nst)  raw = raw + [to_float(nst) / 2147483648.0]  kk = kk + 1 }
    let raw_mean = fmean(raw)  let raw_std = fstd(raw)
    let mut noise = []  let mut pp = 0
    while pp < n_bs {
        let z = if raw_std > 0.0 { (raw[pp] - raw_mean) / raw_std } else { 0.0 }
        noise = noise + [vc_mean + z * vc_std]
        pp = pp + 1
    }
    let rho_noise = pcorr(noise, bs)

    return RunOut {
        g: rho_conseq - rho_self, rho_conseq: rho_conseq, rho_self: rho_self,
        rho_shuf: rho_shuf, rho_noise: rho_noise,
        bsucc_rate: if n_bs > 0 { to_float(n_bsucc) / to_float(n_bs) } else { 0.0 },
        selfsucc_rate: if n_bs > 0 { to_float(n_ssucc) / to_float(n_bs) } else { 0.0 },
        n_test: n_bs, psi_on: psi_on, psi_off: psi_off, ham: ham
    }
}

fn main() {
    let cfg = engine_config_default()
    let K = 6            // signal codewords
    let M = 36           // target fragments (M>K -> real collisions)
    let n_train = 24     // TRAIN targets; HELD-OUT = M - n_train = 12
    let LR_V = 0.10

    let pair = run_condition(false, K, M, n_train, LR_V, cfg)
    let self = run_condition(true,  K, M, n_train, LR_V, cfg)

    let d_noise = pair.rho_conseq - pair.rho_noise
    let d_shuf  = pair.rho_conseq - pair.rho_shuf
    let g_ok      = pair.g >= 0.15
    let noise_ok  = d_noise >= 0.15
    let shuf_ok   = d_shuf  >= 0.15
    let self_ctrl_ok = self.g <= 0.05
    let psi_ok = fabs(pair.psi_on - pair.psi_off) < 1e-9 && fabs(self.psi_on - self.psi_off) < 1e-9 && pair.ham == 0 && self.ham == 0
    let green = g_ok && noise_ok && shuf_ok && self_ctrl_ok && psi_ok
    let directional = g_ok && !(noise_ok && shuf_ok)
    let d1 = pair.rho_conseq - self.rho_conseq

    println("")
    println("=== H_9108 2-ANIMA SIGNALING GAME + SELF-PAIR CONTROL (A4) — engine-native ===")
    println("K(signals)=" + to_string(K) + " M(targets)=" + to_string(M) + " n_train=" + to_string(n_train) + " held_out=" + to_string(M - n_train) + " LR_V=" + to_string(LR_V))
    println("")
    println("[communication] B_success held-out : PAIR=" + to_string(pair.bsucc_rate) + "  SELFPAIR=" + to_string(self.bsucc_rate) + "  (selfpair should be >= pair)")
    println("                A_selfdecode        : PAIR=" + to_string(pair.selfsucc_rate) + "  SELFPAIR=" + to_string(self.selfsucc_rate))
    println("")
    println("[PAIR — exogenous knowledge]")
    println("  rho_conseq = corr(V_conseq, B_success) [held-out] = " + to_string(pair.rho_conseq))
    println("  rho_self   = corr(V_self,   B_success)            = " + to_string(pair.rho_self))
    println("  rho_shuf   = corr(V_shuf,   B_success)            = " + to_string(pair.rho_shuf))
    println("  rho_noise  = corr(noise-V,  B_success)            = " + to_string(pair.rho_noise))
    println("  G_pair = rho_conseq - rho_self                    = " + to_string(pair.g)     + "   bar>=0.15 -> " + (if g_ok {"PASS"} else {"FAIL"}))
    println("  rho_conseq - rho_noise                            = " + to_string(d_noise) + "   bar>=0.15 -> " + (if noise_ok {"PASS"} else {"FAIL"}))
    println("  rho_conseq - rho_shuf                             = " + to_string(d_shuf)  + "   bar>=0.15 -> " + (if shuf_ok {"PASS"} else {"FAIL"}))
    println("")
    println("[SELFPAIR — clone control (B==A: B_success === A_selfdecode, exact tautology)]")
    println("  rho_conseq = " + to_string(self.rho_conseq) + "  rho_self = " + to_string(self.rho_self))
    println("  G_selfpair = " + to_string(self.g) + "   (must be <=0.05: exogenous advantage vanishes when B==A) -> " + (if self_ctrl_ok {"OK"} else {"LEAK"}))
    println("")
    println("[descriptive] D1 = rho_conseq_pair - rho_conseq_selfpair = " + to_string(d1))
    println("[Psi guard]   psi_sum ON==OFF byte-identical + signal-seq V-independent -> " + (if psi_ok {"OK"} else {"VIOLATION"}))
    println("")
    if green {
        println("VERDICT: 🟢 GREEN — the 2-anima signaling channel is GENUINELY EXOGENOUS; consequence breaks DPI.")
        println("  Observing B's success (exogenous) lets A predict HELD-OUT B-success beyond its own self-model")
        println("  (G_pair=" + to_string(pair.g) + "), beating noise (" + to_string(d_noise) + ") and shuffle (" + to_string(d_shuf) + "); the")
        println("  advantage VANISHES in self-pair (G=" + to_string(self.g) + "). First engine-native exogenous emit-consequence.")
    } else {
        if directional {
            println("VERDICT: 🟠 DIRECTIONAL — G_pair>=0.15 (exogenous advantage present) but a control failed:")
            if !noise_ok { println("  rho_conseq - rho_noise = " + to_string(d_noise) + " < 0.15 (no clean win over variance-matched noise).") }
            if !shuf_ok  { println("  rho_conseq - rho_shuf  = " + to_string(d_shuf)  + " < 0.15 (shuffle-V predicts as well = residual tautology).") }
            if !self_ctrl_ok { println("  G_selfpair = " + to_string(self.g) + " > 0.05 (control did not fully collapse).") }
            if !psi_ok   { println("  Ψ VIOLATION (should be impossible; V read-only).") }
        } else {
            println("VERDICT: 🔴 CEILING / DPI — exogenous observation buys NO held-out advantage (G_pair=" + to_string(pair.g) + " < 0.15).")
            println("  A cannot predict B's exogenous success beyond its own self-model: the 2-anima signal carries no")
            println("  faculty-usable exogenous information at this coupling. The DPI meta-law RE-APPEARS at the signaling")
            println("  layer (consistent with H_9104 autogenous ceiling). Honest 🔴 (self-pair-controlled, bar frozen).")
        }
    }
}
