// h1129_parity_probe.hexa — engine-native last-position logits for the h1129.bin,
// for byte-faithfulness parity vs torch golden (.pt forward on the SAME seed).
// Seed = "consciousness" (13 bytes). Mirrors state/core_research_probes/h1156_bytegpt_parity_probe.hexa.

import "core/bytegpt_decode.hexa"

fn main() {
    let path = "/Users/mini/anima-weights/bytegpt303_h1129/h1129.bin"
    // "consciousness" bytes
    let pb = [99, 111, 110, 115, 99, 105, 111, 117, 115, 110, 101, 115, 115]
    let T = len(pb)
    let ids = farr_zeros(T)
    let mut i = 0
    while i < T { let _ = farr_set(ids, i, to_float(pb[i])); i = i + 1 }

    let logits = bytegpt_forward_last(path, ids, T)

    let mut am = 0
    let mut mx = farr_get(logits, 0)
    let mut k = 1
    while k < 256 {
        let v = farr_get(logits, k)
        if v > mx { mx = v; am = k }
        k = k + 1
    }
    println("CORE_ARGMAX " + to_string(am))
    println("CORE_MAXVAL " + to_string(mx))

    let mut s = "CORE_FIRST16 "
    let mut j = 0
    while j < 16 { s = s + to_string(farr_get(logits, j)) + " "; j = j + 1 }
    println(s)

    let cp = farr_zeros(256)
    let mut c2 = 0
    while c2 < 256 { let _ = farr_set(cp, c2, farr_get(logits, c2)); c2 = c2 + 1 }
    let mut t5 = "CORE_TOP5 "
    let mut r = 0
    while r < 5 {
        let mut bi = 0
        let mut bv = farr_get(cp, 0)
        let mut kk = 1
        while kk < 256 {
            let vv = farr_get(cp, kk)
            if vv > bv { bv = vv; bi = kk }
            kk = kk + 1
        }
        t5 = t5 + to_string(bi) + " "
        let _ = farr_set(cp, bi, 0.0 - 1.0e30)
        r = r + 1
    }
    println(t5)
    let _ = farr_free(logits); let _ = farr_free(cp); let _ = farr_free(ids)
}
