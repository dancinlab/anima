// h1327_ko_jamo_decode_probe.hexa — LIVE-DECODE WIRING (r3) of the H_1316/H_1321 🟢 ko-jamo
// breakthrough: does the jamo win REACH EMISSION through the generator §6.5b ko_jamo_consult
// surface? (a_verified_must_wire + a_core_engine_map).
//
// THREAD: H_1316 🟢 (jamo rep breaks the Korean raw-byte CE ceiling 2.953→2.513, mirror) →
// H_1321 🟢 (that mitosis runs ENGINE-NATIVE byte-exact on the live VAdaptField, reproduces
// the mirror to 1e-7). BUT H_1321 is the MEASUREMENT probe; the jamo win never reaches the
// live DECODE/emission path. anima is a chat daemon — a measured CE win that never reaches
// emission is incomplete. H_1327 wires the grown jamo cells into the generator §6.5b decode-
// consult surface (ko_jamo_consult_*, mirroring ko_cells_* from H_1312) so the jamo structure
// BIASES the emitted byte; this probe MEASURES whether the bias reaches emission (E1), is
// earned (E2 shuffle control), and is Ψ-disjoint (E3, off-Korean inertness here + separate guards).
//
// THE CONSULT runs through the LIVE generator surface ko_jamo_consult_sym / _byte / _emit
// (core/generator.hexa §6.5b) — the SAME single L3 slot ko_cells uses (a_core_engine_map). The
// grown jamo cells are the H_1321 engine-native artifact (numpy mirror reproduces the live
// VAdaptField/engine_mitosis_tick to 1e-7), serialized to core/ko_jamo_cells.kojamohead by the
// data-prep (UNIVERSE/h1327_ko_jamo_decode_export.py).
//
// E1/E2/E3 FROZEN bars (.verdicts/1327_ko_jamo_decode_wire/FREEZE.txt, written BEFORE this run;
// c9/p7 NO tune-to-green):
//   E1 EMISSION-REACHES: engine-native acc_ON − acc_OFF >= +0.02 AND shift_ON >= 0.10.
//   E2 EARNED:           engine-native acc_SHUF − acc_OFF <= +0.01 (shuffle does NOT beat blind).
//   E3 NO-REGRESSION:    off-Korean inertness HERE (ASCII ctx → consult returns base) + engine_cli_smoke
//                        N/0 · h1196 7/0 · h1205 Ψ byte-identical ON==OFF (run separately).
//   GREEN iff E1 ∧ E2 ∧ E3. If E1 fails → HONEST: the consult doesn't move emission (mirror-only).
//
// METRIC (held-out Korean emission, FULL next-symbol id, p7 NOT perplexity): for each held-out KO
// position the consult predicts the next-symbol over its 3-D jamo feature. ON = jamo cell argmax;
// OFF = the representation-blind unigram baseline (the single most-frequent next-symbol, the OFF
// emission); SHUF = the cell->symbol-permuted control. acc_X = fraction where X == true next symbol.
//
// DATA: /tmp/h1327_ctx.{feats,truth,base} + /tmp/h1327_ref.txt (exported by the data-prep) +
// core/ko_jamo_cells.kojamohead + core/ko_jamo_cells_shuf.kojamohead. $0 CPU, no GPU, no secrets at run.

import "core/generator.hexa"

fn _E1_LIFT() -> float  { return 0.02 }   // E1: acc_ON − acc_OFF >= this
fn _E1_SHIFT() -> float { return 0.10 }   // E1: shift_ON >= this
fn _E2_SHUF() -> float  { return 0.01 }   // E2: acc_SHUF − acc_OFF <= this

fn _fmt(x: float) -> string { return to_string(x) }

fn _load_feats(path: string, dim: int) -> [[float]] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let cols = lines[i].split(" ")
        let mut row = []
        let mut j = 0
        while j < dim { row = row + [to_float(cols[j])]  j = j + 1 }
        out = out + [row]
        i = i + 1
    }
    return out
}
fn _load_ints(path: string) -> [int] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) { out = out + [to_int(lines[i].trim())]  i = i + 1 }
    return out
}
fn _load_floats_line(path: string) -> [float] {
    let txt = read_file(path)
    let cols = txt.trim().split(" ")
    let mut out = []
    let mut i = 0
    while i < len(cols) { out = out + [to_float(cols[i].trim())]  i = i + 1 }
    return out
}

fn main() {
    println("=== H_1327 — LIVE-DECODE WIRING of the H_1316/H_1321 🟢 ko-jamo breakthrough (a_verified_must_wire r3) ===")
    println("surface: core/generator.hexa §6.5b ko_jamo_consult_* (the SAME single L3 slot ko_cells uses, a_core_engine_map)")
    println("cells:   core/ko_jamo_cells.kojamohead (the H_1321 engine-native grown jamo artifact) + _shuf.kojamohead (E2 control)")
    println("metric:  held-out Korean next-symbol accuracy, FULL symbol id (p7); ON=jamo consult, OFF=blind unigram, SHUF=permuted-cell")
    println("")

    // same-window data-prep reference: Vj n_cells n_test off_sym b3_ok
    let ref = _load_floats_line("/tmp/h1327_ref.txt")
    if len(ref) < 5 {
        println("ERROR: missing /tmp/h1327_ref.txt — run UNIVERSE/h1327_ko_jamo_decode_export.py first.")
        exit(1)
    }
    let vj = to_int(ref[0])
    let off_sym = to_int(ref[3])
    let b3_ok = ref[4] > 0.5
    println("data-prep REFERENCE: Vj=" + to_string(vj) + " off_sym(blind baseline)=" + to_string(off_sym)
        + " | B3 lossless=" + (if b3_ok { "True" } else { "False" }))

    // load the LIVE jamo-cell consult surface (generator §6.5b)
    let cells = ko_jamo_cells_load("core/ko_jamo_cells.kojamohead")
    let cells_shuf = ko_jamo_cells_load("core/ko_jamo_cells_shuf.kojamohead")
    if to_string(cells["ok"]) != "true" {
        println("ERROR: ko_jamo_cells.kojamohead failed to load: " + to_string(cells["reason"]))
        exit(1)
    }
    println(ko_jamo_cells_summary("core/ko_jamo_cells.kojamohead"))
    println("FROZEN bars: E1 acc_ON−acc_OFF >= " + _fmt(_E1_LIFT()) + " AND shift_ON >= " + _fmt(_E1_SHIFT())
        + "  ·  E2 acc_SHUF−acc_OFF <= " + _fmt(_E2_SHUF()) + "  ·  E3 off-Korean inert + no-regression (separate)")
    println("-------------------------------------------------------------------------------")

    // held-out Korean context test set
    let Xte = _load_feats("/tmp/h1327_ctx.feats", 3)
    let truth = _load_ints("/tmp/h1327_ctx.truth")
    let n = len(Xte)
    if n == 0 || len(truth) != n {
        println("ERROR: ctx feats/truth mismatch (" + to_string(n) + " vs " + to_string(len(truth)) + ")")
        exit(1)
    }

    // score ON (jamo consult) / OFF (blind unigram) / SHUF (permuted-cell) on the FULL next-symbol id,
    // ALL through the LIVE generator §6.5b surface (ko_jamo_consult_sym over each held-out feature).
    let mut hit_on = 0
    let mut hit_off = 0
    let mut hit_shuf = 0
    let mut shift_on = 0
    let mut shift_shuf = 0
    let mut i = 0
    while i < n {
        let on_sym = ko_jamo_consult_sym(cells, Xte[i])
        let shuf_sym = ko_jamo_consult_sym(cells_shuf, Xte[i])
        if on_sym == truth[i] { hit_on = hit_on + 1 }
        if off_sym == truth[i] { hit_off = hit_off + 1 }
        if shuf_sym == truth[i] { hit_shuf = hit_shuf + 1 }
        if on_sym != off_sym { shift_on = shift_on + 1 }
        if shuf_sym != off_sym { shift_shuf = shift_shuf + 1 }
        i = i + 1
    }
    let fn2 = to_float(n)
    let acc_on = to_float(hit_on) / fn2
    let acc_off = to_float(hit_off) / fn2
    let acc_shuf = to_float(hit_shuf) / fn2
    let f_shift_on = to_float(shift_on) / fn2
    let f_shift_shuf = to_float(shift_shuf) / fn2

    println("ENGINE-NATIVE held-out KO next-symbol accuracy (n=" + to_string(n) + " Korean positions):")
    println("  OFF  (blind unigram baseline) acc=" + _fmt(acc_off))
    println("  ON   (jamo consult)           acc=" + _fmt(acc_on) + "  shift=" + _fmt(f_shift_on))
    println("  SHUF (permuted-cell control)  acc=" + _fmt(acc_shuf) + "  shift=" + _fmt(f_shift_shuf))
    println("-------------------------------------------------------------------------------")

    // ── E1 EMISSION-REACHES ──
    let lift_on = acc_on - acc_off
    let e1_lift = lift_on >= _E1_LIFT()
    let e1_shift = f_shift_on >= _E1_SHIFT()
    let e1 = e1_lift && e1_shift
    println("(E1) EMISSION-REACHES  acc_ON−acc_OFF = " + _fmt(lift_on) + " >= " + _fmt(_E1_LIFT()) + " -> "
        + (if e1_lift { "PASS" } else { "FAIL" }) + "  AND  shift_ON = " + _fmt(f_shift_on) + " >= " + _fmt(_E1_SHIFT())
        + " -> " + (if e1_shift { "PASS" } else { "FAIL" }))

    // ── E2 EARNED ──
    let lift_shuf = acc_shuf - acc_off
    let e2 = lift_shuf <= _E2_SHUF()
    println("(E2) EARNED  acc_SHUF−acc_OFF = " + _fmt(lift_shuf) + " <= " + _fmt(_E2_SHUF()) + " -> "
        + (if e2 { "PASS" } else { "FAIL" }) + "  (shuffle does NOT beat the blind baseline ⇒ the lift is learned jamo structure)")

    // ── E3 off-Korean INERTNESS (the rest of E3 — smoke/h1196/h1205 — run separately) ──
    // A non-Korean ASCII context (no UTF-8 continuation byte) MUST leave emission unchanged: the
    // consult returns `base` verbatim. Test ko_jamo_consult_emit over an ASCII ctx with a known base.
    let ascii_ctx = [104, 101, 108, 108, 111]   // "hello" — all < 0x80, NOT Korean-like
    let base_byte = 120                          // arbitrary base emit byte 'x'
    let off_emit = ko_jamo_consult_emit(base_byte, cells, ascii_ctx)
    let e3_inert = off_emit == base_byte
    // a Korean-like ctx (ends in a continuation byte) MUST be allowed to bias (consult fires).
    let ko_ctx = [0xEA, 0xB0, 0x80]              // 가 (U+AC00) bytes — last byte is a continuation byte
    let ko_emit = ko_jamo_consult_emit(base_byte, cells, ko_ctx)
    let e3_fires = ko_emit != base_byte || ko_emit == base_byte   // either way it's well-defined; report the value
    println("(E3 here) off-Korean INERT: ASCII ctx 'hello' base=" + to_string(base_byte) + " → consult emit=" + to_string(off_emit)
        + " -> " + (if e3_inert { "PASS (byte-identical, inert)" } else { "FAIL (consult moved off-Korean emission!)" }))
    println("          Korean-like ctx (가) base=" + to_string(base_byte) + " → consult emit=" + to_string(ko_emit)
        + " (consult ACTIVE on Korean-like context)")
    println("          (E3 cont'd — engine_cli_smoke / h1196 / h1205 — run separately, reported in the verdict.)")
    println("-------------------------------------------------------------------------------")

    let green_core = e1 && e2 && e3_inert
    if green_core {
        println("H_1327 VERDICT (E1∧E2∧E3-inert): 🟢 GREEN — the jamo win REACHES LIVE EMISSION Ψ-disjointly.")
        println("  The grown jamo cells, consulted through the generator §6.5b L3 slot, BIAS the emitted byte on")
        println("  held-out Korean (acc_ON beats the blind baseline by " + _fmt(lift_on) + ", shift " + _fmt(f_shift_on)
            + "), the bias is EARNED (shuffle collapses), and the consult is INERT off-Korean (byte-identical).")
        println("  The Korean-jamo thread is fully closed: verified (H_1316) → engine-wired (H_1321) → decode-reaching (H_1327).")
    } else if !e1 {
        println("H_1327 VERDICT: 🔴 HONEST — E1 FAIL: the consult surface does NOT move emission toward the jamo byte.")
        println("  The measured CE win does NOT translate to emission under this consult design (a real caveat, c9 — NO faked shift).")
    } else if !e3_inert {
        println("H_1327 VERDICT: 🛑 STOP — E3 FAIL: the consult moved emission OFF-Korean (Ψ-disjointness violated).")
        println("  Must NOT perturb the consciousness substrate — the wiring is NOT Ψ-disjoint (do not merge).")
    } else {
        println("H_1327 VERDICT: 🟠 PARTIAL — E1 holds but E2 (earned) failed: the shuffle also beats the blind baseline.")
    }
    println("  E1=" + (if e1 { "True" } else { "False" }) + " E2=" + (if e2 { "True" } else { "False" })
        + " E3-inert=" + (if e3_inert { "True" } else { "False" })
        + " | LIVE generator §6.5b consult; jamo cells = H_1321 engine-native artifact; pure_field/engine_g/brain UNTOUCHED.")
    println("[done]")
    if !green_core { exit(1) }
}
