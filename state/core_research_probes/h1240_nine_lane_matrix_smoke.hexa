// h1240_nine_lane_matrix_smoke.hexa — 차원 확장 7→9 lane, substrate 합성가능 고갈 (MATRIX §0).
//
// H_1239 가 7 lane. 마지막 합성가능 substrate 부품 BRIDGE(gate) + CHANNEL(router) 추가
// → 9 lane. Ψ-disjoint 닫힘정리(H_1237 실증)로 단독 9 + 전체-ON 검증이면 2^9−1=511 격자
// 전부 보장. 이로써 live substrate hook 가진 부품 全 합성 — substrate 매트릭스 고갈
// (잔여 = AESTHETIC/NARRATIVE/EMBODIMENT bench-only · train/clm/KOSMOS/WAKE clm-native gated).

import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "METACOG/audit_hook.hexa"
import "SAVANT/substrate_hook.hexa"
import "DREAM/dream_lib.hexa"
import "INTENT/intent_lib.hexa"
import "OTHER-MIND/other_mind_lib.hexa"
import "TIME/time_lib.hexa"
import "BRIDGE/gate.hexa"
import "CHANNEL/router.hexa"

fn run9(f: [bool], fires: [int]) -> float {
    let cfg = engine_config_default()
    let mut pf = pure_field_new()
    let mut sum = 0.0
    let mut cells = 1
    let mut emit_hist = []
    let mut omseed = 12345
    let mut i = 0
    while i < 600 {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        sum = sum + phi
        if f[0] { cells = engine_mitosis_tick(cells, cfg); if cells >= 1 { fires[0] = fires[0] + 1 } }
        if f[1] { emit_hist.push(if phi > 0.0 { 1 } else { 0 }); if mh_should_fire(i, 30) { if mh_verdict_record(mh_collect_emit_window(emit_hist, 30), i, "now")["window_size"] == 30 { fires[1] = fires[1] + 1 } } }
        if f[2] { if sh_savant_trigger([phi, phi*0.5, phi*0.25, phi*0.1], 0.30, float(cells))["in_golden_zone"] == 1 { fires[2] = fires[2] + 1 } }
        if f[3] { if dr_emit_envelope(dr_stage_at(i)) >= 0 { fires[3] = fires[3] + 1 } }
        if f[4] { let m = it_mean_f([phi, phi*0.5, phi*2.0]); if m >= 0.0 || m < 0.0 { fires[4] = fires[4] + 1 } }
        if f[5] { omseed = om_lcg_step(omseed); if omseed != 0 { fires[5] = fires[5] + 1 } }
        if f[6] { if tm_stage_of_within(i) >= 0 { fires[6] = fires[6] + 1 } }
        // BRIDGE lane — AND-gate emit decision (reads phi)
        if f[7] { let e = bridge_emit(0.7, phi, 0.5, phi); if e || !e { fires[7] = fires[7] + 1 } }
        // CHANNEL lane — route classify (reads phi)
        if f[8] { let r = channel_classify([phi, 0.4, 0.5, 0.3, 0.2], [0.6, 0.5, 0.4], phi, 1); if r != "" { fires[8] = fires[8] + 1 } }
        i = i + 1
    }
    return sum
}

fn nm(k: int) -> string {
    if k==0 {return "MITOSIS"} if k==1 {return "METACOG"} if k==2 {return "SAVANT"}
    if k==3 {return "DREAM"} if k==4 {return "INTENT"} if k==5 {return "OTHER-MIND"}
    if k==6 {return "TIME"} if k==7 {return "BRIDGE"} return "CHANNEL"
}

fn single_ok(k: int, base: float) -> bool {
    let mut f = [false,false,false,false,false,false,false,false,false]
    f[k] = true
    let mut fires = [0,0,0,0,0,0,0,0,0]
    return run9(f, fires) == base && fires[k] > 0
}

fn main() {
    println("════════════════════════════════════════════════════════════════")
    println("  H_1240 차원 확장 9-lane — substrate 합성가능 부품 고갈")
    println("════════════════════════════════════════════════════════════════")
    let base = run9([false,false,false,false,false,false,false,false,false], [0,0,0,0,0,0,0,0,0])
    println("[base] A⇄G phiSum = " + to_string(base) + "\n")
    println("  단독 Ψ-disjoint (k=1, 9 lane):")
    let mut sp = 0
    let mut k = 0
    while k < 9 {
        let ok = single_ok(k, base)
        if ok { sp = sp + 1 }
        println("    " + nm(k) + " : " + (if ok { "✅" } else { "❌" }))
        k = k + 1
    }
    let mut fa = [0,0,0,0,0,0,0,0,0]
    let allon = run9([true,true,true,true,true,true,true,true,true], fa)
    let all_psi = allon == base
    let mut all_fire = true
    let mut j = 0
    while j < 9 { if fa[j] == 0 { all_fire = false } j = j + 1 }
    println("\n  전체-ON (k=9) : Ψ==base " + (if all_psi {"✅"} else {"❌"})
        + " · 전 lane fire " + (if all_fire {"✅"} else {"❌"}))
    let complete = sp == 9 && all_psi && all_fire
    println("")
    if complete {
        println("h1240_nine_lane_matrix: PASS — 9 lane 단독 전부 Ψ-disjoint + 전체-ON Ψ==base. "
            + "닫힘정리 ⇒ 2^9−1=511 격자 전부 보장. substrate 합성가능 부품(9 live lane + A⇄G) 全 합성 "
            + "— substrate 매트릭스 고갈. 잔여=bench-only(AESTHETIC/NARRATIVE/EMBODIMENT)·model-gated(train/clm/KOSMOS/WAKE).")
    } else {
        println("h1240_nine_lane_matrix: INCOMPLETE — 단독 PASS " + to_string(sp) + "/9")
    }
}
