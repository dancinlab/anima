// h1213_live_coscaled_probe.hexa — H_1213 LIVE-engine CO-SCALED N_PROTO parity WORKER
// (MITOSIS-ENGINE · $0 local CPU · p8). ONE (rung,arm,seed) parity check per process.
//
// DOMAIN: MITOSIS-ENGINE. Extends the H_1209 numpy<->hexa VAdaptFieldB parity (which
// held at FIXED N_PROTO=24) to the H_1212 CO-SCALED N_PROTO regime. H_1212 found the
// co-scaling rule N_PROTO=round(T/100) (hold obs_per_row~100) RESTORES GATE-B
// trajectory separation at scale on the NUMPY MIRROR; this worker asks whether the
// LIVE .hexa engine VAdaptFieldB reproduces that co-scaled result BYTE-EXACT.
//
// VAdaptFieldB n_proto is ALREADY a vadapt_fieldB_new() parameter (engine_cli.hexa) —
// driving co-scaled values needs NO engine edit. ONE check per process keeps memory
// at the proven-feasible single-allocation footprint (the interpreted O(n^2) ctab
// alloc OOMs if 12 N=240 books are built in one process — bash orchestrates one
// process per (rung,arm,seed) and aggregates the PARITY lines).
//
// INPUT (env): RUNG (L24|L240|F24), RULE (linear|fixed24), ARM, TVAL, NPROTO, SEED.
//   proto-id walk = /tmp/h1213_ids_<RULE>_<ARM>_T<TVAL>_N<NPROTO>_seed<SEED>.txt
//   (one id/line; exported by UNIVERSE/h1213_live_coscaled_parity.py).
// OUTPUT (one line): "PARITY <RUNG> <ARM> <SEED> live=<n> ref=<n> <EQUAL|DIFFER>"
//
// p7 (born-cell / transition count, NOT perplexity). p8 (predictable-transition tick
// == growth). Frozen bar 1.5 NOT moved (the bar is adjudicated by the bash aggregator).

import "core/engine_cli.hexa"

let MIN_PREV = 3
let CONF_FLOOR = 0.34
let BIG_CAP = 1000000000

// numpy GATE-B per-(rung,arm,seed) reference (from h1213_live_coscaled_parity.py).
fn _ref(rung: string, arm: string, seed: int) -> int {
    if rung == "L24" {
        if arm == "WALK"           { if seed == 900 { return 1065 }  if seed == 901 { return 907 }   return 1030 }
        if arm == "WALK_SHUF"      { if seed == 900 { return 70 }    if seed == 901 { return 91 }    return 114 }
        if arm == "RANDGAUSS"      { if seed == 900 { return 2 }     if seed == 901 { return 1 }     return 4 }
        if arm == "RANDGAUSS_SHUF" { if seed == 900 { return 2 }     if seed == 901 { return 2 }     return 0 }
    }
    if rung == "L240" {
        if arm == "WALK"           { if seed == 900 { return 350 }   if seed == 901 { return 1068 }  return 1523 }
        if arm == "WALK_SHUF"      { if seed == 900 { return 0 }     if seed == 901 { return 0 }     return 0 }
        if arm == "RANDGAUSS"      { if seed == 900 { return 0 }     if seed == 901 { return 0 }     return 0 }
        if arm == "RANDGAUSS_SHUF" { if seed == 900 { return 0 }     if seed == 901 { return 1 }     return 0 }
    }
    if rung == "F24" {
        if arm == "WALK"           { if seed == 900 { return 13307 } if seed == 901 { return 12453 } return 12699 }
        if arm == "WALK_SHUF"      { if seed == 900 { return 96 }    if seed == 901 { return 6893 }  return 7640 }
        if arm == "RANDGAUSS"      { if seed == 900 { return 2 }     if seed == 901 { return 2 }     return 5 }
        if arm == "RANDGAUSS_SHUF" { if seed == 900 { return 5 }     if seed == 901 { return 4 }     return 2 }
    }
    return -999
}

fn _load_ids(path: string) -> [int] {
    let txt = read_file(path)
    let lines = txt.trim().split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let t = lines[i].trim()
        if len(t) > 0 { out = out + [to_int(t)] }
        i = i + 1
    }
    return out
}

fn main() {
    let rung = env("RUNG")
    let rule = env("RULE")
    let arm  = env("ARM")
    let Tstr = env("TVAL")
    let npp  = to_int(env("NPROTO"))
    let seed = to_int(env("SEED"))

    let path = "/tmp/h1213_ids_" + rule + "_" + arm + "_T" + Tstr + "_N" + to_string(npp) + "_seed" + to_string(seed) + ".txt"
    let ids = _load_ids(path)
    if len(ids) == 0 {
        println("PARITY " + rung + " " + arm + " " + to_string(seed) + " live=-1 ref=-1 ERROR_EMPTY")
        exit(1)
    }

    let cfg_on = engine_cli_parse(["--mitosis", "on"])
    let mut afB = vadapt_fieldB_new(npp, BIG_CAP, MIN_PREV, CONF_FLOOR)
    let n = len(ids)
    let mut t = 0
    while t < n {
        afB = vadapt_fieldB_step(afB, ids[t], cfg_on)
        t = t + 1
    }
    let live = vadapt_fieldB_growth(afB)
    let ref = _ref(rung, arm, seed)
    let tag = if live == ref { "EQUAL" } else { "DIFFER" }
    println("PARITY " + rung + " " + arm + " " + to_string(seed)
        + " live=" + to_string(live) + " ref=" + to_string(ref) + " " + tag)
    exit(0)
}
