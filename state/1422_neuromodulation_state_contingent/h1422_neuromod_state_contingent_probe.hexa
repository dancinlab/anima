// h1422_neuromod_state_contingent_probe.hexa — H_1422: MULTI-LENS breakthrough attempt
// on the NEUROMODULATION WALL (H_1284 🔴 RED / 🧱 "no free lunch"), realized ENGINE-NATIVE
// on the LIVE engine (CORE/engine_cli.hexa immune_memory_* recall faculty + live recall
// margin / top-2 gap reads). a_break_the_wall (strengthened) · a_no_llm_frame_trap ·
// a_engine_native_learning · $0 CPU · p7 · p8.
//
// WALL (H_1284, verbatim): a GLOBAL per-tick neuromodulatory schedule on a clean key-
// addressed store is INERT-to-HARMFUL vs the best FIXED hyperparameters (C-SHUF ≈ B
// everywhere: knob-VARIETY not state→knob COUPLING; a single tuned fixed point dominates).
//
// BREAKTHROUGH ANGLE (biology, a_no_llm_frame_trap): neuromodulation is NOT a continuous
// global gain — it is a DISCRETE regime-DETECTOR that deviates from the fixed point ONLY
// when a LIVE substrate signal crosses a threshold (ACh on cholinergic novelty, NE phasic
// burst on uncertainty, DA on prediction-error). The deviation is GATED. Gate OFF ⇒ revert
// EXACTLY to the fixed point (H_1284's null). The conditioning is then LOAD-BEARING:
// ablation (gate forced ON every tick = global schedule) MUST revert to the no-free-lunch
// null — proving the GATE (state-contingency) is the load-bearing mechanism.
//
// NON-DEGENERATE FIXTURE (a_break_the_wall taxonomy (a): NO degenerate slice): the store is
// probed with a MIX of clean / corrupted-recoverable (1-2 byte key corruption → the right
// cell is still nearest, margin pushed up) / ghost (genuinely-absent) keys, so the FIXED
// abstain thr faces a REAL precision/recall tradeoff (a too-tight thr abstains on recoverable
// facts = lost recall; a too-loose thr fabricates on ghosts). A = the BEST FIXED thr SWEPT
// over a grid (the strongest honest fixed baseline). The state-contingent lenses then have
// genuine headroom: can a gate that reads a LIVE signal beat the single best thr?
//
// THREE LENSES (each conditions the LIVE knob on a DIFFERENT live engine signal):
//   L1 SURPRISE-GATED (ACh): LOOSEN the abstain thr ONLY when the live recall-MARGIN says
//      the probe is a recoverable near-miss (margin in the recoverable band), TIGHTEN on a
//      far ghost — recover corrupted facts without fabricating on absent ones.
//   L2 AMBIGUITY-GATED (NE): TIGHTEN the abstain thr ONLY when the live top-2 GAP is small
//      (two cells tie ⇒ ambiguous → abstain rather than guess a likely-wrong fire).
//   L3 DRIFT-GATED (DA): eagerly RE-BIND ONLY when a witnessed value contradicts the live
//      recall (prediction-error ⇒ fast unlearn the stale fact); else leave the store.
// Each scored vs A (best FIXED), with SHUFFLE (permute the gate decisions → collapse) AND
// ABLATION (gate OFF = deviation every tick = H_1284 global schedule null).
//
// FROZEN bars (verbatim H_1284): MARGIN=0.05, CAP = recall_acc − fab_rate, GREEN iff
// B≥A+0.05 on ≥2 regimes AND B.fab≤A.fab on wins AND C-SHUF<B−0.05 AND ablation≈A.
// p7 (no loss; gates are no-grad reads of live state). p8 (the engine's own tick).
// p1/p2/p3/p6 (the true value scores the metric only; NEVER enters a gate or knob).
// Ψ-disjoint (pure read + the store's own write; pure_field Φ/phase/Ψ untouched).

import "CORE/engine_cli.hexa"

fn _f(x: float) -> string { return to_string(x) }

const N_FACTS: int = 24
const N_EVENTS: int = 200

fn _subj(i: int) -> string { return "subj" + to_string(i) }
fn _city(seed: int, i: int) -> string {
    let h = (i * 131 + seed * 17) % 9973
    return "city" + to_string(h)
}
fn _drift_city(seed: int, i: int) -> string {
    let h = (i * 251 + seed * 29 + 7) % 9973
    return "city" + to_string(h)
}
// byte-key corruption: a recoverable near-miss (right cell still nearest, margin pushed up).
fn _noisy(s: string, lvl: int) -> string {
    if lvl == 0 { return s }
    if lvl == 1 { return s + "q" }
    return s + "qx"
}

fn _lcg(s: int) -> int { return (s * 1103515245 + 12345) % 2147483647 }
fn _is_drift(seed: int, i: int) -> bool { return (i * 7 + seed) % 5 < 1 }

fn _set_thr(mem: ImmuneMemory, thr: float) -> ImmuneMemory {
    return ImmuneMemory { field: mem.field, cell_value: mem.cell_value, recall_thr: thr }
}

// the LIVE recoverable-band edges (read off the diagnostic): a 1-2 byte corrupted in-store
// key lands margin ~0.37-0.52; a genuine ghost lands margin ~1.26. The recoverable band is
// (0, GHOST_FLOOR). The fixed thr cannot place itself per-probe; the gate can.
const GHOST_FLOOR: float = 0.90       // margin above this ⇒ treat as ghost (TIGHTEN)
const GAP_BAR: float     = 0.20       // top-2 gap below this ⇒ ambiguous (L2 gate)
const THR_TIGHT: float   = 0.15       // strict thr when the gate says "ghost / ambiguous"
const THR_LOOSE: float   = 0.70       // loose thr when the gate says "recoverable near-miss"

// build the taught store on the LIVE immune_memory faculty.
fn _build(seed: int) -> ImmuneMemory {
    let cfg = engine_config_default()
    let mut mem = immune_memory_new(immune_embed_key(_subj(0)), _city(seed, 0), 24)
    let mut i = 1
    while i < N_FACTS {
        mem = immune_memory_bind(mem, immune_embed_key(_subj(i)), _city(seed, i), cfg)
        i = i + 1
    }
    return mem
}

// the per-probe LIVE gate-chosen thr (lens 1/2). reads ONLY live margin/gap (no truth label).
fn _gated_thr(mem: ImmuneMemory, key: [float], lens: int) -> float {
    if lens == 1 {
        // ACh surprise: LOOSEN on a recoverable near-miss (margin below ghost-floor), TIGHTEN
        // on a far ghost. The fixed thr cannot do this per-probe; the gate reads the live margin.
        if immune_memory_recall_margin(mem, key) < GHOST_FLOOR { return THR_LOOSE }
        return THR_TIGHT
    }
    if lens == 2 {
        // NE ambiguity: TIGHTEN when the top-2 gap is small (ambiguous), else the loose thr.
        if immune_memory_recall_gap(mem, key) < GAP_BAR { return THR_TIGHT }
        return THR_LOOSE
    }
    return THR_LOOSE
}

// ── one regime run. lens: 0=A · 1=L1 · 2=L2 · 3=L3.  mode: 0=live · 1=shuffle · 2=ablate.
// A (lens 0) sweeps the best FIXED thr over a grid and uses it. returns [acc, fab].
fn run_arm(seed: int, regime: int, lens: int, mode: int, fixed_thr: float) -> [float] {
    let cfg = engine_config_default()
    let mut mem = _build(seed)

    // dry pass: harvest the LIVE gate-firing (loose-thr) rate for the shuffle control.
    let mut fire_count = 0
    let mut rng = _lcg(seed * 131 + regime * 17 + 3)
    let mut t = 0
    while t < N_EVENTS {
        rng = _lcg(rng)
        let qi = rng % N_FACTS
        let key = immune_embed_key(_subj(qi))
        if mode == 0 && (lens == 1 || lens == 2) {
            if _gated_thr(mem, key, lens) == THR_LOOSE { fire_count = fire_count + 1 }
        }
        if mode == 0 && lens == 3 {
            if _is_drift(seed, qi) { fire_count = fire_count + 1 }
        }
        t = t + 1
    }

    let mut n_recall = 0
    let mut n_correct = 0
    let mut n_fab = 0
    rng = _lcg(seed * 131 + regime * 17 + 3)
    let mut drift_done = false
    t = 0
    while t < N_EVENTS {
        if regime == 1 && t == (N_EVENTS / 2) && !drift_done {
            let mut j = 0
            while j < N_FACTS {
                if _is_drift(seed, j) {
                    mem = immune_memory_bind(mem, immune_embed_key(_subj(j)), _drift_city(seed, j), cfg)
                }
                j = j + 1
            }
            drift_done = true
        }

        rng = _lcg(rng)
        let qi = rng % N_FACTS
        let kind = (rng / 7) % 3                 // 0=clean · 1=corrupted-recoverable · 2=ghost
        let oos = kind == 2
        let lvl = if kind == 1 { (if regime == 2 { 2 } else { 1 }) } else { 0 }
        let key = if oos { immune_embed_key("ghost" + to_string(qi) + "zz") }
                  else { immune_embed_key(_noisy(_subj(qi), lvl)) }

        if lens == 3 {
            // L3 (DA): eager re-bind under the gate. live = re-bind drifted facts (done at
            // midpoint; lift = eager write helps). ablation = churn every tick (re-bind a
            // NON-drifted fact = destabilize good bindings = H_1284 null). shuffle = matched-
            // rate churn on a decorrelated target.
            let mut fires = false
            if mode == 2 { fires = true }
            else if mode == 1 { let perm = (t * 13 + 5) % N_EVENTS  if perm < fire_count { fires = true } }
            else { if _is_drift(seed, qi) { fires = true } }
            if fires && mode == 2 {
                mem = immune_memory_bind(mem, immune_embed_key(_subj(qi)), _city(seed, qi), cfg)
            }
            if fires && mode == 1 {
                let tgt = (qi * 3 + 1) % N_FACTS
                mem = immune_memory_bind(mem, immune_embed_key(_subj(tgt)), _city(seed, tgt), cfg)
            }
            mem = _set_thr(mem, fixed_thr)
        } else if lens == 0 {
            mem = _set_thr(mem, fixed_thr)       // best FIXED thr (swept)
        } else {
            // L1/L2 state-contingent gate.
            let mut thr = THR_LOOSE
            if mode == 2 {
                // ABLATION: gate forced ON every tick = the loose deviation applied globally
                // (= H_1284's global schedule, no state-contingency).
                thr = THR_LOOSE
            } else if mode == 1 {
                // SHUFFLE: loose on a decorrelated index set of the SAME cardinality; else tight.
                let perm = (t * 13 + 5) % N_EVENTS
                thr = if perm < fire_count { THR_LOOSE } else { THR_TIGHT }
            } else {
                thr = _gated_thr(mem, key, lens)  // LIVE gate
            }
            mem = _set_thr(mem, thr)
        }

        n_recall = n_recall + 1
        let pred = immune_memory_recall(mem, key)
        if oos {
            if pred != "" { n_fab = n_fab + 1 }
        } else {
            let drifted = regime == 1 && drift_done && _is_drift(seed, qi)
            let truth = if drifted { _drift_city(seed, qi) } else { _city(seed, qi) }
            if pred == truth { n_correct = n_correct + 1 }
            else if pred != "" { n_fab = n_fab + 1 }
        }
        t = t + 1
    }
    let acc = (n_correct + 0.0) / (n_recall + 0.0)
    let fab = (n_fab + 0.0) / (n_recall + 0.0)
    return [acc, fab]
}

// best FIXED thr: sweep a grid on this regime, return the thr maximizing mean cap over seeds.
fn best_fixed_thr(regime: int) -> float {
    let grid = [0.15, 0.30, 0.45, 0.60, 0.70, 0.85, 1.00]
    let seeds = [1422, 1423, 1424]
    let mut best_thr = 0.15
    let mut best_cap = 0.0 - 99.0
    let mut gi = 0
    while gi < 7 {
        let mut s = 0.0
        let mut si = 0
        while si < 3 {
            let r = run_arm(seeds[si], regime, 0, 0, grid[gi])
            s = s + (r[0] - r[1])
            si = si + 1
        }
        let c = s / 3.0
        if c > best_cap { best_cap = c  best_thr = grid[gi] }
        gi = gi + 1
    }
    return best_thr
}

fn cap3(regime: int, lens: int, mode: int, fixed_thr: float) -> float {
    let seeds = [1422, 1423, 1424]
    let mut s = 0.0
    let mut si = 0
    while si < 3 { let r = run_arm(seeds[si], regime, lens, mode, fixed_thr)  s = s + (r[0] - r[1])  si = si + 1 }
    return s / 3.0
}
fn fab3(regime: int, lens: int, mode: int, fixed_thr: float) -> float {
    let seeds = [1422, 1423, 1424]
    let mut s = 0.0
    let mut si = 0
    while si < 3 { let r = run_arm(seeds[si], regime, lens, mode, fixed_thr)  s = s + r[1]  si = si + 1 }
    return s / 3.0
}

fn _eval_lens(name: string, lens: int, bft: [float]) -> bool {
    println("")
    println("=== LENS " + name + " ===")
    println("  regime        A_cap     B_cap    B-A      CSHUF    ABLATE   A_fab  B_fab")
    let mut wins = 0
    let mut fab_ok = true
    let mut never_worse = true
    let mut shuf_sep = true
    let mut ablate_reverts = true
    let rnames = ["R1_STABLE", "R2_DRIFT ", "R3_NOISE "]
    let mut ri = 0
    while ri < 3 {
        let ft = bft[ri]
        let a  = cap3(ri, 0, 0, ft)
        let b  = cap3(ri, lens, 0, ft)
        let cs = cap3(ri, lens, 1, ft)
        let ab = cap3(ri, lens, 2, ft)
        let af = fab3(ri, 0, 0, ft)
        let bf = fab3(ri, lens, 0, ft)
        println("  " + rnames[ri] + "  " + _f(a) + "  " + _f(b) + "  " + _f(b - a)
            + "  " + _f(cs) + "  " + _f(ab) + "  " + _f(af) + "  " + _f(bf))
        if b >= a + 0.05 {
            wins = wins + 1
            if bf > af { fab_ok = false }
            if cs >= b - 0.05 { shuf_sep = false }
        }
        if (a - b) > 0.02 { never_worse = false }
        let abl_gap = ab - a
        let abl_abs = if abl_gap < 0.0 { 0.0 - abl_gap } else { abl_gap }
        if abl_abs > 0.05 { ablate_reverts = false }
        ri = ri + 1
    }
    let green = wins >= 2 && fab_ok && never_worse && shuf_sep && ablate_reverts
    println("  → wins=" + to_string(wins) + " fab_ok=" + (if fab_ok {"T"} else {"F"})
        + " never_worse=" + (if never_worse {"T"} else {"F"})
        + " shuf_sep=" + (if shuf_sep {"T"} else {"F"})
        + " ablate_reverts_to_A=" + (if ablate_reverts {"T"} else {"F"}))
    println("  → LENS " + name + ": " + (if green { "🟢 BINDS" } else { "🧱 WALL" }))
    return green
}

fn main() {
    println("H_1422 — NEUROMODULATION WALL, MULTI-LENS BREAKTHROUGH ATTEMPT (state-contingent)")
    println("================================================================================")
    println("live faculty: immune_memory_* + live recall_margin / recall_gap | CORE/engine_cli.hexa")
    println("frozen bars: .verdicts/1422_neuromodulation_state_contingent/FREEZE.txt (NOT moved)")
    println("NON-degenerate fixture: clean/corrupted-recoverable/ghost mix ⇒ real precision/recall")
    println("tradeoff. A = BEST FIXED thr SWEPT over a grid (strongest honest baseline).")
    println("3 seeds [1422,1423,1424]. p7 · p8 · $0 CPU. MARGIN=0.05.")
    println("GREEN iff B>=A+0.05 on >=2 regimes AND B.fab<=A.fab AND shuffle collapses AND")
    println("ablation (gate always ON = H_1284 global schedule) REVERTS to ~A.")

    // best FIXED thr per regime (swept once; the strongest honest A).
    let bft = [best_fixed_thr(0), best_fixed_thr(1), best_fixed_thr(2)]
    println("")
    println("best FIXED thr (swept): R1=" + _f(bft[0]) + " R2=" + _f(bft[1]) + " R3=" + _f(bft[2]))

    let g1 = _eval_lens("L1 SURPRISE-GATED (ACh, loosen on recoverable near-miss)", 1, bft)
    let g2 = _eval_lens("L2 AMBIGUITY-GATED (NE, tighten on small top-2 gap)", 2, bft)
    let g3 = _eval_lens("L3 DRIFT-GATED (DA, prediction-error re-bind)", 3, bft)

    println("")
    println("================================================================================")
    if g1 || g2 || g3 {
        println("VERDICT: 🟢 BREAKTHROUGH — at least one state-contingent lens BINDS.")
    } else {
        println("VERDICT: 🧱 CONFIDENT-TERMINAL (NO FREE LUNCH HELD) — all 3 state-contingent")
        println("  lenses FAIL their controls vs the best SWEPT fixed thr. The H_1284 wall is a")
        println("  REAL ceiling: on a key-addressed store the abstain decision is ALREADY a")
        println("  threshold on the live margin, so conditioning the threshold on that same")
        println("  margin is circular — it cannot beat the single best threshold. Per-lens")
        println("  ablation / shuffle evidence above (c9, a_break_the_wall).")
    }
    println("================================================================================")
}
