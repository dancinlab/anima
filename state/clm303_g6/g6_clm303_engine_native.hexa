// ⚠️ SUPERSEDED by anima eval single-entry (cli/anima.hexa -- eval) per PR #2603/#2605/#2607.
// This G6-only side-harness is NOT a 박제 path (side-harness=production-drift). Kept for audit only.
// clm303 verdict = H_1579 (🔴 serialization defect; eval not run). See state/clm303_g6/GARBLE_3WAY_RESULT.md.
import "core/g6_ideation.hexa"

// g6_clm303_engine_native.hexa — FULLY engine-native G6 frozen 5-bar for clm303 (.clm 388M
// savant+mitosis). Decode AND scoring both go through WIRED engine ops (NO python, NO torch):
//   · decode  = gen_clm_ideate_W / g6_decode_best_of_k_W  → generator L3 .clm slot
//               (gen_clm_ideate) → core/clm_decode.hexa (clm_decode_topk_sampled_W).
//               LOAD-ONCE via clm_load_weights (388M ConvMoE loaded once for all decodes —
//               the hexa bump allocator never frees a model load, so per-decode reload OOMs).
//   · score   = _g6_is_falsifiable / _g6_known_word_ratio / _g6_jaccard  (engine .hexa ops,
//               FROZEN H_1305/H_1362 detector sets VERBATIM).
// a_engine_native_learning: single path, no mirror. a_core_engine_map: .clm enters via the
// ONE generator L3 slot. Bars FROZEN-first (no tune-to-green): G0 coh KWR>=0.5 · B1/B4 FALS>=1
// · B2 DIST>=5 (recombination) · B3 cross-shuffle collapse (FALS_composed > FALS_shuffled =
// earned binding not form) · B5 ablate-control (composed > ablated). Prints per-frame inline
// (a_cpu_local_no_waiter — harvestable on poll, no Monitor).
//
// argv: <clm_path> [gen] [k] [seed]  (defaults gen=110 k=3 seed=7 — match H_1464 arm)
fn main() {
    let a = argv()
    let mut b = 0
    let mut i = 0
    while i < len(a) { if a[i] == "--" { b = i + 1 } i = i + 1 }
    let ckpt = a[b + 0]
    let GEN = if len(a) > b + 1 { to_int(a[b + 1]) } else { 110 }
    let K   = if len(a) > b + 2 { to_int(a[b + 2]) } else { 3 }
    let SEED = if len(a) > b + 3 { to_int(a[b + 3]) } else { 7 }

    let cu = cuda_available()
    if cu == 1 { println("cuda_available: 1 -> forge own-GEMM DEVICE path") }
    else       { println("cuda_available: 0 -> farr CPU path (single-thread scalar, HONEST)") }

    if !clm_decodable(ckpt) {
        println("CLM_NOT_DECODABLE " + ckpt + " (no CLMX trailer)")
        return
    }
    let known = _g6_dict_load()
    println("CKPT=" + ckpt + " GEN=" + to_string(GEN) + " K=" + to_string(K) + " SEED=" + to_string(SEED))
    println("DETECTOR_CALIBRATION=" + to_string(g6_detector_calibration(known)) + "/10")

    let fr = g6_build_frames(6)
    let comp = fr["composed"]
    let shuf = fr["shuffled"]
    let abla = fr["ablated"]
    println("FRAME_GUARD_LEAKS=" + to_string(len(g6_frame_guard(comp, known))) + " (must be 0, p7)")
    let st = g6_sampler_selftest()
    println("SAMPLER det=" + to_string(st["deterministic"]) + " diverse=" + to_string(st["diverse"]) + " in_topk=" + to_string(st["in_topk"]))

    // LOAD 388M ConvMoE ONCE (clm_load_weights) — all decodes off the resident W.
    println("[load] clm_load_weights " + ckpt + " ...")
    let t_load = now_ms()
    let W = clm_load_weights(ckpt)
    println("[load] done ms=" + to_string(now_ms() - t_load))

    // ── ARM composed (best-of-K) — the primary FALS/DIST/coh read ──
    println("=== ARM composed (6 frames x K=" + to_string(K) + ", GEN=" + to_string(GEN) + ", seed=" + to_string(SEED) + ") ===")
    let mut fals_c = 0
    let csets = []
    let mut ci = 0
    while ci < len(comp) {
        let t0 = now_ms()
        let o = g6_decode_best_of_k_W(W, to_string(comp[ci]), GEN, K, SEED, known)
        let kwr = _g6_known_word_ratio(o, known)
        let mut isf = false
        if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
        if kwr >= 0.5 { csets.push(_g6_words(o)) }
        if isf { fals_c = fals_c + 1 }
        println("COMP[" + to_string(ci) + "] fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
        ci = ci + 1
    }
    // greedy distinctness (jaccard <= 0.5) = B2 recombination COUNT
    let kept = []
    let mut w = 0
    while w < len(csets) {
        let ws = csets[w]; let mut ok = true; let mut kk = 0
        while kk < len(kept) { if _g6_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    let DIST = len(kept)
    println("COMP DIST=" + to_string(DIST) + " FALS=" + to_string(fals_c) + " coh=" + to_string(len(csets)) + "/6")

    // ── ARM shuffled (B3 cross-shuffle control) — same K, deranged measurable concept ──
    println("=== ARM shuffled (B3 control, 6 frames x K=" + to_string(K) + ") ===")
    let mut fals_s = 0
    let mut si = 0
    while si < len(shuf) {
        let t0 = now_ms()
        let o = g6_decode_best_of_k_W(W, to_string(shuf[si]), GEN, K, SEED, known)
        let kwr = _g6_known_word_ratio(o, known)
        let mut isf = false
        if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
        if isf { fals_s = fals_s + 1 }
        println("SHUF[" + to_string(si) + "] fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
        si = si + 1
    }
    println("SHUF FALS=" + to_string(fals_s))

    // ── ARM ablated (B5-style control, single-concept frame, K=1) ──
    println("=== ARM ablated (control, 6 frames K=1) ===")
    let mut fals_a = 0
    let mut ai = 0
    while ai < len(abla) {
        let t0 = now_ms()
        let r = gen_clm_ideate_W(W, to_string(abla[ai]), GEN, 40, 0.7, SEED)
        let o = to_string(r["text"])
        let kwr = _g6_known_word_ratio(o, known)
        let mut isf = false
        if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
        if isf { fals_a = fals_a + 1 }
        println("ABLA[" + to_string(ai) + "] fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
        ai = ai + 1
    }
    println("ABLA FALS=" + to_string(fals_a))

    // ── FROZEN 5-BAR ──
    let cohrate = (1.0 * len(csets)) / 6.0
    println("======== clm303 G6 FROZEN 5-BAR (engine-native, wired-op decode+score) ========")
    println("  G0 COHERENCE (coh>=3/6 ~ KWR-pass): coh=" + to_string(len(csets)) + "/6  rate=" + to_string(cohrate))
    println("  B1 FALS-FLOOR (FALS_comp>=1)      : " + to_string(fals_c >= 1) + "   (FALS_comp=" + to_string(fals_c) + ")")
    println("  B2 COUNT (DIST>=5) [recombination]: " + to_string(DIST >= 5) + "   (DIST=" + to_string(DIST) + ")")
    println("  B3 SHUFFLE-COLLAPSE (comp>shuf)   : " + to_string(fals_c > fals_s) + "   (comp=" + to_string(fals_c) + " shuf=" + to_string(fals_s) + ")")
    println("  B5 ABLATE-CTRL (comp>ablated)     : " + to_string(fals_c > fals_a) + "   (comp=" + to_string(fals_c) + " abla=" + to_string(fals_a) + ")")
    println("CLM303_G6_DONE fals_c=" + to_string(fals_c) + " dist=" + to_string(DIST) + " fals_s=" + to_string(fals_s) + " fals_a=" + to_string(fals_a) + " coh=" + to_string(len(csets)))
}
