// h1418_tom_compose_LIVEOP_probe.hexa — H_1418 rung-3 verification for the TWO new compose
// pairs from H_1417 that BOUND engine-native (P3 ToM×spatial, P5 ToM×basal). It re-runs the
// FROZEN H_1417 compose bars driving the LIVE CORE ops `tom_spatial_compose` / `tom_basal_compose`
// (CORE/engine_cli.hexa §ToM×SPATIAL / §ToM×BASAL COMPOSE ARBITER) + the wired leg-read ops
// (tom_spatial_tom_vote / tom_spatial_spatial_vote / tom_basal_tom_vote) INSTEAD of the H_1417
// probe's inlined glue, and confirms it reproduces the H_1417 P3/P5 numbers BYTE-IDENTICALLY
// (a_verified_must_wire rung-3, c2). Everything else (fixture, seeds, knobs, live faculty builds)
// is IDENTICAL to state/1417_compose_bind_law_predictive/h1417_compose_bind_law_probe.hexa — only
// the arbiter + leg-reads are swapped: inlined `_arbiter`/`_leg_*` → live wired ops. If the numbers
// match the H_1417 card (P3 compose 0.791111 · P5 compose 0.801481, all 4 bars PASS for each),
// the live ops == the validated mechanism. The basal leg's vbasal_go_value read stays inline (basal
// lives in CORE/brain.hexa, value-passed to tom_basal_compose like spatial_episodic_compose).

import "CORE/engine_cli.hexa"
import "CORE/brain.hexa"

// ── frozen knobs (== H_1417 probe, NOT moved) ───────────────────────────────
const N_PER_FAMILY: int = 90
const COMPOSE_DELTA: float = 0.05
const ORACLE_MARGIN: float = 0.02
const SHUFFLE_TOL: float = 0.02
const N_LANDMARKS: int = 8
const GRID: float = 10.0

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _unif(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    return _u01(s1)
}
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}
fn _jit(base: float, seed: int, i: int, salt: int) -> float {
    return base + 0.06 * _stdnorm(seed, i, salt)
}

// faculty IDs: 1 ToM · 2 spatial · 4 basal (P3 = [1,2], P5 = [1,4])
fn _PAIRS() -> [[int]] { return [[1,2],[1,4]] }           // P3, P5 only
fn _PAIR_NAME(p: int) -> string {
    if p == 0 { return "P3 ToM x spatial" }
    return "P5 ToM x basal"
}
fn _SEEDS(p: int) -> [int] {
    // EXACT H_1417 seed triples: P3 -> base 5500+2*10=5520 ; P5 -> 5500+4*10=5540
    let base = if p == 0 { 5520 } else { 5540 }
    return [base, base + 1, base + 2]
}

// per-item family structure (== H_1417 _item, verbatim).
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut correct = 0.0
    let mut xm = 0.0  let mut ym = 0.0
    let mut xc = 0.0  let mut yc = 0.0
    correct = if _unif(seed, i, 41) < 0.5 { 0.0 } else { 1.0 }
    if fam == 0 {
        xm = _absf(_jit(0.55, seed, i, 1))  ym = _absf(_jit(0.05, seed, i, 2))
        xc = 1.0  yc = if _unif(seed, i, 51) < 0.5 { 0.0 } else { 1.0 }
    } else if fam == 1 {
        xm = _absf(_jit(0.05, seed, i, 1))  ym = _absf(_jit(0.55, seed, i, 2))
        yc = 1.0  xc = if _unif(seed, i, 52) < 0.5 { 0.0 } else { 1.0 }
    } else if fam == 2 {
        xm = _absf(_jit(0.45, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 1.0  yc = 1.0
    } else if fam == 3 {
        xm = _absf(_jit(0.50, seed, i, 1))  ym = _absf(_jit(0.40, seed, i, 2))
        xc = 1.0  yc = 0.0
    } else {
        xm = _absf(_jit(0.60, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 0.0  yc = 1.0
    }
    return [to_float(fam), correct, xm, ym, xc, yc]
}

// ── LIVE leg reads — via the WIRED ops where the faculty lives in engine_cli, inline (matching
//    the H_1417 _leg_basal) where it lives in brain.hexa. All produce [vote, abstain, conf]. ──

// ToM leg → wired tom_spatial_tom_vote (vote from the LIVE other_mind_predict, == H_1417 _leg_tom).
fn _leg_tom(tom: OtherMindModel, seed: int, i: int, votes_correct: float,
            correct: float, mag: float) -> [float] {
    let _ = votes_correct  let _ = correct   // ToM vote comes from the live predict, NOT the class
    return tom_spatial_tom_vote(tom, "tom_" + to_string(seed) + "_" + to_string(i), mag)
}

// spatial leg → wired tom_spatial_spatial_vote (LIVE nearest over the placed map).
fn _leg_spatial(sm: SpatialMap, seed: int, i: int, votes_correct: float,
                correct: float, mag: float) -> [float] {
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    return tom_spatial_spatial_vote(sm, cls, mag)
}

// basal leg → INLINE LIVE vbasal_go_value (basal lives in brain.hexa; value-passed to the
// wired tom_basal_compose). BYTE-EXACT to the H_1417 _leg_basal.
fn _leg_basal(bg: VBasalGate, seed: int, i: int, votes_correct: float,
              correct: float, mag: float) -> [float] {
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    let gv_pred = vbasal_go_value(bg, [mag])
    let gv_comp = vbasal_go_value(bg, [0.0])
    let margin = gv_pred - gv_comp
    let conf = _absf(margin) + mag
    return [cls, 0.0, conf]
}

// ── run one pair (P3 or P5): build live faculties, score frozen bars over 3 seeds via WIRED ops ──
fn run_pair_seed(pidx: int, seed: int, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY
    let is_spatial = pidx == 0                 // P3 ToM×spatial ; else P5 ToM×basal

    // ── build live faculties (ToM always; spatial OR basal) ─────────────────
    let mut tom = other_mind_new()
    let mut sm = spatial_map_new()
    let mut bg = vbasal_new(1, 0.20)
    let mut tt = 0
    while tt < 40 { bg = vbasal_update(bg, 0, [1.0], 1.0)  tt = tt + 1 }   // STRONG arm (LIVE)
    let mut lk = 0
    while lk < N_LANDMARKS {
        sm = spatial_map_place(sm, "L" + to_string(lk),
                               GRID * _unif(seed, lk, 101), GRID * _unif(seed, lk, 202))
        lk = lk + 1
    }

    // ── item structure + witness ToM per item (ToM is faculty X = fx==1) ────
    let mut corrs: [float] = []
    let mut xms: [float] = []   let mut yms: [float] = []
    let mut xcs: [float] = []   let mut ycs: [float] = []
    let mut b = 0
    while b < n {
        let it = _item(seed, b)
        corrs = corrs + [it[1]]
        xms = xms + [it[2]]  yms = yms + [it[3]]  xcs = xcs + [it[4]]  ycs = ycs + [it[5]]
        let correct = it[1]
        // X = ToM → witness the X-intended class.
        let cls = if it[4] > 0.5 { correct } else { 1.0 - correct }
        let val = if cls > 0.5 { "box" } else { "basket" }
        tom = other_mind_witness(tom, "tom_" + to_string(seed) + "_" + to_string(b), val)
        b = b + 1
    }

    // ── first pass: wired leg reads + confidence means ──────────────────────
    let mut xdec: [float] = []  let mut xcf: [float] = []  let mut xab: [float] = []
    let mut ydec: [float] = []  let mut ycf: [float] = []  let mut yab: [float] = []
    let mut sx = 0.0  let mut sy = 0.0
    let mut i = 0
    while i < n {
        let lx = _leg_tom(tom, seed, i, xcs[i], corrs[i], xms[i])
        let mut ly: [float] = []
        if is_spatial { ly = _leg_spatial(sm, seed, i, ycs[i], corrs[i], yms[i]) }
        else { ly = _leg_basal(bg, seed, i, ycs[i], corrs[i], yms[i]) }
        xdec = xdec + [lx[0]]  xab = xab + [lx[1]]  xcf = xcf + [lx[2]]  sx = sx + _absf(lx[2])
        ydec = ydec + [ly[0]]  yab = yab + [ly[1]]  ycf = ycf + [ly[2]]  sy = sy + _absf(ly[2])
        i = i + 1
    }
    let xmean = sx / to_float(n)
    let ymean = sy / to_float(n)

    // ── second pass: accuracies + compose (via WIRED op) + oracle + decomposition ──
    let mut on_x = 0  let mut on_y = 0  let mut on_c = 0  let mut on_o = 0
    let mut only_x = 0  let mut only_y = 0
    let mut j = 0
    while j < n {
        let xd = xdec[j]  let yd = ydec[j]  let ct = corrs[j]
        let xleg = [xdec[j], xab[j], xcf[j]]
        let yleg = [ydec[j], yab[j], ycf[j]]
        let comp = if is_spatial { tom_spatial_compose(xleg, yleg, xmean, ymean) }
                   else { tom_basal_compose(xleg, yleg, xmean, ymean) }
        let x_ok = (xab[j] < 0.5) && (xd == ct)
        let y_ok = (yab[j] < 0.5) && (yd == ct)
        if x_ok { on_x = on_x + 1 }
        if y_ok { on_y = on_y + 1 }
        if comp >= 0.0 && comp == ct { on_c = on_c + 1 }
        if x_ok || y_ok { on_o = on_o + 1 }
        if x_ok && !y_ok { only_x = only_x + 1 }
        if y_ok && !x_ok { only_y = only_y + 1 }
        j = j + 1
    }

    // ── shuffle control: permute the faculty reads, re-arbitrate via the WIRED op ──
    let mut pm: [int] = []  let mut pn: [int] = []
    let mut s = 0
    while s < n { pm = pm + [s]  pn = pn + [s]  s = s + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r1 = st % (a + 1)
        let tmp = pm[a]  pm[a] = pm[r1]  pm[r1] = tmp
        st = _lcg(st)  let r2 = st % (a + 1)
        let tmpb = pn[a]  pn[a] = pn[r2]  pn[r2] = tmpb
        a = a - 1
    }
    let mut on_s = 0
    let mut k = 0
    while k < n {
        let mi = pm[k]  let ni = pn[k]
        let xleg = [xdec[mi], xab[mi], xcf[mi]]
        let yleg = [ydec[ni], yab[ni], ycf[ni]]
        let comp = if is_spatial { tom_spatial_compose(xleg, yleg, xmean, ymean) }
                   else { tom_basal_compose(xleg, yleg, xmean, ymean) }
        if comp >= 0.0 && comp == corrs[k] { on_s = on_s + 1 }
        k = k + 1
    }

    let dn = to_float(n)
    let ax = to_float(on_x) / dn
    let ay = to_float(on_y) / dn
    let best = if ax >= ay { ax } else { ay }
    return [ax, ay, best, to_float(on_c)/dn, to_float(on_s)/dn, to_float(on_o)/dn,
            to_float(only_x)/dn, to_float(only_y)/dn]
}

fn main() {
    println("================================================================================")
    println("H_1418 RUNG-3 — LIVE-OP re-run: P3/P5 arbiter via WIRED tom_spatial_compose /")
    println("  tom_basal_compose (CORE/engine_cli.hexa). MUST reproduce H_1417 P3/P5 byte-exact.")
    println("  $0 CPU · P3 seeds [5520,5521,5522] · P5 seeds [5540,5541,5542] · a_verified_must_wire rung-3")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let pairs = _PAIRS()
    let mut all_pass = true
    let mut p = 0
    while p < len(pairs) {
        let seeds = _SEEDS(p)
        let mut ax = 0.0  let mut ay = 0.0  let mut best = 0.0
        let mut ac = 0.0  let mut ash = 0.0  let mut ao = 0.0
        let mut ox = 0.0  let mut oy = 0.0
        let ns = to_float(len(seeds))
        let mut si = 0
        while si < len(seeds) {
            let r = run_pair_seed(p, seeds[si], cfg)
            println("  " + _PAIR_NAME(p) + " seed " + to_string(seeds[si]) + ": acc_x=" + _f4(r[0])
                  + " acc_y=" + _f4(r[1]) + " best=" + _f4(r[2]) + " compose=" + _f4(r[3])
                  + " shuf=" + _f4(r[4]) + " oracle=" + _f4(r[5]))
            ax = ax + r[0]  ay = ay + r[1]  best = best + r[2]
            ac = ac + r[3]  ash = ash + r[4]  ao = ao + r[5]  ox = ox + r[6]  oy = oy + r[7]
            si = si + 1
        }
        ax = ax/ns  ay = ay/ns  best = best/ns  ac = ac/ns  ash = ash/ns  ao = ao/ns  ox = ox/ns  oy = oy/ns

        let B1 = ac >= best + COMPOSE_DELTA
        let B2 = (ao - best) > ORACLE_MARGIN
        let B3 = (ac - ash) > SHUFFLE_TOL
        let SEP = ox > 0.0 && oy > 0.0
        let bind = B1 && B2 && B3 && SEP
        if !bind { all_pass = false }

        println("--------------------------------------------------------------------------------")
        println(_PAIR_NAME(p) + "  MEAN (3 seeds, LIVE WIRED OP):")
        println("  acc_x=" + _f4(ax) + " acc_y=" + _f4(ay) + " best=" + _f4(best))
        println("  compose=" + _f4(ac) + " shuffle=" + _f4(ash) + " oracle=" + _f4(ao)
              + " (oracle-best=" + _f4(ao - best) + ")")
        println("  only_x=" + _f4(ox) + " only_y=" + _f4(oy)
              + " | net-lift(compose-best)=" + _f4(ac - best))
        println("  (B1 " + (if B1 {"PASS"} else {"FAIL"}) + ") (B2 " + (if B2 {"PASS"} else {"FAIL"})
              + ") (B3 " + (if B3 {"PASS"} else {"FAIL"}) + ") (SEP " + (if SEP {"PASS"} else {"FAIL"}) + ")")
        println("  ==> " + (if bind { "🟢 BIND" } else { "🧱 WALL" }))
        p = p + 1
    }
    println("================================================================================")
    if all_pass {
        println("VERDICT: 🟢 RUNG-3 LIVE-OP REPRODUCES H_1417 P3+P5 — the WIRED tom_spatial_compose /")
        println("  tom_basal_compose ops give the SAME engine-native compose-lift (all 4 bars PASS each).")
        println("  Expected byte-exact: P3 compose 0.791111 · P5 compose 0.801481 (H_1417 result.txt).")
        println("  The two arbiters are now OWNED by the engine (a_verified_must_wire rung-3 done).")
    } else {
        println("VERDICT: 🧱 — a live op did NOT reproduce the H_1417 P3/P5 bars (wire-in regression, c9).")
    }
    if !all_pass { exit(1) }
}
