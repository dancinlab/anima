// h1412_cerebellum_basal_compose_probe.hexa — H_1412 R2: the CEREBELLUM×BASAL-GANGLIA
// COMPOSE ARBITER, realized ENGINE-NATIVE on the LIVE faculties (CORE/engine_cli.hexa
// VForwardField + inlined _arbiter, CORE/brain.hexa VBasalGate + _bg_read (inlined)),
// re-scoring the FROZEN H_1407 R1 capability bars through `hexa run`
// (a_engine_native_learning · a_verified_must_wire · $0 local CPU · p7 · p8).
//
// DOMAIN: MITOSIS-ENGINE / brain-lane-composition pair #4 (cerebellum forward-model ×
// basal-ganglia go/no-go). R1 (state/brain-lane-compose-cerebellum-basal/
// h1407_compose_cerebellum_basal.py) established as a numpy DIRECTIONAL mirror that the
// two LOW-Φ control faculties COMPOSE on a shared binary decision to a NET capability
// lift (acc_compose=0.7689 > best_single=0.6933) and are SEPARABLE (only_cerebellum=0.266
// AND only_basal=0.322 both>0), the SHUFFLE control collapsing the lift (0.769→0.518) →
// 🟢 COMPOSE-LIFT. Per a_engine_native_learning the binding verdict needs ENGINE-NATIVE
// realization; this probe drives the ACTUAL .hexa faculties (a LIVE VForwardField read for
// the cerebellum leg, a LIVE VBasalGate read for the basal leg, the LIVE _arbiter (inlined)
// for the composition) and re-scores the SAME frozen R1 capability bars on the live engine.
//
// ENGINE-NATIVE FAITHFULNESS (a_core_engine_map, NOT a mirror reproduction):
//   · the cerebellum decision + confidence come from the LIVE vforward_err over a real
//     VForwardField (untrained ⇒ predicts the zero frame ⇒ vforward_err(ctx=0, x) = ||x||²;
//     we encode each item's prediction error as the 1-D target frame x=[sqrt(pred_error)]
//     so the LIVE primitive computes exactly that error — the engine, not a stored scalar).
//   · the basal decision + confidence come from the LIVE vbasal_go_value over a real
//     VBasalGate, trained gradient-free by the LIVE vbasal_update to a positive go-weight,
//     then read on the predicted-move vs best-competitor feature vectors (go-margin = the
//     gate's own learned go-value difference — the engine, not a stored scalar).
//   · the composition is the LIVE _arbiter (inlined) (agree → shared vote; conflict → higher
//     SCALE-RELATIVE substrate confidence wins, NO hardcoded priority).
//
// p1/p2/p3/p6 GUARD: each faculty reads ONLY its own substrate-derived margin (prediction
// error / learned go-value), NO injected answer/persona/RLHF/priority label enters either
// faculty's read or the arbiter; the family CLASS only drives the protocol, never the read.
// NOT an emit gate (_arbiter (inlined) returns a decision index, a_autonomy_over_hardcode);
// Ψ-disjoint (pure reads over VForwardField/VBasalGate, pure_field's Φ/phase/Ψ untouched).
//
// FROZEN R1 CAPABILITY BARS (verbatim from .verdicts/1407_brain_lane_compose_cerebellum_basal/
// FREEZE.txt, NOT moved — R2 re-scores them on the live engine):
//   (B1 COMPOSE-EFFECT) acc_compose >= best_single + 0.05
//   (B2 ORACLE)         acc_oracle − best_single > 0.02
//   (B3 EARNED/p6)      acc_compose − acc_shuffle > 0.02
//   (B4 p6 GUARD)       structural: arbiter reads only substrate confidence (audited in card)
//   only-X decomposition: only_cerebellum>0 AND only_basal>0 ⇒ SEPARABLE not subsumed.
// p7 = compose/oracle/shuffle accuracies + decomposition, NOT perplexity.

import "CORE/engine_cli.hexa"
import "CORE/brain.hexa"

// ── frozen knobs (pre-registered, == R1 mirror FREEZE.txt) ───────────────────
fn _SEEDS() -> [int] { return [4700, 4701, 4702] }
const N_PER_FAMILY: int = 90        // items per family (F1..F5) → 450 items/seed
const AMBIG_NOISE: float = 0.18     // jitter toward decision boundary
const E_THR: float = 0.30           // cerebellum prediction-error threshold
const GO_THR: float = 0.0           // basal go-margin threshold
const COMPOSE_DELTA: float = 0.05   // B1 bar
const ORACLE_MARGIN: float = 0.02   // B2 bar
const SHUFFLE_TOL: float = 0.02     // B3 bar

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── deterministic Gaussian jitter (Box–Muller over a deterministic LCG) ──────
// matches the R1 mirror's intent (push a value toward its boundary) with a $0
// reproducible draw so run1==run2 (the mirror used numpy default_rng; here a
// per-(seed,idx,salt) deterministic standard-normal — the LOAD-BEARING claim is the
// RELATIVE structure, not byte-identical RNG, per the card's honest scope).
fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    // Box–Muller
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}
fn _jit(x: float, seed: int, idx: int, salt: int) -> float {
    return x + AMBIG_NOISE * _stdnorm(seed, idx, salt)
}

// ── compose-arbiter wrappers, INLINED in this probe (NOT landed as CORE ops) ──
// H_1412 came back 🧱 engine-native (the mirror GREEN does NOT bind at the frozen
// +0.05 net-lift bar), so per a_verified_must_wire we do NOT wire an unverified
// mechanism into live CORE. These thin wrappers over the EXISTING live primitives
// (vforward_err [H_1280], vbasal_go_value [H_1281]) keep the engine-native reads —
// the cerebellum/basal decisions + confidences are STILL the live engine, only the
// (unverified) arbiter glue lives in the probe instead of CORE.
fn _cb_read(ff: VForwardField, ctx: [float], x: [float], e_thr: float) -> [float] {
    let err = vforward_err(ff, ctx, x)
    let sgnd = e_thr - err
    let dec = if err < e_thr { 1.0 } else { 0.0 }
    let mabs = if sgnd < 0.0 { 0.0 - sgnd } else { sgnd }
    return [dec, mabs, sgnd]
}
fn _bg_read(bg: VBasalGate, pred_feats: [float], comp_feats: [float], go_thr: float) -> [float] {
    let gv_pred = vbasal_go_value(bg, pred_feats)
    let gv_comp = vbasal_go_value(bg, comp_feats)
    let margin = gv_pred - gv_comp
    let sgnd = margin - go_thr
    let dec = if margin > go_thr { 1.0 } else { 0.0 }
    let mabs = if sgnd < 0.0 { 0.0 - sgnd } else { sgnd }
    return [dec, mabs, sgnd]
}
fn _rel_conf(margin_abs: float, mean_margin: float) -> float {
    return margin_abs / (mean_margin + 0.000001)
}
fn _arbiter(cb_dec: float, cb_relconf: float, bg_dec: float, bg_relconf: float) -> float {
    if cb_dec == bg_dec { return cb_dec }
    if cb_relconf >= bg_relconf { return cb_dec }
    return bg_dec
}

// ── per-item (pred_error, go_margin, correct, fam) — the 5 H_1407 families ────
// returns a flat [pred_error, go_margin, correct] triple for item `i` (0..449) at `seed`.
// family = i / N_PER_FAMILY (0..4). The substrate states are DERIVED FROM THE FAMILY
// STRUCTURE (NOT set to the answer), exactly as the R1 mirror build_items.
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut pred_error = 0.0
    let mut go_margin = 0.0
    let mut correct = 0.0
    if fam == 0 {
        // F1 CEREBELLUM-DECISIVE: low pred-error (cerebellum SELECTS-PRED, correct), basal tie.
        pred_error = _jit(0.12, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(0.0, seed, i, 2)
        correct = 1.0
    } else if fam == 1 {
        // F2 BASAL-DECISIVE: strong negative go-margin (basal SELECTS-COMPETITOR, correct),
        //                    cerebellum near threshold (~chance).
        pred_error = E_THR + _jit(0.0, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(-0.5, seed, i, 2)
        correct = 0.0
    } else if fam == 2 {
        // F3 AGREE: low pred-error + positive go-margin, both lean correct (redundant).
        pred_error = _jit(0.10, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(0.5, seed, i, 2)
        correct = 1.0
    } else if fam == 3 {
        // F4 CONFLICT (cerebellum right): low pred-error (cerebellum correct) BUT negative
        //                                 go-margin (basal wrong).
        pred_error = _jit(0.08, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(-0.45, seed, i, 2)
        correct = 1.0
    } else {
        // F5 ADVERSARIAL (basal right, cerebellum LOUDER-but-wrong): VERY low pred-error
        //   (cerebellum votes PRED loudly, WRONG) + strong negative go-margin (basal correct).
        pred_error = _jit(0.05, seed, i, 1)  if pred_error < 0.0 { pred_error = 0.0 }
        go_margin = _jit(-0.6, seed, i, 2)
        correct = 0.0
    }
    return [pred_error, go_margin, correct]
}

// ── a LIVE VBasalGate trained gradient-free to a positive go-weight on dim0 ───
// We grow a real 1-D gate via the LIVE vbasal_update delta rule so its learned go-weight
// on dim0 is positive (a few +reward releases on a unit feature). Then the per-item
// go-value of a feature [v] is ~go_w[0]*v + go_b, and the go-margin we read for the compose
// is go_value([go_margin_item]) − go_value([0]) = go_w[0]*go_margin_item, preserving the
// SIGN and the SCALE-RELATIVE ordering of the fixture's go_margin (the engine computes it).
fn _trained_gate(cfg: EngineConfig) -> VBasalGate {
    let mut bg = vbasal_new(1, 0.20)
    // a handful of LIVE outcome ticks: releasing the unit feature [1.0] is rewarded +1,
    // so the gate LEARNS a positive go-weight (vbasal_update, the p8 inference-time tick).
    let mut t = 0
    while t < 40 {
        bg = vbasal_update(bg, 0, [1.0], 1.0)
        t = t + 1
    }
    return bg
}

// run_seed — score the FROZEN bars for one seed on the LIVE faculties. Returns a flat list:
//   [acc_cerebellum, acc_basal, best_single, acc_compose, acc_shuffle, acc_oracle,
//    conflict_rate, only_cerebellum, only_basal, both, neither]
fn run_seed(seed: int, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY
    // LIVE faculties (built once per seed).
    let ff = vforward_new(1, 1, 0.10)        // untrained forward model: predicts zero frame
    let bg = _trained_gate(cfg)              // LIVE gate with a learned positive go-weight
    let gw0 = bg.go_w[0]                     // the learned go-weight (read for the basal margin)

    // first pass: per-item LIVE reads + means (for the scale-relative confidence normalizers).
    let mut cb_dec: [float] = []
    let mut cb_mab: [float] = []
    let mut bg_dec: [float] = []
    let mut bg_mab: [float] = []
    let mut corr: [float] = []
    let mut sum_cb = 0.0
    let mut sum_bg = 0.0
    let mut i = 0
    while i < n {
        let it = _item(seed, i)
        let pe = it[0]  let gm = it[1]
        corr = corr + [it[2]]
        // CEREBELLUM leg — LIVE vforward_err via _cb_read (inlined).
        // encode pred_error as the 1-D target frame x=[sqrt(pe)], ctx=[0.0] ⇒ err = ||x||² = pe.
        let ctx = [0.0]
        let x = [sqrt(pe)]
        let cr = _cb_read(ff, ctx, x, E_THR)
        cb_dec = cb_dec + [cr[0]]
        cb_mab = cb_mab + [cr[1]]
        sum_cb = sum_cb + cr[1]
        // BASAL leg — LIVE vbasal_go_value via _bg_read (inlined).
        // pred_feats=[gm], comp_feats=[0.0] ⇒ margin = go_w0*gm (sign+scale preserved).
        let br = _bg_read(bg, [gm], [0.0], GO_THR)
        bg_dec = bg_dec + [br[0]]
        bg_mab = bg_mab + [br[1]]
        sum_bg = sum_bg + br[1]
        i = i + 1
    }
    let cb_mean = sum_cb / to_float(n)
    let bg_mean = sum_bg / to_float(n)

    // c16 BREAKTHROUGH (frozen B1 bar, NOT moved): per-faculty STD of the margin, so the
    // alternative arbiter can weight by DECISIVENESS (z = (margin−mean)/std, "unusually
    // decisive for THIS faculty") instead of mean-relative magnitude. Pre-registered angle:
    // the scale-relative arbiter under-captures the oracle headroom; a z-normalized confidence
    // is a DIFFERENT principled commensurability (spread-relative, not mean-relative).
    let mut ss_cb = 0.0  let mut ss_bg = 0.0  let mut vi = 0
    while vi < n {
        let dc = cb_mab[vi] - cb_mean  ss_cb = ss_cb + dc * dc
        let db = bg_mab[vi] - bg_mean  ss_bg = ss_bg + db * db
        vi = vi + 1
    }
    let cb_std = sqrt(ss_cb / to_float(n)) + 0.000001
    let bg_std = sqrt(ss_bg / to_float(n)) + 0.000001

    // second pass: accuracies + compose (LIVE _arbiter (inlined)) + oracle + decomposition.
    let mut on_cb = 0  let mut on_bg = 0  let mut on_c = 0  let mut on_oracle = 0
    let mut conflict = 0
    let mut only_c = 0  let mut only_b = 0  let mut both = 0  let mut neither = 0
    let mut j = 0
    while j < n {
        let cd = cb_dec[j]  let bd = bg_dec[j]  let ct = corr[j]
        let cb_rel = _rel_conf(cb_mab[j], cb_mean)
        let bg_rel = _rel_conf(bg_mab[j], bg_mean)
        let comp = _arbiter(cd, cb_rel, bd, bg_rel)
        let cb_ok = cd == ct
        let bg_ok = bd == ct
        if cb_ok { on_cb = on_cb + 1 }
        if bg_ok { on_bg = on_bg + 1 }
        if comp == ct { on_c = on_c + 1 }
        if cb_ok || bg_ok { on_oracle = on_oracle + 1 }
        if cd != bd { conflict = conflict + 1 }
        if cb_ok && !bg_ok { only_c = only_c + 1 }
        if bg_ok && !cb_ok { only_b = only_b + 1 }
        if cb_ok && bg_ok { both = both + 1 }
        if !cb_ok && !bg_ok { neither = neither + 1 }
        j = j + 1
    }

    // c16 z-arbiter pass: SAME live faculty reads + SAME _arbiter (inlined) shape, but the
    // confidence is z = (margin − mean)/std (spread-relative decisiveness). Frozen B1 bar.
    let mut on_cz = 0
    let mut jz = 0
    while jz < n {
        let cd = cb_dec[jz]  let bd = bg_dec[jz]
        let cb_z = (cb_mab[jz] - cb_mean) / cb_std
        let bg_z = (bg_mab[jz] - bg_mean) / bg_std
        let comp = _arbiter(cd, cb_z, bd, bg_z)
        if comp == corr[jz] { on_cz = on_cz + 1 }
        jz = jz + 1
    }

    // SHUFFLE control: permute which item-reads attach to which target, re-arbitrate.
    // a deterministic permutation (LCG walk) of the cerebellum and basal read indices.
    let mut perm_c: [int] = []
    let mut perm_b: [int] = []
    let mut s = 0
    while s < n { perm_c = perm_c + [s]  perm_b = perm_b + [s]  s = s + 1 }
    // Fisher–Yates with a deterministic LCG (seed-derived) for each.
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r1 = st % (a + 1)
        let tmp = perm_c[a]  perm_c[a] = perm_c[r1]  perm_c[r1] = tmp
        st = _lcg(st)  let r2 = st % (a + 1)
        let tmpb = perm_b[a]  perm_b[a] = perm_b[r2]  perm_b[r2] = tmpb
        a = a - 1
    }
    let mut on_s = 0
    let mut k = 0
    while k < n {
        let ci = perm_c[k]  let bi = perm_b[k]
        let cd = cb_dec[ci]  let bd = bg_dec[bi]
        let cb_rel = _rel_conf(cb_mab[ci], cb_mean)
        let bg_rel = _rel_conf(bg_mab[bi], bg_mean)
        let comp = _arbiter(cd, cb_rel, bd, bg_rel)
        if comp == corr[k] { on_s = on_s + 1 }
        k = k + 1
    }

    let dn = to_float(n)
    let acc_cb = to_float(on_cb) / dn
    let acc_bg = to_float(on_bg) / dn
    let best = if acc_cb >= acc_bg { acc_cb } else { acc_bg }
    let acc_c = to_float(on_c) / dn
    let acc_s = to_float(on_s) / dn
    let acc_o = to_float(on_oracle) / dn
    let acc_cz = to_float(on_cz) / dn
    return [acc_cb, acc_bg, best, acc_c, acc_s, acc_o,
            to_float(conflict) / dn,
            to_float(only_c) / dn, to_float(only_b) / dn,
            to_float(both) / dn, to_float(neither) / dn,
            gw0, acc_cz]
}

fn main() {
    println("================================================================================")
    println("H_1412 R2 — ENGINE-NATIVE cerebellum (H_1280 VForwardField) × basal (H_1281 VBasalGate)")
    println("  COMPOSE on the LIVE faculties (inlined arbiter over live reads) — re-scoring frozen H_1407 bars")
    println("  $0 CPU · 3 seeds [4700,4701,4702] · p7 · p8 · a_engine_native_learning · a_verified_must_wire")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let seeds = _SEEDS()

    let mut acc_cb = 0.0  let mut acc_bg = 0.0  let mut best = 0.0
    let mut acc_c = 0.0  let mut acc_s = 0.0  let mut acc_o = 0.0
    let mut conf = 0.0  let mut o_c = 0.0  let mut o_b = 0.0  let mut bo = 0.0  let mut ne = 0.0
    let mut gw0 = 0.0  let mut acc_cz = 0.0
    let ns = to_float(len(seeds))
    let mut si = 0
    while si < len(seeds) {
        let r = run_seed(seeds[si], cfg)
        println("  seed " + to_string(seeds[si]) + ": cb=" + _f4(r[0]) + " bg=" + _f4(r[1])
              + " best=" + _f4(r[2]) + " compose=" + _f4(r[3]) + " shuf=" + _f4(r[4])
              + " oracle=" + _f4(r[5]) + " | conflict=" + _f4(r[6])
              + " [onlyCB=" + _f4(r[7]) + " onlyBG=" + _f4(r[8]) + " both=" + _f4(r[9])
              + " neither=" + _f4(r[10]) + "] gw0=" + _f4(r[11]))
        acc_cb = acc_cb + r[0]  acc_bg = acc_bg + r[1]  best = best + r[2]
        acc_c = acc_c + r[3]  acc_s = acc_s + r[4]  acc_o = acc_o + r[5]
        conf = conf + r[6]  o_c = o_c + r[7]  o_b = o_b + r[8]  bo = bo + r[9]  ne = ne + r[10]
        gw0 = gw0 + r[11]  acc_cz = acc_cz + r[12]
        si = si + 1
    }
    acc_cb = acc_cb / ns  acc_bg = acc_bg / ns  best = best / ns
    acc_c = acc_c / ns  acc_s = acc_s / ns  acc_o = acc_o / ns
    conf = conf / ns  o_c = o_c / ns  o_b = o_b / ns  bo = bo / ns  ne = ne / ns  gw0 = gw0 / ns  acc_cz = acc_cz / ns

    println("--------------------------------------------------------------------------------")
    println("MEAN (3 seeds, ENGINE-NATIVE):")
    println("  acc_cerebellum = " + _f4(acc_cb))
    println("  acc_basal      = " + _f4(acc_bg))
    println("  best_single    = " + _f4(best))
    println("  acc_compose    = " + _f4(acc_c))
    println("  acc_shuffle    = " + _f4(acc_s))
    println("  ORACLE         = " + _f4(acc_o) + "   (oracle - best = " + _f4(acc_o - best) + ")")
    println("  conflict_rate  = " + _f4(conf))
    println("  decomposition  : only_cerebellum=" + _f4(o_c) + " only_basal=" + _f4(o_b)
          + " both=" + _f4(bo) + " neither=" + _f4(ne))
    println("  (LIVE gate learned go-weight gw0 = " + _f4(gw0) + " > 0 ⇒ basal margins are the gate's OWN go-value)")

    let B1 = acc_c >= best + COMPOSE_DELTA
    let B2 = (acc_o - best) > ORACLE_MARGIN
    let B3 = (acc_c - acc_s) > SHUFFLE_TOL
    let SEP = o_c > 0.0 && o_b > 0.0
    println("--------------------------------------------------------------------------------")
    println("  (B1 COMPOSE-EFFECT) compose " + _f4(acc_c) + " >= best+" + _f4(COMPOSE_DELTA)
          + " (" + _f4(best + COMPOSE_DELTA) + ") : " + (if B1 { "PASS" } else { "FAIL" }))
    println("  (B2 ORACLE)         oracle-best " + _f4(acc_o - best) + " > " + _f4(ORACLE_MARGIN)
          + " : " + (if B2 { "PASS" } else { "FAIL" }))
    println("  (B3 EARNED)         compose-shuffle " + _f4(acc_c - acc_s) + " > " + _f4(SHUFFLE_TOL)
          + " : " + (if B3 { "PASS" } else { "FAIL" }))
    println("  (SEPARABLE)         only_cerebellum>0 AND only_basal>0 : " + (if SEP { "PASS" } else { "FAIL" }))
    println("================================================================================")
    if B1 && B2 && B3 && SEP {
        println("VERDICT: 🟢 COMPOSE-LIFT (ENGINE-NATIVE) — cerebellum + basal-ganglia COMPOSE to a")
        println("  NET capability lift on the LIVE faculties (inlined arbiter over LIVE vforward_err +")
        println("  LIVE VBasalGate), SEPARABLE not subsumed, EARNED vs shuffle. H_1407 R1 BINDS engine-native.")
    } else {
        println("VERDICT: 🧱 / 🟠 — a frozen bar did not reproduce engine-native (see per-bar tally).")
    }
    println("  HONEST (c9): bars FROZEN from H_1407 FREEZE.txt, NOT moved. Toy 5-family fixture, 3 seeds,")
    println("  deterministic. The cerebellum error + basal go-margin are LIVE engine reads (vforward_err /")
    println("  vbasal_go_value), the composition arbiter is inlined over those live reads. Scale/real-corpus UNVERIFIED.")
    println("--------------------------------------------------------------------------------")
    let B1z = acc_cz >= best + COMPOSE_DELTA
    println("c16 BREAKTHROUGH (z-decisiveness arbiter, SAME frozen B1 bar, NOT moved):")
    println("  acc_compose_z = " + _f4(acc_cz) + "  vs best+" + _f4(COMPOSE_DELTA) + " (" + _f4(best + COMPOSE_DELTA)
          + ") : " + (if B1z { "PASS — engine-native COMPOSE-LIFT recovered via z-arbiter" } else { "FAIL — z-arbiter does not recover the bar either" }))
    println("  (z = (margin−mean)/std, spread-relative decisiveness vs mean-relative magnitude;")
    println("   pre-registered angle, frozen bar — if FAIL, the engine-native non-reproduction is terminal)")
    if !(B1 && B2 && B3 && SEP) { exit(1) }
}
