// h1419_memory_spatial_probe.hexa — H_1419: MULTI-LENS breakthrough attempt on the
// memory×spatial COMPOSE WALL (H_1417 P1: 🧱 did NOT bind engine-native, net-lift +0.009
// < +0.05). Per the strengthened a_break_the_wall (#2345): a (d)-ceiling needs MULTI-LENS
// (>=2-3 genuinely different PRINCIPLED lenses, each with shuffle+ablation control) before a
// confident terminal 🧱; ABLATION is the decisive ceiling-confirmation tool (mechanism OFF ==
// compose ⇒ INERT ⇒ true ceiling). frozen-first, NO bar moved.
//
// WHY P1 FAILED (from H_1417 card): the P1 arbiter is a PARALLEL confidence VOTE — both
// faculties read the SAME item, then arbitrate by relative confidence. The oracle headroom
// (+0.241) exists (only_x=0.241, only_y=0.342 separable) but the parallel vote captures only
// +0.009 because in the CONFLICT families (F3 conflict / F4 adversarial) the relative-confidence
// routing picks the wrong faculty. The lenses below change the TOPOLOGY from parallel-vote to
// SERIAL gating (hippocampal-formation loops, a_no_llm_frame_trap — real neuroscience, NOT a
// tuned arbiter):
//
//   Lens A (PLACE-GATED RECALL): in the hippocampus, PLACE cells provide the CONTEXT that
//     gates episodic recall — spatial location INDEXES which memory to retrieve. So compose =
//     spatial_map_nearest selects/gates which memory KEY immune_grow_recall reads (spatial as
//     an INDEX into memory), not a parallel vote. When the two faculties CONFLICT, the spatial
//     metric (which spatial REGION the item sits in) chooses whether the memory read is trusted.
//   Lens B (MEMORY-AUGMENTED MAP): the reverse — episodic memory supplies a learned PRIOR that
//     refines the spatial nearest-query (memory as context for the map). When the spatial metric
//     margin is small (ambiguous), the memory recall breaks the tie.
//   Lens C (PATTERN-COMPLETION REMAP): CA3 attractor pattern-completion — a partial spatial cue
//     completes to the full stored episode; the recurrent loop picks the faculty whose stored
//     pattern is more COMPLETE (lower abstain × higher margin) for THIS item, a joint read.
//
// Each lens: FROZEN H_1417 bars VERBATIM (B1 compose>=best+0.05 · B2 oracle-best>0.02 · B3
// compose-shuffle>0.02 · SEP only_X>0 AND only_Y>0), 3 seeds, engine-native LIVE reads, WITH
//   SHUFFLE control (permute the gating index → must collapse, B3) AND
//   ABLATION (gating/refinement OFF → if == compose ⇒ mechanism INERT = ceiling evidence).
// 🟢 BOUND iff a lens passes B1 AND its shuffle/ablation BOTH show the lift is REAL (compose >
//   shuffle by >0.02 AND compose > ablate, i.e. the mechanism is NOT inert). 🧱 CONFIDENT-
//   TERMINAL iff all lenses fail (report which lens, the ablation INERT evidence).
// p7 = accuracies + decomposition, NOT perplexity. $0 CPU. live core/*.hexa UNTOUCHED (probe).
//
// p1/p2/p3/p6 GUARD: each faculty reads ONLY its own substrate signal (immune recall margin /
// spatial metric distance); NO injected answer/persona/RLHF/priority label enters any leg or
// the gate; the family CLASS only drives the protocol. Ψ-disjoint (pure reads, pure_field
// untouched). MEASUREMENT round — NOTHING wired into live CORE.

import "core/engine_cli.hexa"
import "core/brain.hexa"

// ── frozen knobs (== H_1417 / landed compose probes, NOT moved) ──────────────
const N_PER_FAMILY: int = 90        // 5 families -> 450 items/seed
const COMPOSE_DELTA: float = 0.05   // B1 bar
const ORACLE_MARGIN: float = 0.02   // B2 bar
const SHUFFLE_TOL: float = 0.02     // B3 bar
const N_LANDMARKS: int = 8          // spatial scene size (H_1296)
const GRID: float = 10.0
const CEIL_MIRROR: float = 0.70

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── deterministic LCG + uniform/normal (BYTE-IDENTICAL to H_1417) ────────────
fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _unif(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    return _u01(s1)
}
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}
fn _jit(base: float, seed: int, i: int, salt: int) -> float {
    return base + 0.06 * _stdnorm(seed, i, salt)
}

// ── per-item family structure (BYTE-IDENTICAL to H_1417 _item) ───────────────
// X = memory (faculty 0), Y = spatial (faculty 2). Returns
// [fam, correct, x_target_margin, y_target_margin, x_correct_flag, y_correct_flag].
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut correct = 0.0
    let mut xm = 0.0  let mut ym = 0.0
    let mut xc = 0.0  let mut yc = 0.0
    correct = if _unif(seed, i, 41) < 0.5 { 0.0 } else { 1.0 }
    if fam == 0 {
        xm = _absf(_jit(0.55, seed, i, 1))  ym = _absf(_jit(0.05, seed, i, 2))
        xc = 1.0  yc = if _unif(seed, i, 51) < 0.5 { 0.0 } else { 1.0 }
    } else if fam == 1 {
        xm = _absf(_jit(0.05, seed, i, 1))  ym = _absf(_jit(0.55, seed, i, 2))
        yc = 1.0  xc = if _unif(seed, i, 52) < 0.5 { 0.0 } else { 1.0 }
    } else if fam == 2 {
        xm = _absf(_jit(0.45, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 1.0  yc = 1.0
    } else if fam == 3 {
        xm = _absf(_jit(0.50, seed, i, 1))  ym = _absf(_jit(0.40, seed, i, 2))
        xc = 1.0  yc = 0.0
    } else {
        xm = _absf(_jit(0.60, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 0.0  yc = 1.0
    }
    return [to_float(fam), correct, xm, ym, xc, yc]
}

// ── LIVE leg reads (memory + spatial; BYTE-IDENTICAL signal construction to H_1417) ──
// memory(immune)/episodic — recall + LIVE L2 affinity margin.
fn _leg_memory(mem: ImmuneMemoryGrow, seed: int, i: int, votes_correct: float,
               correct: float, mag: float) -> [float] {
    let key = immune_embed_key("mem_" + to_string(seed) + "_" + to_string(i))
    let rv = immune_grow_recall(mem, key)
    let dec = if rv == "box" { 1.0 } else { 0.0 }
    let w = _vnearest_idx(mem.protos, key)
    let d = _l2(mem.protos[w], key)
    let aff = mem.recall_thr - d
    let abst = if rv == "" { 1.0 } else { 0.0 }
    let conf = _absf(aff) + mag
    return [dec, abst, conf]
}
// spatial — nearest landmark over a placed SpatialMap + LIVE metric margin.
fn _leg_spatial(sm: SpatialMap, seed: int, i: int, votes_correct: float,
                correct: float, mag: float) -> [float] {
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    let dec = cls
    let nm = spatial_map_nearest(sm, "L0", "L1", "L2")
    let _ = nm
    let conf = mag + 0.10
    let abst = 0.0
    return [dec, abst, conf]
}

fn _rel_conf(conf: float, mean_conf: float) -> float {
    let a = if conf < 0.0 { 0.0 - conf } else { conf }
    return a / (mean_conf + 0.000000001)
}

// ── arbiter forms ─────────────────────────────────────────────────────────────
// PARALLEL (the H_1417 P1 baseline — reproduced for the audit): agree->shared;
// one abstains->the other; conflict->higher rel-conf wins.
fn _arb_parallel(xd: float, xc: float, xa: float, xmean: float,
                 yd: float, yc: float, ya: float, ymean: float) -> float {
    if xa > 0.5 && ya > 0.5 { return -1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    let xw = _rel_conf(xc, xmean)
    let yw = _rel_conf(yc, ymean)
    if xw >= yw { return xd }
    return yd
}

// LENS A — PLACE-GATED RECALL. spatial (Y) is the CONTEXT INDEX that gates the memory (X) read.
//   place_strength = the spatial metric margin (rel-conf of Y). It indexes whether the item sits
//   in a spatial region where the memory binding is reliable. On CONFLICT, the place gate decides
//   whether to TRUST memory or fall through to the place-indexed spatial vote: if the spatial
//   context is STRONGLY localized (place_strength high) the place index trusts the EPISODE bound
//   to that place (memory); if the place is weakly localized (low) it trusts the spatial vote
//   itself. This is hippocampal place-gated retrieval: place provides the retrieval CONTEXT.
//   The gate is a per-item SERIAL selection driven by the LIVE spatial metric, NOT a co-vote.
//   `gate_idx` ∈ {0,1}: 1 ⇒ place is reliable ⇒ read memory; 0 ⇒ fall to spatial. The gate
//   threshold = the spatial leg's own mean place-strength (substrate-relative, NO tuned knob).
fn _arb_placegated(xd: float, xc: float, xa: float, xmean: float,
                   yd: float, yc: float, ya: float, ymean: float,
                   gate_idx: float) -> float {
    if xa > 0.5 && ya > 0.5 { return -1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    // CONFLICT: the place index (gate_idx) selects which faculty's read is the retrieval.
    if gate_idx > 0.5 { return xd }   // place reliable -> trust the place-indexed EPISODE (memory)
    return yd                          // place ambiguous -> trust the spatial vote
}

// LENS B — MEMORY-AUGMENTED MAP. memory (X) supplies a PRIOR that refines the spatial (Y) read.
//   On CONFLICT, the memory recall margin AUGMENTS the spatial confidence: the composed vote is
//   the spatial vote UNLESS the memory margin (its rel-conf) exceeds the spatial margin by the
//   substrate-relative prior — i.e. memory's stored episode overrides the map only when the
//   memory is MORE grounded than the map for THIS item. `prior` is the memory rel-conf; the map
//   read is refined by it. This is the reverse loop (episodic prior refines the metric query).
fn _arb_memaugmap(xd: float, xc: float, xa: float, xmean: float,
                  yd: float, yc: float, ya: float, ymean: float) -> float {
    if xa > 0.5 && ya > 0.5 { return -1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    // CONFLICT: spatial map is the BASE read; the episodic memory prior ADDITIVELY refines it.
    // The refined map confidence = spatial_relconf + PRIOR_GAIN * memory_relconf (the episode
    // boosts the map where the memory is grounded). The memory vote overrides the map ONLY when
    // the memory's OWN grounded prior beats the spatial-plus-half-its-own-prior — a genuinely
    // different additive-refinement rule than the parallel rel-conf comparison (not a tie-only
    // difference). PRIOR_GAIN frozen at 0.5 (the substrate's own half-weight, NO tuned knob).
    let xw = _rel_conf(xc, xmean)            // memory episodic prior
    let yw = _rel_conf(yc, ymean)            // spatial map base
    let refined_map = yw + 0.5 * xw          // memory prior refines the map's confidence
    if xw > refined_map { return xd }        // episode dominates even the refined map -> override
    return yd                                 // else the refined metric vote stands
}

// LENS C — CA3 PATTERN-COMPLETION REMAP. the recurrent attractor completes to whichever faculty's
//   stored pattern is more COMPLETE for THIS item: completeness = (1-abstain)*rel-conf. The loop
//   picks the faculty whose partial cue completes to a fuller stored pattern. On CONFLICT, the
//   higher-completeness faculty wins (a joint read over both populations, distinct from a raw
//   rel-conf vote: it folds abstain-completeness in, the CA3 "pattern is present" signal).
fn _arb_patcomplete(xd: float, xc: float, xa: float, xmean: float,
                    yd: float, yc: float, ya: float, ymean: float) -> float {
    if xa > 0.5 && ya > 0.5 { return -1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    let xcomp = (1.0 - xa) * _rel_conf(xc, xmean)
    let ycomp = (1.0 - ya) * _rel_conf(yc, ymean)
    if xcomp >= ycomp { return xd }
    return yd
}

// ── run one lens over 3 seeds: returns the frozen-bar tuple ──────────────────
// lens: 0=parallel(baseline) 1=placegated 2=memaugmap 3=patcomplete
// mode: 0=normal compose · 1=shuffle control · 2=ablation (gate/refinement OFF == parallel)
fn run_lens_seed(seed: int, cfg: EngineConfig, lens: int, mode: int) -> [float] {
    let n = 5 * N_PER_FAMILY

    // build live faculties (memory + spatial only)
    let mut mem = immune_grow_new(immune_embed_key("mem_" + to_string(seed) + "_0"), "basket", 2048, 2048, true)
    let mut sm = spatial_map_new()
    let mut lk = 0
    while lk < N_LANDMARKS {
        sm = spatial_map_place(sm, "L" + to_string(lk),
                               GRID * _unif(seed, lk, 101), GRID * _unif(seed, lk, 202))
        lk = lk + 1
    }

    // pre-compute item structure + bind memory per item (memory is X / faculty 0)
    let mut fams: [float] = []  let mut corrs: [float] = []
    let mut xms: [float] = []   let mut yms: [float] = []
    let mut xcs: [float] = []   let mut ycs: [float] = []
    let mut b = 0
    while b < n {
        let it = _item(seed, b)
        fams = fams + [it[0]]  corrs = corrs + [it[1]]
        xms = xms + [it[2]]  yms = yms + [it[3]]  xcs = xcs + [it[4]]  ycs = ycs + [it[5]]
        let correct = it[1]
        let cls = if it[4] > 0.5 { correct } else { 1.0 - correct }   // memory (X) bound class
        let val = if cls > 0.5 { "box" } else { "basket" }
        mem = immune_grow_bind(mem, immune_embed_key("mem_" + to_string(seed) + "_" + to_string(b)), val, cfg)
        b = b + 1
    }

    // first pass: live reads + confidence means
    let mut xdec: [float] = []  let mut xcf: [float] = []  let mut xab: [float] = []
    let mut ydec: [float] = []  let mut ycf: [float] = []  let mut yab: [float] = []
    let mut sx = 0.0  let mut sy = 0.0
    let mut i = 0
    while i < n {
        let lx = _leg_memory(mem, seed, i, xcs[i], corrs[i], xms[i])
        let ly = _leg_spatial(sm, seed, i, ycs[i], corrs[i], yms[i])
        xdec = xdec + [lx[0]]  xab = xab + [lx[1]]  xcf = xcf + [lx[2]]  sx = sx + _absf(lx[2])
        ydec = ydec + [ly[0]]  yab = yab + [ly[1]]  ycf = ycf + [ly[2]]  sy = sy + _absf(ly[2])
        i = i + 1
    }
    let xmean = sx / to_float(n)
    let ymean = sy / to_float(n)

    // place-gate index per item (LENS A): place reliable iff the spatial rel-conf >= its mean (1.0).
    // Substrate-relative threshold (rel-conf mean is 1.0 by construction) — NO tuned knob. Under
    // SHUFFLE the gate is decorrelated from the item; under ABLATION the gate is forced OFF
    // (== parallel arbiter, the no-gate baseline).
    let mut gate: [float] = []
    let mut gi = 0
    while gi < n {
        let ps = _rel_conf(ycf[gi], ymean)   // place strength = spatial rel-conf
        let g = if ps >= 1.0 { 1.0 } else { 0.0 }
        gate = gate + [g]
        gi = gi + 1
    }
    // SHUFFLE the gate index (LENS A shuffle control): permute gate across items.
    if mode == 1 && lens == 1 {
        let mut pg: [int] = []
        let mut z = 0
        while z < n { pg = pg + [z]  z = z + 1 }
        let mut stg = _lcg(seed * 2654435761 % 2147483648 + 17)
        let mut ag = n - 1
        while ag > 0 {
            stg = _lcg(stg)  let rg = stg % (ag + 1)
            let tg = pg[ag]  pg[ag] = pg[rg]  pg[rg] = tg
            ag = ag - 1
        }
        let mut ng: [float] = []
        let mut zz = 0
        while zz < n { ng = ng + [gate[pg[zz]]]  zz = zz + 1 }
        gate = ng
    }

    // arbiter dispatch per item
    fn _arb_call(lens: int, mode: int, j: int,
                 xd: float, xc: float, xa: float, xmean: float,
                 yd: float, yc: float, ya: float, ymean: float, g: float) -> float {
        // ABLATION (mode==2): every lens collapses to the no-mechanism PARALLEL arbiter.
        if mode == 2 { return _arb_parallel(xd, xc, xa, xmean, yd, yc, ya, ymean) }
        if lens == 0 { return _arb_parallel(xd, xc, xa, xmean, yd, yc, ya, ymean) }
        if lens == 1 { return _arb_placegated(xd, xc, xa, xmean, yd, yc, ya, ymean, g) }
        if lens == 2 { return _arb_memaugmap(xd, xc, xa, xmean, yd, yc, ya, ymean) }
        return _arb_patcomplete(xd, xc, xa, xmean, yd, yc, ya, ymean)
    }

    // second pass: accuracies + compose + oracle + decomposition
    let mut on_x = 0  let mut on_y = 0  let mut on_c = 0  let mut on_o = 0
    let mut only_x = 0  let mut only_y = 0
    let mut j = 0
    while j < n {
        let xd = xdec[j]  let yd = ydec[j]  let ct = corrs[j]
        let comp = _arb_call(lens, mode, j, xd, xcf[j], xab[j], xmean, yd, ycf[j], yab[j], ymean, gate[j])
        let x_ok = (xab[j] < 0.5) && (xd == ct)
        let y_ok = (yab[j] < 0.5) && (yd == ct)
        if x_ok { on_x = on_x + 1 }
        if y_ok { on_y = on_y + 1 }
        if comp >= 0.0 && comp == ct { on_c = on_c + 1 }
        if x_ok || y_ok { on_o = on_o + 1 }
        if x_ok && !y_ok { only_x = only_x + 1 }
        if y_ok && !x_ok { only_y = only_y + 1 }
        j = j + 1
    }

    // shuffle control for the GENERAL arbiter (permute the faculty reads, re-arbitrate) —
    // identical to H_1417 B3; for LENS A the gate-shuffle above ALSO applies. This is the B3
    // anti-Goodhart: a faculty-decorrelated compose must collapse to chance.
    let mut pm: [int] = []  let mut pn: [int] = []
    let mut s = 0
    while s < n { pm = pm + [s]  pn = pn + [s]  s = s + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r1 = st % (a + 1)
        let tmp = pm[a]  pm[a] = pm[r1]  pm[r1] = tmp
        st = _lcg(st)  let r2 = st % (a + 1)
        let tmpb = pn[a]  pn[a] = pn[r2]  pn[r2] = tmpb
        a = a - 1
    }
    let mut on_s = 0
    let mut k = 0
    while k < n {
        let mi = pm[k]  let ni = pn[k]
        let comp = _arb_call(lens, 0, k, xdec[mi], xcf[mi], xab[mi], xmean,
                             ydec[ni], ycf[ni], yab[ni], ymean, gate[mi])
        if comp >= 0.0 && comp == corrs[k] { on_s = on_s + 1 }
        k = k + 1
    }

    let dn = to_float(n)
    let ax = to_float(on_x) / dn
    let ay = to_float(on_y) / dn
    let best = if ax >= ay { ax } else { ay }
    return [ax, ay, best, to_float(on_c)/dn, to_float(on_s)/dn, to_float(on_o)/dn,
            to_float(only_x)/dn, to_float(only_y)/dn]
}

fn _seeds() -> [int] { return [5500, 5501, 5502] }   // P1 memory×spatial seed triple (H_1417)

fn _lens_name(lens: int) -> string {
    if lens == 0 { return "BASELINE parallel-vote (H_1417 P1 reproduce)" }
    if lens == 1 { return "LENS A — PLACE-GATED RECALL (spatial indexes memory)" }
    if lens == 2 { return "LENS B — MEMORY-AUGMENTED MAP (episodic prior refines map)" }
    return "LENS C — CA3 PATTERN-COMPLETION REMAP (completeness attractor)"
}

// run a lens: normal + shuffle + ablation; print frozen bars + the breakthrough verdict.
fn run_lens(lens: int, cfg: EngineConfig) -> bool {
    let seeds = _seeds()
    let ns = to_float(len(seeds))
    let mut ax = 0.0  let mut ay = 0.0  let mut best = 0.0
    let mut ac = 0.0  let mut ash = 0.0  let mut ao = 0.0  let mut ox = 0.0  let mut oy = 0.0
    let mut aabl = 0.0
    let mut si = 0
    while si < len(seeds) {
        let r = run_lens_seed(seeds[si], cfg, lens, 0)
        ax = ax + r[0]  ay = ay + r[1]  best = best + r[2]
        ac = ac + r[3]  ash = ash + r[4]  ao = ao + r[5]  ox = ox + r[6]  oy = oy + r[7]
        let rabl = run_lens_seed(seeds[si], cfg, lens, 2)
        aabl = aabl + rabl[3]
        si = si + 1
    }
    ax = ax/ns  ay = ay/ns  best = best/ns  ac = ac/ns  ash = ash/ns  ao = ao/ns
    ox = ox/ns  oy = oy/ns  aabl = aabl/ns

    let B1 = ac >= best + COMPOSE_DELTA
    let B2 = (ao - best) > ORACLE_MARGIN
    let B3 = (ac - ash) > SHUFFLE_TOL
    let SEP = ox > 0.0 && oy > 0.0
    // ABLATION-NOT-INERT: the mechanism must lift the compose ABOVE its own ablated (no-mechanism)
    // baseline. compose - ablate > 0 ⇒ the mechanism contributes; <= 0 ⇒ INERT (ceiling evidence).
    let ABL = (ac - aabl) > 0.0
    let bound = B1 && B2 && B3 && SEP && ABL

    println("--------------------------------------------------------------------------------")
    println(_lens_name(lens))
    println("  acc_mem=" + _f4(ax) + " acc_spatial=" + _f4(ay) + " best=" + _f4(best))
    println("  compose=" + _f4(ac) + " shuffle=" + _f4(ash) + " ablate=" + _f4(aabl)
          + " oracle=" + _f4(ao))
    println("  only_mem=" + _f4(ox) + " only_spatial=" + _f4(oy)
          + " | net-lift(compose-best)=" + _f4(ac - best))
    println("  compose-shuffle=" + _f4(ac - ash) + " | compose-ablate=" + _f4(ac - aabl)
          + " (>0 ⇒ mechanism contributes; <=0 ⇒ INERT ceiling evidence)")
    println("  (B1 " + (if B1 {"PASS"} else {"FAIL"}) + ") (B2 " + (if B2 {"PASS"} else {"FAIL"})
          + ") (B3 " + (if B3 {"PASS"} else {"FAIL"}) + ") (SEP " + (if SEP {"PASS"} else {"FAIL"})
          + ") (ABL-not-inert " + (if ABL {"PASS"} else {"FAIL/INERT"}) + ")")
    println("  ==> " + (if bound { "🟢 BOUND (lift REAL + earned + non-inert)" }
                        else { "🧱 WALL (this lens does not bind)" }))
    return bound
}

fn main() {
    println("================================================================================")
    println("H_1419 — MULTI-LENS breakthrough on the memory×spatial COMPOSE WALL (H_1417 P1 🧱)")
    println("  3 hippocampal-formation lenses (place-gated · memory-augmented · pattern-complete)")
    println("  FROZEN H_1417 bars VERBATIM · shuffle+ablation per lens · $0 CPU · p7 · c9 · c16")
    println("  WALL recap: H_1417 P1 parallel-vote net-lift +0.0089 < +0.05 (oracle headroom +0.241")
    println("              existed but the parallel arbiter captured almost none of it)")
