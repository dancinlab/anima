// H_9071 substrate self-organized criticality — ENGINE-NATIVE characterization on live core/.
//
// Pre-registered (card cards/H_9071_substrate_self_organized_criticality.md):
//   kick one lane on the LIVE 15-lane brain topology (topo_brain_adjacency) → count lanes crossing
//   activation threshold = avalanche size s. Branching σ = mean lanes activated in the FIRST step
//   after a single kick (Beggs-Plenz gen-1 ratio). Collect P(s). Dynamic range Δ = 10·log10(r90/r10)
//   over an external-drive stimulus sweep (Kinouchi-Copelli).
//
//   FROZEN BARS (no tune-to-green):
//     B1 σ-tunable-to-1  : σ(crit) ∈ [0.80,1.25] AND σ(sub) < σ(crit) < σ(super) (gain→σ monotone)
//     B2 P(s) heavy tail : heavy-tail frac(s≥5) at criticality ≥ 2× subcritical (power-law emerges)
//     B3 dyn-range peak  : Δ(crit) > Δ(sub) AND Δ(crit) > Δ(super)  (payoff at σ≈1)
//     B4 ablation decisive: max Δ − min Δ over the 3 gains ≥ 3.0 dB (gain-detune NOT flat = not INERT)
//     B5 shuffle breaks  : heavy-tail frac at crit on degree-matched SHUFFLE < 0.5× brain
//                          (pre-reg connectome-specificity test — degree-preserving randomize)
//
//   crit gain g_c is DERIVED (1/⟨k⟩), NOT tuned to the metric; σ is a measured confirmation.
//   shuffle = topo_degree_matched_random (degree-preserving) ; ablation = coupling gain detune.
//
// usage: hexa run state/9071_substrate_self_organized_criticality/soc_engine_native.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn zeros_i(n: int) -> [int] {
    let mut a = []
    let mut i = 0
    while i < n { a = a + [0]  i = i + 1 }
    return a
}

fn avg_degree(a: [[float]]) -> float {
    let n = len(a)
    let mut m = 0
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n { if a[i][j] > 0.5 { m = m + 1 } j = j + 1 }
        i = i + 1
    }
    return to_float(m) / to_float(n)
}

// ONE avalanche from a single kicked lane. Refractory (each lane fires once). Per-edge activation
// probability = gain. Returns [size, gen1, rng]. gen1 = lanes activated in the FIRST step (the
// branching numerator for a single-seed kick).
fn sim_avalanche(a: [[float]], gain: float, seed_lane: int, rng0: int) -> [int] {
    let n = len(a)
    let mut fired = zeros_i(n)
    fired[seed_lane] = 1
    let mut active = [seed_lane]
    let mut size = 1
    let mut gen1 = 0
    let mut rng = rng0
    let mut gen = 0
    while len(active) > 0 {
        let mut nxt = []
        let mut p = 0
        while p < len(active) {
            let i = active[p]
            let mut j = 0
            while j < n {
                if a[i][j] > 0.5 { if fired[j] == 0 {
                    rng = (rng * 1103515245 + 12345) & 2147483647
                    let u = to_float(rng) / 2147483648.0
                    if u < gain {
                        fired[j] = 1
                        nxt = nxt + [j]
                        size = size + 1
                        if gen == 0 { gen1 = gen1 + 1 }
                    }
                } }
                j = j + 1
            }
            p = p + 1
        }
        active = nxt
        gen = gen + 1
    }
    return [size, gen1, rng]
}

// ONE externally-driven trial: each lane seeded with prob r, then refractory propagation at `gain`.
// Returns [num_fired, rng]. Response F(r) = mean num_fired/n.
fn sim_driven(a: [[float]], gain: float, r: float, rng0: int) -> [int] {
    let n = len(a)
    let mut fired = zeros_i(n)
    let mut active = []
    let mut rng = rng0
    let mut i = 0
    while i < n {
        rng = (rng * 1103515245 + 12345) & 2147483647
        let u = to_float(rng) / 2147483648.0
        if u < r { fired[i] = 1  active = active + [i] }
        i = i + 1
    }
    while len(active) > 0 {
        let mut nxt = []
        let mut p = 0
        while p < len(active) {
            let ii = active[p]
            let mut j = 0
            while j < n {
                if a[ii][j] > 0.5 { if fired[j] == 0 {
                    rng = (rng * 1103515245 + 12345) & 2147483647
                    let u2 = to_float(rng) / 2147483648.0
                    if u2 < gain { fired[j] = 1  nxt = nxt + [j] }
                } }
                j = j + 1
            }
            p = p + 1
        }
        active = nxt
    }
    let mut c = 0
    i = 0
    while i < n { c = c + fired[i]  i = i + 1 }
    return [c, rng]
}

// P(s) + σ over all seed lanes × trials. Returns [meanSigma_x1000(int), htFrac_x10000(int),
// meanSize_x1000(int)] plus threads rng out is dropped (fresh seed each call). We return floats via
// a small struct-less encoding: use a 3-float array through a wrapper below.
struct SocStat { sigma: float, htfrac: float, meansize: float }

fn collect_ps(a: [[float]], gain: float, trials: int, ht_thr: int) -> SocStat {
    let n = len(a)
    let mut rng = 20260702
    let mut sig_sum = 0.0
    let mut sz_sum = 0.0
    let mut ht = 0
    let mut cnt = 0
    let mut t = 0
    while t < trials {
        let mut seed = 0
        while seed < n {
            let res = sim_avalanche(a, gain, seed, rng)
            let size = res[0]
            let gen1 = res[1]
            rng = res[2]
            sig_sum = sig_sum + to_float(gen1)
            sz_sum = sz_sum + to_float(size)
            if size >= ht_thr { ht = ht + 1 }
            cnt = cnt + 1
            seed = seed + 1
        }
        t = t + 1
    }
    let fc = to_float(cnt)
    return SocStat { sigma: sig_sum / fc, htfrac: to_float(ht) / fc, meansize: sz_sum / fc }
}

// F(r) at one stimulus level over trials.
fn response_F(a: [[float]], gain: float, r: float, trials: int, rng0: int) -> [float] {
    let n = len(a)
    let mut rng = rng0
    let mut acc = 0.0
    let mut t = 0
    while t < trials {
        let res = sim_driven(a, gain, r, rng)
        acc = acc + to_float(res[0]) / to_float(n)
        rng = res[1]
        t = t + 1
    }
    return [acc / to_float(trials), to_float(rng)]
}

// Dynamic range Δ = 10·log10(r90/r10) over a log-spaced r grid.
fn dynamic_range(a: [[float]], gain: float, kgrid: int, trials: int) -> float {
    let rmin = 0.002
    let rmax = 0.8
    let lmin = ln(rmin)
    let lmax = ln(rmax)
    let mut rs = []
    let mut fs = []
    let mut rng = 777
    let mut k = 0
    while k < kgrid {
        let frac = to_float(k) / to_float(kgrid - 1)
        let r = exp(lmin + frac * (lmax - lmin))
        let rf = response_F(a, gain, r, trials, rng)
        rs = rs + [r]
        fs = fs + [rf[0]]
        rng = (rng * 1103515245 + 12345) & 2147483647
        k = k + 1
    }
    let flo = fs[0]
    let fhi = fs[kgrid - 1]
    let span = fhi - flo
    if span < 0.000001 { return 0.0 }
    let f10 = flo + 0.1 * span
    let f90 = flo + 0.9 * span
    // find r10, r90 by first-crossing + linear interpolation in r.
    let mut r10 = rs[0]
    let mut r90 = rs[kgrid - 1]
    let mut i = 1
    let mut got10 = 0
    let mut got90 = 0
    while i < kgrid {
        if got10 == 0 { if fs[i] >= f10 {
            let d = fs[i] - fs[i - 1]
            let mut w = 0.0
            if d > 0.000001 { w = (f10 - fs[i - 1]) / d }
            r10 = rs[i - 1] + w * (rs[i] - rs[i - 1])
            got10 = 1
        } }
        if got90 == 0 { if fs[i] >= f90 {
            let d = fs[i] - fs[i - 1]
            let mut w = 0.0
            if d > 0.000001 { w = (f90 - fs[i - 1]) / d }
            r90 = rs[i - 1] + w * (rs[i] - rs[i - 1])
            got90 = 1
        } }
        i = i + 1
    }
    if r10 < 0.0000001 { r10 = 0.0000001 }
    return 10.0 * (ln(r90 / r10) / ln(10.0))
}

fn main() {
    let brain = topo_brain_adjacency()
    let kbar = avg_degree(brain)
    let g_c = 1.0 / kbar                 // DERIVED critical gain (not tuned to metric)
    let g_sub = 0.5 * g_c
    let g_super = 1.7 * g_c

    let PS_TRIALS = 200
    let DR_GRID = 20
    let DR_TRIALS = 140
    let HT_THR = 5                        // heavy-tail threshold s ≥ n/3

    // ── branching σ + P(s) at 3 gains on the LIVE brain topology ──
    let sub = collect_ps(brain, g_sub, PS_TRIALS, HT_THR)
    let crit = collect_ps(brain, g_c, PS_TRIALS, HT_THR)
    let sup = collect_ps(brain, g_super, PS_TRIALS, HT_THR)

    // ── shuffle control: degree-matched random rewiring (degree-preserving) at crit gain ──
    let shuf = topo_degree_matched_random(13)
    let shuf_kbar = avg_degree(shuf)
    let shuf_stat = collect_ps(shuf, g_c, PS_TRIALS, HT_THR)

    // ── dynamic range Δ at 3 gains (Kinouchi-Copelli) ──
    let dr_sub = dynamic_range(brain, g_sub, DR_GRID, DR_TRIALS)
    let dr_crit = dynamic_range(brain, g_c, DR_GRID, DR_TRIALS)
    let dr_super = dynamic_range(brain, g_super, DR_GRID, DR_TRIALS)
    let dr_shuf = dynamic_range(shuf, g_c, DR_GRID, DR_TRIALS)

    let mut dmax = dr_sub
    if dr_crit > dmax { dmax = dr_crit }
    if dr_super > dmax { dmax = dr_super }
    let mut dmin = dr_sub
    if dr_crit < dmin { dmin = dr_crit }
    if dr_super < dmin { dmin = dr_super }

    println("INFO topology: brain 15-lane, ⟨k⟩=" + to_string(kbar) + " g_c=1/⟨k⟩=" + to_string(g_c))
    println("INFO gains: sub=" + to_string(g_sub) + " crit=" + to_string(g_c) + " super=" + to_string(g_super))
    println("INFO sigma:   sub=" + to_string(sub.sigma) + " crit=" + to_string(crit.sigma) + " super=" + to_string(sup.sigma) + " | shuffle@crit=" + to_string(shuf_stat.sigma) + " (⟨k⟩shuf=" + to_string(shuf_kbar) + ")")
    println("INFO meansize:sub=" + to_string(sub.meansize) + " crit=" + to_string(crit.meansize) + " super=" + to_string(sup.meansize))
    println("INFO htfrac(s>=5): sub=" + to_string(sub.htfrac) + " crit=" + to_string(crit.htfrac) + " super=" + to_string(sup.htfrac) + " | shuffle@crit=" + to_string(shuf_stat.htfrac))
    println("INFO dyn-range dB: sub=" + to_string(dr_sub) + " crit=" + to_string(dr_crit) + " super=" + to_string(dr_super) + " | shuffle@crit=" + to_string(dr_shuf))

    let mut np = 0
    // B1 — σ tunable to ≈1 at derived critical gain, monotone in gain
    let b1 = (crit.sigma >= 0.80) && (crit.sigma <= 1.25) && (sub.sigma < crit.sigma) && (crit.sigma < sup.sigma)
    if _ab("B1 σ(crit)∈[0.80,1.25] & σ monotone in gain (sub<crit<super)", b1) { np = np + 1 }
    // B2 — heavy-tail power-law emerges at criticality
    let b2 = crit.htfrac >= 2.0 * sub.htfrac
    if _ab("B2 heavy-tail frac(s>=5) crit >= 2x sub (P(s) power-law emerges)", b2) { np = np + 1 }
    // B3 — dynamic-range payoff peaks at σ≈1
    let b3 = (dr_crit > dr_sub) && (dr_crit > dr_super)
    if _ab("B3 dyn-range Δ(crit) > Δ(sub) AND > Δ(super) (payoff at σ≈1)", b3) { np = np + 1 }
    // B4 — ablation (gain detune) decisive: Δ NOT flat vs gain
    let b4 = (dmax - dmin) >= 3.0
    if _ab("B4 gain-detune decisive: maxΔ-minΔ >= 3.0 dB (NOT flat=INERT)", b4) { np = np + 1 }
    // B5 — shuffle breaks the power-law (connectome-specificity)
    let b5 = shuf_stat.htfrac < 0.5 * crit.htfrac
    if _ab("B5 degree-shuffle breaks power-law: htfrac(shuf) < 0.5x brain (connectome-specific)", b5) { np = np + 1 }

    println("--- H_9071 substrate SOC engine-native: " + to_string(np) + " pass / " + to_string(5 - np) + " fail ---")
}
