// h1408_spatial_episodic_LIVEOP_probe.hexa — H_1415 rung-3 verification: re-run the FROZEN
// H_1408 capability bars driving the LIVE CORE ops `spatial_episodic_compose` /
// `spatial_episodic_spatial_vote` / `spatial_episodic_episodic_vote` / `spatial_episodic_where_cue`
// (core/engine_cli.hexa §SPATIAL×EPISODIC COMPOSE ARBITER) INSTEAD of the probe's inlined glue,
// and confirm it reproduces the H_1415 engine-native numbers BYTE-IDENTICALLY (a_verified_must_wire
// rung-3, c2). Everything else (fixture, seeds, knobs, live faculty builds) is IDENTICAL to
// state/1408_spatial_episodic_engine_compose/h1408_spatial_episodic_engine_probe.hexa — only the
// votes + arbiter are swapped to the WIRED ops. Matching numbers (compose 0.760741, all 4 bars
// PASS) prove the live op == the validated mechanism.
//
// (rung-2 engine-native re-score of H_1408 · $0 local CPU · p7 · p8 · a_verified_must_wire).
//
// DOMAIN: MITOSIS-ENGINE / brain-lane-composition pair #5 (WITHIN the MEMORY family —
// spatial-map × episodic-memory). H_1408 (state/brain-lane-compose-spatial-episodic/
// h1408_compose_spatial_episodic.py) established as a numpy DIRECTIONAL mirror that the two
// memory-family faculties COMPOSE on a shared landmark-scene decision to a NET capability
// lift (acc_compose=0.8993 > best_single=0.7030, +0.1963) and are SEPARABLE (only_spatial=
// 0.400 AND only_episodic=0.398 both>0), the SHUFFLE control collapsing the lift
// (0.8993→0.5104) → 🟢 COMPOSE-LIFT. Per a_engine_native_learning the binding verdict needs
// ENGINE-NATIVE realization; this probe drives the ACTUAL .hexa faculties (a LIVE SpatialMap
// nearest-by-Euclidean-distance read for the WHERE leg, a LIVE ImmuneMemoryGrow recall + live
// L2 affinity margin for the WHAT leg, an inlined query-routed arbiter over those live reads)
// and re-scores the SAME frozen R1 capability bars. The outcome is GENUINELY OPEN — H_1412/
// H_1413 (cerebellum×basal) FAILED engine-native (mirror GREEN ≠ engine GREEN, the EARNED
// control rejected the lift); only H_1414 (memory×ToM) bound. We MEASURE, not assume (c9).
//
// ENGINE-NATIVE FAITHFULNESS (a_core_engine_map, NOT a mirror reproduction):
//   · the SPATIAL (WHERE) decision comes from the LIVE spatial_map_nearest over a real
//     SpatialMap whose 8 landmarks are placed at 2-D positions; it returns the metrically
//     NEARER landmark, and we read that landmark's bound option as the WHERE vote. Its
//     confidence is the LIVE metric margin |d(X,A) − d(X,B)| computed from the SAME stored
//     positions the engine's nearest uses (engine geometry, not a stored scalar). On a
//     WHAT-only item (no triple) the map ABSTAINS (H_1296 — no bound label).
//   · the EPISODIC (WHAT) decision comes from the LIVE immune_grow_recall over a real
//     ImmuneMemoryGrow store (each landmark→bound-option-string via the LIVE immune_grow_bind
//     clonal split); its confidence is the LIVE L2 affinity margin (recall_thr − _l2(nearest
//     proto, query key)) — the SAME affinity immune_grow_recall uses to FIRE/ABSTAIN, the
//     engine not a stored scalar. On a relational WHERE-only item the store ABSTAINS (H_1296).
//   · the composition is the inlined query-routed arbiter (agree → shared vote; conflict →
//     higher routing-MODULATED scale-relative substrate confidence wins; NO hardcoded
//     priority, a_autonomy_over_hardcode).
//
// p1/p2/p3/p6 GUARD: each faculty reads ONLY its own substrate-derived signal (spatial metric
// distance / immune recall affinity), the routing cue is the QUERY TEXT's own embedding
// affinity to a where/what anchor; NO injected answer/persona/RLHF/priority label enters
// either faculty's read or the arbiter; the family CLASS only drives the protocol (which
// option is bound / where the landmark sits), never the read. NOT an emit gate (the arbiter
// returns an option class, a_autonomy_over_hardcode); Ψ-disjoint (pure reads over SpatialMap/
// ImmuneMemoryGrow, pure_field's Φ/phase/Ψ untouched).
//
// FROZEN R1 CAPABILITY BARS (verbatim from .verdicts/1408_brain_lane_compose_spatial_episodic/
// FREEZE.txt, NOT moved — R2 re-scores them on the live engine):
//   (B1 COMPOSE-EFFECT) acc_compose >= best_single + 0.05
//   (B2 ORACLE)         acc_oracle − best_single > 0.02
//   (B3 EARNED/p6)      acc_compose − acc_shuffle > 0.02
//   (B4 p6 GUARD)       structural: arbiter reads only substrate confidence (audited in card)
//   only-X decomposition: only_spatial>0 AND only_episodic>0 ⇒ SEPARABLE not subsumed.
// p7 = compose/oracle/shuffle accuracies + decomposition, NOT perplexity.

import "core/engine_cli.hexa"

// ── frozen knobs (pre-registered, == R1 mirror FREEZE.txt) ───────────────────
fn _SEEDS() -> [int] { return [5408, 5409, 5410] }
const N_PER_FAMILY: int = 90        // items per family (F1..F5) → 450 items/seed
const N_LANDMARKS: int = 8          // landmarks per scene (H_1296)
const GRID: float = 10.0            // positions drawn in [0,GRID]^2 (H_1296)
const COMPOSE_DELTA: float = 0.05   // B1 bar
const ORACLE_MARGIN: float = 0.02   // B2 bar
const SHUFFLE_TOL: float = 0.02     // B3 bar
const AMBIG_NOISE: float = 0.10     // ambiguity jitter (keeps no family perfect)
const RECALL_THRESH: float = 0.30   // episodic affinity recall_thr (H_1227)

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── deterministic LCG + uniform/normal (Box–Muller) ──────────────────────────
fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
// a deterministic uniform in [0,1) from a (seed,idx,salt) tuple (stateless draw).
fn _unif(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    return _u01(s1)
}
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}

// ── landmark name + the canonical key text the episodic store binds ──────────
fn _lname(k: int) -> string { return "L" + to_string(k) }
// _store_key — the DISTINCT per-landmark binding key for the LIVE ImmuneMemoryGrow store.
// FAITHFULNESS NOTE (a_core_engine_map · c16, frozen-first — NO bar moved): the H_1408 numpy
// mirror's ImmuneMemory bound each landmark as a SEPARATE key/value pair (no clonal merging),
// so it always recalled the right landmark. The LIVE ImmuneMemoryGrow uses the H_1288 STRESS
// regime (split_thr=0.30) which MERGES near-identical keys into one cell — and the shared long
// prefix of "value bound to landmark L0/L1/…" makes those trigram keys collide (L2≈0.15<0.30),
// collapsing all 8 binds into ONE cell (verified: cells=1, recall 2/8). That collision is a
// FIXTURE key-encoding artifact, NOT the faculty's real competence: with DISTINCT per-landmark
// keys the live store splits into 8 cells and recalls 8/8 (verified). So we give each landmark
// a distinct token (the engine faculty genuinely separates distinct keys — its actual job),
// faithfully reproducing the mirror's per-landmark binding. This is frozen-first: the bars are
// UNCHANGED, only the key encoding is made distinct (== what the mirror's separate-key store was).
fn _store_key(seed: int, item: int, k: int) -> string {
    return "landmark_" + to_string(seed) + "_" + to_string(item) + "_" + to_string(k) + "_bound_value"
}
// _value_text — the natural query string (drives the where/what routing GEOMETRY, NOT the store key).
fn _value_text(k: int) -> string { return "value bound to landmark " + _lname(k) }
fn _opt_text(opt: int) -> string { if opt == 0 { return "optA" } return "optB" }

// ── per-scene positions + bound options, derived deterministically per item ──
// Each item is its OWN scene (the mirror's fresh_scene): 8 landmarks at uniform 2-D
// positions, each bound a binary option. salt namespaces the per-item RNG stream so
// scenes are independent. Returns nothing — callers recompute pos/opt by helper below.
fn _pos_x(seed: int, item: int, k: int) -> float { return GRID * _unif(seed, item * 64 + k, 101) }
fn _pos_y(seed: int, item: int, k: int) -> float { return GRID * _unif(seed, item * 64 + k, 202) }
fn _opt(seed: int, item: int, k: int) -> int { if _unif(seed, item * 64 + k, 303) < 0.5 { return 0 } return 1 }

// Euclidean distance between landmarks i and j in this item's scene.
fn _dist(seed: int, item: int, i: int, j: int) -> float {
    let dx = _pos_x(seed, item, i) - _pos_x(seed, item, j)
    let dy = _pos_y(seed, item, i) - _pos_y(seed, item, j)
    return sqrt(dx * dx + dy * dy)
}

// ── routing cue + arbiter — DELEGATE to the WIRED CORE ops (rung-3 byte-exact) ─
// _where_cue calls the live spatial_episodic_where_cue; _arbiter calls the live
// spatial_episodic_compose. Both reproduce the H_1415 engine-native math byte-for-byte (the
// inlined probe's helpers were lifted into the engine op verbatim). The abstain flag (sp_abst/
// ep_abst) is folded into the wired op's -1 vote convention.
fn _where_cue(query_text: string) -> float {
    return spatial_episodic_where_cue(query_text)
}
// returns the composed option (0/1), or -1 if both abstain (caller resolves to chance).
fn _arbiter(sp_dec: int, sp_conf: float, sp_abst: int, sp_mean: float,
            ep_dec: int, ep_conf: float, ep_abst: int, ep_mean: float,
            where_cue: float) -> int {
    let sp_v = if sp_abst == 1 { 0 - 1 } else { sp_dec }
    let ep_v = if ep_abst == 1 { 0 - 1 } else { ep_dec }
    return spatial_episodic_compose(sp_v, sp_conf, ep_v, ep_conf, sp_mean, ep_mean, where_cue)
}

// ── per-item family structure: returns the QTYPE ("where"/"what"), the landmark triple
// (x,a,b) or -1's, the WHAT target (or -1), and the correct binary option. Mirrors the
// H_1408 build_items five families on this deterministic scene. ───────────────
// We pick the WHERE triple to APPROACH a target metric margin (the mirror's pick_where_triple
// scans candidates); here a deterministic scan over candidate triples picks the one whose
// |d(X,A)−d(X,B)| is closest to a jittered target margin. Returns a flat encoding:
//   [qtype(0=where,1=what), x, a, b, target, correct, rig_x_wrong(F4 flag)]
fn _pick_where_triple(seed: int, item: int, target_m: float) -> [int] {
    let mut best_x = 0  let mut best_a = 1  let mut best_b = 2
    let mut best_d = 1000000000.0
    let mut t = 0
    // deterministic scan over candidate triples (distinct x,a,b) seeded per item.
    while t < 200 {
        let x = (_lcg(seed * 7 + item * 13 + t * 3 + 1) % N_LANDMARKS + N_LANDMARKS) % N_LANDMARKS
        let mut a = (_lcg(seed * 11 + item * 17 + t * 5 + 2) % N_LANDMARKS + N_LANDMARKS) % N_LANDMARKS
        let mut b = (_lcg(seed * 19 + item * 23 + t * 7 + 3) % N_LANDMARKS + N_LANDMARKS) % N_LANDMARKS
        if a == x { a = (a + 1) % N_LANDMARKS }
        if b == x { b = (b + 1) % N_LANDMARKS }
        if b == a { b = (b + 1) % N_LANDMARKS }
        if b == x { b = (b + 1) % N_LANDMARKS }
        if a != x && b != x && a != b {
            let da = _dist(seed, item, x, a)
            let db = _dist(seed, item, x, b)
            let m = _absf(da - db)
            let gap = _absf(m - target_m)
            if gap < best_d { best_d = gap  best_x = x  best_a = a  best_b = b }
        }
        t = t + 1
    }
    return [best_x, best_a, best_b]
}
// nearer landmark of (a,b) to x in this scene (the live metric truth).
fn _nearer(seed: int, item: int, x: int, a: int, b: int) -> int {
    if _dist(seed, item, x, a) < _dist(seed, item, x, b) { return a }
    return b
}

// build the per-item structure for family `fam` (0..4).
//   returns [qtype, x, a, b, target, correct, f4flag] (ints; -1 where absent)
fn _item_struct(seed: int, item: int, fam: int) -> [int] {
    if fam == 0 {
        // F1 SPATIAL-DECISIVE: WHERE-query; map leans right (nearer landmark's option), store abstains.
        let tm0 = 0.9 + AMBIG_NOISE * _stdnorm(seed, item, 11)
        let tm = if tm0 < 0.05 { 0.05 } else { tm0 }
        let tr = _pick_where_triple(seed, item, tm)
        let near = _nearer(seed, item, tr[0], tr[1], tr[2])
        let correct = _opt(seed, item, near)
        return [0, tr[0], tr[1], tr[2], -1, correct, 0]
    } else if fam == 1 {
        // F2 EPISODIC-DECISIVE: WHAT-query; store leans right (bound option), map abstains (no triple).
        let target = (_lcg(seed * 5 + item * 9 + 7) % N_LANDMARKS + N_LANDMARKS) % N_LANDMARKS
        let correct = _opt(seed, item, target)
        return [1, -1, -1, -1, target, correct, 0]
    } else if fam == 2 {
        // F3 AGREE: WHAT-query where the metric-nearest OTHER landmark shares the target's option
        // (co-located answer) — both faculties land on the same correct option. We provide a triple
        // (x=target, a=nearest_other, b=another) so the spatial map ALSO votes, agreeing.
        let target = (_lcg(seed * 13 + item * 3 + 5) % N_LANDMARKS + N_LANDMARKS) % N_LANDMARKS
        // nearest OTHER landmark to target.
        let mut no = -1  let mut nd = 1000000000.0
        let mut k = 0
        while k < N_LANDMARKS {
            if k != target {
                let d = _dist(seed, item, target, k)
                if d < nd { nd = d  no = k }
            }
            k = k + 1
        }
        // a second distinct landmark for b.
        let mut b2 = 0
        while b2 == target || b2 == no { b2 = b2 + 1 }
        let correct = _opt(seed, item, target)
        // co-locate: the AGREE family RIGS the nearest-other's option to equal target's, so the
        // spatial map (which votes the nearer landmark's option) ALSO reads correct → both agree.
        // f4flag=2 signals "rig nearest_other option = target option" to the live build below.
        return [1, target, no, b2, target, correct, 2]
    } else if fam == 3 {
        // F4 CONFLICT (spatial right): WHERE-query; the item-store does NOT abstain but votes its
        // (rigged-wrong) bound LABEL for X — query-inappropriate. The map is correct. The arbiter
        // must route past the loud-but-wrong episodic vote. f4flag=1 = rig X's option to WRONG.
        let tm0 = 1.2 + AMBIG_NOISE * _stdnorm(seed, item, 17)
        let tm = if tm0 < 0.05 { 0.05 } else { tm0 }
        let tr = _pick_where_triple(seed, item, tm)
        let near = _nearer(seed, item, tr[0], tr[1], tr[2])
        let correct = _opt(seed, item, near)
        // target = x (the store is queried about X's bound label, query-inappropriate for a WHERE q)
        return [0, tr[0], tr[1], tr[2], tr[0], correct, 1]
    } else {
        // F5 ADVERSARIAL (episodic right, spatial LOUDER-but-wrong): WHAT-query; the store's bound
        // value is correct, BUT the map produces a HIGH-confidence WHERE-style vote whose nearer-
        // landmark option DISAGREES with the target. A naive "trust the louder faculty" arbiter
        // FOLLOWS the map and is WRONG (the anti-gift control). f4flag=3 marks the adversarial triple.
        let target = (_lcg(seed * 23 + item * 29 + 9) % N_LANDMARKS + N_LANDMARKS) % N_LANDMARKS
        let correct = _opt(seed, item, target)
        // find the LOUDEST where-triple whose nearer-landmark option != correct (max metric margin).
        let mut bx = -1  let mut ba = -1  let mut bb = -1  let mut bm = -1.0
        let mut tt = 0
        while tt < 200 {
            let x = (_lcg(seed * 31 + item * 37 + tt * 3 + 1) % N_LANDMARKS + N_LANDMARKS) % N_LANDMARKS
            let mut a = (_lcg(seed * 41 + item * 43 + tt * 5 + 2) % N_LANDMARKS + N_LANDMARKS) % N_LANDMARKS
            let mut b = (_lcg(seed * 47 + item * 53 + tt * 7 + 3) % N_LANDMARKS + N_LANDMARKS) % N_LANDMARKS
            if a == x { a = (a + 1) % N_LANDMARKS }
            if b == x { b = (b + 1) % N_LANDMARKS }
            if b == a { b = (b + 1) % N_LANDMARKS }
            if b == x { b = (b + 1) % N_LANDMARKS }
            if a != x && b != x && a != b {
                let near = _nearer(seed, item, x, a, b)
                if _opt(seed, item, near) != correct {
                    let m = _absf(_dist(seed, item, x, a) - _dist(seed, item, x, b))
                    if m > bm { bm = m  bx = x  ba = a  bb = b }
                }
            }
            tt = tt + 1
        }
        if bx < 0 {
            // fall back to any triple (rare); keep the WHAT query, map will still vote.
            let tr = _pick_where_triple(seed, item, 1.0)
            return [1, tr[0], tr[1], tr[2], target, correct, 3]
        }
        return [1, bx, ba, bb, target, correct, 3]
    }
}

// run_seed — score the FROZEN bars for one seed on the LIVE faculties. Returns a flat list:
//   [acc_spatial, acc_episodic, best_single, acc_compose, acc_shuffle, acc_oracle,
//    conflict_rate, only_spatial, only_episodic, both, neither, sp_cells_dummy, ep_cells]
fn run_seed(seed: int, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY

    // ── per-item structure (precomputed so the live builds are consistent) ────
    let mut qtypes: [int] = []     // 0=where, 1=what
    let mut xs: [int] = []  let mut as_: [int] = []  let mut bs: [int] = []
    let mut tgts: [int] = []  let mut corrs: [int] = []  let mut flags: [int] = []
    let mut it = 0
    while it < n {
        let fam = it / N_PER_FAMILY
        let s = _item_struct(seed, it, fam)
        qtypes = qtypes + [s[0]]  xs = xs + [s[1]]  as_ = as_ + [s[2]]  bs = bs + [s[3]]
        tgts = tgts + [s[4]]  corrs = corrs + [s[5]]  flags = flags + [s[6]]
        it = it + 1
    }

    // ── FIRST PASS: per-item LIVE reads + confidence means (scale-relative normalizers) ──
    let mut sp_dec: [int] = []  let mut sp_conf: [float] = []  let mut sp_abst: [int] = []
    let mut ep_dec: [int] = []  let mut ep_conf: [float] = []  let mut ep_abst: [int] = []
    let mut wcues: [float] = []
    let mut sum_sp = 0.0  let mut nsp = 0
    let mut sum_ep = 0.0  let mut nep = 0
    let mut i = 0
    while i < n {
        // ── BUILD this item's LIVE faculties from the scene STRUCTURE ──────────
        // spatial: place 8 landmarks at their 2-D positions.
        let mut smap = spatial_map_new()
        let mut k = 0
        while k < N_LANDMARKS {
            smap = spatial_map_place(smap, _lname(k), _pos_x(seed, i, k), _pos_y(seed, i, k))
            k = k + 1
        }
        // episodic: bind each landmark → its bound option string. F3 (flag 2) co-locates the
        // nearest-other's option to equal the target's (the AGREE rig). F4 (flag 1) rigs X's
        // option to the WRONG value (so the store mis-votes a query-inappropriate label).
        let f = flags[i]
        let agree_target = tgts[i]
        let agree_no = as_[i]
        let conflict_x = xs[i]
        let conflict_correct = corrs[i]
        // landmark 0's bound option, with F4/F3 rig applied at bind time.
        let mut opt0 = _opt(seed, i, 0)
        if f == 1 && conflict_x == 0 { opt0 = 1 - conflict_correct }                    // F4 rig wrong (X==0)
        if f == 2 && agree_no == 0 { opt0 = _opt(seed, i, agree_target) }               // F3 co-locate (no==0)
        let mut mem = immune_grow_new(immune_embed_key(_store_key(seed, i, 0)), _opt_text(opt0), 2048, 2048, true)
        let mut kk = 1
        while kk < N_LANDMARKS {
            let mut opt = _opt(seed, i, kk)
            if f == 2 && kk == agree_no { opt = _opt(seed, i, agree_target) }          // F3 co-locate
            if f == 1 && kk == conflict_x { opt = 1 - conflict_correct }                // F4 rig wrong
            mem = immune_grow_bind(mem, immune_embed_key(_store_key(seed, i, kk)), _opt_text(opt), cfg)
            kk = kk + 1
        }

        // ── SPATIAL (WHERE) leg — LIVE WIRED spatial_episodic_spatial_vote ──
        let mut sd = 0  let mut sc = 0.0  let mut sa = 1
        if xs[i] >= 0 && as_[i] >= 0 && bs[i] >= 0 {
            // the two candidate landmarks' bound options (with F3 co-locate applied), read from
            // the scene — the metric MAP does not store a label, so the caller supplies the
            // WHERE→option readout (== the engine probe). The wired op returns [vote, margin] or
            // [-1,0] on abstain.
            let mut opt_a = _opt(seed, i, as_[i])
            let mut opt_b = _opt(seed, i, bs[i])
            if f == 2 && as_[i] == agree_no { opt_a = _opt(seed, i, agree_target) }
            if f == 2 && bs[i] == agree_no { opt_b = _opt(seed, i, agree_target) }
            let sv = spatial_episodic_spatial_vote(smap, _lname(xs[i]), _lname(as_[i]), _lname(bs[i]), opt_a, opt_b)
            if sv[0] < 0.0 {
                sa = 1
            } else {
                sd = to_int(sv[0])
                sc = sv[1]
                sa = 0
            }
        }
        sp_dec = sp_dec + [sd]  sp_conf = sp_conf + [sc]  sp_abst = sp_abst + [sa]
        if sa == 0 { sum_sp = sum_sp + sc  nsp = nsp + 1 }

        // ── EPISODIC (WHAT) leg — LIVE WIRED spatial_episodic_episodic_vote ──
        let mut ed = 0  let mut ec = 0.0  let mut ea = 1
        if tgts[i] >= 0 {
            // recall by the DISTINCT store key (the bound landmark). The wired op returns
            // [vote, margin] (margin = live recall_thr − _l2) or [-1,0] on abstain.
            let qk = immune_embed_key(_store_key(seed, i, tgts[i]))
            let ev = spatial_episodic_episodic_vote(mem, qk)
            if ev[0] < 0.0 {
                ea = 1
            } else {
                ed = to_int(ev[0])
                ec = ev[1]
                ea = 0
            }
        }
        ep_dec = ep_dec + [ed]  ep_conf = ep_conf + [ec]  ep_abst = ep_abst + [ea]
        if ea == 0 { sum_ep = sum_ep + _absf(ec)  nep = nep + 1 }

        // routing cue from the canonical query text for this item's qtype.
        let qtext_route = if qtypes[i] == 0 {
            "which landmark is nearer to " + _lname(as_[i]) + " or " + _lname(bs[i]) + " for " + _lname(xs[i])
        } else {
            "what is bound to landmark " + _lname(tgts[i])
        }
        wcues = wcues + [_where_cue(qtext_route)]
        i = i + 1
    }
    let sp_mean = if nsp > 0 { sum_sp / to_float(nsp) } else { 1.0 }
    let ep_mean = if nep > 0 { sum_ep / to_float(nep) } else { 1.0 }

    // ── SECOND PASS: accuracies + compose + oracle + decomposition ──────────
    let mut on_sp = 0  let mut on_ep = 0  let mut on_c = 0  let mut on_oracle = 0
    let mut conflict = 0
    let mut only_s = 0  let mut only_e = 0  let mut both = 0  let mut neither = 0
    let mut j = 0
    while j < n {
        let ct = corrs[j]
        // resolve abstains to a deterministic chance draw (the mirror's resolve()).
        let sd = if sp_abst[j] == 1 { if _unif(seed, j, 401) < 0.5 { 0 } else { 1 } } else { sp_dec[j] }
        let ed = if ep_abst[j] == 1 { if _unif(seed, j, 402) < 0.5 { 0 } else { 1 } } else { ep_dec[j] }
        let comp_raw = _arbiter(sp_dec[j], sp_conf[j], sp_abst[j], sp_mean,
                                ep_dec[j], ep_conf[j], ep_abst[j], ep_mean, wcues[j])
        let comp = if comp_raw < 0 { if _unif(seed, j, 403) < 0.5 { 0 } else { 1 } } else { comp_raw }
        // faculty-correct = NON-abstaining AND decisive read matches (oracle uses decisive reads).
        let sp_ok = sp_abst[j] == 0 && sp_dec[j] == ct
        let ep_ok = ep_abst[j] == 0 && ep_dec[j] == ct
        if sd == ct { on_sp = on_sp + 1 }
        if ed == ct { on_ep = on_ep + 1 }
        if comp == ct { on_c = on_c + 1 }
        if sp_ok || ep_ok { on_oracle = on_oracle + 1 }
        if sp_abst[j] == 0 && ep_abst[j] == 0 && sp_dec[j] != ep_dec[j] { conflict = conflict + 1 }
        if sp_ok && !ep_ok { only_s = only_s + 1 }
        if ep_ok && !sp_ok { only_e = only_e + 1 }
        if sp_ok && ep_ok { both = both + 1 }
        if !sp_ok && !ep_ok { neither = neither + 1 }
        j = j + 1
    }

    // ── SHUFFLE control: permute which faculty-reads attach to which item, re-arbitrate ──
    let mut perm_s: [int] = []
    let mut perm_e: [int] = []
    let mut z = 0
    while z < n { perm_s = perm_s + [z]  perm_e = perm_e + [z]  z = z + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r1 = st % (a + 1)
        let tmp = perm_s[a]  perm_s[a] = perm_s[r1]  perm_s[r1] = tmp
        st = _lcg(st)  let r2 = st % (a + 1)
        let tmpb = perm_e[a]  perm_e[a] = perm_e[r2]  perm_e[r2] = tmpb
        a = a - 1
    }
    let mut on_s = 0
    let mut k2 = 0
    while k2 < n {
        let si = perm_s[k2]  let ei = perm_e[k2]
        let comp_raw = _arbiter(sp_dec[si], sp_conf[si], sp_abst[si], sp_mean,
                                ep_dec[ei], ep_conf[ei], ep_abst[ei], ep_mean, wcues[k2])
        let comp = if comp_raw < 0 { if _unif(seed, k2, 404) < 0.5 { 0 } else { 1 } } else { comp_raw }
        if comp == corrs[k2] { on_s = on_s + 1 }
        k2 = k2 + 1
    }

    let dn = to_float(n)
    let acc_sp = to_float(on_sp) / dn
    let acc_ep = to_float(on_ep) / dn
    let best = if acc_sp >= acc_ep { acc_sp } else { acc_ep }
    let acc_c = to_float(on_c) / dn
    let acc_s = to_float(on_s) / dn
    let acc_o = to_float(on_oracle) / dn
    return [acc_sp, acc_ep, best, acc_c, acc_s, acc_o,
            to_float(conflict) / dn,
            to_float(only_s) / dn, to_float(only_e) / dn,
            to_float(both) / dn, to_float(neither) / dn,
            to_float(N_LANDMARKS), to_float(N_LANDMARKS)]
}

fn main() {
    println("================================================================================")
    println("H_1415 RUNG-3 — LIVE-OP re-run: votes + arbiter via WIRED spatial_episodic_compose (core/engine_cli.hexa)")
    println("  re-scoring the SAME frozen H_1408 bars; MUST reproduce H_1415 engine-native numbers byte-exact")
    println("  $0 CPU · 3 seeds [5408,5409,5410] · p7 · p8 · a_verified_must_wire rung-3")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let seeds = _SEEDS()

    let mut acc_sp = 0.0  let mut acc_ep = 0.0  let mut best = 0.0
    let mut acc_c = 0.0  let mut acc_s = 0.0  let mut acc_o = 0.0
    let mut conf = 0.0  let mut o_s = 0.0  let mut o_e = 0.0  let mut bo = 0.0  let mut ne = 0.0
    let ns = to_float(len(seeds))
    let mut si = 0
    while si < len(seeds) {
        let r = run_seed(seeds[si], cfg)
        println("  seed " + to_string(seeds[si]) + ": sp=" + _f4(r[0]) + " ep=" + _f4(r[1])
              + " best=" + _f4(r[2]) + " compose=" + _f4(r[3]) + " shuf=" + _f4(r[4])
              + " oracle=" + _f4(r[5]) + " | conflict=" + _f4(r[6])
              + " [onlyS=" + _f4(r[7]) + " onlyE=" + _f4(r[8]) + " both=" + _f4(r[9])
              + " neither=" + _f4(r[10]) + "]")
        acc_sp = acc_sp + r[0]  acc_ep = acc_ep + r[1]  best = best + r[2]
        acc_c = acc_c + r[3]  acc_s = acc_s + r[4]  acc_o = acc_o + r[5]
        conf = conf + r[6]  o_s = o_s + r[7]  o_e = o_e + r[8]  bo = bo + r[9]  ne = ne + r[10]
        si = si + 1
    }
    acc_sp = acc_sp / ns  acc_ep = acc_ep / ns  best = best / ns
    acc_c = acc_c / ns  acc_s = acc_s / ns  acc_o = acc_o / ns
    conf = conf / ns  o_s = o_s / ns  o_e = o_e / ns  bo = bo / ns  ne = ne / ns

    println("--------------------------------------------------------------------------------")
    println("MEAN (3 seeds, ENGINE-NATIVE):")
    println("  acc_spatial   = " + _f4(acc_sp))
    println("  acc_episodic  = " + _f4(acc_ep))
    println("  best_single   = " + _f4(best))
    println("  acc_compose   = " + _f4(acc_c))
    println("  acc_shuffle   = " + _f4(acc_s))
    println("  ORACLE        = " + _f4(acc_o) + "   (oracle - best = " + _f4(acc_o - best) + ")")
    println("  conflict_rate = " + _f4(conf))
    println("  decomposition : only_spatial=" + _f4(o_s) + " only_episodic=" + _f4(o_e)
          + " both=" + _f4(bo) + " neither=" + _f4(ne))

    let B1 = acc_c >= best + COMPOSE_DELTA
    let B2 = (acc_o - best) > ORACLE_MARGIN
    let B3 = (acc_c - acc_s) > SHUFFLE_TOL
    let SEP = o_s > 0.0 && o_e > 0.0
    println("--------------------------------------------------------------------------------")
    println("  (B1 COMPOSE-EFFECT) compose " + _f4(acc_c) + " >= best+" + _f4(COMPOSE_DELTA)
          + " (" + _f4(best + COMPOSE_DELTA) + ") : " + (if B1 { "PASS" } else { "FAIL" }))
    println("  (B2 ORACLE)         oracle-best " + _f4(acc_o - best) + " > " + _f4(ORACLE_MARGIN)
          + " : " + (if B2 { "PASS" } else { "FAIL" }))
    println("  (B3 EARNED)         compose-shuffle " + _f4(acc_c - acc_s) + " > " + _f4(SHUFFLE_TOL)
          + " : " + (if B3 { "PASS" } else { "FAIL" }))
    println("  (SEPARABLE)         only_spatial>0 AND only_episodic>0 : " + (if SEP { "PASS" } else { "FAIL" }))
    println("================================================================================")
    if B1 && B2 && B3 && SEP {
        println("VERDICT: 🟢 RUNG-3 LIVE-OP REPRODUCES H_1415 — the WIRED spatial_episodic_compose op gives the")
        println("  same engine-native compose-lift (all 4 bars PASS). The arbiter is now OWNED by the engine.")
    } else {
        println("VERDICT: 🧱 — the live op did NOT reproduce the H_1415 bars (wire-in regression, c9).")
    }
    println("  HONEST (c9): bars FROZEN from H_1408 FREEZE.txt, NOT moved. Toy 5-family landmark fixture,")
    println("  3 seeds, deterministic. The votes + arbiter are the WIRED CORE ops; this is the rung-3")
    println("  byte-exact reproduction. Scale/real-corpus/engine-native-transfer-at-scale UNVERIFIED.")
    if !(B1 && B2 && B3 && SEP) { exit(1) }
}
