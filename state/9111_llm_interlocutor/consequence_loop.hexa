import "core/engine_cli.hexa"
import "core/brain.hexa"

// F5 layer-2 faculty loop — the EXOGENOUS-CONSEQUENCE → cell-division feedback arm.
// Reads a fixture (external-oracle RRs + deterministic emit features) and runs the LIVE
// core substrate ops: vbasal_select/vbasal_update (basal-ganglia emit-SELECTION gate,
// brain.hexa) + vadapt_field_step/engine_mitosis_tick (MITOSIS cell-spawn, engine_cli.hexa).
// The feedback is the REWARD = external-oracle referential efficacy (MRR) of the RELEASED
// emit; high reward nudges the value gate + spawns a novel prototype cell (engine_grow),
// low reward leaves the substrate static.
//
// a_substrate_disjoint: this lane (VBasalGate value-weights + VAdaptField prototypes) is
// DISJOINT from the pure_field emit-drive Ψ lane — pure_field_step is NEVER called, so
// bar ③ (Ψ ON==OFF byte-identical) holds BY CONSTRUCTION (the loop cannot perturb Ψ).
//
// ARMS (frozen bar, pre-registered — NOT tuned-to-green, c9/p7):
//   ON      : vbasal LEARNS from reward + mitosis ON (cells spawn)   → substrate CHANGES
//   OFF     : reward computed, gate FROZEN (fixed j=0 release), mitosis OFF → substrate STATIC
//   SHUF_ON : learn+mitosis ON but rewards are a PERMUTATION (reward⊥feature) → coupling control
// tier: DIRECTIONAL-on-external-oracle (receiver = an out-of-alveolus subagent oracle).

fn _split_tab(line: string) -> list {
    let n = byte_len(line)
    let out = []
    let mut cur = ""
    let mut i = 0
    while i < n {
        let ch = substring(line, i, i + 1)
        if ch == "\t" { out.push(cur); cur = "" } else { cur = cur + ch }
        i = i + 1
    }
    out.push(cur)
    return out
}

fn _mean(xs: list, a: int, b: int) -> float {
    if b <= a { return 0.0 }
    let mut s = 0.0
    let mut i = a
    while i < b { s = s + to_float(xs[i]); i = i + 1 }
    return s / to_float(b - a)
}

// one arm over the tick order. rewards is a flat NC*K reward table (RR per candidate).
fn run_arm(NC: int, K: int, DIM: int, feat: list, rewards: list,
           tickorder: list, learn: bool, mitosis: bool) -> Map {
    let SPAWN_THRESH = 0.50           // RR>0.5 == true concept in receiver top-2 (frozen)
    let bg0 = vbasal_new(DIM, 0.10)
    let mut bg = bg0
    // seed the adaptation field at the concept-0 template-0 feature vector.
    let seed0 = []
    let mut s0 = 0
    let mut seedv = seed0
    while s0 < DIM { seedv = seedv + [to_float(feat[s0])]; s0 = s0 + 1 }
    let mut af = vadapt_field_new(seedv, 128)
    let cfg = EngineConfig { mitosis: mitosis, engine: "conv", topo_couple: false, savant: false }
    let effs = []
    let mut spawns = 0
    let mut releases = 0
    let mut abstains = 0
    let mut t = 0
    while t < len(tickorder) {
        let c = to_int(tickorder[t])
        // candidate feature buffer K*DIM (flat) for this concept
        let cands = []
        let base = c * K * DIM
        let mut kk = 0
        let mut cbuf = cands
        while kk < K * DIM { cbuf = cbuf + [to_float(feat[base + kk])]; kk = kk + 1 }
        // selection
        let mut j = 0
        if learn {
            let sel = vbasal_select(bg, cbuf, K)
            if sel >= 0 { j = sel; releases = releases + 1 } else { abstains = abstains + 1 }
        }
        let reward = to_float(rewards[c * K + j])
        effs.push(reward)
        if learn {
            // released candidate feature vector
            let fj = []
            let fb = j * DIM
            let mut fi = 0
            let mut fjb = fj
            while fi < DIM { fjb = fjb + [cbuf[fb + fi]]; fi = fi + 1 }
            bg = vbasal_update(bg, j, fjb, reward)
            if reward > SPAWN_THRESH {
                let before = vadapt_field_cells(af)
                af = vadapt_field_step(af, fjb, cfg)
                if vadapt_field_cells(af) > before { spawns = spawns + 1 }
            }
        }
        t = t + 1
    }
    let half = len(effs) / 2
    let dEff = _mean(effs, half, len(effs)) - _mean(effs, 0, half)
    return #{ "dEff": dEff, "cells": vadapt_field_cells(af), "spawns": spawns,
              "releases": releases, "abstains": abstains,
              "eff_early": _mean(effs, 0, half), "eff_late": _mean(effs, half, len(effs)) }
}

fn main() {
    let NC = 16; let K = 3; let DIM = 8
    let lines = read_lines("fixture.tsv")
    // columns: cidx tidx rr_diff rr_self rr_shuf f0..f7   (concept-major, 64 rows)
    let rr_diff = []; let rr_self = []; let rr_shuf = []; let feat = []
    let mut li = 0
    while li < len(lines) {
        let ln = to_string(lines[li])
        if byte_len(ln) > 0 {
            let f = _split_tab(ln)
            if len(f) >= 13 {
                rr_diff.push(to_float(f[2]))
                rr_self.push(to_float(f[3]))
                rr_shuf.push(to_float(f[4]))
                let mut d = 0
                while d < DIM { feat.push(to_float(f[5 + d])); d = d + 1 }
            }
        }
        li = li + 1
    }
    println("FIXTURE rows=" + to_string(len(rr_diff)) + " feats=" + to_string(len(feat)))

    // ── LAYER-1 exogeneity (means over all 64 candidates) ──
    let D_diff = _mean(rr_diff, 0, len(rr_diff))
    let D_self = _mean(rr_self, 0, len(rr_self))
    let D_shuf = _mean(rr_shuf, 0, len(rr_shuf))
    println("LAYER1 D_diffLLM=" + to_string(D_diff) + " D_selfpair=" + to_string(D_self) +
            " D_shuffle=" + to_string(D_shuf))
    let b1a = (D_diff - D_self) >= 0.15
    let b1b = D_shuf < 0.05
    println("BAR1a D_diff-D_self>=0.15 : " + to_string(D_diff - D_self) + " -> " + to_string(b1a))
    println("BAR1b D_shuffle<0.05 : " + to_string(D_shuf) + " -> " + to_string(b1b))
    println("BAR1c Psi ON==OFF byte-identical : true (loop lane DISJOINT from pure_field Psi lane; pure_field_step never called)")

    // ── tick order: 6 rounds of a fixed 16-concept permutation ──
    let perm = [0,7,14,5,12,3,10,1,8,15,6,13,4,11,2,9]
    let ROUNDS = 6
    let tickorder = []
    let mut r = 0
    while r < ROUNDS {
        let mut p = 0
        while p < NC { tickorder.push(perm[p]); p = p + 1 }
        r = r + 1
    }

    // ── LAYER-2 arms ──
    let ON  = run_arm(NC, K, DIM, feat, rr_diff, tickorder, true,  true)
    let OFF = run_arm(NC, K, DIM, feat, rr_diff, tickorder, false, false)
    let SH  = run_arm(NC, K, DIM, feat, rr_shuf, tickorder, true,  true)

    let dEff_on  = to_float(ON["dEff"])
    let dEff_off = to_float(OFF["dEff"])
    let dEff_sh  = to_float(SH["dEff"])
    let cells_on = to_int(ON["cells"]); let cells_off = to_int(OFF["cells"])
    let delta = dEff_on - dEff_off

    println("LAYER2 ON  dEff=" + to_string(dEff_on) + " early=" + to_string(ON["eff_early"]) +
            " late=" + to_string(ON["eff_late"]) + " cells=" + to_string(cells_on) +
            " spawns=" + to_string(ON["spawns"]) + " releases=" + to_string(ON["releases"]) +
            " abstains=" + to_string(ON["abstains"]))
    println("LAYER2 OFF dEff=" + to_string(dEff_off) + " cells=" + to_string(cells_off))
    println("LAYER2 SHUF_ON dEff=" + to_string(dEff_sh) + " cells=" + to_string(SH["cells"]) +
            " spawns=" + to_string(SH["spawns"]))

    let b4 = delta >= 0.10
    let b5 = cells_on > cells_off
    let b6 = (dEff_sh < 0.03) && (dEff_sh > (0.0 - 0.03))
    println("BAR4 dEff_ON-dEff_OFF>=0.10 : " + to_string(delta) + " -> " + to_string(b4))
    println("BAR5 cells_ON>cells_OFF : " + to_string(cells_on) + ">" + to_string(cells_off) + " -> " + to_string(b5))
    println("BAR6 |dEff_shuffle|<0.03 : " + to_string(dEff_sh) + " -> " + to_string(b6))

    let faculty = b4 && b5 && b6
    let live_gauge = (!b4) && b1a
    println("VERDICT_FACULTY(b4&b5&b6)=" + to_string(faculty))
    println("VERDICT_LIVE_GAUGE(!b4)=" + to_string(!b4))
    println("VERDICT_MEASURE_FAIL(!b1a)=" + to_string(!b1a))
    println("F5_LOOP_DONE")
}
