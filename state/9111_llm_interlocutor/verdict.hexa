// ============================================================================
// state/9111_llm_interlocutor/verdict.hexa
//   H_9111 — REGIME-2 ENGINE-NATIVE VERDICT (frozen fixture, grep-clean).
//
//   Reads the FROZEN engine-native emits (emits.tsv, live-core 303M decode from
//   emit_gen.hexa) + the FROZEN external-oracle fixture (fable_fixture.tsv, one
//   sidecar-fable choice per emit). Computes — ENTIRELY on live core/*.hexa
//   (immune_memory associative decode + vbasal striatal value lane + pure_field Ψ) —
//   the exogenous-advantage D per arm and applies the PRE-REGISTERED frozen bar.
//   NO numpy/torch/.py math here (a_engine_native_learning). The ONLY external datum
//   is the oracle's cached CHOICE (as an EEG fixture supplies external signal).
//
//   D_arm = rho_conseq − rho_self :
//     rho_conseq = corr(V trained on THIS receiver's success, held-out success)
//     rho_self   = corr(V trained on anima's OWN self-decode success, held-out success)
//   self-pair: receiver == anima-clone ⇒ success ≡ self-decode ⇒ V_conseq≡V_self ⇒ D=0.
//   diff-LLM : receiver == fable (θ outside closure) ⇒ D measures exogenous advantage.
//   shuffle  : fable success re-paired to random emit ⇒ D≈0.
//   FROZEN (PREREG.md, no post-hoc move): 🟢 iff D_diffLLM−D_selfpair>=0.15 ∧ D_shuffle<0.05 ∧ Ψ_ok.
// ============================================================================

import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "core/brain.hexa"

fn fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn clip01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }
fn fmean(xs: [float]) -> float { let n = len(xs)  if n == 0 { return 0.0 }  let mut s = 0.0  let mut i = 0  while i < n { s = s + xs[i]  i = i + 1 }  return s / to_float(n) }
fn pcorr(a: [float], b: [float]) -> float {
    let n = len(a)  if n < 2 { return 0.0 }
    let ma = fmean(a)  let mb = fmean(b)
    let mut num = 0.0  let mut da = 0.0  let mut db = 0.0  let mut i = 0
    while i < n { let xa = a[i]-ma  let xb = b[i]-mb  num = num+xa*xb  da = da+xa*xa  db = db+xb*xb  i = i + 1 }
    if da <= 1e-12 || db <= 1e-12 { return 0.0 }
    return num / sqrt(da*db)
}
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn distinct_byte_ratio(s: string) -> float {
    let n = byte_len(s)  if n == 0 { return 0.0 }
    let mut seen = []  let mut u = 0  let mut i = 0
    while i < 256 { seen = seen + [0]  i = i + 1 }
    i = 0
    while i < n {
        let b = ord(substring(s, i, i + 1))
        if seen[b] == 0 { seen[b] = 1  u = u + 1 }
        i = i + 1
    }
    return to_float(u) / to_float(n)
}

// engine-native salience = immune_memory recall margin (READ-only, Ψ-disjoint).
fn salience(st: ImmuneMemory, txt: string) -> float { return immune_memory_recall_margin_text(st, txt) }

// train a vbasal value lane on (feats,reward) over TRAIN rows, then return held-out predictions.
fn train_predict(flat: [float], D: int, rewards: [float], n_train: int, n_total: int, lr: float) -> [float] {
    let mut V = vbasal_new(D, lr)
    let mut i = 0
    while i < n_train {
        let mut f = []  let mut c = 0
        while c < D { f = f + [flat[i * D + c]]  c = c + 1 }
        V = vbasal_update(V, 0, f, rewards[i])
        i = i + 1
    }
    let mut preds = []
    let mut t = n_train
    while t < n_total {
        let mut f = []  let mut c = 0
        while c < D { f = f + [flat[t * D + c]]  c = c + 1 }
        preds = preds + [vbasal_go_value(V, f)]
        t = t + 1
    }
    return preds
}

// D_arm = rho_conseq − rho_self for a given receiver-success vector.
struct ArmOut { d: float, rho_conseq: float, rho_self: float }
fn arm(flat: [float], D: int, recv_succ: [float], self_succ: [float], n_train: int, n_total: int, lr: float) -> ArmOut {
    let pc = train_predict(flat, D, recv_succ, n_train, n_total, lr)  // V_conseq
    let ps = train_predict(flat, D, self_succ, n_train, n_total, lr)  // V_self
    // held-out ground truth = the receiver's held-out success
    let mut ho = []
    let mut t = n_train
    while t < n_total { ho = ho + [recv_succ[t]]  t = t + 1 }
    let rc = pcorr(pc, ho)
    let rs = pcorr(ps, ho)
    return ArmOut { d: rc - rs, rho_conseq: rc, rho_self: rs }
}

fn field_from(text: string) -> ImmuneMemory { return immune_memory_new_text(text, text, 4096) }

// strip the constant degenerate LM-fallback tail (mode-collapse phrase past the grounded
// description end) — SAME cleanup the fable prompt applies, so all arms see identical E.
fn clean_clue(e: string) -> string {
    let parts = e.split("the state and")
    return parts[0]
}

fn main() {
    let cfg = engine_config_default()
    let slug = "state/9111_llm_interlocutor/"
    let emits_raw = read_file(slug + "emits.tsv")
    let fable_raw = read_file(slug + "fable_fixture.tsv")

    // parse emits.tsv
    let mut idxs = []  let mut concepts = []  let mut emits = []
    let elines = emits_raw.split("\n")
    let mut li = 0
    while li < len(elines) {
        let ln = elines[li]
        if ln.starts_with("EMIT\t") {
            let p = ln.split("\t")
            // p = [EMIT, i, concept, ok, E]
            idxs = idxs + [to_int(p[1])]
            concepts = concepts + [p[2]]
            let mut e = ""
            if len(p) >= 5 { e = clean_clue(p[4]) }
            emits = emits + [e]
        }
        li = li + 1
    }
    let M = len(emits)

    // parse fable_fixture.tsv -> pick per index
    let mut fpick = []
    let mut z = 0
    while z < M { fpick = fpick + [-1]  z = z + 1 }
    let flines = fable_raw.split("\n")
    li = 0
    while li < len(flines) {
        let ln = flines[li]
        if ln.starts_with("FABLE\t") {
            let p = ln.split("\t")   // [FABLE, i, hash, pick]
            let fi = to_int(p[1])
            let pk = to_int(p[3])
            if fi >= 0 && fi < M { fpick[fi] = pk }
        }
        li = li + 1
    }

    // per-emit: anima associative self-decode + features + successes
    let D = 6
    let mut flat = []
    let mut fable_succ = []
    let mut self_succ = []
    let mut pf = pure_field_warmup(500)
    let mut psi_on = 0.0  let mut psi_off = 0.0

    let mut i = 0
    while i < M {
        let e = emits[i]
        // anima decode: store shaped by E_i, argmin salience over the M candidate concepts
        let st_e = field_from(e)
        let mut best_j = 0  let mut best_m = 1e30  let mut second_m = 1e30
        let mut j = 0
        while j < M {
            let m = salience(st_e, concepts[j])
            if m < best_m { second_m = best_m  best_m = m  best_j = j }
            else { if m < second_m { second_m = m } }
            j = j + 1
        }
        let a_succ = if best_j == i { 1.0 } else { 0.0 }
        let f_succ = if fpick[i] == i { 1.0 } else { 0.0 }
        self_succ = self_succ + [a_succ]
        fable_succ = fable_succ + [f_succ]

        // features (all anima-ENDOGENOUS; only training TARGET differs across arms)
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        psi_on = psi_on + phi
        psi_off = psi_off + phi                       // V read-only -> identical
        let st_c = field_from(concepts[i])
        let f0 = clip01(salience(st_c, e))            // emit<->true-concept linkage
        let f1 = phi                                   // substrate Φ
        let f2 = clip01(best_m)                        // anima decode best margin
        let f3 = clip01(second_m - best_m)             // decode confidence gap
        let f4 = distinct_byte_ratio(e)                // emit coherence proxy
        let f5 = clip01(to_float(byte_len(e)) / 64.0)  // emit length
        flat = flat + [f0, f1, f2, f3, f4, f5]
        i = i + 1
    }

    let n_train = M / 2
    let lr = 0.10

    // shuffle arm: permute fable_succ vs feature rows (break E->R correspondence)
    let mut shuf = fable_succ
    let mut rst = 20260703
    let mut ii = M - 1
    while ii > 0 {
        rst = lcg_next(rst)
        let k = rst % (ii + 1)
        let tmp = shuf[ii]  shuf[ii] = shuf[k]  shuf[k] = tmp
        ii = ii - 1
    }

    let a_self = arm(flat, D, self_succ,  self_succ, n_train, M, lr)   // self-pair (== by construction)
    let a_diff = arm(flat, D, fable_succ, self_succ, n_train, M, lr)   // diff-LLM (fable oracle)
    let a_shuf = arm(flat, D, shuf,       self_succ, n_train, M, lr)   // shuffle control

    // communication sanity rates
    let n_ho = M - n_train
    let mut fh = 0  let mut sh = 0  let mut t = n_train
    while t < M { if fable_succ[t] > 0.5 { fh = fh + 1 }  if self_succ[t] > 0.5 { sh = sh + 1 }  t = t + 1 }
    let fable_rate = to_float(fh) / to_float(n_ho)
    let self_rate  = to_float(sh) / to_float(n_ho)

    let d_diff_minus_self = a_diff.d - a_self.d
    let psi_ok = fabs(psi_on - psi_off) < 1e-9
    let green = d_diff_minus_self >= 0.15 && a_shuf.d < 0.05 && psi_ok
    let directional = d_diff_minus_self >= 0.15 && !(a_shuf.d < 0.05 && psi_ok)

    println("")
    println("=== H_9111 LLM-INTERLOCUTOR exogenous consequence-loop — engine-native verdict ===")
    println("M(concepts)=" + to_string(M) + "  n_train=" + to_string(n_train) + "  held_out=" + to_string(n_ho) + "  D(feats)=" + to_string(D) + "  oracle=claude-fable-5")
    println("")
    println("[communication held-out]  fable_success=" + to_string(fable_rate) + "   anima_self_decode=" + to_string(self_rate) + "   (chance=" + to_string(1.0/to_float(M)) + ")")
    println("")
    println("[arm a — SELF-PAIR (anima-clone; success ≡ self-decode by construction)]")
    println("  rho_conseq=" + to_string(a_self.rho_conseq) + "  rho_self=" + to_string(a_self.rho_self) + "  D_selfpair=" + to_string(a_self.d))
    println("[arm b — DIFF-LLM (sidecar fable, θ outside anima closure)]")
    println("  rho_conseq=" + to_string(a_diff.rho_conseq) + "  rho_self=" + to_string(a_diff.rho_self) + "  D_diffLLM=" + to_string(a_diff.d))
    println("[arm c — SHUFFLE (fable success re-paired to random emit)]")
    println("  rho_conseq=" + to_string(a_shuf.rho_conseq) + "  rho_self=" + to_string(a_shuf.rho_self) + "  D_shuffle=" + to_string(a_shuf.d))
    println("")
    println("[FROZEN BAR] D_diffLLM − D_selfpair = " + to_string(d_diff_minus_self) + "  (>=0.15 -> " + (if d_diff_minus_self >= 0.15 {"PASS"} else {"FAIL"}) + ")")
    println("             D_shuffle = " + to_string(a_shuf.d) + "  (<0.05 -> " + (if a_shuf.d < 0.05 {"PASS"} else {"FAIL"}) + ")")
    println("             Ψ guard psi_sum ON==OFF byte-identical -> " + (if psi_ok {"OK"} else {"VIOLATION"}))
    println("")
    if green {
        println("VERDICT: 🟢 GREEN — the EXTERNAL LLM receiver (θ outside anima's closure) opens the")
        println("  emit-appropriateness faculty that 4 self-contained axes (H_9104/9105/9108/9109) could NOT.")
        println("  Training the value lane on the exogenous oracle's success predicts held-out success beyond")
        println("  anima's own self-model (D_diffLLM=" + to_string(a_diff.d) + " vs D_selfpair=" + to_string(a_self.d) + "), and it VANISHES under shuffle")
        println("  (D_shuffle=" + to_string(a_shuf.d) + "). FIRST autonomous exogenous closed loop — the session's central insight, demonstrated.")
    } else {
        if directional {
            println("VERDICT: 🟠 DIRECTIONAL — exogenous advantage present (D_diffLLM−D_selfpair>=0.15) but a control failed.")
        } else {
            println("VERDICT: 🔴 CEILING / DPI — the external LLM is ALSO a derivable-mirror floor at this coupling")
            println("  (D_diffLLM−D_selfpair=" + to_string(d_diff_minus_self) + " < 0.15). DPI runs DEEPER than the receiver: even an oracle")
            println("  outside anima's closure buys no held-out faculty advantage here = a self-contained 5th axis.")
        }
    }
}
