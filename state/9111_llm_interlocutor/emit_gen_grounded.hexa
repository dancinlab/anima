// ============================================================================
// state/9111_llm_interlocutor/emit_gen_grounded.hexa
//   H_9111 — REGIME-1 engine-native EMIT GENERATOR (GROUNDED coherent channel).
//
//   WHY GROUNDED: the only engine-loadable 303M .clm (savant_mitosis) free-decodes
//   DEGENERATELY (mode-collapse: 2/2 distinct seeds -> byte-identical output — see
//   seed_probe.log), and the G0-coherent h1129 mouth is a torch .pt (not engine-loadable)
//   while both RTX-5070 pool boxes are down. So the DESIGN §4.3 pre-condition (a
//   G0-coherent free mouth) is UNMET this session. To still test the SCIENTIFIC question
//   (does a receiver OUTSIDE anima's closure open the faculty a clone cannot?) on a
//   COHERENT channel, anima emits via the engine's GROUNDED path: clm_decode_grounded
//   copies VERBATIM from anima's grounded-knowledge anchors (a_kosmos grounded emit —
//   live core/decode.hexa, retrieve-then-copy, NOT the collapsed argmax). This decouples
//   the receiver-variable test from the dead free-mouth; the emit is still engine-native.
//
//   The anchor descriptions are anima's grounded knowledge; the concept NAME is absent
//   from each (and stripped) so no receiver can lexically name it — comprehension required.
//   Output = deterministic TSV -> emits.tsv (frozen fixture for fable + verdict.hexa).
// ============================================================================

import "core/decode.hexa"

fn concept(i: int) -> string {
    let w = ["volcano","glacier","library","violin","spider","lighthouse",
             "umbrella","beehive","telescope","avalanche","compass","cactus",
             "harbor","thunderstorm","magnet","anchor"]
    return w[i]
}
// grounded-knowledge description (concept name ABSENT) — anima's anchor payload.
fn descr(i: int) -> string {
    let d = [
        "a mountain that erupts molten lava ash and hot gases from deep underground",
        "a slow moving river of ancient ice that carves valleys as it grinds downhill",
        "a quiet public building full of shelves where books are borrowed read and returned",
        "a small wooden four string instrument played with a horsehair bow under the chin",
        "an eight legged creature that spins silk webs to trap flies and other insects",
        "a tall coastal tower with a bright rotating lamp that warns passing ships of rocks",
        "a folding fabric canopy on a handle you open above your head to stay dry in rain",
        "a structure of waxy hexagon cells where bees store honey and raise their young",
        "a long optical tube with curved lenses used to see distant stars planets and moons",
        "a sudden huge mass of loose snow sliding very fast down a steep mountain slope",
        "a small pocket device with a magnetic needle that always swings to point north",
        "a spiny thick skinned desert plant that stores water inside its swollen green stem",
        "a sheltered stretch of calm water where boats and ships safely dock and moor",
        "a violent weather event with heavy rain gusting wind loud booms and flashing bolts",
        "a bar of iron or steel that attracts metal and has a north and a south pole",
        "a heavy hooked iron weight lowered on a chain to hold a vessel still at sea"
    ]
    return d[i]
}
// seed = first three words of the description so the grounded anchor-copy fires and
// verbatim-copies the rest (engine-native retrieve-then-copy).
fn seed3(d: string) -> string {
    let parts = d.split(" ")
    return parts[0] + " " + parts[1] + " " + parts[2]
}
fn strip_echo(e: string, c: string) -> string {
    let mut s = e.to_lower().replace(c.to_lower(), " ")
    s = s.replace("\n", " ")  s = s.replace("\t", " ")  s = s.replace("\r", " ")
    return s
}

fn main() {
    let av = args()
    let mut ckpt = "/Users/mini/anima-weights/py303_savant_mitosis.clm"
    let mut k = 0
    while k < len(av) { if av[k] == "--" && k + 1 < len(av) { ckpt = av[k+1] }  k = k + 1 }
    let M = 16
    let gen = 90
    let l_min = 4
    println("# emit_gen_grounded H_9111 ckpt=" + ckpt + " M=" + to_string(M) + " gen=" + to_string(gen) + " decodable=" + to_string(clm_decodable(ckpt)))
    let mut i = 0
    while i < M {
        let c = concept(i)
        let d = descr(i)
        let anchors = [d]
        let r = clm_decode_grounded(ckpt, seed3(d), gen, anchors, l_min)
        let full = seed3(d) + to_string(r["text"])
        let e = strip_echo(full, c)
        println("EMIT\t" + to_string(i) + "\t" + c + "\t" + to_string(r["ok"]) + "\t" + e)
        println("# dbg i=" + to_string(i) + " grounded=" + to_string(r["grounded"]) + " lm=" + to_string(r["lm"]))
        i = i + 1
    }
    println("# emit_gen_grounded DONE")
}
