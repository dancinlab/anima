import "core/bytegpt_decode.hexa"

// F5 emit harness — LOADED-W (H_1400 load-once) ByteGPT 303M grounded-definition emit.
// The 303M mouth (h1129) is loaded ONCE via bg_load_ranged; every candidate decode reuses
// the resident W (NO per-call reload → the h9107/b50 pod-burn is structurally impossible).
// 16 F5-fresh held-out concepts (F6-disjoint), K=4 definitional templates each. Each emit is
// argmax-decoded then the concept token is STRIPPED (anti-echo) so an external oracle must
// infer the referent from the DESCRIPTION alone. TSV out: concept<TAB>tidx<TAB>emit.
// Self-contained in state/ (pub bg_load_ranged + bg_forward_last_W + farr_* builtins) — no
// core edit, single .clm/.bin slot (a_core_engine_map).

fn _lower1(b: int) -> int { if b >= 65 && b <= 90 { return b + 32 } return b }

// case-insensitive strip of `needle` from `hay` (anti-echo).
fn _strip_ci(hay: string, needle: string) -> string {
    let hn = byte_len(hay)
    let nn = byte_len(needle)
    if nn == 0 { return hay }
    let mut out = ""
    let mut i = 0
    while i < hn {
        let mut matched = false
        if i + nn <= hn {
            let mut c = 0
            let mut ok = true
            while c < nn {
                let a = ord(substring(hay, i + c, i + c + 1))
                let b = ord(substring(needle, c, c + 1))
                if _lower1(a) != _lower1(b) { ok = false; c = nn } else { c = c + 1 }
            }
            matched = ok
        }
        if matched { i = i + nn } else { out = out + substring(hay, i, i + 1); i = i + 1 }
    }
    return out
}

fn _mix32(s: int) -> int {
    let mut x = (s * 2654435761 + 1013904223) % 4294967296
    if x < 0 { x = x + 4294967296 }
    return x
}

// top-k SAMPLED decode from a PRE-LOADED W (loaded-once). Escapes greedy-argmax repetition
// degeneracy (a metric-artifact, a_break_the_wall cat-a): each step pick the top_k highest
// logits, then sample UNIFORMLY among them via an LCG rng (no exp/softmax dependency). Frozen
// bar unchanged — only the decode escapes the degenerate greedy loop. Returns `gen` bytes.
fn gen_topk_W(W: Map, seed_str: string, gen: int, top_k: int, seed_rng: int) -> string {
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    let toks = []
    let slen = byte_len(seed_str)
    let mut si = 0
    while si < slen { toks.push(ord(substring(seed_str, si, si + 1))); si = si + 1 }
    let mut out = ""
    let mut rng = _mix32(seed_rng)
    let mut g = 0
    while g < gen {
        let n = len(toks)
        let mut start = 0
        if n > block { start = n - block }
        let T = n - start
        let ids = farr_zeros(T)
        let mut p = 0
        while p < T { let _ = farr_set(ids, p, to_float(to_int(toks[start + p]))); p = p + 1 }
        let logits = bg_forward_last_W(W, ids, T)
        let lg = []
        let mut mk = 0
        let mut lgb = lg
        while mk < vocab { lgb = lgb + [farr_get(logits, mk)]; mk = mk + 1 }
        let _ = farr_free(logits); let _ = farr_free(ids)
        let cand = []
        let mut kk = 0
        let mut candb = cand
        while kk < top_k {
            let mut best = 0
            let mut bestv = lgb[0]
            let mut j = 1
            while j < vocab {
                if lgb[j] > bestv { bestv = lgb[j]; best = j }
                j = j + 1
            }
            candb = candb + [best]
            lgb[best] = -1000000000.0
            kk = kk + 1
        }
        // RANK-WEIGHTED pick (temperature-like, no exp): heavily favor the argmax (rank0)
        // so the byte stream stays COHERENT, but allow occasional lower-rank picks to escape
        // greedy repetition degeneracy. r<55 -> rank0, <80 -> rank1, <92 -> rank2, else rank3.
        rng = _mix32(rng)
        let r = rng % 100
        let mut pick = 0
        if r < 55 { pick = 0 } else { if r < 80 { pick = 1 } else { if r < 92 { pick = 2 } else { pick = 3 } } }
        if pick >= top_k { pick = 0 }
        let nb = to_int(candb[pick])
        toks.push(nb); out = out + chr(nb)
        g = g + 1
    }
    return out
}

fn _esc(s: string) -> string {
    let n = byte_len(s)
    let mut o = ""
    let mut i = 0
    while i < n {
        let ch = substring(s, i, i + 1)
        if ch == "\t" { o = o + " " } else { if ch == "\n" { o = o + " " } else { o = o + ch } }
        i = i + 1
    }
    return o
}

fn main() {
    let CKPT = "h1129.bin"       // placed in cwd on the pod
    let OUT  = "emits.tsv"
    let GEN  = 44
    let concepts = ["canyon","tundra","cathedral","cello","scorpion","windmill",
                    "parasol","anthill","microscope","landslide","sundial","fern",
                    "pier","blizzard","lodestone","mast"]

    println("CKPT=" + CKPT)
    let W = bg_load_ranged(CKPT)
    println("LOADED vocab=" + to_string(W["vocab"]) + " d=" + to_string(W["d"]) +
            " block=" + to_string(W["block"]) + " nlay=" + to_string(W["nlay"]))
    let _ = write_file(OUT, "")   // truncate

    let mut ci = 0
    while ci < len(concepts) {
        let c = to_string(concepts[ci])
        let tmpls = ["A " + c + " is a ",
                     "The " + c + " is ",
                     c + ", which is "]
        let mut ti = 0
        while ti < len(tmpls) {
            let t0 = now_ms()
            let raw = gen_topk_W(W, to_string(tmpls[ti]), GEN, 4, 7919 * ci + 131 * ti + 17)
            let stripped = _strip_ci(raw, c)
            let _ = append_file(OUT, c + "\t" + to_string(ti) + "\t" + _esc(stripped) + "\n")
            println("EMIT " + c + "[" + to_string(ti) + "] ms=" + to_string(now_ms() - t0) +
                    " :: " + _esc(stripped))
            ti = ti + 1
        }
        ci = ci + 1
    }
    println("EMIT_GEN_DONE n=" + to_string(len(concepts) * 3))
}
