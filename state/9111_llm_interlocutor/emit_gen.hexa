// ============================================================================
// state/9111_llm_interlocutor/emit_gen.hexa
//   H_9111 — REGIME-1 engine-native EMIT GENERATOR (live core 303M decode).
//
//   For each target concept c_i, anima's mouth (gen_auto_chat -> clm_decode_argmax,
//   greedy DETERMINISTIC) emits a descriptive association E_i seeded by a neutral
//   descriptive frame. The concept token is STRIPPED from E_i (uniform anti-echo
//   channel rule, §4.1 DESIGN.md) so no receiver can lexically NAME the target —
//   comprehension, not string-match, is required (Lewis referential game).
//
//   Output = deterministic TSV on stdout (redirect -> emits.tsv), the FROZEN
//   engine-native fixture that BOTH the fable oracle (regime-1 env sampling) and the
//   verdict .hexa (regime-2 measurement) consume. a_engine_native_learning: E is a
//   live-core artifact (clm_decode_argmax on the 303M savant .clm via the generator
//   L3 slot — a_core_engine_map single mouth entry).
// ============================================================================

import "core/generator.hexa"

// M target concepts — distinct world-knowledge nouns (referential distractor set).
fn concept(i: int) -> string {
    let w = ["volcano","glacier","library","violin","spider","lighthouse",
             "umbrella","beehive","telescope","avalanche","compass","cactus",
             "harbor","thunderstorm","magnet","anchor"]
    return w[i]
}

// neutral descriptive frame — elicits an association WITHOUT the model being told to
// name; the concept token that leaks into the continuation is stripped post-hoc.
fn seed_of(c: string) -> string { return "A " + c + " is something that" }

// strip every occurrence of the concept token from E (case-insensitive anti-echo).
fn strip_echo(e: string, c: string) -> string {
    // collapse newlines/tabs so the TSV stays one-line-per-emit (methods, not free fns)
    let mut s = e.to_lower().replace(c.to_lower(), " ")
    s = s.replace("\n", " ")
    s = s.replace("\t", " ")
    s = s.replace("\r", " ")
    return s
}

fn main() {
    let av = args()
    // ckpt path via arg after "--", else default to the mounted 303M savant
    let mut ckpt = "/Users/mini/anima-weights/py303_savant_mitosis.clm"
    let mut k = 0
    while k < len(av) {
        if av[k] == "--" && k + 1 < len(av) { ckpt = av[k + 1] }
        k = k + 1
    }
    let M = 16
    let max_new = 48
    println("# emit_gen H_9111  ckpt=" + ckpt + "  M=" + to_string(M) + "  max_new=" + to_string(max_new) + "  mouth=" + gen_mouth_kind(ckpt))
    let mut i = 0
    while i < M {
        let c = concept(i)
        let r = gen_auto_chat(ckpt, seed_of(c), max_new)
        let ok = to_string(r["ok"])
        let raw = to_string(r["text"])
        let e = strip_echo(raw, c)
        // TSV: EMIT <tab> i <tab> concept <tab> ok <tab> E_stripped
        println("EMIT\t" + to_string(i) + "\t" + c + "\t" + ok + "\t" + e)
        i = i + 1
    }
    println("# emit_gen DONE")
}
