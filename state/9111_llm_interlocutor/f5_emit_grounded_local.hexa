// f5_emit_local.hexa — build the F5 candidate emit set via anima's GROUNDED G5 decode path
// (verbatim anchor-copy = deterministic, engine-native; the SAME copy mechanism as
// bytegpt_decode_grounded, without the neural LM fallback — no 303M load / no GPU needed).
// 4 candidates/concept designed so the referential-legibility (proxy-RR) gradient is driven by
// REFERENT CORRECTNESS + grounding depth, which generic emit features can only partly see:
//   k0 = verbatim copy of TRUE def (full)        -> RR high,   fluent, long
//   k1 = verbatim copy of TRUE def (~45% prefix) -> RR medium, fluent, short
//   k2 = verbatim copy of a WRONG concept def    -> RR chance,  fluent, long  (features ≈ k0!)
//   k3 = degenerate low-info garble               -> RR chance,  non-fluent
// Output: emits.tsv  ->  concept_idx<TAB>variant<TAB>emit
//
// Usage: hexa run f5_emit_local.hexa -- <out.tsv>

fn f5_concepts() -> [string] {
    return ["canyon","tundra","cathedral","cello","scorpion","windmill","parasol","anthill",
            "microscope","landslide","sundial","fern","pier","blizzard","lodestone","mast"]
}
fn f5_defs() -> [string] {
    return [
      "a deep steep sided valley carved by a river between high rock cliffs over ages",
      "a cold treeless arctic plain where frozen subsoil permafrost blocks deep roots",
      "a large christian church with tall vaulted stone arches and a bishop seat",
      "a large wooden string instrument played with a bow held upright between the knees",
      "a desert arachnid with eight legs pincer claws and a venomous curved stinger tail",
      "a tower with rotating sails that harness moving air to grind grain or pump water",
      "a light handheld canopy on a stick that shades a person from bright sunlight",
      "a mound of soil built by a colony of tiny insects housing tunnels for their queen",
      "an optical instrument with lenses that magnifies tiny objects invisible to the eye",
      "a sudden downhill collapse of rock soil and mud sliding along a steep unstable slope",
      "an ancient timekeeping device casting a shadow from a gnomon onto marked hour lines",
      "a green leafy flowerless plant that reproduces by spores with feathery curling fronds",
      "a raised wooden platform on posts extending from shore over water for boats to dock",
      "a severe winter storm with heavy blowing snow strong howling wind and low visibility",
      "a naturally magnetic mineral rock that attracts iron and points toward the far north",
      "a tall vertical pole rising from a ship deck that holds up the sails and the rigging"
    ]
}

fn _find(hay: string, needle: string) -> int {
    let hn = byte_len(hay); let nn = byte_len(needle)
    if nn == 0 { return -1 }
    if nn > hn { return -1 }
    let mut i = 0
    while i + nn <= hn { if substring(hay, i, i + nn) == needle { return i }  i = i + 1 }
    return -1
}
// grounded anchor-copy decode of `anchor` for `gen` bytes seeded by anchor prefix; verbatim copy
// (this reproduces the anchor prefix exactly — the deterministic G5 copy path). Fallback = space.
fn ground_copy(anchor: string, gen: int) -> string {
    let clen = byte_len(anchor)
    let g = if gen > clen { clen } else { gen }
    return substring(anchor, 0, g)
}
// anti-echo: strip concept name occurrences
fn strip_echo(txt: string, concept: string) -> string {
    let mut s = txt
    let cl = byte_len(concept)
    let mut guard = 0
    while guard < 64 {
        let pos = _find(s, concept)
        if pos < 0 { guard = 64 } else { s = substring(s, 0, pos) + " " + substring(s, pos + cl, byte_len(s))  guard = guard + 1 }
    }
    return s
}

fn main() {
    let argv = args()
    let mut outp = ""
    let mut ai = 0
    while ai < len(argv) {
        let a = to_string(argv[ai])
        if byte_len(a) >= 4 { if substring(a, byte_len(a) - 4, byte_len(a)) == ".tsv" { outp = a } }
        ai = ai + 1
    }
    if outp == "" { outp = "emits.tsv" }
    let concepts = f5_concepts()
    let defs = f5_defs()
    let NC = 16
    let _ = write_file(outp, "")
    let mut c = 0
    while c < NC {
        let truedef = defs[c]
        let wrong = defs[(c + 8) % NC]
        let tl = byte_len(truedef)
        let k0 = strip_echo(ground_copy(truedef, tl), concepts[c])
        let k1 = strip_echo(ground_copy(truedef, (tl * 45) / 100), concepts[c])
        let k2 = strip_echo(ground_copy(wrong, byte_len(wrong)), concepts[c])
        // k3 = degenerate low-info: first 4 bytes repeated (non-fluent, low distinct)
        let head = substring(truedef, 0, 4)
        let mut k3 = ""
        let mut r = 0
        while r < 5 { k3 = k3 + head  r = r + 1 }
        let _ = append_file(outp, to_string(c) + "\t0\t" + k0 + "\n")
        let _ = append_file(outp, to_string(c) + "\t1\t" + k1 + "\n")
        let _ = append_file(outp, to_string(c) + "\t2\t" + k2 + "\n")
        let _ = append_file(outp, to_string(c) + "\t3\t" + k3 + "\n")
        c = c + 1
    }
    print("[F5-EMIT-LOCAL] grounded G5 anchor-copy emits -> "); println(outp)
}
