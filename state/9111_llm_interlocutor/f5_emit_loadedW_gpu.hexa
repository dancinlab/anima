// f5_emit.hexa — F5 diff-LLM interlocutor: LOADED-W emit harness (engine-native).
// Loads the 303M ByteGPT ONCE (bg_load_ranged) and generates 16 concepts × 4 grounding
// variants of a concept-definition emit, WITHOUT per-call reload (a_engine_native_learning,
// no gen_auto_ideate reload leak). Ungrounded steps call the LIVE core forward
// bg_forward_last_W (own-GEMM GPU when HEXA_CUDA=1). Concept token strip = anti-echo.
// Output: emits.tsv  ->  `concept_idx<TAB>variant<TAB>escaped_emit`  (one line/candidate).
//
// Usage: hexa run core/f5_emit.hexa -- <h1129.bin> <out_emits.tsv>
import "core/bytegpt_decode.hexa"

// ---- 16 F5-fresh concepts (F6-disjoint) + reference definitions (concept name STRIPPED
// from the body so anti-echo is intrinsic; packed with discriminative content words) ----
fn f5_concepts() -> [string] {
    return ["canyon","tundra","cathedral","cello","scorpion","windmill","parasol","anthill",
            "microscope","landslide","sundial","fern","pier","blizzard","lodestone","mast"]
}
fn f5_defs() -> [string] {
    return [
      "a deep steep sided valley carved by a river between high rock cliffs over ages",
      "a cold treeless arctic plain where frozen subsoil permafrost blocks deep roots",
      "a large christian church with tall vaulted stone arches and a bishop seat",
      "a large wooden string instrument played with a bow held upright between the knees",
      "a desert arachnid with eight legs pincer claws and a venomous curved stinger tail",
      "a tower with rotating sails that harness moving air to grind grain or pump water",
      "a light handheld canopy on a stick that shades a person from bright sunlight",
      "a mound of soil built by a colony of tiny insects housing tunnels for their queen",
      "an optical instrument with lenses that magnifies tiny objects invisible to the eye",
      "a sudden downhill collapse of rock soil and mud sliding along a steep unstable slope",
      "an ancient timekeeping device casting a shadow from a gnomon onto marked hour lines",
      "a green leafy flowerless plant that reproduces by spores with feathery curling fronds",
      "a raised wooden platform on posts extending from shore over water for boats to dock",
      "a severe winter storm with heavy blowing snow strong howling wind and low visibility",
      "a naturally magnetic mineral rock that attracts iron and points toward the far north",
      "a tall vertical pole rising from a ship deck that holds up the sails and the rigging"
    ]
}

// per-variant grounding depth (l_min): low = strong verbatim copy = legible; high(99) = pure LM.
// gen capped near def-length so grounded variants stay pure verbatim-copy (fast, no LM misses
// past the anchor); v3 is the pure-LM (l_min=99) low-legibility anchor with a short budget.
fn f5_lmins() -> [int] { return [3, 6, 12, 99] }
fn f5_gens()  -> [int] { return [72, 56, 40, 14] }

// find first occurrence of needle in hay (byte exact); -1 if absent.
fn _f5_find(hay: string, needle: string) -> int {
    let hn = byte_len(hay); let nn = byte_len(needle)
    if nn == 0 { return -1 }
    if nn > hn { return -1 }
    let mut i = 0
    while i + nn <= hn { if substring(hay, i, i + nn) == needle { return i }  i = i + 1 }
    return -1
}
// one grounded copy step: longest ctx-suffix (>= l_min) found in anchor -> its next byte; else -1.
fn _f5_anchor_copy(ctx: string, anchor: string, l_min: int, l_max: int) -> int {
    let clen = byte_len(ctx)
    let mut L = l_max
    if L > clen { L = clen }
    while L >= l_min {
        let suf = substring(ctx, clen - L, clen)
        let pos = _f5_find(anchor, suf)
        if pos >= 0 { let nxt = pos + L  if nxt < byte_len(anchor) { return ord(substring(anchor, nxt, nxt + 1)) } }
        L = L - 1
    }
    return -1
}
// argmax over a loaded-W logits farr[vocab].
fn _f5_argmax(logits: int, vocab: int) -> int {
    let mut best = 0
    let mut bv = farr_get(logits, 0)
    let mut i = 1
    while i < vocab { let v = farr_get(logits, i)  if v > bv { bv = v  best = i }  i = i + 1 }
    return best
}

// generate `gen` bytes from ALREADY-LOADED W: grounded anchor-copy first, else LIVE LM argmax.
fn f5_gen(W: Map, seed: string, anchor: string, gen: int, l_min: int, block: int, vocab: int) -> string {
    let toks = []
    let slen = byte_len(seed)
    let mut si = 0
    while si < slen { toks.push(ord(substring(seed, si, si + 1)))  si = si + 1 }
    let mut out = ""
    let mut g = 0
    while g < gen {
        let ctx = seed + out
        let cb = _f5_anchor_copy(ctx, anchor, l_min, block)
        let mut nb = 0
        if cb >= 0 {
            nb = cb
        } else {
            let n = len(toks)
            let mut start = 0
            if n > block { start = n - block }
            let T = n - start
            let ids = farr_zeros(T)
            let mut p = 0
            while p < T { let _ = farr_set(ids, p, to_float(to_int(toks[start + p])))  p = p + 1 }
            let logits = bg_forward_last_W(W, ids, T)
            nb = _f5_argmax(logits, vocab)
            let _ = farr_free(logits)
            let _ = farr_free(ids)
        }
        toks.push(nb)
        out = out + chr(nb)
        g = g + 1
    }
    return out
}

// strip all occurrences of the concept name (anti-echo) + escape tab/newline to space.
fn _f5_clean(txt: string, concept: string) -> string {
    let mut s = txt
    let cl = byte_len(concept)
    let mut guard = 0
    while guard < 64 {
        let pos = _f5_find(s, concept)
        if pos < 0 { guard = 64 } else {
            s = substring(s, 0, pos) + " " + substring(s, pos + cl, byte_len(s))
            guard = guard + 1
        }
    }
    let mut esc = ""
    let mut k = 0
    let tl = byte_len(s)
    while k < tl {
        let ch = substring(s, k, k + 1)
        if ch == "\t" { esc = esc + " " } else { if ch == "\n" { esc = esc + " " } else { esc = esc + ch } }
        k = k + 1
    }
    return esc
}

fn main() {
    let argv = args()
    let mut ck = ""
    let mut outp = ""
    let mut ai = 0
    while ai < len(argv) {
        let a = to_string(argv[ai])
        if _f5_find(a, ".bin") >= 0 { ck = a }
        if _f5_find(a, ".tsv") >= 0 { outp = a }
        ai = ai + 1
    }
    if ck == "" { ck = "/root/h1129.bin" }
    if outp == "" { outp = "/root/f5_out/emits.tsv" }

    print("[F5-EMIT] cuda_available=")
    println(cuda_available())
    println("[F5-EMIT] loading W (bg_load_ranged) ...")
    let W = bg_load_ranged(ck)
    let vocab = to_int(W["vocab"]); let block = to_int(W["block"])
    print("[F5-EMIT] loaded. vocab="); print(vocab); print(" block="); println(block)

    let concepts = f5_concepts()
    let defs = f5_defs()
    let lmins = f5_lmins()
    let gens = f5_gens()
    let _ = write_file(outp, "")
    let mut c = 0
    while c < len(concepts) {
        let anchor = defs[c]
        let seed = substring(anchor, 0, 6)
        let mut v = 0
        while v < len(lmins) {
            let raw = f5_gen(W, seed, anchor, gens[v], lmins[v], block, vocab)
            let clean = _f5_clean(raw, concepts[c])
            let _ = append_file(outp, to_string(c) + "\t" + to_string(v) + "\t" + clean + "\n")
            v = v + 1
        }
        print("[F5-EMIT] concept done: "); println(concepts[c])
        c = c + 1
    }
    print("[F5-EMIT] DONE -> "); println(outp)
}
