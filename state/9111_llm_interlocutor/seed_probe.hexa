import "core/generator.hexa"
// probe multiple seeds/formats in ONE run to test whether the engine-loadable 303M
// savant .clm has ANY G0-coherent decode mode (English free / chat / Korean).
fn main() {
    let ckpt = "/Users/mini/anima-weights/py303_savant_mitosis.clm"
    let seeds = [
        "A volcano is something that",
        "The library was full of",
        "사용자: 화산이 뭐야? | 도우미: ",
        "고양이는 ",
        "도우미: 바다는",
        "Q: What is a spider? A: A spider is"
    ]
    let mut i = 0
    while i < len(seeds) {
        let r = gen_auto_chat(ckpt, seeds[i], 40)
        println("SEED[" + to_string(i) + "]=[" + seeds[i] + "]")
        println("  OUT=[" + to_string(r["text"]) + "]")
        i = i + 1
    }
}
