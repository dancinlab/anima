use "core/clm_decode"
fn _argv(raw: [string]) -> [string] {
    let mut start = 1; let mut k = 0
    while k < len(raw) { if raw[k] == "--" { start = k + 1 }  k = k + 1 }
    let a = []; let mut m = start
    while m < len(raw) { a.push(raw[m]); m = m + 1 }
    return a
}
fn main() {
    let av = _argv(args())
    print("readout_type=" + to_string(clm_readout_type(av[0])) + " decodable=" + to_string(clm_decodable(av[0])))
}
