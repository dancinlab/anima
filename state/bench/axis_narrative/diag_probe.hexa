// DIAGNOSTIC PROBE — confirm collision-saturation modeling gap
// ═════════════════════════════════════════════════════════════════════
// Hypothesis of the gap:
//   reuse_rate = "does token appear ANYWHERE in prior WINDOW*TOKENS_PER
//   prior tokens" saturates because WINDOW(10)*TOKENS_PER(5)=50 prior
//   tokens cover a large fraction of VOCAB=64.
//
//   Expected baseline for a PURE-RANDOM (fragmented) token:
//     P(present) = 1 - (1 - 1/VOCAB)^50
//   We compute this closed-form (libm-free pow via loop) and print it.
//   If it is ~0.5, that explains F2 FAIL (fragmented mean 0.509 ≈ 0.5).
// ═════════════════════════════════════════════════════════════════════

fn pow_loop(base: float, n: int) -> float {
    let mut r = 1.0
    let mut k = 0
    while k < n {
        r = r * base
        k = k + 1
    }
    return r
}

fn main() {
    let vocab = 64
    // window of 10 turns * 5 tokens = 50 prior tokens
    let prior_tokens = 50
    let p_absent_one = (vocab - 1) as float / (vocab as float)
    // P(a given random token is absent from `prior_tokens` i.i.d. draws)
    let p_absent = pow_loop(p_absent_one, prior_tokens)
    let p_present = 1.0 - p_absent
    println("=== collision-saturation closed-form ===")
    println("vocab=" + vocab.to_string() + " prior_tokens=" + prior_tokens.to_string())
    println("P(random token PRESENT in window) = " + p_present.to_string())
    println("(observed fragmented mean_reuse = 0.509)")
    println("")
    // Compare against a smaller window / larger vocab to show the gap closes
    let p2 = 1.0 - pow_loop((256 - 1) as float / 256.0, 10)
    println("if vocab=256, prior_tokens=10 (window=2):")
    println("P(random token PRESENT) = " + p2.to_string() + "  (<<0.3, no saturation)")
}
