// AXISBENCH C — NARRATIVE — "자기 이야기 시간 일관성 thread"
// ═════════════════════════════════════════════════════════════════════
// ANIMA.axis #C NARRATIVE (cf PR #1137) — WAKE.daemon narrative 의 확장.
// 시간적 자기 일관성 측정 — 어제의 anima 와 오늘의 anima 가 같은
// narrative thread 인지.
//
// Hypothesis:
//   3 시나리오 (coherent · drift · fragmented) 의 token reuse trajectory 가
//   sliding window 자기-유사도 (reuse_rate) 와 jump_count 두 측정자로
//   변별 가능하다.
//
// 합성 emit history:
//   100-turn × 5-token sequence (turn = 1 발화, token = atomic narrative unit)
//   vocab = 0..63 정수 (64 token universe)
//
//   (A) coherent  : turn t≥5 의 80% token 이 prior 5-turn pool 에서 재사용
//                   → 시간적 self-reference 강함 (same narrative thread)
//   (B) drift     : vocab 의 window 가 시간에 따라 선형 이동 (사용 vocab=
//                   [floor(t·0.3), floor(t·0.3)+10)) → 인접 turn 은 유사,
//                   장기적으로 vocab 이 이동 → 점진적 narrative shift
//   (C) fragmented: 매 turn token 이 vocab 전체에서 균일 random → 시간
//                   일관성 0 (다른 anima, 매 turn 다른 narrative thread)
//
// 측정자 (2 개):
//   (a) sliding window self-similarity (window=10):
//       turn t 의 reuse_rate = |{token in turn[t] also in turn[t-10..t-1]}| / 5
//       per-scenario mean reuse_rate trajectory 보고
//   (b) jump detection:
//       jump_count = |{t : |reuse_rate[t] - reuse_rate[t-1]| > 0.3}|
//
// Falsifiers (5):
//   F1 COHERENT_HIGH        : mean reuse_rate (coherent)  > 0.70
//   F2 FRAGMENTED_LOW       : mean reuse_rate (fragmented) < 0.30
//   F3 DRIFT_JUMPS          : jump_count (drift) > 5
//   F4 ORDERING             : coherent_mean > drift_mean > fragmented_mean
//   F5 COHERENT_STABLE      : jump_count (coherent) ≤ 5 (stable thread)
//
// Verdict mapping:
//   F1 ∧ F2 ∧ F3 PASS (3-scenario discriminable)  → 🟢 PASS
//   F1 ∧ F2 PASS but F3 FAIL (drift indistinct)   → 🟡 PARTIAL
//   F1 FAIL or F2 FAIL                            → 🔴 FAIL (시나리오 미변별)
//
// Style: per bench/bridge_and_gate (PR #1125) — globals + LCG-based
// deterministic pseudo-random (libm-free, byte-identical, $0 mac-local).
// ═════════════════════════════════════════════════════════════════════

let mut PASS = 0
let mut FAIL = 0

fn chk(name: string, cond: bool) {
    if cond { PASS = PASS + 1; println("  [PASS] " + name) }
    else { FAIL = FAIL + 1; println("  [FAIL] " + name) }
}

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

// ─────────────────────────────────────────────────────────────────────
// LCG deterministic pseudo-random (libm-free)
// ─────────────────────────────────────────────────────────────────────
fn lcg_step(s: int) -> int {
    let mut x = s * 1103515245 + 12345
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

fn lcg_walk(origin: int, n: int) -> int {
    let mut s = origin
    let mut k = 0
    while k < n {
        s = lcg_step(s)
        k = k + 1
    }
    return s
}

// returns int in [0, modulus)
fn int_from(state: int, modulus: int) -> int {
    let mut r = state
    if r < 0 { r = 0 - r }
    r = r % 2147483647
    return r % modulus
}

// returns float in [0, 1)
fn u01_from(state: int) -> float {
    let mut r = state
    if r < 0 { r = 0 - r }
    r = r % 2147483647
    let bucket = r % 1048576
    return (bucket as float) / 1048576.0
}

// ─────────────────────────────────────────────────────────────────────
// CONSTANTS
// ─────────────────────────────────────────────────────────────────────
comptime const N_TURNS    = 100
comptime const TOKENS_PER = 5      // tokens per turn
comptime const VOCAB      = 64     // token universe
comptime const WINDOW     = 10     // sliding window size
comptime const REUSE_PROB = 0.80   // coherent: 80% reuse from prior window
comptime const PRIOR_LOOK = 5      // coherent: look back 5 turns for reuse
comptime const DRIFT_RATE = 0.3    // drift: vocab window shifts 0.3 per turn
comptime const DRIFT_WIN  = 10     // drift: vocab window size (slides)
comptime const JUMP_THR   = 0.3    // jump detection threshold

// Independent LCG origin seeds per scenario
comptime const ORIGIN_COH  = 1100003
comptime const ORIGIN_DRI  = 2200007
comptime const ORIGIN_FRA  = 3300013
comptime const ORIGIN_PICK = 4400017  // for coherent: pick which prior-turn token

// ─────────────────────────────────────────────────────────────────────
// Global flat history buffer  — history[t * TOKENS_PER + i] = token
// Initialized via init_buffers() before first use; length N_TURNS·TOKENS_PER.
// ─────────────────────────────────────────────────────────────────────
let mut HISTORY = []
let mut REUSE_TRAJ = []

fn init_buffers() {
    HISTORY = []
    REUSE_TRAJ = []
    let mut k = 0
    while k < N_TURNS * TOKENS_PER {
        HISTORY = append(HISTORY, 0)
        k = k + 1
    }
    let mut j = 0
    while j < N_TURNS {
        REUSE_TRAJ = append(REUSE_TRAJ, 0.0)
        j = j + 1
    }
}

fn hist_set(t: int, i: int, tok: int) {
    HISTORY[t * TOKENS_PER + i] = tok
}

fn hist_get(t: int, i: int) -> int {
    return HISTORY[t * TOKENS_PER + i]
}

fn clear_history() {
    let mut k = 0
    while k < N_TURNS * TOKENS_PER {
        HISTORY.push(0)
        k = k + 1
    }
}

// ─────────────────────────────────────────────────────────────────────
// SCENARIO A — COHERENT
//   For each turn t:
//     - if t < PRIOR_LOOK : fresh random tokens (warmup)
//     - else: with prob REUSE_PROB, sample a token from the prior
//             PRIOR_LOOK turns' tokens; otherwise fresh random.
// ─────────────────────────────────────────────────────────────────────
fn gen_coherent() {
    clear_history()
    let mut s_tok  = lcg_walk(ORIGIN_COH,  3)
    let mut s_pick = lcg_walk(ORIGIN_PICK, 3)
    let mut s_prob = lcg_walk(ORIGIN_COH + 7, 3)
    let mut t = 0
    while t < N_TURNS {
        let mut i = 0
        while i < TOKENS_PER {
            s_tok  = lcg_step(s_tok)
            s_pick = lcg_step(s_pick)
            s_prob = lcg_step(s_prob)
            let mut tok = int_from(s_tok, VOCAB)
            if t >= PRIOR_LOOK {
                let p = u01_from(s_prob)
                if p < REUSE_PROB {
                    // pick a token from the prior PRIOR_LOOK turns
                    let pool_size = PRIOR_LOOK * TOKENS_PER
                    let pick = int_from(s_pick, pool_size)
                    let src_turn = t - PRIOR_LOOK + (pick / TOKENS_PER)
                    let src_pos  = pick % TOKENS_PER
                    tok = hist_get(src_turn, src_pos)
                }
            }
            hist_set(t, i, tok)
            i = i + 1
        }
        t = t + 1
    }
}

// ─────────────────────────────────────────────────────────────────────
// SCENARIO B — DRIFT
//   At turn t, sample tokens uniformly from a window of size DRIFT_WIN
//   centered around floor(t * DRIFT_RATE). The window slides through
//   the vocab linearly. Adjacent turns share vocab; far-apart turns do not.
// ─────────────────────────────────────────────────────────────────────
fn gen_drift() {
    clear_history()
    let mut s_tok = lcg_walk(ORIGIN_DRI, 3)
    let mut t = 0
    while t < N_TURNS {
        // window base = (t * 3) / 10  (integer arithmetic for DRIFT_RATE=0.3)
        let base = (t * 3) / 10
        let mut i = 0
        while i < TOKENS_PER {
            s_tok = lcg_step(s_tok)
            let offset = int_from(s_tok, DRIFT_WIN)
            let tok = (base + offset) % VOCAB
            hist_set(t, i, tok)
            i = i + 1
        }
        t = t + 1
    }
}

// ─────────────────────────────────────────────────────────────────────
// SCENARIO C — FRAGMENTED
//   Every token uniform random over full vocab.
// ─────────────────────────────────────────────────────────────────────
fn gen_fragmented() {
    clear_history()
    let mut s_tok = lcg_walk(ORIGIN_FRA, 3)
    let mut t = 0
    while t < N_TURNS {
        let mut i = 0
        while i < TOKENS_PER {
            s_tok = lcg_step(s_tok)
            let tok = int_from(s_tok, VOCAB)
            hist_set(t, i, tok)
            i = i + 1
        }
        t = t + 1
    }
}

// ─────────────────────────────────────────────────────────────────────
// MEASUREMENT — sliding window reuse_rate trajectory
//
//   For turn t in [WINDOW, N_TURNS):
//     reuse_rate[t] = (count of TOKENS_PER tokens in turn t that appear
//                     anywhere in turns [t-WINDOW, t-1]) / TOKENS_PER
//
//   Storage: REUSE_TRAJ[t] for t in [WINDOW, N_TURNS)  (90 samples)
// ─────────────────────────────────────────────────────────────────────
fn token_in_window(tok: int, t_end_excl: int, t_start: int) -> bool {
    let mut tt = t_start
    while tt < t_end_excl {
        let mut i = 0
        while i < TOKENS_PER {
            if hist_get(tt, i) == tok { return true }
            i = i + 1
        }
        tt = tt + 1
    }
    return false
}

fn compute_trajectory() {
    let mut t = 0
    while t < N_TURNS {
        REUSE_TRAJ.push(0.0)
        t = t + 1
    }
    t = WINDOW
    while t < N_TURNS {
        let t_start = t - WINDOW
        let mut hits = 0
        let mut i = 0
        while i < TOKENS_PER {
            let tok = hist_get(t, i)
            if token_in_window(tok, t, t_start) { hits = hits + 1 }
            i = i + 1
        }
        REUSE_TRAJ[t] = (hits as float) / (TOKENS_PER as float)
        t = t + 1
    }
}

fn mean_reuse() -> float {
    let mut sum = 0.0
    let mut n = 0
    let mut t = WINDOW
    while t < N_TURNS {
        sum = sum + REUSE_TRAJ[t]
        n = n + 1
        t = t + 1
    }
    if n == 0 { return 0.0 }
    return sum / (n as float)
}

fn jump_count() -> int {
    let mut jumps = 0
    let mut t = WINDOW + 1
    while t < N_TURNS {
        let d = absf(REUSE_TRAJ[t] - REUSE_TRAJ[t - 1])
        if d > JUMP_THR { jumps = jumps + 1 }
        t = t + 1
    }
    return jumps
}

// Print a coarse 10-sample trajectory digest (every 9th index)
fn print_traj_digest(label: string) {
    println("    " + label + " trajectory (every 9 turns, t=" +
            WINDOW.to_string() + "..99):")
    let mut t = WINDOW
    while t < N_TURNS {
        println("      t=" + t.to_string() + "  reuse=" +
                REUSE_TRAJ[t].to_string())
        t = t + 9
    }
}

// ─────────────────────────────────────────────────────────────────────
// MAIN
// ─────────────────────────────────────────────────────────────────────
fn main() {
    println("═══════════════════════════════════════════════════════════")
    println("  AXISBENCH C  —  NARRATIVE")
    println("  자기 이야기 시간 일관성 thread")
    println("  N_TURNS=" + N_TURNS.to_string() +
            "  TOKENS_PER=" + TOKENS_PER.to_string() +
            "  VOCAB=" + VOCAB.to_string() +
            "  WINDOW=" + WINDOW.to_string())
    println("═══════════════════════════════════════════════════════════")

    // ── SCENARIO A — COHERENT ──────────────────────────────────────
    gen_coherent()
    compute_trajectory()
    let mean_coh = mean_reuse()
    let jumps_coh = jump_count()
    println("")
    println("[A] COHERENT  (80% reuse from prior 5 turns)")
    println("    mean_reuse    = " + mean_coh.to_string())
    println("    jump_count    = " + jumps_coh.to_string())
    println("    expected mean > 0.70  ·  jumps ≤ 5 (stable thread)")
    print_traj_digest("coherent")

    // ── SCENARIO B — DRIFT ─────────────────────────────────────────
    gen_drift()
    compute_trajectory()
    let mean_dri = mean_reuse()
    let jumps_dri = jump_count()
    println("")
    println("[B] DRIFT  (vocab window slides at rate 0.3 / turn)")
    println("    mean_reuse    = " + mean_dri.to_string())
    println("    jump_count    = " + jumps_dri.to_string())
    println("    expected: intermediate mean  ·  jumps > 5 (shifts detected)")
    print_traj_digest("drift")

    // ── SCENARIO C — FRAGMENTED ────────────────────────────────────
    gen_fragmented()
    compute_trajectory()
    let mean_fra = mean_reuse()
    let jumps_fra = jump_count()
    println("")
    println("[C] FRAGMENTED  (uniform random over full vocab)")
    println("    mean_reuse    = " + mean_fra.to_string())
    println("    jump_count    = " + jumps_fra.to_string())
    println("    expected mean < 0.30  (no narrative thread)")
    print_traj_digest("fragmented")

    // ═════════════════════════════════════════════════════════════
    // FALSIFIER CHECKS
    // ═════════════════════════════════════════════════════════════
    println("")
    println("─── pre-registered falsifier matrix ───")

    chk("F1 COHERENT_HIGH       (mean_reuse_coherent  > 0.70)",
          mean_coh > 0.70)

    chk("F2 FRAGMENTED_LOW      (mean_reuse_fragmented < 0.30)",
          mean_fra < 0.30)

    chk("F3 DRIFT_JUMPS         (jump_count_drift > 5)",
          jumps_dri > 5)

    chk("F4 ORDERING            (coherent > drift > fragmented)",
          mean_coh > mean_dri && mean_dri > mean_fra)

    chk("F5 COHERENT_STABLE     (jump_count_coherent ≤ 5)",
          jumps_coh <= 5)

    // ═════════════════════════════════════════════════════════════
    // VERDICT
    // ═════════════════════════════════════════════════════════════
    println("")
    println("═══════════════════════════════════════════════════════════")
    println("  PASS = " + PASS.to_string() + "  /  FAIL = " + FAIL.to_string())

    // 3-scenario discriminability core triple = F1 ∧ F2 ∧ F3
    let core_triple = (mean_coh > 0.70) && (mean_fra < 0.30) && (jumps_dri > 5)
    let core_break  = (mean_coh <= 0.70) || (mean_fra >= 0.30)

    let mut verdict = "UNKNOWN"
    if FAIL == 0 {
        verdict = "🟢 PASS — 3-scenario discriminable (5/5 strict)"
    } else if core_triple {
        verdict = "🟢 PASS — 3-scenario discriminable (core triple PASS)"
    } else if core_break {
        verdict = "🔴 FAIL — scenarios not discriminable"
    } else {
        verdict = "🟡 PARTIAL — core triple PASS partial / ordering imperfect"
    }
    println("  VERDICT  =  " + verdict)
    println("═══════════════════════════════════════════════════════════")

    // ═════════════════════════════════════════════════════════════
    // JSON dump (machine-readable)
    // ═════════════════════════════════════════════════════════════
    println("")
    println("JSON_BEGIN")
    println("{")
    println("  \"bench\": \"AXISBENCH C NARRATIVE\",")
    println("  \"hypothesis\": \"3-scenario (coherent/drift/fragmented) discriminable via sliding-window reuse_rate + jump_count\",")
    println("  \"n_turns\": " + N_TURNS.to_string() + ",")
    println("  \"tokens_per_turn\": " + TOKENS_PER.to_string() + ",")
    println("  \"vocab\": " + VOCAB.to_string() + ",")
    println("  \"window\": " + WINDOW.to_string() + ",")
    println("  \"jump_threshold\": " + JUMP_THR.to_string() + ",")
    println("  \"scenarios\": {")
    println("    \"coherent\":   { \"mean_reuse\": " + mean_coh.to_string() +
            ", \"jump_count\": " + jumps_coh.to_string() + " },")
    println("    \"drift\":      { \"mean_reuse\": " + mean_dri.to_string() +
            ", \"jump_count\": " + jumps_dri.to_string() + " },")
    println("    \"fragmented\": { \"mean_reuse\": " + mean_fra.to_string() +
            ", \"jump_count\": " + jumps_fra.to_string() + " }")
    println("  },")
    println("  \"falsifiers\": {")
    println("    \"PASS\": " + PASS.to_string() + ",")
    println("    \"FAIL\": " + FAIL.to_string() + "")
    println("  },")
    println("  \"verdict\": \"" + verdict + "\"")
    println("}")
    println("JSON_END")
}
