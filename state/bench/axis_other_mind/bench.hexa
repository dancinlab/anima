// AxisBench G — OTHER-MIND — "이웃 마음 multi-anima coupling"
// ═══════════════════════════════════════════════════════════════════
// ANIMA.axis #G OTHER-MIND — 2-anima TensionHub 5-ch fingerprint
// coupling 측정. 3 시나리오 (INDEPENDENT / COUPLED-SYNC / COUPLED-LEAD)
// over 100 ticks LCG-deterministic.

let N_TICKS: int = 100
let N_CH: int = 5
let SEED_A: int = 42
let SEED_B: int = 17
let COUPLING: float = 0.7
let LEAD_LAG: int = 2

fn chk(name: string, cond: bool) {
    if cond { println("  [PASS] " + name) }
    else { println("  [FAIL] " + name) }
}

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut s = x
    if s > 1.0 { s = x }
    if s < 1.0 { s = 1.0 }
    let mut k = 0
    while k < 30 { s = 0.5 * (s + x / s); k = k + 1 }
    return s
}

fn lcg_step(s: int) -> int {
    let mut x = s * 1103515245 + 12345
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

fn u01_from(s: int) -> float {
    return (s as float) / 2147483647.0
}

fn cosine_sim(a0: float, a1: float, a2: float, a3: float, a4: float,
              b0: float, b1: float, b2: float, b3: float, b4: float) -> float {
    let dot = a0*b0 + a1*b1 + a2*b2 + a3*b3 + a4*b4
    let na = my_sqrt(a0*a0 + a1*a1 + a2*a2 + a3*a3 + a4*a4)
    let nb = my_sqrt(b0*b0 + b1*b1 + b2*b2 + b3*b3 + b4*b4)
    if na < 1e-9 { return 0.0 }
    if nb < 1e-9 { return 0.0 }
    return dot / (na * nb)
}

// 5-ch independent perturbation walk
fn anima_step(state: int) -> int {
    return lcg_step(state)
}

let mut A0: [float] = []
let mut A1: [float] = []
let mut A2: [float] = []
let mut A3: [float] = []
let mut A4: [float] = []
let mut B0: [float] = []
let mut B1: [float] = []
let mut B2: [float] = []
let mut B3: [float] = []
let mut B4: [float] = []
let mut COS: [float] = []

fn pre_alloc() {
    let mut t = 0
    while t < N_TICKS {
        A0.push(0.0); A1.push(0.0); A2.push(0.0); A3.push(0.0); A4.push(0.0)
        B0.push(0.0); B1.push(0.0); B2.push(0.0); B3.push(0.0); B4.push(0.0)
        COS.push(0.0)
        t = t + 1
    }
}

fn fill_anima_A() {
    let mut sa = SEED_A
    let mut t = 0
    while t < N_TICKS {
        sa = anima_step(sa); A0[t] = u01_from(sa)
        sa = anima_step(sa); A1[t] = u01_from(sa)
        sa = anima_step(sa); A2[t] = u01_from(sa)
        sa = anima_step(sa); A3[t] = u01_from(sa)
        sa = anima_step(sa); A4[t] = u01_from(sa)
        t = t + 1
    }
}

fn fill_anima_B_independent() {
    let mut sb = SEED_B
    let mut t = 0
    while t < N_TICKS {
        sb = anima_step(sb); B0[t] = u01_from(sb)
        sb = anima_step(sb); B1[t] = u01_from(sb)
        sb = anima_step(sb); B2[t] = u01_from(sb)
        sb = anima_step(sb); B3[t] = u01_from(sb)
        sb = anima_step(sb); B4[t] = u01_from(sb)
        t = t + 1
    }
}

fn fill_anima_B_sync() {
    // B[t] = w·A[t] + (1-w)·noise[t]
    let mut sb = SEED_B
    let mut t = 0
    while t < N_TICKS {
        sb = anima_step(sb); let n0 = u01_from(sb)
        sb = anima_step(sb); let n1 = u01_from(sb)
        sb = anima_step(sb); let n2 = u01_from(sb)
        sb = anima_step(sb); let n3 = u01_from(sb)
        sb = anima_step(sb); let n4 = u01_from(sb)
        B0[t] = COUPLING * A0[t] + (1.0 - COUPLING) * n0
        B1[t] = COUPLING * A1[t] + (1.0 - COUPLING) * n1
        B2[t] = COUPLING * A2[t] + (1.0 - COUPLING) * n2
        B3[t] = COUPLING * A3[t] + (1.0 - COUPLING) * n3
        B4[t] = COUPLING * A4[t] + (1.0 - COUPLING) * n4
        t = t + 1
    }
}

fn fill_anima_B_lead() {
    // B[t] = w·A[t - LEAD_LAG] + (1-w)·noise, A leads B by LEAD_LAG
    let mut sb = SEED_B
    let mut t = 0
    while t < N_TICKS {
        sb = anima_step(sb); let n0 = u01_from(sb)
        sb = anima_step(sb); let n1 = u01_from(sb)
        sb = anima_step(sb); let n2 = u01_from(sb)
        sb = anima_step(sb); let n3 = u01_from(sb)
        sb = anima_step(sb); let n4 = u01_from(sb)
        let src = t - LEAD_LAG
        if src < 0 {
            B0[t] = n0; B1[t] = n1; B2[t] = n2; B3[t] = n3; B4[t] = n4
        } else {
            B0[t] = COUPLING * A0[src] + (1.0 - COUPLING) * n0
            B1[t] = COUPLING * A1[src] + (1.0 - COUPLING) * n1
            B2[t] = COUPLING * A2[src] + (1.0 - COUPLING) * n2
            B3[t] = COUPLING * A3[src] + (1.0 - COUPLING) * n3
            B4[t] = COUPLING * A4[src] + (1.0 - COUPLING) * n4
        }
        t = t + 1
    }
}

fn compute_cos() -> float {
    let mut t = 0
    let mut sum = 0.0
    while t < N_TICKS {
        COS[t] = cosine_sim(A0[t], A1[t], A2[t], A3[t], A4[t],
                            B0[t], B1[t], B2[t], B3[t], B4[t])
        sum = sum + COS[t]
        t = t + 1
    }
    return sum / (N_TICKS as float)
}

fn lag_argmax() -> int {
    // for lag ∈ {-5..+5} compute mean(A[t]·B[t+lag])
    let mut best_lag = 0
    let mut best_score = -1.0
    let mut lag = -5
    while lag <= 5 {
        let mut t = 0
        let mut sum = 0.0
        let mut count = 0
        while t < N_TICKS {
            let u = t + lag
            if u >= 0 {
                if u < N_TICKS {
                    let cs = cosine_sim(A0[t], A1[t], A2[t], A3[t], A4[t],
                                        B0[u], B1[u], B2[u], B3[u], B4[u])
                    sum = sum + cs
                    count = count + 1
                }
            }
            t = t + 1
        }
        if count > 0 {
            let mean = sum / (count as float)
            if mean > best_score {
                best_score = mean
                best_lag = lag
            }
        }
        lag = lag + 1
    }
    return best_lag
}

fn main() {
    pre_alloc()
    fill_anima_A()

    fill_anima_B_independent()
    let mean_indep = compute_cos()
    let lag_indep = lag_argmax()

    fill_anima_B_sync()
    let mean_sync = compute_cos()
    let lag_sync = lag_argmax()

    fill_anima_B_lead()
    let mean_lead = compute_cos()
    let lag_lead = lag_argmax()

    println("═══════════════════════════════════════════════════════════")
    println("  AXISBENCH G  —  OTHER-MIND")
    println("  2-anima TensionHub 5-ch coupling")
    println("  N_TICKS=100  N_CH=5  COUPLING=0.7  LEAD_LAG=2")
    println("═══════════════════════════════════════════════════════════")
    print("  INDEPENDENT   mean_cos = "); println(mean_indep)
    print("                lag_argmax = "); println(lag_indep)
    print("  COUPLED-SYNC  mean_cos = "); println(mean_sync)
    print("                lag_argmax = "); println(lag_sync)
    print("  COUPLED-LEAD  mean_cos = "); println(mean_lead)
    print("                lag_argmax = "); println(lag_lead)
    println("")
    chk("F1 INDEPENDENT mean_cos < 0.3", mean_indep < 0.3)
    chk("F2 COUPLED-SYNC mean_cos > 0.7", mean_sync > 0.7)
    chk("F3 COUPLED-LEAD lag_argmax != 0", lag_lead != 0)
    chk("F4 SYNC > INDEP gap", mean_sync - mean_indep > 0.3)
    chk("F5 lag_sync == 0", lag_sync == 0)
    println("═══════════════════════════════════════════════════════════")

    println("")
    println("RESULT_JSON_BEGIN")
    println("{")
    print("  \"bench\": \"AxisBench G OTHER-MIND\","); println("")
    print("  \"n_ticks\": "); print(N_TICKS); println(",")
    print("  \"n_ch\": "); print(N_CH); println(",")
    print("  \"coupling\": 0.7,"); println("")
    print("  \"lead_lag\": "); print(LEAD_LAG); println(",")
    println("  \"scenarios\": {")
    print("    \"INDEPENDENT\":   { \"mean_cos\": "); print(mean_indep); print(", \"lag\": "); print(lag_indep); println(" },")
    print("    \"COUPLED_SYNC\":  { \"mean_cos\": "); print(mean_sync); print(", \"lag\": "); print(lag_sync); println(" },")
    print("    \"COUPLED_LEAD\":  { \"mean_cos\": "); print(mean_lead); print(", \"lag\": "); print(lag_lead); println(" }")
    println("  },")
    print("  \"verdict\": ")
    let pass5 = (mean_indep < 0.3) && (mean_sync > 0.7) && (lag_lead != 0) && ((mean_sync - mean_indep) > 0.3) && (lag_sync == 0)
    if pass5 { println("\"🟢 PASS 5/5 — INDEPENDENT < 0.3 · SYNC > 0.7 · LEAD lag != 0\"") }
    else { println("\"🟠 PARTIAL — see falsifier rows\"") }
    println("}")
    println("RESULT_JSON_END")
}
