// ════════════════════════════════════════════════════════════════════════
// OTHER-MIND A4 — u01 baseline-bias diagnosis + bias-corrected re-measurement
//
// Hypothesis (A4): bench G OTHER-MIND 의 3/5 PARTIAL (PR #1147) residual 인
//   u01 baseline bias 는 baseline 정규화 결함이다 — u01_from(s)=s/2^31 이
//   [0,1] 양수만 생성 → 모든 5-ch 벡터가 positive orthant 에 갇혀
//   cosine_sim 의 dot >= 0 always → INDEPENDENT mean_cos ~= 0.78 (기대 < 0.3).
//   bias-corrected (zero-mean centering: c = 2*u - 1, [0,1] -> [-1,+1]) 로
//   재측정 시 INDEPENDENT mean_cos -> ~0 회복, gap > 0.3 회복, >= 4/5 도달.
//
// Falsifier: centering 후에도 3/5 이하 → bias 가 substrate 본질 (honest
//   residual, a_paper_negative_ok).
//
// 본 harness 는 원본 bench (bench/axis_other_mind/bench.hexa, PR #1147) 의
// 3-scenario 구조를 그대로 재현하되, 단 한 줄 — u01 -> centered transform —
// 만 교체하여 bias 의 원인을 단독 isolate (A/B test). 추가로 closed-form
// orthant-bias probe (biased vs corrected INDEPENDENT baseline 동시 측정) 로
// "어느 측정이 어떻게 편향되는가" 를 verbatim 출력.
//
// foreground sync · $0 mac-local · libm-free.
// ════════════════════════════════════════════════════════════════════════

let N_TICKS: int = 100
let SEED_A: int = 42
let SEED_B: int = 17
let COUPLING: float = 0.7
let LEAD_LAG: int = 2

fn absf(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}

fn my_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut s = x
    if s < 1.0 { s = 1.0 }
    let mut k = 0
    while k < 30 { s = 0.5 * (s + x / s); k = k + 1 }
    return s
}

// bench-compatible single LCG (carry verbatim)
fn lcg_step(s: int) -> int {
    let mut x = s * 1103515245 + 12345
    if x < 0 { x = 0 - x }
    x = x % 2147483647
    return x
}

// raw u01 — bench original (BIASED, [0,1] positive only)
fn u01_raw(s: int) -> float {
    return (s as float) / 2147483647.0
}

// bias-corrected u01 — zero-mean centering [0,1] -> [-1,+1]
fn u01_centered(s: int) -> float {
    return 2.0 * ((s as float) / 2147483647.0) - 1.0
}

fn cosine_sim(a0: float, a1: float, a2: float, a3: float, a4: float,
              b0: float, b1: float, b2: float, b3: float, b4: float) -> float {
    let dot = a0*b0 + a1*b1 + a2*b2 + a3*b3 + a4*b4
    let na = my_sqrt(a0*a0 + a1*a1 + a2*a2 + a3*a3 + a4*a4)
    let nb = my_sqrt(b0*b0 + b1*b1 + b2*b2 + b3*b3 + b4*b4)
    if na < 1e-9 { return 0.0 }
    if nb < 1e-9 { return 0.0 }
    return dot / (na * nb)
}

// ─── storage ──────────────────────────────────────────────────────────────
let mut A0: [float] = []
let mut A1: [float] = []
let mut A2: [float] = []
let mut A3: [float] = []
let mut A4: [float] = []
let mut B0: [float] = []
let mut B1: [float] = []
let mut B2: [float] = []
let mut B3: [float] = []
let mut B4: [float] = []

fn pre_alloc() {
    let mut t = 0
    while t < N_TICKS {
        A0.push(0.0); A1.push(0.0); A2.push(0.0); A3.push(0.0); A4.push(0.0)
        B0.push(0.0); B1.push(0.0); B2.push(0.0); B3.push(0.0); B4.push(0.0)
        t = t + 1
    }
}

// mode = 0 -> raw (biased), mode = 1 -> centered (corrected)
fn map_u01(s: int, mode: int) -> float {
    if mode == 1 { return u01_centered(s) }
    return u01_raw(s)
}

fn fill_A(mode: int) {
    let mut sa = SEED_A
    let mut t = 0
    while t < N_TICKS {
        sa = lcg_step(sa); A0[t] = map_u01(sa, mode)
        sa = lcg_step(sa); A1[t] = map_u01(sa, mode)
        sa = lcg_step(sa); A2[t] = map_u01(sa, mode)
        sa = lcg_step(sa); A3[t] = map_u01(sa, mode)
        sa = lcg_step(sa); A4[t] = map_u01(sa, mode)
        t = t + 1
    }
}

fn fill_B_independent(mode: int) {
    let mut sb = SEED_B
    let mut t = 0
    while t < N_TICKS {
        sb = lcg_step(sb); B0[t] = map_u01(sb, mode)
        sb = lcg_step(sb); B1[t] = map_u01(sb, mode)
        sb = lcg_step(sb); B2[t] = map_u01(sb, mode)
        sb = lcg_step(sb); B3[t] = map_u01(sb, mode)
        sb = lcg_step(sb); B4[t] = map_u01(sb, mode)
        t = t + 1
    }
}

fn fill_B_sync(mode: int) {
    let mut sb = SEED_B
    let mut t = 0
    while t < N_TICKS {
        sb = lcg_step(sb); let n0 = map_u01(sb, mode)
        sb = lcg_step(sb); let n1 = map_u01(sb, mode)
        sb = lcg_step(sb); let n2 = map_u01(sb, mode)
        sb = lcg_step(sb); let n3 = map_u01(sb, mode)
        sb = lcg_step(sb); let n4 = map_u01(sb, mode)
        B0[t] = COUPLING * A0[t] + (1.0 - COUPLING) * n0
        B1[t] = COUPLING * A1[t] + (1.0 - COUPLING) * n1
        B2[t] = COUPLING * A2[t] + (1.0 - COUPLING) * n2
        B3[t] = COUPLING * A3[t] + (1.0 - COUPLING) * n3
        B4[t] = COUPLING * A4[t] + (1.0 - COUPLING) * n4
        t = t + 1
    }
}

fn fill_B_lead(mode: int) {
    let mut sb = SEED_B
    let mut t = 0
    while t < N_TICKS {
        sb = lcg_step(sb); let n0 = map_u01(sb, mode)
        sb = lcg_step(sb); let n1 = map_u01(sb, mode)
        sb = lcg_step(sb); let n2 = map_u01(sb, mode)
        sb = lcg_step(sb); let n3 = map_u01(sb, mode)
        sb = lcg_step(sb); let n4 = map_u01(sb, mode)
        let src = t - LEAD_LAG
        if src < 0 {
            B0[t] = n0; B1[t] = n1; B2[t] = n2; B3[t] = n3; B4[t] = n4
        } else {
            B0[t] = COUPLING * A0[src] + (1.0 - COUPLING) * n0
            B1[t] = COUPLING * A1[src] + (1.0 - COUPLING) * n1
            B2[t] = COUPLING * A2[src] + (1.0 - COUPLING) * n2
            B3[t] = COUPLING * A3[src] + (1.0 - COUPLING) * n3
            B4[t] = COUPLING * A4[src] + (1.0 - COUPLING) * n4
        }
        t = t + 1
    }
}

fn compute_cos() -> float {
    let mut t = 0
    let mut sum = 0.0
    while t < N_TICKS {
        sum = sum + cosine_sim(A0[t], A1[t], A2[t], A3[t], A4[t],
                               B0[t], B1[t], B2[t], B3[t], B4[t])
        t = t + 1
    }
    return sum / (N_TICKS as float)
}

fn lag_argmax() -> int {
    let mut best_lag = 0
    let mut best_score = -1.0e9
    let mut lag = -5
    while lag <= 5 {
        let mut t = 0
        let mut sum = 0.0
        let mut count = 0
        while t < N_TICKS {
            let u = t + lag
            if u >= 0 {
                if u < N_TICKS {
                    let cs = cosine_sim(A0[t], A1[t], A2[t], A3[t], A4[t],
                                        B0[u], B1[u], B2[u], B3[u], B4[u])
                    sum = sum + cs
                    count = count + 1
                }
            }
            t = t + 1
        }
        if count > 0 {
            let mean = sum / (count as float)
            if mean > best_score {
                best_score = mean
                best_lag = lag
            }
        }
        lag = lag + 1
    }
    return best_lag
}

// run all 3 scenarios under a given mode; returns nothing, prints rows.
// mode 0 = raw biased (reproduce #1147), mode 1 = centered corrected.
fn run_mode(mode: int) -> int {
    fill_A(mode)

    fill_B_independent(mode)
    let mean_indep = compute_cos()
    let lag_indep = lag_argmax()

    fill_B_sync(mode)
    let mean_sync = compute_cos()
    let lag_sync = lag_argmax()

    fill_B_lead(mode)
    let mean_lead = compute_cos()
    let lag_lead = lag_argmax()

    let f1 = mean_indep < 0.3
    let f2 = mean_sync > 0.7
    let f3 = lag_lead != 0
    let f4 = (mean_sync - mean_indep) > 0.3
    let f5 = lag_sync == 0

    let mut pass = 0
    if f1 { pass = pass + 1 }
    if f2 { pass = pass + 1 }
    if f3 { pass = pass + 1 }
    if f4 { pass = pass + 1 }
    if f5 { pass = pass + 1 }

    if mode == 0 { println("  ── MODE 0: RAW u01 [0,1] (reproduce #1147 BIASED) ──") }
    else { println("  ── MODE 1: CENTERED u01 [-1,+1] (A4 bias-corrected) ──") }
    print("    INDEPENDENT  mean_cos = "); print(mean_indep); print("  lag = "); println(lag_indep)
    print("    COUPLED-SYNC mean_cos = "); print(mean_sync); print("  lag = "); println(lag_sync)
    print("    COUPLED-LEAD mean_cos = "); print(mean_lead); print("  lag = "); println(lag_lead)
    print("    gap(SYNC-INDEP) = "); println(mean_sync - mean_indep)
    if f1 { println("    [PASS] F1 INDEP < 0.3") } else { println("    [FAIL] F1 INDEP < 0.3") }
    if f2 { println("    [PASS] F2 SYNC > 0.7") } else { println("    [FAIL] F2 SYNC > 0.7") }
    if f3 { println("    [PASS] F3 LEAD lag != 0") } else { println("    [FAIL] F3 LEAD lag != 0") }
    if f4 { println("    [PASS] F4 gap > 0.3") } else { println("    [FAIL] F4 gap > 0.3") }
    if f5 { println("    [PASS] F5 SYNC lag == 0") } else { println("    [FAIL] F5 SYNC lag == 0") }
    print("    SCORE = "); print(pass); println("/5")
    println("")
    return pass
}

fn main() {
    pre_alloc()

    println("═══════════════════════════════════════════════════════════")
    println("  OTHER-MIND A4 — u01 baseline-bias diagnosis + correction")
    println("  N_TICKS=100  COUPLING=0.7  LEAD_LAG=2")
    println("═══════════════════════════════════════════════════════════")

    let score_raw = run_mode(0)
    let score_cor = run_mode(1)

    // ─── closed-form orthant-bias probe ──────────────────────────────────
    // 두 INDEPENDENT 5-ch 벡터의 기대 cosine: positive-orthant (raw) vs
    // zero-mean (centered). raw 는 E[cos] ~ 0.7+ (양반평면 set), centered
    // 는 E[cos] ~ 0 (전 orthant). 측정값으로 verbatim 출력.
    println("  ── ORTHANT-BIAS PROBE (n=400 indep pairs) ──")
    let mut sa = 7919
    let mut sb = 104729
    let mut t = 0
    let mut sum_raw = 0.0
    let mut sum_cor = 0.0
    while t < 400 {
        sa = lcg_step(sa); let ra0 = u01_raw(sa); let ca0 = u01_centered(sa)
        sa = lcg_step(sa); let ra1 = u01_raw(sa); let ca1 = u01_centered(sa)
        sa = lcg_step(sa); let ra2 = u01_raw(sa); let ca2 = u01_centered(sa)
        sa = lcg_step(sa); let ra3 = u01_raw(sa); let ca3 = u01_centered(sa)
        sa = lcg_step(sa); let ra4 = u01_raw(sa); let ca4 = u01_centered(sa)
        sb = lcg_step(sb); let rb0 = u01_raw(sb); let cb0 = u01_centered(sb)
        sb = lcg_step(sb); let rb1 = u01_raw(sb); let cb1 = u01_centered(sb)
        sb = lcg_step(sb); let rb2 = u01_raw(sb); let cb2 = u01_centered(sb)
        sb = lcg_step(sb); let rb3 = u01_raw(sb); let cb3 = u01_centered(sb)
        sb = lcg_step(sb); let rb4 = u01_raw(sb); let cb4 = u01_centered(sb)
        sum_raw = sum_raw + cosine_sim(ra0,ra1,ra2,ra3,ra4, rb0,rb1,rb2,rb3,rb4)
        sum_cor = sum_cor + cosine_sim(ca0,ca1,ca2,ca3,ca4, cb0,cb1,cb2,cb3,cb4)
        t = t + 1
    }
    let e_raw = sum_raw / 400.0
    let e_cor = sum_cor / 400.0
    print("    E[cos | raw  positive-orthant] = "); println(e_raw)
    print("    E[cos | centered zero-mean]    = "); println(e_cor)
    print("    bias magnitude |E_raw - E_cor| = "); println(absf(e_raw - e_cor))
    println("")

    // ─── verdict ──────────────────────────────────────────────────────────
    println("═══════════════════════════════════════════════════════════")
    print("  RAW (biased #1147 repro) = "); print(score_raw); println("/5")
    print("  CORRECTED (A4 centered)  = "); print(score_cor); println("/5")
    print("  VERDICT: ")
    if score_cor >= 4 {
        if score_cor > score_raw {
            println("🟢 RECOVERED — centering raised score >= 4/5, u01 bias = normalization defect")
        } else {
            println("🟢 RECOVERED >= 4/5 (no delta vs raw)")
        }
    } else {
        println("🟠 RESIDUAL — centering did NOT reach 4/5, bias may be substrate-intrinsic")
    }
    println("═══════════════════════════════════════════════════════════")

    println("")
    println("RESULT_JSON_BEGIN")
    println("{")
    print("  \"score_raw\": "); print(score_raw); println(",")
    print("  \"score_corrected\": "); print(score_cor); println(",")
    print("  \"E_cos_raw_orthant\": "); print(e_raw); println(",")
    print("  \"E_cos_centered\": "); print(e_cor); println(",")
    print("  \"bias_magnitude\": "); print(absf(e_raw - e_cor)); println(",")
    if score_cor >= 4 { println("  \"verdict\": \"GREEN_RECOVERED\"") }
    else { println("  \"verdict\": \"ORANGE_RESIDUAL\"") }
    println("}")
    println("RESULT_JSON_END")
}
