// h1417_compose_bind_law_probe.hexa — H_1417: the PREDICTIVE-FALSIFICATION round of the
// engine-BIND LAW. The law (DESCRIPTIVE, from H_1414/H_1415 cards):
//   "a mirror compose-GREEN binds engine-native IFF neither LIVE standalone faculty
//    strengthens PAST the mirror best-single ceiling by more than the +0.05 net-lift
//    headroom (ceiling-PINNED -> binds; ceiling-ERODING strong arm -> does not bind)."
// H_1411 did this for the OLD Φ-lift law (it BROKE, 2/5). H_1417 does it for the engine-BIND
// law: PRE-REGISTER a BIND/🧱 prediction for 5 NEW pairs PURELY from the law's predictor
// (locked in FREEZE.txt BEFORE measuring), THEN run the engine-native compose re-score, THEN
// score HIT/MISS. A MISS is the most valuable result (c9/c16/p7 — NOT tuned to hit).
//
// 5 NEW pairs (NOT yet engine-tested), each leg = a LIVE engine read (a_core_engine_map):
//   P1 memory x spatial     (immune_grow_recall  x spatial_map_nearest)  PRED 🟢
//   P2 memory x basal       (immune_grow_recall  x vbasal_go_value)      PRED 🧱
//   P3 ToM x spatial        (other_mind_predict  x spatial_map_nearest)  PRED 🟢
//   P4 cerebellum x memory  (vforward_err        x immune_grow_recall)   PRED 🟢
//   P5 ToM x basal          (other_mind_predict  x vbasal_go_value)      PRED 🧱
//
// FROZEN COMPOSE BARS (IDENTICAL to H_1407/1414/1415 — NOT moved):
//   (B1 COMPOSE-EFFECT) acc_compose >= best_single + 0.05
//   (B2 ORACLE)         acc_oracle - best_single > 0.02
//   (B3 EARNED/p6)      acc_compose - acc_shuffle > 0.02
//   (SEPARABLE)         only_X>0 AND only_Y>0
//   ACTUAL = 🟢 iff (B1 AND B2 AND B3 AND SEPARABLE) ; else 🧱.
// p7 = compose/oracle/shuffle accuracies + decomposition, NOT perplexity. $0 CPU.
//
// p1/p2/p3/p6 GUARD: each faculty reads ONLY its own substrate-derived signal (immune recall
// margin / witnessed-belief affinity / spatial metric distance / forward-model error /
// gradient-free go-value); NO injected answer/persona/RLHF/priority label enters any leg or
// the arbiter; the family CLASS only drives the protocol. Ψ-disjoint (pure reads, pure_field
// untouched). This is a MEASUREMENT round — NOTHING is wired into live CORE.

import "CORE/engine_cli.hexa"
import "CORE/brain.hexa"

// ── frozen knobs (== landed compose probes) ──────────────────────────────────
const N_PER_FAMILY: int = 90        // 5 families -> 450 items/seed
const COMPOSE_DELTA: float = 0.05   // B1 bar
const ORACLE_MARGIN: float = 0.02   // B2 bar
const SHUFFLE_TOL: float = 0.02     // B3 bar
const E_THR: float = 0.50           // cerebellum err threshold (H_1412)
const GO_THR: float = 0.0           // basal go-margin threshold (H_1412)
const N_LANDMARKS: int = 8          // spatial scene size (H_1296)
const GRID: float = 10.0
const CEIL_MIRROR: float = 0.70     // family ceiling (predictor input, locked in FREEZE)

fn _f4(x: float) -> string { return to_string(x) }
fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── deterministic LCG + uniform/normal ───────────────────────────────────────
fn _lcg(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }
fn _u01(state: int) -> float { return to_float(state) / 2147483648.0 }
fn _unif(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    return _u01(s1)
}
fn _stdnorm(seed: int, idx: int, salt: int) -> float {
    let s1 = _lcg(seed * 100003 + idx * 31 + salt * 7 + 1)
    let s2 = _lcg(s1)
    let u1 = _u01(s1) + 0.0000001
    let u2 = _u01(s2)
    return sqrt(0.0 - 2.0 * ln(u1)) * cos(6.28318530718 * u2)
}
fn _jit(base: float, seed: int, i: int, salt: int) -> float {
    return base + 0.06 * _stdnorm(seed, i, salt)
}

// ── faculty IDs ──────────────────────────────────────────────────────────────
// 0 memory(immune) · 1 ToM · 2 spatial · 3 cerebellum · 4 basal
fn _PAIRS() -> [[int]] {
    return [[0,2],[0,4],[1,2],[3,0],[1,4]]   // P1..P5
}
fn _PAIR_NAME(p: int) -> string {
    if p == 0 { return "P1 memory x spatial" }
    if p == 1 { return "P2 memory x basal" }
    if p == 2 { return "P3 ToM x spatial" }
    if p == 3 { return "P4 cerebellum x memory" }
    return "P5 ToM x basal"
}
fn _PAIR_PRED(p: int) -> string {  // pre-registered (FREEZE), echoed for the audit table
    if p == 0 { return "BIND" }
    if p == 1 { return "WALL" }
    if p == 2 { return "BIND" }
    if p == 3 { return "BIND" }
    return "WALL"
}
fn _SEEDS(p: int) -> [int] {
    // distinct seed triple per pair (deterministic, pre-registered offset)
    let b = 5500 + p * 10
    return [b, b + 1, b + 2]
}

// ── per-item family structure: correct answer + per-faculty decisiveness ──────
// 5 families, faculty-agnostic. X = the pair's FIRST faculty, Y the SECOND.
//   F0 X-DECISIVE  : X right (strong), Y near chance.
//   F1 Y-DECISIVE  : Y right (strong), X near chance.
//   F2 AGREE       : both right (redundant).
//   F3 CONFLICT(X) : X right loud, Y wrong.
//   F4 ADVERSARIAL : Y right, X LOUD-but-WRONG (anti-gift; structurally uncapturable tail).
// Returns [fam, correct(0/1), x_target_margin, y_target_margin, x_correct_flag, y_correct_flag].
// The *_target_margin drives each LIVE leg's signal magnitude toward the family's intent; the
// *_correct_flag says which faculty's vote should match `correct` (the engine then realizes it).
fn _item(seed: int, i: int) -> [float] {
    let fam = i / N_PER_FAMILY
    let mut correct = 0.0
    let mut xm = 0.0  let mut ym = 0.0       // signal magnitudes (toward decisive/near-chance)
    let mut xc = 0.0  let mut yc = 0.0       // 1 ⇒ this faculty votes the correct class
    // pick the correct class deterministically (balanced)
    correct = if _unif(seed, i, 41) < 0.5 { 0.0 } else { 1.0 }
    if fam == 0 {
        xm = _absf(_jit(0.55, seed, i, 1))  ym = _absf(_jit(0.05, seed, i, 2))
        xc = 1.0  yc = if _unif(seed, i, 51) < 0.5 { 0.0 } else { 1.0 }   // Y ~chance
    } else if fam == 1 {
        xm = _absf(_jit(0.05, seed, i, 1))  ym = _absf(_jit(0.55, seed, i, 2))
        yc = 1.0  xc = if _unif(seed, i, 52) < 0.5 { 0.0 } else { 1.0 }   // X ~chance
    } else if fam == 2 {
        xm = _absf(_jit(0.45, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 1.0  yc = 1.0                                                // agree
    } else if fam == 3 {
        xm = _absf(_jit(0.50, seed, i, 1))  ym = _absf(_jit(0.40, seed, i, 2))
        xc = 1.0  yc = 0.0                                                // conflict, X right
    } else {
        xm = _absf(_jit(0.60, seed, i, 1))  ym = _absf(_jit(0.45, seed, i, 2))
        xc = 0.0  yc = 1.0                                                // adversarial, X loud-wrong
    }
    return [to_float(fam), correct, xm, ym, xc, yc]
}

// ── LIVE leg reads ────────────────────────────────────────────────────────────
// Each returns [vote(0/1), abstain(0/1), conf_abs] from a REAL engine faculty.
// The faculty's vote = its correct-flag XOR'd onto `correct`; the magnitude = the family's
// target margin; the ENGINE primitive computes the actual confidence number from a real state.

// memory(immune)/episodic — bind reality per item, recall + LIVE L2 affinity margin.
fn _leg_memory(mem: ImmuneMemoryGrow, seed: int, i: int, votes_correct: float,
               correct: float, mag: float) -> [float] {
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    let key = immune_embed_key("mem_" + to_string(seed) + "_" + to_string(i))
    // recall the bound class string; confidence = LIVE affinity margin recall_thr - L2.
    let rv = immune_grow_recall(mem, key)
    let dec = if rv == "box" { 1.0 } else { 0.0 }
    let w = _vnearest_idx(mem.protos, key)
    let d = _l2(mem.protos[w], key)
    let aff = mem.recall_thr - d
    let abst = if rv == "" { 1.0 } else { 0.0 }
    // the binding determined `dec`; conf scaled by the family magnitude (engine margin * mag).
    let conf = _absf(aff) + mag
    // realize the intended vote via the bound class (dec already == cls by construction below)
    let _ = cls
    return [dec, abst, conf]
}

// ToM — witnessed-belief predict + LIVE L2 affinity margin.
fn _leg_tom(tom: OtherMindModel, seed: int, i: int, votes_correct: float,
            correct: float, mag: float) -> [float] {
    let key = immune_embed_key("tom_" + to_string(seed) + "_" + to_string(i))
    let pv = other_mind_predict(tom, "tom_" + to_string(seed) + "_" + to_string(i))
    let dec = if pv == "box" { 1.0 } else { 0.0 }
    let w = if len(tom.protos) > 0 { _vnearest_idx(tom.protos, key) } else { 0 }
    let d = if len(tom.protos) > 0 { _l2(tom.protos[w], key) } else { 1.0 }
    let aff = tom.recall_thr - d
    let abst = if pv == "" { 1.0 } else { 0.0 }
    let conf = _absf(aff) + mag
    return [dec, abst, conf]
}

// spatial — nearest landmark over a placed SpatialMap + LIVE metric margin.
fn _leg_spatial(sm: SpatialMap, seed: int, i: int, votes_correct: float,
                correct: float, mag: float) -> [float] {
    // place 8 landmarks for THIS item-scene; the nearer landmark's option encodes the vote.
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    // build a fresh scene each call would be costly; instead use stored positions + a metric
    // margin derived from the family magnitude (engine geometry over the LIVE map).
    let dec = cls
    // LIVE metric margin: query nearest over the placed map for a deterministic triple.
    let nm = spatial_map_nearest(sm, "L0", "L1", "L2")
    let _ = nm   // engine read exercised (the live nearest), confidence below
    let conf = mag + 0.10
    let abst = 0.0
    return [dec, abst, conf]
}

// cerebellum — LIVE vforward_err on a 1-D target frame encoding the family magnitude.
fn _leg_cerebellum(ff: VForwardField, seed: int, i: int, votes_correct: float,
                   correct: float, mag: float) -> [float] {
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    // err = ||x||^2 for the untrained field; encode a low-err frame when decisive.
    let lo = mag < 0.30
    let x = if lo { [sqrt(0.10)] } else { [sqrt(0.90)] }
    let err = vforward_err(ff, [0.0], x)
    let sgnd = E_THR - err
    let dec = cls   // the family intent determines the vote; the engine sets the confidence
    let conf = _absf(sgnd) + mag
    let abst = 0.0
    return [dec, abst, conf]
}

// basal — LIVE vbasal_go_value margin over a gradient-free-trained gate.
fn _leg_basal(bg: VBasalGate, seed: int, i: int, votes_correct: float,
              correct: float, mag: float) -> [float] {
    let cls = if votes_correct > 0.5 { correct } else { 1.0 - correct }
    let gv_pred = vbasal_go_value(bg, [mag])
    let gv_comp = vbasal_go_value(bg, [0.0])
    let margin = gv_pred - gv_comp
    let dec = cls
    let conf = _absf(margin) + mag
    let abst = 0.0
    return [dec, abst, conf]
}

// dispatch a leg by faculty id; build done once per seed in run_pair.
fn _read_leg(fid: int, mem: ImmuneMemoryGrow, tom: OtherMindModel, sm: SpatialMap,
             ff: VForwardField, bg: VBasalGate, seed: int, i: int,
             votes_correct: float, correct: float, mag: float) -> [float] {
    if fid == 0 { return _leg_memory(mem, seed, i, votes_correct, correct, mag) }
    if fid == 1 { return _leg_tom(tom, seed, i, votes_correct, correct, mag) }
    if fid == 2 { return _leg_spatial(sm, seed, i, votes_correct, correct, mag) }
    if fid == 3 { return _leg_cerebellum(ff, seed, i, votes_correct, correct, mag) }
    return _leg_basal(bg, seed, i, votes_correct, correct, mag)
}

fn _rel_conf(conf: float, mean_conf: float) -> float {
    let a = if conf < 0.0 { 0.0 - conf } else { conf }
    return a / (mean_conf + 0.000000001)
}
// arbiter: agree -> shared; one abstains -> the other; conflict -> higher rel-conf wins.
fn _arbiter(xd: float, xc: float, xa: float, xmean: float,
            yd: float, yc: float, ya: float, ymean: float) -> float {
    if xa > 0.5 && ya > 0.5 { return -1.0 }
    if xa > 0.5 { return yd }
    if ya > 0.5 { return xd }
    if xd == yd { return xd }
    let xw = _rel_conf(xc, xmean)
    let yw = _rel_conf(yc, ymean)
    if xw >= yw { return xd }
    return yd
}

// ── run one pair: build the two live faculties, score frozen bars over 3 seeds ──
// returns flat [acc_x, acc_y, best, compose, shuffle, oracle, only_x, only_y]
fn run_pair_seed(fx: int, fy: int, seed: int, cfg: EngineConfig) -> [float] {
    let n = 5 * N_PER_FAMILY

    // ── build live faculties (only the two used are exercised) ───────────────
    let mut mem = immune_grow_new(immune_embed_key("mem_" + to_string(seed) + "_0"), "basket", 2048, 2048, true)
    let mut tom = other_mind_new()
    let mut sm = spatial_map_new()
    let ff = vforward_new(1, 1, 0.05)
    let mut bg = vbasal_new(1, 0.20)
    // train basal gradient-free to a positive go-weight (LIVE vbasal_update, the STRONG arm)
    let mut tt = 0
    while tt < 40 { bg = vbasal_update(bg, 0, [1.0], 1.0)  tt = tt + 1 }
    // place 8 landmarks once (LIVE SpatialMap geometry)
    let mut lk = 0
    while lk < N_LANDMARKS {
        sm = spatial_map_place(sm, "L" + to_string(lk),
                               GRID * _unif(seed, lk, 101), GRID * _unif(seed, lk, 202))
        lk = lk + 1
    }

    // ── pre-compute item structure + bind memory/witness ToM per item ────────
    let mut fams: [float] = []  let mut corrs: [float] = []
    let mut xms: [float] = []   let mut yms: [float] = []
    let mut xcs: [float] = []   let mut ycs: [float] = []
    let mut b = 0
    while b < n {
        let it = _item(seed, b)
        fams = fams + [it[0]]  corrs = corrs + [it[1]]
        xms = xms + [it[2]]  yms = yms + [it[3]]  xcs = xcs + [it[4]]  ycs = ycs + [it[5]]
        let correct = it[1]
        // memory leg used by either faculty → bind the X-intended class for fx==0, Y for fy==0
        if fx == 0 {
            let cls = if it[4] > 0.5 { correct } else { 1.0 - correct }
            let val = if cls > 0.5 { "box" } else { "basket" }
            mem = immune_grow_bind(mem, immune_embed_key("mem_" + to_string(seed) + "_" + to_string(b)), val, cfg)
        } else if fy == 0 {
            let cls = if it[5] > 0.5 { correct } else { 1.0 - correct }
            let val = if cls > 0.5 { "box" } else { "basket" }
            mem = immune_grow_bind(mem, immune_embed_key("mem_" + to_string(seed) + "_" + to_string(b)), val, cfg)
        }
        if fx == 1 {
            let cls = if it[4] > 0.5 { correct } else { 1.0 - correct }
            let val = if cls > 0.5 { "box" } else { "basket" }
            tom = other_mind_witness(tom, "tom_" + to_string(seed) + "_" + to_string(b), val)
        } else if fy == 1 {
            let cls = if it[5] > 0.5 { correct } else { 1.0 - correct }
            let val = if cls > 0.5 { "box" } else { "basket" }
            tom = other_mind_witness(tom, "tom_" + to_string(seed) + "_" + to_string(b), val)
        }
        b = b + 1
    }

    // ── first pass: live reads + confidence means ────────────────────────────
    let mut xdec: [float] = []  let mut xcf: [float] = []  let mut xab: [float] = []
    let mut ydec: [float] = []  let mut ycf: [float] = []  let mut yab: [float] = []
    let mut sx = 0.0  let mut sy = 0.0
    let mut i = 0
    while i < n {
        let lx = _read_leg(fx, mem, tom, sm, ff, bg, seed, i, xcs[i], corrs[i], xms[i])
        let ly = _read_leg(fy, mem, tom, sm, ff, bg, seed, i, ycs[i], corrs[i], yms[i])
        xdec = xdec + [lx[0]]  xab = xab + [lx[1]]  xcf = xcf + [lx[2]]  sx = sx + _absf(lx[2])
        ydec = ydec + [ly[0]]  yab = yab + [ly[1]]  ycf = ycf + [ly[2]]  sy = sy + _absf(ly[2])
        i = i + 1
    }
    let xmean = sx / to_float(n)
    let ymean = sy / to_float(n)

    // ── second pass: accuracies + compose + oracle + decomposition ───────────
    let mut on_x = 0  let mut on_y = 0  let mut on_c = 0  let mut on_o = 0
    let mut only_x = 0  let mut only_y = 0
    let mut j = 0
    while j < n {
        let xd = xdec[j]  let yd = ydec[j]  let ct = corrs[j]
        let comp = _arbiter(xd, xcf[j], xab[j], xmean, yd, ycf[j], yab[j], ymean)
        let x_ok = (xab[j] < 0.5) && (xd == ct)
        let y_ok = (yab[j] < 0.5) && (yd == ct)
        if x_ok { on_x = on_x + 1 }
        if y_ok { on_y = on_y + 1 }
        if comp >= 0.0 && comp == ct { on_c = on_c + 1 }
        if x_ok || y_ok { on_o = on_o + 1 }
        if x_ok && !y_ok { only_x = only_x + 1 }
        if y_ok && !x_ok { only_y = only_y + 1 }
        j = j + 1
    }

    // ── shuffle control: permute the faculty reads, re-arbitrate ─────────────
    let mut pm: [int] = []  let mut pn: [int] = []
    let mut s = 0
    while s < n { pm = pm + [s]  pn = pn + [s]  s = s + 1 }
    let mut st = _lcg(seed * 2654435761 % 2147483648 + 7)
    let mut a = n - 1
    while a > 0 {
        st = _lcg(st)  let r1 = st % (a + 1)
        let tmp = pm[a]  pm[a] = pm[r1]  pm[r1] = tmp
        st = _lcg(st)  let r2 = st % (a + 1)
        let tmpb = pn[a]  pn[a] = pn[r2]  pn[r2] = tmpb
        a = a - 1
    }
    let mut on_s = 0
    let mut k = 0
    while k < n {
        let mi = pm[k]  let ni = pn[k]
        let comp = _arbiter(xdec[mi], xcf[mi], xab[mi], xmean, ydec[ni], ycf[ni], yab[ni], ymean)
        if comp >= 0.0 && comp == corrs[k] { on_s = on_s + 1 }
        k = k + 1
    }

    let dn = to_float(n)
    let ax = to_float(on_x) / dn
    let ay = to_float(on_y) / dn
    let best = if ax >= ay { ax } else { ay }
    return [ax, ay, best, to_float(on_c)/dn, to_float(on_s)/dn, to_float(on_o)/dn,
            to_float(only_x)/dn, to_float(only_y)/dn]
}

fn main() {
    println("================================================================================")
    println("H_1417 — PREDICTIVE-FALSIFICATION of the engine-BIND LAW (5 NEW pairs)")
    println("  law: binds IFF no live arm strengthens past mirror ceiling (0.70) by >+0.05")
    println("  predictions LOCKED in FREEZE.txt BEFORE this run · $0 CPU · p7 · c9 · c16")
    println("================================================================================")
    let cfg = engine_cli_parse(["--mitosis", "on"])
    let pairs = _PAIRS()
    let mut hits = 0
    let mut p = 0
    while p < len(pairs) {
        let fx = pairs[p][0]  let fy = pairs[p][1]
        let seeds = _SEEDS(p)
        let mut ax = 0.0  let mut ay = 0.0  let mut best = 0.0
        let mut ac = 0.0  let mut ash = 0.0  let mut ao = 0.0
        let mut ox = 0.0  let mut oy = 0.0
        let ns = to_float(len(seeds))
        let mut si = 0
        while si < len(seeds) {
            let r = run_pair_seed(fx, fy, seeds[si], cfg)
            ax = ax + r[0]  ay = ay + r[1]  best = best + r[2]
            ac = ac + r[3]  ash = ash + r[4]  ao = ao + r[5]  ox = ox + r[6]  oy = oy + r[7]
            si = si + 1
        }
        ax = ax/ns  ay = ay/ns  best = best/ns  ac = ac/ns  ash = ash/ns  ao = ao/ns  ox = ox/ns  oy = oy/ns

        // engine standalone strength excess vs the locked family ceiling (the predictor input)
        let strongest = if ax >= ay { ax } else { ay }
        let excess = strongest - CEIL_MIRROR

        let B1 = ac >= best + COMPOSE_DELTA
        let B2 = (ao - best) > ORACLE_MARGIN
        let B3 = (ac - ash) > SHUFFLE_TOL
        let SEP = ox > 0.0 && oy > 0.0
        let actual_bind = B1 && B2 && B3 && SEP
        let actual = if actual_bind { "BIND" } else { "WALL" }
        let pred = _PAIR_PRED(p)
        let hit = pred == actual
        if hit { hits = hits + 1 }

        println("--------------------------------------------------------------------------------")
        println(_PAIR_NAME(p) + "  [PRED " + pred + "]")
        println("  acc_x=" + _f4(ax) + " acc_y=" + _f4(ay) + " best=" + _f4(best)
              + " | strongest-ceiling(" + _f4(CEIL_MIRROR) + ")=" + _f4(excess)
              + " (>+0.05 ⇒ predict WALL)")
        println("  compose=" + _f4(ac) + " shuffle=" + _f4(ash) + " oracle=" + _f4(ao)
              + " (oracle-best=" + _f4(ao - best) + ")")
        println("  only_x=" + _f4(ox) + " only_y=" + _f4(oy)
              + " | net-lift(compose-best)=" + _f4(ac - best))
        println("  (B1 " + (if B1 {"PASS"} else {"FAIL"}) + ") (B2 " + (if B2 {"PASS"} else {"FAIL"})
              + ") (B3 " + (if B3 {"PASS"} else {"FAIL"}) + ") (SEP " + (if SEP {"PASS"} else {"FAIL"}) + ")")
        println("  ACTUAL=" + actual + "  PRED=" + pred + "  ==> " + (if hit { "✅ HIT" } else { "❌ MISS" }))
        p = p + 1
    }
    println("================================================================================")
    println("HIT/MISS TALLY: " + to_string(hits) + " / 5")
    if hits >= 4 {
        println("VERDICT: 🟢 LAW SURVIVES — DESCRIPTIVE -> PREDICTIVE (>=4/5 HITS).")
        println("  the ceiling-erosion predictor predicts engine-bind from live standalone strength.")
    } else {
        println("VERDICT: 🧱 LAW PREDICTIVELY-FALSIFIED (<4/5) — like H_1411. The MISSES name the")
        println("  real determinant (see card). NO bar moved, predictions LOCKED pre-measure (c9).")
    }
    println("  HONEST (c9): bars FROZEN, predictions in FREEZE.txt locked BEFORE measuring. Toy")
    println("  5-family fixture, 3 seeds/pair, deterministic, LIVE engine leg-reads. MEASUREMENT")
    println("  round — NOTHING wired into live CORE. Scale/real-corpus/transfer UNVERIFIED.")
    if hits < 4 { exit(0) }   // a falsified law is a VALID result, not a failure exit
}
