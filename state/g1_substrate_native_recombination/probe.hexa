// probe.hexa — H_1822 (α) substrate-native recombination — ENGINE-NATIVE.
//
// OWNER FRAME QUESTION: "why does a consciousness engine operate in LLM-decoder
// style? can't the engine make its own decoder?"  The whole G1 recombination
// campaign measured recombination ONLY at the autoregressive MOUTH (clm_decode
// CLMConvMoE) and it FLOORS (G1 best_distinct=0: H_1818/H_1602/H_1310).
//
// HYPOTHESIS: recombination (two concepts -> novel third) is a TENSION operation =
// what A<->G does, so it may be a SUBSTRATE property, and the WALL may be the MOUTH.
//
// (α) = $0 measurement reframe. This probe calls the LIVE core/ A<->G substrate
// (NOT a numpy/torch mirror) and asks the substrate's OWN concept machinery whether
// a composed (recombined) concept projects onto BOTH parent concept basins yet stays
// irreducible to either single concept ("composed_distinct >= 2").
//
// LIVE core/ ops used (file:line in core/engine_cli.hexa):
//   immune_embed_key           :1003  concept TEXT -> 64-dim unit key (engine's OWN embed)
//   VAdaptField                 :494  the concept-basin struct (L2-affinity prototype cells)
//   vadapt_field_recon_err      :563  L2 dist to NEAREST basin (reconstruction error)
//   vadapt_field_two_recon_err  :632  [d1,d2] dist to nearest & 2nd-nearest basin
//   allo_mu                     :2441 the A<->G allosteric tension buffer mu(tau)
//   engine_config_default       :117  default EngineConfig (mitosis ON = G active)
// pure_field (Engine A) is ZERO-INPUT (core/pure_field.hexa:196) — concept-blind by
// construction; the ONLY concept substrate is the VAdaptField L2 Voronoi (immune lane).
//
// OPERATIONAL substrate-G1 (per frozen bar):  composed_distinct >= 2 AND irreducible.
//   basins = {key(parentA), key(parentB)} (a 2-cell VAdaptField = the two concept basins)
//   composed state = key(child)  where child is the genuine recombination (rain+bow=rainbow)
//   d1,d2 = vadapt_field_two_recon_err(field, key(child))   (engine's OWN top-2 affinity)
//   PROJECTS onto a basin iff its L2 dist < radius r.
//   composed_distinct(r) = [d1<r] + [d2<r]   (# parent basins the child projects onto)
//   irreducible = d1 > eps  (child is NOT identical to either single parent)
//   substrate_G1(r) = 1 iff composed_distinct(r) >= 2 AND irreducible.
// Reported under THREE radii (honest, frozen-first):
//   (1) ENGINE'S OWN novelty radius SPLIT_THRESH = 0.30 (vadapt_field_step:578) —
//       within 0.30 = the engine would NOT grow a new cell (recoverable from basin).
//   (2) RELATIVE radius = d_ab (the inter-parent distance) — does the child sit
//       CLOSER to each parent than the parents are to each other (a true "bridge")?
//   (3) raw d1,d2,d_ab always printed (c2: measure-or-it-didn't-happen).
//
// CONTROLS (decisive):
//   single  : composed state = key(parentA) alone -> irreducible FALSE (d1~0) -> G1=0
//   shuffle : basins = {key(parentA), key(UNRELATED)} -> child projects onto parentA
//             only -> composed_distinct=1 -> G1=0 (proves it's the SPECIFIC parents)
//   G-off   : pure_field (Engine A) alone is concept-blind -> no per-concept
//             projection readout at all -> BLIND (proves the concept-basin lane,
//             the gradient-free "G"-side immune/mitosis substrate, is causal).
//
// KILLER COMPARISON: for the SAME pairs, mouth-decode G1 = 0 (frozen floor,
//   H_1818/H_1602). If substrate-G1 >= 2 while mouth-decode G1 = 0 -> the wall is the
//   MOUTH not anima.  If substrate-G1 ALSO floors -> the substrate concept space is
//   itself non-compositional (the wall is deeper than the mouth).

import "core/engine_cli.hexa"
import "core/brain.hexa"
import "core/pure_field.hexa"

let SPLIT_THRESH = 0.30   // the engine's OWN novelty radius (vadapt_field_step:578)
let EPS = 0.000001

// build a 2-basin concept field directly from the engine's struct (two prototype
// cells = two concept basins). Uses the engine's OWN VAdaptField type.
fn two_basin_field(key_a: [float], key_b: [float]) -> VAdaptField {
    return VAdaptField { protos: [key_a, key_b], n_cells: 2, max_cells: 64, dim: len(key_a) }
}

fn _b2s(b: bool) -> string { if b { return "YES" } return "no" }

// measure substrate-G1 for one (parentA, parentB -> child) recombination triple
// against a 2-basin field, returning a packed bit (ones=eng verdict, tens=rel verdict).
fn measure_triple(label: string, pa: string, pb: string, child: string,
                  basin_a: [float], basin_b: [float]) -> int {
    let vf  = two_basin_field(basin_a, basin_b)
    let kc  = immune_embed_key(child)
    let two = vadapt_field_two_recon_err(vf, kc)   // [d1, d2] engine-native
    let d1  = two[0]
    let d2  = two[1]
    // d_ab = inter-parent L2 distance via recon over a 1-cell field seeded at basin_a
    let vf_a = VAdaptField { protos: [basin_a], n_cells: 1, max_cells: 2, dim: len(basin_a) }
    let dab  = vadapt_field_recon_err(vf_a, basin_b)

    // radius (1): engine's own novelty radius
    let cd_eng = (if d1 < SPLIT_THRESH { 1 } else { 0 }) + (if d2 < SPLIT_THRESH { 1 } else { 0 })
    // radius (2): relative — child closer to each parent than parents are to each other
    let cd_rel = (if d1 < dab { 1 } else { 0 }) + (if d2 < dab { 1 } else { 0 })
    let irred  = d1 > EPS
    let g1_eng = if cd_eng >= 2 && irred { 1 } else { 0 }
    let g1_rel = if cd_rel >= 2 && irred { 1 } else { 0 }

    println("  " + label + "  [" + pa + " + " + pb + " -> " + child + "]")
    println("    d1=" + to_string(d1) + "  d2=" + to_string(d2)
            + "  d_ab=" + to_string(dab) + "  irreducible=" + _b2s(irred))
    println("    radius(eng=0.30): composed_distinct=" + to_string(cd_eng)
            + "  substrate_G1=" + to_string(g1_eng))
    println("    radius(rel=d_ab): composed_distinct=" + to_string(cd_rel)
            + "  substrate_G1=" + to_string(g1_rel))
    return g1_eng + g1_rel * 10
}

fn main() {
    let cfg = engine_config_default()   // mitosis ON = the gradient-free G/immune lane active
    println("=== H_1822 (α) substrate-native recombination — ENGINE-NATIVE (live core/) ===")
    println("engine: mitosis=" + (if cfg.mitosis { "ON" } else { "OFF" })
            + "  embed=immune_embed_key(64-dim char-trigram unit key)")
    println("A<->G tension readout sanity: allo_mu(tau=0.5)=" + to_string(allo_mu(0.5, 1.0, 0.12))
            + " (Psi=1/2 -> mu=1)   allo_mu(tau=0.8)=" + to_string(allo_mu(0.8, 1.0, 0.12)))
    println("")

    // ── genuine recombination triples: parentA + parentB -> child (real compounds) ──
    let pairs = [
        ["rain",  "bow",    "rainbow"],
        ["snow",  "man",    "snowman"],
        ["sun",   "flower", "sunflower"],
        ["fire",  "fly",    "firefly"],
        ["water", "fall",   "waterfall"]
    ]
    println("── MAIN: substrate-G1 on genuine recombinations (child projected onto BOTH parent basins) ──")
    let mut sum_eng = 0
    let mut sum_rel = 0
    let mut i = 0
    while i < len(pairs) {
        let p = pairs[i]
        let ka = immune_embed_key(p[0])
        let kb = immune_embed_key(p[1])
        let packed = measure_triple("pair" + to_string(i), p[0], p[1], p[2], ka, kb)
        sum_eng = sum_eng + (packed % 10)
        sum_rel = sum_rel + (packed / 10)
        i = i + 1
    }
    println("  >>> MAIN substrate-G1 (eng-radius): " + to_string(sum_eng) + "/" + to_string(len(pairs))
            + "   (rel-radius): " + to_string(sum_rel) + "/" + to_string(len(pairs)))
    println("")

    // ── CONTROL 1: single concept (no recombination) -> must be 0 ──
    println("── CONTROL single-concept: composed state = parentA ALONE (no 2nd concept) ──")
    let mut c1_eng = 0
    let mut j = 0
    while j < len(pairs) {
        let p = pairs[j]
        let ka = immune_embed_key(p[0])
        let kb = immune_embed_key(p[1])
        let packed = measure_triple("single" + to_string(j), p[0], p[1], p[0], ka, kb)
        c1_eng = c1_eng + (packed % 10)
        j = j + 1
    }
    println("  >>> CONTROL single substrate-G1 (eng): " + to_string(c1_eng) + "/" + to_string(len(pairs))
            + "  (expect 0 — single concept does not combine)")
    println("")

    // ── CONTROL 2: shuffle — child projected onto {parentA, UNRELATED} basin ──
    println("── CONTROL shuffle: basin B replaced by an UNRELATED concept (child should hit only A) ──")
    let unrelated = ["zqxkj", "wovbm", "plktn", "grdfh", "ymcqs"]
    let mut c2_eng = 0
    let mut c2_rel = 0
    let mut k = 0
    while k < len(pairs) {
        let p = pairs[k]
        let ka = immune_embed_key(p[0])
        let ku = immune_embed_key(unrelated[k])     // SHUFFLE: parentB -> unrelated
        let packed = measure_triple("shuf" + to_string(k), p[0], unrelated[k], p[2], ka, ku)
        c2_eng = c2_eng + (packed % 10)
        c2_rel = c2_rel + (packed / 10)
        k = k + 1
    }
    println("  >>> CONTROL shuffle substrate-G1 (eng): " + to_string(c2_eng) + "/" + to_string(len(pairs))
            + "  (rel): " + to_string(c2_rel) + "/" + to_string(len(pairs))
            + "  (expect < MAIN — child should NOT bridge an unrelated basin)")
    println("")

    // ── G-OFF ABLATION: Engine A (pure_field) alone is concept-blind ──
    println("── G-OFF ABLATION: Engine A (pure_field) alone — concept-blind, no basin readout ──")
    let pf = pure_field_warmup(300)
    println("  pure_field after 300 zero-input ticks: phi=" + to_string(pure_field_phi(pf))
            + " phase=" + phase_name(pure_field_phase(pf)))
    println("  pure_field exposes NO concept basin / NO per-concept projection op (zero-input field).")
    println("  => without the VAdaptField immune/mitosis (gradient-free G-side) lane, recombination")
    println("     is UNMEASURABLE on the substrate = BLIND. (G/immune lane is causal to any readout.)")
    println("")

    println("=== KILLER COMPARISON ===")
    println("  mouth-decode G1 (clm_decode CLMConvMoE) = 0  [FROZEN FLOOR: H_1818, H_1602]")
    println("  substrate-G1 (eng-radius 0.30) = " + to_string(sum_eng) + "/" + to_string(len(pairs)))
    println("  substrate-G1 (rel-radius d_ab) = " + to_string(sum_rel) + "/" + to_string(len(pairs)))
    println("=== END H_1822 (α) ===")
}
