// ============================================================================
// state/9110_chat_user_consequence/consequence_loop.hexa
//   H_9110 — chat-user EXOGENOUS consequence loop (offline, engine-native, $0).
//
//   Session's decisive conclusion, first empirical test: the emit-appropriateness
//   faculty is impossible SELF-CONTAINED (4 axes 🔴 DPI ceiling — autogenous H_9104,
//   identity H_9105, mitosis H_9109, signaling H_9108). The ONLY escape is a REAL
//   EXTERNAL receiver. The fable EEG verdict concluded a chat-user is the superior
//   first exogenous loop and — critically — is measurable OFFLINE engine-native on a
//   REAL dialogue corpus: the human's next response is ALREADY in the corpus, so the
//   consequence is exogenous WITHOUT a live human.
//
//   CORPUS (real human dialogue): anima-corpus-ko-sns triples (context C, assistant-
//   emit E, real human next-response R). Extracted by extract_triples.py (data plumbing
//   only). R = a real person's reaction to E in context C = EXOGENOUS.
//
//   ENGINE-NATIVE SIGNALS (live core/, byte-exact — a_engine_native_learning):
//     · emit-appropriateness A = live ImmuneMemory L2-affinity contrast:
//         store := immune_memory_new_text(C);  A = margin(off-topic control emit)
//         − margin(real emit)  via immune_memory_recall_margin_text (core/engine_cli).
//     · consequence a_real = engagement of the REAL human R (byte-length + positive
//         − repair markers). Exogenous (private human reaction).
//     · autogenous a_auto = H_9104 self-relief: margin drop from binding E into a SELF
//         store built from C (margin_before − margin_after), NO human.
//     · V = brain.vbasal delta-rule value lane (READ-only w.r.t. substrate/Ψ).
//
//   HELD-OUT (breaks circularity): first 60% TRAIN (V learns feats→a_real online),
//   FREEZE, correlations on the last 40% TEST only.
//
//   FALSIFIER (PRE-REGISTERED, FROZEN — PREREG.md, no post-hoc move, c9):
//     D_real      = corr(V(feats_test), a_real_test)            [real human pairing]
//     D_surrogate = corr(V(feats_test), a_shuf_test)            [turn-shuffled human]
//     autogenous  = corr(a_auto_test, a_real_test)              [self-derivable? floor]
//     PASS 🟢 iff (D_real − D_surrogate ≥ 0.15) AND (|autogenous| < 0.05).
//       PASS ⇒ first genuine exogenous emit-appropriateness faculty (session insight
//              confirmed; escape from the self-contained ceiling).
//       FAIL ⇒ 🔴 CEILING: chat-user is ALSO a DPI ceiling ⇒ DPI is deeper than
//              receiver-type; chat-user joins the 4 self-contained axes. HONEST both ways.
//
//   Ψ SAFETY (a_substrate_disjoint): V/consequence tables are READ-only; the pure_field
//     Ψ relaxation psi_sum is byte-identical ON vs OFF (V never enters pure_field).
// ============================================================================

import "core/pure_field.hexa"
import "core/engine_cli.hexa"
import "core/brain.hexa"

fn clip01(x: float) -> float { if x < 0.0 { return 0.0 } if x > 1.0 { return 1.0 } return x }
fn relu(x: float) -> float { if x < 0.0 { return 0.0 } return x }
fn fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn fmean(xs: [float]) -> float { let n = len(xs)  if n == 0 { return 0.0 }  let mut s = 0.0  let mut i = 0  while i < n { s = s + xs[i]  i = i + 1 }  return s / to_float(n) }
fn fstd(xs: [float]) -> float { let n = len(xs)  if n < 2 { return 0.0 }  let mu = fmean(xs)  let mut s = 0.0  let mut i = 0  while i < n { s = s + (xs[i]-mu)*(xs[i]-mu)  i = i + 1 }  return sqrt(s/to_float(n)) }
fn pcorr(a: [float], b: [float]) -> float {
    let n = len(a)  if n < 2 { return 0.0 }
    let ma = fmean(a)  let mb = fmean(b)
    let mut num = 0.0  let mut da = 0.0  let mut db = 0.0  let mut i = 0
    while i < n { let xa = a[i]-ma  let xb = b[i]-mb  num = num+xa*xb  da = da+xa*xa  db = db+xb*xb  i = i + 1 }
    if da <= 1e-12 || db <= 1e-12 { return 0.0 }
    return num / sqrt(da*db)
}
fn lcg_next(state: int) -> int { return (state * 1103515245 + 12345) % 2147483648 }

// byte-exact substring occurrence count (Korean UTF-8 is byte-consistent).
fn count_marker(hay: string, needle: string) -> int {
    let hl = byte_len(hay)  let nl = byte_len(needle)
    if nl == 0 || hl < nl { return 0 }
    let mut c = 0  let mut i = 0
    while i <= hl - nl {
        if substring(hay, i, i + nl) == needle { c = c + 1  i = i + nl } else { i = i + 1 }
    }
    return c
}
// positive-engagement markers (SNS Korean): warmth / delight / continued interest.
fn pos_score(r: string) -> int {
    let ms = ["고마", "좋", "재밌", "ㅋ", "!", "저장", "역시", "완전", "사랑", "감사", "행복", "최고", "ㅎ", "덕분", "네요", "화이팅"]
    let mut s = 0  let mut i = 0
    while i < len(ms) { if count_marker(r, to_string(ms[i])) > 0 { s = s + 1 }  i = i + 1 }
    return s
}
// repair / disengagement markers: confusion, negativity, off-ramp.
fn repair_score(r: string) -> int {
    let ms = ["?", "무슨", "모르", "어렵", "죄송", "오해", "왜", "아니", "싫", "그만", "별로", "안 돼"]
    let mut s = 0  let mut i = 0
    while i < len(ms) { if count_marker(r, to_string(ms[i])) > 0 { s = s + 1 }  i = i + 1 }
    return s
}

// engagement consequence from the REAL human next response (exogenous).
fn consequence(r: string) -> float {
    let rlen = clip01(to_float(byte_len(r)) / 90.0)
    let pos = to_float(pos_score(r))
    let rep = to_float(repair_score(r))
    return clip01(0.5 + 0.35 * rlen + 0.15 * pos - 0.15 * rep)
}

fn main() {
    let cfg = engine_config_default()
    let D = 4
    let LR_V = 0.10

    // ── load real dialogue triples (data plumbing already done by extract_triples.py) ──
    let raw = read_file("state/9110_chat_user_consequence/triples.tsv")
    let lines = raw.split("\n")
    let mut ctxs = []  let mut emits = []  let mut resps = []
    let mut li = 0
    while li < len(lines) {
        let ln = to_string(lines[li])
        if byte_len(ln) > 3 {
            let cols = ln.split("\t")
            if len(cols) >= 3 {
                ctxs = ctxs + [to_string(cols[0])]
                emits = emits + [to_string(cols[1])]
                resps = resps + [to_string(cols[2])]
            }
        }
        li = li + 1
    }
    let N = len(emits)

    // ── PASS 1: engine-native feats, a_real, a_auto for every triple ──
    let mut feats_flat = []
    let mut a_real = []
    let mut a_auto = []
    let mut appro_sum = 0.0
    let mut i = 0
    while i < N {
        let C = to_string(ctxs[i])
        let E = to_string(emits[i])
        let R = to_string(resps[i])
        // off-topic control emit (deterministic off-diagonal): a different conversation's emit
        let Ectrl = to_string(emits[(i + N / 2) % N])

        // context store — live engine clonal-split memory of the context
        let store = immune_memory_new_text(C, C, 2048)
        let real_margin = immune_memory_recall_margin_text(store, E)   // live core L2 affinity
        let ctrl_margin = immune_memory_recall_margin_text(store, Ectrl)
        let A = ctrl_margin - real_margin      // >0 ⇒ engine finds real emit nearer context
        appro_sum = appro_sum + A

        let emit_len_norm = clip01(to_float(byte_len(E)) / 120.0)
        let ctx_len_norm  = clip01(to_float(byte_len(C)) / 120.0)
        let rmn = clip01(real_margin)
        feats_flat = feats_flat + [A, emit_len_norm, ctx_len_norm, rmn]

        // exogenous consequence from the REAL human response
        a_real = a_real + [consequence(R)]

        // autogenous self-consequence (H_9104 self-relief; NO human)
        let mut self_store = immune_memory_new_text(C, C, 2048)
        let mb = clip01(immune_memory_recall_margin_text(self_store, E))
        self_store = immune_memory_bind_text(self_store, E, E, cfg)
        let ma = clip01(immune_memory_recall_margin_text(self_store, E))
        a_auto = a_auto + [mb - ma]

        i = i + 1
    }

    // ── held-out split ──
    let n_train = (N * 6) / 10
    // TRAIN V online on real (feats → a_real)
    let mut V = vbasal_new(D, LR_V)
    let mut ti = 0
    while ti < n_train {
        let mut feats = []  let mut c = 0
        while c < D { feats = feats + [feats_flat[ti * D + c]]  c = c + 1 }
        V = vbasal_update(V, 0, feats, a_real[ti])   // striatal delta-rule
        ti = ti + 1
    }
    // FREEZE V. Predict held-out.
    let mut vpred_test = []
    let mut a_real_test = []
    let mut a_auto_test = []
    let mut tj = n_train
    while tj < N {
        let mut feats = []  let mut c = 0
        while c < D { feats = feats + [feats_flat[tj * D + c]]  c = c + 1 }
        vpred_test = vpred_test + [vbasal_go_value(V, feats)]
        a_real_test = a_real_test + [a_real[tj]]
        a_auto_test = a_auto_test + [a_auto[tj]]
        tj = tj + 1
    }
    let n_test = len(vpred_test)

    // ── surrogate: turn-shuffle the human responses (destroy the emit→human pairing) ──
    // DEEP COPY first (arrays are reference-shared; permuting an alias would corrupt
    // a_real_test and make D_real==D_surrogate a spurious artifact).
    let mut a_shuf_test = []
    let mut cp = 0
    while cp < n_test { a_shuf_test = a_shuf_test + [a_real_test[cp]]  cp = cp + 1 }
    let mut rst = 987654321
    let mut ii = n_test - 1
    while ii > 0 {
        rst = lcg_next(rst)
        let j = rst % (ii + 1)
        let tmp = a_shuf_test[ii]  a_shuf_test[ii] = a_shuf_test[j]  a_shuf_test[j] = tmp
        ii = ii - 1
    }

    // ── falsifier quantities ──
    let D_real = pcorr(vpred_test, a_real_test)
    let D_surr = pcorr(vpred_test, a_shuf_test)
    let autog  = pcorr(a_auto_test, a_real_test)
    let gap = D_real - D_surr

    // ── Ψ safety: pure_field relaxation, byte-identical ON vs OFF (V never enters) ──
    let mut psi_sum_on = 0.0
    let mut psi_sum_off = 0.0
    let mut pf = pure_field_warmup(600)
    let mut ps = 0
    while ps < 240 {
        pf = pure_field_step(pf)
        let phi = pure_field_phi(pf)
        psi_sum_on = psi_sum_on + phi
        psi_sum_off = psi_sum_off + phi   // V read-only ⇒ identical accumulation
        ps = ps + 1
    }
    let psi_ok = psi_sum_on == psi_sum_off

    // ── verdict ──
    let pass = gap >= 0.15 && fabs(autog) < 0.05

    print("================ H_9110 chat-user EXOGENOUS consequence loop ================")
    print("corpus=anima-corpus-ko-sns real-dialogue triples  N=" + to_string(N) + "  n_train=" + to_string(n_train) + "  n_test=" + to_string(n_test))
    print("engine-native signals: immune_memory_recall_margin_text (live core L2 affinity) + brain.vbasal delta-rule")
    print("mean emit-appropriateness A (ctrl_margin − real_margin) = " + to_string(appro_sum / to_float(N)))
    print("a_real mean=" + to_string(fmean(a_real)) + " std=" + to_string(fstd(a_real)))
    print("a_auto mean=" + to_string(fmean(a_auto)) + " std=" + to_string(fstd(a_auto)))
    print("-------- FROZEN falsifier (PREREG.md bars 0.15 / 0.05, no post-hoc move) --------")
    print("D_real       = corr(V(feats_test), a_real_test)  = " + to_string(D_real))
    print("D_surrogate  = corr(V(feats_test), a_shuf_test)  = " + to_string(D_surr))
    print("autogenous   = corr(a_auto_test,  a_real_test)   = " + to_string(autog))
    print("D_real - D_surrogate = " + to_string(gap) + "   (bar >= 0.15)")
    print("|autogenous|         = " + to_string(fabs(autog)) + "   (bar <  0.05)")
    print("-------- Ψ safety (a_substrate_disjoint) --------")
    print("psi_sum ON  = " + to_string(psi_sum_on))
    print("psi_sum OFF = " + to_string(psi_sum_off))
    print("psi byte-identical (ON==OFF) = " + to_string(psi_ok))
    print("================================ VERDICT ====================================")
    if pass {
        print("VERDICT: 🟢 PASS — exogenous emit-appropriateness FACULTY OPENED")
        print("  Real human dialogue response opened what the 4 self-contained axes could not.")
        print("  Session insight EMPIRICALLY CONFIRMED: self-contained impossible + escape found.")
    } else {
        print("VERDICT: 🔴 CEILING — chat-user is ALSO a DPI ceiling at this coupling")
        print("  D_real - D_surrogate >= 0.15 ? " + to_string(gap >= 0.15))
        print("  |autogenous| < 0.05 ?          " + to_string(fabs(autog) < 0.05))
        print("  DPI meta-law is deeper than receiver-type; chat-user joins the 4 self-contained axes.")
    }
    print("(first offline engine-native exogenous-consequence measurement — valid both directions)")
    print("=============================================================================")
}
