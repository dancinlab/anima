// H_9079 salience_phasic_reset ENGINE-NATIVE — mid-settle salience SPIKE aborts+restarts the A⇄G
// settle loop (LC-NE phasic reset / superior-colliculus attention capture) on live core/engine_cli.hexa.
// Content lane 7 (isolated in adj, disjoint from emit-drive lanes 0/4) carries each input's identity:
//   original x_i identity = 100+i ; salient sal_i identity = i. REROUTE tracks the NEW identity.
// Ψ=½ (emit-drive lanes 0/4) is PRESERVED across the reroute (loop control, NOT an emit gate).
// usage: hexa run state/9079_salience_phasic_reset/salience_reset_engine_native.hexa

import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

// build a 15-lane, 12-timestep population: 6 EMIT rows (coupled lanes=1.0, drive=1.0>=thr) + 6 SILENT
// rows (coupled lanes=0.0) => Ψ=½ ; content lane 7 = `ident` on every row (isolated => preserved).
fn _mk_pop(ident: float) -> [[float]] {
    let mut pop = []
    let mut t = 0
    while t < 12 {
        let emit = t < 6                         // first 6 emit, last 6 silent => Ψ=6/12=½
        let mut row = []
        let mut k = 0
        while k < 15 {
            let mut v = 0.0
            if k == 7 { v = ident }              // isolated content/identity lane
            else if emit { v = 1.0 }             // uniform emit-drive lanes => drive=1.0
            row = row + [v]
            k = k + 1
        }
        pop = pop + [row]
        t = t + 1
    }
    return pop
}

// 15x15 adjacency: chain over lanes {0..6} and {8..14}; lane 7 has ZERO degree (dangling => P=I under
// row-stochastic op=2) so the content/identity lane is graph-DISJOINT from emit-drive coupling.
fn _mk_adj() -> [[float]] {
    let mut a = []
    let mut i = 0
    while i < 15 {
        let mut row = []
        let mut j = 0
        while j < 15 {
            let mut v = 0.0
            // undirected chain edge |i-j|==1, but never touching the isolated content lane 7
            if i != 7 {
                if j != 7 {
                    if (j == i + 1) || (i == j + 1) { v = 1.0 }
                }
            }
            row = row + [v]
            j = j + 1
        }
        a = a + [row]
        i = i + 1
    }
    return a
}

fn _round(x: float) -> int {
    return to_int(x + 0.5)
}

fn main() {
    // topo_couple ON so the settle loop actually iterates the (Ψ-preserving, op=2 row-stochastic)
    // coupling; op=2 keeps uniform emit-drive lanes AND the dangling content lane EXACT.
    let cfg = EngineConfig { mitosis: true, engine: "conv", topo_couple: true, savant: false }
    let adj = _mk_adj()
    let N = 12
    let alpha = 0.5
    let thr = 0.5
    let maxdepth = 8
    let op = 2                                   // row-stochastic (Ψ-preserving, dangling-safe)
    let eps = 0.05
    let spike_at = 3                             // salience arrives mid-settle

    let mut reroute_hit = 0                      // interrupt ON: final identity tracks NEW input i
    let mut ablate_hit = 0                       // interrupt OFF (spike_at>maxdepth): tracks NEW? (should not)
    let mut shuffle_hit = 0                      // spike carries MISMATCHED sal_j: tracks NEW i? (should not)
    let mut psi_ok = 0                           // Ψ=½ preserved under reroute
    let mut flag_ok = 0                          // reroute_flag correct (1 on reroute, 0 on ablation)
    let mut psi_maxdev = 0.0

    let mut i = 0
    while i < N {
        let x_i   = _mk_pop(100.0 + to_float(i)) // original identity block 100..111
        let sal_i = _mk_pop(to_float(i))         // salient   identity block 0..11
        let jj    = (i + 5) - ((i + 5) / N) * N  // shuffle target j = (i+5) mod N
        let sal_j = _mk_pop(to_float(jj))

        // REROUTE: interrupt ON, salient = sal_i -> final identity should be i
        let r = tension_resolve_interruptible(x_i, adj, alpha, thr, maxdepth, op, eps, spike_at, sal_i, cfg)
        if _round(r[2]) == i { reroute_hit = reroute_hit + 1 }
        // Ψ preserved (r[1] ~ 0.5) and reroute_flag set
        let dev = if r[1] - 0.5 >= 0.0 { r[1] - 0.5 } else { 0.5 - r[1] }
        if dev > psi_maxdev { psi_maxdev = dev }
        if dev < 0.05 { psi_ok = psi_ok + 1 }
        if r[3] > 0.5 { flag_ok = flag_ok + 1 }  // reroute fired => flag 1.0

        // ABLATION: interrupt OFF (spike_at = maxdepth+99 never arrives) -> original completes, id=100+i
        let a = tension_resolve_interruptible(x_i, adj, alpha, thr, maxdepth, op, eps, maxdepth + 99, sal_i, cfg)
        if _round(a[2]) == i { ablate_hit = ablate_hit + 1 } // tracks NEW? should be NO (a[2]~100+i)
        if a[3] < 0.5 { flag_ok = flag_ok + 1 }  // no reroute => flag 0.0

        // SHUFFLE: spike carries MISMATCHED sal_j -> final id = j != i -> tracks NEW(i) should collapse
        let s = tension_resolve_interruptible(x_i, adj, alpha, thr, maxdepth, op, eps, spike_at, sal_j, cfg)
        if _round(s[2]) == i { shuffle_hit = shuffle_hit + 1 }

        i = i + 1
    }

    let rr = to_float(reroute_hit) / to_float(N)
    let ar = to_float(ablate_hit) / to_float(N)
    let sr = to_float(shuffle_hit) / to_float(N)
    let lift = rr - ar
    let earned = rr - sr

    let mut np = 0
    if _ab("REROUTE tracks NEW input (>=0.8)", rr >= 0.8) { np = np + 1 }
    if _ab("ABLATION (interrupt OFF) does NOT track new (<=0.2)", ar <= 0.2) { np = np + 1 }
    if _ab("LIFT reroute-ablation >= +0.5", lift >= 0.5) { np = np + 1 }
    if _ab("EARNED reroute-shuffle >= +0.5 (spike-target load-bearing)", earned >= 0.5) { np = np + 1 }
    if _ab("Ψ=½ PRESERVED under reroute (all N, |Ψ-½|<0.05)", psi_ok == N) { np = np + 1 }
    if _ab("reroute_flag correct (1 on reroute, 0 on ablation)", flag_ok == 2 * N) { np = np + 1 }

    println("INFO reroute=" + to_string(reroute_hit) + "/" + to_string(N)
        + " ablate=" + to_string(ablate_hit) + " shuffle=" + to_string(shuffle_hit)
        + " lift=" + to_string(lift) + " earned=" + to_string(earned)
        + " psi_maxdev=" + to_string(psi_maxdev) + " flag_ok=" + to_string(flag_ok) + "/" + to_string(2 * N))
    println("--- H_9079 salience_phasic_reset engine-native: " + to_string(np) + " pass / " + to_string(6 - np) + " fail ---")
}
