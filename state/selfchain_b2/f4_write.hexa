// f4_write.hexa — F4 (K-session persistence) WRITE phase, process #1.
// Simulates K session boundaries: at each boundary the drifted self-identity
// waypoint is persisted to a REAL on-disk .kosmos anchor via kosmos_io.create_anchor
// (the canonical writer — a_kosmos). Each anchor's full 8-dim identity vector is
// stored losslessly in the @payload text field (to_string↔parse_float is byte-exact),
// with the first-5 projection also written to @payload tension for kosmos-native
// placement. This process then EXITS — no in-memory state survives to the reload
// process (H_1204: in-memory carry != disk round-trip).
//   usage: hexa run state/selfchain_b2/f4_write.hexa
import "core/engine_cli.hexa"
import "core/kosmos_io.hexa"

fn _join_vec(s: SelfIdentity) -> string {
    let mut out = ""
    let mut i = 0
    while i < self_dim(s) {
        if i > 0 { out = out + " " }
        out = out + to_string(self_component(s, i))
        i = i + 1
    }
    return out
}

fn main() {
    let dim = 8
    let bigk = 4                                     // 4 boundaries -> waypoints w0..w4 (5 sessions)
    let kdir = "state/selfchain_b2/f4_sessions"
    let _clean = exec("rm -rf '" + kdir + "'")       // deterministic re-runs: drop stale anchors

    // Build the diachronic trajectory the same deterministic way as round-1's F1/F2.
    let seed = self_new(dim, 0)
    let mut cur = seed

    // waypoint w0 = the seed self (session 0 boundary)
    let mut wps = [seed]
    let mut tk = 0
    while tk < bigk {
        cur = self_drift(cur, tk, 0.3)               // the self GROWS one session
        wps = wps + [cur]
        tk = tk + 1
    }

    // Persist every waypoint as a REAL .kosmos anchor (one per session boundary).
    let mut k = 0
    let mut nwritten = 0
    while k < len(wps) {
        let wk = wps[k]
        let name = "self_wp0" + to_string(k)         // self_wp00..self_wp04 (string-sort = chronological)
        let text = _join_vec(wk)                     // full 8-dim vector, lossless
        // first-5 projection -> @payload tension (kosmos-native placement; NOT used for recovery)
        let t5 = [self_component(wk, 0), self_component(wk, 1), self_component(wk, 2),
                  self_component(wk, 3), self_component(wk, 4)]
        let path = create_anchor(kdir, name, "self waypoint " + to_string(k),
                                 self_component(wk, 0), to_float(k), "self_chain", 0.1,
                                 3, "self-identity", "continuity",
                                 text, t5, "self-chain-wp", "")
        println("WROTE " + path)
        nwritten = nwritten + 1
        k = k + 1
    }
    println("--- f4_write: " + to_string(nwritten) + " .kosmos waypoint anchors persisted to " + kdir + " ---")
}
