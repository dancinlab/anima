// selfchain_smoke.hexa — ENGINE-NATIVE proof of the B② self-CHAIN discriminator.
// Imports the LIVE core/engine_cli.hexa self_chain_* ops (no generator/brain — light compile).
// Mirrors the frozen falsifiers F1/F2/F3/F5/F6 of core/engine_cli_smoke.hexa cases 420-425.
//   usage: hexa run state/selfchain_b2/selfchain_smoke.hexa
import "core/engine_cli.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn main() {
    let mut npass = 0
    let mut nfail = 0

    let seed = self_new(8, 0)
    let mut chain = self_chain_new(seed)
    let mut cur = seed
    let mut tk = 0
    while tk < 4 {                                   // K=4 boundaries -> waypoints w0..w4
        cur = self_drift(cur, tk, 0.3)
        chain = self_chain_append(chain, cur)
        tk = tk + 1
    }
    let latest = self_chain_latest(chain)

    // F1 continuity
    let adjw = self_chain_retro_cos(chain, 1)
    let distw = self_chain_retro_cos(chain, 4)
    if _ab("F1_continuity adj>=0.70 & adj>distant", adjw >= 0.70 && adjw - distw >= 0.05) { npass = npass + 1 } else { nfail = nfail + 1 }

    // F5 retrodiction monotone-decreasing
    let r0 = self_chain_retro_cos(chain, 0)  let r1 = self_chain_retro_cos(chain, 1)
    let r2 = self_chain_retro_cos(chain, 2)  let r3 = self_chain_retro_cos(chain, 3)
    let r4 = self_chain_retro_cos(chain, 4)
    if _ab("F5_retrodiction monotone-decreasing", r0 > r1 && r1 > r2 && r2 > r3 && r3 > r4) { npass = npass + 1 } else { nfail = nfail + 1 }

    // populations: genuine (axis 5 = a_pred) vs impostor (fresh axes 6,7,0 = matches latest, wrong history)
    let g0 = self_drift(latest, 4, 0.24)  let g1 = self_drift(latest, 4, 0.27)
    let g2 = self_drift(latest, 4, 0.30)  let g3 = self_drift(latest, 4, 0.33)
    let g4 = self_drift(latest, 4, 0.36)  let g5 = self_drift(latest, 4, 0.39)
    let m0 = self_drift(latest, 5, 0.24)  let m1 = self_drift(latest, 6, 0.27)
    let m2 = self_drift(latest, 7, 0.30)  let m3 = self_drift(latest, 5, 0.33)
    let m4 = self_drift(latest, 6, 0.36)  let m5 = self_drift(latest, 7, 0.39)
    let fg = [self_chain_fit(g0, chain), self_chain_fit(g1, chain), self_chain_fit(g2, chain),
              self_chain_fit(g3, chain), self_chain_fit(g4, chain), self_chain_fit(g5, chain)]
    let fm = [self_chain_fit(m0, chain), self_chain_fit(m1, chain), self_chain_fit(m2, chain),
              self_chain_fit(m3, chain), self_chain_fit(m4, chain), self_chain_fit(m5, chain)]
    let cg = [self_cos(g0, latest), self_cos(g1, latest), self_cos(g2, latest),
              self_cos(g3, latest), self_cos(g4, latest), self_cos(g5, latest)]
    let cm = [self_cos(m0, latest), self_cos(m1, latest), self_cos(m2, latest),
              self_cos(m3, latest), self_cos(m4, latest), self_cos(m5, latest)]

    let mut auc_c = 0.0
    let mut auc_s = 0.0
    let mut gi = 0
    while gi < 6 {
        let mut ii = 0
        while ii < 6 {
            if fg[gi] > fm[ii] { auc_c = auc_c + 1.0 } else { if fg[gi] == fm[ii] { auc_c = auc_c + 0.5 } }
            if cg[gi] > cm[ii] { auc_s = auc_s + 1.0 } else { if cg[gi] == cm[ii] { auc_s = auc_s + 0.5 } }
            ii = ii + 1
        }
        gi = gi + 1
    }
    let auroc_chain = auc_c / 36.0
    let auroc_single = auc_s / 36.0

    // F2 impostor-history: chain-fit AUROC >> single-vector AUROC
    if _ab("F2_impostor_history AUROC(chain)>=0.95 & gap>=0.30", auroc_chain >= 0.95 && auroc_chain - auroc_single >= 0.30) { npass = npass + 1 } else { nfail = nfail + 1 }
    if _ab("F2b_margin genuine>=0.90 & impostor<=0.10", fg[0] >= 0.90 && fg[5] >= 0.90 && fm[0] <= 0.10 && fm[2] <= 0.10 && fm[5] <= 0.10) { npass = npass + 1 } else { nfail = nfail + 1 }

    // F3 ablation: erase history (count=1) -> fit=0 for both -> single-vector regime
    let mut flat_last = []
    let mut fli = 0
    while fli < 8 { flat_last = flat_last + [self_component(latest, fli)]  fli = fli + 1 }
    let abl = self_chain_from_flat(flat_last, 1, 8)
    if _ab("F3_ablation history-load-bearing (fit=0 both)", self_chain_fit(g2, abl) == 0.0 && self_chain_fit(m2, abl) == 0.0) { npass = npass + 1 } else { nfail = nfail + 1 }

    // F6 round-trip: serialize flat payload -> rebuild -> byte-identical fit
    let mut flat_rt = []
    let mut ri = 0
    let nflat = self_chain_count(chain) * self_chain_dim(chain)
    while ri < nflat { flat_rt = flat_rt + [self_chain_component(chain, ri)]  ri = ri + 1 }
    let rt = self_chain_from_flat(flat_rt, self_chain_count(chain), self_chain_dim(chain))
    if _ab("F6_roundtrip byte-identical fit", self_chain_fit(g2, rt) == self_chain_fit(g2, chain)) { npass = npass + 1 } else { nfail = nfail + 1 }

    println("INFO  AUROC(chain-fit)=" + to_string(auroc_chain) + " AUROC(single-vector)=" + to_string(auroc_single)
          + " fit_genuine=" + to_string(fg[2]) + " fit_impostor=" + to_string(fm[2])
          + " adj-cos=" + to_string(adjw) + " distant-cos=" + to_string(distw)
          + " retro=[" + to_string(r0) + "," + to_string(r1) + "," + to_string(r2) + "," + to_string(r3) + "," + to_string(r4) + "]")
    println("--- selfchain engine-native smoke: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
