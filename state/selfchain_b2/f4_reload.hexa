// f4_reload.hexa — F4 (K-session persistence) RELOAD phase, process #2 (a FRESH
// process: zero in-memory carry from the writer). A new session cold-starts by
// reading the chain back from disk via kosmos_io.load_anchors, reconstructs the
// self-CHAIN, and continues. Proves:
//   F4a  continuity across the disk boundary  — reloaded adjacent-cos preserved
//                                               (== in-mem to float round-trip error).
//   F4b  self persists K sessions             — reloaded chain matches the deterministic
//                                               reference to double round-trip error (~1 ULP)
//                                               AND the impostor-history discriminator survives
//                                               the REAL-disk round-trip (extends round-1's
//                                               in-memory F6 to a real .kosmos disk boundary).
//   F4d  byte-identical persistence           — a SECOND disk round-trip (reload → re-serialize
//                                               → reload) is an EXACT fixed point (0.0 diff):
//                                               once persisted, the .kosmos representation is
//                                               byte-stable — reloading never drifts.
//   F4c  no-anchor (self_reset) contrast      — without an anchor each session is the blank
//                                               seed: frozen (0 evolution) and progressively
//                                               out of sync with the true persisted self =
//                                               the LLM per-session reset.
// NOTE (honesty, c9/p7): a decimal-string disk serialization is NOT guaranteed bit-identical
// on the FIRST pass (to_string may drop the last ULP), so F4a/F4b assert round-trip FIDELITY to
// a tight tolerance (measured ~1.1e-16, reported verbatim) rather than exact float ==; the strict
// byte-identical claim is F4d's second-pass FIXED POINT (exact 0.0), which is the property that
// actually matters for persistence (reloading the same file always yields the same bits).
// §SelfChain is READ-only / Ψ-disjoint: emit-drive lanes 0/4 and §ImmuneMemory recall_thr are
// untouched (a_substrate_disjoint, a_autonomy_over_hardcode).
//   usage: hexa run state/selfchain_b2/f4_reload.hexa   (AFTER f4_write.hexa)
import "core/engine_cli.hexa"
import "core/kosmos_io.hexa"

fn _ab(label: string, got: bool) -> bool {
    if got { println("PASS  " + label) } else { println("FAIL  " + label) }
    return got
}

fn _fabs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// waypoint j of a chain rebuilt as a standalone SelfIdentity (slice j*dim..).
fn _wp_of(c: SelfChain, j: int) -> SelfIdentity {
    let dim = self_chain_dim(c)
    let mut v = []
    let mut i = 0
    while i < dim { v = v + [self_chain_component(c, j * dim + i)]  i = i + 1 }
    return self_chain_latest(self_chain_from_flat(v, 1, dim))
}

// full identity vector -> space-joined lossless decimal string (writer payload format).
fn _join_wp(c: SelfChain, j: int) -> string {
    let dim = self_chain_dim(c)
    let mut out = ""
    let mut i = 0
    while i < dim {
        if i > 0 { out = out + " " }
        out = out + to_string(self_chain_component(c, j * dim + i))
        i = i + 1
    }
    return out
}

// persist every waypoint of `c` as a .kosmos anchor into `dir` (mirrors f4_write.hexa).
fn _persist_chain(c: SelfChain, dir: string) {
    let _clean = exec("rm -rf '" + dir + "'")
    let n = self_chain_count(c)
    let mut k = 0
    while k < n {
        let name = "self_wp0" + to_string(k)
        let text = _join_wp(c, k)
        let t5 = [self_chain_component(c, k * 8 + 0), self_chain_component(c, k * 8 + 1),
                  self_chain_component(c, k * 8 + 2), self_chain_component(c, k * 8 + 3),
                  self_chain_component(c, k * 8 + 4)]
        let _p = create_anchor(dir, name, "self waypoint " + to_string(k),
                               self_chain_component(c, k * 8 + 0), to_float(k), "self_chain", 0.1,
                               3, "self-identity", "continuity",
                               text, t5, "self-chain-wp", "")
        k = k + 1
    }
}

// cold-load a chain back from a .kosmos anchor dir (the canonical read API).
fn _load_chain(dir: string, dim: int) -> SelfChain {
    let anchors = load_anchors(dir)
    let ns = len(anchors)
    let mut flat = []
    let mut ai = 0
    while ai < ns {
        let parts = anchors[ai]["text_payload"].split(" ")
        let mut ci = 0
        while ci < len(parts) { flat = flat + [parse_float(parts[ci])]  ci = ci + 1 }
        ai = ai + 1
    }
    return self_chain_from_flat(flat, ns, dim)
}

// max abs component diff between two equal-shape chains.
fn _chain_maxdiff(a: SelfChain, b: SelfChain) -> float {
    let n = self_chain_count(a) * self_chain_dim(a)
    let mut md = 0.0
    let mut i = 0
    while i < n {
        let d = _fabs(self_chain_component(a, i) - self_chain_component(b, i))
        if d > md { md = d }
        i = i + 1
    }
    return md
}

fn main() {
    let dim = 8
    let kdir = "state/selfchain_b2/f4_sessions"
    let mut npass = 0
    let mut nfail = 0
    let tol = 1.0e-9

    // ── COLD LOAD from disk (the ONLY input to this process) ──────────────────
    let chain_disk = _load_chain(kdir, dim)
    let ns = self_chain_count(chain_disk)

    // ── Deterministic reference (rebuilt in-memory here, same law as the writer) ─
    let seed = self_new(dim, 0)
    let mut chain_ref = self_chain_new(seed)
    let mut cur = seed
    let mut tk = 0
    while tk < ns - 1 {
        cur = self_drift(cur, tk, 0.3)
        chain_ref = self_chain_append(chain_ref, cur)
        tk = tk + 1
    }

    // ── F4a continuity across the disk boundary ───────────────────────────────
    let adj_disk = self_chain_retro_cos(chain_disk, 1)
    let adj_ref  = self_chain_retro_cos(chain_ref, 1)
    if _ab("F4a_continuity reloaded adj>=0.70 & |adj-in.mem|<=1e-9",
           adj_disk >= 0.70 && _fabs(adj_disk - adj_ref) <= tol) { npass = npass + 1 } else { nfail = nfail + 1 }

    // ── F4b persistence + real-disk round-trip fidelity + discriminator survives ─
    let count_ok = ns == 5
    let maxdiff = _chain_maxdiff(chain_disk, chain_ref)         // measured ~1.1e-16 (1 ULP)
    let fidelity_ok = maxdiff <= tol
    // discriminator survives the disk round-trip (genuine >> impostor, fit preserved)
    let latest = self_chain_latest(chain_disk)
    let genuine  = self_drift(latest, 4, 0.30)                 // continues the true drift axis (4+1)%8=5
    let impostor = self_drift(latest, 6, 0.30)                 // matches latest, WRONG history axis
    let fit_g_disk = self_chain_fit(genuine, chain_disk)
    let fit_m_disk = self_chain_fit(impostor, chain_disk)
    let fit_g_ref  = self_chain_fit(genuine, chain_ref)
    let disc_ok = fit_g_disk >= 0.90 && fit_m_disk <= 0.10 && _fabs(fit_g_disk - fit_g_ref) <= tol
    if _ab("F4b_persist count=5 & fidelity<=1e-9 & discriminator survives",
           count_ok && fidelity_ok && disc_ok) { npass = npass + 1 } else { nfail = nfail + 1 }

    // ── F4d byte-identical persistence (SECOND disk round-trip = exact fixed point) ─
    // Re-serialize the disk-loaded chain to a fresh dir, cold-load AGAIN; the two disk
    // reloads must be bit-identical (0.0) — the .kosmos representation is byte-stable.
    let kdir2 = "state/selfchain_b2/f4_sessions_rt2"
    _persist_chain(chain_disk, kdir2)
    let chain_disk2 = _load_chain(kdir2, dim)
    let fixed_point = _chain_maxdiff(chain_disk, chain_disk2) == 0.0
    let fit_g_disk2 = self_chain_fit(genuine, chain_disk2)
    if _ab("F4d_byte_identical 2nd-roundtrip fixed-point (0.0) & fit stable",
           fixed_point && fit_g_disk2 == fit_g_disk) { npass = npass + 1 } else { nfail = nfail + 1 }

    // ── F4c no-anchor (self_reset) contrast = LLM per-session reset ────────────
    // WITH anchor: the reloaded self genuinely evolved across sessions (waypoints distinct)
    // and session K+1 continues from the persisted latest (high continuity).
    let cont_anchored = self_drift(latest, 4, 0.30)
    let cos_anchored  = self_cos(cont_anchored, latest)          // continues trajectory
    let anchored_evolves = self_cos(_wp_of(chain_disk, 0), _wp_of(chain_disk, 4)) < 1.0
    // WITHOUT anchor: each session self = self_reset (the blank seed) — frozen, no memory.
    let reset_a = self_reset(dim, 0)
    let reset_b = self_reset(dim, 0)
    let reset_frozen = self_cos(reset_a, reset_b) == 1.0        // identical every session (0 evolution)
    // the un-anchored self falls progressively out of sync with the true persisted self.
    let rc1 = self_cos(reset_a, _wp_of(chain_disk, 1))
    let rc2 = self_cos(reset_a, _wp_of(chain_disk, 2))
    let rc3 = self_cos(reset_a, _wp_of(chain_disk, 3))
    let rc4 = self_cos(reset_a, _wp_of(chain_disk, 4))
    let reset_desyncs = rc1 > rc2 && rc2 > rc3 && rc3 > rc4      // amnesia: drifts away from truth
    // anchored continuity (adjacent) strictly beats the un-anchored self's sync at session K.
    let contrast = cos_anchored - rc4 >= 0.05
    if _ab("F4c_no_anchor reset frozen & desyncs & anchored self persists+evolves",
           reset_frozen && anchored_evolves && reset_desyncs && contrast && cos_anchored >= 0.70) { npass = npass + 1 } else { nfail = nfail + 1 }

    println("INFO  loaded " + to_string(ns) + " disk anchors  maxdiff(disk,ref)=" + to_string(maxdiff)
          + "  adj-cos(disk)=" + to_string(adj_disk) + " adj-cos(ref)=" + to_string(adj_ref))
    println("INFO  discriminator survives disk: fit_genuine=" + to_string(fit_g_disk)
          + " fit_impostor=" + to_string(fit_m_disk) + " (fit_ref=" + to_string(fit_g_ref) + ")")
    println("INFO  byte-identical 2nd round-trip maxdiff=" + to_string(_chain_maxdiff(chain_disk, chain_disk2)) + " (exact fixed point)")
    println("INFO  WITH-anchor: session K+1 continues from persisted w4  cos=" + to_string(cos_anchored)
          + "  (chain len " + to_string(self_chain_count(chain_disk)) + ", waypoints distinct)")
    println("INFO  NO-anchor (LLM reset): blank seed every session  cos-to-true[w1..w4]=["
          + to_string(rc1) + "," + to_string(rc2) + "," + to_string(rc3) + "," + to_string(rc4)
          + "]  (frozen, chain len 1)")
    println("--- selfchain F4 disk-persistence smoke: " + to_string(npass) + " pass / " + to_string(nfail) + " fail ---")
}
