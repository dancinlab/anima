import "CORE/g6_ideation.hexa"

// H_1400 — G6 IDEATION ★ FALS re-score, LOADED-ONCE (the H_1392 wall, now unblocked).
// VERBATIM the H_1392 frozen probe (detector + scaffold + M1-M5 bars UNCHANGED) — the ONLY
// difference is the streaming/bounded decode (H_1400 fix) + a SINGLE clm_load_weights so all
// 69 decodes reuse ONE 303M model load (the hexa bump allocator never frees a per-decode
// reload → that was the cross-decode OOM). NO bar moved, NO tune-to-green (c9, p7).
fn main() {
    let ckpt = "state/g6-retro303m-fals/retro303m.clm"
    let known = _g6_dict_load()
    println("CKPT=" + ckpt)
    println("DETECTOR_CALIBRATION=" + to_string(g6_detector_calibration(known)) + "/10")
    let fr = g6_build_frames(6)
    let comp = fr["composed"]; let shuf = fr["shuffled"]; let abl = fr["ablated"]
    println("FRAME_GUARD_LEAKS=" + to_string(len(g6_frame_guard(comp, known))))
    let st = g6_sampler_selftest()
    println("SAMPLER det=" + to_string(st["deterministic"]) + " diverse=" + to_string(st["diverse"]) + " in_topk=" + to_string(st["in_topk"]))

    // H_1400: load the 303M ConvMoE ONCE; reuse W for every decode below.
    let W = clm_load_weights(ckpt)
    println("LOADED ok=" + to_string(W["ok"]) + " d=" + to_string(W["d"]) + " E=" + to_string(W["E"]) + " V=" + to_string(W["V"]) + " L=" + to_string(W["L"]))

    let GEN = 110   // FROZEN H_1362 MAX_NEW (full falsifiable-sentence budget)
    let SEED = 7    // FROZEN H_1362 primary seed

    // ── C_strong: 6 frames, best-of-K=3 ──
    println("=== ARM C_strong (6 frames x K=3, GEN=110, seed=7) ===")
    let mut fals_c = 0
    let csets = []
    let mut i = 0
    while i < len(comp) {
        let t0 = now_ms()
        let o = g6_decode_best_of_k_W(W, to_string(comp[i]), GEN, 3, SEED, known)
        let kwr = _g6_known_word_ratio(o, known)
        let mut isf = false
        if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
        if isf { fals_c = fals_c + 1; csets.push(_g6_words(o)) }
        else { if kwr >= 0.5 { csets.push(_g6_words(o)) } }
        println("C_strong[" + to_string(i) + "] fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
        i = i + 1
    }
    let kept = []
    let mut w = 0
    while w < len(csets) {
        let ws = csets[w]; let mut ok = true; let mut kk = 0
        while kk < len(kept) { if _g6_jaccard(ws, kept[kk]) > 0.5 { ok = false } kk = kk + 1 }
        if ok { kept.push(ws) }
        w = w + 1
    }
    println("C_strong DIST=" + to_string(len(kept)) + " FALS=" + to_string(fals_c) + " coh=" + to_string(len(csets)) + "/6")
    println("M1_COUNT_pass=" + to_string(len(kept) >= 5))
    println("M2_DEPTH_pass=" + to_string(fals_c >= 1))

    // ── B_composed (single-sample, 5 frames K=1) for M3 LIFT ──
    println("=== ARM B_composed (5 frames K=1, GEN=110, seed=7) ===")
    let bfr = g6_build_frames(5)
    let bcomp = bfr["composed"]
    let mut fals_b = 0
    let mut bi = 0
    while bi < len(bcomp) {
        let t0 = now_ms()
        let r = gen_clm_ideate_W(W, to_string(bcomp[bi]), GEN, 40, 0.7, SEED)
        let o = to_string(r["text"])
        let kwr = _g6_known_word_ratio(o, known)
        let mut isf = false
        if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
        if isf { fals_b = fals_b + 1 }
        println("B[" + to_string(bi) + "] fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
        bi = bi + 1
    }
    println("B_composed FALS=" + to_string(fals_b))
    println("M3_LIFT_pass=" + to_string(fals_c > fals_b))

    // ── C_shuffle (control, M4) ──
    println("=== ARM C_shuffle (6 frames x K=3, GEN=110, seed=7) ===")
    let mut fals_sh = 0
    let mut si = 0
    while si < len(shuf) {
        let t0 = now_ms()
        let o = g6_decode_best_of_k_W(W, to_string(shuf[si]), GEN, 3, SEED, known)
        let kwr = _g6_known_word_ratio(o, known)
        let mut isf = false
        if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
        if isf { fals_sh = fals_sh + 1 }
        println("C_shuffle[" + to_string(si) + "] fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
        si = si + 1
    }
    println("C_shuffle FALS=" + to_string(fals_sh))
    println("M4_EARNED_PAIR_pass=" + to_string(fals_c > fals_sh))

    // ── C_ablate (control, M5) ──
    println("=== ARM C_ablate (6 frames x K=3, GEN=110, seed=7) ===")
    let mut fals_ab = 0
    let mut ai = 0
    while ai < len(abl) {
        let t0 = now_ms()
        let o = g6_decode_best_of_k_W(W, to_string(abl[ai]), GEN, 3, SEED, known)
        let kwr = _g6_known_word_ratio(o, known)
        let mut isf = false
        if kwr >= 0.5 { isf = _g6_is_falsifiable(o, known) }
        if isf { fals_ab = fals_ab + 1 }
        println("C_ablate[" + to_string(ai) + "] fals=" + to_string(isf) + " kwr=" + to_string(kwr) + " ms=" + to_string(now_ms()-t0) + " :: " + o)
        ai = ai + 1
    }
    println("C_ablate FALS=" + to_string(fals_ab))
    println("M5_EARNED_COMP_pass=" + to_string(fals_c > fals_ab))

    println("=== FROZEN BARS (engine-native, 303M ConvMoE-RETRO, seed=7, GEN=110, H_1400 streaming) ===")
    println("M1_COUNT  DIST(Cs)>=5     : " + to_string(len(kept)) + " -> " + to_string(len(kept)>=5))
    println("M2_DEPTH  FALS(Cs)>=1     : " + to_string(fals_c) + " -> " + to_string(fals_c>=1))
    println("M3_LIFT   FALS(Cs)>FALS(B): " + to_string(fals_c) + ">" + to_string(fals_b) + " -> " + to_string(fals_c>fals_b))
    println("M4_PAIR   FALS(Cs)>FALS(Sh): " + to_string(fals_c) + ">" + to_string(fals_sh) + " -> " + to_string(fals_c>fals_sh))
    println("M5_COMP   FALS(Cs)>FALS(Ab): " + to_string(fals_c) + ">" + to_string(fals_ab) + " -> " + to_string(fals_c>fals_ab))
    let allpass = (len(kept)>=5) && (fals_c>=1) && (fals_c>fals_b) && (fals_c>fals_sh) && (fals_c>fals_ab)
    println("ALL_5_BARS_PASS=" + to_string(allpass))
    println("DONE")
}
