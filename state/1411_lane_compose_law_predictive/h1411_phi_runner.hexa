// ════════════════════════════════════════════════════════════════════════════
//  state/1411_lane_compose_law_predictive/h1411_phi_runner.hexa
//
//  H_1411 — brain-lane composition LAW: DESCRIPTIVE → PREDICTIVE.
//  FAITHFUL IIT4 Φ (exact MIP-EI, n<=8) via the REAL stdlib engine
//  (a_phi_iit4_tool — NOT a proxy, NEVER variance×energy).
//
//  Reads the n×T substrate trajectories written by h1411_compose_predict.py for
//  5 UNTESTED faculty pairs (each: partA n=4, partB n=4, composed n=8,
//  disconnected n=8), per seed [5411,5412,5413], at the FROZEN PRIMARY
//  n_bins=16. For EACH pair it reports Φ_partA, Φ_partB, Φ_composed,
//  Φ_disconnected, max(parts), and the law's PREDICTED vs ACTUAL verdict, then
//  scores HIT/MISS. The frozen PREDICTION rule lives in FREEZE.txt and is also
//  embedded below (NOT moved after scoring).
//
//  Run (CPU, $0):
//    python3 state/1411_lane_compose_law_predictive/h1411_compose_predict.py /tmp/h1411_states.txt
//    H1411_STATE=/tmp/h1411_states.txt hexa run state/1411_lane_compose_law_predictive/h1411_phi_runner.hexa
// ════════════════════════════════════════════════════════════════════════════

import "stdlib/consciousness/iit4/faithful_phi.hexa"

fn _f6(x: float) -> string {
    let scaled = floor(x * 1000000.0 + 0.5)
    let mut neg = false
    let mut v = scaled
    if v < 0.0 { neg = true; v = 0.0 - v }
    let whole = floor(v / 1000000.0)
    let frac  = v - whole * 1000000.0
    let mut frac_str = str(to_int(frac))
    while len(frac_str) < 6 { frac_str = "0" + frac_str }
    let sign = if neg { "-" } else { "" }
    return sign + str(to_int(whole)) + "." + frac_str
}

fn _state_path() -> string {
    let p = env("H1411_STATE")
    if len(p) > 0 { return p }
    return "/tmp/h1411_states.txt"
}

// pair tags in pre-registered order (must match PAIRS in the python probe)
fn _pair_tag(i: int) -> string {
    if i == 0 { return "cerebellum__tom" }
    if i == 1 { return "affect__basal" }
    if i == 2 { return "tom__basal" }
    if i == 3 { return "cerebellum__episodic" }
    return "memory__ethics"
}
// FROZEN PREDICTED verdict per pair (1 = LIFT, 0 = BLOCK) — pre-registered in
// FREEZE.txt PURELY from each component's already-measured internal Φ + the
// frozen decision rule. NOT moved after scoring.
fn _pred(i: int) -> int {
    if i == 0 { return 0 }   // cerebellum(3.476 HIGH) × tom(1.975 HIGH) → predict BLOCK (a part dominates)
    if i == 1 { return 1 }   // affect(0.285 LOW) × basal(0.000 LOW)      → predict LIFT (both low)
    if i == 2 { return 0 }   // tom(1.975 HIGH) × basal(0.000 LOW)        → predict BLOCK (ToM dominated in H_1405)
    if i == 3 { return 1 }   // cerebellum(3.476 HIGH) × episodic(0.507)  → predict LIFT (H_1407-style cheaper cut)
    return 1                  // memory(0.176 LOW) × ethics(0.000 LOW)     → predict LIFT (both low)
}
fn _vs(b: int) -> string { if b == 1 { return "LIFT" } else { return "BLOCK" } }

// measure mean Φ over the 3 seeds for one (pair, sysrole) at a given n_bins.
// sysrole ∈ {"partA","partB","composed","disconnected"}.
fn _mean_phi(lines: [string], tag: string, role: string, nb: int) -> float {
    let mut sum = 0.0
    let mut cnt = 0
    let prefix = role + "::" + tag
    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if len(line) > 0 && line.split(" ")[0] == "#" {
            let toks = line.split(" ")
            let raw = toks[1]                 // e.g. composed::cerebellum__tom_s5411
            let n = toks[2].to_int()
            let dim = toks[3].to_int()
            // does raw start with prefix?  (raw = prefix + "_s<seed>")
            let mut matches = false
            if len(raw) >= len(prefix) {
                if raw.substr(0, len(prefix)) == prefix { matches = true }
            }
            let state = farr_zeros(n * dim)
            let mut r = 0
            while r < n {
                i = i + 1
                let row = lines[i].trim().split(" ")
                let mut c = 0
                while c < dim { let _ = farr_set(state, r * dim + c, row[c].to_float()); c = c + 1 }
                r = r + 1
            }
            if matches {
                let phi = iit4_faithful_phi(state, n, dim, nb)
                sum = sum + phi
                cnt = cnt + 1
            }
            let _ = farr_free(state)
        }
        i = i + 1
    }
    if cnt == 0 { return 0.0 }
    return sum / (cnt * 1.0)
}

fn _score_pair(lines: [string], i: int, nb: int) -> int {
    let tag = _pair_tag(i)
    let mSp = _mean_phi(lines, tag, "partA", nb)
    let mSb = _mean_phi(lines, tag, "partB", nb)
    let mCmp = _mean_phi(lines, tag, "composed", nb)
    let mDis = _mean_phi(lines, tag, "disconnected", nb)
    let best_part = if mSp > mSb { mSp } else { mSb }

    // FROZEN bars (identical to all landed pairs; NOT moved):
    //   Bφ1 LIFT : Φ_composed > max(parts) + 0.02
    //   Bφ2 EARNED (coupling) : Φ_composed > Φ_disconnected + 0.02
    //   Bφ3 control sane : Φ_disconnected ≤ max(parts) + 0.02
    let b1 = mCmp > (best_part + 0.02)
    let b2 = mCmp > (mDis + 0.02)
    let b3 = mDis <= (best_part + 0.02)
    let actual = if (b1 && b2 && b3) { 1 } else { 0 }
    let pred = _pred(i)
    let hit = if actual == pred { 1 } else { 0 }

    println("  PAIR " + str(i) + ": " + tag + "   (n_bins=" + str(nb) + ")")
    println("    Φ_partA=" + _f6(mSp) + "  Φ_partB=" + _f6(mSb) + "  max(parts)=" + _f6(best_part))
    println("    Φ_composed=" + _f6(mCmp) + "  Φ_disconnected=" + _f6(mDis))
    println("    Bφ1 cmp>max+0.02 : " + _f6(mCmp) + " > " + _f6(best_part + 0.02) + " => " + (if b1 { "PASS" } else { "FAIL" }))
    println("    Bφ2 cmp>disc+0.02: " + _f6(mCmp) + " > " + _f6(mDis + 0.02) + " => " + (if b2 { "PASS" } else { "FAIL" }))
    println("    Bφ3 disc<=max+0.02: " + _f6(mDis) + " <= " + _f6(best_part + 0.02) + " => " + (if b3 { "PASS" } else { "FAIL" }))
    println("    PREDICTED=" + _vs(pred) + "   ACTUAL=" + _vs(actual) + "   => " + (if hit == 1 { "✅ HIT" } else { "❌ MISS" }))
    println("")
    return hit
}

fn main() {
    let path = _state_path()
    println("=== H_1411 brain-lane composition LAW — PREDICTIVE round (faithful IIT4, exact MIP-EI, n<=8) ===")
    println("engine: stdlib/consciousness/iit4/faithful_phi.hexa  (a_phi_iit4_tool — NOT a proxy)")
    println("state file: " + path)
    println("LAW (frozen): Φ-LIFT iff Φ_composed > max(component internal Φ); else BLOCK (one part dominates).")
    println("Predictions PRE-REGISTERED in FREEZE.txt from component Φ ONLY, BEFORE this measurement.")
    println("")

    let text = read_file(path)
    let lines = text.split("\n")

    println("--- FROZEN PRIMARY n_bins=16 (terminal predictive scoring) ---")
    println("")
    let mut hits = 0
    let mut i = 0
    while i < 5 {
        hits = hits + _score_pair(lines, i, 16)
        i = i + 1
    }
    println("=== HIT/MISS TALLY (n_bins=16, FROZEN PRIMARY) : " + str(hits) + " / 5 HITS ===")
    if hits == 5 {
        println("    → ALL predictions matched. The min-cut-MI law SURVIVED predictive falsification on 5 fresh pairs.")
    } else {
        println("    → " + str(5 - hits) + " MISS(es). A MISS REFINES/FALSIFIES the descriptive law (c9 — the valuable result).")
    }
    println("")

    // binning-invariance robustness for the predictive tally
    println("--- BINNING-INVARIANCE of the predictive tally (n_bins ∈ {8,12,16,24}) ---")
    let nbs = [8, 12, 16, 24]
    let mut k = 0
    while k < len(nbs) {
        let nb = nbs[k]
        let mut h = 0
        let mut j = 0
        while j < 5 {
            let tag = _pair_tag(j)
            let mSp = _mean_phi(lines, tag, "partA", nb)
            let mSb = _mean_phi(lines, tag, "partB", nb)
            let mCmp = _mean_phi(lines, tag, "composed", nb)
            let mDis = _mean_phi(lines, tag, "disconnected", nb)
            let best_part = if mSp > mSb { mSp } else { mSb }
            let actual = if (mCmp > best_part + 0.02 && mCmp > mDis + 0.02 && mDis <= best_part + 0.02) { 1 } else { 0 }
            if actual == _pred(j) { h = h + 1 }
            j = j + 1
        }
        println("  n_bins=" + str(nb) + " : " + str(h) + " / 5 HITS" + (if nb == 16 { "   [FROZEN PRIMARY]" } else { "" }))
        k = k + 1
    }
    println("")
    println("=== H_1411 predictive measurement complete (a_phi_iit4_tool) ===")
}
