// generator_parity_harness.hexa — TEMP parity harness for core/generator.py.
// Drives the live core/generator.hexa L3 MOUTH-DISPATCH surface (gen_mouth_kind +
// gen_auto_chat + gen_auto_ideate) on a ckpt, for byte-parity vs core/generator.py.
// Selected mouth (clm | bytegpt) follows the header sniff, so running this on BOTH
// a tiny .clm and a tiny ByteGPT .bin proves the dispatcher + both routings faithful.
import "core/generator.hexa"

fn main() {
    let ck   = exec("printf %s \"$GEN_CK\"")
    let seed = exec("printf %s \"$GEN_SEED\"")
    let gen  = to_int(exec("printf %s \"$GEN_N\""))

    println("KIND:" + gen_mouth_kind(ck))

    // ── CHAT (greedy argmax) via gen_auto_chat ──
    let rc = gen_auto_chat(ck, seed, gen)
    println("CHAT_OK:" + to_string(rc["ok"]))
    println("CHAT:" + to_string(rc["text"]))

    // ── IDEATE (seeded top-k) via gen_auto_ideate ──
    let ri = gen_auto_ideate(ck, seed, gen, 8, 0.9, 4242)
    println("IDEATE_OK:" + to_string(ri["ok"]))
    println("IDEATE:" + to_string(ri["text"]))
}
