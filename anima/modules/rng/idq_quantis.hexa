// anima/modules/rng/idq_quantis.hexa — IDQ Quantis commercial QRNG (Tier 3 STUB)
//
// Stub interface for ID Quantique Quantis hardware QRNG family.
// Real implementation requires:
//   to wire: Quantis SDK (libQuantis) + PCIe/USB device file + permissions
//
// raw#10:
//   (1) STUB only — collect always returns ok=0 with not_implemented reason.
//   (2) Throughput is model-dependent. Recorded values:
//         - Legacy USB-4M:  4 Mbps
//         - PCIe-240M:      240 Mbps  (default in this stub)
//   (3) Cost: $1k–10k commercial unit.

// ── inline struct mirror (SSOT: anima/core/rng/source.hexa) ─

struct RngSourceMeta {
    name:           str,
    tier:           int,
    throughput_bps: int,
    cost_usd:       int,
    lead_days:      int,
    is_quantum:     int,
    is_local:       int,
    is_free:        int,
    status:         str,
    vendor:         str
}

struct RngCollectResult {
    ok:             int,
    n_bytes:        int,
    bytes_:         [int],
    sha256_hex:     str,
    message:        str
}

fn rng_meta_make(
    name: str, tier: int, throughput_bps: int, cost_usd: int,
    lead_days: int, is_quantum: int, is_local: int, is_free: int,
    status: str, vendor: str
) -> RngSourceMeta {
    return RngSourceMeta {
        name: name, tier: tier, throughput_bps: throughput_bps,
        cost_usd: cost_usd, lead_days: lead_days,
        is_quantum: is_quantum, is_local: is_local, is_free: is_free,
        status: status, vendor: vendor
    }
}

fn rng_result_fail(reason: str) -> RngCollectResult {
    return RngCollectResult { ok: 0, n_bytes: 0, bytes_: [], sha256_hex: "", message: reason }
}

// ── IDQ meta ───────────────────────────────────────────────
//
// Default model = PCIe-240M (240 Mbps). Legacy USB-4M throughput recorded in
// vendor string for reference.

let IDQ_NAME       = "idq_quantis"
let IDQ_TIER       = 3
let IDQ_BPS        = 240000000        // 240 Mbps default (PCIe-240M)
let IDQ_VENDOR     = "ID_Quantique_Quantis_PCIe_240M_default;legacy_USB_4M=4Mbps"

fn rng_source_meta_idq_quantis() -> RngSourceMeta {
    return rng_meta_make(
        IDQ_NAME, IDQ_TIER, IDQ_BPS,
        5000,   // cost_usd (~$5k mid-range)
        42,     // lead_days (~4-8 weeks ship + integrate)
        1,      // is_quantum
        1,      // is_local (PCIe/USB device)
        0,      // is_free (commercial)
        "STUB",
        IDQ_VENDOR
    )
}

fn rng_source_collect_idq_quantis(n_bytes: int, seed: int) -> RngCollectResult {
    // to wire: open /dev/quantis0 (or USB), libQuantis_GetData(handle, n_bytes, buf)
    return rng_result_fail("idq_quantis: STUB — libQuantis SDK + PCIe/USB device required")
}

// ── Selftest ───────────────────────────────────────────────

fn _selftest_idq_quantis() -> int {
    let m = rng_source_meta_idq_quantis()
    if m.name != "idq_quantis" { return 0 }
    if m.tier != 3 { return 0 }
    if m.status != "STUB" { return 0 }
    if m.is_quantum != 1 { return 0 }
    if m.is_local != 1 { return 0 }
    if m.is_free != 0 { return 0 }
    let r = rng_source_collect_idq_quantis(8, 0)
    if r.ok != 0 { return 0 }
    return 1
}

fn main() {
    println("[rng/idq_quantis] IDQ Quantis commercial QRNG (Tier 3 STUB)")
    if _selftest_idq_quantis() == 1 {
        println("[rng/idq_quantis] SELFTEST PASS")
    } else {
        println("[rng/idq_quantis] SELFTEST FAIL")
    }
}
