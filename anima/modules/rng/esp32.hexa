// anima/modules/rng/esp32.hexa — ESP32 hardware QRNG wrapper
//
// Tier 0 (local hardware). Wraps existing anima-physics/esp32/qrng_bridge.hexa
// WITHOUT MODIFYING IT. Original file remains byte-identical (audit at landing).
//
// raw#9 hexa-only strict. raw#10:
//   (1) Original qrng_bridge.hexa exposes mock LCG path only (HW serial stack
//       not yet bridged). This module preserves that behavior — mock-mode bytes
//       are deterministic from seed, NOT true quantum.
//   (2) Real-HW path activates when hexa serial stdlib lands; this wrapper's
//       interface stays identical (1-line internal swap).
//   (3) qrng_bridge returns float [0,1] samples; we discretize to bytes
//       (multiply by 256, clamp to 0..255). Determinism preserved per seed.

// ── inline struct mirror (SSOT: anima/core/rng/source.hexa) ─

struct RngSourceMeta {
    name:           str,
    tier:           int,
    throughput_bps: int,
    cost_usd:       int,
    lead_days:      int,
    is_quantum:     int,
    is_local:       int,
    is_free:        int,
    status:         str,
    vendor:         str
}

struct RngCollectResult {
    ok:             int,
    n_bytes:        int,
    bytes_:         [int],
    sha256_hex:     str,
    message:        str
}

fn rng_meta_make(
    name: str, tier: int, throughput_bps: int, cost_usd: int,
    lead_days: int, is_quantum: int, is_local: int, is_free: int,
    status: str, vendor: str
) -> RngSourceMeta {
    return RngSourceMeta {
        name: name, tier: tier, throughput_bps: throughput_bps,
        cost_usd: cost_usd, lead_days: lead_days,
        is_quantum: is_quantum, is_local: is_local, is_free: is_free,
        status: status, vendor: vendor
    }
}

fn rng_result_fail(reason: str) -> RngCollectResult {
    return RngCollectResult { ok: 0, n_bytes: 0, bytes_: [], sha256_hex: "", message: reason }
}

fn rng_result_ok(bytes_: [int], sha256_hex: str, message: str) -> RngCollectResult {
    return RngCollectResult { ok: 1, n_bytes: len(bytes_), bytes_: bytes_, sha256_hex: sha256_hex, message: message }
}

// ── Mirror constants from qrng_bridge.hexa (read-only copy) ─
//
// We replicate QRNG_LCG_A, QRNG_LCG_C, QRNG_MOCK_SEED, QRNG_U32_MOD here to
// produce *byte-identical* deterministic bytes vs. the original file's
// qrng_batch_samples → x256 conversion. Original file is NOT modified.

let ESP32_NAME       = "esp32"
let ESP32_TIER       = 0
let ESP32_BPS        = 256000          // ~256 kbit/s typical ESP32-S3 USB-CDC
let ESP32_VENDOR     = "ESP32-S3_USB-CDC"
let ESP32_LCG_A      = 1664525
let ESP32_LCG_C      = 1013904223
let ESP32_LCG_MOD    = 4294967296
let ESP32_MOCK_SEED  = 2463534242
let ESP32_U32_MAX_F  = 4294967295.0

fn esp32_lcg_next(s: int) -> int {
    return (ESP32_LCG_A * s + ESP32_LCG_C) % ESP32_LCG_MOD
}

// ── Meta export ─────────────────────────────────────────────

fn rng_source_meta_esp32() -> RngSourceMeta {
    return rng_meta_make(
        ESP32_NAME, ESP32_TIER, ESP32_BPS,
        4,   // ~$4 ESP32-S3 board cost
        0,   // already on hand (lead 0)
        1,   // quantum (avalanche-noise based real device); mock layer is classical fallback
        1,   // local
        1,   // free (hardware on hand)
        "WRAPPED",
        ESP32_VENDOR
    )
}

// ── Collect ─────────────────────────────────────────────────
//
// Wraps the qrng_bridge LCG-mock path. When hexa serial stdlib lands, swap
// `esp32_lcg_next(s)` → `qrng_read_hw(stream).last_sample` (1-line change).

fn rng_source_collect_esp32(n_bytes: int, seed: int) -> RngCollectResult {
    if n_bytes < 1 {
        return rng_result_fail("esp32: n_bytes must be >= 1")
    }
    // Use seed if non-zero, else default mock seed (matches qrng_bridge).
    let mut s = if seed > 0 { seed } else { ESP32_MOCK_SEED }
    let mut bytes_ = []
    let mut i = 0
    while i < n_bytes {
        s = esp32_lcg_next(s)
        // sample ∈ [0,1): s / U32_MAX_F
        let sample = (s * 1.0) / ESP32_U32_MAX_F
        let b = to_int(sample * 256.0)
        let b_clamp = if b > 255 { 255 } else { if b < 0 { 0 } else { b } }
        bytes_ = bytes_.push(b_clamp)
        i = i + 1
    }
    // Compute sha256 by writing bytes to tmp file then hashing.
    let tmp = "/tmp/anima_rng_esp32_" + str(seed) + "_" + str(n_bytes) + ".bin"
    // Build hex string
    let mut hex = ""
    let mut k = 0
    while k < n_bytes {
        let b = bytes_[k]
        let hi = b / 16
        let lo = b - hi * 16
        let hi_c = if hi < 10 { str(hi) } else { if hi == 10 { "a" } else { if hi == 11 { "b" } else { if hi == 12 { "c" } else { if hi == 13 { "d" } else { if hi == 14 { "e" } else { "f" } } } } } }
        let lo_c = if lo < 10 { str(lo) } else { if lo == 10 { "a" } else { if lo == 11 { "b" } else { if lo == 12 { "c" } else { if lo == 13 { "d" } else { if lo == 14 { "e" } else { "f" } } } } } }
        hex = hex + hi_c + lo_c
        k = k + 1
    }
    let cmd = "printf '%s' '" + hex + "' | xxd -r -p > " + tmp + " 2>&1; (shasum -a 256 " + tmp + " 2>/dev/null || sha256sum " + tmp + ") | awk '{print $1}'"
    let sha = exec(cmd).trim()
    let _rc = exec("rm -f " + tmp + "; echo OK")
    return rng_result_ok(bytes_, sha, "esp32: ok (mock LCG; hw_serial pending)")
}

// ── Selftest ────────────────────────────────────────────────

fn _selftest_esp32() -> int {
    let m = rng_source_meta_esp32()
    if m.name != "esp32" { return 0 }
    if m.tier != 0 { return 0 }
    if m.is_local != 1 { return 0 }
    if m.status != "WRAPPED" { return 0 }
    let r1 = rng_source_collect_esp32(8, 42)
    if r1.ok != 1 { return 0 }
    if r1.n_bytes != 8 { return 0 }
    if len(r1.bytes_) != 8 { return 0 }
    // Determinism check: same seed → same bytes
    let r2 = rng_source_collect_esp32(8, 42)
    let mut i = 0
    while i < 8 {
        if r1.bytes_[i] != r2.bytes_[i] { return 0 }
        i = i + 1
    }
    if r1.sha256_hex != r2.sha256_hex { return 0 }
    // Different seed → different bytes (very high prob)
    let r3 = rng_source_collect_esp32(8, 99)
    let mut diff = 0
    let mut j = 0
    while j < 8 {
        if r1.bytes_[j] != r3.bytes_[j] { diff = diff + 1 }
        j = j + 1
    }
    if diff < 4 { return 0 }
    return 1
}

fn main() {
    println("[rng/esp32] ESP32-S3 QRNG wrapper (raw#10: mock-LCG layer; hw_serial pending)")
    if _selftest_esp32() == 1 {
        println("[rng/esp32] SELFTEST PASS")
    } else {
        println("[rng/esp32] SELFTEST FAIL")
    }
}
