// anima/modules/rng/urandom.hexa — system /dev/urandom fallback source
//
// Tier 0. Always available, classical pseudo-random (kernel CSPRNG).
// Used as last-resort fallback when all quantum sources fail.
//
// raw#9 hexa-only strict. Uses `exec` to dd bytes from /dev/urandom (POSIX).
// raw#10:
//   (1) kernel CSPRNG NOT quantum; informational only when no quantum source
//       is configured.
//   (2) struct definitions inlined (hexa stage0 has no `use`/`import`); kept
//       byte-identical to anima/core/rng/source.hexa SSOT.

// ── inline struct mirror of source.hexa SSOT ────────────────

struct RngSourceMeta {
    name:           str,
    tier:           int,
    throughput_bps: int,
    cost_usd:       int,
    lead_days:      int,
    is_quantum:     int,
    is_local:       int,
    is_free:        int,
    status:         str,
    vendor:         str
}

struct RngCollectResult {
    ok:             int,
    n_bytes:        int,
    bytes_:         [int],
    sha256_hex:     str,
    message:        str
}

fn rng_meta_make(
    name: str, tier: int, throughput_bps: int, cost_usd: int,
    lead_days: int, is_quantum: int, is_local: int, is_free: int,
    status: str, vendor: str
) -> RngSourceMeta {
    return RngSourceMeta {
        name:           name,
        tier:           tier,
        throughput_bps: throughput_bps,
        cost_usd:       cost_usd,
        lead_days:      lead_days,
        is_quantum:     is_quantum,
        is_local:       is_local,
        is_free:        is_free,
        status:         status,
        vendor:         vendor
    }
}

fn rng_result_fail(reason: str) -> RngCollectResult {
    return RngCollectResult {
        ok:         0,
        n_bytes:    0,
        bytes_:     [],
        sha256_hex: "",
        message:    reason
    }
}

fn rng_result_ok(bytes_: [int], sha256_hex: str, message: str) -> RngCollectResult {
    return RngCollectResult {
        ok:         1,
        n_bytes:    len(bytes_),
        bytes_:     bytes_,
        sha256_hex: sha256_hex,
        message:    message
    }
}

// ── urandom-specific constants ──────────────────────────────

let URANDOM_NAME    = "urandom"
let URANDOM_TIER    = 0
let URANDOM_BPS     = 1000000000
let URANDOM_VENDOR  = "POSIX_kernel_CSPRNG"

// ── Meta export ─────────────────────────────────────────────

fn rng_source_meta_urandom() -> RngSourceMeta {
    return rng_meta_make(
        URANDOM_NAME, URANDOM_TIER, URANDOM_BPS,
        0, 0, 0, 1, 1,
        "IMPLEMENTED",
        URANDOM_VENDOR
    )
}

// ── Collect ─────────────────────────────────────────────────

fn rng_source_collect_urandom(n_bytes: int, seed: int) -> RngCollectResult {
    if n_bytes < 1 {
        return rng_result_fail("urandom: n_bytes must be >= 1")
    }
    let tmp = "/tmp/anima_rng_urandom_" + str(seed) + "_" + str(n_bytes) + ".bin"
    // 1. dd N bytes from /dev/urandom
    let cmd_dd = "dd if=/dev/urandom of=" + tmp + " bs=1 count=" + str(n_bytes) + " status=none 2>&1; echo OK"
    let _rc = exec(cmd_dd)
    // 2. od -An -v -tu1 → space-separated decimal bytes
    let cmd_od = "od -An -v -tu1 " + tmp + " | tr '\\n' ' '"
    let out = exec(cmd_od)
    // 3. parse byte stream (split on spaces, drop empties)
    let parts = out.split(" ")
    let mut bytes_ = []
    let mut i = 0
    while i < len(parts) {
        let p = parts[i]
        if len(p) > 0 {
            let b = to_int(p)
            if b >= 0 {
                if b <= 255 {
                    bytes_ = bytes_.push(b)
                }
            }
        }
        i = i + 1
    }
    // 4. sha256 (shasum on macOS, sha256sum on Linux/docker)
    let cmd_sha = "(shasum -a 256 " + tmp + " 2>/dev/null || sha256sum " + tmp + ") | awk '{print $1}'"
    let sha = exec(cmd_sha).trim()
    // 5. cleanup
    let _rc2 = exec("rm -f " + tmp + "; echo OK")
    if len(bytes_) != n_bytes {
        return rng_result_fail("urandom: byte count mismatch want=" + str(n_bytes) + " got=" + str(len(bytes_)))
    }
    return rng_result_ok(bytes_, sha, "urandom: ok")
}

// ── Selftest ────────────────────────────────────────────────

fn _selftest_urandom() -> int {
    let m = rng_source_meta_urandom()
    if m.name != "urandom" { return 0 }
    if m.tier != 0 { return 0 }
    if m.is_local != 1 { return 0 }
    if m.is_quantum != 0 { return 0 }
    let r = rng_source_collect_urandom(16, 42)
    if r.ok != 1 { return 0 }
    if r.n_bytes != 16 { return 0 }
    if len(r.bytes_) != 16 { return 0 }
    if len(r.sha256_hex) != 64 { return 0 }
    return 1
}

fn main() {
    println("[rng/urandom] system POSIX /dev/urandom source")
    if _selftest_urandom() == 1 {
        println("[rng/urandom] SELFTEST PASS")
    } else {
        println("[rng/urandom] SELFTEST FAIL")
    }
}
