// anima/modules/rng/ibm_q.hexa — IBM Quantum cloud QRNG (Tier 2 STUB)
//
// Stub interface for IBM Quantum Network. Real implementation requires:
//   to wire: qiskit-ibm-runtime SDK + IBM_QUANTUM_TOKEN auth + circuit submit
//
// raw#10:
//   (1) STUB only — collect always returns ok=0 with not_implemented reason.
//   (2) sister facade exists at anima-physics/quantum/cloud_real_ibm_q_facade.hexa
//       (4-gate contract), but it does Bell-state probe, not bulk byte collect.
//       Future wiring: extract bitstrings from `runtime.run(circuit, shots=N)`.
//   (3) Throughput estimate 100 bit/sec is conservative (per-shot ~10ms +
//       queue wait, free-tier).

// ── inline struct mirror (SSOT: anima/core/rng/source.hexa) ─

struct RngSourceMeta {
    name:           str,
    tier:           int,
    throughput_bps: int,
    cost_usd:       int,
    lead_days:      int,
    is_quantum:     int,
    is_local:       int,
    is_free:        int,
    status:         str,
    vendor:         str
}

struct RngCollectResult {
    ok:             int,
    n_bytes:        int,
    bytes_:         [int],
    sha256_hex:     str,
    message:        str
}

fn rng_meta_make(
    name: str, tier: int, throughput_bps: int, cost_usd: int,
    lead_days: int, is_quantum: int, is_local: int, is_free: int,
    status: str, vendor: str
) -> RngSourceMeta {
    return RngSourceMeta {
        name: name, tier: tier, throughput_bps: throughput_bps,
        cost_usd: cost_usd, lead_days: lead_days,
        is_quantum: is_quantum, is_local: is_local, is_free: is_free,
        status: status, vendor: vendor
    }
}

fn rng_result_fail(reason: str) -> RngCollectResult {
    return RngCollectResult { ok: 0, n_bytes: 0, bytes_: [], sha256_hex: "", message: reason }
}

// ── IBM Q meta ──────────────────────────────────────────────

let IBMQ_NAME      = "ibm_q"
let IBMQ_TIER      = 2
let IBMQ_BPS       = 100              // ~100 bit/sec sustained free-tier
let IBMQ_VENDOR    = "IBM_Quantum_Network_qiskit_runtime"

fn rng_source_meta_ibm_q() -> RngSourceMeta {
    return rng_meta_make(
        IBMQ_NAME, IBMQ_TIER, IBMQ_BPS,
        0,    // cost_usd (free tier; paid tiers exist)
        10,   // lead_days (~1-2 weeks: signup + token + queue access)
        1,    // is_quantum
        0,    // is_local
        1,    // is_free (free tier)
        "STUB",
        IBMQ_VENDOR
    )
}

fn rng_source_collect_ibm_q(n_bytes: int, seed: int) -> RngCollectResult {
    // to wire: import qiskit-ibm-runtime, run Bell-state circuit shots=n*8,
    // pack measurement outcomes into bytes, return.
    return rng_result_fail("ibm_q: STUB — qiskit-ibm-runtime SDK + IBM_QUANTUM_TOKEN required")
}

// ── Selftest (meta-only; collect returns fail by design) ────

fn _selftest_ibm_q() -> int {
    let m = rng_source_meta_ibm_q()
    if m.name != "ibm_q" { return 0 }
    if m.tier != 2 { return 0 }
    if m.status != "STUB" { return 0 }
    if m.is_quantum != 1 { return 0 }
    if m.is_local != 0 { return 0 }
    // Stub collect MUST fail with sentinel
    let r = rng_source_collect_ibm_q(8, 0)
    if r.ok != 0 { return 0 }
    if r.n_bytes != 0 { return 0 }
    if len(r.bytes_) != 0 { return 0 }
    return 1
}

fn main() {
    println("[rng/ibm_q] IBM Quantum cloud QRNG (Tier 2 STUB)")
    if _selftest_ibm_q() == 1 {
        println("[rng/ibm_q] SELFTEST PASS")
    } else {
        println("[rng/ibm_q] SELFTEST FAIL")
    }
}
