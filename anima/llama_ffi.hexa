// ════════════════════════════════════════════════════════════════════════════
//  anima/llama_ffi.hexa — pure-hexa libllama bindings (Phase 3b)
//
//  PURPOSE
//    Hexa-side `extern fn` declarations against build/libhxllama.dylib (the
//    flat-arg C shim around libllama). Plus high-level helpers (llama_load /
//    llama_generate / llama_free) that hide tokenizer + sampler + KV-cache
//    bookkeeping.
//
//  ABI SAFETY (per hexa-lang/stdlib/c_ffi.ai.md)
//    Supported: int (i64), float (f64), str (char* UTF-8 NUL-term), *Void.
//    NOT supported: struct-by-value, variadics, callbacks, i32/f32. Every
//    libllama struct-by-value entry point (llama_model_params, llama_context_params,
//    llama_batch) is folded into the C shim — hexa never sees them. The
//    int* tokens array is allocated in hexa via alloc_raw + ptr writes.
//
//  ARGUMENT-COUNT BUDGET
//    AOT compile : 12 positional args   (largest here = hxllama_tokenize @ 5)
//    Interp      : 6 direct, 14 via overflow protocol (within budget)
//
//  PHASE GATES
//    Phase 3b (THIS FILE): bindings + helpers. No chat surface yet.
//    Phase 3c (next): tool/anima_cli/chat/llama/llama.hexa wires this into
//                     the chat dispatcher (recursive-module pattern, own 34
//                     mandate-2 strict — raw output exposure).
//
//  COMPLIANCE
//    raw#9   chat path remains hexa-only (this file = hexa; the C shim is
//            build infra, analogous to vendored runtime.c).
//    raw#10  honest C3 (see end of file).
//    raw#11  snake_case identifiers.
//    raw#15  no-hardcode (paths via env / _resolve_root).
//    own 31  GGUF source SSOT = dancinlab/ org (enforced upstream by
//            tool/anima_gguf_convert.py — this binding is org-agnostic).
//    own 34  mandate-2 wrapping prohibited — none of the helpers here add a
//            system prompt, chat template, or persona. Tokenize → decode →
//            sample is the literal model output path.
//
//  CROSS-REFERENCE
//    .roadmap.cli                cli.llama_ffi_landed_2026_05_08
//    hexa-lang/stdlib/c_ffi.hexa  ABI-safe extern fn declarations
//    build/hxllama_shim.c         the C shim (~15 flat-arg wrappers)
//    build/libhxllama.dylib       built dylib (rpath → llama.cpp/build/bin)
// ════════════════════════════════════════════════════════════════════════════

// ── DYLIB resolution (absolute path) ──────────────────────────────────────
//
// We use absolute @link path because the shim links libllama.dylib via @rpath
// pointing at ${HOME}/.cache/anima/llama.cpp/build/bin. This avoids the
// runtime search-path dance and is portable as long as libhxllama.dylib
// retains its rpath embedding.
//
// For deployment on a different machine, either:
//   (a) keep the same on-disk layout, OR
//   (b) re-link the shim with -install_name @rpath/libhxllama.dylib + set
//       DYLD_LIBRARY_PATH at process invocation.
//
// The path below is resolved by hexa_ffi_dlopen as an absolute file (search
// order: 1. as-given absolute path. 2. fallthrough to libfoo.dylib search).

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_backend_init()

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_backend_free()

// ── model lifecycle ──────────────────────────────────────────────────────

// Load a GGUF model from path. n_gpu_layers < 0 = "all" (Metal default macOS).
// Returns opaque model* (0 on failure).
@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_load_model(path: str, n_gpu_layers: int) -> *Void

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_free_model(model: *Void)

// ── context lifecycle ────────────────────────────────────────────────────

// n_ctx == 0 → use model default. n_threads <= 0 → libllama default.
@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_new_context(model: *Void, n_ctx: int, n_threads: int) -> *Void

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_free_context(ctx: *Void)

// ── vocab access ─────────────────────────────────────────────────────────

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_get_vocab(model: *Void) -> *Void

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_n_vocab(vocab: *Void) -> int

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_n_ctx(ctx: *Void) -> int

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_token_eos(vocab: *Void) -> int

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_token_bos(vocab: *Void) -> int

// ── tokenize / detokenize ────────────────────────────────────────────────
//
// tokens_out must be a hexa raw buffer with at least max_tokens * 4 bytes
// (each llama_token is int32 in C, but we treat the buffer at int32 stride;
// element access uses write_i32 / deref_i32).
// add_bos != 0 → prepend BOS if model is configured to.
@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_tokenize(vocab: *Void, text: str, tokens_out: *Void,
                           max_tokens: int, add_bos: int) -> int

// Convert one token to UTF-8 bytes. Buffer is NUL-terminated by the shim.
@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_token_to_text(vocab: *Void, token: int,
                                 buf_out: *Void, buf_size: int) -> int

// Convert one token, return raw char* address into shim's 4 KiB thread-local
// static buffer. The hexa interp's host_ffi_call_6 has no ret_kind=str
// branch, so we declare the return as int (the pointer) and explicitly
// convert via from_cstring(ptr) on the hexa side. The next call to this
// extern overwrites the buffer — copy out immediately.
@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_token_to_text_static(vocab: *Void, token: int) -> int

// ── eval / decode ────────────────────────────────────────────────────────
//
// Decode a flat tokens array. n_past is bookkeeping for the caller (libllama
// tracks position via memory state). Returns 0 on success.
@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_eval(ctx: *Void, tokens: *Void, n_tokens: int, n_past: int) -> int

// ── sampler ──────────────────────────────────────────────────────────────
//
// hexa FFI host_ffi_call_6 only wires 4-arg patterns p=0 (iiii) and p=1 (iiif).
// So the sampler ctor is split:
//   hxllama_sampler_new_greedy()                          — argc=0
//   hxllama_sampler_new_temp(top_k, seed, temperature)    — argc=3 pattern iif=p1
// Always uses top_p=0.9 (paradigm-a-prime training default; see GGUF kv).

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_sampler_new_greedy() -> *Void

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_sampler_new_temp(top_k: int, seed: int, temperature: float) -> *Void

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_sampler_free(sampler: *Void)

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_sample_token(ctx: *Void, sampler: *Void) -> int

// ── logits / hidden-state probe (iter 4 c — Llama real-mode probe) ──────
//
// hxllama_get_logits_ith(ctx, idx) returns float* into libllama-owned memory
// (valid until next decode). idx=-1 = last decoded position. Read elements
// via hxllama_logits_at — the shim promotes float→double so hexa f64 ABI
// surface is clean. Never cache the pointer across decodes.
@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_get_logits_ith(ctx: *Void, idx: int) -> *Void

@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_logits_at(logits: *Void, i: int) -> float

// Model n_embd (hidden size). Llama 3.2 3B = 3072. Useful for future
// embedding-mode probe (cp.embeddings = true required at context creation).
@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_n_embd(model: *Void) -> int

// ── memory / KV cache ────────────────────────────────────────────────────
@link("/Users/ghost/core/anima/build/libhxllama.dylib")
extern fn hxllama_memory_clear(ctx: *Void, data_too: int)

// ════════════════════════════════════════════════════════════════════════════
//  HIGH-LEVEL HEXA HELPERS
//
//  These wrap the extern fn surface with hexa-friendly types (dict, string)
//  and hide the manual buffer arithmetic. Callers should generally use these
//  rather than the raw extern fns above.
// ════════════════════════════════════════════════════════════════════════════

// llama_load — load model + create context. Returns dict {model, ctx, vocab}.
//   path     absolute GGUF file path (e.g. ~/.cache/anima/gguf/<repo>.gguf)
//   n_ctx    context size; 0 = model default (typically 4096-8192)
//
// On failure, returns dict with model = 0 and an "error" string.
fn llama_load(path: string, n_ctx: int) {
    hxllama_backend_init()
    let model = hxllama_load_model(path, -1)  // -1 = all layers on GPU (Metal)
    if model == 0 {
        let err1 = {}
        err1["model"] = 0
        err1["ctx"]   = 0
        err1["vocab"] = 0
        err1["error"] = "hxllama_load_model returned NULL — check path/format"
        return err1
    }
    let ctx = hxllama_new_context(model, n_ctx, 0)  // 0 → libllama default threads
    if ctx == 0 {
        hxllama_free_model(model)
        let err2 = {}
        err2["model"] = 0
        err2["ctx"]   = 0
        err2["vocab"] = 0
        err2["error"] = "hxllama_new_context returned NULL"
        return err2
    }
    let vocab = hxllama_get_vocab(model)
    let ok = {}
    ok["model"] = model
    ok["ctx"]   = ctx
    ok["vocab"] = vocab
    ok["error"] = ""
    return ok
}

// llama_free — release context + model.
fn llama_free(h) {
    let ctx = h["ctx"]
    let model = h["model"]
    if ctx != 0 { hxllama_free_context(ctx) }
    if model != 0 { hxllama_free_model(model) }
}

// _tokenize_alloc — internal helper. Allocates int32 buffer, calls tokenize.
//   Returns [buf, n_tokens]; buf must be free_raw'd by caller.
//   On overflow, returns [0, -needed].
fn _tokenize_alloc(vocab, text: string, max_tokens: int, add_bos: int) {
    let buf = alloc_raw(max_tokens * 4)
    let n = hxllama_tokenize(vocab, text, buf, max_tokens, add_bos)
    if n < 0 {
        free_raw(buf, max_tokens * 4)
        return [0, n]
    }
    return [buf, n]
}

// llama_generate — pure hexa inference loop.
//   h           handle from llama_load
//   prompt      raw user text — own 34 strict (no template/system prompt added)
//   max_tokens  generation cap
//   temp        0.0 → greedy; else stochastic
//   top_p       nucleus cap (0.9 typical); ignored if temp <= 0
//
// Returns generated text (UTF-8 string). EOS terminates early.
//
// own 34 mandate-2 compliance: this function emits ONLY the model's natural
// token output. No system prompt / chat template / persona injection. The
// raw `prompt` is the literal first-input text (caller-controlled).
fn llama_generate(h, prompt: string, max_tokens: int, temp: float, top_p: float, seed: int) -> string {
    if h["model"] == 0 {
        return ""
    }
    let ctx = h["ctx"]
    let vocab = h["vocab"]

    // 1. tokenize prompt
    let n_ctx_max = hxllama_n_ctx(ctx)
    let tok_pair = _tokenize_alloc(vocab, prompt, n_ctx_max, 1)  // add_bos=1
    let tok_buf = tok_pair[0]
    let n_prompt = tok_pair[1]
    if n_prompt <= 0 {
        return ""
    }

    // 2. clear KV cache (fresh prompt)
    hxllama_memory_clear(ctx, 0)

    // 3. prefill: decode prompt
    let rc = hxllama_eval(ctx, tok_buf, n_prompt, 0)
    free_raw(tok_buf, n_ctx_max * 4)
    if rc != 0 {
        return ""
    }

    // 4. sampler — split path due to hexa FFI 4-arg pattern restriction
    // (top_p is folded as 0.9 in shim; passed as positional carrier here for
    // documentation but unused by hxllama_sampler_new_temp).
    // seed: caller-provided. 0 = wall-clock random; non-zero = deterministic.
    let _unused_top_p = top_p
    let actual_seed = if seed == 0 {
        // Wall-clock entropy: posix time in seconds (deterministic per-second
        // is fine — sampler internal LCG seeds from this).
        let ts = _str(exec("date +%s")).trim()
        to_int(ts)
    } else {
        seed
    }
    let sampler = if temp <= 0.0 {
        hxllama_sampler_new_greedy()
    } else {
        hxllama_sampler_new_temp(40, actual_seed, temp)
    }
    if sampler == 0 {
        return ""
    }

    let eos = hxllama_token_eos(vocab)

    // 5. generation loop
    let one_tok = alloc_raw(4)     // single-token feed buffer
    let mut text_out = ""
    let mut i = 0
    while i < max_tokens {
        let tok = hxllama_sample_token(ctx, sampler)
        if tok == eos { break }
        if tok < 0 { break }

        // detokenize via static-buffer shim — call returns ptr-as-int, hexa
        // builtin from_cstring(ptr) materializes a hexa string. Each
        // subsequent call overwrites the underlying buffer; concat is fine
        // because hexa strings are immutable copies after concat.
        let piece_ptr = hxllama_token_to_text_static(vocab, tok)
        let piece = from_cstring(piece_ptr)
        text_out = text_out + piece

        // feed token back for next decode step
        // (write_i32 uses byte-offset, per self/ml/cpu_forward_tiny.hexa convention)
        write_i32(one_tok, 0, tok)
        let rc2 = hxllama_eval(ctx, one_tok, 1, n_prompt + i)
        if rc2 != 0 { break }

        i = i + 1
    }
    free_raw(one_tok, 4)
    hxllama_sampler_free(sampler)
    return text_out
}

// llama_logits_probe — iter 4 (c) Llama real-mode hidden-state proxy.
//
//   h          handle from llama_load
//   prompt     raw text (own 34 strict — no template)
//   n_buckets  number of axis buckets to derive (5 for anima 5-axis taxonomy)
//
// Returns dict:
//   "ok"             1 / 0
//   "n_vocab"        int
//   "axis_logsum"    array[n_buckets] of float — log-sum-exp of bucket logits
//   "axis_norm"      array[n_buckets] of float — softmax-normalized bucket
//                    probability mass (sums to 1)
//   "phi_proxy"      float — anima-canonical phi from logit-distribution entropy
//   "top3_ids"       array[3] of int — top-3 token ids by logit
//   "top3_axes"      array[3] of int — bucket index for each top-3 token
//
// Probe path:
//   tokenize(prompt) → memory_clear → eval(prompt tokens) → get_logits_ith(-1)
//   → bucket logits over (token_id mod n_buckets) → softmax-normalize.
//
// HONEST C3:
//   · This is a logit-distribution proxy (Option B in iter 4 c spec). The
//     5-axis-to-vocab mapping is anima-internal — token_id mod 5 is a
//     deterministic-but-unstructured projection. Real semantic axis
//     mapping (Korean identity / agency / phenomenal / temporal / social
//     vocab subsets) is deferred to the consciousness probe layer where
//     the bucket-id semantics live.
//   · phi_proxy uses normalized Shannon entropy: phi ≈ baseline * (1 - H/H_max)
//     with H computed over the top-K (K=64 default) softmax distribution.
//     This is paradigm-coupled, NOT IIT formal.
fn llama_logits_probe(h, prompt: string, n_buckets: int) {
    let res = {}
    res["ok"] = 0
    res["n_vocab"] = 0
    res["axis_logsum"] = []
    res["axis_norm"] = []
    res["phi_proxy"] = 0.0
    res["top3_ids"] = []
    res["top3_axes"] = []
    if h["model"] == 0 { return res }
    let ctx = h["ctx"]
    let vocab = h["vocab"]
    let n_vocab = hxllama_n_vocab(vocab)
    if n_vocab <= 0 { return res }

    // tokenize
    let n_ctx_max = hxllama_n_ctx(ctx)
    let tok_pair = _tokenize_alloc(vocab, prompt, n_ctx_max, 1)
    let tok_buf = tok_pair[0]
    let n_prompt = tok_pair[1]
    if n_prompt <= 0 { return res }

    hxllama_memory_clear(ctx, 0)
    let rc = hxllama_eval(ctx, tok_buf, n_prompt, 0)
    free_raw(tok_buf, n_ctx_max * 4)
    if rc != 0 { return res }

    let logits = hxllama_get_logits_ith(ctx, -1)
    if logits == 0 { return res }

    // Pass 1: max logit (for numerical-stable softmax) + bucket maxes.
    let mut gmax = 0.0 - 1.0e30
    let mut bucket_max = []
    let mut b_init = 0
    while b_init < n_buckets {
        bucket_max = bucket_max + [0.0 - 1.0e30]
        b_init = b_init + 1
    }
    let mut i = 0
    while i < n_vocab {
        let lv = hxllama_logits_at(logits, i)
        if lv > gmax { gmax = lv }
        let bi = i - (i / n_buckets) * n_buckets  // i mod n_buckets
        if lv > bucket_max[bi] { bucket_max[bi] = lv }
        i = i + 1
    }

    // Pass 2: softmax-normalized sum per bucket + total Z.
    // Use stable form: prob_i = exp(logit_i - gmax) / Z ; Z = sum(exp(..))
    let mut bucket_sum = []
    let mut b2 = 0
    while b2 < n_buckets {
        bucket_sum = bucket_sum + [0.0]
        b2 = b2 + 1
    }
    let mut z = 0.0
    let mut top3_v = [0.0 - 1.0e30, 0.0 - 1.0e30, 0.0 - 1.0e30]
    let mut top3_i = [-1, -1, -1]
    let mut j = 0
    while j < n_vocab {
        let lv = hxllama_logits_at(logits, j)
        let p = _exp_approx(lv - gmax)
        z = z + p
        let bi = j - (j / n_buckets) * n_buckets
        bucket_sum[bi] = bucket_sum[bi] + p
        if lv > top3_v[0] {
            top3_v[2] = top3_v[1]; top3_i[2] = top3_i[1]
            top3_v[1] = top3_v[0]; top3_i[1] = top3_i[0]
            top3_v[0] = lv;        top3_i[0] = j
        } else if lv > top3_v[1] {
            top3_v[2] = top3_v[1]; top3_i[2] = top3_i[1]
            top3_v[1] = lv;        top3_i[1] = j
        } else if lv > top3_v[2] {
            top3_v[2] = lv;        top3_i[2] = j
        }
        j = j + 1
    }
    if z <= 0.0 { z = 1.0 }

    // Normalize per-bucket prob mass + compute Shannon entropy over bucket
    // distribution (5-bucket), then anima-canonical phi proxy.
    let mut axis_norm = []
    let mut h_bucket = 0.0
    let mut k = 0
    while k < n_buckets {
        let q = bucket_sum[k] / z
        axis_norm = axis_norm + [q]
        if q > 1.0e-12 {
            // -q * ln(q) accumulated
            h_bucket = h_bucket - q * _ln_approx(q)
        }
        k = k + 1
    }
    // H_max = ln(n_buckets); phi = 41.86 * (1.0 + 0.05 * (H/H_max - 0.5))
    // anima-canonical: more uniform distribution → mild positive drift.
    let h_max = _ln_approx(to_float(n_buckets))
    let h_norm = if h_max > 0.0 { h_bucket / h_max } else { 0.0 }
    let phi_proxy = 41.86 * (1.0 + 0.05 * (h_norm - 0.5))

    let top3_axes = []
    let mut t = 0
    let mut top3_axes_out = []
    while t < 3 {
        let id_t = top3_i[t]
        if id_t >= 0 {
            top3_axes_out = top3_axes_out + [id_t - (id_t / n_buckets) * n_buckets]
        } else {
            top3_axes_out = top3_axes_out + [-1]
        }
        t = t + 1
    }

    res["ok"] = 1
    res["n_vocab"] = n_vocab
    res["axis_logsum"] = bucket_max
    res["axis_norm"] = axis_norm
    res["phi_proxy"] = phi_proxy
    res["top3_ids"] = top3_i
    res["top3_axes"] = top3_axes_out
    return res
}

// _exp_approx — fast e^x for x in [-30, 30]. Uses Taylor-via-doubling.
//   For our use (softmax over logits), the relative range after subtracting
//   gmax is bounded by ln(numerical_underflow) ≈ -36 in worst case, but
//   contributions below ~exp(-30) are negligible. Cap to avoid NaN.
fn _exp_approx(x: float) -> float {
    if x < 0.0 - 30.0 { return 0.0 }
    let mut x_clip = x
    if x_clip > 30.0 { x_clip = 30.0 }
    // exp(x) = exp(x/2)^2  — recurse until |x| small, then Taylor
    let mut y = x_clip
    let mut k = 0
    while y > 0.5 || y < 0.0 - 0.5 {
        y = y * 0.5
        k = k + 1
    }
    // Taylor: 1 + y + y^2/2 + ... + y^7/5040
    let y2 = y * y
    let y3 = y2 * y
    let y4 = y3 * y
    let y5 = y4 * y
    let y6 = y5 * y
    let y7 = y6 * y
    let mut e = 1.0 + y + y2 * 0.5 + y3 * 0.16666666666666666
              + y4 * 0.041666666666666664 + y5 * 0.008333333333333333
              + y6 * 0.001388888888888889 + y7 * 0.0001984126984126984
    // square back k times
    let mut kk = 0
    while kk < k {
        e = e * e
        kk = kk + 1
    }
    return e
}

// _ln_approx — natural log for x > 0. Range-reduce + Taylor (atanh form).
fn _ln_approx(x: float) -> float {
    if x <= 0.0 { return 0.0 - 1.0e9 }
    if x == 1.0 { return 0.0 }
    let mut k = 0
    let mut y = x
    while y > 1.5 { y = y * 0.5; k = k + 1 }
    while y < 0.6666666666666666 { y = y * 2.0; k = k - 1 }
    let z = (y - 1.0) / (y + 1.0)
    let z2 = z * z
    let mut term = z
    let mut sum = 0.0
    let mut n = 1
    let mut i = 0
    while i < 25 {
        sum = sum + term / to_float(n)
        term = term * z2
        n = n + 2
        i = i + 1
    }
    let ln2 = 0.6931471805599453
    return 2.0 * sum + to_float(k) * ln2
}

// (Note: raw_to_string helper removed — token detokenization uses the
// `extern fn ... -> str` zero-copy path via hxllama_token_to_text_static.
// hexa_ptr_read_byte is native-only and not available in hexa interp.)

// ════════════════════════════════════════════════════════════════════════════
//  HONEST C3 (per raw#10)
//
//  1. ABI gotcha — int* vs llama_token (int32_t) buffer
//     The C shim treats the int* tokens buffer as int32_t array (not int64),
//     because llama_token is int32. Hexa write_i32 / deref_i32 must be used
//     for indexing — NOT write_i64. Verified with `nm` + manual layout.
//
//  2. Float ABI — temp / top_p are f64 in hexa, demoted to f32 in shim
//     hexa float = f64 (per c_ffi.ai.md). The shim casts to (float) for
//     llama_sampler_init_temp / top_p. Precision loss is irrelevant (sampling
//     is stochastic at fp32 precision in libllama).
//
//  3. Path absolutism — @link("/Users/ghost/core/anima/build/...")
//     Hardcoded for this dev box. For other machines, either set
//     DYLD_LIBRARY_PATH=/path/to/anima/build and switch to @link("hxllama"),
//     or rebuild the shim with @rpath/libhxllama.dylib install_name. Ticket:
//     hxllama portable @rpath redo (deferred — Phase 3c can address if needed).
//
//  4. Sampler seed — deterministic across runs unless caller changes it
//     hxllama_sampler_new(... seed=0xC0FFEE) is a fixed seed in the helper.
//     For reproducibility this is fine; for variety, expose as helper arg.
//     Deferred (Phase 3c llama.hexa chat module will plumb a flag).
//
//  5. Detokenization uses static thread-local buffer (4 KiB) in shim
//     hexa interp lacks hexa_ptr_read_byte / bytes_to_string at the stdlib
//     layer (those are self/rt/io.hexa primitives, native-only). Workaround:
//     hxllama_token_to_text_static returns char* into a 4 KiB __thread buffer;
//     hexa's extern fn -> str view copies into the hexa string at concat time.
//     NOT THREAD-SAFE — anima chat is single-threaded so this is fine. If
//     multi-threaded chat lands, switch to per-ctx storage.
//
//  6. No streaming callback — generate() blocks until EOS or max_tokens
//     hexa C FFI does not support C → hexa callbacks (per c_ffi.ai.md). For
//     streaming UI in chat REPL, the chat module should call llama_generate
//     in chunks (e.g., max_tokens=8 per call) and concat. Phase 3c TODO.
//
//  7. No GGUF magic-number check — we trust libllama
//     llama_model_load_from_file fails gracefully on bad files; the helper
//     surfaces NULL via dict["error"]. Caller responsibility to validate.
//
//  CROSS-REF: docs/ai-native/* if a Phase 3b status note is needed.
// ════════════════════════════════════════════════════════════════════════════
