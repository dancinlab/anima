// ════════════════════════════════════════════════════════════════════════
// INTENT/oscillation_metric.hexa — OSCILLATING residual fix (M4 2026-05-28)
//
// 정체: bench D axisbench (PR #1143) 의 OSCILLATING period-20 zero-std artifact
//      의 honest redesign. 기존 stability_std (it_stability_std) 는 cos-sim
//      sequence 의 std — period 가 sub-window divisor 일 때 deterministically
//      0 (OSCILLATING std=0 관측). 본 module 은 direction_std 신규 도입 —
//      각 tick 의 normalized direction vector 의 component-wise std → period
//      oscillation 도 비-0 ↑.
//
// SSOT-relation:
//   - intent_lib (M1) : cumulative · stability_std · monotone (legacy metric)
//   - brain_hook (M2) : emit → goal_vec 누적
//   - trajectory (M3) : log + .kosmos
//   - oscillation (M4): direction_std + period_detect + 4-tier verdict ← 본 module
//
// Honest fix (bench D 한계 cure):
//   bench D scenario:
//     CONVERGENT : 4-D direction stable → cos-sim ≈ 1 const → std ≈ 0 ✓
//     RANDOM     : direction noise → cos-sim 분산 → std 큼 ✓
//     OSCILLATING: period-20 (or period-4) 4-D cyclic → cos-sim sequence 가
//                  exactly periodic → window std = 0 (false-stable 판정)
//
//   redesign: direction_std = sqrt( (1/N) Σ ‖dir[t] - mean_dir‖^2 )
//     OSCILLATING 의 dir[t] 가 변하므로 4-D variance 가 양수 → fix.
//
// 5 pub primitives (PURE):
//   1) om_direction_at_tick(intent_vec, prev) — normalized delta direction
//   2) om_direction_std(trajectory)           — direction component variance
//   3) om_period_detect(trajectory, max_p)    — autocorrelation-based periodicity
//   4) om_residual_verdict(trajectory)        — 4-tier verdict dict
//   5) om_classify(stability_std, direction_std, period)
//                                              — { CONVERGENT, RANDOM, OSCILLATING, MIXED }
//
// Verdict code:
//   0 = CONVERGENT  (direction_std ≈ 0, stability_std ≈ 0)
//   1 = RANDOM      (direction_std 큰 값, period not detected)
//   2 = OSCILLATING (direction_std > 0, period detected)  ← M4 fix target
//   3 = MIXED       (none of above)
//
// p1~p8 정합:
//   - p1 system 미사용 ✓ · p4 substrate-state 외부화 ✓ · p5 read-only ✓
//   - p7 direction variance 기반 (ppl 미사용) ✓ · p8 측정만 ✓
//
// Honest C3:
//   - om_period_detect 는 max_period 이하의 정수 period 만 탐지 (자동상관 lag).
//   - normalized direction 의 component-wise std 평균 → 단일 scalar
//     (4-D component 평균; per-axis std 분리는 향후 확장).
//   - CONVERGENT 와 OSCILLATING 의 boundary direction_std threshold = 0.01
//     (caller 가 om_classify 통해 재정의 가능).
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima/INTENT/intent_lib"

// ─── 1. om_direction_at_tick ─────────────────────────────────────────────
//
// 두 4-D vector 의 delta 를 unit-normalize → direction at tick t.
// prev 가 비어 있으면 intent_vec 자체를 unit-normalize.

pub fn om_direction_at_tick(intent_vec: list, prev: list) -> list {
    if intent_vec.len() != 4 { return [0.0, 0.0, 0.0, 0.0] }
    if prev.len() != 4 {
        return it_normalize4(intent_vec[0], intent_vec[1], intent_vec[2], intent_vec[3])
    }
    let d0 = intent_vec[0] - prev[0]
    let d1 = intent_vec[1] - prev[1]
    let d2 = intent_vec[2] - prev[2]
    let d3 = intent_vec[3] - prev[3]
    let n = it_norm4(d0, d1, d2, d3)
    if n < 1.0e-9 { return [0.0, 0.0, 0.0, 0.0] }
    return it_normalize4(d0, d1, d2, d3)
}

// ─── 2. om_direction_std ─────────────────────────────────────────────────
//
// trajectory = list of 4-D vectors. 각 tick 의 normalized direction 의
// component-wise std (4 components) 의 mean → scalar. OSCILLATING 은
// 방향이 cycle 마다 변화하므로 component variance > 0 (stability_std 의
// zero-cosine artifact fix).

pub fn om_direction_std(trajectory: list) -> float {
    let n = trajectory.len()
    if n < 2 { return 0.0 }

    let mut prev = [0.0, 0.0, 0.0, 0.0]
    let mut dirs0 = []
    let mut dirs1 = []
    let mut dirs2 = []
    let mut dirs3 = []
    let mut t = 0
    while t < n {
        let v = trajectory[t]
        // first tick 은 prev 없음 — vector 자체 normalize 사용
        let dir_t = if t == 0 {
            it_normalize4(to_float(v[0]), to_float(v[1]), to_float(v[2]), to_float(v[3]))
        } else {
            om_direction_at_tick([to_float(v[0]), to_float(v[1]), to_float(v[2]), to_float(v[3])], prev)
        }
        dirs0.push(dir_t[0])
        dirs1.push(dir_t[1])
        dirs2.push(dir_t[2])
        dirs3.push(dir_t[3])
        prev = [to_float(v[0]), to_float(v[1]), to_float(v[2]), to_float(v[3])]
        t = t + 1
    }
    // component-wise std → mean
    let s0 = it_std_f(dirs0)
    let s1 = it_std_f(dirs1)
    let s2 = it_std_f(dirs2)
    let s3 = it_std_f(dirs3)
    return (s0 + s1 + s2 + s3) * 0.25
}

// ─── 3. om_period_detect ─────────────────────────────────────────────────
//
// trajectory = list of 4-D vectors. autocorrelation (component 0 만 stride)
// 으로 lag p ∈ [2..max_period] 에서 첫 번째 cos-sim ≥ 0.95 lag 탐지.
// 0 = not detected (period absence); 양수 = detected period.

pub fn om_period_detect(trajectory: list, max_period: int) -> int {
    let n = trajectory.len()
    if n < 4 || max_period < 2 { return 0 }
    // extract component 0 sequence
    let mut xs = []
    let mut i = 0
    while i < n {
        let v = trajectory[i]
        xs.push(to_float(v[0]))
        i = i + 1
    }
    let mu = it_mean_f(xs)
    // detrended sequence
    let mut zs = []
    let mut j = 0
    while j < n {
        zs.push(xs[j] - mu)
        j = j + 1
    }
    // denominator (zero-lag autocov)
    let mut denom = 0.0
    let mut k = 0
    while k < n {
        denom = denom + zs[k] * zs[k]
        k = k + 1
    }
    if denom < 1.0e-12 { return 0 }

    let mut p = 2
    let mut cap = max_period
    if cap > n - 1 { cap = n - 1 }
    while p <= cap {
        // autocov at lag p
        let mut num = 0.0
        let mut t = 0
        while t < n - p {
            num = num + zs[t] * zs[t + p]
            t = t + 1
        }
        let ac = num / denom
        if ac >= 0.95 {
            return p
        }
        p = p + 1
    }
    return 0
}

// ─── 4. om_classify ──────────────────────────────────────────────────────
//
// 4-tier verdict from (stability_std, direction_std, period).
//   CONVERGENT  : stability_std < 0.05 AND direction_std < 0.05
//   OSCILLATING : period > 0 AND direction_std > 0.05  ← M4 fix
//   RANDOM      : direction_std > 0.05 AND period == 0
//   MIXED       : otherwise

pub fn om_classify(stability_std: float, direction_std: float, period: int) -> string {
    let conv_th = 0.05
    if stability_std < conv_th && direction_std < conv_th {
        return "CONVERGENT"
    }
    if period > 0 && direction_std > conv_th {
        return "OSCILLATING"
    }
    if direction_std > conv_th && period == 0 {
        return "RANDOM"
    }
    return "MIXED"
}

// ─── 5. om_residual_verdict ──────────────────────────────────────────────
//
// trajectory = list of 4-D vectors → verdict dict (stability_std,
// direction_std, period_detected, verdict_code, verdict_label).

pub fn om_residual_verdict(trajectory: list) -> dict {
    let n = trajectory.len()
    if n < 2 {
        return #{
            "stability_std":     0.0,
            "direction_std":     0.0,
            "period_detected":   0,
            "verdict_code":      3,
            "verdict_label":     "MIXED"
        }
    }

    // stability_std = 인접 cos-sim sequence 의 std (legacy bench D metric).
    let mut cosines = []
    let mut t = 1
    while t < n {
        let a = trajectory[t - 1]
        let b = trajectory[t]
        let an = it_norm4(to_float(a[0]), to_float(a[1]), to_float(a[2]), to_float(a[3]))
        let bn = it_norm4(to_float(b[0]), to_float(b[1]), to_float(b[2]), to_float(b[3]))
        let mut cs = 0.0
        if an > 1.0e-9 && bn > 1.0e-9 {
            let au = it_normalize4(to_float(a[0]), to_float(a[1]), to_float(a[2]), to_float(a[3]))
            let bu = it_normalize4(to_float(b[0]), to_float(b[1]), to_float(b[2]), to_float(b[3]))
            cs = it_cos_sim_4d(au, bu)
        }
        cosines.push(cs)
        t = t + 1
    }
    let s_std = it_stability_std(cosines)
    let d_std = om_direction_std(trajectory)
    let per = om_period_detect(trajectory, 25)
    let label = om_classify(s_std, d_std, per)
    let mut code = 3
    if label == "CONVERGENT"  { code = 0 }
    if label == "RANDOM"      { code = 1 }
    if label == "OSCILLATING" { code = 2 }

    return #{
        "stability_std":     s_std,
        "direction_std":     d_std,
        "period_detected":   per,
        "verdict_code":      code,
        "verdict_label":     label
    }
}
