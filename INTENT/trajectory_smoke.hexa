// ════════════════════════════════════════════════════════════════════════
// INTENT/trajectory_smoke.hexa — goal trajectory log invariant smoke
//
// 정체: INTENT/trajectory.hexa 의 4 pub primitives (tr_log_decision ·
//      tr_trajectory · tr_convergence_metric · tr_kosmos_anchor) invariant
//      검증.
//
// Invariants (6):
//   I1: tr_log_decision 의 magnitude == it_norm4(intent_delta) (consistent)
//   I2: tr_trajectory window 추출 inclusive boundary 양끝 포함
//   I3: tr_convergence_metric([asc magnitudes]) == 1.0 (monotone up)
//   I4: tr_kosmos_anchor 가 7 key 출력 (snapshot_id · lane · coord · tension_5ch
//        · radius · tier · trajectory)
//   I5: kosmos_anchor.tension_5ch.len() == 5 (5-ch spec)
//   I6: kosmos_anchor.coord.len() == 2 ([mag_mean, convergence])
// ════════════════════════════════════════════════════════════════════════

use "INTENT/trajectory"
use "INTENT/intent_lib"

fn absf(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn mk_emit(mot: float, phi: float, tier: int, emit: bool) -> dict {
    return #{
        "motivation": mot,
        "phi":        phi,
        "tier":       tier,
        "emit":       emit
    }
}

fn main() {
    println("=== INTENT/trajectory_smoke ===")

    // ─── I1 log_decision magnitude consistency ──────────────────────────
    let e1 = mk_emit(0.6, 0.5, 2, true)
    let delta = [0.3, 0.4, 0.0, 0.0]  // norm = 0.5
    let entry1 = tr_log_decision(e1, delta, 100)
    let m1 = to_float(entry1["magnitude"])
    let expected_m = it_norm4(0.3, 0.4, 0.0, 0.0)
    let i1 = absf(m1 - expected_m) < 1.0e-9

    // ─── I2 trajectory window inclusive ─────────────────────────────────
    let log = [
        tr_log_decision(e1, [0.1, 0.0, 0.0, 0.0], 100),
        tr_log_decision(e1, [0.2, 0.0, 0.0, 0.0], 200),
        tr_log_decision(e1, [0.3, 0.0, 0.0, 0.0], 300),
        tr_log_decision(e1, [0.4, 0.0, 0.0, 0.0], 400)
    ]
    let win = tr_trajectory(log, 100, 300)
    // expects entries at ts=100,200,300 = 3 entries
    let i2 = win.len() == 3

    // ─── I3 convergence monotone up ─────────────────────────────────────
    // log already ascending magnitudes (0.1, 0.2, 0.3, 0.4) → monotone_ratio = 1.0
    let conv = tr_convergence_metric(log)
    let i3 = absf(conv - 1.0) < 1.0e-9

    // ─── I4 kosmos_anchor 7 keys ────────────────────────────────────────
    let anchor = tr_kosmos_anchor(log)
    let has_sid    = anchor["snapshot_id"] != void
    let has_lane   = anchor["lane"]        != void
    let has_coord  = anchor["coord"]       != void
    let has_t5     = anchor["tension_5ch"] != void
    let has_rad    = anchor["radius"]      != void
    let has_tier   = anchor["tier"]        != void
    let has_traj   = anchor["trajectory"]  != void
    let i4 = has_sid && has_lane && has_coord && has_t5 && has_rad && has_tier && has_traj

    // ─── I5 tension_5ch len = 5 ─────────────────────────────────────────
    let t5 = anchor["tension_5ch"]
    let i5 = t5.len() == 5

    // ─── I6 coord len = 2 ───────────────────────────────────────────────
    let cd = anchor["coord"]
    let i6 = cd.len() == 2

    println("I1  log_decision magnitude  " + (if i1 { "PASS" } else { "FAIL" }))
    println("I2  window inclusive bounds " + (if i2 { "PASS (" + str(win.len()) + ")" } else { "FAIL" }))
    println("I3  convergence monotone up " + (if i3 { "PASS" } else { "FAIL" }))
    println("I4  kosmos_anchor 7 keys    " + (if i4 { "PASS" } else { "FAIL" }))
    println("I5  tension_5ch len=5       " + (if i5 { "PASS" } else { "FAIL" }))
    println("I6  coord len=2             " + (if i6 { "PASS" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (6/6)" } else { "INVARIANT FAILURE" })
}
