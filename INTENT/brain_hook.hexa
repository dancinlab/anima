// ════════════════════════════════════════════════════════════════════════
// INTENT/brain_hook.hexa — brain_decide 위 long-term goal hook (M2 2026-05-28)
//
// 정체: CORE.brain_decide(short-term emit decision) 위의 long-term goal
//      formation layer. 단기 emit 마다 goal_vec (4-D direction) 을 누적 ·
//      decay window 를 적용해 며칠 단위 trajectory 형성. INTENT/intent_lib
//      (12 it_* primitives) 위의 PURE wrapper.
//
// SSOT-relation:
//   - 아래 layer (intent_lib): cumulative + decay + stability + monotone
//   - 본 layer (brain_hook)  : emit-dict → goal_vec update + short↔long coupling
//   - 위 layer (M3 trajectory): emit-별 INTENT delta log + .kosmos 영속화
//
// 4 pub primitives (PURE, no global mutation):
//   1) bh_register_emit(emit, goal_vec, decay_h)  — emit 마다 goal_vec 4-D 갱신
//   2) bh_long_term_goal(history, window)         — cumulative_intent + decay
//   3) bh_short_long_coupling(short, long)        — short emit ↔ long goal alignment
//   4) bh_goal_drift(prev_goal, current_goal)     — L2 distance
//
// emit dict 스키마 (CORE.brain_decide 결과):
//   { "emit": bool, "motivation": float, "phi": float,
//     "tier": int, "phase": string, ... }
//   → intent vector 4-D 추출 매핑:
//     v[0] = motivation        (0..1 scalar)
//     v[1] = phi               (0..1+ Φ)
//     v[2] = float(tier) / 3.0 (0..1 phase tier normalized)
//     v[3] = emit_indicator    (1.0 if emit else 0.0)
//
// p1~p8 정합:
//   - p1 NO SYSTEM PROMPT  : 4-D float arithmetic, system 미사용 ✓
//   - p4 NO ASSISTANT FRAMING: emit-dict 는 substrate state 의 외부화 ✓
//   - p5 NO SPEAK()        : read-only goal layer, 외부 emit 호출 0 ✓
//   - p7 NO PERPLEXITY VERDICT: cos-sim/L2/decay 기반, ppl 미사용 ✓
//   - p8 NO TRAIN/INFER    : 측정/누적만, weight update 0 ✓
//
// Honest C3:
//   - emit dict → 4-D vector 매핑은 4 substrate signal 의 1-shot projection,
//     domain-specific axis (relevance · originality · curiosity 등) full
//     8-factor 는 M2 next-iter 잔여 (factor expansion).
//   - long_term_goal 의 window cap = history.len() (window > len 보정 안 함;
//     caller 책임).
// ════════════════════════════════════════════════════════════════════════

use "INTENT/intent_lib"

// ─── helper: emit dict → 4-D intent vector ───────────────────────────────

pub fn bh_emit_to_vec(emit: dict) -> list {
    let mot = to_float(emit["motivation"])
    let phi = to_float(emit["phi"])
    let tier_i = to_int(emit["tier"])
    let emitted = emit["emit"]
    let ti = float(tier_i) / 3.0
    let mut ei = 0.0
    if emitted { ei = 1.0 }
    return [mot, phi, ti, ei]
}

// ─── 1. bh_register_emit ─────────────────────────────────────────────────
//
// emit 1번을 goal_vec 에 누적. decay_h (half-life ticks) 로 직전 goal_vec 을
// 약화 후 새 emit vector 를 더한다.
//
//   goal_vec_new[i] = goal_vec[i] * decay_factor(decay_h) + emit_vec[i]
//     decay_factor = 1 / (1 + 1/decay_h)  (it_decay_weight(1, decay_h))
//
// 직관: half_life 가 클수록 직전 goal 유지 ↑ (장기 누적); 작을수록 emit 반응 ↑.

pub fn bh_register_emit(emit: dict, goal_vec: list, decay_h: float) -> list {
    let ev = bh_emit_to_vec(emit)
    // single-tick decay factor (decay_h <= 0 → no decay)
    let mut df = 1.0
    if decay_h > 0.0 { df = it_decay_weight(1, decay_h) }
    // boundary: goal_vec 이 비어 있으면 emit vector 자체로 시작
    let gn = goal_vec.len()
    if gn == 0 { return ev }
    if gn != 4 { return ev }
    return [
        goal_vec[0] * df + ev[0],
        goal_vec[1] * df + ev[1],
        goal_vec[2] * df + ev[2],
        goal_vec[3] * df + ev[3]
    ]
}

// ─── 2. bh_long_term_goal ────────────────────────────────────────────────
//
// history = list of emit dict (시계열). 최근 `window` ticks 에 대해 decay-weighted
// cumulative goal vector 산출. emit_vec[t] * it_decay_weight(window-1-t, half_life)
// 합산 → 끝쪽 (최신) 일수록 가중치 ↑.

pub fn bh_long_term_goal(history: list, window: int) -> list {
    let n = history.len()
    if n == 0 || window <= 0 { return [0.0, 0.0, 0.0, 0.0] }
    let mut w = window
    if w > n { w = n }
    // half-life 는 window 의 절반 (직관적 decay 폭)
    let mut hl = float(w) * 0.5
    if hl < 1.0 { hl = 1.0 }
    let mut acc0 = 0.0
    let mut acc1 = 0.0
    let mut acc2 = 0.0
    let mut acc3 = 0.0
    let start = n - w
    let mut t = 0
    while t < w {
        let emit = history[start + t]
        let ev = bh_emit_to_vec(emit)
        // age = how far back from latest (latest = 0)
        let age = w - 1 - t
        let wt = it_decay_weight(age, hl)
        acc0 = acc0 + ev[0] * wt
        acc1 = acc1 + ev[1] * wt
        acc2 = acc2 + ev[2] * wt
        acc3 = acc3 + ev[3] * wt
        t = t + 1
    }
    return [acc0, acc1, acc2, acc3]
}

// ─── 3. bh_short_long_coupling ───────────────────────────────────────────
//
// short emit (single dict) ↔ long goal (4-D vector) alignment scalar.
// cos similarity of unit-normalized vectors → [-1, 1] (양 vector unit norm 후).
// 둘 중 하나의 norm 이 0 이면 0.0 반환.

pub fn bh_short_long_coupling(short: dict, long: list) -> float {
    if long.len() != 4 { return 0.0 }
    let sv = bh_emit_to_vec(short)
    let s_norm = it_norm4(sv[0], sv[1], sv[2], sv[3])
    let l_norm = it_norm4(long[0], long[1], long[2], long[3])
    if s_norm < 1.0e-9 { return 0.0 }
    if l_norm < 1.0e-9 { return 0.0 }
    let su = it_normalize4(sv[0], sv[1], sv[2], sv[3])
    let lu = it_normalize4(long[0], long[1], long[2], long[3])
    return it_cos_sim_4d(su, lu)
}

// ─── 4. bh_goal_drift ────────────────────────────────────────────────────
//
// L2 distance between two 4-D goal vectors. drift = 작을수록 안정.

pub fn bh_goal_drift(prev_goal: list, current_goal: list) -> float {
    if prev_goal.len() != 4 { return 0.0 }
    if current_goal.len() != 4 { return 0.0 }
    let d0 = prev_goal[0] - current_goal[0]
    let d1 = prev_goal[1] - current_goal[1]
    let d2 = prev_goal[2] - current_goal[2]
    let d3 = prev_goal[3] - current_goal[3]
    return it_norm4(d0, d1, d2, d3)
}
