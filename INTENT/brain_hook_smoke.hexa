// ════════════════════════════════════════════════════════════════════════
// INTENT/brain_hook_smoke.hexa — brain_decide hook 의 long-term goal 누적 smoke
//
// 정체: INTENT/brain_hook.hexa 의 4 pub primitives (bh_register_emit ·
//      bh_long_term_goal · bh_short_long_coupling · bh_goal_drift) 의
//      invariant 검증. emit dict 시뮬레이션 으로 단기→장기 누적/coupling 측정.
//
// Invariants (7):
//   I1: bh_register_emit(emit, []) 가 emit_vec 자체로 시작 (boundary)
//   I2: decay_h 가 클수록 직전 goal_vec 보존 비율 ↑ (monotone)
//   I3: bh_long_term_goal 의 결과 norm > 0 (non-empty history)
//   I4: bh_short_long_coupling([emit-self], [emit-self]) ≈ 1.0 (self-align)
//   I5: bh_short_long_coupling 결과 ∈ [-1, 1] (cos-sim 범위)
//   I6: bh_goal_drift(g, g) == 0.0 (self-distance 0)
//   I7: bh_goal_drift triangle inequality direction (drift ≥ 0)
// ════════════════════════════════════════════════════════════════════════

use "INTENT/brain_hook"

fn absf(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn mk_emit(mot: float, phi: float, tier: int, emit: bool) -> dict {
    return #{
        "motivation": mot,
        "phi":        phi,
        "tier":       tier,
        "emit":       emit
    }
}

fn main() {
    println("=== INTENT/brain_hook_smoke ===")

    // emit 1: medium motivation, T2, emit=true
    let e1 = mk_emit(0.7, 0.5, 2, true)
    // emit 2: lower motivation, T1, emit=false
    let e2 = mk_emit(0.3, 0.4, 1, false)
    // emit 3: high, T3, emit=true
    let e3 = mk_emit(0.9, 0.7, 3, true)

    // ─── I1 register_emit boundary (empty goal) ─────────────────────────
    let g_seed = bh_register_emit(e1, [], 5.0)
    let i1 = g_seed.len() == 4 && absf(g_seed[0] - 0.7) < 1.0e-9

    // ─── I2 decay monotone (longer half-life → more retention) ─────────
    let g_prev = [1.0, 1.0, 1.0, 1.0]
    let g_short = bh_register_emit(e1, g_prev, 1.0)   // decay = 1/(1+1/1) = 0.5
    let g_long  = bh_register_emit(e1, g_prev, 100.0) // decay ≈ 1/1.01 ≈ 0.99
    // short half-life → smaller retained component → goal[0] smaller
    let i2 = g_long[0] > g_short[0]

    // ─── I3 long_term_goal non-empty norm ───────────────────────────────
    let hist = [e1, e2, e3]
    let lg = bh_long_term_goal(hist, 3)
    let lg_norm = it_norm4(lg[0], lg[1], lg[2], lg[3])
    let i3 = lg_norm > 0.0

    // ─── I4 coupling self-align (same emit vector → cos = 1) ───────────
    let sv = bh_emit_to_vec(e1)
    let c_self = bh_short_long_coupling(e1, sv)
    let i4 = absf(c_self - 1.0) < 1.0e-6

    // ─── I5 coupling range [-1, 1] ──────────────────────────────────────
    let c1 = bh_short_long_coupling(e1, lg)
    let c2 = bh_short_long_coupling(e2, lg)
    let c3 = bh_short_long_coupling(e3, lg)
    let i5 = c1 >= 0.0 - 1.0 && c1 <= 1.0 &&
             c2 >= 0.0 - 1.0 && c2 <= 1.0 &&
             c3 >= 0.0 - 1.0 && c3 <= 1.0

    // ─── I6 drift self-distance 0 ───────────────────────────────────────
    let drift_self = bh_goal_drift(lg, lg)
    let i6 = drift_self == 0.0

    // ─── I7 drift ≥ 0 (non-negative metric) ─────────────────────────────
    let prev = [0.0, 0.0, 0.0, 0.0]
    let drift_nz = bh_goal_drift(prev, lg)
    let i7 = drift_nz >= 0.0

    println("I1  register_emit boundary  " + (if i1 { "PASS" } else { "FAIL" }))
    println("I2  decay monotone half-life " + (if i2 { "PASS" } else { "FAIL" }))
    println("I3  long_term_goal norm>0    " + (if i3 { "PASS" } else { "FAIL" }))
    println("I4  coupling self-align ≈1   " + (if i4 { "PASS (" + str(c_self) + ")" } else { "FAIL" }))
    println("I5  coupling range [-1,1]    " + (if i5 { "PASS" } else { "FAIL" }))
    println("I6  drift self=0             " + (if i6 { "PASS" } else { "FAIL" }))
    println("I7  drift ≥0                 " + (if i7 { "PASS" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5 && i6 && i7
    println("")
    println(if all_pass { "ALL INVARIANTS PASS (7/7)" } else { "INVARIANT FAILURE" })
}
