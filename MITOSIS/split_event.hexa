use "/Users/ghost/core/anima/.claude/worktrees/agent-adb6a589c372b7805/MITOSIS/mitosis_lib"

// ─── canonical split threshold ─────────────────────────────────────────
// mitosis_lib 의 adaptive threshold 는 runtime window-mean × factor.
// `split_threshold()` 는 그 *static* component (factor 자체) 를 노출.
// runtime 값은 pool["split_threshold_eff"] 에 산다.
// "임계" 의 의미 → tension 의 window-mean 대비 곱셈 계수.
pub fn split_threshold() -> float {
    return mit_adaptive_factor()
}

// ─── split patience (window 크기) ──────────────────────────────────────
// hist 의 최근 N 평균이 threshold_eff 초과해야 split 가 fire.
pub fn split_patience() -> int {
    return mit_split_patience()
}

// ─── should_split (PURE 판단 함수) ─────────────────────────────────────
// 1) tension_signal = cell hist 최근 split_patience 평균 (caller pre-comp)
// 2) patience_counter = 누적 위반 step (caller pre-comp; mitosis_lib 자체는
//    patience window 누적이 아닌 hist 평균으로 직접 비교하므로, 본 wrapper
//    는 patience_counter ≥ split_patience() 조건을 합산해 본다)
// → tension > threshold_eff (caller 의 threshold_eff 직접 주입) 이고
//   patience_counter 가 충분히 쌓이면 true.
// 본 함수는 side-effect 없음 (pool mutate · cell append 없음).
pub fn should_split(tension_signal: float, patience_counter: int) -> bool {
    let static_factor = split_threshold()
    let need_patience = split_patience()
    // tension_signal 은 이미 window-mean 형태로 들어왔다 가정.
    // 임계 양수 조건은 mitosis_lib `split_threshold_eff > 0.0` 동기.
    let breach = tension_signal > static_factor && static_factor > 0.0
    let patient = patience_counter >= need_patience
    if breach && patient {
        return true
    }
    return false
}

// ─── split-event summary string (debug · log) ──────────────────────────
pub fn split_event_summary() -> string {
    return "MITOSIS/split_event — threshold-breach × patience → child cell append (F-V5MIT-1 SPLIT-NOGRAD: state-copy, no grad through parent farr)"
}
