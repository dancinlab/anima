// ── ckpt_swap_locate_m3 ─────────────────────────────────────────────────
// DECODER M3 4-axis ckpt 의 HF repo URL 매핑 (axis ∈ {"A","B","C","D"}).
//
// A · C: HF private upload + pod teardown 완료 (M3_FIRE_TEARDOWN.md 2026-05-27).
//        둘 다 verdict FAIL (n_strong=0/5). PARTIAL 축 부재.
// B · D: BG wait 로그에 result_ready 신호 출현 — HF upload + teardown 은
//        **다음 round carry** (M3_FIRE_TEARDOWN.md scope 외). 본 M6 launch
//        시점에서는 HF URL 아직 미확정 — placeholder "pending" 반환.
//
// 인자: axis (대문자 "A" | "B" | "C" | "D")
// 반환:
//   - 유효 axis + HF upload 완료 (A · C):  "https://huggingface.co/dancinlab/anima-decoder-m3-axis-<axis>"
//   - 유효 axis + HF upload 미완 (B · D):  "pending"
//   - 그 외:                                "" (empty)
//
// PURE — fs probe / network call 부재. 문자열 lookup only.
pub fn ckpt_swap_locate_m3(axis: string) -> string {
    if axis == "A" { return "https://huggingface.co/dancinlab/anima-decoder-m3-axis-A" }
    if axis == "B" { return "pending" }
    if axis == "C" { return "https://huggingface.co/dancinlab/anima-decoder-m3-axis-C" }
    if axis == "D" { return "pending" }
    return ""
}

// M3 4-axis 의 verdict carry (M3_FIRE_RESULT.md + M3_FIRE_TEARDOWN.md verbatim).
// A·C 만 확정; B·D 는 "pending" (teardown 다음 round carry).
//
// 반환 verdict 문자열:
//   - "FAIL_n_strong_0_of_5" (A · C — M3_FIRE_TEARDOWN.md verbatim)
//   - "pending"             (B · D)
//   - ""                     (그 외)
pub fn ckpt_swap_m3_verdict(axis: string) -> string {
    if axis == "A" { return "FAIL_n_strong_0_of_5" }
    if axis == "B" { return "pending" }
    if axis == "C" { return "FAIL_n_strong_0_of_5" }
    if axis == "D" { return "pending" }
    return ""
}

// ── ckpt_swap_into_generator ────────────────────────────────────────────
// CORE/DECODER/generator.hexa `_gen_decode` seam 으로 ckpt 를 binding 하는
// **stub locator**. 실 binding 은 DECODER M4 wiring milestone 거주.
//
// 인자:
//   ckpt_path : ckpt_swap_locate_v5() 또는 ckpt_swap_locate_m3(axis) 의 반환값
//
// 반환: Map
//   #{ "ready":  bool   — true = swap 가능 (M4 wiring 완료 이후), false = 아직 (현 M6).
//      "reason": string — ready=false 의 사유 또는 ready=true 의 binding pointer.
//      "seam":   string — target seam reference (cite verbatim).
//      "target_file": string — generator.hexa 위치 (DECODER M4 wiring 시 생성 예정).
//      "ckpt_path":   string — caller 가 전달한 path/URL echo.
//      "family":      string — "v5_mitosis" | "m3_axis" | "unknown" (path heuristic).
//      "todo":        string — M4 wiring 시 caller 가 해야 할 일. }
//
// HONEST TODO #M6-BIND:
//   본 stub 은 ready=false 만 반환한다 — generator.hexa 본체가 아직
//   존재하지 않기 때문 (DECODER M4 wiring 의 산출물). M4 가 generator.hexa
//   를 작성한 후 동일 surface 의 ready=true variant 가 같은 contract 로
//   교체된다 (signature 보존).
//
// PURE — ckpt bytes 미로드, generator.hexa 미수정, network call 부재.
pub fn ckpt_swap_into_generator(ckpt_path: string) -> int {
    let family = _ckpt_family_from_path(ckpt_path)

    return #{
        "ready":  false,
        "reason": "TODO: bind to generator._gen_decode seam — DECODER M4 wiring milestone (DECODER.md line 48)",
        "seam":   "CORE/DECODER/generator.hexa::_gen_decode",
        "target_file": "CORE/DECODER/generator.hexa",
        "ckpt_path": ckpt_path,
        "family": family,
        "todo": "DECODER M4: (1) generator.hexa scaffold 작성, (2) ckpt_path 에서 weight bytes 로드, (3) _gen_decode seam 에서 lm_head + cell-pool routing 호출, (4) brain_decide emit=true 슬롯과 wiring",
    }
}

// path/URL heuristic 으로 ckpt family 식별 — public surface 의 family field 산출.
fn _ckpt_family_from_path(p: string) -> string {
    let v5_local = "v5mitosis"
    let v5_hf    = "anima-clm-v5-mitosis"
    let m3_hf    = "anima-decoder-m3-axis"

    if str_contains(p, v5_local) { return "v5_mitosis" }
    if str_contains(p, v5_hf)    { return "v5_mitosis" }
    if str_contains(p, m3_hf)    { return "m3_axis" }
    return "unknown"
}

