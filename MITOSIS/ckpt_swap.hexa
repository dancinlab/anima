//    F-V5MIT 5/5 PASS · M3 A/C FAIL 6GB HF · CORE/DECODER/generator.hexa
//    _gen_decode seam binding TODO M4 · ready=false stub)"
pub fn ckpt_swap_summary() -> string {
    return "MITOSIS/ckpt_swap — production swap-in locator (v5-mitosis 581MB F-V5MIT 5/5 PASS · M3 A/C FAIL 6GB HF · CORE/DECODER/generator.hexa _gen_decode seam binding TODO M4 · ready=false stub · p5/p7/p8 정합)"
