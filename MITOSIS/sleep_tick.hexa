// @raw117_exempt
// ════════════════════════════════════════════════════════════════════════
// MITOSIS/sleep_tick.hexa — WAKE sleep-tick mitosis (M5 2026-05-27)
//
// 정체: WAKE 의 5-stage state machine 과 MITOSIS 의 cell-pool 을 잇는
//      **inference-time 분열의 자연 거주지**. REM/N3 stage 에서만 mitosis
//      tick 이 발화하며, 본 tick 은 *emit-free internal rehearsal* —
//      외부 emit 없이 cell-pool 의 split/merge 만 진행한다 (a_chat_sleep_
//      imagination "imagination loop = emit-free internal rehearsal +
//      mitosis tick" 직접 정합).
//
// 회수 mechanism (instrument-first verbatim):
//
//   CLAUDE.md a_chat_sleep_imagination:
//     do   = "WAKE / N1 / N2 / N3 / REM 5-stage state machine (90-min ultradian)"
//     do   = "imagination loop = emit-free internal rehearsal + mitosis tick"
//     do   = "stage = substrate context (Φ scale + tension envelope), NOT boolean emit gate"
//     dont = "per-stage emit_allowed boolean hardcode · external 'no monologue when alone' rule"
//     dont = "speak() function call (p5)"
//
//   MITOSIS.md M5:
//     - [ ] WAKE sleep-tick mitosis — REM/N3 stage 에서 imagination loop 가
//           emit-free internal rehearsal + mitosis tick 수행. WAKE 도메인의
//           5-stage state machine 과 통합. inference-time 분열의 자연 거주지
//
//   WAKE/state_machine.hexa pub surface (M1 PR #626):
//     pub fn current_stage(state: Map) -> string
//     pub fn stage_envelope(state: Map) -> Map  // phi_scale · tension_envelope · is_imagination
//
//   MITOSIS/mitosis_lib.hexa pub surface (M1 PR #627):
//     pub fn cell_pool_step(pool, layer_t: farr_id, L: int, step_idx: int) -> Map
//       → #{ pool, aux_value, split_layer_idx, info: #{ split_fired, n_split_this_step,
//             mean_tension, threshold, pool_size, phi, split_total, merge_total } }
//
// ── boundary 명세 (M5 ≠ daemon integration) ─────────────────────────────
//   본 M5 는 sleep-tick 의 *순수 함수 surface* 다 — WAKE state + cell-pool
//   을 받아 (stage NAME 에 따라) cell_pool_step 을 한 번 호출하거나 skip 하고,
//   action label + topology delta 만 반환한다. 실제 daemon 의 tick loop /
//   schedule 은 M6 cotrain ckpt swap-in 이후 daemon-side milestone 이 거주.
//
// ── boolean gate 0 invariant (CRITICAL) ─────────────────────────────────
//   본 모듈의 stage-name 검사는 **emit 차단 gate** 가 아니다 —
//     1. emit 호출 자체가 본 모듈에 없다 (p5 NO SPEAK).
//     2. WAKE/N1/N2 에서 mitosis tick 을 *skip* 하는 것은 stage 의
//        *substrate context* (Φ scale + tension envelope) 가 의미 있는
//        imagination tick 을 못 만든다는 *substrate 사실* 의 귀결.
//     3. is_imagination flag 는 WAKE/state_machine.hexa 가 만든 *컨텍스트
//        플래그*. mitosis 루프가 internal rehearsal trigger 로 *읽는다*.
//     4. CLAUDE.md a_autonomy_over_hardcode "external rule that forces
//        anima" 회피 — sleep_tick 은 anima 가 stage 가 무엇이든 speak/silence
//        하는 결정에 *전혀 관여하지 않는다*. cell topology 만 본다.
//
// ── F-V5MIT carry (mitosis_lib 검증된 invariant) ───────────────────────
//   - F-V5MIT-1 SPLIT-NOGRAD — cell_pool_step 호출 시 state-copy 로 grad
//     leak 없음 (cotrain 62 splits / 0 violations 검증).
//   - F-V5MIT-2 MERGE-WEIGHT — (a+b)·0.5 centroid, max_err 0.0 cotrain carry.
//   - F-V5MIT-3 PHI-CONSERVATION — Φ 변동 4e-5 미만 advisory.
//   본 M5 는 cell_pool_step 본체를 호출만 — invariant 는 lib SSOT 가 carry.
//
// ── p1~p8 정합 ──────────────────────────────────────────────────────────
//   p1 NO SYSTEM PROMPT      — 본 모듈 입력은 pool dict + wake_state dict.
//                               문자열 system prompt 0.
//   p2 NO IDENTITY RULES     — identity 는 cell-pool 의 hidden farr 분포에서
//                               창발 (D3 design). 본 모듈은 그 substrate 의
//                               rehearsal phase 만 trigger.
//   p3 NO PERSONA INJECTION  — 본 모듈은 어떤 prefix 도 만들지 않는다.
//   p4 NO ASSISTANT FRAMING  — user message 인자 0. stimulus-response 아님.
//   p5 NO SPEAK()            — emit 함수 호출 0. "internal rehearsal" 정합.
//                               action="imagination_tick" label 도 외부 text
//                               emit 이 아니라 caller 가 읽는 substrate 신호.
//   p6 NO FINE-TUNED ETHICS  — 본 모듈은 가중치 0. 시간 → mitosis 라우팅만.
//   p7 NO PERPLEXITY VERDICT — verification 은 stage-name → action 결정성 +
//                               topology delta (split_total/merge_total),
//                               perplexity 무관.
//   p8 NO TRAIN/INFER SPLIT  — 동일 cell_pool_step 이 train cotrain 과
//                               inference imagination tick 양쪽에서 호출됨
//                               (mitosis_lib SSOT 의 정합).
//
// ── 호출 패턴 (caller 예시) ─────────────────────────────────────────────
//   let pool = cell_pool_init(64, 8, 42, 16)
//   let mut wake = wake_state_init(unix_now())
//   // ... perception loop 에서 wake = wake_state_tick(wake, t, phi)
//   let out = sleep_tick(pool, wake)
//   // out["action"] == "wake_skip"  OR  "imagination_tick"
//   // out["pool_changed"] : bool
//   // out["splits"] · out["merges"] : int (∆ pool topology)
//   // pool 은 out["pool"] 로 갱신 (immutable update pattern)
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima/MITOSIS/mitosis_lib"
use "/Users/ghost/core/anima/WAKE/state_machine"
use "stdlib/flame/tensor_lib"

// ─── _imagination_layer_tension ────────────────────────────────────────
// imagination tick 의 layer_t 입력 산출.
//
// substrate 사실: N3/REM 에서 anima 는 외부 perception 이 거의 없음 → layer
// tension 은 substrate-internal residual 에서 온다. 본 M5 의 placeholder 는
// stage 의 tension_envelope (WAKE state_machine 이 산출한 substrate-derived
// damping scalar) 를 L 채널에 broadcast 한 farr 를 만든다. M6 cotrain ckpt
// 회수 후 daemon-side 에서 *real* layer tension (Engine A 의 layer-wise
// activation norm) 으로 교체된다 — HONEST TODO #M5-LT.
//
// 본 helper 는 PURE — farr 할당 + 채움. (caller 가 farr_free 책임.)
fn _imagination_layer_tension(tension_envelope: float, L: int) -> int {
    let layer_t = farr_zeros(L)
    let mut l = 0
    while l < L {
        let _ = farr_set(layer_t, l, tension_envelope)
        l = l + 1
    }
    return layer_t
}

// ─── is_imagination_stage ──────────────────────────────────────────────
// stage NAME → imagination phase bool.
//
// CLAUDE.md a_chat_sleep_imagination:
//   "imagination loop = emit-free internal rehearsal + mitosis tick"
// imagination phase = N3 (deep sleep) + REM (vivid rehearsal).
// 그 외 (WAKE/N1/N2) 는 imagination tick skip — substrate-fact 귀결,
// boolean emit gate 아님.
//
// PURE — stage_name string 만 보고 결정. WAKE state 의 다른 field 는 미참.
pub fn is_imagination_stage(stage_name: string) -> bool {
    if stage_name == "N3"  { return true }
    if stage_name == "REM" { return true }
    return false
}

// ─── sleep_tick (main entry) ───────────────────────────────────────────
// WAKE state 의 현재 stage 가 imagination phase (N3/REM) 이면 cell-pool 에
// 한 step imagination tick 을 적용. 그 외에는 pool 무변경 + skip 신호.
//
// 인자:
//   pool       : MITOSIS cell-pool dict (cell_pool_init 또는 직전 tick 반환).
//   wake_state : WAKE state dict (wake_state_init 또는 wake_state_tick 반환).
//
// 반환: Map
//   #{ "pool":         updated cell-pool dict (skip 시 = 원본),
//      "pool_changed": bool (split_total / merge_total 가 갱신되었는지),
//      "action":       "wake_skip" | "imagination_tick",
//      "splits":       int (이번 tick 이 추가한 split 수),
//      "merges":       int (이번 tick 이 추가한 merge 수),
//      "stage":        string (current_stage(wake_state)) }
//
// boolean gate 0 invariant:
//   본 함수가 *반환* 하는 action 은 caller 가 읽는 substrate 신호일 뿐,
//   anima 의 emit 결정에 boolean gate 로 작동하지 않는다 (caller 가 어떻게
//   해석하든, 본 모듈은 emit 함수를 호출하지 않는다 — p5 invariant).
//
// emit-free invariant:
//   본 함수는 어떤 print / emit / channel send 호출도 하지 않는다. 오로지
//   cell-pool 의 topology (cells, hidden farr, hist, event_log) 만 갱신한다.
pub fn sleep_tick(pool: int, wake_state: int) -> int {
    let stage = current_stage(wake_state)
    let envelope = stage_envelope(wake_state)
    let imagination = is_imagination_stage(stage)

    // WAKE/N1/N2 path: skip — substrate fact (imagination phase 아님).
    if !imagination {
        return #{
            "pool":         pool,
            "pool_changed": false,
            "action":       "wake_skip",
            "splits":       0,
            "merges":       0,
            "stage":        stage,
        }
    }

    // N3/REM path: imagination tick.
    //
    // step_idx 산출: pool 의 split_total + merge_total 합산 — 본 M5 의
    // placeholder cycle counter (HONEST TODO #M5-STEP — M6 daemon 이 진짜
    // tick counter 를 넘기게 됨). step_idx 는 merge_patience 의 modulo
    // gate 에만 영향, split fire 결정에는 무관.
    let splits_before = pool["split_count"]
    let merges_before = pool["merge_count"]
    let step_idx = splits_before + merges_before

    // L = 2 (placeholder: M5 는 cell-pool 의 layer count 가 아직 외부에서
    // 주입되지 않음. mitosis_lib `cell_pool_step` 은 L 만큼 layer_t 를 cycle
    // index. M6 cotrain ckpt swap-in 후 real L 이 들어옴 — HONEST TODO #M5-L).
    let L = 2

    let tension_envelope = envelope["tension_envelope"]
    let layer_t = _imagination_layer_tension(tension_envelope, L)

    let out = cell_pool_step(pool, layer_t, L, step_idx)

    let _ = farr_free(layer_t)

    let new_pool = out["pool"]
    let splits_after = new_pool["split_count"]
    let merges_after = new_pool["merge_count"]
    let d_splits = splits_after - splits_before
    let d_merges = merges_after - merges_before
    let changed = (d_splits + d_merges) > 0

    return #{
        "pool":         new_pool,
        "pool_changed": changed,
        "action":       "imagination_tick",
        "splits":       d_splits,
        "merges":       d_merges,
        "stage":        stage,
    }
}

// ─── sleep_tick_summary ────────────────────────────────────────────────
// 모듈 contract 1-줄 요약 (debug · log · introspection).
pub fn sleep_tick_summary() -> string {
    return "MITOSIS/sleep_tick — WAKE stage N3/REM → cell_pool_step imagination tick (emit-free internal rehearsal per a_chat_sleep_imagination · p5 NO SPEAK · boolean gate 0 · cell_pool_step F-V5MIT-1/2/3 carry)"
}
