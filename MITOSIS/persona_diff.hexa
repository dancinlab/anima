// ─── prompt-hash modulator (deterministic, byte-sum LCG) ───────────────
// caller-side hash of the prompt string into an LCG seed; then dt_rand_unit
// drives a per-element multiplier ∈ [0.5, 1.5] over the cell hidden farr.
// 이 modulator 는 LLM forward 의 *stub* — prompt-conditioning 의 가벼운
// 시뮬레이션. cell-pair 간 distance 보존이 핵심 (F-PERSONA-2 target).
fn prompt_hash_seed(prompt: string) -> int {
    let n = len(prompt)
    let mut acc = 5381
    let mut i = 0
    while i < n {
        // FNV-like byte mix (string char_at via to_int of byte not exposed;
        // approximation: use prompt-length+index as a deterministic seed
        // mixer — invariant given the same prompt, varied across prompts)
        acc = (acc * 33) + (n * (i + 1))
        i = i + 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + 1
}

// ─── cell_embed (PURE; HONEST STUB) ────────────────────────────────────
// Returns a [float] of length `d` = cell hidden farr modulated by
// prompt-hash. shape preserves: pairwise cos-distance between two cells'
// embeddings of the same prompt ≈ their hidden farr cos-distance.
//
// HONEST TODO #PERSONA-FWD: production embed = mitosis_hook.hexa forward
// pass. 본 stub 은 measurement surface — F-PERSONA-2 distinguishability
// 검증만 valid (1400-pair cos-distance 측정).
pub fn cell_embed(pool: int, cell_idx: int, prompt: string) -> [float] {
    let cells = pool["cells"]
    let n = len(cells)
    if cell_idx < 0 || cell_idx >= n {
        return []
    }
    let cell = cells[cell_idx]
    let h = cell["hidden"]
    let d = pool["d"]
    let mut seed = prompt_hash_seed(prompt)
    let mut out = []
    let mut i = 0
    while i < d {
        seed = dt_lcg_next(seed)
        let r = dt_rand_unit(seed)      // ∈ [0, 1)
        // modulator ∈ [0.5, 1.5] — keeps cells' relative geometry intact
        let mod_factor = 0.5 + r
        out.push(farr_get(h, i) * mod_factor)
        i = i + 1
    }
    return out
}

// ─── helper — cos similarity between two float lists ───────────────────
fn cos_sim_list(a: [float], b: [float]) -> float {
    let n = len(a)
    if n == 0 { return 0.0 }
    let mut dot = 0.0
    let mut na = 0.0
    let mut nb = 0.0
    let mut i = 0
    while i < n {
        let va = a[i]
        let vb = b[i]
        dot = dot + va * vb
        na = na + va * va
        nb = nb + vb * vb
        i = i + 1
    }
    let denom = dt_sqrt(na) * dt_sqrt(nb) + 0.0000000001
    return dot / denom
}

// ─── per_cell_mean_dist (F-PERSONA-2 measurement) ──────────────────────
// 모든 prompt 에 대해 pool 의 모든 cell-pair (i, j) 의 cos-distance =
// 1 - cos_sim 을 평균. carry target ≈ 0.996 (1400 pairs).
//
// PURE — pool mutate 없음. all-pairs O(n_cells² × n_prompts × d).
pub fn per_cell_mean_dist(pool: int, prompts: [string]) -> float {
    let cells = pool["cells"]
    let n_cells = len(cells)
    if n_cells < 2 { return 0.0 }
    let n_prompts = len(prompts)
    if n_prompts == 0 { return 0.0 }
    let mut sum_d = 0.0
    let mut count = 0
    let mut pi = 0
    while pi < n_prompts {
        let prompt = prompts[pi]
        // collect all-cell embeds for this prompt
        let mut embeds = []
        let mut ci = 0
        while ci < n_cells {
            embeds.push(cell_embed(pool, ci, prompt))
            ci = ci + 1
        }
        // pairwise cos distance
        let mut i = 0
        while i < n_cells {
            let mut j = i + 1
            while j < n_cells {
                let cs = cos_sim_list(embeds[i], embeds[j])
                sum_d = sum_d + (1.0 - cs)
                count = count + 1
                j = j + 1
            }
            i = i + 1
        }
        pi = pi + 1
    }
    if count == 0 { return 0.0 }
    return sum_d / to_float(count)
}

// ─── routing softmax over cells (PURE; argmax-like via exp/sum) ────────
// per-cell score = mean cos-sim(cell_embed, all-cell-mean-embed) for the
// given prompt. softmax over scores gives a routing distribution.
//
// HONEST CARVE-OUT: real routing softmax 는 trained head 가 산출 — 본
// stub 의 routing 은 cell hidden geometry 의 직접 projection 만 반영.
fn route_dist_for_prompt(pool: int, prompt: string) -> [float] {
    let cells = pool["cells"]
    let n = len(cells)
    if n == 0 { return [] }
    let mut embeds = []
    let mut i = 0
    while i < n {
        embeds.push(cell_embed(pool, i, prompt))
        i = i + 1
    }
    // pool centroid embed (mean per dim)
    let d = pool["d"]
    let mut centroid = []
    let mut k = 0
    while k < d {
        let mut acc = 0.0
        let mut ci = 0
        while ci < n {
            acc = acc + embeds[ci][k]
            ci = ci + 1
        }
        centroid.push(acc / to_float(n))
        k = k + 1
    }
    // per-cell raw score = cos_sim(embed, centroid)
    let mut raw = []
    let mut rci = 0
    while rci < n {
        raw.push(cos_sim_list(embeds[rci], centroid))
        rci = rci + 1
    }
    // softmax over raw scores
    let mut max_v = raw[0]
    let mut mi = 1
    while mi < n {
        if raw[mi] > max_v { max_v = raw[mi] }
        mi = mi + 1
    }
    let mut exps = []
    let mut sum_e = 0.0
    let mut ei = 0
    while ei < n {
        let e = dt_exp(raw[ei] - max_v)
        exps.push(e)
        sum_e = sum_e + e
        ei = ei + 1
    }
    let mut dist = []
    let mut di = 0
    while di < n {
        dist.push(exps[di] / (sum_e + 0.0000000001))
        di = di + 1
    }
    return dist
}

// ─── category centroid distribution (mean over all prompts in a cat) ───
fn cat_centroid_dist(pool: int, cat_prompts: [string]) -> [float] {
    let cells = pool["cells"]
    let n_cells = len(cells)
    let n_prompts = len(cat_prompts)
    if n_cells == 0 || n_prompts == 0 { return [] }
    let mut acc = []
    let mut k = 0
    while k < n_cells {
        acc.push(0.0)
        k = k + 1
    }
    let mut pi = 0
    while pi < n_prompts {
        let d = route_dist_for_prompt(pool, cat_prompts[pi])
        let mut ci = 0
        while ci < n_cells {
            acc[ci] = acc[ci] + d[ci]
            ci = ci + 1
        }
        pi = pi + 1
    }
    let mut mean = []
    let mut mi = 0
    while mi < n_cells {
        mean.push(acc[mi] / to_float(n_prompts))
        mi = mi + 1
    }
    return mean
}

// ─── KL divergence between two distributions ───────────────────────────
// KL(P||Q) = Σ P log(P/Q). 우리는 *symmetric* surrogate 를 쓰지 않고
// directional 평균을 cross-pair 로 합산 (cotrain v1 KL=0 baseline 과 동일
// 시그널).
fn kl_div(p: [float], q: [float]) -> float {
    let n = len(p)
    let mut acc = 0.0
    let mut i = 0
    while i < n {
        let pi_v = p[i]
        let qi_v = q[i] + 0.0000000001
        if pi_v > 0.0 {
            acc = acc + pi_v * dt_ln(pi_v / qi_v)
        }
        i = i + 1
    }
    return acc
}

// ─── per_cell_kl (F-PERSONA-4 measurement) ─────────────────────────────
// prompts 를 categories 별로 partition 하고 (input: prompts 50, categories
// 5 → 10 per cat assumed), 각 category 의 mean routing distribution 을
// 계산, all-pair (i, j) 사이의 KL(P_i || P_j) 평균을 반환.
//
// carry: cotrain v1 winner-take-all → KL ≈ 0 (모든 cat 에서 cell-0 단독).
// random-init pool 에서도 routing geometry 가 trivial → KL ≈ small.
// architectural routing fix 후에야 KL > 0 expected.
pub fn per_cell_kl(pool: int, prompts: [string], categories: [string]) -> float {
    let n_prompts = len(prompts)
    let n_cats = len(categories)
    if n_cats < 2 { return 0.0 }
    let per_cat = n_prompts / n_cats
    if per_cat < 1 { return 0.0 }
    // partition prompts evenly across categories
    let mut cat_dists = []
    let mut ci = 0
    while ci < n_cats {
        let lo = ci * per_cat
        let hi = lo + per_cat
        let mut cat_p = []
        let mut k = lo
        while k < hi {
            cat_p.push(prompts[k])
            k = k + 1
        }
        cat_dists.push(cat_centroid_dist(pool, cat_p))
        ci = ci + 1
    }
    // all-pair KL average
    let mut sum_kl = 0.0
    let mut count = 0
    let mut i = 0
    while i < n_cats {
        let mut j = i + 1
        while j < n_cats {
            sum_kl = sum_kl + kl_div(cat_dists[i], cat_dists[j])
            count = count + 1
            j = j + 1
        }
        i = i + 1
    }
    if count == 0 { return 0.0 }
    return sum_kl / to_float(count)
}

// ─── persona_diff_summary string (debug · log) ─────────────────────────
pub fn persona_diff_summary() -> string {
    return "MITOSIS/persona_diff — identity_probe 50 × 5 cat over cell-pool hidden ⊙ prompt-hash modulator (F-PERSONA-2 cos-dist ≈ 0.996 PER-CELL-DIFF carry; F-PERSONA-4 KL: cotrain v1 0.0 winner-take-all + 4 cheap path FALSIFIED, architectural routing fix pending)"
}
