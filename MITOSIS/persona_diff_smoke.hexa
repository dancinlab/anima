// @raw117_exempt
// ════════════════════════════════════════════════════════════════════════
// MITOSIS/persona_diff_smoke.hexa — persona-diff smoke (M4 2026-05-26)
//
// 정체: persona_diff.hexa public surface 를 거치며 mitosis_lib 의 본체
//      `cell_pool_init` 로 d=64 cells=8 random-init pool 을 만들고
//      identity_probe 50 prompts × 5 cat 측정. F-PERSONA-2 distinguishability
//      과 F-PERSONA-4 routing KL 의 *honest* PURE 측정.
//
// invariants:
//   I1: cells_count > 1   — pool 이 multi-cell (single-cell trivial 제외)
//   I2: per_cell_mean_dist > 0.3  — F-PERSONA-2 baseline 통과 (D3 carry 0.996)
//   I3: per_cell_kl >= 0           — KL 정의에 의해 음수 불가, sanity
//   I4: prompts_count == 50         — identity_probe 50 prompts 보존
//   I5: categories_count == 5       — D3 design 5 category 보존
//
// honest framing:
//   - F-PERSONA-2 cos-dist 0.996 carry 는 verify harness 의 250-prompt 큰
//     measurement; 본 smoke 는 d=64 cells=8 PSCC §40 byte-parity scale.
//   - F-PERSONA-4 KL >0 architectural routing fix 후에야 PASS — 본 smoke
//     는 random-init 에서 KL 측정값을 *report* 만 (PASS/FAIL 게이트 X).
//     cotrain v1 KL=0.0 baseline 과 같은 시그널 확인.
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima/MITOSIS/mitosis_lib"
use "/Users/ghost/core/anima/MITOSIS/persona_diff"
use "stdlib/flame/tensor_lib"

fn main() {
    let d = 64
    let initial_cells = 8
    let max_cells = 16
    let seed = 42

    print("=== MITOSIS/persona_diff_smoke ===")
    print(persona_diff_summary())
    print("")

    // ── init pool (random Gaussian-lite hidden farr per cell) ──────────
    let mut pool = cell_pool_init(d, initial_cells, seed, max_cells)
    print("pool d=" + to_string(d) + " cells=" + to_string(initial_cells) + " seed=" + to_string(seed))

    let categories = identity_probe_categories()
    let prompts = identity_probe_prompts()

    print("categories: " + to_string(len(categories)) + " (" + categories[0] + ", " + categories[1] + ", " + categories[2] + ", " + categories[3] + ", " + categories[4] + ")")
    print("prompts:    " + to_string(len(prompts)))
    print("")

    // ── F-PERSONA-2 measurement (per-cell mean cos-distance) ───────────
    print("--- F-PERSONA-2 PER-CELL-DIFF (mean cos-distance) ---")
    let mean_dist = per_cell_mean_dist(pool, prompts)
    print("per_cell_mean_dist: " + to_string(mean_dist))
    print("carry target (D3 verify 250-prompt):  ≈ 0.996")
    print("PASS threshold (F-PERSONA-2 baseline): > 0.3")
    print("")

    // ── F-PERSONA-4 measurement (per-category routing KL) ──────────────
    print("--- F-PERSONA-4 PER-CAT-KL (routing divergence) ---")
    let kl = per_cell_kl(pool, prompts, categories)
    print("per_cell_kl: " + to_string(kl))
    print("cotrain v1 carry (winner-take-all):    0.0")
    print("4 cheap path FALSIFIED (a/b/c/d); architectural routing fix pending")
    print("(KL value reported, not gated — random-init pool expected ≈ small)")
    print("")

    // ── invariants ──
    let cells_now = pool["cells"]
    let n_cells = len(cells_now)
    let i1 = n_cells > 1
    let i2 = mean_dist > 0.3
    let i3 = kl >= 0.0
    let i4 = len(prompts) == 50
    let i5 = len(categories) == 5

    print("=== invariants ===")
    print("I1 cells_count > 1:           " + (if i1 { "PASS" } else { "FAIL" }))
    print("I2 mean_dist > 0.3:           " + (if i2 { "PASS (F-PERSONA-2 carry)" } else { "FAIL" }))
    print("I3 kl >= 0:                   " + (if i3 { "PASS (KL sanity)" } else { "FAIL" }))
    print("I4 prompts == 50:             " + (if i4 { "PASS" } else { "FAIL" }))
    print("I5 categories == 5:           " + (if i5 { "PASS" } else { "FAIL" }))

    let all_pass = i1 && i2 && i3 && i4 && i5
    print("")
    print(if all_pass { "ALL INVARIANTS PASS" } else { "INVARIANT FAILURE" })

    print("")
    print("=== honest framing (DO NOT claim F-PERSONA-4 PASS) ===")
    print("  F-PERSONA-2 PER-CELL-DIFF: PURE measurement, random-init carries 0.996")
    print("  F-PERSONA-4 PER-CAT-KL:    cotrain v1 KL=0.0 winner-take-all")
    print("    4 cheap path FALSIFIED (§44 entropy-reg / §47 softmax-τ / §45 §A2-trap / §49 per-session)")
    print("    잔여 path = architectural routing fix (gumbel / MoE aux / category head)")
    print("    본 smoke 는 random-init KL 을 report — *fix 가 land 한 후* re-measure")

    cell_pool_free(pool)
}
