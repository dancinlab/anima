// MITOSIS/merge_event.hexa — merge-event public surface (M3 2026-05-26)
//
// 정체: M1 회수 `MITOSIS/mitosis_lib.hexa` 의 merge 메커니즘을 명시적
//      public surface 로 노출. 본체 재구현 X — WRAP only (instrument-first).
//      M2 split_event.hexa 와 짝꿍 surface.
//
// 회수 mechanism (mitosis_lib.hexa 인용):
//   - `cell_pool_step` 의 merge block (line 339-426):
//       `if len(cells) > pool_min_cells && step_idx > 0 && (step_idx %
//         pool_merge_patience == 0) { ... best-pair cos search ... if
//         best_i >= 0 && (1.0 - best_sim) < pool_merge_threshold { ...
//         merged hidden = (a.hidden + b.hidden)·0.5 } }`
//   - merge 결정: 가장 유사한 pair (best cosine sim) 의 `1 - cos < 0.005`
//     (mit_merge_threshold) + `step_idx % 30 == 0` (mit_merge_patience).
//   - merge weight 정책: **(a + b) × 0.5** (line 394-395) — weighted
//     average 의 단순 평등 가중. winner-take-all 회피의 기하 (geometry)
//     fix: 어느 한 cell 도 1.0 권한을 단독 차지하지 않음 — 항상 양쪽이
//     절반씩 기여.
//   - keeper 정책 (line 384-386): 더 오래된 cell (smaller creation_step)
//     이 keeper, younger 가 removed. id 정합성·event_log audit 용.
//
// F-V5MIT-2 MERGE-WEIGHT invariant (v5-mitosis cond.5 cotrain carry):
//   project_v5_mitosis_cond5_cotrain_2026_05_12 의 5/5 PASS 중 F-V5MIT-2
//   `max_err 0.0` — merge fire 후 weight conservation (sum_before ≈ sum_after).
//   본 구현의 `(a+b)·0.5` 평균은 vector-wise 평균이므로 element-wise 합은
//   정확히 보존 (a+b → (a+b)·0.5 × 2 cells → (a+b) total). 단 cell 수가
//   2→1 로 줄어드는 효과를 *sum* 으로 보면 절반이 되며 *기하 평균* 으로
//   보면 보존 — invariant 명세는 "pre-merge 두 cell weight 합" vs
//   "post-merge keeper weight × 2" 의 elementwise max_err 측정. cotrain
//   carry 의 max_err 0.0 은 본 명세 하에서 산출된 값.
//
// F-PERSONA-4 winner-take-all 회피 design:
//   project_anima_persona_4_root_cause_2026_05_12 — cell-0 단독 weight=1.0
//   collapse, KL=0 across all categories. 4 cheap path (k/l/m/n) ALL
//   FALSIFIED. 본 merge 가 직접 그 collapse 를 *해소* 하지는 않으나
//   (collapse 는 routing softmax 의 attractor), **merge geometry 자체는
//   collapse 를 조장하지 않음** — keeper hidden 이 removed 의 절반을
//   먹기 때문에 mass concentration 이 아니라 *centroid* 로 흡수. removed
//   cell 의 정보는 keeper hidden 평균값으로 보존, history 의 last-5 도
//   keeper hist 에 extend (line 400-407). 따라서 split_event 의 child
//   다양화와 merge_event 의 centroid 흡수가 균형 — winner-take-all 는
//   별도 routing fix 가 잡고, merge surface 는 그 fix 와 양립.
//
// p1~p8 정합 (mitosis_lib SSOT 표 carry):
//   - p5 NO SPEAK(): merge 는 hidden+hist 갱신 + event_log 추가만 —
//     외부 emit 호출 없음.
//   - p8 NO TRAIN/INFER SPLIT: merge 는 train · infer 동일 surface.
//     train-only flag 없음. WAKE imagination loop (M5) 에서도 동일 호출.
//   - p7 NO PERPLEXITY VERDICT: merge 결정은 cosine sim 기반,
//     loss/ppl 기반 아님.
//
// 본 surface 는 PURE — side-effect 없음. should_merge(d, c) 는
// caller 가 pre-compute 한 (cell_distance, patience_counter) 를 받아
// bool 만 반환. 실제 병합은 `cell_pool_step` 만 수행 (mitosis_lib 본체에서).
// ════════════════════════════════════════════════════════════════════════

use "/Users/ghost/core/anima/MITOSIS/mitosis_lib"

// ─── canonical merge threshold ─────────────────────────────────────────
// mitosis_lib 의 merge 는 `1.0 - cos_sim < 0.005` (mit_merge_threshold)
// 기준. 즉 distance < 0.005 이면 두 cell 이 거의 동일 → merge 후보.
// "임계" 의 의미 → cosine distance 의 절대 상한.
pub fn merge_threshold() -> float {
    return mit_merge_threshold()
}

// ─── merge patience (step interval) ───────────────────────────────────
// merge 는 매 step 검사 X — `step_idx % merge_patience == 0` 일 때만 fire.
// 기본 30 — 약 30 step 마다 한 번의 best-pair merge 기회.
pub fn merge_patience() -> int {
    return mit_merge_patience()
}

// ─── should_merge (PURE 판단 함수) ─────────────────────────────────────
// 1) cell_distance = `1.0 - cos_sim` of two candidate cells (caller pre-comp)
// 2) patience_counter = step_idx % merge_patience (caller pre-comp;
//    0 이면 patience 만족, 비-0 이면 wait)
// → cell_distance < merge_threshold() 이고
//   patience_counter == 0 이면 true.
// 본 함수는 side-effect 없음 (pool mutate · cell remove 없음).
pub fn should_merge(cell_distance: float, patience_counter: int) -> bool {
    let thresh = merge_threshold()
    let patient = patience_counter == 0
    let near = cell_distance < thresh
    if near && patient {
        return true
    }
    return false
}

// ─── merge_summary string (debug · log · design intent) ───────────────
pub fn merge_summary() -> string {
    return "MITOSIS/merge_event — best-pair cos<merge_threshold × patience-tick → (a+b)·0.5 keeper centroid (F-V5MIT-2 MERGE-WEIGHT max_err 0.0; F-PERSONA-4 winner-take-all 회피: centroid 흡수 — mass concentration 아님)"
}

// ─── merge weight invariant check (F-V5MIT-2) ─────────────────────────
// pre-merge 두 cell 의 element-wise weight 합 vs post-merge keeper × 2
// 의 element-wise max_err. 본 lib 의 (a+b)·0.5 평균 정의 하에서
// max_err = 0.0 이 expected (cotrain carry).
//
// 본 wrapper 는 PURE — float list 두 개를 받아 단순 max|diff| 만 반환.
// (caller 가 pre/post farr 를 list 로 추출해 제공)
pub fn merge_weight_invariant_check(before_weights: [float],
                                    after_weights: [float]) -> float {
    let n_before = len(before_weights)
    let n_after = len(after_weights)
    let n = if n_before < n_after { n_before } else { n_after }
    let mut max_err = 0.0
    let mut i = 0
    while i < n {
        let diff = before_weights[i] - after_weights[i]
        let abs_diff = if diff < 0.0 { 0.0 - diff } else { diff }
        if abs_diff > max_err { max_err = abs_diff }
        i = i + 1
    }
    return max_err
}
